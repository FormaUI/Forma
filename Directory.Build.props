<Project>

    <!--
        Forma.Blazor Build Properties
        
        Shared properties for all Forma.Blazor projects.
    -->

    <PropertyGroup>
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <!-- Reports the .editorconfig IDE* code-style severities from the compiler, not just the IDE. -->
    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

</Project>
