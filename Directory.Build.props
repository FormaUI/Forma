<Project>

    <!--
        Forma Build Properties
        
        Shared properties for all Forma projects.
    -->

    <!-- Every project targets the same framework and language settings; a project overrides one by declaring it after this import, which none currently need to. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- Every library a WebAssembly client loads is analyzed for trimming, so a trim warning fails its build as any warning does: everything under src but the halves serving the server alone, the locale packs, which hold no code, and the Showcase. -->
    <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src')) and !$(MSBuildProjectName.EndsWith('.Server')) and !$(MSBuildProjectName.EndsWith('.AspNetCore')) and !$(MSBuildProjectName.Contains('.Locales.')) and '$(MSBuildProjectName)' != 'Forma.Blazor.Showcase'">
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>

    <!-- Repo-root-anchored, so a project imports it correctly whatever depth it sits at. -->
    <PropertyGroup>
        <ComponentAnalyzersTargets>$(MSBuildThisFileDirectory)eng\ComponentAnalyzers.targets</ComponentAnalyzersTargets>
    </PropertyGroup>

    <!-- The one version every package ships at; a preview, as the framework it targets is. -->
    <PropertyGroup>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>preview</VersionSuffix>
    </PropertyGroup>

    <!-- Reports the .editorconfig IDE* code-style severities from the compiler, not just the IDE. -->
    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

</Project>
