<Project>

    <!--
        Forma Build Properties
        
        Shared properties for all Forma projects.
    -->

    <!-- Every project targets the same framework and language settings; a project overrides one by declaring it after this import, which none currently need to. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- Repo-root-anchored, so a project imports it correctly whatever depth it sits at. -->
    <PropertyGroup>
        <ComponentAnalyzersTargets>$(MSBuildThisFileDirectory)eng\ComponentAnalyzers.targets</ComponentAnalyzersTargets>
    </PropertyGroup>

    <!-- The one version every package ships at; a preview, as the framework it targets is. -->
    <PropertyGroup>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>preview</VersionSuffix>
    </PropertyGroup>

    <!-- Reports the .editorconfig IDE* code-style severities from the compiler, not just the IDE. -->
    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

</Project>
