<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>Forma.UI.Blazor.Tests</RootNamespace>
        <NoWarn>CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AngleSharp" Version="1.5.0" />
        <PackageReference Include="bunit" Version="2.6.2" />
        <PackageReference Include="xunit.v3" Version="3.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Forma.UI.Blazor\Forma.UI.Blazor.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework.Core\Forma.Framework.Core.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework.Css\Forma.Framework.Css.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework.Resources\Forma.Framework.Resources.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\Forma.Tests.Support\Forma.Tests.Support.csproj" />
    </ItemGroup>

    <!-- FormaDataGrid's CSS reads a custom property that lives only in QuickGrid's own
         stylesheet. Copying it to the output under a stable name lets a contract test
         assert the property is still declared; the fingerprinted filename and the resolved
         package version both come from the build rather than being written down here. -->
    <Target Name="CopyQuickGridStylesheet" AfterTargets="Build">
        <ItemGroup>
            <_QuickGridStylesheet Include="@(StaticWebAsset)"
                                  Condition="$([System.String]::Copy('%(StaticWebAsset.Identity)').Contains('QuickGrid')) AND $([System.String]::Copy('%(StaticWebAsset.Identity)').EndsWith('.bundle.scp.css'))" />
            <QuickGridStylesheet Include="@(_QuickGridStylesheet->Distinct())" />
        </ItemGroup>
        <Copy SourceFiles="@(QuickGridStylesheet)"
              DestinationFiles="$(OutDir)QuickGrid.bundle.scp.css"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
