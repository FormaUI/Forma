@inherits BunitContext

@code {
    public sealed class Component
    {
        private static readonly FormaModalOptions HideConfirmAction =
            new() { ShowConfirmAction = false };

        private static readonly FormaModalOptions HideFooterActions =
            new() { ShowCancelAction = false, ShowConfirmAction = false };

        [Fact]
        public void Should_render_dialog_element()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" />);

            // Assert
            cut.Find("dialog");
        }

        [Fact]
        public void Should_render_title_in_header_when_provided()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" Title="Test Title" />);
            var header = cut.Find(".forma-modal-header h5");

            // Assert
            Assert.Equal("Test Title", header.TextContent);
        }

        [Fact]
        public void Should_not_render_header_when_title_is_null()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-modal-header"));
        }

        [Fact]
        public void Should_render_child_content()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })">
                    <Body><p>Hello Modal</p></Body>
                </FormaModal>);
            var body = cut.Find(".forma-modal-body");

            // Assert
            Assert.Contains("Hello Modal", body.InnerHtml, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_render_footer_content_when_provided()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })">
                    <Footer><button>Save</button></Footer>
                </FormaModal>);
            var footer = cut.Find(".forma-modal-footer");

            // Assert
            Assert.Contains("Save", footer.InnerHtml, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_not_render_footer_when_not_provided()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" Options="HideFooterActions" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-modal-footer"));
        }

        [Fact]
        public void Should_render_default_footer_actions_when_enabled()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" />);
            var footer = cut.Find(".forma-modal-footer");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("Cancel", footer.TextContent, StringComparison.Ordinal);
                Assert.Contains("Confirm", footer.TextContent, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_render_footer_content_and_default_actions_together_when_enabled()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })">
                    <Footer><span>Custom</span></Footer>
                </FormaModal>);
            var footer = cut.Find(".forma-modal-footer");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("Custom", footer.TextContent, StringComparison.Ordinal);
                Assert.Contains("Cancel", footer.TextContent, StringComparison.Ordinal);
                Assert.Contains("Confirm", footer.TextContent, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_render_close_only_when_confirm_action_is_hidden()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" Options="HideConfirmAction" />);
            var footer = cut.Find(".forma-modal-footer");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("Close", footer.TextContent, StringComparison.Ordinal);
                Assert.DoesNotContain("Confirm", footer.TextContent, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_add_no_header_class_when_title_is_null()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" />);
            var body = cut.Find(".forma-modal-body");

            // Assert
            Assert.Contains("no-header", body.ClassList);
        }

        [Theory]
        [InlineData(ModalSize.Small, "forma-modal-small")]
        [InlineData(ModalSize.Medium, "forma-modal-medium")]
        [InlineData(ModalSize.Large, "forma-modal-large")]
        [InlineData(ModalSize.ExtraLarge, "forma-modal-extralarge")]
        [InlineData(ModalSize.Full, "forma-modal-full")]
        public void Should_apply_size_class(ModalSize size, string expectedClass)
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" Size="@size" />);
            var dialog = cut.Find("dialog");

            // Assert
            Assert.Contains(expectedClass, dialog.ClassList);
        }

        [Fact]
        public void Should_default_to_medium_size()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" />);
            var dialog = cut.Find("dialog");

            // Assert
            Assert.Contains("forma-modal-medium", dialog.ClassList);
        }

        [Fact]
        public void Should_have_close_button_with_aria_label()
        {
            // Arrange
            using var ctx = new FormaModalTests();

            // Act
            var cut = ctx.Render(
                @<FormaModal Opened="false" OnClose="@(() => { })" Title="Test" />);
            var closeBtn = cut.Find(".forma-modal-header button");

            // Assert
            Assert.Equal("Close", closeBtn.GetAttribute("aria-label"));
        }
    }
}
