        [Fact]
        public void Should_wear_the_field_chrome_once_given_a_label()
        {
            // Arrange
            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text" Label="Project" Id="project" />
            </FakeFormHost>);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.NotNull(cut.Find(".forma-field"));
                Assert.Contains("forma-field-input", cut.Find("input").ClassList);
                Assert.Equal("Project", cut.Find("label.forma-field-label").TextContent.Trim());
                Assert.Equal("project", cut.Find("label.forma-field-label").GetAttribute("for"));
            });
        }

