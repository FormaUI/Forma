            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text" Label="Project" />
            </FakeFormHost>);

            // Assert
            var id = cut.Find("input").GetAttribute("id");
            Assert.Multiple(() =>
            {
                Assert.False(string.IsNullOrWhiteSpace(id));
                Assert.Equal(id, cut.Find("label.forma-field-label").GetAttribute("for"));
            });
        }

        [Fact]
        public void Should_render_the_native_constraints_given()
        {
            // Arrange
            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text"
                              MaxLength="20"
                              Pattern="[a-z]+"
                              InputMode="TextInputMode.Email"
                              AutoComplete="email" />
            </FakeFormHost>);
            var input = cut.Find("input");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("20", input.GetAttribute("maxlength"));
                Assert.Equal("[a-z]+", input.GetAttribute("pattern"));
                Assert.Equal("email", input.GetAttribute("inputmode"));
                Assert.Equal("email", input.GetAttribute("autocomplete"));
            });
        }

        [Fact]
        public void Should_leave_the_native_constraints_off_when_not_given()
        {
            // Arrange
            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text" />
            </FakeFormHost>);
            var input = cut.Find("input");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.False(input.HasAttribute("maxlength"));
                Assert.False(input.HasAttribute("pattern"));
                Assert.False(input.HasAttribute("inputmode"));
                Assert.False(input.HasAttribute("autocomplete"));
                Assert.False(input.HasAttribute("style"));
            });
        }

