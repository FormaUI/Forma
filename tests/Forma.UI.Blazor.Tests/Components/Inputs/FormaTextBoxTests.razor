            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text" autocomplete="off" maxlength="50" data-testid="tb-1" />
            </FakeFormHost>);
            var input = cut.Find("input");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("off", input.GetAttribute("autocomplete"));
