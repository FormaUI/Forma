        [Fact]
        public void Should_show_the_newest_window_when_a_slower_query_is_superseded()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            var provider = new FakeGalleryResourcesProvider([.. Enumerable.Range(1, 50)
                .Select(i => new ImageResourceInfo($"https://example.com/{i:D4}.jpg"))])
            {
                Gate = new TaskCompletionSource()
            };
            var cut = ctx.Render(@<FormaGallery ResourcesProvider="provider" PageSize="5" />);

            // Act - a second window is asked for while the first is still held
            cut.Find(".forma-gallery-sort-select").Change("Name");
            provider.Gate.SetResult();
            cut.WaitForState(() => cut.FindAll(".forma-gallery-item").Count > 0);

            // Assert
            Assert.True(provider.Queries.Count >= 2);
            Assert.Equal(5, cut.FindAll(".forma-gallery-item").Count);
            Assert.Empty(cut.FindAll(".forma-gallery-scroll[aria-busy='true']"));
        }

