        [Fact]
        public void Should_sort_resources_by_the_date_added_and_the_date_modified()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            var epoch = new DateTimeOffset(2026, 1, 1, 0, 0, 0, TimeSpan.Zero);
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/a.jpg") { CreatedAt = epoch.AddDays(3), ModifiedAt = epoch.AddDays(1) },
                new ImageResourceInfo("https://example.com/b.jpg") { CreatedAt = epoch.AddDays(1), ModifiedAt = epoch.AddDays(3) },
                new ImageResourceInfo("https://example.com/c.jpg") { CreatedAt = epoch.AddDays(2), ModifiedAt = epoch.AddDays(2) }
            ];
            var cut = ctx.Render(@<FormaGallery Resources="resources" />);

            // Act
            cut.Find(".forma-gallery-sort-select").Change("DateAdded");

            // Assert
            var items = cut.FindAll(".forma-gallery-item-name");
            Assert.Equal(["b.jpg", "c.jpg", "a.jpg"], items.Select(i => i.TextContent));

            // Act
            cut.Find(".forma-gallery-sort-select").Change("DateModified");

            // Assert
            items = cut.FindAll(".forma-gallery-item-name");
            Assert.Equal(["a.jpg", "c.jpg", "b.jpg"], items.Select(i => i.TextContent));
        }

