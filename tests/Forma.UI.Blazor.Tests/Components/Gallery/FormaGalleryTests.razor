        [Fact]
        public void Should_render_folders_sidebar_and_breadcrumbs()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            var parent = new GalleryFolderInfo("races", "Races", null, "/races", 10);
            var child = new GalleryFolderInfo("2026", "2026", "races", "/races/2026", 5);
            IReadOnlyList<GalleryFolderInfo> folders = [parent, child];

            // Act
            var cut = ctx.Render(@<FormaGallery Entries="[]" Folders="folders" CurrentFolder="child" />);

            // Assert
            var breadcrumbs = cut.FindAll(".forma-gallery-breadcrumb-item");
            Assert.Equal(3, breadcrumbs.Count); // "All media" > "Races" > "2026"
            Assert.Equal("All media", breadcrumbs[0].TextContent.Trim());
            Assert.Equal("Races", breadcrumbs[1].TextContent.Trim());
            Assert.Equal("2026", breadcrumbs[2].TextContent.Trim());
