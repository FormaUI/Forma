        [Fact]
        public void Should_sort_entries_by_name_and_size()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            IReadOnlyList<ResourceInfo> entries =
            [
                new ResourceInfo("https://example.com/b.jpg", ResourceKind.Image) { Size = 500 },
                new ResourceInfo("https://example.com/a.jpg", ResourceKind.Image) { Size = 1000 },
                new ResourceInfo("https://example.com/c.jpg", ResourceKind.Image) { Size = 200 }
            ];

            // Act & Assert - Name ascending (default)
            var cut = ctx.Render(@<FormaGallery Entries="entries" />);
            var items = cut.FindAll(".forma-gallery-item-name");
            Assert.Equal("a.jpg", items[0].TextContent);
            Assert.Equal("b.jpg", items[1].TextContent);
            Assert.Equal("c.jpg", items[2].TextContent);

            // Act - Sort by Size
            cut.Find(".forma-gallery-sort-select").Change("Size");
            items = cut.FindAll(".forma-gallery-item-name");
            Assert.Equal("c.jpg", items[0].TextContent);
            Assert.Equal("b.jpg", items[1].TextContent);
            Assert.Equal("a.jpg", items[2].TextContent);
        }

        [Fact]
        public void Should_sort_entries_by_the_date_added_and_the_date_modified()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            var epoch = new DateTimeOffset(2026, 1, 1, 0, 0, 0, TimeSpan.Zero);
            IReadOnlyList<ResourceInfo> entries =
            [
                new GalleryResourceInfo("https://example.com/a.jpg", ResourceKind.Image) { AddedAt = epoch.AddDays(3), ModifiedAt = epoch.AddDays(1) },
                new GalleryResourceInfo("https://example.com/b.jpg", ResourceKind.Image) { AddedAt = epoch.AddDays(1), ModifiedAt = epoch.AddDays(3) },
                new GalleryResourceInfo("https://example.com/c.jpg", ResourceKind.Image) { AddedAt = epoch.AddDays(2), ModifiedAt = epoch.AddDays(2) }
            ];
            var cut = ctx.Render(@<FormaGallery Entries="entries" />);

            // Act
            cut.Find(".forma-gallery-sort-select").Change("DateAdded");

            // Assert
            var items = cut.FindAll(".forma-gallery-item-name");
            Assert.Equal(["b.jpg", "c.jpg", "a.jpg"], items.Select(i => i.TextContent));

            // Act
            cut.Find(".forma-gallery-sort-select").Change("DateModified");

            // Assert
            items = cut.FindAll(".forma-gallery-item-name");
            Assert.Equal(["a.jpg", "c.jpg", "b.jpg"], items.Select(i => i.TextContent));
        }

