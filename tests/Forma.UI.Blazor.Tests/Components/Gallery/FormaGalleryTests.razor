        [Fact]
        public void Should_raise_on_folder_create_rename_and_delete()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            var folder = new GalleryFolderInfo("races", "Races");
            GalleryFolderCreateRequest? createReq = null;
            GalleryFolderRenameRequest? renameReq = null;
            GalleryFolderDeleteRequest? deleteReq = null;

            var cut = ctx.Render(@<FormaGallery Entries="[]"
                                                Folders="[folder]"
                                                OnFolderCreate="@(req => { createReq = req; return Task.CompletedTask; })"
                                                OnFolderRename="@(req => { renameReq = req; return Task.CompletedTask; })"
                                                OnFolderDelete="@(req => { deleteReq = req; return Task.CompletedTask; })" />);

            // Act - Create Folder
            cut.Find(".forma-gallery-new-folder-tool").Click();
            cut.Find("#forma-gallery-folder-input").Input("New Album");
            cut.Find(".forma-modal-footer .forma-btn-primary").Click();

            // Assert create
            Assert.NotNull(createReq);
            Assert.Equal("New Album", createReq.Name);

            // Act - Rename Folder
            cut.Find(".forma-gallery-folder-action-btn").Click();
            cut.Find("#forma-gallery-rename-folder-input").Input("Updated Races");
            cut.Find(".forma-modal-footer .forma-btn-primary").Click();

            // Assert rename
            Assert.NotNull(renameReq);
            Assert.Equal("Updated Races", renameReq.NewName);

            // Act - Delete Folder
            cut.Find(".forma-gallery-folder-action-delete").Click();
            cut.Find(".forma-modal-footer .forma-btn-danger").Click();

            // Assert delete
            Assert.NotNull(deleteReq);
            Assert.Equal("races", deleteReq.Folder.Id);
        }

