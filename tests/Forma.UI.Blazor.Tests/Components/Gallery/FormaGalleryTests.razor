        [Fact]
        public void Should_render_empty_state_when_entries_is_empty()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();

            // Act
            var cut = ctx.Render(@<FormaGallery Entries="[]" />);

            // Assert
            Assert.Contains("No media found", cut.Find(".forma-gallery-empty").TextContent);
        }

        [Fact]
        public void Should_render_thumbnails_view_by_default()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            IReadOnlyList<ResourceInfo> entries =
            [
                new ResourceInfo("https://example.com/cover.jpg", ResourceKind.Image) { Size = 1024 },
                new ResourceInfo("https://example.com/video.mp4", ResourceKind.Video) { Size = 2048000 }
            ];

            // Act
            var cut = ctx.Render(@<FormaGallery Entries="entries" />);

            // Assert
            var items = cut.FindAll(".forma-gallery-item");
            Assert.Equal(2, items.Count);
            Assert.NotNull(cut.Find(".forma-gallery-grid"));
            Assert.Equal("cover.jpg", items[0].QuerySelector(".forma-gallery-item-name")!.TextContent);
        }

        [Fact]
        public void Should_switch_view_modes_between_thumbnails_details_and_list()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            IReadOnlyList<ResourceInfo> entries =
            [
                new ResourceInfo("https://example.com/cover.jpg", ResourceKind.Image) { Size = 1024 }
            ];
            var cut = ctx.Render(@<FormaGallery Entries="entries" />);

            // Act & Assert - Switch to Details
            cut.FindAll(".forma-gallery-view-btn")[1].Click();
            Assert.NotNull(cut.Find(".forma-gallery-details-table"));

            // Act & Assert - Switch to List
