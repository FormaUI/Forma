        [Fact]
        public async Task Should_refuse_a_root_folder_beyond_the_root_folder_ceiling()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            IReadOnlyList<FolderResourceInfo> folders = [new("races") { Name = "Races" }];
            var constraints = new FormaGalleryConstraints { MaxFolderRootCount = 1 };
            GalleryRejection? rejection = null;
            GalleryFolderCreateRequest? created = null;

            var cut = ctx.Render(@<FormaGallery Resources="[]"
                                                Folders="folders"
                                                Constraints="constraints"
                                                OnRejected="@(r => { rejection = r; return Task.CompletedTask; })"
                                                OnFolderCreate="@(r => { created = r; return Task.CompletedTask; })" />);

            // Act
            await cut.Find(".forma-gallery-sidebar button[aria-label='New folder']").ClickAsync(new());

            // Assert
            Assert.Null(created);
            Assert.NotNull(rejection);
            Assert.Equal(GalleryRejectionReason.FolderRootCount, rejection.Reason);
            Assert.Equal(1, rejection.Allowed);
            Assert.Equal(rejection.Message, cut.Find(".forma-gallery-rejection-text").TextContent.Trim());
        }

