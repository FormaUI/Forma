        [Fact]
        public void Should_keep_a_selection_made_on_a_window_the_provider_no_longer_returns()
        {
            // Arrange
            using var ctx = new FormaGalleryTests();
            var provider = new FakeGalleryResourcesProvider([.. Enumerable.Range(1, 50)
                .Select(i => new ImageResourceInfo($"https://example.com/{i:D4}.jpg"))]);
            IReadOnlyList<ResourceInfo> selected = [];
            var cut = ctx.Render(@<FormaGallery ResourcesProvider="provider"
                                                PageSize="10"
                                                SelectedChanged="@(items => { selected = items; return Task.CompletedTask; })" />);
            cut.Find(".forma-gallery-select-mode-btn").Click();
            cut.Find(".forma-gallery-item-open").Click();
            Assert.Single(selected);

            // Act - page away from the window holding the selected resource
            cut.Find(".forma-gallery-pagination .forma-pagination-next").Click();
            cut.Find(".forma-gallery-item-open").Click();

            // Assert
            Assert.Equal(["0001.jpg", "0011.jpg"], selected.Select(item => item.Name));
        }

