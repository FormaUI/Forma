        private static void SortBy<TComponent>(IRenderedComponent<TComponent> cut, ExplorerSortField field)
            where TComponent : IComponent
        {
            cut.Find(".forma-explorer-sort-trigger").Click();
            cut.Find($"[data-sort-field='{field}']").Click();
        }
