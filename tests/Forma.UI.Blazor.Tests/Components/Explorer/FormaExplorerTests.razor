            };
            var cut = ctx.Render(@<FormaExplorer ResourcesProvider="provider" PageSize="5" />);

            // Act - a second window is asked for while the first is still held
            SortBy(cut, ExplorerSortField.Name);
            provider.Gate.SetResult();
            cut.WaitForState(() => cut.FindAll(".forma-explorer-item").Count > 0);

            // Assert
