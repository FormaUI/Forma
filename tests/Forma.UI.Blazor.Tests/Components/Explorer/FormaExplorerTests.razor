        [Fact]
        public void Should_raise_on_folder_create_rename_and_delete()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var folder = new FolderResourceInfo("races") { Name = "Races" };
            ExplorerFolderCreateRequest? createReq = null;
            ExplorerFolderRenameRequest? renameReq = null;
            ExplorerFolderDeleteRequest? deleteReq = null;

            var cut = ctx.Render(@<FormaExplorer Resources="[]"
                                                Folders="[folder]"
                                                OnFolderCreate="@(req => { createReq = req; return Task.CompletedTask; })"
                                                OnFolderRename="@(req => { renameReq = req; return Task.CompletedTask; })"
                                                OnFolderDelete="@(req => { deleteReq = req; return Task.CompletedTask; })" />);

            // Act - Create Folder
            cut.Find(".forma-explorer-new-folder-tool").Click();
            cut.Find("#forma-explorer-folder-input").Input("New Album");
            cut.Find(".forma-modal-footer .forma-button-primary").Click();

            // Assert create
            Assert.NotNull(createReq);
            Assert.Equal("New Album", createReq.Name);

            // Act - Rename Folder
            cut.Find("button[aria-label='Actions for Races']").Click();
            cut.Find("[data-action='folder-rename']").Click();
            cut.Find("#forma-explorer-rename-folder-input").Input("Updated Races");
