@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_toolbar_container()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" SearchPlaceholder="Search..." />);

            // Assert
            cut.Find(".forma-search-toolbar");
        }

        [Fact]
        public void Should_always_render_the_search_field()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" SearchPlaceholder="Search..." />);

            // Assert
            cut.Find("input.forma-search-toolbar-search");
        }

        [Fact]
        public void Should_name_the_search_field_with_its_placeholder()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" SearchPlaceholder="Search..." />);

            // Assert
            var input = cut.Find("input");
            Assert.Multiple(
                () => Assert.Equal("Search...", input.GetAttribute("placeholder")),
                () => Assert.Equal("Search...", input.GetAttribute("aria-label")));
        }

        [Fact]
        public void Should_not_render_actions_without_items()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" SearchPlaceholder="Search..." />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-search-toolbar-items"));
        }

        [Fact]
        public async Task Should_invoke_callback_with_input_value()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            var received = new List<string>();
            var cut = ctx.Render(
                @<FormaSearchToolbar OnSearch="@((string v) => { received.Add(v); return Task.CompletedTask; })" SearchPlaceholder="Search..." SearchDelay="@TimeSpan.Zero" />);

            // Act
            await cut.Find("input").TriggerEventAsync("oninput", new ChangeEventArgs { Value = "hello" });
            await Task.Delay(50, Xunit.TestContext.Current.CancellationToken);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Single(received);
                Assert.Equal("hello", received[0]);
            });
        }

        [Fact]
        public async Task Should_raise_only_the_last_value_when_typing_does_not_settle()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            var received = new List<string>();
            var cut = ctx.Render(
                @<FormaSearchToolbar OnSearch="@((string v) => { received.Add(v); return Task.CompletedTask; })" SearchPlaceholder="Search..." SearchDelay="@TimeSpan.FromMilliseconds(40)" />);
            var input = cut.Find("input");

            // Act
            var first = input.TriggerEventAsync("oninput", new ChangeEventArgs { Value = "h" });
            var second = input.TriggerEventAsync("oninput", new ChangeEventArgs { Value = "he" });
            var third = input.TriggerEventAsync("oninput", new ChangeEventArgs { Value = "hello" });
            await Task.WhenAll(first, second, third);
            await Task.Delay(200, Xunit.TestContext.Current.CancellationToken);

            // Assert
            Assert.Equal(["hello"], received);
        }

        [Fact]
        public void Should_render_actions_beside_the_search_field()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            IReadOnlyList<FormaToolbarItem> actions = [new FormaToolbarCommand { Id = "add", Title = "Add", Command = "add" }];

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" SearchPlaceholder="Search..." Label="Actions" Items="actions" />);

            // Assert
            cut.Find("input.forma-search-toolbar-search");
            Assert.Equal("Add", cut.Find(".forma-search-toolbar-items button").TextContent);
        }

        [Fact]
        public void Should_invoke_on_command_when_an_action_is_clicked()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            IReadOnlyList<FormaToolbarItem> actions = [new FormaToolbarCommand { Id = "add", Title = "Add", Command = "add.new" }];
            string? invoked = null;

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" SearchPlaceholder="Search..." Label="Actions" Items="actions" OnCommand="c => invoked = c" />);
            cut.Find(".forma-search-toolbar-items button").Click();

            // Assert
            Assert.Equal("add.new", invoked);
        }

        [Fact]
        public void Should_require_a_label_when_actions_are_given()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            IReadOnlyList<FormaToolbarItem> actions = [new FormaToolbarCommand { Id = "add", Title = "Add", Command = "add" }];

            // Act
            var render = () => ctx.Render(@<FormaSearchToolbar OnSearch="Noop" SearchPlaceholder="Search..." Items="actions" />);

            // Assert
            Assert.Throws<ArgumentNullException>(render);
        }

        [Fact]
        public void Should_require_a_search_handler()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var render = () => ctx.Render<FormaSearchToolbar>(parameters => parameters
                .Add(p => p.SearchPlaceholder, "Search..."));

            // Assert
            Assert.Throws<ArgumentException>(render);
        }

        [Fact]
        public void Should_require_a_search_placeholder()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var render = () => ctx.Render<FormaSearchToolbar>(parameters => parameters
                .Add(p => p.OnSearch, (string _) => { }));

            // Assert
            Assert.Throws<ArgumentNullException>(render);
        }

        [Fact]
        public void Should_reject_negative_search_delay()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var render = () => ctx.Render(
                @<FormaSearchToolbar OnSearch="Noop" SearchPlaceholder="Search..." SearchDelay="@TimeSpan.FromMilliseconds(-1)" />);

            // Assert
            Assert.Throws<ArgumentOutOfRangeException>(render);
        }

        private static Task Noop(string value)
            => Task.CompletedTask;
    }
}
