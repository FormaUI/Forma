@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_be_shown_by_default()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();

            // Act
            var cut = ctx.Render(@<FormaCommandBar />);

            // Assert
            var wrapper = cut.Find(".forma-visibility");
            Assert.Multiple(
                () => Assert.Contains("is-shown", wrapper.ClassList),
                () => Assert.False(wrapper.HasAttribute("inert")));
        }

        [Fact]
        public void Should_be_inert_and_not_shown_when_hidden()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();

            // Act
            var cut = ctx.Render(@<FormaCommandBar Hidden="true" />);

            // Assert
            var wrapper = cut.Find(".forma-visibility");
            Assert.Multiple(
                () => Assert.DoesNotContain("is-shown", wrapper.ClassList),
                () => Assert.True(wrapper.HasAttribute("inert")));
        }

        [Fact]
        public void Should_not_animate_by_default()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();

            // Act
            var cut = ctx.Render(@<FormaCommandBar />);

            // Assert
            Assert.DoesNotContain("is-animated", cut.Find(".forma-visibility").ClassList);
        }

        [Fact]
        public void Should_animate_when_requested()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();

            // Act
            var cut = ctx.Render(@<FormaCommandBar Animated="true" />);

            // Assert
            Assert.Contains("is-animated", cut.Find(".forma-visibility").ClassList);
        }

        [Fact]
        public void Should_render_commands_on_the_track()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();

            // Act
            var cut = ctx.Render(
                @<FormaCommandBar>
                    <button>Upload</button>
                </FormaCommandBar>);

            // Assert
            Assert.Equal("Upload", cut.Find(".forma-command-bar .forma-command-bar-track button").TextContent);
        }

        [Fact]
        public void Should_not_render_arrows_while_the_commands_fit()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();

            // Act
            var cut = ctx.Render(
                @<FormaCommandBar>
                    <button>Upload</button>
                </FormaCommandBar>);

            // Assert
            Assert.Empty(cut.FindAll(".forma-command-bar-scroll"));
        }

        [Fact]
        public void Should_render_both_arrows_once_the_commands_overflow()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();
            var cut = ctx.Render(
                @<FormaCommandBar>
                    <button>Upload</button>
                </FormaCommandBar>);

            // Act
            _ = cut.FindComponent<FormaCommandBar>().Instance.HandleOverflowAsync(canScrollBack: false, canScrollForward: true);

            // Assert
            cut.WaitForAssertion(() => Assert.Equal(2, cut.FindAll(".forma-command-bar-scroll").Count));
        }

        [Fact]
        public void Should_disable_the_back_arrow_at_the_start_of_the_bar()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();
            var cut = ctx.Render(
                @<FormaCommandBar>
                    <button>Upload</button>
                </FormaCommandBar>);

            // Act
            _ = cut.FindComponent<FormaCommandBar>().Instance.HandleOverflowAsync(canScrollBack: false, canScrollForward: true);

            // Assert
            cut.WaitForAssertion(() =>
            {
                Assert.True(cut.Find(".forma-command-bar-scroll-back").HasAttribute("disabled"));
                Assert.False(cut.Find(".forma-command-bar-scroll-forward").HasAttribute("disabled"));
            });
        }

        [Fact]
        public void Should_disable_the_forward_arrow_at_the_end_of_the_bar()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();
            var cut = ctx.Render(
                @<FormaCommandBar>
                    <button>Upload</button>
                </FormaCommandBar>);

            // Act
            _ = cut.FindComponent<FormaCommandBar>().Instance.HandleOverflowAsync(canScrollBack: true, canScrollForward: false);

            // Assert
            cut.WaitForAssertion(() =>
            {
                Assert.False(cut.Find(".forma-command-bar-scroll-back").HasAttribute("disabled"));
                Assert.True(cut.Find(".forma-command-bar-scroll-forward").HasAttribute("disabled"));
            });
        }

        [Fact]
        public void Should_drop_the_arrows_again_once_the_bar_fits()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();
            var cut = ctx.Render(
                @<FormaCommandBar>
                    <button>Upload</button>
                </FormaCommandBar>);
            _ = cut.FindComponent<FormaCommandBar>().Instance.HandleOverflowAsync(canScrollBack: true, canScrollForward: true);
            cut.WaitForAssertion(() => Assert.NotEmpty(cut.FindAll(".forma-command-bar-scroll")));

            // Act
            _ = cut.FindComponent<FormaCommandBar>().Instance.HandleOverflowAsync(canScrollBack: false, canScrollForward: false);

            // Assert
            cut.WaitForAssertion(() => Assert.Empty(cut.FindAll(".forma-command-bar-scroll")));
        }

        [Fact]
        public void Should_name_the_arrows_from_the_localizer()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();
            var cut = ctx.Render(
                @<FormaCommandBar>
                    <button>Upload</button>
                </FormaCommandBar>);

            // Act
            _ = cut.FindComponent<FormaCommandBar>().Instance.HandleOverflowAsync(canScrollBack: true, canScrollForward: true);

            // Assert
            cut.WaitForAssertion(() =>
            {
                Assert.Equal("Scroll Commands Back", cut.Find(".forma-command-bar-scroll-back").GetAttribute("aria-label"));
                Assert.Equal("Scroll Commands Forward", cut.Find(".forma-command-bar-scroll-forward").GetAttribute("aria-label"));
            });
        }

        [Fact]
        public void Should_let_the_caller_name_the_arrows()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();
            var cut = ctx.Render(
                @<FormaCommandBar ScrollBackLabel="Earlier filters" ScrollForwardLabel="Later filters">
                    <button>Upload</button>
                </FormaCommandBar>);

            // Act
            _ = cut.FindComponent<FormaCommandBar>().Instance.HandleOverflowAsync(canScrollBack: true, canScrollForward: true);

            // Assert
            cut.WaitForAssertion(() =>
            {
                Assert.Equal("Earlier filters", cut.Find(".forma-command-bar-scroll-back").GetAttribute("aria-label"));
                Assert.Equal("Later filters", cut.Find(".forma-command-bar-scroll-forward").GetAttribute("aria-label"));
            });
        }

        [Fact]
        public void Should_render_trailing_content_past_the_track()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();

            // Act
            var cut = ctx.Render(
                @<FormaCommandBar>
                    <ChildContent>
                        <button>Upload</button>
                    </ChildContent>
                    <TrailingContent>
                        <span class="pinned">Pinned</span>
                    </TrailingContent>
                </FormaCommandBar>);

            // Assert
            Assert.NotNull(cut.Find(".forma-command-bar .pinned"));
        }

        [Fact]
        public void Should_merge_custom_class_with_forma_command_bar()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();

            // Act
            var cut = ctx.Render(@<FormaCommandBar Class="demo-filters" />);

            // Assert
            var classes = cut.Find(".forma-command-bar").ClassList;
            Assert.Multiple(() =>
            {
                Assert.Contains("forma-command-bar", classes);
                Assert.Contains("demo-filters", classes);
            });
        }

        [Fact]
        public void Should_pass_through_unmatched_attributes()
        {
            // Arrange
            using var ctx = new FormaCommandBarTests();

            // Act
            var cut = ctx.Render(@<FormaCommandBar aria-label="Filters" />);

            // Assert
            Assert.Equal("Filters", cut.Find(".forma-command-bar").GetAttribute("aria-label"));
        }
    }
}
