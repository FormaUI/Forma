@inherits BunitContext

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_draw_every_glyph_in_the_enum()
        {
            // Arrange
            using var ctx = new FormaGlyphTests();

            // Act & Assert
            foreach (var glyph in Enum.GetValues<Glyph>())
            {
                var cut = ctx.Render(@<FormaGlyph Name="glyph" />);

                Assert.False(
                    string.IsNullOrWhiteSpace(cut.Find("svg path").GetAttribute("d")),
                    $"{glyph} drew nothing; it is missing a switch arm.");
            }
        }

        [Fact]
        public void Should_draw_a_different_shape_for_each_glyph()
        {
            // Arrange
            using var ctx = new FormaGlyphTests();
            var shapes = new HashSet<string>(StringComparer.Ordinal);

            // Act & Assert
            foreach (var glyph in Enum.GetValues<Glyph>())
            {
                var cut = ctx.Render(@<FormaGlyph Name="glyph" />);

                Assert.True(
                    shapes.Add(cut.Find("svg").InnerHtml),
                    $"{glyph} draws the same shape as an earlier glyph.");
            }
        }

        [Fact]
        public void Should_hide_itself_from_assistive_technology()
        {
            // Arrange
            using var ctx = new FormaGlyphTests();

            // Act
            var cut = ctx.Render(@<FormaGlyph Name="Glyph.Check" />);

            // Assert
            var svg = cut.Find("svg");
            Assert.Equal("true", svg.GetAttribute("aria-hidden"));
            Assert.Equal("false", svg.GetAttribute("focusable"));
        }

        [Fact]
        public void Should_fill_itself_with_the_current_text_colour()
        {
            // Arrange
            using var ctx = new FormaGlyphTests();

            // Act
            var cut = ctx.Render(@<FormaGlyph Name="Glyph.Trash" />);

            // Assert
            Assert.Equal("currentColor", cut.Find("svg").GetAttribute("fill"));
        }

        [Fact]
        public void Should_render_the_supplied_class_beside_its_own()
        {
            // Arrange
            using var ctx = new FormaGlyphTests();

            // Act
            var cut = ctx.Render(@<FormaGlyph Name="Glyph.Folder" Class="my-icon" />);

            // Assert
            var svg = cut.Find("svg");
            Assert.Contains("forma-glyph", svg.ClassName, StringComparison.Ordinal);
            Assert.Contains("my-icon", svg.ClassName, StringComparison.Ordinal);
        }
    }
}
