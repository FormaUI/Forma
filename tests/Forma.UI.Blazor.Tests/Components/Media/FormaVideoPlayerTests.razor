        [Fact]
        public void Should_name_the_play_control_by_its_action_and_describe_what_it_costs()
        {
            // Arrange
            using var ctx = new FormaVideoPlayerTests();

            // Act
            var cut = ctx.Render(@<FormaVideoPlayer Source="https://youtu.be/dQw4w9WgXcQ" Title="A video" />);
            var control = cut.Find("button.forma-video-player-facade");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(cut.Find(".forma-video-player-facade-label").Id, control.GetAttribute("aria-labelledby"));
                Assert.Equal(cut.Find(".forma-video-player-facade-note").Id, control.GetAttribute("aria-describedby"));
            });
