        [Fact]
        public void Should_render_a_track_for_each_caption()
        {
            // Arrange
            using var ctx = new FormaVideoPlayerTests();
            var captions = new List<VideoCaptionTrack>
            {
                new("/media/en.vtt", "en", "English") { IsDefault = true },
                new("/media/es.vtt", "es", "Español"),
            };

            // Act
            var cut = ctx.Render(@<FormaVideoPlayer Source="/media/stage-1.mp4" Title="Stage 1" Captions="captions" />);
            var tracks = cut.FindAll("track");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(2, tracks.Count);
                Assert.Equal("captions", tracks[0].GetAttribute("kind"));
                Assert.Equal("/media/en.vtt", tracks[0].GetAttribute("src"));
                Assert.Equal("en", tracks[0].GetAttribute("srclang"));
                Assert.Equal("English", tracks[0].GetAttribute("label"));
            });
        }

