@inherits BunitContext

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_an_item_as_a_button()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items = [new() { Id = "bold", Title = "Bold", Command = "bold" }];

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" />);

            // Assert
            Assert.NotNull(cut.Find("button[aria-label=Bold]"));
        }

        [Fact]
        public void Should_invoke_on_command_when_an_item_is_clicked()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items = [new() { Id = "bold", Title = "Bold", Command = "format.bold" }];
            string? invoked = null;
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" OnCommand="c => invoked = c" />);

            // Act
            cut.Find("button[aria-label=Bold]").Click();

            // Assert
            Assert.Equal("format.bold", invoked);
        }

        [Fact]
        public void Should_separate_groups_with_their_own_wrapper()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items =
            [
                new() { Id = "bold", Title = "Bold", Command = "bold", Group = "inline" },
                new() { Id = "italic", Title = "Italic", Command = "italic", Group = "inline" },
                new() { Id = "align-left", Title = "Align Left", Command = "align-left", Group = "align" },
            ];

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" />);

            // Assert
            Assert.Equal(2, cut.FindAll(".forma-toolbar-group").Count);
        }

        [Fact]
        public void Should_mark_an_active_toggle_item_pressed()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items = [new() { Id = "bold", Title = "Bold", Command = "bold", IsToggle = true, IsActive = true }];

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" />);

            // Assert
            var button = cut.Find("button[aria-label=Bold]");
            Assert.Multiple(
                () => Assert.Equal("true", button.GetAttribute("aria-pressed")),
                () => Assert.Contains("forma-toolbar-button-active", button.ClassList));
        }

        [Fact]
        public void Should_not_mark_an_inactive_toggle_item_pressed()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items = [new() { Id = "bold", Title = "Bold", Command = "bold", IsToggle = true, IsActive = false }];

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" />);

            // Assert
            var button = cut.Find("button[aria-label=Bold]");
            Assert.Multiple(
                () => Assert.Equal("false", button.GetAttribute("aria-pressed")),
                () => Assert.DoesNotContain("forma-toolbar-button-active", button.ClassList));
        }

        [Fact]
        public void Should_show_the_shortcut_in_the_tooltip()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items = [new() { Id = "bold", Title = "Bold", Command = "bold", ShortcutDisplay = "Ctrl+B" }];

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" />);

            // Assert
            Assert.Equal("Bold (Ctrl+B)", cut.Find("button[aria-label=Bold]").GetAttribute("title"));
        }

        [Fact]
        public void Should_render_an_item_with_options_as_a_menu()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items =
            [
                new()
                {
                    Id = "align",
                    Title = "Align",
                    Options =
                    [
                        new() { Id = "left", Title = "Left", Command = "align.left", IsActive = true },
                        new() { Id = "right", Title = "Right", Command = "align.right" },
                    ],
                },
            ];

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" />);

            // Assert
            Assert.Equal("Left", cut.Find(".forma-toolbar-menu-value").TextContent);
        }

        [Fact]
        public void Should_invoke_on_command_when_an_option_is_picked()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items =
            [
                new()
                {
                    Id = "align",
                    Title = "Align",
                    Options =
                    [
                        new() { Id = "left", Title = "Left", Command = "align.left", IsActive = true },
                        new() { Id = "right", Title = "Right", Command = "align.right" },
                    ],
                },
            ];
            string? invoked = null;
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" OnCommand="c => invoked = c" />);

            // Act
            cut.Find(".forma-toolbar-menu.forma-dropdown-menu-trigger").Click();
            cut.FindAll(".forma-dropdown-menu-item")[1].Click();

            // Assert
            Assert.Equal("align.right", invoked);
        }

        [Fact]
        public void Should_render_a_swatch_when_the_active_option_carries_one()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items =
            [
                new()
                {
                    Id = "color",
                    Title = "Color",
                    Options = [new() { Id = "red", Title = "Red", Command = "color.red", IsActive = true, Swatch = "#d32f2f" }],
                },
            ];

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" />);

            // Assert
            Assert.Contains("background-color:#d32f2f", cut.Find(".forma-toolbar-menu-bar").GetAttribute("style"));
        }

        [Fact]
        public void Should_render_a_custom_component_in_place_of_a_button()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items = [new() { Id = "clock", Title = "Clock", CustomComponent = typeof(FormaGlyph) }];

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" />);

            // Assert
            Assert.Empty(cut.FindAll("button[aria-label=Clock]"));
            Assert.NotNull(cut.FindComponent<FormaGlyph>());
        }

        [Fact]
        public void Should_disable_every_item_when_the_toolbar_is_disabled()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            IReadOnlyList<FormaToolbarItem> items = [new() { Id = "bold", Title = "Bold", Command = "bold" }];

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" Disabled="true" />);

            // Assert
            Assert.True(cut.Find("button[aria-label=Bold]").HasAttribute("disabled"));
        }

        [Fact]
        public void Should_render_trailing_content_past_the_track()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();

            // Act
            var cut = ctx.Render(
                @<FormaToolbar Label="Formatting">
                    <TrailingContent>
                        <span class="pinned">Pinned</span>
                    </TrailingContent>
                </FormaToolbar>);

            // Assert
            Assert.NotNull(cut.Find(".pinned"));
        }

        [Fact]
        public void Should_keep_a_menu_with_its_own_item_when_an_earlier_item_is_removed()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            FormaToolbarItem MenuItem(string id) => new()
            {
                Id = id,
                Title = id,
                Options = [new() { Id = $"{id}-only", Title = id, Command = $"{id}.pick", IsActive = true }],
            };
            IReadOnlyList<FormaToolbarItem> items = [MenuItem("first"), MenuItem("second")];
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="items" />);
            cut.FindAll(".forma-dropdown-menu-trigger")[1].Click();

            // Act
            cut.FindComponent<FormaToolbar>()
               .Render(parameters => parameters.Add(p => p.Items, [MenuItem("second")]));

            // Assert
            var trigger = cut.Find(".forma-dropdown-menu-trigger");
            Assert.Multiple(
                () => Assert.Equal("second", trigger.GetAttribute("aria-label")),
                () => Assert.Equal("true", trigger.GetAttribute("aria-expanded")));
        }

        [Fact]
        public void Should_require_a_label()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();

            // Act
            var render = () => ctx.Render(@<FormaToolbar Label="" />);

            // Assert
            Assert.Throws<ArgumentException>(render);
        }
    }
}
