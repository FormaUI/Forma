        [Fact]
        public void Should_keep_a_pushed_status_item_visible_after_switching_editors()
        {
            // Arrange
            using var ctx = new FormaComposerTests();
            var model = new TestModel();
            IReadOnlyList<IComposerPlugin> plugins = [new PlainTextEditorPlugin(), new DummyEditorPlugin(), new StatusPushingPlugin()];
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="plugins" />);
            cut.Find("button[aria-label='Word Count']").Click();
            cut.WaitForAssertion(() => Assert.NotEmpty(cut.FindAll(".forma-composer-status-strip")));

            // Act
            cut.FindAll("[role=tab]")[1].Click();

            // Assert
            cut.WaitForAssertion(() => Assert.Equal("2 words", cut.Find(".forma-composer-status-strip").TextContent.Trim()));
        }
    }
}
