        private sealed class CommandPlugin : IComposerPlugin
        {
            public string Id => "commands";
            public List<string> Executed { get; } = [];
            public IReadOnlyList<ComposerToolbarItem> ToolbarItems =>
                [new() { Id = "shout", Title = "Shout", Icon = Glyph.File, Command = "demo.shout" }];
            public IReadOnlyList<ComposerKeyBinding> KeyBindings =>
                [new() { Key = "k", Command = "demo.shout", Control = true, Shift = true }];
            public IReadOnlyList<ComposerInputTrigger> InputTriggers => [];
            public IReadOnlyList<ComposerAsset> Assets => [];
            public ValueTask<bool> IsAvailableAsync(CancellationToken cancellationToken = default) => ValueTask.FromResult(true);

            public ValueTask ExecuteAsync(string command, ComposerContext context, CancellationToken cancellationToken = default)
            {
                Executed.Add(command);
                return ValueTask.CompletedTask;
            }
        }

        private sealed class SlowPlugin : IComposerPlugin
        {
            public string Id => "slow";
            public IReadOnlyList<ComposerToolbarItem> ToolbarItems => [];
            public IReadOnlyList<ComposerKeyBinding> KeyBindings => [];
            public IReadOnlyList<ComposerInputTrigger> InputTriggers => [];
            public IReadOnlyList<ComposerAsset> Assets => [];

            public async ValueTask<bool> IsAvailableAsync(CancellationToken cancellationToken = default)
            {
                await Task.Yield();
                return true;
            }
        }

        private sealed class ScopedPlugin : IComposerPlugin
        {
            public string Id => "scoped";
            public IReadOnlyList<string> SupportedEditorIds => ["dummy"];
            public IReadOnlyList<ComposerToolbarItem> ToolbarItems =>
                [new() { Id = "scoped", Title = "Scoped", Icon = Glyph.File, Command = "demo.scoped" }];
            public IReadOnlyList<ComposerKeyBinding> KeyBindings => [];
            public IReadOnlyList<ComposerInputTrigger> InputTriggers => [];
            public IReadOnlyList<ComposerAsset> Assets => [];
            public ValueTask<bool> IsAvailableAsync(CancellationToken cancellationToken = default) => ValueTask.FromResult(true);
        }

        // Pushes a status item on command, proving the region registry is a composer-level capability
        // rather than something an editor plugin has to implement for itself.
        private sealed class StatusPushingPlugin : IComposerPlugin
        {
            private IComposerStatusItem? _item;

            public string Id => "status";
            public IReadOnlyList<ComposerToolbarItem> ToolbarItems =>
                [new() { Id = "wordcount", Title = "Word Count", Icon = Glyph.File, Command = "demo.wordcount" }];
            public IReadOnlyList<ComposerKeyBinding> KeyBindings => [];
            public IReadOnlyList<ComposerInputTrigger> InputTriggers => [];
            public IReadOnlyList<ComposerAsset> Assets => [];
            public ValueTask<bool> IsAvailableAsync(CancellationToken cancellationToken = default) => ValueTask.FromResult(true);

            public ValueTask ExecuteAsync(string command, ComposerContext context, CancellationToken cancellationToken = default)
            {
                var count = context.Document.Content.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
                var text = $"{count} words";

                if (_item is null)
                {
                    _item = context.Regions.CreateStatusItem(text);
                }
                else
                {
                    _item.Text = text;
                }

                return ValueTask.CompletedTask;
            }
        }

