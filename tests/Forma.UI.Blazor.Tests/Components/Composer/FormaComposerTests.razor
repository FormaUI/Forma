        // Pushes a status item on command, proving the region registry is a composer-level capability
        // rather than something an editor plugin has to implement for itself.
        private sealed class StatusPushingPlugin : IComposerPlugin
        {
            private IComposerStatusItem? _item;

            public string Id => "status";
            public IReadOnlyList<ComposerToolbarItem> Items =>
                [new(ComposerRows.Plugins, [new FormaToolbarCommand { Id = "wordcount", Title = "Word Count", Icon = Glyph.File, Command = "demo.wordcount" }])];
            public IReadOnlyList<ComposerKeyBinding> KeyBindings => [];
            public IReadOnlyList<ComposerInputTrigger> InputTriggers => [];
            public IReadOnlyList<ComposerAsset> Assets => [];
            public ValueTask<bool> IsAvailableAsync(CancellationToken cancellationToken = default) => ValueTask.FromResult(true);

            public ValueTask ExecuteAsync(string command, ComposerContext context, CancellationToken cancellationToken = default)
            {
                var count = context.Document.Content.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
                var text = $"{count} words";

                if (_item is null)
                {
                    _item = context.Regions.CreateStatusItem(text);
                }
                else
                {
                    _item.Text = text;
                }

                return ValueTask.CompletedTask;
            }
        }

        // Pushes a status item that opts into being announced, unlike the frequently updating readout above.
        private sealed class AnnouncingStatusPlugin : IComposerPlugin
        {
            public string Id => "announcing";
            public IReadOnlyList<ComposerToolbarItem> Items =>
                [new(ComposerRows.Plugins, [new FormaToolbarCommand { Id = "save", Title = "Save", Icon = Glyph.File, Command = "demo.save" }])];
            public IReadOnlyList<ComposerKeyBinding> KeyBindings => [];
            public IReadOnlyList<ComposerInputTrigger> InputTriggers => [];
            public IReadOnlyList<ComposerAsset> Assets => [];
            public ValueTask<bool> IsAvailableAsync(CancellationToken cancellationToken = default) => ValueTask.FromResult(true);

            public ValueTask ExecuteAsync(string command, ComposerContext context, CancellationToken cancellationToken = default)
            {
                var item = context.Regions.CreateStatusItem("Saved");
                item.IsAnnounced = true;

                return ValueTask.CompletedTask;
            }
        }

