@inherits FormaBunitContext
@using Forma.UI.Style.Css

@code {
    public sealed class Component
    {
        private static readonly CssColor Background = CssColor.FromHex(0xe6f5ea);
        private static readonly CssColor Foreground = CssColor.FromHex(0x1c7430);
        [Fact]
        public void Should_render_text()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Published" />);

            // Assert
            Assert.Equal("Published", cut.Find(".forma-status-badge").TextContent);
        }

        [Fact]
        public void Should_mark_the_status_without_relying_on_colour()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();
            var expected = ctx.Render(@<FormaIcon Icon="Glyph.Check" />).Find("path").GetAttribute("d");

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Published" Marker="Glyph.Check" />);
            var marker = cut.Find(".forma-status-badge-marker");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(expected, marker.QuerySelector("svg path")!.GetAttribute("d"));
                Assert.Equal("true", marker.GetAttribute("aria-hidden"));
            });
        }

        [Fact]
        public void Should_omit_the_marker_when_none_is_given()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Draft" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-status-badge-marker"));
        }

        [Fact]
        public void Should_render_as_a_span()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Draft" />);

            // Assert
            Assert.Equal("SPAN", cut.Find(".forma-status-badge").TagName);
        }

        [Fact]
        public void Should_render_without_colours_when_none_apply()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Draft" />);

            // Assert
            Assert.False(cut.Find(".forma-status-badge").HasAttribute("style"));
        }

        [Fact]
        public void Should_take_colours_from_a_registered_status()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();
            ctx.Services.GetRequiredService<IStatusBadgeCatalog>()
                .Add(new("published", Background, Foreground));

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Published" Status="published" />);
            var style = cut.Find(".forma-status-badge").GetAttribute("style");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("--forma-status-badge-background-color: #e6f5ea;", style, StringComparison.Ordinal);
                Assert.Contains("--forma-status-badge-foreground-color: #1c7430;", style, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_match_a_registered_status_regardless_of_casing()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();
            ctx.Services.GetRequiredService<IStatusBadgeCatalog>()
                .Add(new("Published", Background, Foreground));

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Published" Status="PUBLISHED" />);

            // Assert
            Assert.Contains("#e6f5ea", cut.Find(".forma-status-badge").GetAttribute("style"), StringComparison.Ordinal);
        }

        [Fact]
        public void Should_fall_back_to_default_colours_for_an_unknown_status()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Mystery" Status="not-registered" />);

            // Assert
            Assert.False(cut.Find(".forma-status-badge").HasAttribute("style"));
        }

        [Fact]
        public void Should_apply_explicit_colours()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Shipped"
                                                    Background="CssColor.FromRgba(111, 66, 193, 0.14)"
                                                    Foreground="CssColor.FromHex(0x59359a)" />);
            var style = cut.Find(".forma-status-badge").GetAttribute("style");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("--forma-status-badge-background-color: rgba(111, 66, 193, 0.14);", style, StringComparison.Ordinal);
                Assert.Contains("--forma-status-badge-foreground-color: #59359a;", style, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_let_explicit_colours_win_over_the_catalog()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();
            ctx.Services.GetRequiredService<IStatusBadgeCatalog>()
                .Add(new("published", Background, Foreground));

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Published" Status="published"
                                                    Background="CssColor.FromHex(0x000000)" />);
            var style = cut.Find(".forma-status-badge").GetAttribute("style");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("--forma-status-badge-background-color: #000000;", style, StringComparison.Ordinal);
                Assert.Contains("--forma-status-badge-foreground-color: #1c7430;", style, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_keep_base_class_when_host_adds_its_own()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Refunded" class="coi-order-status" />);
            var span = cut.Find("span");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("forma-status-badge", span.ClassList);
                Assert.Contains("coi-order-status", span.ClassList);
            });
        }

        [Fact]
        public void Should_keep_colours_when_host_adds_its_own_style()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Live"
                                                    Background="CssColor.FromHex(0xffeeee)"
                                                    style="text-transform: uppercase" />);
            var style = cut.Find(".forma-status-badge").GetAttribute("style");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("--forma-status-badge-background-color: #ffeeee;", style, StringComparison.Ordinal);
                Assert.Contains("text-transform: uppercase", style, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_pass_additional_attributes()
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act
            var cut = ctx.Render(@<FormaStatusBadge Text="Live" title="Broadcasting now" />);

            // Assert
            Assert.Equal("Broadcasting now", cut.Find(".forma-status-badge").GetAttribute("title"));
        }

        [Theory]
        [InlineData(null)]
        [InlineData("")]
        [InlineData("   ")]
        public void Should_reject_invalid_text(string? text)
        {
            // Arrange
            using var ctx = new FormaStatusBadgeTests();

            // Act & Assert
            Assert.ThrowsAny<ArgumentException>(() => ctx.Render<FormaStatusBadge>(p => p
                .Add(b => b.Text, text!)));
        }
    }
}
