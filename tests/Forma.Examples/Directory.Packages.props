<Project>

    <!--
        Forma Example Package Versions

        The framework's packages at the versions the repository builds with, and Forma's at the version the
        gate packs them at, which only the examples use.
    -->

    <Import Project="..\..\Directory.Packages.props" />

    <PropertyGroup>
        <FormaVersion Condition="'$(FormaVersion)' == ''">1.0.0-examples</FormaVersion>
    </PropertyGroup>

    <!-- The Windows Forms web view, which only an example uses, at the WPF one's version. -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="11.0.0-rc.2.26505.5" />
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="formaui-net.Blazor.Server" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.Blazor.WebAssembly" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.Blazor.WebView" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.AddOns.Operations.Maui" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.Blazor.Locales.Hebrew" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.Framework.Localization.Json" Version="$(FormaVersion)" />
    </ItemGroup>

</Project>
