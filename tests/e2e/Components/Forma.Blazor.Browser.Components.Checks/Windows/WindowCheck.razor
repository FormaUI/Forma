@page "/{Runtime}/window"

@* Two overlapping windows and a modal one, each opened by a button, the workspace's current one and Alpha's placement shown where the check reads them. *@
<FormaButton Id="open-alpha" OnClick="@(() => _isAlphaOpen = true)">Open Alpha</FormaButton>
<FormaButton Id="open-beta" OnClick="@(() => _isBetaOpen = true)">Open Beta</FormaButton>
<FormaButton Id="open-modal" OnClick="@(() => _isModalOpen = true)">Open Modal</FormaButton>
@if (_isAlphaOpen)
{
    <FormaWindow Id="alpha"
                 Title="Alpha"
                 @bind-Placement="_alphaPlacement"
                 ActiveChanged="@(active => Track("Alpha", active))"
                 OnClose="@(() => _isAlphaOpen = false)">
        <Body>The first window</Body>
    </FormaWindow>
}
@if (_isBetaOpen)
{
    <FormaWindow Id="beta"
                 Title="Beta"
                 Placement="BetaPlacement"
                 ActiveChanged="@(active => Track("Beta", active))"
                 OnClose="@(() => _isBetaOpen = false)">
        <Body>The second window</Body>
    </FormaWindow>
}
@if (_isModalOpen)
{
    <FormaWindow Id="modal"
                 Title="Confirm"
                 Modal="true"
                 Placement="ModalPlacement"
                 OnClose="@(() => _isModalOpen = false)">
        <Body>
            <FormaButton Id="modal-first">First</FormaButton>
            <FormaButton Id="modal-last">Last</FormaButton>
        </Body>
    </FormaWindow>
}
<output id="result">@_current</output>
<output id="placement">@FormatPlacement(_alphaPlacement)</output>

@code {
    // Beta overlaps the lower right of Alpha, leaving Alpha's left part and its title bar uncovered.
    private static readonly FramePlacement BetaPlacement = new(240, 200, 360, 240);
    private static readonly FramePlacement ModalPlacement = new(200, 160, 320, 200);

    private FramePlacement? _alphaPlacement = new(40, 120, 360, 240);
    private bool _isAlphaOpen;
    private bool _isBetaOpen;
    private bool _isModalOpen;
    private string? _current;

    [Parameter] public string Runtime { get; set; } = default!;

    private static string FormatPlacement(FramePlacement? placement)
        => placement is { } shown
            ? string.Create(CultureInfo.InvariantCulture, $"{shown.Left},{shown.Top},{shown.Width},{shown.Height}")
            : string.Empty;

    private void Track(string title, bool active)
    {
        if (active)
        {
            _current = title;
        }
        else if (_current == title)
        {
            _current = null;
        }
    }
}
