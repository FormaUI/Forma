@page "/{Runtime}/toast-container"
@using Forma.Framework.Feedback
@inject IToastService ToastService

@* Toasts raised through the toast service from buttons, one held until dismissed and one leaving on its own, drawn by the container the page places. *@
<FormaButton Id="save" OnClick="SaveAsync">Save Draft</FormaButton>
<FormaButton Id="publish" OnClick="PublishAsync">Publish</FormaButton>
<div id="toasts">
    <FormaToastContainer />
</div>

@code {
    [Parameter] public string Runtime { get; set; } = default!;

    // Long enough that the toast leaves only when the check dismisses it.
    private Task SaveAsync()
        => ToastService.ShowAsync("Draft saved.", ToastType.Success, TimeSpan.FromMinutes(5));

    // A toast that leaves on its own, which the check records showing and leaving.
    private Task PublishAsync()
        => ToastService.ShowAsync("Published.", ToastType.Info, TimeSpan.FromSeconds(2));
}
