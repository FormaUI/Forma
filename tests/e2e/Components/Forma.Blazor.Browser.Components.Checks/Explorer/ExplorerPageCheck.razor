@page "/{Runtime}/explorer-page"
@using Forma.Blazor.Components.Explorer
@using Forma.Framework.Catalog
@using Forma.Framework.Explorer
@using Forma.Framework.Explorer.Content.Queries
@using Forma.Framework.Resources

@* Two hundred files twenty to a page, at the explorer's own height, so on a phone the page scrolls its items and each further page is appended only as the page nears its end. *@
<FormaExplorer Id="check" Items="Items" PageSize="20" Options="PageOptions" />

@code {
    private static readonly ExplorerOptions PageOptions = ExplorerOptions.Default with { InfiniteScroll = ExplorerInfiniteScrollMode.Automatic };

    private static readonly IReadOnlyList<ICatalogItem> Items = CatalogItem.ForAll(
        Enumerable.Range(1, 200).Select(index => (ResourceInfo)new DocumentResourceInfo($"files/report-{index:000}.txt")));
}
