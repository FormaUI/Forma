@page "/{Runtime}/link-tabs"
@page "/{Runtime}/link-tabs/members"
@page "/{Runtime}/link-tabs/settings"

@* Tabs to the three pages of one section, its overview matched exactly. Going between them keeps the page and its parameters, so
   the tabs follow the address alone. *@
<FormaLinkTabs Id="link-tabs" Items="Tabs" Label="Section" />

@code {
    private LinkTab[] Tabs =>
    [
        new("Overview", $"{Runtime}/link-tabs") { Match = NavLinkMatch.All },
        new("Members", $"{Runtime}/link-tabs/members"),
        new("Settings", $"{Runtime}/link-tabs/settings") { Trailing = true },
    ];
}
