@page "/{Runtime}/pagination"

@* Two hundred items ten to a page, paged by its steps and by the wheel, and again by a page typed, each bound page shown where the check reads it. *@
<FormaPagination Id="pagination" TotalItemCount="200" PageSize="10" CurrentPage="_page" OnPageChanged="@(page => _page = page)" Options="WheelOptions" />
<output id="result">@_page</output>
<FormaPagination Id="entry" TotalItemCount="200" PageSize="10" CurrentPage="_entryPage" OnPageChanged="@(page => _entryPage = page)" Options="EntryOptions" />
<output id="entry-result">@_entryPage</output>

@code {
    private static readonly PaginationOptions WheelOptions = new() { PageOnWheelGesture = true };
    private static readonly PaginationOptions EntryOptions = new() { NavigationInput = true };
    private int _page = 1;
    private int _entryPage = 1;
}
