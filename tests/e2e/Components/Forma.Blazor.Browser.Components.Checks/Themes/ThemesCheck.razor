@page "/{Runtime}/themes"
@implements IDisposable
@using Forma.Blazor.Components.Themes
@using Forma.Framework.Themes
@inject IThemeState ThemeState
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@* Scopes naming a theme, a scheme or both, nested as a page nests them, and a reference for each theme in each scheme, an element
   naming both: each a span whose tokens a check reads where it stands. A button switches one scope's scheme. The contrast themes
   and Forma High Contrast are measured on the page. *@
<link rel="stylesheet" href="_content/Forma.Blazor.Browser.Components.Checks/check-theme.css" />
<link rel="stylesheet" href="_content/Forma.Blazor.Browser.Components.Checks/contrast-themes.css" />
<link rel="stylesheet" href="_content/Forma.Blazor/forma-high-contrast.css" />

<span id="unthemed"></span>
<FormaThemeScope Theme="forma"><span id="forma-in-root"></span></FormaThemeScope>

<div data-forma-theme="forma" data-forma-scheme="light"><span id="forma-light"></span></div>
<div data-forma-theme="forma" data-forma-scheme="dark"><span id="forma-dark"></span></div>
<div data-forma-theme="check" data-forma-scheme="light"><span id="check-light"></span></div>
<div data-forma-theme="check" data-forma-scheme="dark"><span id="check-dark"></span></div>

<FormaThemeScope Theme="check" Scheme="ColorSchemePreference.Light">
    <span id="outer-light"></span>
    <FormaThemeScope Scheme="ColorSchemePreference.Dark">
        <span id="middle-dark"></span>
        <FormaThemeScope Scheme="ColorSchemePreference.Light"><span id="inner-light"></span></FormaThemeScope>
    </FormaThemeScope>
</FormaThemeScope>

<FormaThemeScope Theme="check" Scheme="ColorSchemePreference.Dark">
    <FormaThemeScope Scheme="ColorSchemePreference.System"><span id="system-in-dark"></span></FormaThemeScope>
</FormaThemeScope>

<FormaThemeScope Theme="check" Scheme="ColorSchemePreference.Light">
    <FormaThemeScope Scheme="ColorSchemePreference.Dark"><span id="scheme-only"></span></FormaThemeScope>
    <FormaThemeScope Theme="forma"><span id="theme-only"></span></FormaThemeScope>
</FormaThemeScope>

<FormaThemeScope Theme="check" Scheme="ColorSchemePreference.Dark">
    <FormaThemeScope Theme="forma">
        <span id="forma-in-check"></span>
        <FormaThemeScope Theme="check"><span id="check-in-forma"></span></FormaThemeScope>
    </FormaThemeScope>
</FormaThemeScope>

<FormaThemeScope Theme="check" Scheme="_switchedScheme"><span id="switched"></span></FormaThemeScope>
<button id="switch-scheme" type="button" data-check-scaffold @onclick="() => _switchedScheme = ColorSchemePreference.Dark">Switch to Dark</button>

@* The choice the page's runtime holds, and switches it requests through the page's theme coordinator, where its runtime has one. *@
<output id="theme-choice">@ThemeState.Choice.Theme @ThemeAttributes.GetSchemeValue(ThemeState.Choice.Scheme)</output>
<output id="theme-outcome">@_outcome</output>
<button id="switch-check-dark" type="button" data-check-scaffold @onclick="@(() => SwitchAsync(new ThemeChoice("check", ColorSchemePreference.Dark)))">Switch to Check, Dark</button>

@* A switch a statically rendered page posts, as a picker rendered statically does, back to this page. *@
<form id="switch-theme" method="post" action="_forma/themes">
    <AntiforgeryToken />
    <input type="hidden" name="theme" value="check" />
    <input type="hidden" name="scheme" value="light" />
    <input type="hidden" name="returnUrl" value="/static/themes" />
    <button type="submit">Switch to Check, Light</button>
</form>

@code {
    private ColorSchemePreference _switchedScheme = ColorSchemePreference.Light;
    private string? _outcome;

    protected override void OnInitialized()
        => ThemeState.Subscribe(RenderAgainAsync);

    public void Dispose()
        => ThemeState.Unsubscribe(RenderAgainAsync);

    private Task RenderAgainAsync()
        => InvokeAsync(StateHasChanged);

    private async Task SwitchAsync(ThemeChoice choice)
    {
        try
        {
            await (Services.GetService<IThemeSwitch>() ?? throw new InvalidOperationException("The runtime registers no theme switch.")).SwitchAsync(choice);
            _outcome = "accepted";
        }
        catch (Exception exception)
        {
            _outcome = exception.GetType().Name;
        }
    }
}
