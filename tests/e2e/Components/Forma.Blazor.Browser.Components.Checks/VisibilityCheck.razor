@page "/{Runtime}/visibility"

@* Content a button collapses and shows again, keeping what was typed into it while it was collapsed. *@
<FormaButton Id="toggle" OnClick="@(() => _isHidden = !_isHidden)">@(_isHidden ? "Show" : "Hide")</FormaButton>
<FormaVisibility Id="check" Hidden="_isHidden">
    <input id="inside" aria-label="Inside" />
</FormaVisibility>

@code {
    private bool _isHidden;
}
