@page "/{Runtime}/date-time-picker"

@* A date and time picker bound in a form at 14 March 2026 09:30, beside a button outside it, the value entered shown where the check reads it. *@
<EditForm Model="_model">
    <FormaDateTimePicker TValue="DateTime" Id="check" @bind-Value="_model.Start" Label="Start" />
</EditForm>
<button id="outside" type="button" data-check-scaffold>Outside</button>
<output id="result">@(_model.Start.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture))</output>

@code {
    private readonly Entry _model = new();

    private sealed class Entry
    {
        public DateTime Start { get; set; } = new(2026, 3, 14, 9, 30, 0);
    }
}
