@page "/{Runtime}/select"

@* A select bound in a form, the value of the option chosen shown where the check reads it. *@
<EditForm Model="_model">
    <FormaSelect TValue="int" Id="check" @bind-Value="_model.Status" Options="_statuses" Label="Status" />
</EditForm>
<output id="result">@_model.Status</output>

@code {
    private readonly Entry _model = new();

    private readonly IReadOnlyList<SelectOption<int>> _statuses = [new(1, "Open"), new(2, "Closed"), new(3, "Cancelled"), new(4, "Archived"), new(5, "Online"), new(6, "On Hold")];

    private sealed class Entry
    {
        public int Status { get; set; } = 1;
    }
}
