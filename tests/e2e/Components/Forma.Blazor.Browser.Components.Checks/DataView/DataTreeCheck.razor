@page "/{Runtime}/data-tree"
@using Forma.Blazor.Components.DataView

@* A tree of a folder holding two more beside a file, the folder opened from its disclosure or by the keys, the node activated shown where the check reads it. *@
<FormaDataView Id="check" TItem="Node" Items="Nodes" ItemKey="@(node => node.Id)" ItemName="@(node => node.Name)" ParentKey="@(node => node.ParentId)" HasChildren="@(node => node.IsFolder)" EnablePagination="false" OnItemClick="@(node => _activated = node.Name)">
    <FormaDataTree TItem="Node" aria-label="Folders" />
</FormaDataView>
<output id="activated">@_activated</output>

@code {
    private static readonly IQueryable<Node> Nodes = new Node[]
    {
        new(1, null, "Documents", true),
        new(2, null, "Readme.txt", false),
        new(3, 1, "Reports", true),
        new(4, 1, "Contracts", true),
    }.AsQueryable();

    private string? _activated;

    internal sealed record Node(int Id, int? ParentId, string Name, bool IsFolder);
}
