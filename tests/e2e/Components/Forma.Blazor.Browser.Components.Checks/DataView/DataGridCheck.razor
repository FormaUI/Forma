@page "/{Runtime}/data-grid"
@using Forma.Blazor.Components.DataView

@* A grid of three rows out of order, sorted by the header pressed and selected by the row pressed, the selection named where the check reads it. *@
<FormaDataView Id="check" TItem="Row" Items="Rows" ItemKey="@(row => row.Name)" ItemName="@(row => row.Name)" EnablePagination="false" EnableItemSelection="true" @bind-SelectedItems="_selectedRows">
    <FormaDataGrid TItem="Row">
        <Columns>
            <FormaPropertyColumn Property="@(row => row.Name)" Title="Name" Sortable="true" />
            <FormaPropertyColumn Property="@(row => row.Count)" Title="Count" Sortable="false" />
        </Columns>
    </FormaDataGrid>
</FormaDataView>
<output id="result">@string.Join(", ", _selectedRows.Select(row => row.Name))</output>

@code {
    private static readonly IQueryable<Row> Rows = new Row[] { new("Gamma", 3), new("Alpha", 1), new("Beta", 2) }.AsQueryable();

    private IReadOnlyList<Row> _selectedRows = [];

    internal sealed record Row(string Name, int Count);
}
