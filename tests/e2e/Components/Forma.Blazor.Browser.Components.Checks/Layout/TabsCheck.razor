@page "/{Runtime}/tabs"

@* Three tabs in a form, whose selections, by press or by keyboard, show in order where the check reads them, beside the times the form was submitted. *@
<EditForm Model="_model" OnSubmit="() => _submits++">
    <FormaTabs Id="tabs" Label="Settings" ActiveTabId="@_active" ActiveTabIdChanged="Select">
        <FormaTab TabId="general" Title="General">General settings</FormaTab>
        <FormaTab TabId="privacy" Title="Privacy">Privacy settings</FormaTab>
        <FormaTab TabId="advanced" Title="Advanced">Advanced settings</FormaTab>
    </FormaTabs>
</EditForm>
<output id="result">@(string.Join(' ', _selections))</output>
<output id="submits">@_submits</output>

@* Tabs too many for their narrow strip, the last of them active. *@
<div style="inline-size: 12rem">
    <FormaTabs Id="narrow-tabs" Label="Account" ActiveTabId="audit">
        <FormaTab TabId="overview" Title="Overview">Overview</FormaTab>
        <FormaTab TabId="members" Title="Members">Members</FormaTab>
        <FormaTab TabId="billing" Title="Billing">Billing</FormaTab>
        <FormaTab TabId="audit" Title="Audit">Audit</FormaTab>
    </FormaTabs>
</div>

@code {
    private readonly object _model = new();
    private readonly List<string> _selections = [];
    private string _active = "general";
    private int _submits;

    private void Select(string tabId)
    {
        _active = tabId;
        _selections.Add(tabId);
    }
}
