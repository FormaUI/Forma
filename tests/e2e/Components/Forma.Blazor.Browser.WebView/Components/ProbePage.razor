@page "/{culture}/probe"
@page "/{culture}/translated-probe"
@page "/{culture}/sonda-traducida"
@inherits CultureRoutePage
@implements IDisposable
@inject ProbeShell Shell
@inject ProbeScope Scope
@inject NavigationManager Navigation
@inject ICultureState CultureState
@inject ICultureSwitch CultureSwitch
@inject IStringLocaleFactory LocaleFactory

@* One web view's page, a culture route page: the culture it renders in, a string of the host's own, a select reaching its script,
   an event, a binding, work begun before a switch, the ways a culture is applied, the application's switch from a component and from
   native code, the web views it opens, under the name a check gives or the next in order, and closes, its own or another by name, the
   web views whose scopes were released, the guards a navigation handler keeps, and what its navigation saw. *@
<output id="segment">@Culture</output>
<output id="instance">@_instance</output>
<output id="context">@_context</output>
<output id="render-culture">@Ambient()</output>
<output id="state">@CultureState.Culture.Name|@CultureState.UICulture.Name</output>
<output id="welcome">@_locale["Welcome"]</output>

<EditForm Model="_entry">
    <FormaSelect TValue="int" @bind-Value="_entry.Status" Options="_statuses" Label="Status" />
</EditForm>
<output id="status">@_entry.Status</output>

<FormaButton OnClick="RecordEvent">Event</FormaButton>
<output id="event">@_event</output>

<label>Amount <input id="amount" @bind="_amount" /></label>
<output id="amount-value">@_amount.ToString(CultureInfo.InvariantCulture)</output>
<label>Draft <input id="draft" @bind="_draft" /></label>

<button id="begin-work" @onclick="BeginWorkAsync">Begin work</button>
<button id="end-work" @onclick="EndWork">End work</button>
<output id="work">@_work</output>

<label>Culture <input id="culture" @bind="_culture" /></label>
<button id="apply-defaults" @onclick="ApplyToDefaults">Apply to defaults</button>
<button id="apply-threads" @onclick="ApplyToThreadsAsync">Apply to threads</button>
<button id="apply-captured" @onclick="ApplyInCapturedFlowAsync">Apply in captured flow</button>
<output id="applied">@_applied</output>
<button id="switch" @onclick="SwitchAsync">Switch</button>
<button id="switch-native" @onclick="SwitchFromNativeCodeAsync">Switch from native code</button>
<output id="switched">@_switched</output>

<label>Start path <input id="start-path" @bind="_startPath" /></label>
<label>Open as <input id="open-as" @bind="_openAs" /></label>
<button id="open" @onclick="Open">Open</button>
<output id="opened">@_opened</output>
<button id="close" @onclick="() => Shell.Close(WebView, isDisposing: false)">Close</button>
<button id="close-disposing" @onclick="() => Shell.Close(WebView, isDisposing: true)">Close and dispose</button>
<label>Web view <input id="other" @bind="_other" /></label>
<button id="close-other" @onclick="() => Shell.Close(_other, isDisposing: true)">Close and dispose the web view named</button>
<output id="released">@_releasedWebViews</output>

<label><input id="guard-work" type="checkbox" @bind="_isGuardingWork" /> Guard work</label>
<label><input id="refuse" type="checkbox" @bind="_isRefusing" /> Refuse every navigation</label>
<a id="to-entry" href="en/probe?entry=2">entry 2</a>
<a id="to-es" href="es/probe">es</a>
<a id="to-he" href="he/probe">he</a>
<ol id="navigations">
    @foreach (var navigation in _navigations)
    {
        <li>@navigation</li>
    }
</ol>

@code {
    private readonly string _instance = Guid.NewGuid().ToString("N")[..8];
    private readonly Entry _entry = new();
    private IStringLocale _locale = default!;
    private readonly IReadOnlyList<SelectOption<int>> _statuses = [new(1, "Open"), new(2, "Closed")];
    private readonly List<string> _navigations = [];
    private IDisposable? _locationChanging;
    private TaskCompletionSource? _workGate;
    private string? _context;
    private string? _event;
    private decimal _amount;
    private string? _draft;
    private string? _work;
    private string _culture = "es-ES";
    private string? _switched;
    private string? _applied;
    private string _startPath = "/en/probe";
    private string _openAs = string.Empty;
    private string? _opened;
    private string _other = string.Empty;
    private string? _releasedWebViews;
    private bool _isGuardingWork;
    private bool _isRefusing;

    [CascadingParameter(Name = "WebView")] public string WebView { get; set; } = default!;

    protected override void OnInitialized()
    {
        // A string of the host's own, looked up in the web view's culture state, which a culture per web view switches alone.
        _locale = LocaleFactory.Create(typeof(ProbePage), CultureState);
        Scope.WebView = WebView;
        _context = SynchronizationContext.Current?.GetType().Name;
        Shell.Attach(new ProbeAttachment(WebView, SynchronizationContext.Current!, action => InvokeAsync(action)));
        _locationChanging = Navigation.RegisterLocationChangingHandler(OnLocationChangingAsync);
        Navigation.LocationChanged += OnLocationChanged;
        Shell.ScopeReleased += OnScopeReleased;
    }

    public void Dispose()
    {
        _locationChanging?.Dispose();
        Navigation.LocationChanged -= OnLocationChanged;
        Shell.ScopeReleased -= OnScopeReleased;
    }

    private static string Ambient()
        => $"{CultureInfo.CurrentCulture.Name}|{CultureInfo.CurrentUICulture.Name}";

    private void RecordEvent()
        => _event = $"{Ambient()}|{1234.5.ToString("N1", CultureInfo.CurrentCulture)}|{ProbeStrings.Greeting}";

    private async Task BeginWorkAsync()
    {
        var gate = new TaskCompletionSource();
        _workGate = gate;
        var begun = Ambient();
        _work = $"begun {begun}";

        await gate.Task;

        _work = $"begun {begun}, ended {Ambient()}";
    }

    private void EndWork()
        => _workGate?.TrySetResult();

    private void ApplyToDefaults()
    {
        ProbeShell.ApplyToDefaults(CultureInfo.GetCultureInfo(_culture), CultureInfo.GetCultureInfo(_culture));
        _applied = "defaults";
    }

    private async Task ApplyToThreadsAsync()
    {
        await Shell.ApplyToThreadsAsync(CultureInfo.GetCultureInfo(_culture), CultureInfo.GetCultureInfo(_culture));
        _applied = "threads";
    }

    private async Task ApplyInCapturedFlowAsync()
    {
        await Shell.ApplyInCapturedFlowAsync(CultureInfo.GetCultureInfo(_culture), CultureInfo.GetCultureInfo(_culture));
        _applied = "captured";
    }

    private async Task SwitchAsync()
    {
        await CultureSwitch.SwitchAsync(CultureInfo.GetCultureInfo(_culture));
        _switched = "switched";
    }

    private async Task SwitchFromNativeCodeAsync()
    {
        await Shell.SwitchFromNativeCodeAsync(CultureInfo.GetCultureInfo(_culture));
        _switched = "switched from native code";
    }

    private void Open()
        => _opened = Shell.Open(_startPath, string.IsNullOrEmpty(_openAs) ? null : _openAs);

    private void OnScopeReleased()
        => _ = InvokeAsync(() =>
        {
            _releasedWebViews = string.Join(' ', Shell.ReleasedWebViews);
            StateHasChanged();
        });

    // A guard on the user's work lets the web view's address follow the application's culture, which keeps the page and the work.
    private ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        _navigations.Add($"changing {Navigation.ToAbsoluteUri(context.TargetLocation).PathAndQuery} state={context.HistoryEntryState ?? "none"} intercepted={context.IsNavigationIntercepted}");

        if (_isRefusing || (_isGuardingWork && !context.IsCultureFollowing()))
        {
            context.PreventNavigation();
            _navigations.Add("prevented");
        }

        _ = InvokeAsync(StateHasChanged);

        return ValueTask.CompletedTask;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _navigations.Add($"changed {new Uri(args.Location).PathAndQuery} state={args.HistoryEntryState ?? "none"} intercepted={args.IsNavigationIntercepted}");
        _ = InvokeAsync(StateHasChanged);
    }

    private sealed class Entry
    {
        public int Status { get; set; } = 1;
    }
}
