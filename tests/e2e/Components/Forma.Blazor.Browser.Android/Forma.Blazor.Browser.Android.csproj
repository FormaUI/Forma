<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!--
        The Android check host: a MAUI application whose web view renders every component's check page, which the browser check
        drives on an Android device or emulator through its web view's DevTools socket. It builds against the maui-android workload,
        so it stands outside the repository's solution, in one of its own beside it, and the browser step builds it where it is asked
        to check Android.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0-android</TargetFramework>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ApplicationTitle>Forma Android Check</ApplicationTitle>
        <ApplicationId>com.formaui.checks.android</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Blazor.Browser.Components.Checks\Forma.Blazor.Browser.Components.Checks.csproj" />
        <ProjectReference Include="..\..\..\..\src\Blazor\Forma.Blazor\Forma.Blazor.csproj" />
        <ProjectReference Include="..\..\..\..\src\Blazor\Forma.Blazor.WebView\Forma.Blazor.WebView.csproj" />
        <ProjectReference Include="..\..\..\..\src\Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\..\..\..\src\Framework\Forma.Framework.Localization.Json\Forma.Framework.Localization.Json.csproj" />
    </ItemGroup>

</Project>
