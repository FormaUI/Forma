@* The page's runtime is its address's first segment, server, webassembly or auto, which the interactive router renders every check in, or static, which renders it statically. *@
<!DOCTYPE html>
<html lang="en" dir="ltr" @attributes="ThemeAttributes.Of(Themes, ThemeState.Choice)">
<head>
    <FormaPageHead Title="Forma Component Checks" IconHref="data:," PageRenderMode="PageRenderMode" Nonce="@CheckContentSecurityPolicy.GetNonce(HttpContext)">
        <link rel="stylesheet" href="@Assets["Forma.Blazor.Browser.Components.styles.css"]" />
    </FormaPageHead>
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    @* Blazor's own reconnection display writes an inline style element, so the page shows one of its own, as a host under a strict policy does. *@
    <div id="components-reconnect-modal" class="check-reconnect" role="status">Reconnecting…</div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [Inject] private ThemeRegistry Themes { get; set; } = default!;

    [Inject] private IThemeState ThemeState { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode
        => RenderModeOf(HttpContext?.Request.Path.Value);

    private static IComponentRenderMode? RenderModeOf(string? path)
        => path?.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() switch
        {
            "server" => InteractiveServer,
            "webassembly" => InteractiveWebAssembly,
            "auto" => InteractiveAuto,
            _ => null,
        };
}
