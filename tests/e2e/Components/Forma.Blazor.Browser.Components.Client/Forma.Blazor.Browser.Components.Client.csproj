<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The component checks' client: the check pages, which the router renders in the page's runtime. -->
    <PropertyGroup>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Blazor.Browser.Components.Checks\Forma.Blazor.Browser.Components.Checks.csproj" />
        <ProjectReference Include="..\..\..\..\src\Blazor\Forma.Blazor.WebAssembly\Forma.Blazor.WebAssembly.csproj" />
    </ItemGroup>

</Project>
