        <ProjectReference Include="..\..\..\..\src\Framework\Forma.Framework.Culture\Forma.Framework.Culture.csproj" />
        <ProjectReference Include="..\..\..\..\src\Framework\Forma.Framework.Culture.Browser.Interop\Forma.Framework.Culture.Browser.Interop.csproj" />
        <ProjectReference Include="..\..\..\..\src\Framework\Forma.Framework.Culture.Router\Forma.Framework.Culture.Router.csproj" />
        <ProjectReference Include="..\..\..\..\src\Framework\Forma.Framework.Culture.Router.AspNetCore\Forma.Framework.Culture.Router.AspNetCore.csproj" />
    </ItemGroup>

</Project>
