@using Microsoft.JSInterop
@implements IDisposable
@inject ICultureState CultureState
@inject ICultureSwitch CultureSwitch
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject DelayedSwitches Delayed

@* What the culture checks read and press on the Server: the state, text a reader typed, the links to the other culture and to the other pages, switches at once or held until the check releases them, a switch to a pair no route carries, the outcome of the last switch made at once, and a guard on the page's navigations that refuses each or holds it until the check lets it go. *@
<output id="state">@CultureState.UICulture.Name</output>
<output id="interactive">@RendererInfo.IsInteractive</output>
<input id="typed" @bind="_typed" />
@foreach (var route in Router?.Routes ?? [])
{
    <a id="lang-@route.Token" href="@Router!.GetUrl(route, Navigation.ToBaseRelativePath(Navigation.Uri))">@route.Token</a>
}
<a id="go-culture" href="@GetPath("/culture")">Culture</a>
<a id="go-other" href="@GetPath("/culture/other")">Other</a>
<a id="go-streaming" href="@GetPath("/culture/streaming")">Streaming</a>
<a id="go-static" href="@GetPath("/culture/static")">Static</a>
<a id="go-state-static" href="/state/static">State static</a>
<button id="switch-state" @onclick="SwitchStateAsync">Switch the state</button>
<button id="switch-unrouted" @onclick="SwitchUnroutedAsync">Switch to a pair no route carries</button>
<output id="switch-outcome">@_outcome</output>
<button id="switch-later" @onclick="SwitchLater">Switch the state once released</button>
<output id="held-switch">@_heldSwitchState</output>
<button id="guard-refuse" @onclick="GuardRefusing">Refuse every navigation</button>
<button id="guard-hold" @onclick="GuardHolding">Hold each navigation</button>
<button id="guard-release" @onclick="ReleaseHeldNavigation">Let the held navigation go</button>
<button id="guard-end" @onclick="EndGuard">Guard no navigation</button>
<output id="guard-state">@_guardState</output>
<output id="switch-outcomes">@string.Join(' ', _outcomes)</output>

@code {
    private static readonly CultureInfo Hebrew = CultureInfo.GetCultureInfo("he");
    private static readonly CultureInfo French = CultureInfo.GetCultureInfo("fr");

    private string? _typed;
    private string? _outcome;
    private string _guardState = "none";
    private string _heldSwitchState = "none";
    private readonly List<string> _outcomes = [];
    private IDisposable? _guard;
    private TaskCompletionSource? _heldNavigation;

    // Registered only where the host switches through culture addresses.
    private CultureRouter? Router
        => Services.GetService<CultureRouter>();

    private string GetPath(string path)
        => Router is { } router ? router.GetPath(Services.GetRequiredService<CultureSwitcher>().CurrentRoute, path) : path;

    protected override void OnInitialized()
        => CultureState.Subscribe(HandleCultureChangedAsync);

    // Every switch's outcome is kept in order, beside the last one's.
    private async Task SwitchStateAsync()
    {
        _outcome = await SwitchAsync(Hebrew);
        _outcomes.Add(_outcome);
    }

    private async Task SwitchUnroutedAsync()
        => _outcome = await SwitchAsync(French);

    private async Task<string> SwitchAsync(CultureInfo culture)
    {
        try
        {
            await CultureSwitch.SwitchAsync(culture);

            return "accepted";
        }
        catch (TaskCanceledException)
        {
            return "canceled";
        }
        catch (TimeoutException)
        {
            return "timed out";
        }
        catch (InvalidOperationException)
        {
            return "refused";
        }
    }

    // A switch held from the press, which the panel shows, until the check releases it with the browser offline; the check learns over HTTP that it started and how it settled.
    private void SwitchLater()
    {
        var release = Delayed.WaitForReleaseAsync();
        _heldSwitchState = "held";
        _ = Task.Run(async () =>
        {
            await release;
            await InvokeAsync(async () =>
            {
                try
                {
                    Task switching;

                    try
                    {
                        switching = CultureSwitch.SwitchAsync(Hebrew);
                    }
                    finally
                    {
                        Delayed.RecordStart();
                    }

                    await switching;
                    Delayed.Record(isFailed: false);
                }
                catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException or JSException)
                {
                    Delayed.Record(isFailed: true);
                }
            });
        });
    }

    // A guard refusing every navigation, as one guarding the reader's unsaved work refuses one.
    private void GuardRefusing()
    {
        EndGuard();
        _guard = Navigation.RegisterLocationChangingHandler(context =>
        {
            context.PreventNavigation();

            return ValueTask.CompletedTask;
        });
        _guardState = "refusing";
    }

    // A guard holding each navigation until the check lets it go, as one asking the reader first does.
    private void GuardHolding()
    {
        EndGuard();
        _guard = Navigation.RegisterLocationChangingHandler(async _ =>
        {
            var held = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
            _heldNavigation = held;
            _guardState = "held";
            StateHasChanged();
            await held.Task;
        });
        _guardState = "holding";
    }

    private void ReleaseHeldNavigation()
    {
        _guardState = "released";
        _heldNavigation?.TrySetResult();
    }

    private void EndGuard()
    {
        _guard?.Dispose();
        _guard = null;
        _guardState = "none";
    }

    private Task HandleCultureChangedAsync()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CultureState.Unsubscribe(HandleCultureChangedAsync);
        _guard?.Dispose();
        _heldNavigation?.TrySetResult();
    }
}
