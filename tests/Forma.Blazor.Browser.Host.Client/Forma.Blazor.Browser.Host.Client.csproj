<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!-- The minimal client a host builds: the components and their WebAssembly half, nothing optional. -->
    <PropertyGroup>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Forma.Blazor\Forma.Blazor.csproj" />
        <ProjectReference Include="..\..\src\Forma.Blazor.WebAssembly\Forma.Blazor.WebAssembly.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework\Forma.Framework.Culture\Forma.Framework.Culture.csproj" />
    </ItemGroup>

</Project>
