@page "/nav/a"
@page "/nav/b"
@page "/nav/slow"
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationRecorder Recorder
@inject NavigationManager Navigation

@* The page each navigation lands at, and the navigations the check starts from it. *@
<p id="nav-page">navigation page</p>
<button id="go-b" @onclick='() => Navigation.NavigateTo("nav/b")'>To b</button>
<a id="link-b" href="nav/b">Link to b</a>
<button id="go-a" @onclick='() => Navigation.NavigateTo("nav/a")'>To a</button>
<button id="go-slow-then-b" @onclick="GoSlowThenB">To slow, then to b</button>
<button id="go-missing" @onclick='() => Navigation.NavigateTo("nav/missing")'>To a page that isn't there</button>
<button id="reload-b" @onclick='() => Navigation.NavigateTo("nav/b", forceLoad: true)'>Load b as a new document</button>
<label><input id="guard" type="checkbox" @onchange="Guard" /> Prevent leaving</label>

@code {
    private IDisposable? _guard;

    private void GoSlowThenB()
    {
        Navigation.NavigateTo("nav/slow");
        Navigation.NavigateTo("nav/b");
    }

    private void Guard(ChangeEventArgs args)
    {
        _guard?.Dispose();
        _guard = args.Value is true
            ? Navigation.RegisterLocationChangingHandler(context =>
            {
                Recorder.Record($"prevented /{Navigation.ToBaseRelativePath(context.TargetLocation)}");
                context.PreventNavigation();

                return ValueTask.CompletedTask;
            })
            : null;
    }

    public void Dispose()
        => _guard?.Dispose();
}
