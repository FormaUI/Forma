@inherits FormaBunitContext
@using Forma.Framework.Resources
@using Forma.Tests.Files
@using Forma.Tests.Resources
@using Forma.Blazor.Components.Files
@using Forma.Framework.Files
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.DependencyInjection

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_store_every_file_in_turn()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("one.txt", "first"), new FakeBrowserFile("two.txt", "second")];

            // Act
            ctx.Render(@<FormaFileUploader Store="store" Files="files" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(["one.txt", "two.txt"], store.Saved);
                Assert.Equal("first", store.Contents["one.txt"]);
                Assert.Equal("second", store.Contents["two.txt"]);
            });
        }

        [Fact]
        public void Should_store_a_file_a_store_reads_in_chunks_off_the_renderer_thread()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new ChunkedFileStore();
            var failures = new List<UploadFailure>();
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("long.txt", new string('a', 64))];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store"
                                                 Files="files"
                                                 OnFailed="@(failure => { failures.Add(failure); return Task.CompletedTask; })" />);

            // Assert
            cut.WaitForAssertion(() => Assert.Equal("Stored", cut.Find(".forma-file-uploader-state").TextContent));
            Assert.Empty(failures);
        }

        [Fact]
        public void Should_mark_what_it_had_not_stored_as_cancelled()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new ChunkedFileStore();
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("slow.txt", new string('a', 400)),
                new FakeBrowserFile("next.txt", "second")
            ];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" />);
            var uploader = cut.FindComponent<FormaFileUploader>();

            cut.WaitForState(() => uploader.Instance.IsUploading);
            uploader.Instance.Cancel();

            // Assert
            cut.WaitForAssertion(() => Assert.Equal(
                ["Canceled", "Canceled"],
                cut.FindAll(".forma-file-uploader-state").Select(element => element.TextContent)));
        }

        [Fact]
        public void Should_show_no_measurements_by_default()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("one.txt", "first")];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-file-uploader-metric"));
        }

        [Fact]
        public void Should_show_a_finished_file_as_its_size_rather_than_repeating_it()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            var options = new FileUploaderOptions { ShowByteCount = true };
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("one.txt", new string('a', 2048))];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="options" />);

            // Assert
            cut.WaitForAssertion(() => Assert.Equal("(2 KB)", cut.Find(".forma-file-uploader-size").TextContent));
        }

        [Fact]
        public void Should_not_total_a_set_of_one_file_it_has_already_measured()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            var options = new FileUploaderOptions { ShowByteCount = true, ShowTotalMetrics = true };
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("one.txt", new string('a', 2048))];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="options" />);

            // Assert
            cut.WaitForAssertion(() => Assert.Empty(cut.FindAll(".forma-file-uploader-totals")));
        }

        [Fact]
        public void Should_name_the_totals_of_a_set_of_more_than_one_file()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            var options = new FileUploaderOptions { ShowByteCount = true, ShowTotalMetrics = true };
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("one.txt", new string('a', 1024)),
                new FakeBrowserFile("two.txt", new string('b', 1024))
            ];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="options" />);

            // Assert
            cut.WaitForAssertion(() =>
            {
                Assert.Equal("All Files", cut.Find(".forma-file-uploader-totals-label").TextContent);
                Assert.Equal("(2 KB)", cut.Find(".forma-file-uploader-totals .forma-file-uploader-size").TextContent);
            });
        }

        [Fact]
        public void Should_leave_the_totals_out_when_they_are_switched_off()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            var options = new FileUploaderOptions { ShowByteCount = true, ShowTotalMetrics = false };
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("one.txt", new string('a', 1024)),
                new FakeBrowserFile("two.txt", new string('b', 1024))
            ];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="options" />);

            // Assert
            cut.WaitForAssertion(() => Assert.Empty(cut.FindAll(".forma-file-uploader-totals")));
        }

        [Fact]
        public void Should_leave_the_summary_out_when_it_is_switched_off()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            var options = new FileUploaderOptions { ShowSummary = false };
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("one.txt", "first")];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="options" />);

            // Assert
            cut.WaitForAssertion(() => Assert.Empty(cut.FindAll(".forma-file-uploader-summary")));
        }

        [Fact]
        public void Should_keep_each_file_to_one_list_item_while_showing_its_measurements()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            var options = new FileUploaderOptions { ShowByteCount = true };
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("one.txt", "first"),
                new FakeBrowserFile("two.txt", "second")
            ];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="options" />);

            // Assert
            cut.WaitForAssertion(() => Assert.Equal(2, cut.FindAll(".forma-file-uploader-list > li").Count));
        }

        [Fact]
        public void Should_mark_a_stored_file_with_a_word_and_not_only_a_colour()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("cover.jpg", "bytes")];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("Stored", cut.Find(".forma-file-uploader-state").TextContent);
                Assert.Equal("Stored 1 of 1.", cut.Find(".forma-file-uploader-summary").TextContent);
            });
        }

        [Fact]
        public void Should_report_the_resources_the_store_returned()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            IReadOnlyList<ResourceInfo>? completed = null;
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("cover.jpg", "bytes")];

            // Act
            ctx.Render(@<FormaFileUploader Store="store"
                                       Files="files"
                                       OnCompleted="@(resources => { completed = resources; return Task.CompletedTask; })" />);

            // Assert
            Assert.Equal("/stored/cover.jpg", Assert.Single(completed!).Source);
        }

        [Fact]
        public void Should_carry_on_after_a_file_the_store_refuses()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore(failOn: "bad.txt");
            UploadFailure? failure = null;
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("bad.txt", "first"),
                new FakeBrowserFile("good.txt", "second")
            ];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store"
                                                 Files="files"
                                                 OnFailed="@(reported => { failure = reported; return Task.CompletedTask; })" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(["good.txt"], store.Saved);
                Assert.Equal("bad.txt", failure!.Name);
                Assert.Equal("Failed", cut.FindAll(".forma-file-uploader-state")[0].TextContent);
                Assert.Equal("Stored", cut.FindAll(".forma-file-uploader-state")[1].TextContent);
                Assert.Equal("Stored 1 of 2.", cut.Find(".forma-file-uploader-summary").TextContent);
            });
        }

        [Fact]
        public void Should_wait_for_the_upload_action_when_AutoStart_is_false()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("cover.jpg", "bytes")];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="@(new FileUploaderOptions { AutoStart = false })" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Empty(store.Saved);
                Assert.Equal("Waiting", cut.Find(".forma-file-uploader-state").TextContent);
                Assert.Equal("Upload", cut.Find("button").TextContent.Trim());
            });
        }

        [Fact]
        public void Should_store_the_set_once_the_upload_action_is_pressed()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("cover.jpg", "bytes")];
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="@(new FileUploaderOptions { AutoStart = false })" />);

            // Act
            cut.Find("button").Click();

            // Assert
            Assert.Equal(["cover.jpg"], store.Saved);
        }

        [Fact]
        public void Should_name_each_progress_bar_after_its_file()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("cover.jpg", "bytes")];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="@(new FileUploaderOptions { AutoStart = false })" />);

            // Assert
            Assert.Equal("cover.jpg", cut.Find("progress").GetAttribute("aria-label"));
        }

        [Fact]
        public void Should_store_a_second_set_when_the_selection_is_replaced()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();
            IReadOnlyList<IBrowserFile> first = [new FakeBrowserFile("one.txt", "first")];
            IReadOnlyList<IBrowserFile> second = [new FakeBrowserFile("two.txt", "second")];
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="first" />);

            // Act
            cut.FindComponent<FormaFileUploader>().Render(parameters => parameters
                .Add(instance => instance.Store, store)
                .Add(instance => instance.Files, second));
            cut.WaitForState(() => store.Saved.Count == 2);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(["one.txt", "two.txt"], store.Saved);
                Assert.Equal("Stored 1 of 1.", cut.Find(".forma-file-uploader-summary").TextContent);
            });
        }

        [Fact]
        public void Should_skip_the_rest_of_the_set_when_StopOnFailure_is_on()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore(failOn: "bad.txt");
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("bad.txt", "first"),
                new FakeBrowserFile("good.txt", "second")
            ];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="@(new FileUploaderOptions { StopOnFailure = true })" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Empty(store.Saved);
                Assert.Equal("Failed", cut.FindAll(".forma-file-uploader-state")[0].TextContent);
                Assert.Equal("Skipped", cut.FindAll(".forma-file-uploader-state")[1].TextContent);
            });
        }

        [Fact]
        public void Should_undo_what_it_stored_when_RollbackOnFailure_is_on()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore(failOn: "bad.txt");
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("good.txt", "first"),
                new FakeBrowserFile("bad.txt", "second")
            ];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store" Files="files" Options="@(new FileUploaderOptions { RollbackOnFailure = true })" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(["/stored/good.txt"], store.Deleted);
                Assert.Equal("Rolled Back", cut.FindAll(".forma-file-uploader-state")[0].TextContent);
                Assert.Equal("Failed", cut.FindAll(".forma-file-uploader-state")[1].TextContent);
                Assert.Equal("Stored 0 of 2.", cut.Find(".forma-file-uploader-summary").TextContent);
            });
        }

        [Fact]
        public void Should_not_report_completion_for_a_set_it_rolled_back()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore(failOn: "bad.txt");
            var completed = false;
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("good.txt", "first"),
                new FakeBrowserFile("bad.txt", "second")
            ];

            // Act
            ctx.Render(@<FormaFileUploader Store="store"
                                       Files="files"
                                       Options="@(new FileUploaderOptions { RollbackOnFailure = true })"
                                       OnCompleted="@(_ => { completed = true; return Task.CompletedTask; })" />);

            // Assert
            Assert.False(completed);
        }

        [Fact]
        public void Should_report_a_store_that_could_not_rollback_a_file()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore(failOn: "bad.txt", deletes: false);
            var failures = new List<UploadFailure>();
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("good.txt", "first"),
                new FakeBrowserFile("bad.txt", "second")
            ];

            // Act
            var cut = ctx.Render(@<FormaFileUploader Store="store"
                                                 Files="files"
                                                 Options="@(new FileUploaderOptions { RollbackOnFailure = true })"
                                                 OnFailed="@(failure => { failures.Add(failure); return Task.CompletedTask; })" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Empty(store.Deleted);
                Assert.Equal(2, failures.Count);
                Assert.Equal("good.txt", failures[1].Name);
                Assert.Equal("Failed", cut.FindAll(".forma-file-uploader-state")[0].TextContent);
            });
        }

        [Fact]
        public void Should_keep_stored_files_when_rollback_is_off()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore(failOn: "bad.txt");
            IReadOnlyList<IBrowserFile> files =
            [
                new FakeBrowserFile("good.txt", "first"),
                new FakeBrowserFile("bad.txt", "second")
            ];

            // Act
            ctx.Render(@<FormaFileUploader Store="store" Files="files" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(["good.txt"], store.Saved);
                Assert.Empty(store.Deleted);
            });
        }

        [Fact]
        public void Should_reject_a_set_with_no_store_given_or_registered()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("cover.jpg", "bytes")];

            // Act & Assert
            Assert.Throws<InvalidOperationException>(() => ctx.Render(@<FormaFileUploader Files="files" />));
        }

        [Fact]
        public void Should_store_through_the_store_the_host_registered()
        {
            // Arrange
            using var ctx = new FormaFileUploaderTests();
            var store = new FakeFileStore();

            ctx.Services.AddSingleton<IFileStore>(store);

            IReadOnlyList<IBrowserFile> files = [new FakeBrowserFile("one.txt", "first")];

            // Act
            ctx.Render(@<FormaFileUploader Files="files" />);

            // Assert
            Assert.Equal(["one.txt"], store.Saved);
        }
    }
}
