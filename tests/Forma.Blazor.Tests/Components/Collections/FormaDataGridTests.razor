        [Fact]
        public async Task Should_re_query_the_data_source_when_refresh_is_requested()
        {
            // Arrange
            using var ctx = new FormaDataGridTests();
            var calls = 0;
            GridItemsProvider<GridItem> provider = _ =>
            {
                calls++;
                return ValueTask.FromResult(GridItemsProviderResult.From(CreateItems(3).ToArray(), 3));
            };

            var cut = ctx.Render(
                @<FormaDataGrid ItemsProvider="provider" PageSize="10">
                    <Columns>
                        <PropertyColumn Property="@(item => item.Title)" />
                    </Columns>
                </FormaDataGrid>);
            cut.WaitForState(() => calls > 0);
            var before = calls;
            var grid = cut.FindComponent<FormaDataGrid<GridItem>>().Instance;

            // Act
            await cut.InvokeAsync(grid.RefreshDataAsync);

            // Assert
            Assert.True(calls > before);
        }

