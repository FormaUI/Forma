        [Fact]
        public async Task Should_reject_a_row_select_that_would_exceed_the_maximum()
        {
            // Arrange
            using var ctx = new FormaDataGridTests();
            IReadOnlyList<GridItem>? changedTo = null;
            var rejections = new List<SelectionRejected>();

            var cut = ctx.Render(
                @<FormaDataGrid Items="CreateItems(3)" PageSize="10" EnableRowSelection="true"
                                CheckedSelectionOptions="@(new CheckedSelectionOptions { Maximum = 1 })" SelectedItems="CreateItems(1).ToArray()"
                                SelectedItemsChanged="@((IReadOnlyList<GridItem> selected) => changedTo = selected)"
                                OnSelectionRejected="@((SelectionRejected args) => rejections.Add(args))">
                    <Columns>
                        <PropertyColumn Property="@(item => item.Title)" />
                    </Columns>
                </FormaDataGrid>);
            cut.WaitForState(() => cut.FindAll("tbody .forma-data-grid-row-marker").Count == 3);
            var grid = cut.FindComponent<FormaDataGrid<GridItem>>().Instance;
            var token = int.Parse(cut.FindAll("tbody .forma-data-grid-row-marker")[1].GetAttribute("data-row-key")!, CultureInfo.InvariantCulture);

            // Act
            await cut.InvokeAsync(() => grid.HandleSelectAsync(token, additive: true));

            // Assert
            Assert.Null(changedTo);
            var rejection = Assert.Single(rejections);
            Assert.Equal(SelectionBoundary.Maximum, rejection.Boundary);
            Assert.Equal(1, rejection.Limit);
        }

