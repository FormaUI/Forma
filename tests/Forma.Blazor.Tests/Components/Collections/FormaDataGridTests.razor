        [Fact]
        public void Should_return_to_the_first_page_when_pagination_is_turned_off()
        {
            // Arrange — page forward so a stale index would survive the round trip
            using var ctx = new FormaDataGridTests();
            var cut = ctx.Render(
                @<FormaDataGrid Items="CreateItems(25)" PageSize="10">
                    <Columns>
                        <PropertyColumn Property="@(item => item.Title)" />
                    </Columns>
                </FormaDataGrid>);
            cut.WaitForState(() => cut.FindAll(".forma-pagination-navigation-input .forma-pagination-navigation-button-next").Count == 1);
            cut.Find(".forma-pagination-navigation-input .forma-pagination-navigation-button-next").Click();
            cut.Find(".forma-pagination-navigation-input .forma-pagination-navigation-button-next").Click();
            cut.WaitForState(() => cut.Markup.Contains("Item 25", StringComparison.Ordinal));

            // Act
            var grid = cut.FindComponent<FormaDataGrid<GridItem>>();
            grid.Render(parameters => parameters.Add(p => p.EnablePagination, false));
            grid.Render(parameters => parameters.Add(p => p.EnablePagination, true));
            cut.WaitForState(() => cut.FindAll("tbody tr").Count == 10);

            // Assert
            Assert.Contains("Item 1", cut.Markup, StringComparison.Ordinal);
            Assert.DoesNotContain("Item 25", cut.Markup, StringComparison.Ordinal);
        }

