@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_a_checkbox_input()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" />
            </FakeFormHost>);
            var input = cut.Find(".forma-checkbox");

            // Assert
            Assert.Equal("INPUT", input.TagName);
            Assert.Equal("checkbox", input.GetAttribute("type"));
        }

        [Fact]
        public void Should_reflect_the_bound_value()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel { Toggle = true };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.True(cut.Find(".forma-checkbox").HasAttribute("checked"));
        }

        [Fact]
        public void Should_disable_the_input_when_disabled()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" Disabled="true" />
            </FakeFormHost>);

            // Assert
            Assert.True(cut.Find(".forma-checkbox").HasAttribute("disabled"));
        }

        [Fact]
        public void Should_write_its_own_class_then_the_hosts_then_the_fields()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" class="host-supplied" />
            </FakeFormHost>);

            // Assert
            Assert.Equal("forma-checkbox host-supplied valid", cut.Find("input").ClassName);
        }

        [Fact]
        public void Should_splat_additional_attributes_onto_the_input()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" data-row-key="7" aria-label="Select Row" />
            </FakeFormHost>);
            var input = cut.Find(".forma-checkbox");

            // Assert
            Assert.Equal("7", input.GetAttribute("data-row-key"));
            Assert.Equal("Select Row", input.GetAttribute("aria-label"));
        }

        [Fact]
        public void Should_write_the_new_value_to_the_model_on_a_normal_toggle()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-checkbox").Change(true);

            // Assert
            Assert.True(model.Toggle);
        }

        [Fact]
        public void Should_mark_the_field_modified_once_toggled()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-checkbox").Change(true);

            // Assert
            Assert.Equal("forma-checkbox modified valid", cut.Find("input").ClassName);
        }

        [Fact]
        public void Should_invoke_on_click_without_suppressing_the_toggle()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();
            var clicks = 0;
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" OnClick="() => clicks++" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-checkbox").Click();
            cut.Find(".forma-checkbox").Change(true);

            // Assert
            Assert.Equal(1, clicks);
            Assert.True(model.Toggle);
        }

        [Fact]
        public void Should_report_the_click_as_prevented_when_prevent_default_is_set()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" PreventDefault="true" />
            </FakeFormHost>);

            // Assert
            Assert.True(cut.Find(".forma-checkbox").HasAttribute("blazor:onclick:preventdefault"));
        }

        [Fact]
        public void Should_leave_the_click_unprevented_by_default()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" OnClick="() => { }" />
            </FakeFormHost>);

            // Assert
            Assert.False(cut.Find(".forma-checkbox").HasAttribute("blazor:onclick:preventdefault"));
        }

        [Fact]
        public void Should_apply_the_indeterminate_state_through_script()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();
            var invocation = ctx.JSInterop.SetupVoid("setIndeterminate", _ => true);

            // Act
            ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" Indeterminate="true" />
            </FakeFormHost>);

            // Assert
            invocation.VerifyInvoke("setIndeterminate");
            Assert.NotEmpty(ctx.JSInterop.Invocations["setIndeterminate"]);
        }

        [Fact]
        public void Should_not_call_into_script_when_it_is_never_indeterminate()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel { Toggle = true };

            // Act
            ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Empty(ctx.JSInterop.Invocations["setIndeterminate"]);
        }

        [Fact]
        public void Should_wrap_the_input_in_a_label_when_child_content_is_provided()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle">Subscribe to updates</FormaCheckBox>
            </FakeFormHost>);
            var label = cut.Find(".forma-checkbox-label");

            // Assert
            Assert.Equal("LABEL", label.TagName);
            Assert.Contains("Subscribe to updates", label.TextContent);
            Assert.NotNull(label.QuerySelector(".forma-checkbox"));
        }

        [Fact]
        public void Should_not_wrap_the_input_in_a_label_when_there_is_no_child_content()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Empty(cut.FindAll(".forma-checkbox-label"));
            Assert.Equal("INPUT", cut.Find(".forma-checkbox").TagName);
        }

        [Fact]
        public void Should_keep_splatted_attributes_on_the_input_when_labelled()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle" class="host-supplied" data-row-key="7">Featured</FormaCheckBox>
            </FakeFormHost>);
            var input = cut.Find(".forma-checkbox");

            // Assert
            Assert.Equal("7", input.GetAttribute("data-row-key"));
            Assert.Contains("host-supplied", input.ClassName);
            Assert.False(cut.Find(".forma-checkbox-label").HasAttribute("data-row-key"));
        }

        [Fact]
        public void Should_write_the_new_value_to_the_model_when_labelled()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox @bind-Value="model.Toggle">Featured</FormaCheckBox>
            </FakeFormHost>);

            // Act
            cut.Find(".forma-checkbox").Change(true);

            // Assert
            Assert.True(model.Toggle);
        }

        [Fact]
        public void Should_take_a_value_and_an_expression_without_a_binding()
        {
            // Arrange
            using var ctx = new FormaCheckBoxTests();
            var model = new FakeModel();
            var toggled = false;

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaCheckBox Value="true" ValueChanged="_ => toggled = true" ValueExpression="() => model.Toggle" PreventDefault="true" />
            </FakeFormHost>);
            cut.Find(".forma-checkbox").Change(false);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.True(toggled);
                Assert.False(model.Toggle);
            });
        }
    }
}
