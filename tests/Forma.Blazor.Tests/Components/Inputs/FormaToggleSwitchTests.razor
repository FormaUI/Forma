@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_toggle_wrapper()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            cut.Find(".forma-toggle-switch-wrapper");
        }

        [Fact]
        public void Should_render_unchecked_when_value_is_false()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel { Toggle = false };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);
            var input = cut.Find("input[type='checkbox']");

            // Assert
            Assert.Null(input.GetAttribute("checked"));
        }

        [Fact]
        public void Should_render_checked_when_value_is_true()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel { Toggle = true };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);
            var input = cut.Find("input[type='checkbox']");

            // Assert
            Assert.NotNull(input.GetAttribute("checked"));
        }

        [Fact]
        public void Should_set_role_switch_on_input()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Equal("switch", cut.Find("input[type='checkbox']").GetAttribute("role"));
        }

        [Fact]
        public void Should_mark_the_on_state_without_relying_on_colour()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel { Toggle = true };
            var expected = ctx.Render(@<FormaIcon Icon="Glyph.Check" />).Find("path").GetAttribute("d");

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Equal(expected, cut.Find(".forma-toggle-switch-mark svg path").GetAttribute("d"));
        }

        [Fact]
        public void Should_mark_the_off_state_without_relying_on_colour()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel { Toggle = false };
            var expected = ctx.Render(@<FormaIcon Icon="Glyph.Cross" />).Find("path").GetAttribute("d");

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Equal(expected, cut.Find(".forma-toggle-switch-mark svg path").GetAttribute("d"));
        }

        [Fact]
        public void Should_keep_the_state_mark_out_of_the_accessibility_tree()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel { Toggle = true };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Equal("true", cut.Find(".forma-toggle-switch-track").GetAttribute("aria-hidden"));
        }

        [Fact]
        public void Should_render_on_label_when_provided()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" OnLabel="Enabled" />
            </FakeFormHost>);
            var label = cut.Find(".forma-toggle-switch-on-label");

            // Assert
            Assert.Equal("Enabled", label.TextContent);
        }

        [Fact]
        public void Should_not_render_on_label_when_not_provided()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Empty(cut.FindAll(".forma-toggle-switch-on-label"));
        }

        [Fact]
        public void Should_render_off_label_when_provided()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" OffLabel="Disabled" />
            </FakeFormHost>);
            var label = cut.Find(".forma-toggle-switch-off-label");

            // Assert
            Assert.Equal("Disabled", label.TextContent);
        }

        [Fact]
        public void Should_not_render_off_label_when_not_provided()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Empty(cut.FindAll(".forma-toggle-switch-off-label"));
        }

        [Fact]
        public void Should_render_both_labels_when_provided()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" OffLabel="Off" OnLabel="On" />
            </FakeFormHost>);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Single(cut.FindAll(".forma-toggle-switch-off-label"));
                Assert.Single(cut.FindAll(".forma-toggle-switch-on-label"));
            });
        }

        [Fact]
        public void Should_be_disabled_when_disabled_is_set()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" Disabled="true" />
            </FakeFormHost>);
            var input = cut.Find("input[type='checkbox']");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.NotNull(input.GetAttribute("disabled"));
                Assert.Contains("disabled", cut.Find(".forma-toggle-switch").ClassList);
            });
        }

        [Fact]
        public void Should_not_be_disabled_by_default()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Null(cut.Find("input[type='checkbox']").GetAttribute("disabled"));
        }

        [Fact]
        public void Should_render_the_field_label_when_provided()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" Label="Accept comments" />
            </FakeFormHost>);

            // Assert
            Assert.Contains("Accept comments", cut.Find(".forma-field-label").TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_point_the_field_label_at_the_input()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" Label="Accept comments" />
            </FakeFormHost>);

            // Assert
            Assert.Equal(
                cut.Find("input[type='checkbox']").GetAttribute("id"),
                cut.Find(".forma-field-label").GetAttribute("for"));
        }

        [Fact]
        public void Should_not_render_a_field_label_when_none_is_provided()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Assert
            Assert.Empty(cut.FindAll(".forma-field-label"));
        }

        [Fact]
        public async Task Should_update_value_when_toggled()
        {
            // Arrange
            using var ctx = new FormaToggleSwitchTests();
            var model = new FakeModel { Toggle = false };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaToggleSwitch @bind-Value="model.Toggle" />
            </FakeFormHost>);

            // Act
            await cut.Find("input[type='checkbox']").ChangeAsync(new ChangeEventArgs { Value = true });

            // Assert
            Assert.True(model.Toggle);
        }
    }
}
