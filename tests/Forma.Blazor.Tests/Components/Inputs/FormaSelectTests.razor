        [Fact]
        public void Should_route_the_trigger_s_arrows_on_the_trigger()
        {
            // Arrange
            using var ctx = new FormaSelectTests();
            var router = new InputRouterProbe(ctx);
            var model = new FakeModel();

            // Act
            ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSelect TValue="int?" @bind-Value="model.Status" Options="Options" Label="Status" />
            </FakeFormHost>);

            // Assert
            var registration = Assert.Single(router.Registrations);
            Assert.Equal(["select.open:ArrowDown,ArrowUp"], InputRouterProbe.GetRoutes(registration));
        }

        [Fact]
        public void Should_route_the_list_s_navigation_keys_through_the_popover_once_open()
        {
            // Arrange
            using var ctx = new FormaSelectTests();
            var router = new InputRouterProbe(ctx);
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSelect TValue="int?" @bind-Value="model.Status" Options="Options" Label="Status" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-select-trigger").Click();

            // Assert
            var registration = router.Registrations.Last();
            Assert.Multiple(
                () => Assert.Equal(cut.FindComponent<FormaPopover>().Instance.RootElement.Id, Assert.IsType<ElementReference>(registration.Arguments[0]).Id),
                () => Assert.Equal(["select.next:ArrowDown", "select.previous:ArrowUp", "select.first:Home", "select.last:End", "select.close:Tab"], InputRouterProbe.GetRoutes(registration)));
        }

        [Fact]
        public async Task Should_move_through_the_options_as_the_router_routes_the_list_s_keys()
        {
            // Arrange
            using var ctx = new FormaSelectTests();
            var router = new InputRouterProbe(ctx);
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSelect TValue="int?" @bind-Value="model.Status" Options="Options" Label="Status" />
            </FakeFormHost>);
            cut.Find(".forma-select-trigger").Click();
            var popover = cut.FindComponent<FormaPopover>().Instance;
            var opened = GetFocused(ctx.JSInterop).Count;

            // Act
            foreach (var (action, key) in new[] { ("select.first", "Home"), ("select.next", "ArrowDown"), ("select.next", "ArrowDown"), ("select.next", "ArrowDown"), ("select.last", "End"), ("select.previous", "ArrowUp") })
            {
                await router.RouteAsync(popover.RootElement, action, key);
            }

            // Assert: the first, second and third, wrapping to the first; then the last, and back to the second.
            var focused = GetFocused(ctx.JSInterop).Skip(opened).ToList();
            Assert.Equal(6, focused.Count);
            Assert.Multiple(
                () => Assert.Equal(3, focused.Take(3).Distinct().Count()),
                () => Assert.Equal(focused[0], focused[3]),
                () => Assert.Equal(focused[2], focused[4]),
                () => Assert.Equal(focused[1], focused[5]));
        }

