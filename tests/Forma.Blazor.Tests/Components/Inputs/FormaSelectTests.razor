        [Fact]
        public void Should_mark_the_selected_option_with_aria_selected()
        {
            // Arrange
            using var ctx = new FormaSelectTests();
            var model = new FakeModel { Status = 3 };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSelect TValue="int?" @bind-Value="model.Status" Options="Options" Label="Status" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-select-trigger").Click();
            var options = cut.FindAll(".forma-select-option");

            // Assert
            Assert.Equal("false", options[0].GetAttribute("aria-selected"));
            Assert.Equal("false", options[1].GetAttribute("aria-selected"));
            Assert.Equal("true", options[2].GetAttribute("aria-selected"));
