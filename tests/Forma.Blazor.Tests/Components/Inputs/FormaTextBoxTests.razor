@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_input_element_with_forma_text_box_class()
        {
            // Arrange
            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text" />
            </FakeFormHost>);

            // Assert
            var input = cut.Find("input.forma-text-box");
            Assert.NotNull(input);
        }

        [Fact]
        public async Task Should_be_described_by_the_message_its_field_shows()
        {
            // Arrange
            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();
            var editContext = new EditContext(model);
            var cut = ctx.Render(@<FakeFormHost EditContext="@editContext">
                <FormaTextBox @bind-Value="model.Text" Label="Name" />
            </FakeFormHost>);

            // Act
            new ValidationMessageStore(editContext).Add(FieldIdentifier.Create(() => model.Text), "Required");
            await cut.InvokeAsync(editContext.NotifyValidationStateChanged);

            // Assert
            Assert.Equal(cut.Find(".forma-field-messages").Id, cut.Find("input").GetAttribute("aria-describedby"));
        }

        [Fact]
        public async Task Should_not_be_described_by_a_message_while_no_label_draws_its_field()
        {
            // Arrange
            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();
            var editContext = new EditContext(model);
            var cut = ctx.Render(@<FakeFormHost EditContext="@editContext">
                <FormaTextBox @bind-Value="model.Text" />
            </FakeFormHost>);

            // Act
            new ValidationMessageStore(editContext).Add(FieldIdentifier.Create(() => model.Text), "Required");
            await cut.InvokeAsync(editContext.NotifyValidationStateChanged);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("true", cut.Find("input").GetAttribute("aria-invalid")),
                () => Assert.Null(cut.Find("input").GetAttribute("aria-describedby")));
        }

