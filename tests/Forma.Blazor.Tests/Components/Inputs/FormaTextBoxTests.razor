        [Fact]
        public void Should_report_invalid_without_being_modified()
        {
            // Arrange
            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();
            var editContext = new EditContext(model);
            var messages = new ValidationMessageStore(editContext);

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="editContext">
                <FormaTextBox @bind-Value="model.Text" />
            </FakeFormHost>);

            cut.InvokeAsync(() =>
            {
                messages.Add(editContext.Field(nameof(FakeModel.Text)), "Required field");
                editContext.NotifyValidationStateChanged();
            });

            // Assert
            cut.WaitForAssertion(() =>
            {
                var classes = cut.Find("input").ClassList;
                Assert.Contains("invalid", classes);
                Assert.DoesNotContain("modified", classes);
            });
        }

        [Fact]
        public void Should_apply_validation_classes_when_valid_and_modified()
        {
            // Arrange
            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();
            var editContext = new EditContext(model);

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="editContext">
                <FormaTextBox @bind-Value="model.Text" />
            </FakeFormHost>);

            cut.Find("input").Input("Valid Text");

            // Assert
            var classes = cut.Find("input").ClassList;
            Assert.Multiple(() =>
            {
                Assert.Contains("modified", classes);
                Assert.Contains("valid", classes);
            });
        }
