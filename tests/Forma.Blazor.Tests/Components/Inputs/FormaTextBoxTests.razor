            // Assert
            Assert.Multiple(() =>
            {
                Assert.False(input.HasAttribute("minlength"));
                Assert.False(input.HasAttribute("maxlength"));
                Assert.False(input.HasAttribute("pattern"));
                Assert.False(input.HasAttribute("inputmode"));
                Assert.False(input.HasAttribute("enterkeyhint"));
                Assert.False(input.HasAttribute("autocapitalize"));
                Assert.False(input.HasAttribute("spellcheck"));
                Assert.False(input.HasAttribute("autocomplete"));
                Assert.False(input.HasAttribute("style"));
            });
        }

