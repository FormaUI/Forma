        [Fact]
        public void Should_render_the_native_constraints_given()
        {
            // Arrange
            using var ctx = new FormaTextBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text"
                              Options="@(new TextBoxOptions { MinLength = 3, MaxLength = 20, Pattern = "[a-z]+", InputMode = TextInputMode.Email, EnterKeyHint = TextEnterKeyHint.Send, AutoCapitalize = TextAutoCapitalize.Words, SpellCheck = true, AutoComplete = "email" })" />
            </FakeFormHost>);
            var input = cut.Find("input");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("3", input.GetAttribute("minlength"));
                Assert.Equal("20", input.GetAttribute("maxlength"));
                Assert.Equal("[a-z]+", input.GetAttribute("pattern"));
                Assert.Equal("email", input.GetAttribute("inputmode"));
                Assert.Equal("send", input.GetAttribute("enterkeyhint"));
                Assert.Equal("words", input.GetAttribute("autocapitalize"));
                Assert.Equal("true", input.GetAttribute("spellcheck"));
                Assert.Equal("email", input.GetAttribute("autocomplete"));
            });
        }

