@inherits FormaBunitContext
@using Forma.Framework.Browser.Interop.Behaviors
@using System.Globalization

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_a_trigger_button()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);

            // Assert
            Assert.NotNull(cut.Find(".forma-date-picker-trigger"));
        }

        [Fact]
        public void Should_display_the_value_formatted_for_the_culture()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel { Date = new DateOnly(2025, 3, 15) };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);

            // Assert
            var expected = model.Date!.Value.ToDateTime(TimeOnly.MinValue).ToString("d", CultureInfo.CurrentCulture);
            Assert.Equal(expected, cut.Find(".forma-date-picker-value").TextContent);
        }

        [Fact]
        public void Should_show_a_placeholder_when_there_is_no_value()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);
            var value = cut.Find(".forma-date-picker-value");

            // Assert
            Assert.NotEmpty(value.TextContent.Trim());
            Assert.Contains("placeholder", value.ClassList);
        }

        [Fact]
        public void Should_open_one_month_in_the_top_layer_on_a_trigger_click()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-date-picker-trigger").Click();

            // Assert
            Assert.Multiple(
                () => Assert.NotNull(cut.Find(".forma-date-picker-popover")),
                () => Assert.Single(cut.FindAll(".forma-calendar-month")),
                () => Assert.Equal("manual", cut.Find(".forma-popover").GetAttribute("popover")));
        }

        [Fact]
        public async Task Should_close_the_popover_and_collapse_the_trigger_when_dismissed_by_escape()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var router = new InputRouterProbe(ctx);
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);
            cut.Find(".forma-date-picker-trigger").Click();

            // Act
            await router.DismissAsync(cut.FindComponent<FormaPopover>().Instance.RootElement, DismissBehavior.Dismiss, DismissReason.Escape);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll(".forma-date-picker-popover")),
                () => Assert.Equal("false", cut.Find(".forma-date-picker-trigger").GetAttribute("aria-expanded")));
        }

        [Fact]
        public async Task Should_close_the_popover_when_pressed_away()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var router = new InputRouterProbe(ctx);
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);
            cut.Find(".forma-date-picker-trigger").Click();

            // Act
            await router.DismissAsync(cut.FindComponent<FormaPopover>().Instance.RootElement, DismissBehavior.Dismiss, DismissReason.PressAway);

            // Assert
            Assert.Empty(cut.FindAll(".forma-date-picker-popover"));
        }

        [Fact]
        public void Should_write_the_picked_day_to_the_model_and_close()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel();
            var completed = 0;
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" OnSelectionComplete="() => completed++" />
            </FakeFormHost>);
            cut.Find(".forma-date-picker-trigger").Click();

            // Act
            cut.FindAll(".forma-calendar-day").First(day => day.TextContent.Trim() == "15" && !day.ClassList.Contains("empty")).Click();

            // Assert
            Assert.Multiple(
                () => Assert.Equal(15, model.Date!.Value.Day),
                () => Assert.Equal(1, completed),
                () => Assert.Empty(cut.FindAll(".forma-date-picker-popover")));
        }

        [Fact]
        public void Should_highlight_the_value_as_the_selected_day()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel { Date = new DateOnly(2025, 3, 15) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-date-picker-trigger").Click();

            // Assert
            var selected = Assert.Single(cut.FindAll(".forma-calendar-day.selected"));
            Assert.Equal("15", selected.TextContent.Trim());
        }

        [Fact]
        public void Should_render_the_label()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start Date" />
            </FakeFormHost>);

            // Assert
            Assert.Equal("Start Date", cut.Find(".forma-field-label").TextContent);
        }

        [Fact]
        public void Should_reject_a_blank_label()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel();

            // Act & Assert
            Assert.Throws<ArgumentException>(() => ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label=" " />
            </FakeFormHost>));
        }

        [Fact]
        public void Should_offer_clearing_only_while_there_is_a_value()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var filled = new FakeModel { Date = new DateOnly(2025, 6, 1) };
            var empty = new FakeModel();

            // Act
            var withValue = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(filled))">
                <FormaDatePicker @bind-Value="filled.Date" Label="Start date" />
            </FakeFormHost>);
            var withoutValue = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(empty))">
                <FormaDatePicker @bind-Value="empty.Date" Label="Start date" />
            </FakeFormHost>);

            // Assert
            Assert.Multiple(
                () => Assert.Single(withValue.FindAll(".forma-date-picker-clear")),
                () => Assert.Empty(withoutValue.FindAll(".forma-date-picker-clear")));
        }

        [Fact]
        public void Should_clear_the_value_on_a_clear_click()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel { Date = new DateOnly(2025, 6, 1) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-date-picker-clear").Click();

            // Assert
            Assert.Null(model.Date);
        }

        [Fact]
        public void Should_pass_the_allowed_dates_to_the_calendar()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel { Date = new DateOnly(2025, 3, 15) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" MinDate="@(new DateOnly(2025, 3, 10))" MaxDate="@(new DateOnly(2025, 3, 20))" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-date-picker-trigger").Click();

            // Assert
            var day5 = cut.FindAll(".forma-calendar-day").First(day => day.TextContent.Trim() == "5" && !day.ClassList.Contains("empty"));
            Assert.True(day5.HasAttribute("disabled"));
        }

        [Fact]
        public void Should_pass_additional_attributes_to_the_trigger()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" data-testid="my-date" />
            </FakeFormHost>);

            // Assert
            Assert.Equal("my-date", cut.Find(".forma-date-picker-trigger").GetAttribute("data-testid"));
        }

        [Fact]
        public async Task Should_carry_the_fields_validation_class()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel();
            var editContext = new EditContext(model);
            var cut = ctx.Render(@<FakeFormHost EditContext="editContext">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);

            // Act
            var messages = new ValidationMessageStore(editContext);
            messages.Add(new FieldIdentifier(model, nameof(model.Date)), "A date is required.");
            await cut.InvokeAsync(editContext.NotifyValidationStateChanged);

            // Assert
            Assert.Multiple(
                () => Assert.Contains("invalid", cut.Find(".forma-date-picker-trigger").ClassList),
                () => Assert.Equal("A date is required.", cut.Find(".forma-field-message").TextContent));
        }

        [Fact]
        public void Should_open_under_the_fields_start_edge()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Date" Label="Start date" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-date-picker-trigger").Click();

            // Assert
            Assert.Equal(PopoverAlignment.Start, cut.FindComponent<FormaPopover>().Instance.Alignment);
        }
    }

    public sealed class DateThatCannotBeEmpty
    {
        private static void PickDay(IRenderedComponent<IComponent> cut, int day)
        {
            cut.Find(".forma-date-picker-trigger").Click();
            cut.FindAll(".forma-calendar-day").First(cell => cell.TextContent.Trim() == day.ToString(CultureInfo.InvariantCulture) && !cell.ClassList.Contains("empty")).Click();
        }

        [Fact]
        public void Should_write_the_picked_day_to_the_model()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new Deadline { Due = new DateOnly(2025, 6, 1) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Due" Label="Due date" />
            </FakeFormHost>);

            // Act
            PickDay(cut, 15);

            // Assert
            Assert.Equal(new DateOnly(2025, 6, 15), model.Due);
        }

        [Fact]
        public void Should_keep_the_date_and_report_the_field_when_cleared()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new Deadline { Due = new DateOnly(2025, 6, 1) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Due" Label="Due date" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-date-picker-clear").Click();

            // Assert
            Assert.Multiple(
                () => Assert.Equal(new DateOnly(2025, 6, 1), model.Due),
                () => Assert.Contains("invalid", cut.Find(".forma-date-picker-trigger").ClassList),
                () => Assert.Equal("The Due date field is required.", cut.Find(".forma-field-message").TextContent),
                () => Assert.Contains("placeholder", cut.Find(".forma-date-picker-value").ClassList),
                () => Assert.Empty(cut.FindAll(".forma-date-picker-clear")));
        }

        [Fact]
        public void Should_clear_the_report_once_a_day_is_picked_again()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new Deadline { Due = new DateOnly(2025, 6, 1) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Due" Label="Due date" />
            </FakeFormHost>);
            cut.Find(".forma-date-picker-clear").Click();

            // Act
            PickDay(cut, 20);

            // Assert
            Assert.Multiple(
                () => Assert.Equal(20, model.Due.Day),
                () => Assert.DoesNotContain("invalid", cut.Find(".forma-date-picker-trigger").ClassList),
                () => Assert.Empty(cut.FindAll(".forma-field-message")));
        }

        [Fact]
        public void Should_refuse_a_value_that_is_not_a_date()
        {
            // Arrange
            using var ctx = new FormaDatePickerTests();
            var model = new Deadline();

            // Act
            var render = () => ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDatePicker @bind-Value="model.Note" Label="Note" />
            </FakeFormHost>);

            // Assert
            Assert.Throws<InvalidOperationException>(render);
        }

        private sealed class Deadline
        {
            public DateOnly Due { get; set; }

            public string? Note { get; set; }
        }
    }
}
