                <FormaPasswordBox @bind-Value="model.Text" Label="Password" StrengthOptions="@(new PasswordStrengthOptions { ShowMeter = true })" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-field-input").Input("abcdefghIJ1!longer");

            // Assert
            Assert.Equal(5, cut.FindAll(".forma-password-box-strength-segment").Count);
            Assert.Equal(5, cut.FindAll(".forma-password-box-strength-segment.filled").Count);
        }

