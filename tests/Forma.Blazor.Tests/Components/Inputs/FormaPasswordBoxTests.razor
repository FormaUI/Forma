        {
            // Arrange
            using var ctx = new FormaPasswordBoxTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaPasswordBox @bind-Value="model.Text" Label="Password" StrengthOptions="@(new PasswordStrengthOptions { ShowAdvice = true })" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-field-input").Input("abcdef");

            // Assert
            var advice = cut.FindAll(".forma-password-box-advice li").Select(li => li.TextContent).ToArray();
            Assert.Equal(
                ["Use at least 12 characters.", "Mix uppercase and lowercase letters.", "Add a number.", "Add a symbol."],
                advice);
        }

