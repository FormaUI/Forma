        [Fact]
        public void Should_show_a_strength_meter_once_a_value_is_typed()
        {
            // Arrange
            using var ctx = new FormaPasswordBoxTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaPasswordBox @bind-Value="model.Text" Label="Password" StrengthOptions="@(new PasswordStrengthOptions { ShowMeter = true })" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-field-input").Input("abc");

            // Assert
            Assert.Single(cut.FindAll(".forma-password-box-strength"));
        }

        [Theory]
        [InlineData("abc", "strength-weak")]
        [InlineData("abcdefghij", "strength-weak")]
        [InlineData("abcdefghijkl", "strength-fair")]
        [InlineData("abcdefghIJ1", "strength-good")]
        [InlineData("abcdefghIJ12longer", "strength-strong")]
        [InlineData("abcdefghIJ1!longer", "strength-very-strong")]
        public void Should_rate_a_value(string password, string expected)
        {
            // Arrange
            using var ctx = new FormaPasswordBoxTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaPasswordBox @bind-Value="model.Text" Label="Password" StrengthOptions="@(new PasswordStrengthOptions { ShowMeter = true })" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-field-input").Input(password);

            // Assert
            Assert.Contains(expected, cut.Find(".forma-password-box-strength").ClassList);
        }

