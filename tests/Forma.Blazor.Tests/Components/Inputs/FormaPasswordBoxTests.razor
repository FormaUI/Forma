        [Fact]
        public void Should_render_label_text()
        {
            // Arrange
            using var ctx = new FormaPasswordBoxTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaPasswordBox @bind-Value="model.Text" Label="Password" />
            </FakeFormHost>);

            // Assert
            Assert.Contains("Password", cut.Find(".forma-field-label").TextContent, StringComparison.Ordinal);
        }

