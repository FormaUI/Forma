            Assert.Throws<ArgumentException>(() => ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Count" Label="In stock" MinDecimalPlaces="2" />
            </FakeFormHost>));
        }
    }

    public sealed class Adornment
    {
        [Fact]
        public void Should_stand_the_adornment_beside_the_number_pin_the_label_and_describe_the_number_by_it()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            using var culture = new CultureFixture("en-US");
            var model = new Stock { Price = 12m };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Price" Label="Price" Adornment="@(new NumberAdornment("$", AdornmentSide.Start, "USD"))" />
            </FakeFormHost>);

            // Assert
            var input = cut.Find("input");
            var adornment = cut.Find(".forma-number-input-adornment");
            Assert.Multiple(
                () => Assert.Equal("$", adornment.TextContent.Trim()),
                () => Assert.Equal("true", adornment.GetAttribute("aria-hidden")),
                () => Assert.Contains("forma-number-input-adornment-start", adornment.ClassList),
                () => Assert.Contains("forma-number-input-room-start", input.ClassList),
                () => Assert.Contains("--forma-number-input-adornment-size: 1ch", input.GetAttribute("style") ?? string.Empty, StringComparison.Ordinal),
                () => Assert.Contains("forma-field-label-pinned", cut.Find(".forma-field").ClassList),
                () => Assert.Equal("USD", cut.Find($"[id='{input.GetAttribute("aria-describedby")}']").TextContent.Trim()),
                () => Assert.Equal("12", input.GetAttribute("value")));
        }

        [Theory]
        [InlineData("he-IL", AdornmentSide.Start, "forma-number-input-room-end")]
        [InlineData("he-IL", AdornmentSide.End, "forma-number-input-room-start")]
        [InlineData("en-US", AdornmentSide.End, "forma-number-input-room-end")]
        public void Should_make_room_on_the_side_of_the_left_to_right_number_where_the_adornment_stands(string name, AdornmentSide side, string room)
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            using var culture = new CultureFixture(name);
            var model = new Stock();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Price" Label="Price" Adornment="@(new NumberAdornment("$", side))" />
            </FakeFormHost>);

            // Assert
            Assert.Contains(room, cut.Find("input").ClassList);
        }

        [Fact]
        public void Should_describe_the_number_by_nothing_where_the_adornment_has_no_description()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            var model = new Stock();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Price" Label="Share" Adornment="@(new NumberAdornment("%", AdornmentSide.End))" />
            </FakeFormHost>);

            // Assert
            Assert.Null(cut.Find("input").GetAttribute("aria-describedby"));
        }

        [Fact]
        public void Should_keep_the_number_and_its_adornment_in_one_box_without_a_label()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            var model = new Stock();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Price" Adornment="@(new NumberAdornment("kg", AdornmentSide.End))" />
            </FakeFormHost>);

            // Assert
            var box = cut.Find(".forma-number-input-box");
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll(".forma-field")),
                () => Assert.NotNull(box.QuerySelector("input")),
                () => Assert.NotNull(box.QuerySelector(".forma-number-input-adornment")));
        }
    }

