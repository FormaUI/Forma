        [Fact]
        public void Should_render_a_spin_button_with_its_number_and_limits()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            using var culture = new CultureFixture("en-US");
            var model = new Stock { Count = 5 };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Count" Label="In stock" Min="0" Max="10" />
            </FakeFormHost>);

            // Assert
            var input = cut.Find("input");
            Assert.Multiple(
                () => Assert.Equal("spinbutton", input.GetAttribute("role")),
                () => Assert.Equal("text", input.GetAttribute("type")),
                () => Assert.Equal("ltr", input.GetAttribute("dir")),
                () => Assert.Equal("5", input.GetAttribute("value")),
                () => Assert.Equal("5", input.GetAttribute("aria-valuenow")),
                () => Assert.Equal("0", input.GetAttribute("aria-valuemin")),
                () => Assert.Equal("10", input.GetAttribute("aria-valuemax")),
                () => Assert.Equal("numeric", input.GetAttribute("inputmode")),
                () => Assert.Equal("In stock", cut.Find("label.forma-field-label").TextContent.Trim()));
        }

