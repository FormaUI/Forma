        [Theory]
        [InlineData("en-US", "1,234", 1234)]
        [InlineData("en-US", "-12,345.5", -12345.5)]
        [InlineData("en-US", "1234.5", 1234.5)]
        [InlineData("de-DE", "1.234,5", 1234.5)]
        [InlineData("en-IN", "12,34,567", 1234567)]
        [InlineData("fr-FR", "1 234,5", 1234.5)]
        public void Should_read_a_number_grouped_as_the_culture_groups_it(string name, string typed, double expected)
        {
