    public sealed class Stepping
    {
        [Fact]
        public void Should_declare_the_vertical_arrows_as_routes_on_the_field()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            var router = new InputRouterProbe(ctx);
            var model = new Stock();

            // Act
            ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Count" Label="In stock" />
            </FakeFormHost>);

            // Assert
            Assert.Equal(["number-input.increase:ArrowUp", "number-input.decrease:ArrowDown"], InputRouterProbe.GetRoutes(router.Registrations.Last()));
        }

        [Fact]
        public async Task Should_step_the_number_by_the_step_either_way()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            using var culture = new CultureFixture("en-US");
            var router = new InputRouterProbe(ctx);
            var model = new Stock { Price = 2m };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Price" Label="Price" Step="0.5m" />
            </FakeFormHost>);

            // Act
            await router.RouteAsync("number-input.increase", "ArrowUp");
            await router.RouteAsync("number-input.increase", "ArrowUp");
            await router.RouteAsync("number-input.decrease", "ArrowDown");

            // Assert
            Assert.Multiple(
                () => Assert.Equal(2.5m, model.Price),
                () => Assert.Equal("2.5", cut.Find("input").GetAttribute("value")));
        }

        [Fact]
        public async Task Should_show_a_stepped_number_without_the_zeros_a_sum_keeps()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            using var culture = new CultureFixture("en-US");
            var router = new InputRouterProbe(ctx);
            var model = new Stock { Price = 12.5m };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Price" Label="Price" Step="0.5m" />
            </FakeFormHost>);

            // Act
            await router.RouteAsync("number-input.increase", "ArrowUp");

            // Assert
            Assert.Equal("13", cut.Find("input").GetAttribute("value"));
        }

        [Fact]
        public async Task Should_stop_a_step_at_the_limits()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            var router = new InputRouterProbe(ctx);
            var model = new Stock { Count = 9 };
            ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Count" Label="In stock" Min="0" Max="10" Step="5" />
            </FakeFormHost>);

            // Act
            await router.RouteAsync("number-input.increase", "ArrowUp");
            var afterUp = model.Count;
            await router.RouteAsync("number-input.decrease", "ArrowDown");
            await router.RouteAsync("number-input.decrease", "ArrowDown");
            await router.RouteAsync("number-input.decrease", "ArrowDown");

            // Assert
            Assert.Multiple(
                () => Assert.Equal(10, afterUp),
                () => Assert.Equal(0, model.Count));
        }

        [Theory]
        [InlineData("number-input.increase", "ArrowUp", 3)]
        [InlineData("number-input.decrease", "ArrowDown", 8)]
        public async Task Should_start_an_empty_number_from_the_limit_it_moves_away_from(string action, string key, int expected)
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            var router = new InputRouterProbe(ctx);
            var model = new Stock();
            ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Count" Label="In stock" Min="3" Max="8" />
            </FakeFormHost>);

            // Act
            await router.RouteAsync(action, key);

            // Assert
            Assert.Equal(expected, model.Count);
        }

