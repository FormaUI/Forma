        [Fact]
        public async Task Should_stop_a_step_at_the_largest_number_its_type_holds()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            var router = new InputRouterProbe(ctx);
            var model = new Stock { Count = int.MaxValue };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Count" Label="In stock" />
            </FakeFormHost>);

            // Act
            await router.RouteAsync("number-input.increase", "ArrowUp");

            // Assert
            Assert.Multiple(
                () => Assert.Equal(int.MaxValue, model.Count),
                () => Assert.Empty(cut.FindAll(".forma-field-message")));
        }

        [Fact]
        public async Task Should_show_the_number_a_step_lands_on_in_place_of_text_it_could_not_read()
        {
            // Arrange — the number stands at its limit, with a word typed over it
            using var ctx = new FormaNumberInputTests();
            var router = new InputRouterProbe(ctx);
            var model = new Stock { Count = 10 };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Count" Label="In stock" Max="10" />
            </FakeFormHost>);
            cut.Find("input").Change("ten");
            var unread = cut.Find("input").GetAttribute("value");

            // Act — a step at the limit lands on the same number
            await router.RouteAsync("number-input.increase", "ArrowUp");

            // Assert
            Assert.Multiple(
                () => Assert.Equal("ten", unread),
                () => Assert.Equal(10, model.Count),
                () => Assert.Equal("10", cut.Find("input").GetAttribute("value")),
                () => Assert.Empty(cut.FindAll(".forma-field-message")));
        }

        [Fact]
        public async Task Should_leave_a_read_only_or_disabled_number_alone()
        {
            // Arrange
            using var ctx = new FormaNumberInputTests();
            var router = new InputRouterProbe(ctx);
            var model = new Stock { Count = 5, Limit = 5 };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaNumberInput @bind-Value="model.Count" Label="In stock" ReadOnly="true" />
                <FormaNumberInput @bind-Value="model.Limit" Label="Usage limit" Disabled="true" />
            </FakeFormHost>);
            var inputs = cut.FindComponents<FormaNumberInput<int?>>().Select(input => input.Instance.RootElement).ToList();
            var limit = cut.FindComponent<FormaNumberInput<int>>().Instance.RootElement;

            // Act
            await router.RouteAsync(inputs[0], "number-input.increase", "ArrowUp");
            await router.RouteAsync(limit, "number-input.increase", "ArrowUp");

            // Assert
            Assert.Multiple(
                () => Assert.Equal(5, model.Count),
                () => Assert.Equal(5, model.Limit),
                () => Assert.True(cut.FindAll("input")[0].HasAttribute("readonly")),
                () => Assert.True(cut.FindAll("input")[1].HasAttribute("disabled")));
        }
    }

    private sealed class Stock
    {
        public int? Count { get; set; }

        public int Limit { get; set; }

        public decimal? Price { get; set; }

        public string? Note { get; set; }
    }
}
