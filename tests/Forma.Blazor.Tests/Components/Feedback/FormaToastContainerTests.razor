@inherits FormaBunitContext
@code {
    // Longer than any test runs, so no toast expires under a check that isn't about expiry.
    private static readonly TimeSpan Held = TimeSpan.FromHours(1);

    public sealed class Component
    {
        [Fact]
        public void Should_render_container()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();

            // Act
            var cut = ctx.Render(@<FormaToastContainer />);

            // Assert
            cut.Find(".forma-toast-container");
        }

        [Fact]
        public void Should_announce_toasts_through_a_live_region()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();

            // Act
            var cut = ctx.Render(@<FormaToastContainer />);
            var container = cut.Find(".forma-toast-container");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("status", container.GetAttribute("role"));
                Assert.Equal("polite", container.GetAttribute("aria-live"));
            });
        }

        [Fact]
        public async Task Should_mark_severity_without_relying_on_colour()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();
            var cut = ctx.Render(@<FormaToastContainer />);
            var service = ctx.Services.GetRequiredService<IToastService>();
            var expected = ctx.Render(@<FormaIcon Icon="Glyph.CircleCross" Size="IconSize.Small" />).Find("path").GetAttribute("d");

            // Act
            await service.ShowAsync("Broke!", ToastType.Error, duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            var marker = cut.Find(".forma-toast-marker");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(expected, marker.QuerySelector("svg path")!.GetAttribute("d"));
                Assert.Equal("true", marker.GetAttribute("aria-hidden"));
            });
        }

        [Fact]
        public void Should_be_empty_initially()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();

            // Act
            var cut = ctx.Render(@<FormaToastContainer />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-toast"));
        }

        [Fact]
        public async Task Should_show_toast_when_service_invoked()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();
            var cut = ctx.Render(@<FormaToastContainer />);
            var service = ctx.Services.GetRequiredService<IToastService>();

            // Act
            await service.ShowAsync("Saved!", duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            var message = cut.Find(".forma-toast-message");

            // Assert
            Assert.Equal("Saved!", message.TextContent);
        }

        [Fact]
        public async Task Should_apply_success_class_by_default()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();
            var cut = ctx.Render(@<FormaToastContainer />);
            var service = ctx.Services.GetRequiredService<IToastService>();

            // Act
            await service.ShowAsync("Done!", duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            var toast = cut.Find(".forma-toast");

            // Assert
            Assert.Contains("forma-toast-success", toast.ClassList);
        }

        [Theory]
        [InlineData(ToastType.Success, "forma-toast-success")]
        [InlineData(ToastType.Error, "forma-toast-error")]
        [InlineData(ToastType.Info, "forma-toast-info")]
        [InlineData(ToastType.Warning, "forma-toast-warning")]
        public async Task Should_apply_correct_type_class(ToastType type, string expectedClass)
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();
            var cut = ctx.Render(@<FormaToastContainer />);
            var service = ctx.Services.GetRequiredService<IToastService>();

            // Act
            await service.ShowAsync("Test", type, duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            var toast = cut.Find(".forma-toast");

            // Assert
            Assert.Contains(expectedClass, toast.ClassList);
        }

        [Fact]
        public async Task Should_show_multiple_toasts()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();
            var cut = ctx.Render(@<FormaToastContainer />);
            var service = ctx.Services.GetRequiredService<IToastService>();

            // Act
            await service.ShowAsync("First", ToastType.Success, duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            await service.ShowAsync("Second", ToastType.Error, duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            await service.ShowAsync("Third", ToastType.Warning, duration: Held, cancellationToken: TestContext.Current.CancellationToken);

            // Assert
            Assert.Equal(3, cut.FindAll(".forma-toast").Count);
        }

        [Fact]
        public async Task Should_remove_toast_on_close_click()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();
            var cut = ctx.Render(@<FormaToastContainer />);
            var service = ctx.Services.GetRequiredService<IToastService>();
            await service.ShowAsync("Remove me", duration: Held, cancellationToken: TestContext.Current.CancellationToken);

            // Act
            await cut.Find("[aria-label='Dismiss']").ClickAsync(new());

            // Assert
            Assert.Empty(cut.FindAll(".forma-toast"));
        }

        [Fact]
        public async Task Should_remove_only_clicked_toast()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();
            var cut = ctx.Render(@<FormaToastContainer />);
            var service = ctx.Services.GetRequiredService<IToastService>();
            await service.ShowAsync("Keep me", ToastType.Success, duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            await service.ShowAsync("Remove me", ToastType.Error, duration: Held, cancellationToken: TestContext.Current.CancellationToken);

            // Act
            var closeButtons = cut.FindAll("[aria-label='Dismiss']");
            await closeButtons[1].ClickAsync(new());

            // Assert
            Assert.Equal("Keep me", cut.Find(".forma-toast-message").TextContent);
        }
    }

    public sealed class Service
    {
        [Fact]
        public async Task Should_track_toasts_in_service()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();
            ctx.Render(@<FormaToastContainer />);
            var service = ctx.Services.GetRequiredService<IToastService>();
            Assert.Empty(service.Toasts);

            // Act & Assert — after first toast
            await service.ShowAsync("One", duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            Assert.Single(service.Toasts);

            // Act & Assert — after second toast
            await service.ShowAsync("Two", duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            Assert.Equal(2, service.Toasts.Count);
        }

        [Fact]
        public async Task Should_remove_by_id()
        {
            // Arrange
            using var ctx = new FormaToastContainerTests();
            ctx.Render(@<FormaToastContainer />);
            var service = ctx.Services.GetRequiredService<IToastService>();
            await service.ShowAsync("Test", duration: Held, cancellationToken: TestContext.Current.CancellationToken);
            var id = service.Toasts[0].Id;

            // Act
            await service.RemoveAsync(id, TestContext.Current.CancellationToken);

            // Assert
            Assert.Empty(service.Toasts);
        }
    }
}
