@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        private static readonly DialogOptions HideConfirmAction =
            new() { ShowConfirmAction = false };

        private static readonly DialogOptions HideFooterActions =
            new() { ShowCancelAction = false, ShowConfirmAction = false };

        [Fact]
        public void Should_render_dialog_element()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" />);

            // Assert
            cut.Find("dialog");
        }

        [Fact]
        public void Should_render_title_in_header_when_provided()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" Title="Test Title" />);
            var header = cut.Find(".forma-dialog-header h5");

            // Assert
            Assert.Equal("Test Title", header.TextContent);
        }

        [Fact]
        public void Should_not_render_header_when_title_is_null()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-dialog-header"));
        }

        [Fact]
        public void Should_name_itself_by_its_title()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Id="report" Opened="false" OnClose="@(() => { })" Title="Test Title" />);

            // Assert
            Assert.Equal("report-title", cut.Find("dialog").GetAttribute("aria-labelledby"));
            Assert.Equal("Test Title", cut.Find("#report-title").TextContent);
        }

        [Fact]
        public void Should_leave_its_name_to_the_host_when_it_has_no_title()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" />);

            // Assert
            Assert.False(cut.Find("dialog").HasAttribute("aria-labelledby"));
        }

        [Fact]
        public void Should_render_child_content()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })">
                    <Body><p>Hello Modal</p></Body>
                </FormaDialog>);
            var body = cut.Find(".forma-dialog-body");

            // Assert
            Assert.Contains("Hello Modal", body.InnerHtml, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_render_footer_content_when_provided()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })">
                    <Footer><button>Save</button></Footer>
                </FormaDialog>);
            var footer = cut.Find(".forma-dialog-footer");

            // Assert
            Assert.Contains("Save", footer.InnerHtml, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_not_render_footer_when_not_provided()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" Options="HideFooterActions" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-dialog-footer"));
        }

        [Fact]
        public void Should_render_default_footer_actions_when_enabled()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" />);
            var footer = cut.Find(".forma-dialog-footer");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("Cancel", footer.TextContent, StringComparison.Ordinal);
                Assert.Contains("Confirm", footer.TextContent, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_render_footer_content_and_default_actions_together_when_enabled()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })">
                    <Footer><span>Custom</span></Footer>
                </FormaDialog>);
            var footer = cut.Find(".forma-dialog-footer");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("Custom", footer.TextContent, StringComparison.Ordinal);
                Assert.Contains("Cancel", footer.TextContent, StringComparison.Ordinal);
                Assert.Contains("Confirm", footer.TextContent, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_render_close_only_when_confirm_action_is_hidden()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" Options="HideConfirmAction" />);
            var footer = cut.Find(".forma-dialog-footer");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("Close", footer.TextContent, StringComparison.Ordinal);
                Assert.DoesNotContain("Confirm", footer.TextContent, StringComparison.Ordinal);
            });
        }

        [Fact]
        public void Should_add_no_header_class_when_title_is_null()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" />);
            var body = cut.Find(".forma-dialog-body");

            // Assert
            Assert.Contains("no-header", body.ClassList);
        }

        [Theory]
        [InlineData(DialogSize.Small, "forma-dialog-small")]
        [InlineData(DialogSize.Medium, "forma-dialog-medium")]
        [InlineData(DialogSize.Large, "forma-dialog-large")]
        [InlineData(DialogSize.ExtraLarge, "forma-dialog-extralarge")]
        [InlineData(DialogSize.Full, "forma-dialog-full")]
        public void Should_apply_size_class(DialogSize size, string expectedClass)
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" Size="@size" />);
            var dialog = cut.Find("dialog");

            // Assert
            Assert.Contains(expectedClass, dialog.ClassList);
        }

        [Fact]
        public void Should_default_to_medium_size()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" />);
            var dialog = cut.Find("dialog");

            // Assert
            Assert.Contains("forma-dialog-medium", dialog.ClassList);
        }

        [Fact]
        public void Should_have_close_button_with_aria_label()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" Title="Test" />);
            var closeBtn = cut.Find(".forma-dialog-header button");

            // Assert
            Assert.Equal("Close", closeBtn.GetAttribute("aria-label"));
        }

        [Fact]
        public void Should_register_a_modal_scope_while_open()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="true" OnClose="@(() => { })" />);

            // Assert
            cut.WaitForAssertion(() =>
            {
                var profile = Assert.Single(GetRegistrations(ctx));
                Assert.Multiple(
                    () => Assert.True(profile.Modal),
                    () => Assert.Equal(DismissBehavior.Dismiss, profile.Escape),
                    () => Assert.Equal(DismissBehavior.Dismiss, profile.CloseRequest),
                    () => Assert.Equal(PressAwayBehavior.Ignore, profile.PressAway));
            });
        }

        [Fact]
        public void Should_not_register_a_scope_while_closed()
        {
            // Arrange
            using var ctx = new FormaDialogTests();

            // Act
            var cut = ctx.Render(
                @<FormaDialog Opened="false" OnClose="@(() => { })" />);

            // Assert
            Assert.Empty(GetRegistrations(ctx));
        }

        [Fact]
        public async Task Should_close_the_dialog_when_the_router_dismisses_it()
        {
            // Arrange
            using var ctx = new FormaDialogTests();
            var cut = ctx.Render(
                @<FormaDialog Opened="true" OnClose="@(() => { })" />);
            cut.WaitForAssertion(() => Assert.Single(GetRegistrations(ctx)));

            // Act
            await ctx.Router.DismissAsync(cut.FindComponent<FormaDialog>().Instance.RootElement, DismissBehavior.Dismiss, DismissReason.Escape);

            // Assert
            Assert.Contains(ctx.Dialog.Invocations, invocation => invocation.Identifier == "close");
        }

        [Fact]
        public async Task Should_run_the_default_cancel_action_when_the_router_cancels_it()
        {
            // Arrange
            using var ctx = new FormaDialogTests();
            var canceled = false;
            var cut = ctx.Render(
                @<FormaDialog Opened="true" OnClose="@(() => { })" OnCancel="() => canceled = true" />);
            cut.WaitForAssertion(() => Assert.Single(GetRegistrations(ctx)));

            // Act
            await ctx.Router.DismissAsync(cut.FindComponent<FormaDialog>().Instance.RootElement, DismissBehavior.Cancel, DismissReason.CloseRequest);

            // Assert
            Assert.Multiple(
                () => Assert.True(canceled),
                () => Assert.Contains(ctx.Dialog.Invocations, invocation => invocation.Identifier == "close"));
        }

        [Fact]
        public async Task Should_leave_the_dialog_open_when_the_router_ignores_the_request()
        {
            // Arrange
            using var ctx = new FormaDialogTests();
            var cut = ctx.Render(
                @<FormaDialog Opened="true" OnClose="@(() => { })" />);
            cut.WaitForAssertion(() => Assert.Single(GetRegistrations(ctx)));

            // Act
            await ctx.Router.DismissAsync(cut.FindComponent<FormaDialog>().Instance.RootElement, DismissBehavior.Ignore, DismissReason.Escape);

            // Assert
            Assert.DoesNotContain(ctx.Dialog.Invocations, invocation => invocation.Identifier == "close");
        }

        [Fact]
        public async Task Should_stay_closed_after_the_user_closed_it_while_opened_is_still_true()
        {
            // Arrange
            using var ctx = new FormaDialogTests();
            var cut = ctx.Render(
                @<FormaDialog Opened="true" OnClose="@(() => { })" />);
            cut.WaitForAssertion(() => Assert.Single(GetRegistrations(ctx)));

            // Act
            await cut.Find("dialog").TriggerEventAsync("onclose", new EventArgs());
            cut.Render();

            // Assert
            Assert.Multiple(
                () => Assert.Single(ctx.Dialog.Invocations, invocation => invocation.Identifier == "open"),
                () => Assert.Single(GetRegistrations(ctx)));
        }

        [Fact]
        public async Task Should_open_again_once_the_parent_asks_after_the_user_closed_it()
        {
            // Arrange
            using var ctx = new FormaDialogTests();
            var cut = ctx.Render<FormaDialog>(parameters => parameters
                .Add(p => p.Opened, true)
                .Add(p => p.OnClose, () => { }));
            cut.WaitForAssertion(() => Assert.Single(GetRegistrations(ctx)));

            // Act
            await cut.Find("dialog").TriggerEventAsync("onclose", new EventArgs());
            cut.Render(parameters => parameters.Add(p => p.Opened, false));
            cut.Render(parameters => parameters.Add(p => p.Opened, true));

            // Assert
            cut.WaitForAssertion(() => Assert.Equal(2, ctx.Dialog.Invocations.Count(invocation => invocation.Identifier == "open")));
        }

        /// <summary>The profile of every scope the dialog registered with the router.</summary>
        private static List<InputProfile> GetRegistrations(FormaDialogTests ctx)
            => [.. ctx.Router.Registrations.Select(registration => (InputProfile)registration.Arguments[1]!)];
    }
}
