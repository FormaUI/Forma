        [Fact]
        public async Task Should_hold_the_viewport_in_place_when_items_are_added_before_the_one_it_opened_on()
        {
            // Arrange - a hundred rows, scrolled away from the start, so the row the viewport opened on is Row 50
            using var ctx = new FormaVirtualizeTests();
            var rows = CreateRows().ToList();
            ItemsProviderDelegate<Row> provider = request => ValueTask.FromResult(new ItemsProviderResult<Row>(rows.Skip(request.StartIndex).Take(request.Count), rows.Count));
            double? scrolledTo = null;
            ctx.JSInterop.SetupVoid("scrollTo", invocation => { scrolledTo = (double)invocation.Arguments[0]!; return true; }).SetVoidResult();
            var cut = ctx.Render(
                @<div>
                    <FormaVirtualize TItem="Row" ItemsProvider="provider" ItemKey="@(row => row.Id)" ItemSize="20" OverscanCount="2">
                        <ItemContent Context="row"><div class="row">@row.Name</div></ItemContent>
                    </FormaVirtualize>
                </div>);
            var virtualizer = Virtualizer(cut);
            await virtualizer.InvokeAsync(() => virtualizer.Instance.HandleViewportAsync(1000, 200, 20));

            // Act - ten rows land before Row 50
            rows.InsertRange(0, CreateRows(10).Select(row => row with { Id = row.Id - 10, Name = $"Row {row.Id - 10}" }));
            await virtualizer.InvokeAsync(() => virtualizer.Instance.RefreshDataAsync());

            // Assert - the viewport moves down by the ten rows' height, so Row 50 stands where it did, two items in for the overscan
