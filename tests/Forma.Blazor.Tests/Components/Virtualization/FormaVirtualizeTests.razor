        [Fact]
        public async Task Should_scroll_to_the_initial_item_once_attached()
        {
            // Arrange
            using var ctx = new FormaVirtualizeTests();
            ctx.JSInterop.Setup<bool>("reveal", _ => true).SetResult(true);

            // Act
            var cut = ctx.Render(
                @<div>
                    <FormaVirtualize TItem="Row" Items="CreateRows()" ItemKey="@(row => row.Id)" ItemSize="20" OverscanCount="2" InitialItemIndex="50">
                        <ItemContent Context="row"><div class="row">@row.Name</div></ItemContent>
                    </FormaVirtualize>
                </div>);

            // Assert — the item's own offset, opening the range drawn on it; the real scroll follows once attached
            cut.WaitForAssertion(() => Assert.Equal("Row 50", Drawn(cut)[0]), TimeSpan.FromSeconds(5));
            var scrollTo = ctx.JSInterop.Invocations.Last(invocation => invocation.Identifier == "scrollTo");
            Assert.Equal(1000d, scrollTo.Arguments[0]);
        }

        [Fact]
        public async Task Should_correct_the_initial_item_once_a_real_measurement_differs_from_the_estimate()
        {
            // Arrange — opens on item 50 by the estimated size of 20, before anything is measured
            using var ctx = new FormaVirtualizeTests();
            ctx.JSInterop.Setup<bool>("reveal", _ => true).SetResult(true);
            var cut = ctx.Render(
                @<div>
                    <FormaVirtualize TItem="Row" Items="CreateRows()" ItemKey="@(row => row.Id)" ItemSize="20" OverscanCount="2" InitialItemIndex="50">
                        <ItemContent Context="row"><div class="row">@row.Name</div></ItemContent>
                    </FormaVirtualize>
                </div>);
            cut.WaitForAssertion(() => Assert.Contains("scrollTo", ctx.JSInterop.Invocations.Select(invocation => invocation.Identifier)), TimeSpan.FromSeconds(5));
            var virtualizer = Virtualizer(cut);

            // Act — the real room an item takes turns out to be 25, not the 20 estimated
            await virtualizer.InvokeAsync(() => virtualizer.Instance.HandleViewportAsync(1000, 200, 25));

            // Assert — the item's real offset corrects the one the estimate opened it on
            var scrollTo = ctx.JSInterop.Invocations.Last(invocation => invocation.Identifier == "scrollTo");
            Assert.Equal(1250d, scrollTo.Arguments[0]);
        }

