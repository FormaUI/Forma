@inherits BunitContext

@code {
    public sealed class Component
    {
        private static readonly List<SelectOption<int>> Options =
        [
            new(1, "Cycling"),
            new(2, "Running"),
            new(3, "Swimming"),
        ];

        [Fact]
        public void Should_render_label_text()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" Label="Categories" />
            </FakeFormHost>);

            // Assert
            Assert.Contains("Categories", cut.Find(".forma-multi-select-label").TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_show_placeholder_when_nothing_selected()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" Placeholder="Pick some" />
            </FakeFormHost>);

            // Assert
            Assert.Equal("Pick some", cut.Find(".forma-multi-select-trigger-text").TextContent);
        }

        [Fact]
        public void Should_render_a_tag_for_each_selected_value()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel { Categories = [1, 2] };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);

            // Assert
            Assert.Equal(2, cut.FindAll(".forma-multi-select-tag").Count);
        }

        [Fact]
        public void Should_open_the_popup_on_trigger_click()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-multi-select-trigger").Click();

            // Assert
            cut.Find(".forma-multi-select-popup");
        }

        [Fact]
        public void Should_list_every_option_in_the_popup()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-multi-select-trigger").Click();

            // Assert
            Assert.Equal(3, cut.FindAll(".forma-multi-select-options .forma-checkbox-label").Count);
        }

        [Fact]
        public void Should_add_a_value_when_its_checkbox_is_checked()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);
            cut.Find(".forma-multi-select-trigger").Click();

            // Act
            cut.Find(".forma-multi-select-options .forma-checkbox").Change(true);

            // Assert
            Assert.Equal([1], model.Categories);
        }

        [Fact]
        public void Should_remove_a_value_when_its_tag_is_removed()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel { Categories = [1, 2] };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-multi-select-tag-remove").Click();

            // Assert
            Assert.Equal([2], model.Categories);
        }

        [Fact]
        public void Should_filter_options_by_the_search_text()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);
            cut.Find(".forma-multi-select-trigger").Click();

            // Act
            cut.Find(".forma-multi-select-search").Input("run");

            // Assert
            var remaining = cut.FindAll(".forma-multi-select-options .forma-checkbox-label");
            Assert.Single(remaining);
            Assert.Contains("Running", remaining[0].TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_show_no_results_message_when_search_matches_nothing()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);
            cut.Find(".forma-multi-select-trigger").Click();

            // Act
            cut.Find(".forma-multi-select-search").Input("zzz");

            // Assert
            cut.Find(".forma-multi-select-empty");
        }

        [Fact]
        public void Should_show_no_options_message_when_the_option_list_is_empty()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="@([])" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-multi-select-trigger").Click();

            // Assert
            Assert.Equal("No options available yet", cut.Find(".forma-multi-select-empty").TextContent);
        }

        [Fact]
        public void Should_not_render_add_new_action_by_default()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);

            // Act
            cut.Find(".forma-multi-select-trigger").Click();

            // Assert
            Assert.Empty(cut.FindAll(".forma-multi-select-add"));
        }

        [Fact]
        public void Should_raise_on_add_new_with_the_search_text()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            string? raised = null;
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options"
                                          AllowAdd="true" OnAddNew="@(text => raised = text)" />
            </FakeFormHost>);
            cut.Find(".forma-multi-select-trigger").Click();
            cut.Find(".forma-multi-select-search").Input("Yoga");

            // Act
            cut.Find(".forma-multi-select-add").Click();

            // Assert
            Assert.Equal("Yoga", raised);
        }

        [Fact]
        public void Should_close_the_popup_when_the_backdrop_is_clicked()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);
            cut.Find(".forma-multi-select-trigger").Click();

            // Act
            cut.Find(".forma-multi-select-backdrop").Click();

            // Assert
            Assert.Empty(cut.FindAll(".forma-multi-select-popup"));
        }

        [Fact]
        public void Should_disable_the_trigger_and_tags_when_disabled()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel { Categories = [1] };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" Disabled="true" />
            </FakeFormHost>);

            // Assert
            Assert.True(cut.Find(".forma-multi-select-tag-remove").HasAttribute("disabled"));
            Assert.True(cut.Find(".forma-multi-select-trigger").HasAttribute("disabled"));
        }

        [Fact]
        public void Should_report_the_open_state_through_aria_expanded()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);
            Assert.Equal("false", cut.Find(".forma-multi-select-trigger").GetAttribute("aria-expanded"));

            // Act
            cut.Find(".forma-multi-select-trigger").Click();

            // Assert
            Assert.Equal("true", cut.Find(".forma-multi-select-trigger").GetAttribute("aria-expanded"));
        }

        [Fact]
        public void Should_close_the_popup_on_escape()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" />
            </FakeFormHost>);
            cut.Find(".forma-multi-select-trigger").Click();

            // Act
            cut.Find(".forma-multi-select").KeyDown(Key.Escape);

            // Assert
            Assert.Empty(cut.FindAll(".forma-multi-select-popup"));
        }

        [Fact]
        public void Should_not_offer_add_new_until_the_search_text_is_unmatched()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="Options" AllowAdd="true" />
            </FakeFormHost>);
            cut.Find(".forma-multi-select-trigger").Click();

            // Act & Assert
            Assert.Empty(cut.FindAll(".forma-multi-select-add"));

            cut.Find(".forma-multi-select-search").Input("Cycling");
            Assert.Empty(cut.FindAll(".forma-multi-select-add"));

            cut.Find(".forma-multi-select-search").Input("Yoga");
            cut.Find(".forma-multi-select-add");
        }

        [Fact]
        public void Should_throw_when_options_is_null()
        {
            // Arrange
            using var ctx = new FormaMultiSelectDropDownTests();
            var model = new FakeModel();

            // Act & Assert
            Assert.Throws<ArgumentNullException>(() => ctx.Render(
                @<FakeFormHost EditContext="@(new EditContext(model))">
                    <FormaMultiSelectDropDown TValue="int" @bind-Value="model.Categories" Options="@(null!)" />
                </FakeFormHost>));
        }
    }
}
