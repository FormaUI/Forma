@inherits FormaBunitContext
@using Bunit.Rendering
@using Forma.Framework.Resources
@using Forma.Blazor.Components.Composer.Dialogs
@using Forma.Blazor.Components.Composer.RichTextEditor.Plugins
@using Forma.Blazor.Components.Explorer

@code {
    public sealed class Component
    {
        private sealed class StubLibrary(params ResourceInfo[] resources) : IExplorerItemsProvider
        {
            public ValueTask<ExplorerItemPage> GetItemsAsync(ExplorerItemQuery query, CancellationToken cancellationToken)
                => ValueTask.FromResult(new ExplorerItemPage(ExplorerItem.ForAll(resources), resources.Length));
        }

        private static readonly ResourceInfo Picture = new ImageResourceInfo("/media/podium.png");
        private static readonly ResourceInfo Clip = new VideoResourceInfo("/media/finish.mp4");
        private static readonly ResourceInfo Report = new DocumentResourceInfo("/media/report.pdf");

        private static void Choose(IRenderedComponent<ContainerFragment> cut, string name)
            => cut.FindAll(".forma-explorer-item-open").Single(button => button.GetAttribute("aria-label")!.Contains(name, StringComparison.Ordinal)).Click();

        private static void Confirm(IRenderedComponent<ContainerFragment> cut)
            => cut.FindAll("button").Single(button => button.TextContent.Trim() == "Insert").Click();

        [Fact]
        public void Should_hand_the_modal_the_open_state_it_was_given()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<IExplorerItemsProvider>(_ => new StubLibrary(Picture));

            // Act
            var cut = ctx.Render(@<FormaComposerExplorerDialog Opened="true" />);

            // Assert
            var modal = cut.FindComponent<Forma.Blazor.Components.Feedback.FormaModal>().Instance;
            Assert.True(modal.Opened);
            Assert.False(modal.Options.CloseOnConfirm);
        }

        [Fact]
        public void Should_say_so_when_nothing_is_registered_to_browse()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();

            // Act
            var cut = ctx.Render(@<FormaComposerExplorerDialog Opened="true" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-explorer"));
            Assert.Equal(
                "No stored files are available, because this application registered nowhere to browse.",
                cut.Find(".forma-composer-dialog-notice").TextContent.Trim());
        }

        [Fact]
        public void Should_list_every_kind_when_no_limit_is_given()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<IExplorerItemsProvider>(_ => new StubLibrary(Picture, Clip, Report));

            // Act
            var cut = ctx.Render(@<FormaComposerExplorerDialog Opened="true" />);

            // Assert
            Assert.Equal(3, cut.FindAll(".forma-explorer-item").Count);
        }

        [Fact]
        public void Should_list_only_the_kinds_the_limit_names()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<IExplorerItemsProvider>(_ => new StubLibrary(Picture, Clip, Report));
            var options = new ExplorerPluginOptions { AcceptedResourceKinds = "contentType:image" };

            // Act
            var cut = ctx.Render(@<FormaComposerExplorerDialog Opened="true" Options="options" />);

            // Assert
            var names = cut.FindAll(".forma-explorer-item-name").Select(item => item.TextContent.Trim()).ToList();
            Assert.Equal(["podium.png"], names);
        }

        [Fact]
        public void Should_ask_for_a_choice_when_confirmed_empty()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<IExplorerItemsProvider>(_ => new StubLibrary(Picture));
            var inserted = false;
            var cut = ctx.Render(@<FormaComposerExplorerDialog Opened="true" OnInsert="_ => inserted = true" />);

            // Act
            Confirm(cut);

            // Assert
            Assert.False(inserted);
            Assert.Equal("Choose a file before inserting.", cut.Find(".forma-composer-dialog-error[role=alert]").TextContent.Trim());
        }

        [Fact]
        public void Should_embed_a_picture_and_not_link_it_by_default()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<IExplorerItemsProvider>(_ => new StubLibrary(Picture));
            ResourceDialogResult? result = null;
            var cut = ctx.Render(@<FormaComposerExplorerDialog Opened="true" OnInsert="value => result = value" />);
            Choose(cut, "podium.png");

            // Act
            Confirm(cut);

            // Assert
            Assert.NotNull(result);
            Assert.Equal("image", result.Kind);
            Assert.True(result.Embed);
            Assert.False(result.Link);
        }

        [Fact]
        public void Should_both_embed_and_link_a_clip_when_asked_for_both()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<IExplorerItemsProvider>(_ => new StubLibrary(Clip));
            ResourceDialogResult? result = null;
            var options = new ExplorerPluginOptions { InsertMode = MediaInsertMode.Both };
            var cut = ctx.Render(@<FormaComposerExplorerDialog Opened="true" Options="options" OnInsert="value => result = value" />);
            Choose(cut, "finish.mp4");

            // Act
            Confirm(cut);

            // Assert
            Assert.NotNull(result);
            Assert.Equal("video", result.Kind);
            Assert.True(result.Embed);
            Assert.True(result.Link);
        }

        [Fact]
        public void Should_link_a_file_the_browser_cannot_render_whatever_the_mode_says()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<IExplorerItemsProvider>(_ => new StubLibrary(Report));
            ResourceDialogResult? result = null;
            var options = new ExplorerPluginOptions { InsertMode = MediaInsertMode.Embed };
            var cut = ctx.Render(@<FormaComposerExplorerDialog Opened="true" Options="options" OnInsert="value => result = value" />);
            Choose(cut, "report.pdf");

            // Act
            Confirm(cut);

            // Assert
            Assert.NotNull(result);
            Assert.Equal("file", result.Kind);
            Assert.False(result.Embed);
            Assert.True(result.Link);
        }
    }
}
