@inherits FormaBunitContext
@using Bunit.Rendering
@using Forma.Blazor.Components.Composer.Dialogs
@using Forma.Blazor.Components.Feedback

@code {
    public sealed class Component
    {
        private static void Fill(IRenderedComponent<ContainerFragment> cut, string label, string value)
        {
            var field = cut.FindAll("label.forma-field-label")
                .Single(candidate => candidate.TextContent.Trim().TrimEnd('*', ' ') == label);

            cut.Find($"#{field.GetAttribute("for")}").Input(value);
        }

        private static void Confirm(IRenderedComponent<ContainerFragment> cut)
            => cut.FindAll("button").Single(button => button.TextContent.Trim() == "Insert").Click();

        private static List<string> Alerts(IRenderedComponent<ContainerFragment> cut)
            => cut.FindAll(".forma-composer-dialog-error[role=alert]").Select(alert => alert.TextContent.Trim()).ToList();

        [Fact]
        public void Should_keep_the_modal_open_when_confirming_can_fail()
        {
            // Arrange
            using var ctx = new FormaComposerEmbedDialogTests();

            // Act
            var cut = ctx.Render(@<FormaComposerEmbedDialog Opened="true" />);

            // Assert
            Assert.False(cut.FindComponent<FormaDialog>().Instance.Options.CloseOnConfirm);
        }

        [Fact]
        public void Should_name_both_missing_details_when_confirmed_empty()
        {
            // Arrange
            using var ctx = new FormaComposerEmbedDialogTests();
            var inserted = false;

            // Act
            var cut = ctx.Render(@<FormaComposerEmbedDialog Opened="true" OnInsert="_ => inserted = true" />);
            Confirm(cut);

            // Assert
            Assert.False(inserted);
            Assert.Equal(
                ["Enter the embed type before inserting.", "Enter the identifier before inserting."],
                Alerts(cut));
        }

        [Fact]
        public void Should_name_only_the_detail_still_missing()
        {
            // Arrange
            using var ctx = new FormaComposerEmbedDialogTests();

            // Act
            var cut = ctx.Render(@<FormaComposerEmbedDialog Opened="true" />);
            Fill(cut, "Embed Type", "youtube");
            Confirm(cut);

            // Assert
            Assert.Equal(["Enter the identifier before inserting."], Alerts(cut));
        }

        [Fact]
        public void Should_insert_once_both_details_are_given()
        {
            // Arrange
            using var ctx = new FormaComposerEmbedDialogTests();
            EmbedDialogResult? result = null;

            // Act
            var cut = ctx.Render(@<FormaComposerEmbedDialog Opened="true" OnInsert="value => result = value" />);
            Fill(cut, "Embed Type", "  youtube  ");
            Fill(cut, "Identifier", "  dQw4w9WgXcQ  ");
            Confirm(cut);

            // Assert
            Assert.NotNull(result);
            Assert.Equal("youtube", result.EmbedType);
            Assert.Equal("dQw4w9WgXcQ", result.Identifier);
            Assert.Empty(Alerts(cut));
        }
    }
}
