@inherits FormaBunitContext
@using Forma.Tests.Composer
@using Forma.Blazor.Components.Composer.RichTextEditor.Plugins
@using Forma.Framework.Composer.Editing

@code {
    public sealed class Component
    {
        private static RenderFragment RenderHost(IComposerInteraction interaction, RenderFragment content)
            => @<CascadingValue Value="ComposerContexts.Create()"><CascadingValue Value="interaction">@content</CascadingValue></CascadingValue>;

        [Fact]
        public void Should_render_a_button_named_emoji()
        {
            // Arrange
            using var ctx = new FormaComposerEmojiButtonTests();

            // Act
            var cut = ctx.Render(RenderHost(new RecordingComposerInteraction(), @<FormaComposerEmojiButton />));

            // Assert
            var button = cut.Find("button");
            Assert.Equal("Emoji", button.GetAttribute("aria-label"));
        }

        [Fact]
        public void Should_open_the_picker_popover_when_clicked()
        {
            // Arrange
            using var ctx = new FormaComposerEmojiButtonTests();
            var cut = ctx.Render(RenderHost(new RecordingComposerInteraction(), @<FormaComposerEmojiButton />));

            // Act
            cut.Find("button").Click();

            // Assert
            Assert.NotNull(cut.Find(".forma-emoji-picker"));
            Assert.Equal("true", cut.Find("button").GetAttribute("aria-expanded"));
        }

        [Fact]
        public void Should_dispatch_the_insert_command_and_close_when_an_emoji_is_chosen()
        {
            // Arrange
            using var ctx = new FormaComposerEmojiButtonTests();
            var interaction = new RecordingComposerInteraction();
            var cut = ctx.Render(RenderHost(interaction, @<FormaComposerEmojiButton />));
            cut.Find("button").Click();

            // Act
            cut.Find(".forma-emoji-picker-emoji").Click();

            // Assert
            Assert.Equal($"{EmojiPlugin.InsertEmojiPrefix}😀", Assert.Single(interaction.ExecutedCommands));
            Assert.Empty(cut.FindAll(".forma-emoji-picker"));
        }

        [Fact]
        public async Task Should_close_and_collapse_the_button_when_dismissed_by_escape()
        {
            // Arrange
            using var ctx = new FormaComposerEmojiButtonTests();
            var cut = ctx.Render(RenderHost(new RecordingComposerInteraction(), @<FormaComposerEmojiButton />));
            cut.Find("button").Click();

            // Act
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.HandleDismissAsync(DismissBehavior.Dismiss, DismissReason.Escape));

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll(".forma-emoji-picker")),
                () => Assert.Equal("false", cut.Find("button").GetAttribute("aria-expanded")));
        }

        [Fact]
        public async Task Should_close_when_pressed_away()
        {
            // Arrange
            using var ctx = new FormaComposerEmojiButtonTests();
            var cut = ctx.Render(RenderHost(new RecordingComposerInteraction(), @<FormaComposerEmojiButton />));
            cut.Find("button").Click();

            // Act
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.HandleDismissAsync(DismissBehavior.Dismiss, DismissReason.PressAway));

            // Assert
            Assert.Empty(cut.FindAll(".forma-emoji-picker"));
        }

        [Fact]
        public void Should_forward_max_recent_to_the_picker()
        {
            // Arrange
            using var ctx = new FormaComposerEmojiButtonTests();
            var cut = ctx.Render(RenderHost(new RecordingComposerInteraction(), @<FormaComposerEmojiButton PickerOptions="@(new EmojiPickerOptions { MaxRecent = 5 })" />));

            // Act
            cut.Find("button").Click();

            // Assert
            Assert.NotNull(cut.FindComponent<FormaEmojiPicker>().Instance);
            Assert.Equal(5, cut.FindComponent<FormaEmojiPicker>().Instance.Options.MaxRecent);
        }
    }
}
