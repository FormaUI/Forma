@inherits BunitContext

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_make_the_controls_inert_when_count_is_zero()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="0" OnClear="() => {}" />);

            // Assert
            Assert.True(cut.Find(".forma-context-toolbar-trailing").HasAttribute("inert"));
        }

        [Fact]
        public void Should_not_make_the_controls_inert_when_count_is_positive()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="3" OnClear="() => {}" />);

            // Assert
            Assert.False(cut.Find(".forma-context-toolbar-trailing").HasAttribute("inert"));
        }

        [Fact]
        public void Should_keep_the_caption_outside_the_inert_controls()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="0" OnClear="() => {}" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-context-toolbar-trailing .forma-context-toolbar-caption"));
        }

        [Fact]
        public void Should_add_active_class_when_count_is_positive()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="1" />);

            // Assert
            Assert.Contains("is-active", cut.Find(".forma-context-toolbar").ClassList);
        }

        [Fact]
        public void Should_not_add_active_class_when_count_is_zero()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="0" />);

            // Assert
            Assert.DoesNotContain("is-active", cut.Find(".forma-context-toolbar").ClassList);
        }

        [Fact]
        public void Should_render_the_selected_count_in_the_caption()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="5" />);

            // Assert
            Assert.Equal("5 selected", cut.Find(".forma-context-toolbar-caption").TextContent);
        }

        [Fact]
        public void Should_prefer_a_supplied_caption_over_the_count()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="5" Caption="3 rows filtered" />);

            // Assert
            Assert.Equal("3 rows filtered", cut.Find(".forma-context-toolbar-caption").TextContent);
        }

        [Fact]
        public void Should_render_an_empty_supplied_caption_rather_than_falling_back()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="5" Caption="" />);

            // Assert
            Assert.Equal("", cut.Find(".forma-context-toolbar-caption").TextContent);
        }

        [Fact]
        public void Should_mark_the_caption_as_a_polite_status_region()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="2" />);

            // Assert
            var caption = cut.Find(".forma-context-toolbar-caption");
            Assert.Equal("status", caption.GetAttribute("role"));
            Assert.Equal("polite", caption.GetAttribute("aria-live"));
        }

        [Fact]
        public void Should_not_render_actions_without_child_content()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="1" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-context-toolbar-actions"));
        }

        [Fact]
        public void Should_render_child_content_as_actions()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(
                @<FormaContextToolbar Count="2">
                    <button type="button">Delete</button>
                </FormaContextToolbar>);

            // Assert
            Assert.Equal("Delete", cut.Find(".forma-context-toolbar-actions button").TextContent);
        }

        [Fact]
        public void Should_not_render_a_clear_button_without_a_callback()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="1" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-context-toolbar-clear"));
        }

        [Fact]
        public void Should_render_a_clear_button_with_a_callback()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaContextToolbar Count="1" OnClear="() => {}" />);

            // Assert
            cut.Find(".forma-context-toolbar-clear");
        }

        [Fact]
        public void Should_invoke_on_clear_when_the_clear_button_is_clicked()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();
            var cleared = false;
            var cut = ctx.Render(@<FormaContextToolbar Count="1" OnClear="() => cleared = true" />);

            // Act
            cut.Find(".forma-context-toolbar-clear").Click();

            // Assert
            Assert.True(cleared);
        }

        [Fact]
        public void Should_reject_a_negative_count()
        {
            // Arrange
            using var ctx = new FormaContextToolbarTests();

            // Act
            var act = () => ctx.Render(@<FormaContextToolbar Count="-1" />);

            // Assert
            Assert.Throws<ArgumentOutOfRangeException>(act);
        }
    }
}
