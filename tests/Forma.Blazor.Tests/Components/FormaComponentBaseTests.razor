@inherits FormaBunitContext
@using Forma.Framework.JavaScript.Interop
@using Forma.Tests.Localization
@using Microsoft.Extensions.Logging

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_log_under_its_own_type()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();
            using var loggerFactory = new FakeLoggerFactory();
            ctx.Services.AddSingleton<ILoggerFactory>(loggerFactory);

            // Act
            ctx.Render<Announcer>();

            // Assert
            var entry = Assert.Single(loggerFactory.Entries, e => e.Category.EndsWith(nameof(Announcer), StringComparison.Ordinal));
            Assert.Equal("rendered", entry.Message);
        }

        [Fact]
        public void Should_read_its_strings_from_its_own_type_unless_it_names_another()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();
            var localeFactory = new StubStringLocaleFactory(new Dictionary<string, string> { ["Hello"] = "Shalom" });
            ctx.Services.AddSingleton<IStringLocaleFactory>(localeFactory);

            // Act
            var own = ctx.Render<Announcer>().Instance.Greeting;
            var borrowed = ctx.Render<Borrower>().Instance.Greeting;

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("Shalom", own);
                Assert.Equal("Shalom", borrowed);
                Assert.Equal([typeof(Announcer), typeof(Announcer)], localeFactory.RequestedTypes);
            });
        }

        [Fact]
        public async Task Should_reach_the_browser_through_the_registered_runtime_under_its_own_identity()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();
            ctx.JSInterop.Setup<int>("measure").SetResult(7);
            var announcer = ctx.Render<Announcer>().Instance;

            // Act
            var measured = await announcer.OwnContext.JS.InvokeAsync<int>("measure");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(7, measured);
                Assert.Equal(announcer.OwnContext.RuntimeId, announcer.OwnContext.JS.RuntimeId);
            });
        }

        [Fact]
        public void Should_carry_an_identity_of_its_own_for_its_lifetime()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();

            // Act
            var first = ctx.Render<Announcer>().Instance;
            var second = ctx.Render<Announcer>().Instance;

            // Assert
            Assert.Multiple(() =>
            {
                Assert.NotEqual(Guid.Empty, first.OwnContext.RuntimeId);
                Assert.NotEqual(first.OwnContext.RuntimeId, second.OwnContext.RuntimeId);
                Assert.Equal(7, first.OwnContext.RuntimeId.Version);
            });
        }

        [Fact]
        public void Should_keep_its_identity_across_rerenders()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();
            var cut = ctx.Render<Announcer>();
            var before = cut.Instance.OwnContext.RuntimeId;

            // Act
            cut.Render();

            // Assert
            Assert.Equal(2, cut.RenderCount);
            Assert.Equal(before, cut.Instance.OwnContext.RuntimeId);
        }

        [Fact]
        public void Should_read_its_strings_from_the_context_that_carries_its_identity()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();

            // Act
            var announcer = ctx.Render<Announcer>().Instance;

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Same(announcer.OwnContext.Locale, announcer.Strings);
                Assert.Equal(announcer.OwnContext.RuntimeId, announcer.OwnContext.JS.RuntimeId);
                Assert.Same(announcer.OwnContext.Logger, announcer.OwnContext.JS.Logger);
            });
        }

        [Fact]
        public async Task Should_dispose_once_through_its_hook()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();
            var announcer = ctx.Render<Announcer>().Instance;

            // Act
            await announcer.DisposeAsync();
            await announcer.DisposeAsync();

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(1, announcer.DisposeCalls);
                Assert.True(announcer.IsDisposed);
            });
        }
    }

    public sealed class Teardown
    {
        [Fact]
        public async Task Should_release_its_context_after_its_own_cleanup()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();
            var announcer = ctx.Render<Announcer>().Instance;

            // Act
            await announcer.DisposeAsync();

            // Assert
            Assert.Multiple(
                () => Assert.False(announcer.ContextDisposedDuringCleanup),
                () => Assert.True(((ComponentContext)announcer.OwnContext).IsDisposed));
        }

        [Fact]
        public async Task Should_create_no_context_while_it_is_disposed()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();
            var silent = ctx.Render<Silent>().Instance;

            // Act
            await silent.DisposeAsync();

            // Assert: a context made during teardown would have been released with it.
            Assert.False(((ComponentContext)silent.OwnContext).IsDisposed);
        }

        [Fact]
        public async Task Should_release_its_context_even_when_its_own_cleanup_fails()
        {
            // Arrange
            using var ctx = new FormaComponentBaseTests();
            var failing = ctx.Render<Failing>().Instance;

            // Act
            await Assert.ThrowsAsync<InvalidOperationException>(() => failing.DisposeAsync().AsTask());

            // Assert
            Assert.Multiple(
                () => Assert.True(failing.IsDisposed),
                () => Assert.True(((ComponentContext)failing.OwnContext).IsDisposed));
        }
    }

    public sealed class Announcer : FormaComponentBase
    {
        public int DisposeCalls { get; private set; }

        public bool? ContextDisposedDuringCleanup { get; private set; }

        public IComponentContext OwnContext
            => Context;

        public IStringLocale Strings
            => L;

        public string Greeting
            => L["Hello"];

        protected override void OnInitialized()
            => Context.Logger.Log(LogLevel.Information, "rendered");

        protected override ValueTask DisposeAsyncCore()
        {
            DisposeCalls++;
            ContextDisposedDuringCleanup = ((ComponentContext)Context).IsDisposed;

            return ValueTask.CompletedTask;
        }
    }

    public sealed class Silent : FormaComponentBase
    {
        public IComponentContext OwnContext
            => Context;
    }

    public sealed class Failing : FormaComponentBase
    {
        public IComponentContext OwnContext
            => Context;

        protected override void OnInitialized()
            => _ = Context.RuntimeId;

        protected override ValueTask DisposeAsyncCore()
            => throw new InvalidOperationException("The cleanup failed.");
    }

    public sealed class Borrower : FormaComponentBase
    {
        public string Greeting
            => L["Hello"];

        protected override Type LocalizationSourceType
            => typeof(Announcer);
    }
}
