@inherits FormaBunitContext

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_a_flat_frame_by_default()
        {
            // Arrange
            using var ctx = new FormaFrameTests();

            // Act
            var cut = ctx.Render(@<FormaFrame><span>Inside</span></FormaFrame>);
            var frame = cut.Find(".forma-frame");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("forma-frame", frame.ClassName);
                Assert.Equal("Inside", frame.TextContent);
            });
        }

        [Theory]
        [InlineData(FrameVariant.Raised, "forma-frame-raised")]
        [InlineData(FrameVariant.Inset, "forma-frame-inset")]
        [InlineData(FrameVariant.Canvas, "forma-frame-canvas")]
        public void Should_mark_the_variant(FrameVariant variant, string expectedClass)
        {
            // Arrange
            using var ctx = new FormaFrameTests();

            // Act
            var cut = ctx.Render(@<FormaFrame Variant="variant" />);

            // Assert
            Assert.Contains(expectedClass, cut.Find(".forma-frame").ClassList);
        }

        [Fact]
        public void Should_stand_frames_on_a_canvas_frame()
        {
            // Arrange
            using var ctx = new FormaFrameTests();

            // Act
            var cut = ctx.Render(@<FormaFrame Variant="FrameVariant.Canvas"><FormaFrame Variant="FrameVariant.Raised">Card</FormaFrame></FormaFrame>);

            // Assert
            Assert.Equal("Card", cut.Find(".forma-frame-canvas > .forma-frame-raised").TextContent);
        }

        [Fact]
        public void Should_merge_the_host_class_and_pass_attributes_through()
        {
            // Arrange
            using var ctx = new FormaFrameTests();

            // Act
            var cut = ctx.Render(@<FormaFrame class="host-pane" data-region="side" />);
            var frame = cut.Find(".forma-frame");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("host-pane", frame.ClassList);
                Assert.Equal("side", frame.GetAttribute("data-region"));
            });
        }
    }
}
