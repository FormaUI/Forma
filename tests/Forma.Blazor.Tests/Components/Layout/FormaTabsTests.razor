@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_tab_list_and_panels()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Tab 1">Content 1</FormaTab>
                </FormaTabs>);

            // Assert
            cut.Find(".forma-tab-list");
            cut.Find(".forma-tab-panels");
        }

        [Fact]
        public void Should_mark_the_first_trailing_tab_so_it_and_those_after_sit_at_the_end()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Edit">Edit</FormaTab>
                    <FormaTab Title="Preview" Trailing="true">Preview</FormaTab>
                    <FormaTab Title="Source" Trailing="true">Source</FormaTab>
                </FormaTabs>);

            // Assert
            var trailing = cut.FindAll(".forma-tab-button-trailing");
            Assert.Single(trailing);
            Assert.Contains("Preview", trailing[0].TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_render_button_for_each_tab()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Tab 1">Content 1</FormaTab>
                    <FormaTab Title="Tab 2">Content 2</FormaTab>
                    <FormaTab Title="Tab 3">Content 3</FormaTab>
                </FormaTabs>);

            // Assert
            Assert.Equal(3, cut.FindAll(".forma-tab-button").Count);
        }

        [Fact]
        public void Should_render_tab_title_in_button()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="General">Content</FormaTab>
                </FormaTabs>);

            // Assert
            Assert.Contains("General", cut.Find(".forma-tab-button").TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_render_a_glyph_when_icon_is_set()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Settings" Icon="Glyph.Settings">Content</FormaTab>
                </FormaTabs>);
            var icon = cut.Find(".forma-tab-button svg");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("forma-icon", (IEnumerable<string>)icon.ClassList);
                Assert.Equal("true", icon.GetAttribute("aria-hidden"));
                Assert.False(string.IsNullOrWhiteSpace(cut.Find(".forma-tab-button svg path").GetAttribute("d")));
            });
        }

        [Fact]
        public void Should_not_render_a_glyph_when_icon_is_null()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Tab">Content</FormaTab>
                </FormaTabs>);

            // Assert
            Assert.Empty(cut.FindAll(".forma-tab-button svg"));
        }

        [Fact]
        public void Should_make_first_tab_active_by_default()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>);
            var buttons = cut.FindAll(".forma-tab-button");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("active", (IEnumerable<string>)buttons[0].ClassList);
                Assert.DoesNotContain("active", (IEnumerable<string>)buttons[1].ClassList);
            });
        }

        [Fact]
        public void Should_set_aria_selected_true_on_active_tab()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>);
            var buttons = cut.FindAll(".forma-tab-button");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("true", buttons[0].GetAttribute("aria-selected"));
                Assert.Equal("false", buttons[1].GetAttribute("aria-selected"));
            });
        }

        [Fact]
        public async Task Should_switch_active_tab_on_click()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>);

            // Act
            await cut.FindAll(".forma-tab-button")[1].ClickAsync(new());
            var buttons = cut.FindAll(".forma-tab-button");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.DoesNotContain("active", (IEnumerable<string>)buttons[0].ClassList);
                Assert.Contains("active", (IEnumerable<string>)buttons[1].ClassList);
            });
        }

        [Fact]
        public void Should_show_active_panel_and_hide_others()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>);
            var panels = cut.FindAll(".forma-tab-panel");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("active", (IEnumerable<string>)panels[0].ClassList);
                Assert.DoesNotContain("active", (IEnumerable<string>)panels[1].ClassList);
            });
        }

        [Fact]
        public void Should_set_tablist_role_on_list()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Tab">Content</FormaTab>
                </FormaTabs>);

            // Assert
            Assert.Equal("tablist", cut.Find(".forma-tab-list").GetAttribute("role"));
        }

        [Fact]
        public void Should_set_tab_role_on_buttons()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Tab">Content</FormaTab>
                </FormaTabs>);

            // Assert
            Assert.Equal("tab", cut.Find(".forma-tab-button").GetAttribute("role"));
        }

        [Fact]
        public void Should_set_tabpanel_role_on_panels()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Tab">Content</FormaTab>
                </FormaTabs>);

            // Assert
            Assert.Equal("tabpanel", cut.Find(".forma-tab-panel").GetAttribute("role"));
        }

        [Fact]
        public void Should_link_button_to_panel_via_aria_controls()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Tab">Content</FormaTab>
                </FormaTabs>);
            var button = cut.Find(".forma-tab-button");
            var panel = cut.Find(".forma-tab-panel");

            // Assert
            Assert.Equal(panel.Id, button.GetAttribute("aria-controls"));
        }

        [Fact]
        public void Should_link_panel_to_button_via_aria_labelledby()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Tab">Content</FormaTab>
                </FormaTabs>);
            var button = cut.Find(".forma-tab-button");
            var panel = cut.Find(".forma-tab-panel");

            // Assert
            Assert.Equal(button.Id, panel.GetAttribute("aria-labelledby"));
        }

        [Theory]
        [InlineData(null)]
        [InlineData("")]
        [InlineData("   ")]
        public void Should_reject_tab_with_invalid_title(string? title)
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act & Assert
            Assert.ThrowsAny<ArgumentException>(() => ctx.Render<FormaTabs>(p => p
                .AddChildContent<FormaTab>(t => t
                    .Add(x => x.Title, title!)
                    .AddChildContent("Content"))));
        }

        [Fact]
        public void Should_throw_when_tab_used_outside_tabs()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act & Assert
            Assert.Throws<InvalidOperationException>(() => ctx.Render<FormaTab>(p => p
                .Add(x => x.Title, "Orphan")
                .AddChildContent("Content")));
        }
    }

    public sealed class SelectionById
    {
        [Fact]
        public void Should_activate_the_tab_the_caller_named()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs ActiveTabId="second">
                    <FormaTab TabId="first" Title="First">Content 1</FormaTab>
                    <FormaTab TabId="second" Title="Second">Content 2</FormaTab>
                </FormaTabs>);

            // Assert
            var active = cut.FindAll(".forma-tab-button.active");
            Assert.Single(active);
            Assert.Contains("Second", active[0].TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public async Task Should_report_the_identifier_the_caller_gave_the_tab()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            string? reported = null;
            var cut = ctx.Render(
                @<FormaTabs ActiveTabId="first" ActiveTabIdChanged="id => reported = id">
                    <FormaTab TabId="first" Title="First">Content 1</FormaTab>
                    <FormaTab TabId="second" Title="Second">Content 2</FormaTab>
                </FormaTabs>);

            // Act
            await cut.FindAll(".forma-tab-button")[1].ClickAsync(new());

            // Assert
            Assert.Equal("second", reported);
        }

        [Fact]
        public void Should_reject_a_tab_with_no_identifier_when_the_caller_selects_by_one()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act & Assert
            Assert.Throws<InvalidOperationException>(() => ctx.Render(
                @<FormaTabs ActiveTabId="first">
                    <FormaTab TabId="first" Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>));
        }

        [Fact]
        public void Should_reject_a_tab_with_no_identifier_when_the_caller_only_observes()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act & Assert
            Assert.Throws<InvalidOperationException>(() => ctx.Render(
                @<FormaTabs ActiveTabIdChanged="_ => { }">
                    <FormaTab Title="First">Content 1</FormaTab>
                </FormaTabs>));
        }

        [Fact]
        public void Should_reject_a_registered_tab_with_no_identifier_once_the_caller_starts_selecting()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                </FormaTabs>);

            // Act & Assert
            Assert.Throws<InvalidOperationException>(
                () => cut.FindComponent<FormaTabs>().Render(parameters => parameters.Add(p => p.ActiveTabId, "first")));
        }
    }
}
