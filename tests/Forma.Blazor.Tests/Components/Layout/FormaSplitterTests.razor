@inherits FormaBunitContext
@using Microsoft.AspNetCore.Components.Web
@using Forma.Framework.Input
@using Forma.Framework.Input.Keyboard

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_a_separator()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();

            // Act
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" />);

            // Assert
            Assert.NotNull(cut.Find(".forma-splitter[role=separator]"));
        }

        [Fact]
        public void Should_report_the_bounds_and_current_size()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();

            // Act
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" />);
            var separator = cut.Find(".forma-splitter");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("18", separator.GetAttribute("aria-valuenow"));
                Assert.Equal("10", separator.GetAttribute("aria-valuemin"));
                Assert.Equal("28", separator.GetAttribute("aria-valuemax"));
                Assert.Equal("Resize", separator.GetAttribute("aria-label"));
                Assert.Equal("0", separator.GetAttribute("tabindex"));
            });
        }

        [Fact]
        public void Should_declare_a_vertical_orientation_by_default()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();

            // Act
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("vertical", cut.Find(".forma-splitter").GetAttribute("aria-orientation"));
                Assert.Contains("forma-splitter-vertical", cut.Find(".forma-splitter").ClassList);
            });
        }

        [Fact]
        public void Should_declare_a_horizontal_orientation_when_asked()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();

            // Act
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" Orientation="SplitterOrientation.Horizontal" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("horizontal", cut.Find(".forma-splitter").GetAttribute("aria-orientation"));
                Assert.Contains("forma-splitter-horizontal", cut.Find(".forma-splitter").ClassList);
            });
        }

        [Fact]
        public void Should_route_the_inline_arrows_home_and_end_on_a_vertical_splitter()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);

            // Act
            ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" />);

            // Assert
            var registration = Assert.Single(router.Registrations);
            Assert.Equal(["splitter.grow:ArrowRight", "splitter.shrink:ArrowLeft", "splitter.min:Home", "splitter.max:End"], InputRouterProbe.GetRoutes(registration));
        }

        [Fact]
        public void Should_swap_the_inline_arrows_under_right_to_left()
        {
            // Arrange
            using var fixture = new CultureFixture("he");
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);

            // Act
            ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" />);

            // Assert
            var registration = Assert.Single(router.Registrations);
            Assert.Equal(["splitter.grow:ArrowLeft", "splitter.shrink:ArrowRight", "splitter.min:Home", "splitter.max:End"], InputRouterProbe.GetRoutes(registration));
        }

        [Fact]
        public void Should_route_the_block_arrows_on_a_horizontal_splitter_whatever_the_direction()
        {
            // Arrange
            using var fixture = new CultureFixture("he");
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);

            // Act
            ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" Orientation="SplitterOrientation.Horizontal" />);

            // Assert
            var registration = Assert.Single(router.Registrations);
            Assert.Equal(["splitter.grow:ArrowDown", "splitter.shrink:ArrowUp", "splitter.min:Home", "splitter.max:End"], InputRouterProbe.GetRoutes(registration));
        }

        [Fact]
        public void Should_take_the_keys_of_a_new_orientation()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);
            var registration = router.Module.SetupModule("register", _ => true);
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" />);

            // Act
            cut.FindComponent<FormaSplitter>().Render(parameters => parameters.Add(p => p.Orientation, SplitterOrientation.Horizontal));

            // Assert
            var update = Assert.Single(registration.Invocations, invocation => invocation.Identifier == "update");
            Assert.Equal("ArrowDown", Assert.IsType<KeyBinding>(Assert.IsType<InputProfile>(update.Arguments[0]).InputRoutes[0].Bindings[0]).Key);
        }

        [Fact]
        public async Task Should_grow_by_the_step_when_the_router_routes_grow()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);
            double? reported = null;
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" Step="4" ValueChanged="v => reported = v" />);

            // Act
            await router.RouteAsync("splitter.grow", "ArrowRight");

            // Assert
            Assert.Equal(22d, reported);
        }

        [Fact]
        public async Task Should_shrink_by_the_step_when_the_router_routes_shrink()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);
            double? reported = null;
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" ValueChanged="v => reported = v" />);

            // Act
            await router.RouteAsync("splitter.shrink", "ArrowLeft");

            // Assert
            Assert.Equal(17d, reported);
        }

        [Fact]
        public async Task Should_jump_to_either_bound_when_the_router_routes_min_or_max()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);
            double? reported = null;
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" ValueChanged="v => reported = v" />);

            // Act
            await router.RouteAsync("splitter.min", "Home");
            var atMin = reported;
            await router.RouteAsync("splitter.max", "End");

            // Assert
            Assert.Multiple(
                () => Assert.Equal(10d, atMin),
                () => Assert.Equal(28d, reported));
        }

        [Fact]
        public async Task Should_clamp_at_the_maximum()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);
            double? reported = null;
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="28" Min="10" Max="28" ValueChanged="v => reported = v" />);

            // Act
            await router.RouteAsync("splitter.grow", "ArrowRight");

            // Assert
            Assert.Null(reported);
        }

        [Fact]
        public async Task Should_clamp_at_the_minimum()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);
            double? reported = null;
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="10" Min="10" Max="28" ValueChanged="v => reported = v" />);

            // Act
            await router.RouteAsync("splitter.shrink", "ArrowLeft");

            // Assert
            Assert.Null(reported);
        }

        [Fact]
        public async Task Should_show_the_new_size_after_a_routed_move()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" />);

            // Act
            await router.RouteAsync("splitter.grow", "ArrowRight");

            // Assert
            Assert.Equal("19", cut.Find(".forma-splitter").GetAttribute("aria-valuenow"));
        }

        [Fact]
        public void Should_report_resizing_across_a_drag()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var reported = new List<bool>();
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" OnResizingChanged="r => reported.Add(r)" />);

            // Act
            cut.Find(".forma-splitter").PointerDown();
            cut.Find(".forma-splitter").PointerUp();

            // Assert
            Assert.Equal([true, false], reported);
        }

        [Fact]
        public void Should_mark_itself_while_a_drag_runs()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" />);

            // Act
            cut.Find(".forma-splitter").PointerDown();

            // Assert
            Assert.Contains("is-resizing", cut.Find(".forma-splitter").ClassList);
        }

        [Fact]
        public void Should_stop_marking_itself_once_the_drag_ends()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" />);
            cut.Find(".forma-splitter").PointerDown();

            // Act
            cut.Find(".forma-splitter").PointerUp();

            // Assert
            Assert.DoesNotContain("is-resizing", cut.Find(".forma-splitter").ClassList);
        }

        [Fact]
        public void Should_ignore_a_pointer_move_that_no_drag_started()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            double? reported = null;

            // Act
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" ValueChanged="v => reported = v" />);
            cut.Find(".forma-splitter").PointerMove(new PointerEventArgs { ClientX = 400 });

            // Assert
            Assert.Null(reported);
        }

        [Fact]
        public void Should_resize_as_the_pointer_travels()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            double? reported = null;
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" ValueChanged="v => reported = v" />);

            // Act
            cut.Find(".forma-splitter").PointerDown(new PointerEventArgs { ClientX = 100 });
            cut.Find(".forma-splitter").PointerMove(new PointerEventArgs { ClientX = 132 });

            // Assert
            Assert.Equal(20d, reported);
        }

        [Fact]
        public void Should_measure_the_block_axis_for_a_horizontal_splitter()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            double? reported = null;
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" Orientation="SplitterOrientation.Horizontal" ValueChanged="v => reported = v" />);

            // Act
            cut.Find(".forma-splitter").PointerDown(new PointerEventArgs { ClientY = 100 });
            cut.Find(".forma-splitter").PointerMove(new PointerEventArgs { ClientY = 132 });

            // Assert
            Assert.Equal(20d, reported);
        }

        [Fact]
        public void Should_honour_a_caller_supplied_pixel_scale()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();
            double? reported = null;
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="180" Min="100" Max="280" PixelsPerUnit="1" ValueChanged="v => reported = v" />);

            // Act
            cut.Find(".forma-splitter").PointerDown(new PointerEventArgs { ClientX = 100 });
            cut.Find(".forma-splitter").PointerMove(new PointerEventArgs { ClientX = 132 });

            // Assert
            Assert.Equal(212d, reported);
        }

        [Fact]
        public void Should_merge_custom_class_with_forma_splitter()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();

            // Act
            var cut = ctx.Render(@<FormaSplitter Label="Resize" Value="18" Min="10" Max="28" Class="forma-explorer-splitter" />);

            // Assert
            var classes = cut.Find("div").ClassList;
            Assert.Multiple(() =>
            {
                Assert.Contains("forma-splitter", classes);
                Assert.Contains("forma-explorer-splitter", classes);
            });
        }

        [Theory]
        [InlineData(null)]
        [InlineData("")]
        [InlineData("   ")]
        public void Should_reject_a_missing_label(string? label)
        {
            // Arrange
            using var ctx = new FormaSplitterTests();

            // Act & Assert
            Assert.ThrowsAny<ArgumentException>(() => ctx.Render<FormaSplitter>(p => p
                .Add(s => s.Label, label!)));
        }

        [Fact]
        public void Should_reject_a_step_that_cannot_move()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();

            // Act & Assert
            Assert.Throws<ArgumentOutOfRangeException>(() => ctx.Render<FormaSplitter>(p => p
                .Add(s => s.Label, "Resize")
                .Add(s => s.Step, 0d)));
        }

        [Fact]
        public void Should_reject_bounds_that_cross()
        {
            // Arrange
            using var ctx = new FormaSplitterTests();

            // Act & Assert
            Assert.Throws<ArgumentOutOfRangeException>(() => ctx.Render<FormaSplitter>(p => p
                .Add(s => s.Label, "Resize")
                .Add(s => s.Min, 30d)
                .Add(s => s.Max, 10d)));
        }
    }
}
