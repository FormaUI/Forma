@inherits FormaBunitContext
@using Forma.Framework.Browser.Interop.Scrolling
@using Forma.Framework.Input.Keyboard
@code {
    private static readonly FreezePaneOptions BlockArrows = new() { Axis = ScrollAxis.Block, Navigation = ScrollNavigation.Arrows };

    private static Task Report(DomProbe<ScrollState> probe, bool canScrollBack, bool canScrollForward, double frozenExtent = 0, double cornerExtent = 0, double? viewportExtent = null)
        => probe.ReportAsync(new ScrollState(canScrollBack, canScrollForward, frozenExtent, cornerExtent, viewportExtent));

    private static Task Report<TComponent>(DomProbe<ScrollState> probe, IRenderedComponent<TComponent> cut, bool canScrollBack, bool canScrollForward, double frozenExtent = 0, double cornerExtent = 0, double? viewportExtent = null)
        where TComponent : class, IComponent
        => probe.ReportAsync(cut.Find(".forma-freeze-pane").GetAttribute("data-rid")!, new ScrollState(canScrollBack, canScrollForward, frozenExtent, cornerExtent, viewportExtent));

    public sealed class Component
    {
        [Fact]
        public void Should_render_the_content_in_an_inline_scrollbar_viewport_by_default()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();

            // Act
            var cut = ctx.Render(@<FormaFreezePane><button>One</button></FormaFreezePane>);

            // Assert
            var root = cut.Find(".forma-freeze-pane");
            Assert.Multiple(
                () => Assert.Contains("forma-freeze-pane-inline", root.ClassList),
                () => Assert.Contains("forma-freeze-pane-scrollbar", root.ClassList),
                () => Assert.Equal("One", cut.Find(".forma-freeze-pane-viewport button").TextContent),
                () => Assert.Empty(cut.FindAll(".forma-freeze-pane-arrow")));
        }

        [Fact]
        public async Task Should_render_no_arrows_in_the_scrollbar_form_however_far_the_content_goes()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane><button>One</button></FormaFreezePane>);

            // Act
            await Report(probe, canScrollBack: true, canScrollForward: true);

            // Assert
            Assert.Empty(cut.FindAll(".forma-freeze-pane-arrow"));
        }

        [Fact]
        public void Should_mark_the_arrow_form_and_hide_its_arrows_while_the_content_fits()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();

            // Act
            var cut = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);

            // Assert
            Assert.Multiple(
                () => Assert.Contains("forma-freeze-pane-arrows", cut.Find(".forma-freeze-pane").ClassList),
                () => Assert.Empty(cut.FindAll(".forma-freeze-pane-arrow")));
        }

        [Fact]
        public async Task Should_show_only_the_forward_arrow_at_the_start()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);

            // Act
            await Report(probe, canScrollBack: false, canScrollForward: true);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll(".forma-freeze-pane-arrow-back")),
                () => Assert.NotNull(cut.Find(".forma-freeze-pane-arrow-forward")));
        }

        [Fact]
        public async Task Should_show_both_arrows_from_the_middle()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);

            // Act
            await Report(probe, canScrollBack: true, canScrollForward: true);

            // Assert
            Assert.Equal(2, cut.FindAll(".forma-freeze-pane-arrow").Count);
        }

        [Fact]
        public async Task Should_show_only_the_back_arrow_at_the_end()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);

            // Act
            await Report(probe, canScrollBack: true, canScrollForward: false);

            // Assert
            Assert.Multiple(
                () => Assert.NotNull(cut.Find(".forma-freeze-pane-arrow-back")),
                () => Assert.Empty(cut.FindAll(".forma-freeze-pane-arrow-forward")));
        }

        [Fact]
        public async Task Should_drop_both_arrows_once_the_content_fits_again()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);
            await Report(probe, canScrollBack: true, canScrollForward: true);

            // Act
            await Report(probe, canScrollBack: false, canScrollForward: false);

            // Assert
            Assert.Empty(cut.FindAll(".forma-freeze-pane-arrow"));
        }

        [Fact]
        public async Task Should_leave_its_arrows_presses_in_the_browser()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);

            // Act
            await Report(probe, canScrollBack: true, canScrollForward: true);

            // Assert
            Assert.All(cut.FindAll(".forma-freeze-pane-arrow"), arrow => Assert.False(arrow.HasAttribute("blazor:onclick")));
        }

        [Fact]
        public async Task Should_name_the_inline_arrows_from_the_localizer()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);

            // Act
            await Report(probe, canScrollBack: true, canScrollForward: true);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Scroll Back", cut.Find(".forma-freeze-pane-arrow-back").GetAttribute("aria-label")),
                () => Assert.Equal("Scroll Forward", cut.Find(".forma-freeze-pane-arrow-forward").GetAttribute("aria-label")));
        }

        [Fact]
        public async Task Should_name_the_block_arrows_up_and_down()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane Options="BlockArrows"><button>One</button></FormaFreezePane>);

            // Act
            await Report(probe, canScrollBack: true, canScrollForward: true);

            // Assert
            Assert.Multiple(
                () => Assert.Contains("forma-freeze-pane-block", cut.Find(".forma-freeze-pane").ClassList),
                () => Assert.Equal("Scroll Up", cut.Find(".forma-freeze-pane-arrow-back").GetAttribute("aria-label")),
                () => Assert.Equal("Scroll Down", cut.Find(".forma-freeze-pane-arrow-forward").GetAttribute("aria-label")));
        }

        [Fact]
        public async Task Should_let_the_caller_name_the_arrows()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var options = new FreezePaneOptions { Navigation = ScrollNavigation.Arrows, ScrollBackLabel = "Earlier", ScrollForwardLabel = "Later" };
            var cut = ctx.Render(@<FormaFreezePane Options="options"><button>One</button></FormaFreezePane>);

            // Act
            await Report(probe, canScrollBack: true, canScrollForward: true);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Earlier", cut.Find(".forma-freeze-pane-arrow-back").GetAttribute("aria-label")),
                () => Assert.Equal("Later", cut.Find(".forma-freeze-pane-arrow-forward").GetAttribute("aria-label")));
        }

        [Fact]
        public async Task Should_carry_the_frozen_extents_for_the_back_arrow_to_stand_in()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);

            // Act
            await Report(probe, canScrollBack: true, canScrollForward: true, frozenExtent: 120.5, cornerExtent: 32);

            // Assert
            var root = cut.Find(".forma-freeze-pane");
            Assert.Multiple(
                () => Assert.Contains("has-frozen", root.ClassList),
                () => Assert.Equal("--forma-freeze-pane-frozen-extent: 120.5px; --forma-freeze-pane-corner-extent: 32px;", root.GetAttribute("style")));
        }

        [Fact]
        public async Task Should_mark_itself_measured_once_the_first_state_arrives()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane><button>One</button></FormaFreezePane>);
            Assert.DoesNotContain("is-measured", cut.Find(".forma-freeze-pane").ClassList);

            // Act
            await Report(probe, canScrollBack: false, canScrollForward: false);

            // Assert
            Assert.Contains("is-measured", cut.Find(".forma-freeze-pane").ClassList);
        }

        [Fact]
        public async Task Should_draw_the_frozen_edge_only_for_content_that_answers_it()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var router = new InputRouterProbe(ctx);
            var asked = new List<double>();
            var silent = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);
            var answering = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows" FrozenExtentChanged="@(extent => asked.Add(extent))"><button>One</button></FormaFreezePane>);

            // Act - the answering pane asks for its viewport's extent once its edge is to be drawn
            await Report(probe, silent, canScrollBack: false, canScrollForward: true, frozenExtent: 120, cornerExtent: 32);
            await Report(probe, answering, canScrollBack: false, canScrollForward: true, frozenExtent: 120, cornerExtent: 32);
            await Report(probe, answering, canScrollBack: false, canScrollForward: true, frozenExtent: 120, cornerExtent: 32, viewportExtent: 500);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(silent.FindAll(".forma-freeze-pane-edge")),
                () => Assert.Equal("120", answering.Find(".forma-freeze-pane-edge").GetAttribute("aria-valuenow")),
                () => Assert.Equal("500", answering.Find(".forma-freeze-pane-edge").GetAttribute("aria-valuemax")));

            // Act - the router's grow on the edge asks the content for a wider frozen region
            await router.RouteAsync("splitter.grow", "ArrowRight");

            // Assert
            Assert.Equal([128], asked);
        }

        [Fact]
        public async Task Should_ask_for_the_viewport_extent_only_while_the_frozen_edge_is_drawn()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var cut = ctx.Render(@<FormaFreezePane FrozenExtentChanged="@((double _) => { })"><button>One</button></FormaFreezePane>);
            var first = Assert.Single(probe.Observations);

            // Act
            await Report(probe, canScrollBack: false, canScrollForward: true, frozenExtent: 120, cornerExtent: 32);

            // Assert
            Assert.Multiple(
                () => Assert.Equal(false, DomProbe<ScrollState>.GetOption(first, "viewportExtent")),
                () => Assert.Equal(true, DomProbe<ScrollState>.GetOption(probe.Observations[^1], "viewportExtent")),
                () => Assert.Equal(2, probe.Observations.Count));
        }

        [Fact]
        public void Should_observe_its_axis_and_frozen_parts()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);

            // Act
            ctx.Render(@<FormaFreezePane Options="BlockArrows"><button>One</button></FormaFreezePane>);

            // Assert
            var observation = Assert.Single(probe.Observations);
            Assert.Multiple(
                () => Assert.Equal("scroll", DomProbe<ScrollState>.GetRequestField(observation, "capability")),
                () => Assert.Equal("block", DomProbe<ScrollState>.GetOption(observation, "axis")),
                () => Assert.Equal(".forma-freeze-pane-frozen", DomProbe<ScrollState>.GetOption(observation, "frozen")));
        }

        [Fact]
        public void Should_answer_the_wheel_as_its_own_scroll_action()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);

            // Act
            ctx.Render(@<FormaFreezePane><button>One</button></FormaFreezePane>);

            // Assert
            Assert.Equal("freeze-pane.scroll", DomProbe<ScrollState>.GetOption(Assert.Single(probe.Interactions), "wheel"));
        }

        [Fact]
        public void Should_leave_the_wheel_to_the_browser_along_the_block_axis()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);

            // Act
            ctx.Render(@<FormaFreezePane Options="BlockArrows"><button>One</button></FormaFreezePane>);

            // Assert
            Assert.Null(DomProbe<ScrollState>.GetOption(Assert.Single(probe.Interactions), "wheel"));
        }

        [Fact]
        public void Should_step_to_its_stops_by_its_arrows_in_the_browser()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);

            // Act
            var cut = ctx.Render(@<FormaFreezePane Options="FreezePaneOptions.Arrows"><button>One</button></FormaFreezePane>);

            // Assert
            var interaction = Assert.Single(probe.Interactions);
            var buttons = DomProbe<ScrollState>.GetOption(interaction, "buttons")!;
            object? GetButtonOption(string name) => buttons.GetType().GetProperty(name)!.GetValue(buttons);
            Assert.Multiple(
                () => Assert.Equal(".forma-freeze-pane-stop", DomProbe<ScrollState>.GetOption(interaction, "stops")),
                () => Assert.Equal(".forma-freeze-pane-frozen", DomProbe<ScrollState>.GetOption(interaction, "frozen")),
                () => Assert.Equal(cut.FindComponent<FormaFreezePane>().Instance.RootElement.Id, ((ElementReference)GetButtonOption("container")!).Id),
                () => Assert.Equal(".forma-freeze-pane-arrow-back", GetButtonOption("back")),
                () => Assert.Equal(".forma-freeze-pane-arrow-forward", GetButtonOption("forward")),
                () => Assert.Equal("freeze-pane.scroll-back", GetButtonOption("backAction")),
                () => Assert.Equal("freeze-pane.scroll-forward", GetButtonOption("forwardAction")));
        }

        [Fact]
        public void Should_attach_no_interaction_while_neither_arrows_nor_the_wheel_move_it()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();
            var probe = new DomProbe<ScrollState>(ctx);

            // Act
            ctx.Render(@<FormaFreezePane Options="@(new FreezePaneOptions { PageOnWheelGesture = false })"><button>One</button></FormaFreezePane>);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(probe.Interactions),
                () => Assert.Single(probe.Observations));
        }

        [Fact]
        public void Should_mark_a_pane_that_scrolls_its_other_axis_too()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();

            // Act
            var cut = ctx.Render(@<FormaFreezePane Options="@(new FreezePaneOptions { ScrollsCrossAxis = true })"><button>One</button></FormaFreezePane>);

            // Assert
            Assert.Contains("forma-freeze-pane-cross-axis", cut.Find(".forma-freeze-pane").ClassList);
        }

        [Fact]
        public void Should_merge_the_host_class_and_pass_other_attributes_through()
        {
            // Arrange
            using var ctx = new FormaFreezePaneTests();

            // Act
            var cut = ctx.Render(@<FormaFreezePane Class="demo-track" aria-label="Filters" />);

            // Assert
            var root = cut.Find(".forma-freeze-pane");
            Assert.Multiple(
                () => Assert.Contains("demo-track", root.ClassList),
                () => Assert.Equal("Filters", root.GetAttribute("aria-label")));
        }
    }
}
