@inherits FormaBunitContext
@using Forma.Framework.Icons
@using Forma.Framework.Input
@using Forma.Framework.Toolbar
@using Forma.Framework.Windows

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_the_title_the_icon_and_the_body()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var cut = ctx.Render(@<FormaWindow Title="Folders" Icon="Glyph.Pin"><Body>Tree</Body></FormaWindow>);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("Folders", cut.Find(".forma-window-title").TextContent);
                Assert.NotNull(cut.Find(".forma-window-icon .forma-icon"));
                Assert.Equal("Tree", cut.Find(".forma-window-body").TextContent);
            });
        }

        [Fact]
        public void Should_render_the_header_and_footer_bands_only_when_given()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var bare = ctx.Render(@<FormaWindow Title="Folders"><Body>Tree</Body></FormaWindow>);
            var banded = ctx.Render(@<FormaWindow Title="Folders"><Header>Where the media lives</Header><Body>Tree</Body><Footer>Two folders</Footer></FormaWindow>);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Empty(bare.FindAll(".forma-window-header"));
                Assert.Empty(bare.FindAll(".forma-window-footer"));
                Assert.Equal("Where the media lives", banded.Find(".forma-window-header").TextContent);
                Assert.Equal("Two folders", banded.Find(".forma-window-footer").TextContent);
            });
        }

        [Fact]
        public void Should_be_a_region_when_docked_and_a_non_modal_dialog_when_floating()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var docked = ctx.Render(@<FormaWindow Title="Folders" />);
            var floating = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("region", docked.Find(".forma-window").GetAttribute("role"));
                Assert.Null(docked.Find(".forma-window").GetAttribute("aria-modal"));
                Assert.Null(docked.Find(".forma-window").GetAttribute("popover"));
                Assert.Contains("forma-window-docked", docked.Find(".forma-window").ClassList);
                Assert.Equal("dialog", floating.Find(".forma-window").GetAttribute("role"));
                Assert.Equal("false", floating.Find(".forma-window").GetAttribute("aria-modal"));
                Assert.Equal("manual", floating.Find(".forma-window").GetAttribute("popover"));
                Assert.Contains("forma-window-floating", floating.Find(".forma-window").ClassList);
            });
        }

        [Fact]
        public void Should_name_the_window_by_its_title()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var cut = ctx.Render(@<FormaWindow Title="Folders" />);
            var window = cut.Find(".forma-window");

            // Assert
            Assert.Equal("Folders", cut.Find($"#{window.GetAttribute("aria-labelledby")}").TextContent);
        }

        [Fact]
        public void Should_make_the_title_bar_focusable_only_while_floating()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var docked = ctx.Render(@<FormaWindow Title="Folders" />);
            var floating = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" />);
            var maximized = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" Maximized="true" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Null(docked.Find(".forma-window-titlebar").GetAttribute("tabindex"));
                Assert.Equal("0", floating.Find(".forma-window-titlebar").GetAttribute("tabindex"));
                Assert.Contains("Folders", floating.Find(".forma-window-titlebar").GetAttribute("aria-label"));
                Assert.Null(maximized.Find(".forma-window-titlebar").GetAttribute("tabindex"));
                Assert.Null(maximized.Find(".forma-window-titlebar").GetAttribute("aria-keyshortcuts"));
            });
        }

        [Fact]
        public void Should_promise_the_resize_keys_only_while_resizable()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var resizable = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" />);
            var fixedSize = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" Options="new() { Resizable = false }" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("Shift", resizable.Find(".forma-window-titlebar").GetAttribute("aria-label"));
                Assert.Contains("Shift+ArrowUp", resizable.Find(".forma-window-titlebar").GetAttribute("aria-keyshortcuts"));
                Assert.DoesNotContain("Shift", fixedSize.Find(".forma-window-titlebar").GetAttribute("aria-label"));
                Assert.Equal("ArrowUp ArrowDown ArrowLeft ArrowRight", fixedSize.Find(".forma-window-titlebar").GetAttribute("aria-keyshortcuts"));
            });
        }

        [Fact]
        public void Should_render_resize_handles_only_while_floating_resizable_and_not_maximized()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var docked = ctx.Render(@<FormaWindow Title="Folders" />);
            var floating = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" />);
            var fixedSize = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" Options="new() { Resizable = false }" />);
            var maximized = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" Maximized="true" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Empty(docked.FindAll($".{FormaWindow.HandleClass}"));
                Assert.Equal(8, floating.FindAll($".{FormaWindow.HandleClass}").Count);
                Assert.Empty(fixedSize.FindAll($".{FormaWindow.HandleClass}"));
                Assert.Empty(maximized.FindAll($".{FormaWindow.HandleClass}"));
                Assert.Contains("is-maximized", maximized.Find(".forma-window").ClassList);
            });
        }

