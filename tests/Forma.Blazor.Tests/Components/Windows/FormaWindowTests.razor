        [Fact]
        public async Task Should_close_when_the_router_dismisses_it_and_it_is_closable()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var closed = 0;
            var closable = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" OnClose="() => closed++" />);
            var pinned = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" Options="new() { Closable = false }" OnClose="() => closed++" />);

            // Act
            await closable.FindComponent<FormaWindow>().Instance.HandleDismissAsync(DismissBehavior.Dismiss, DismissReason.Escape);
            await pinned.FindComponent<FormaWindow>().Instance.HandleDismissAsync(DismissBehavior.Dismiss, DismissReason.Escape);

            // Assert
            Assert.Equal(1, closed);
        }

        [Fact]
        public async Task Should_take_a_reported_placement_and_raise_it_once_per_change()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var reported = new List<WindowPlacement>();
            var cut = ctx.Render(@<FormaWindow Title="Folders" Mode="WindowMode.Floating" PlacementChanged="placement => reported.Add(placement)" />);

            // Act
            var window = cut.FindComponent<FormaWindow>().Instance;
            await window.ReportPlacementAsync(10, 20, 300, 200);
            await window.ReportPlacementAsync(10, 20, 300, 200);
            await window.ReportPlacementAsync(15, 20, 300, 200);

            // Assert
            Assert.Equal([new(10, 20, 300, 200), new(15, 20, 300, 200)], reported);
        }

