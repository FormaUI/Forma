@inherits FormaBunitContext
@using Microsoft.Extensions.DependencyInjection
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_toolbar_container()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" Search="Search" />);

            // Assert
            cut.Find(".forma-search-toolbar");
        }

        [Fact]
        public void Should_always_render_the_search_field()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" Search="Search" />);

            // Assert
            cut.Find(".forma-search-toolbar-search input");
        }

        [Fact]
        public void Should_name_the_search_field_with_its_placeholder()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" Search="Search" />);

            // Assert
            var input = cut.Find("input");
            Assert.Multiple(
                () => Assert.Equal("Search...", input.GetAttribute("placeholder")),
                () => Assert.Equal("Search...", input.GetAttribute("aria-label")));
        }

        [Fact]
        public void Should_not_render_actions_without_items()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" Search="Search" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-search-toolbar-items"));
        }

        [Fact]
        public async Task Should_invoke_callback_with_input_value()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            var received = new List<string>();
            var cut = ctx.Render(
                @<FormaSearchToolbar OnSearch="@((string v) => { received.Add(v); return Task.CompletedTask; })" Search="@(Search with { DebounceDelay = TimeSpan.Zero })" />);

            // Act
            await cut.Find("input").TriggerEventAsync("oninput", new ChangeEventArgs { Value = "hello" });

            // Assert
            Assert.Equal(["hello"], received);
        }

        [Fact]
        public async Task Should_debounce_each_keystroke_by_the_debounce_delay()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            var debouncer = new RecordingDebounceable();
            ctx.Services.AddSingleton<IDebounceable>(debouncer);
            var received = new List<string>();
            var cut = ctx.Render(
                @<FormaSearchToolbar OnSearch="@((string v) => { received.Add(v); return Task.CompletedTask; })" Search="@(Search with { DebounceDelay = TimeSpan.FromMilliseconds(40) })" />);
            var input = cut.Find("input");

            // Act
            await input.TriggerEventAsync("oninput", new ChangeEventArgs { Value = "h" });
            await input.TriggerEventAsync("oninput", new ChangeEventArgs { Value = "he" });
            await input.TriggerEventAsync("oninput", new ChangeEventArgs { Value = "hello" });

            // Assert
            Assert.Multiple(
                () => Assert.Equal([TimeSpan.FromMilliseconds(40), TimeSpan.FromMilliseconds(40), TimeSpan.FromMilliseconds(40)], debouncer.Delays),
                () => Assert.Equal(["h", "he", "hello"], received));
        }

        [Fact]
        public void Should_render_actions_beside_the_search_field()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            IReadOnlyList<ToolbarItem> actions = [new ToolbarCommand { Id = "add", Title = "Add", Command = "add" }];

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" Search="Search" Label="Actions" Items="actions" />);

            // Assert
            cut.Find(".forma-search-toolbar-search input");
            Assert.Equal("Add", cut.Find(".forma-search-toolbar-items button").TextContent);
        }

        [Fact]
        public void Should_invoke_on_command_when_an_action_is_clicked()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            IReadOnlyList<ToolbarItem> actions = [new ToolbarCommand { Id = "add", Title = "Add", Command = "add.new" }];
            string? invoked = null;

            // Act
            var cut = ctx.Render(@<FormaSearchToolbar OnSearch="Noop" Search="Search" Label="Actions" Items="actions" OnCommand="c => invoked = c" />);
            cut.Find(".forma-search-toolbar-items button").Click();

            // Assert
            Assert.Equal("add.new", invoked);
        }

        [Fact]
        public void Should_require_a_label_when_actions_are_given()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();
            IReadOnlyList<ToolbarItem> actions = [new ToolbarCommand { Id = "add", Title = "Add", Command = "add" }];

            // Act
            var render = () => ctx.Render(@<FormaSearchToolbar OnSearch="Noop" Search="Search" Items="actions" />);

            // Assert
            Assert.Throws<ArgumentNullException>(render);
        }

        [Fact]
        public void Should_require_a_search_handler()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var render = () => ctx.Render<FormaSearchToolbar>(parameters => parameters
                .Add(p => p.Search, Search));

            // Assert
            Assert.Throws<ArgumentException>(render);
        }

        [Fact]
        public void Should_require_search_options()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var render = () => ctx.Render<FormaSearchToolbar>(parameters => parameters
                .Add(p => p.OnSearch, (string _) => { }));

            // Assert
            Assert.Throws<ArgumentNullException>(render);
        }

        [Fact]
        public void Should_require_a_search_placeholder()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var render = () => ctx.Render(@<FormaSearchToolbar OnSearch="Noop" Search="@(new SearchBoxOptions())" />);

            // Assert
            Assert.Throws<ArgumentNullException>(render);
        }

        [Fact]
        public void Should_reject_a_negative_debounce_delay()
        {
            // Arrange
            using var ctx = new FormaSearchToolbarTests();

            // Act
            var render = () => ctx.Render(
                @<FormaSearchToolbar OnSearch="Noop" Search="@(Search with { DebounceDelay = TimeSpan.FromMilliseconds(-1) })" />);

            // Assert
            Assert.Throws<ArgumentOutOfRangeException>(render);
        }

        private static readonly SearchBoxOptions Search = new() { Placeholder = "Search..." };

        private static Task Noop(string value)
            => Task.CompletedTask;
    }
}
