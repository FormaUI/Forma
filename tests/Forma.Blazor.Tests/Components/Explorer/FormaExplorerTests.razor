        [Fact]
        public void Should_re_read_the_window_after_a_resource_is_dropped_on_a_folder()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var provider = new FakeExplorerItemsProvider([new ImageResourceInfo("https://example.com/photo.jpg")]);
            var folder = new FolderResourceInfo("vacation") { Name = "Vacation" };

            var cut = ctx.Render(@<FormaExplorer ItemsProvider="provider"
                                                Folders="@(ExplorerItem.ForAll([folder]))"
                                                OnDrop="@(_ => Task.CompletedTask)" />);

            cut.WaitForAssertion(() => Assert.NotEmpty(cut.FindAll(".forma-explorer-item")));
            var asked = provider.Queries.Count;

            // Act
            cut.Find(".forma-explorer-item").DragStart();
            cut.FindAll(".forma-explorer-folder-row")[1].Drop();

            // Assert
            cut.WaitForAssertion(() => Assert.True(provider.Queries.Count > asked));
        }

