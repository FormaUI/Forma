        [Fact]
        public void Should_ignore_a_second_load_while_the_first_page_is_still_arriving()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/a.jpg"),
                new ImageResourceInfo("https://example.com/b.jpg"),
                new ImageResourceInfo("https://example.com/c.jpg"),
                new ImageResourceInfo("https://example.com/d.jpg"),
                new ImageResourceInfo("https://example.com/e.jpg"),
                new ImageResourceInfo("https://example.com/f.jpg")
            ];
            var pending = new TaskCompletionSource();
            var pages = new List<int>();
            var cut = ctx.Render(@<FormaExplorer Items="@(ExplorerItem.ForAll(resources))"
                                                PageSize="2"
                                                Options="@(new ExplorerOptions { InfiniteScroll = ExplorerInfiniteScrollMode.Manual })"
                                                OnPageChanged="@(page => { pages.Add(page); return pending.Task; })" />);

            // Act - a second press lands while the host is still fetching the first
            var contentArea = cut.FindComponent<FormaExplorerContentArea>().Instance;
            var first = cut.InvokeAsync(contentArea.HandleReachedAsync);
            var second = cut.InvokeAsync(contentArea.HandleReachedAsync);

            // Assert - the guard turns the second press away, so it settles while the first is still parked
            cut.WaitForState(() => second.IsCompleted);
            cut.WaitForAssertion(() => Assert.Equal([2], pages));

            // Act
            pending.SetResult();
            cut.WaitForState(() => first.IsCompleted);
            var third = cut.InvokeAsync(contentArea.HandleReachedAsync);

            // Assert
            cut.WaitForState(() => third.IsCompleted);
            Assert.Equal([2, 3], pages);
        }

