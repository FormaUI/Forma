            cut.FindAll(".forma-explorer-item-open")[0].Click();

            // Act
            cut.Find(".forma-explorer-clear-button").Click();

            // Assert
            Assert.Multiple(
                () => Assert.Equal(2, reports.Count),
                () => Assert.Empty(reports[^1]));
        }

        [Fact]
        public void Should_stay_quiet_when_adopting_what_the_host_supplied()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var reports = new List<IReadOnlyList<IExplorerItem>>();
            IReadOnlyList<IExplorerItem> selected = ExplorerItem.ForAll([Two[0]]);
            var cut = ctx.Render(@<FormaExplorer Items="@(ExplorerItem.ForAll(Two))"
                                                Selected="selected"
                                                SelectedChanged="@(items => { reports.Add(items); return Task.CompletedTask; })" />);
            var explorer = cut.FindComponent<FormaExplorer>();

            // Act
            explorer.Render(parameters => parameters.Add(p => p.Selected, ExplorerItem.ForAll([Two[1]])));

            // Assert
            Assert.Empty(reports);
        }
    }
