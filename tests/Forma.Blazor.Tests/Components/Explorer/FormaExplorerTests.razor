            using var ctx = new FormaExplorerTests();
            IReadOnlyList<IExplorerItem> items =
            [
                new ExplorerItem
                {
                    Key = "locked",
                    Name = "locked.jpg",
                    IsDisabled = true,
                    Capabilities = ExplorerItemCapabilities.Drag | ExplorerItemCapabilities.Open | ExplorerItemCapabilities.View | ExplorerItemCapabilities.Move | ExplorerItemCapabilities.Rename | ExplorerItemCapabilities.Delete,
                    Resource = new ImageResourceInfo("https://example.com/locked.jpg")
                }
            ];
            var reports = new List<IReadOnlyList<IExplorerItem>>();
            var cut = ctx.Render(@<FormaExplorer Items="items"
                                                SelectedChanged="@(selected => { reports.Add(selected); return Task.CompletedTask; })" />);

            // Assert - drawn as disabled, with no operation offered
            var tile = cut.Find(".forma-explorer-item");
            Assert.Multiple(
                () => Assert.Equal("false", tile.GetAttribute("draggable")),
                () => Assert.Contains("is-disabled", tile.ClassList),
                () => Assert.True(cut.Find(".forma-explorer-item-open").HasAttribute("disabled")),
                () => Assert.Empty(cut.FindAll(".forma-explorer-action-bar")));

            // Act - activation neither previews nor selects it
            cut.Find(".forma-explorer-item-open").Click();
            cut.Find(".forma-explorer-select-mode-button").Click();
            cut.Find(".forma-explorer-item-open").Click();

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll(".forma-dialog")),
                () => Assert.Empty(reports));
