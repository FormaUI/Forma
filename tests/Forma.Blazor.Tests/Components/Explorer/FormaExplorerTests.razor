        [Fact]
        public void Should_raise_on_delete_when_delete_is_confirmed()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/item.jpg")
            ];
            ExplorerDeleteRequest? request = null;
            var cut = ctx.Render(@<FormaExplorer Items="@(ExplorerItem.ForAll(resources))"
                                                OnDelete="@(req => { request = req; return Task.CompletedTask; })" />);

            // Act
            cut.Find(".forma-explorer-action-bar .forma-dropdown-menu-trigger").Click();
            cut.Find("[data-action='delete']").Click();
            cut.Find(".forma-dialog-footer .forma-button-danger").Click();

