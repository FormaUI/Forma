@inherits BunitContext

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_the_input_before_the_label()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-1">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            var children = cut.Find(".forma-field").Children;
            Assert.Equal("INPUT", children[0].TagName);
            Assert.Equal("LABEL", children[1].TagName);
        }

        [Fact]
        public void Should_point_the_label_at_the_input()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-7">
                    <ChildContent><input class="forma-field-input" id="fld-7" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Equal("fld-7", cut.Find(".forma-field-label").GetAttribute("for"));
        }

        [Fact]
        public void Should_render_the_label_text()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Full Name" TargetId="fld-1">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Contains("Full Name", cut.Find(".forma-field-label").TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_not_render_a_required_marker_by_default()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-1">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Empty(cut.FindAll(".forma-field-required"));
        }

        [Fact]
        public void Should_hide_the_required_marker_from_assistive_technology()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-1" Required="true">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Equal("true", cut.Find(".forma-field-required").GetAttribute("aria-hidden"));
        }

        [Fact]
        public void Should_add_the_multiline_class_when_asked()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Notes" TargetId="fld-1" Multiline="true">
                    <ChildContent><textarea class="forma-field-input" id="fld-1"></textarea></ChildContent>
                </FormaField>);

            // Assert
            Assert.Contains("forma-field-multiline", cut.Find(".forma-field").ClassList);
        }

        [Fact]
        public void Should_not_add_the_multiline_class_by_default()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-1">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.DoesNotContain("forma-field-multiline", cut.Find(".forma-field").ClassList);
        }

        [Fact]
        public void Should_render_validation_content_after_the_label()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-1">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                    <Validation><span class="stub-validation">Required</span></Validation>
                </FormaField>);

            // Assert
            var children = cut.Find(".forma-field").Children;
            Assert.Equal("LABEL", children[1].TagName);
            Assert.Contains("stub-validation", children[2].ClassList);
        }

        [Fact]
        public void Should_add_the_inline_class_when_asked()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Active" TargetId="fld-1" LabelMode="FieldLabelMode.Inline">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Contains("forma-field-label-inline", cut.Find(".forma-field").ClassList);
        }

        [Fact]
        public void Should_add_the_pinned_class_when_asked()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Culture" TargetId="fld-1" LabelMode="FieldLabelMode.Pinned">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Contains("forma-field-label-pinned", cut.Find(".forma-field").ClassList);
        }

        [Fact]
        public void Should_add_the_above_class_when_asked()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Volume" TargetId="fld-1" LabelMode="FieldLabelMode.Above">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Contains("forma-field-label-above", cut.Find(".forma-field").ClassList);
        }

        [Fact]
        public void Should_add_no_mode_class_when_the_label_floats()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-1">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Equal("forma-field", cut.Find(".forma-field").GetAttribute("class"));
        }

        [Fact]
        public void Should_merge_a_host_class_onto_the_wrapper()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-1" class="host-class">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("forma-field", cut.Find("div").ClassList);
                Assert.Contains("host-class", cut.Find("div").ClassList);
            });
        }

        [Fact]
        public void Should_not_render_a_label_when_none_is_supplied()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField TargetId="fld-1">
                    <ChildContent><input class="forma-field-input" id="fld-1" aria-label="Name" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Empty(cut.FindAll(".forma-field-label"));
        }

        [Fact]
        public void Should_not_require_a_target_id_when_no_label_renders()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField>
                    <ChildContent><input class="forma-field-input" aria-label="Name" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.NotNull(cut.Find(".forma-field"));
        }

        [Fact]
        public void Should_splat_a_host_id_onto_the_wrapper()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-1" id="wrapper-1">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("wrapper-1", cut.Find(".forma-field").GetAttribute("id"));
                Assert.Equal("fld-1", cut.Find(".forma-field-label").GetAttribute("for"));
            });
        }

        [Fact]
        public void Should_reject_a_blank_target_id()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var act = () => ctx.Render(
                @<FormaField Label="Name" TargetId="">
                    <ChildContent><input class="forma-field-input" /></ChildContent>
                </FormaField>);

            // Assert
            Assert.Throws<ArgumentException>(act);
        }
    }
}
