@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_the_input_before_the_label()
        {
            // Arrange
            using var ctx = new FormaFieldTests();

            // Act
            var cut = ctx.Render(
                @<FormaField Label="Name" TargetId="fld-1">
                    <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                </FormaField>);

            // Assert
            var children = cut.Find(".forma-field").Children;
            Assert.Equal("INPUT", children[0].TagName);
            Assert.Equal("LABEL", children[1].TagName);
        }

