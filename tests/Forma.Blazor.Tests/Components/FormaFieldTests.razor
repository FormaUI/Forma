        [Fact]
        public async Task Should_clear_the_messages_when_the_form_revalidates()
        {
            // Arrange
            using var ctx = new FormaFieldTests();
            var model = new FakeModel();
            var editContext = new EditContext(model);
            var cut = ctx.Render(
                @<FakeFormHost EditContext="editContext">
                    <FormaField Label="Name" TargetId="fld-1" Field="@FieldIdentifier.Create(() => model.Text)">
                        <ChildContent><input class="forma-field-input" id="fld-1" /></ChildContent>
                    </FormaField>
                </FakeFormHost>);
            var messages = new ValidationMessageStore(editContext);
            messages.Add(FieldIdentifier.Create(() => model.Text), "Required");
            await cut.InvokeAsync(editContext.NotifyValidationStateChanged);

            // Act
            messages.Clear();
            await cut.InvokeAsync(editContext.NotifyValidationStateChanged);

            // Assert
            Assert.Empty(cut.FindAll(".forma-field-message"));
        }

