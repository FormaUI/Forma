@inherits FormaBunitContext
@using System.Text
@using Forma.Framework.Icons.Glyphs
@code {
    public sealed class Component
    {
        private static IEnumerable<Glyph> Drawable
            => Enum.GetValues<Glyph>().Where(glyph => glyph is not Glyph.None);

        [Fact]
        public void Should_draw_every_glyph_in_the_set()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act & Assert
            foreach (var glyph in Drawable)
            {
                var cut = ctx.Render(@<FormaIcon Icon="glyph" />);

                Assert.False(
                    string.IsNullOrWhiteSpace(cut.Find("svg path").GetAttribute("d")),
                    $"{glyph} drew nothing; it is missing from _assets/glyphs.json.");
            }
        }

        [Fact]
        public void Should_draw_every_glyph_in_every_variant()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act & Assert
            foreach (var glyph in Drawable)
            {
                foreach (var variant in Enum.GetValues<GlyphVariant>())
                {
                    var icon = Icon.FromGlyph(glyph, variant);
                    var cut = ctx.Render(@<FormaIcon Icon="icon" />);

                    Assert.False(
                        string.IsNullOrWhiteSpace(cut.Find("svg path").GetAttribute("d")),
                        $"{glyph} drew nothing at {variant}.");
                }
            }
        }

        [Fact]
        public void Should_draw_a_different_shape_for_each_glyph()
        {
            // Arrange
            using var ctx = new FormaIconTests();
            var shapes = new HashSet<string>(StringComparer.Ordinal);
            var repeated = new List<Glyph>();

            // Act
            foreach (var glyph in Drawable)
            {
                var cut = ctx.Render(@<FormaIcon Icon="glyph" />);

                if (!shapes.Add(cut.Find("svg").InnerHtml))
                {
                    repeated.Add(glyph);
                }
            }

            // Assert
            Assert.Empty(repeated);
        }

        [Fact]
        public void Should_draw_the_alternate_variant_differently_from_the_default()
        {
            // Arrange
            using var ctx = new FormaIconTests();
            var alternate = Icon.FromGlyph(Glyph.Heart, GlyphVariant.Alternate);

            // Act
            var drawnPrimary = ctx.Render(@<FormaIcon Icon="Glyph.Heart" />).Find("svg").InnerHtml;
            var drawnAlternate = ctx.Render(@<FormaIcon Icon="alternate" />).Find("svg").InnerHtml;

            // Assert
            // The same outline, stroked in one and filled in the other.
            Assert.NotEqual(drawnPrimary, drawnAlternate);
        }

        [Fact]
        public void Should_hide_a_glyph_from_assistive_technology()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var cut = ctx.Render(@<FormaIcon Icon="Glyph.Check" />);

            // Assert
            var svg = cut.Find("svg");
            Assert.Equal("true", svg.GetAttribute("aria-hidden"));
            Assert.Equal("false", svg.GetAttribute("focusable"));
        }

        [Fact]
        public void Should_fill_itself_with_the_current_text_colour()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var cut = ctx.Render(@<FormaIcon Icon="Glyph.Delete" />);

            // Assert
            Assert.Equal("currentColor", cut.Find("svg").GetAttribute("fill"));
        }

        [Fact]
        public void Should_render_the_supplied_class_beside_its_own()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var cut = ctx.Render(@<FormaIcon Icon="Glyph.Folder" Class="my-icon" />);

            // Assert
            var svg = cut.Find("svg");
            Assert.Contains("forma-icon", svg.ClassName, StringComparison.Ordinal);
            Assert.Contains("my-icon", svg.ClassName, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_carry_no_size_class_when_inline()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var cut = ctx.Render(@<FormaIcon Icon="Glyph.Check" />);

            // Assert
            // An inline icon follows the text around it, so nothing sets its size.
            Assert.Equal("forma-icon", cut.Find("svg").ClassName);
        }

        [Theory]
        [InlineData(IconSize.Small, "forma-icon-sm")]
        [InlineData(IconSize.Medium, "forma-icon-md")]
        [InlineData(IconSize.Large, "forma-icon-lg")]
        [InlineData(IconSize.Display, "forma-icon-display")]
        public void Should_carry_the_class_of_its_size(IconSize size, string expected)
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var cut = ctx.Render(@<FormaIcon Icon="Glyph.Check" Size="size" />);

            // Assert
            Assert.Equal($"forma-icon {expected}", cut.Find("svg").ClassName);
        }

        [Fact]
        public void Should_draw_the_grid_that_is_crisp_at_its_size()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var small = ctx.Render(@<FormaIcon Icon="Glyph.Check" Size="IconSize.Small" />).Find("svg");
            var medium = ctx.Render(@<FormaIcon Icon="Glyph.Check" Size="IconSize.Medium" />).Find("svg");

            // Assert
            // At 24px a 24-unit grid puts the stroke on whole pixels; at 32px the 32-unit grid does.
            Assert.Multiple(
                () => Assert.Equal("0 0 24 24", small.GetAttribute("viewBox")),
                () => Assert.Equal("0 0 32 32", medium.GetAttribute("viewBox")));
        }

        [Fact]
        public void Should_draw_through_a_supplied_provider_over_the_registered_one()
        {
            // Arrange
            using var ctx = new FormaIconTests();
            var marker = new MarkerIconProvider();

            // Act
            var cut = ctx.Render(@<FormaIcon Icon="Glyph.Check" Provider="marker" />);

            // Assert
            // The librarys own artwork would draw the tick; the parameter takes precedence.
            Assert.Equal(MarkerIconProvider.Data, cut.Find("svg path").GetAttribute("d"));
        }

        [Fact]
        public void Should_draw_through_a_provider_the_surrounding_subtree_supplies()
        {
            // Arrange
            using var ctx = new FormaIconTests();
            var marker = new MarkerIconProvider();

            // Act
            var cut = ctx.Render(@<CascadingValue Value="(IIconProvider)marker" IsFixed="true">
                                      <FormaIcon Icon="Glyph.Check" />
                                  </CascadingValue>);

            // Assert
            // A subtree names its own artwork without every icon in it repeating the parameter.
            Assert.Equal(MarkerIconProvider.Data, cut.Find("svg path").GetAttribute("d"));
        }

        [Fact]
        public void Should_prefer_its_own_provider_over_the_surrounding_one()
        {
            // Arrange
            using var ctx = new FormaIconTests();
            var marker = new MarkerIconProvider();

            // Act
            var cut = ctx.Render(@<CascadingValue Value="(IIconProvider)marker" IsFixed="true">
                                      <FormaIcon Icon="Glyph.Check" Provider="new GlyphIconProvider()" />
                                  </CascadingValue>);

            // Assert
            // The nearer answer wins, so one icon can differ from the subtree around it.
            Assert.NotEqual(MarkerIconProvider.Data, cut.Find("svg path").GetAttribute("d"));
        }

        [Fact]
        public void Should_fall_back_to_the_bundled_artwork_for_what_a_provider_declines()
        {
            // Arrange
            using var ctx = new FormaIconTests();
            var marker = new MarkerIconProvider();

            // Act
            var cut = ctx.Render(@<FormaIcon Icon="Brand.GitHub" Provider="marker" />);

            // Assert
            // A provider that only knows glyphs still leaves brands and characters drawable.
            Assert.NotEqual(MarkerIconProvider.Data, cut.Find("svg path").GetAttribute("d"));
        }

        [Fact]
        public void Should_stroke_a_stroke_path_in_the_current_text_colour()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var path = ctx.Render(@<FormaIcon Icon="Glyph.Check" />).Find("svg path");

            // Assert
            Assert.Multiple(
                () => Assert.Equal("none", path.GetAttribute("fill")),
                () => Assert.Equal("currentColor", path.GetAttribute("stroke")),
                () => Assert.Equal("2", path.GetAttribute("stroke-width")),
                () => Assert.Equal("round", path.GetAttribute("stroke-linecap")));
        }

        [Fact]
        public void Should_fill_a_filled_path_with_its_knock_outs()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var path = ctx.Render(@<FormaIcon Icon="Icon.FromGlyph(Glyph.Heart, GlyphVariant.Alternate)" />).Find("svg path");

            // Assert
            Assert.Multiple(
                () => Assert.Null(path.GetAttribute("stroke")),
                () => Assert.Equal("evenodd", path.GetAttribute("fill-rule")));
        }

        [Fact]
        public void Should_refuse_to_draw_the_absent_glyph()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act & Assert
            Assert.Throws<ArgumentOutOfRangeException>(
                () => ctx.Render(@<FormaIcon Icon="Glyph.None" />));
        }

        [Fact]
        public void Should_name_a_brand_mark_after_its_brand()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var svg = ctx.Render(@<FormaIcon Icon="Brand.GitHub" Size="IconSize.Small" />).Find("svg");

            // Assert
            // A mark often stands alone as a link, so it carries its own accessible name rather than hiding.
            Assert.Multiple(
                () => Assert.Equal("img", svg.GetAttribute("role")),
                () => Assert.Equal("GitHub", svg.GetAttribute("aria-label")),
                () => Assert.Null(svg.GetAttribute("aria-hidden")),
                () => Assert.Equal("forma-icon forma-icon-sm", svg.ClassName),
                () => Assert.Null(svg.QuerySelector("path")!.GetAttribute("stroke")),
                // The source draws its mark under the default nonzero rule; evenodd would punch holes where its subpaths overlap.
                () => Assert.Null(svg.QuerySelector("path")!.GetAttribute("fill-rule")));
        }

        [Fact]
        public void Should_set_a_character_in_the_icon_box()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var cut = ctx.Render(@<FormaIcon Icon="new Rune('Ω')" Size="IconSize.Small" />);

            // Assert
            var span = cut.Find("span");
            Assert.Multiple(
                () => Assert.Equal("Ω", span.TextContent),
                () => Assert.Equal("forma-icon forma-icon-sm forma-icon-character", span.ClassName),
                () => Assert.Equal("true", span.GetAttribute("aria-hidden")),
                () => Assert.Empty(cut.FindAll("svg")));
        }

        [Fact]
        public void Should_set_a_character_beyond_the_basic_plane_whole()
        {
            // Arrange
            using var ctx = new FormaIconTests();

            // Act
            var cut = ctx.Render(@<FormaIcon Icon="new Rune(0x1D538)" />);

            // Assert
            Assert.Equal("𝔸", cut.Find("span").TextContent);
        }
    }

    /// <summary>Answers every glyph with one recognizable path and declines everything else, so a test can tell which provider drew it.</summary>
    private sealed class MarkerIconProvider : IIconProvider
    {
        public const string Data = "M 0 0 L 32 32";

        public bool TryGetArtwork(Icon icon, IconSize size, out IconArtwork artwork)
        {
            if (icon is GlyphIcon)
            {
                artwork = IconArtwork.Vector("0 0 32 32", [new IconPath { Data = Data, StrokeWidth = 2 }]);
                return true;
            }

            artwork = IconArtwork.None;
            return false;
        }

        public IconArtwork GetArtwork(Icon icon, IconSize size)
            => TryGetArtwork(icon, size, out var artwork) ? artwork : IconArtwork.None;
    }
}
