        [Fact]
        public async Task Should_move_through_the_enabled_items_as_the_router_routes_the_menu_s_keys()
        {
            // Arrange
            using var ctx = new FormaDropDownMenuTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(
                @<FormaDropDownMenu>
                    <Trigger>Options</Trigger>
                    <ChildContent>
                        <FormaDropDownMenuItem>Print</FormaDropDownMenuItem>
                        <FormaDropDownMenuItem>Notes</FormaDropDownMenuItem>
                        <FormaDropDownMenuItem Disabled="true">Archive</FormaDropDownMenuItem>
                    </ChildContent>
                </FormaDropDownMenu>);
            cut.Find(".forma-dropdown-menu-trigger").Click();
            var popover = cut.FindComponent<FormaPopover>().Instance;
            var opened = GetFocused(ctx.JSInterop).Count;

            // Act
            foreach (var (action, key) in new[] { ("menu.first", "Home"), ("menu.next", "ArrowDown"), ("menu.next", "ArrowDown"), ("menu.next", "ArrowDown"), ("menu.last", "End"), ("menu.previous", "ArrowUp") })
            {
                await router.RouteAsync(popover.RootElement, action, key);
            }

            // Assert: Print, Notes, wrapping past the disabled Archive to Print, Notes; then Notes again as the last enabled item, and back to Print.
            var focused = GetFocused(ctx.JSInterop).Skip(opened).ToList();
            Assert.Equal(6, focused.Count);
            Assert.Multiple(
                () => Assert.NotEqual(focused[0], focused[1]),
                () => Assert.Equal(focused[0], focused[2]),
                () => Assert.Equal(focused[1], focused[3]),
                () => Assert.Equal(focused[1], focused[4]),
                () => Assert.Equal(focused[0], focused[5]));
        }

        [Fact]
        public async Task Should_move_through_its_items_in_the_order_the_document_holds_them()
        {
            // Arrange — a group, which renders its own items after the item beside it, and the browser's answer of where each stands
            using var ctx = new FormaDropDownMenuTests();
            ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/operations/DocumentOrder.js").Setup<int[]>("sort", _ => true).SetResult([1, 2, 0]);
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(
                @<FormaDropDownMenu>
                    <Trigger>Options</Trigger>
                    <ChildContent>
                        <FormaDropDownMenuGroup Label="Edit">
                            <FormaDropDownMenuItem>Rename</FormaDropDownMenuItem>
                            <FormaDropDownMenuItem>Duplicate</FormaDropDownMenuItem>
                        </FormaDropDownMenuGroup>
                        <FormaDropDownMenuDivider />
                        <FormaDropDownMenuItem>Delete</FormaDropDownMenuItem>
                    </ChildContent>
                </FormaDropDownMenu>);
            cut.Find(".forma-dropdown-menu-trigger").Click();
            var popover = cut.FindComponent<FormaPopover>().Instance;
            var items = cut.FindComponents<FormaDropDownMenuItem>().Select(item => item.Instance.RootElement.Id).ToList();
            var opened = GetFocused(ctx.JSInterop);

            // Act
            await router.RouteAsync(popover.RootElement, "menu.next", "ArrowDown");
            await router.RouteAsync(popover.RootElement, "menu.next", "ArrowDown");

            // Assert — the menu opened on Rename and moved to Duplicate, then Delete
            Assert.Equal([items[0], items[1], items[2]], [opened[^1], .. GetFocused(ctx.JSInterop).Skip(opened.Count)]);
        }

        [Fact]
        public async Task Should_read_the_document_s_order_again_once_an_item_is_added()
        {
            // Arrange — a menu that has read its order, and an item a condition then adds
            using var ctx = new FormaDropDownMenuTests();
            var order = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/operations/DocumentOrder.js");
            order.Setup<int[]>("sort", _ => true).SetResult([0]);
            var router = new InputRouterProbe(ctx);
            var showsNotes = false;
            var cut = ctx.Render(
                @<FormaDropDownMenu>
                    <Trigger>Options</Trigger>
                    <ChildContent>
                        <FormaDropDownMenuItem>Print</FormaDropDownMenuItem>
                        @if (showsNotes)
                        {
                            <FormaDropDownMenuItem>Notes</FormaDropDownMenuItem>
                        }
                    </ChildContent>
                </FormaDropDownMenu>);
            cut.Find(".forma-dropdown-menu-trigger").Click();
            var popover = cut.FindComponent<FormaPopover>().Instance;
            var read = order.Invocations.Count(invocation => invocation.Identifier == "sort");
            showsNotes = true;
            cut.FindComponent<FormaDropDownMenu>().Render();

            // Act
            await router.RouteAsync(popover.RootElement, "menu.next", "ArrowDown");

            // Assert
            Assert.Equal(2, cut.FindComponents<FormaDropDownMenuItem>().Count);
            Assert.Equal(read + 1, order.Invocations.Count(invocation => invocation.Identifier == "sort"));
        }

        [Fact]
        public async Task Should_follow_items_the_page_reorders_while_keeping_each_of_them()
        {
            // Arrange — keyed items the host reorders in place, so none comes or goes, and the browser's answer for each order
            using var ctx = new FormaDropDownMenuTests();
            var reordered = false;
            var order = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/operations/DocumentOrder.js");
            order.Setup<int[]>("sort", _ => !reordered).SetResult([0, 1, 2]);
            order.Setup<int[]>("sort", _ => reordered).SetResult([2, 0, 1]);
            var router = new InputRouterProbe(ctx);
            string[] names = ["Cut", "Copy", "Paste"];
            var cut = ctx.Render(
                @<FormaDropDownMenu>
                    <Trigger>Edit</Trigger>
                    <ChildContent>
                        @foreach (var name in names)
                        {
                            <FormaDropDownMenuItem @key="name">@name</FormaDropDownMenuItem>
                        }
                    </ChildContent>
                </FormaDropDownMenu>);
            cut.Find(".forma-dropdown-menu-trigger").Click();
            var popover = cut.FindComponent<FormaPopover>().Instance;
            var items = cut.FindComponents<FormaDropDownMenuItem>().ToDictionary(item => item.Find("[role=menuitem]").TextContent.Trim(), item => item.Instance.RootElement.Id);
            names = ["Paste", "Cut", "Copy"];
            reordered = true;
            cut.FindComponent<FormaDropDownMenu>().Render();
            var focused = GetFocused(ctx.JSInterop).Count;

            // Act
            await router.RouteAsync(popover.RootElement, "menu.first", "Home");

            // Assert — the first item is Paste, where the page now holds it
            Assert.Equal([items["Paste"]], GetFocused(ctx.JSInterop).Skip(focused));
        }

