        [Fact]
        public void Should_invoke_onclick_when_an_item_is_activated()
        {
            // Arrange
            using var ctx = new FormaDropDownMenuTests();
            var clicked = false;
            var cut = ctx.Render(
                @<FormaDropDownMenu>
                    <Trigger>Options</Trigger>
                    <ChildContent><FormaDropDownMenuItem OnClick="() => clicked = true">Print</FormaDropDownMenuItem></ChildContent>
                </FormaDropDownMenu>);
            cut.Find(".forma-dropdown-menu-trigger").Click();

            // Act
