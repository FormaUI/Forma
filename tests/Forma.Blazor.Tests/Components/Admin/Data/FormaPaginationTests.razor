        [Fact]
        public void Should_ignore_a_typed_page_that_is_already_current()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();
            var received = new List<int>();
            var cut = ctx.Render(
                @<FormaPagination TotalItems="50" PageSize="10" CurrentPage="2"
                    OnPageChanged="@((int p) => received.Add(p))" />);

            // Act
            cut.Find(".forma-pagination-jump-input").Input("2");
            cut.Find(".forma-pagination-jump-go").Click();

            // Assert
            Assert.Empty(received);
        }

        [Fact]
        public void Should_hide_the_go_button_when_asked()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();

            // Act
            var cut = ctx.Render(
                @<FormaPagination TotalItems="50" PageSize="10" CurrentPage="1" EnableGoButton="false" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Empty(cut.FindAll("button"));
                cut.Find(".forma-pagination-jump-input");
            });
        }

        [Fact]
        public void Should_still_jump_without_the_go_button()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();
            var received = new List<int>();
            var cut = ctx.Render(
                @<FormaPagination TotalItems="50" PageSize="10" CurrentPage="1" EnableGoButton="false"
                    OnPageChanged="@((int p) => received.Add(p))" />);

            // Act
            var input = cut.Find(".forma-pagination-jump-input");
            input.Input("2");
            input.KeyDown(Key.Enter);

            // Assert
            Assert.Equal([2], received);
        }

        [Fact]
        public void Should_read_the_box_when_typing_preceded_the_connection()
        {
            // Arrange — no Input() call, so the component never saw an input event.
            using var ctx = new FormaPaginationTests();
            var received = new List<int>();
            ctx.JSInterop
                .SetupModule("./_content/Forma.Blazor/Components/Admin/Data/FormaPagination.razor.js")
                .Setup<string>("takePageEntry", _ => true)
                .SetResult("3");
            var cut = ctx.Render(
                @<FormaPagination TotalItems="50" PageSize="10" CurrentPage="1"
                    OnPageChanged="@((int p) => received.Add(p))" />);

            // Act
            cut.Find(".forma-pagination-jump-input").KeyDown(Key.Enter);

            // Assert
            Assert.Equal([3], received);
        }

        private static List<string> PageLabels(IEnumerable<IElement> items)
        {
            var list = items.ToList();

            return list
                .Skip(1)
                .Take(list.Count - 2)
                .Select(li => li.TextContent.Trim())
                .ToList();
        }
    }
}
