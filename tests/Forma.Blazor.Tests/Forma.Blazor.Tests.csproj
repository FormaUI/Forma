    <!-- FormaDataGrid's CSS reads a custom property that lives only in QuickGrid's own
         stylesheet. Copying it to the output under a stable name lets a contract test
         assert the property is still declared; the fingerprinted filename and the resolved
         package version both come from the build rather than being written down here. -->
    <Target Name="CopyQuickGridStylesheet" AfterTargets="Build">
        <ItemGroup>
            <_QuickGridStylesheet Include="@(StaticWebAsset)" Condition="$([System.String]::Copy('%(StaticWebAsset.Identity)').Contains('QuickGrid')) AND $([System.String]::Copy('%(StaticWebAsset.Identity)').EndsWith('.bundle.scp.css'))" />
            <QuickGridStylesheet Include="@(_QuickGridStylesheet-&gt;Distinct())" />
        </ItemGroup>
        <Copy SourceFiles="@(QuickGridStylesheet)" DestinationFiles="$(OutDir)QuickGrid.bundle.scp.css" SkipUnchangedFiles="true" />
    </Target>

</Project>
