@page "/button"
@attribute [ShowcasePage("FormaButton")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Forma.UI.Components.Input
@inject IStringLocalizer<FormaButtonPage> L

<h1>FormaButton</h1>
<p class="desc">@L["The Forma button. Five variants set its visual weight, two sizes set its density, and a busy state animates while work is in flight. Pure CSS — no JavaScript."]</p>

<div class="demo-section">
    <h2>@L["Variants"]</h2>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary">@L["Primary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary">@L["Secondary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary">@L["Tertiary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Danger">@L["Danger"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost">@L["Ghost"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Sizes"]</h2>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary">@L["Normal"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Primary" Size="ButtonSize.Mini">@L["Mini"]</FormaButton>
        <FormaButton>@L["Normal"]</FormaButton>
        <FormaButton Size="ButtonSize.Mini">@L["Mini"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Row actions"]</h2>
    <p class="desc">@L["The tertiary variant is the one built for repeated inline commands, such as the actions at the end of a table row."]</p>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Tertiary"
                     OnClick="@(() => Record(L["View"]))">@L["View"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary"
                     OnClick="@(() => Record(L["Edit"]))">@L["Edit"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary"
                     OnClick="@(() => Record(L["Delete"]))">@L["Delete"]</FormaButton>
        <span class="demo-note">@L["Last action: {0}", _lastAction ?? L["none yet"]]</span>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Disabled"]</h2>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary" Disabled="true">@L["Primary"]</FormaButton>
        <FormaButton Disabled="true">@L["Secondary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary" Disabled="true">@L["Tertiary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Danger" Disabled="true">@L["Danger"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost" Disabled="true">@L["Ghost"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Busy"]</h2>
    <p class="desc">@L["A busy button keeps its label, announces itself with aria-busy, and stops accepting clicks until the work finishes."]</p>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary" Busy="true">@L["Saving…"]</FormaButton>
        <FormaButton Busy="true">@L["Saving…"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary" Busy="true">@L["Saving…"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Danger" Busy="true">@L["Saving…"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Inside a form"]</h2>
    <p class="desc">@L["Submit and reset buttons drive the surrounding form without any click handler of their own. A native reset clears the inputs but leaves the bound model alone, so the value below is what the form still holds."]</p>
    <div class="demo-box">
        <EditForm Model="Model" FormName="button-demo" OnValidSubmit="HandleSubmitAsync">
            <FormaInput @bind-Value="Model.Name" Label="@L["Name"]" />
            <div class="demo-row">
                <FormaButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary" Busy="_saving">
                    @(_saving ? L["Saving…"] : L["Save"])
                </FormaButton>
                <FormaButton Type="ButtonType.Reset">@L["Reset"]</FormaButton>
                <span class="demo-note">@(_saved ? L["Saved."] : L["Not saved yet."])</span>
            </div>
        </EditForm>
        <p class="demo-note">
            @L["Bound value: {0}", string.IsNullOrEmpty(Model.Name) ? L["(empty)"].Value : Model.Name]
        </p>
    </div>
</div>

@code {
    private ButtonDemoModel Model { get; set; } = new();

    private string? _lastAction;
    private bool _saving;
    private bool _saved;

    private void Record(string action) => _lastAction = action;

    private async Task HandleSubmitAsync()
    {
        _saving = true;
        _saved = false;

        await Task.Delay(1200);

        _saving = false;
        _saved = true;
    }

    private sealed class ButtonDemoModel
    {
        public string? Name { get; set; }
    }
}
