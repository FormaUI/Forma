@page "/pagination"
@attribute [ShowcasePage("FormaPagination")]
@rendermode InteractiveServer
@using Forma.UI.Components.Data

<h1>FormaPagination</h1>
<p class="desc">@L["A page-number navigator for splitting a list of items across multiple pages."]</p>

<div class="demo-section">
    <h2>@L["Few pages"]</h2>
    <p class="desc">@L["When every page fits, all of them are shown with no collapsed gaps."]</p>
    <div class="demo-box">
        <FormaPagination TotalItems="65" PageSize="10" CurrentPage="_fewPage" OnPageChanged="HandleFewPageChanged"
                         Options="NavigationStepsOnly" aria-label="@L["Few pages"]" />
        <p class="demo-output">@L["Current page"]: <code>@_fewPage</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Many pages"]</h2>
    <p class="desc">@L["With more pages than fit, the boundary and sibling pages are shown and the rest collapse into an ellipsis."]</p>
    <div class="demo-box">
        <FormaPagination TotalItems="4000" PageSize="20" CurrentPage="_manyPage" OnPageChanged="HandleManyPageChanged"
                         Options="NavigationStepsOnly" aria-label="@L["Many pages"]" />
        <p class="demo-output">@L["Current page"]: <code>@_manyPage</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["With a grid"]</h2>
    <p class="desc">@L["Driving a QuickGrid, slicing the page of data to match whatever page is selected."]</p>
    <div class="demo-box">
        <QuickGrid Items="GridPageItems">
            <PropertyColumn Property="@(item => item.Id)" Title="@L["Id"]" />
            <PropertyColumn Property="@(item => item.Title)" Title="@L["Title"]" />
        </QuickGrid>
        <FormaPagination TotalItems="_gridItems.Count" PageSize="GridPageSize" CurrentPage="_gridPage" OnPageChanged="HandleGridPageChanged"
                         Options="NavigationStepsOnly" aria-label="@L["With a grid"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Jump to a page"]</h2>
    <p class="desc">@L["An optional box for typing a page number — useful when there are far too many pages to click through. Press Enter or the button to go."]</p>
    <div class="demo-box">
        <FormaPagination TotalItems="4000" PageSize="20" CurrentPage="_jumpPage" OnPageChanged="HandleJumpPageChanged"
                         Options="NavigationBar" aria-label="@L["Jump to a page"]" />
        <p class="demo-output">@L["Current page"]: <code>@_jumpPage</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Input only"]</h2>
    <p class="desc">@L["The typing box on its own, with no page links — the most compact pager, for tight toolbars."]</p>
    <div class="demo-box">
        <FormaPagination TotalItems="4000" PageSize="20" CurrentPage="_inputOnlyPage" OnPageChanged="HandleInputOnlyPageChanged"
                         Options="NavigationInput" aria-label="@L["Input only"]" />
        <p class="demo-output">@L["Current page"]: <code>@_inputOnlyPage</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Input only, no button"]</h2>
    <p class="desc">@L["Just the box. Press Enter to go."]</p>
    <div class="demo-box">
        <FormaPagination TotalItems="4000" PageSize="20" CurrentPage="_barePage" OnPageChanged="HandleBarePageChanged"
                         Options="NavigationInputOnly"
                         aria-label="@L["Input only, no button"]" />
        <p class="demo-output">@L["Current page"]: <code>@_barePage</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Inside a form"]</h2>
    <p class="desc">@L["Enter jumps to the page without submitting the surrounding form. The submission count stays at zero."]</p>
    <div class="demo-box">
        <form @onsubmit="HandleFormSubmit" @onsubmit:preventDefault>
            <FormaPagination TotalItems="4000" PageSize="20" CurrentPage="_formPage" OnPageChanged="HandleFormPageChanged"
                             aria-label="@L["Inside a form"]" />
        </form>
        <p class="demo-output">
            @L["Current page"]: <code>@_formPage</code> &middot;
            @L["Form submissions"]: <code>@_formSubmits</code>
        </p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Single page"]</h2>
    <p class="desc">@L["When everything fits on one page, the component renders nothing."]</p>
    <div class="demo-box">
        <FormaPagination TotalItems="8" PageSize="10" CurrentPage="1" Options="NavigationBar" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Page beyond the range"]</h2>
    <p class="desc">@L["A page past the end — after a filter narrows the list, or from a hand-edited URL — settles on the nearest page."]</p>
    <div class="demo-box">
        <FormaPagination TotalItems="30" PageSize="10" CurrentPage="99"
                         Options="NavigationStepsOnly" aria-label="@L["Page beyond the range"]" />
    </div>
</div>
