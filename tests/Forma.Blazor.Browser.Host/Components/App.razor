<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <FormaPageHead Title="Forma Browser Check" />
</head>
<body>
    @if (HostModes.NavigationRoutes is { } navigation)
    {
        <Forma.Blazor.Browser.Host.Client.Navigation.RecordingRoutes @rendermode="navigation" />
    }
    else
    {
        <Routes @rendermode="HostModes.Routes" />
    }
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    @* Each WebAssembly runtime reads the host's arrangement from the variable the host's own environment names. *@
    <script>
        Blazor.start({ webAssembly: { configureRuntime: dotnet => dotnet.withEnvironmentVariable('FORMA_BROWSER_ARRANGEMENT', '@(HostModes.ArrangementVariable ?? string.Empty)') } });
    </script>
</body>
</html>
