<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- The WebView check host: a WPF application whose windows each render Forma's components to a web view, which the browser check drives through WebView2. -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
        <UseWPF>true</UseWPF>
        <!-- Builds on every platform the gate runs on, though WebView2 runs on Windows alone. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
        <PackageReference Include="Microsoft.Web.WebView2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Forma.Blazor\Forma.Blazor.csproj" />
        <ProjectReference Include="..\..\src\Forma.Blazor.WebView\Forma.Blazor.WebView.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework\Forma.Framework.Culture\Forma.Framework.Culture.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework\Forma.Framework.Culture.Blazor.WebView\Forma.Framework.Culture.Blazor.WebView.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework\Forma.Framework.Culture.Router\Forma.Framework.Culture.Router.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework\Forma.Framework.Localization.Json\Forma.Framework.Localization.Json.csproj" />
    </ItemGroup>

</Project>
