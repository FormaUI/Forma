@* The root every web view renders: the interactive router over the check host's pages, with the web view's name cascaded to them. *@
<CascadingValue Value="WebView" Name="WebView">
    <Router AppAssembly="typeof(ProbeRoot).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" />
        </Found>
    </Router>
</CascadingValue>

@code {
    /// <summary>The web view's name.</summary>
    [Parameter, EditorRequired] public string WebView { get; set; } = default!;
}
