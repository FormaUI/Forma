                () => Assert.Equal("INPUT", Assert.Single(marked).TagName),
                () => Assert.Equal("Notes.txt", marked[0].Closest(".forma-data-tree-node")!.QuerySelector(".forma-data-tree-node-name")!.TextContent));

            // Act — the mark goes once the node holds the focus
