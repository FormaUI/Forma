@inherits FormaBunitContext
@using System.Globalization
@using AngleSharp.Dom
@using Forma.Framework.Browser.Interop.Focus
@using Forma.Framework.Input
@using Forma.Framework.Input.Keyboard
@using Microsoft.AspNetCore.Components.Web

@code {
    // Two folders at the root, one holding a folder and a file, the other a file; folders open, files are leaves.
    private static IQueryable<Entry> CreateEntries() => new[]
    {
        new Entry(1, null, "Documents", true),
        new Entry(2, null, "Pictures", true),
        new Entry(3, 1, "Reports", true),
        new Entry(4, 1, "Notes.txt", false),
        new Entry(5, 2, "Beach.jpg", false),
        new Entry(6, 3, "Q1.pdf", false),
    }.AsQueryable();

    // Leaves at the root, named from one.
    private static IQueryable<Entry> CreateLeaves(int count)
        => Enumerable.Range(1, count).Select(id => new Entry(id, null, $"Leaf {id}", false)).AsQueryable();

    public sealed class Component
    {
        [Fact]
        public void Should_draw_the_roots_as_a_tree_with_each_node_s_level_and_open_state()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateEntries()" EnablePagination="false" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)">
                    <FormaDataTree TItem="Entry" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 2);

            // Assert
            var nodes = cut.FindAll("[role=treeitem]");
            Assert.Multiple(
                () => Assert.Equal("tree", cut.Find("ul.forma-data-tree-level").GetAttribute("role")),
                () => Assert.Equal(["Documents", "Pictures"], nodes.Select(node => node.QuerySelector(".forma-data-tree-node-name")!.TextContent).ToList()),
                () => Assert.Equal("1", nodes[0].GetAttribute("aria-level")),
                () => Assert.Equal("false", nodes[0].GetAttribute("aria-expanded")),
                () => Assert.Equal(nodes[0].QuerySelector(".forma-data-tree-node-name")!.Id, nodes[0].GetAttribute("aria-labelledby")),
                () => Assert.NotNull(nodes[0].QuerySelector("button.forma-data-tree-disclosure-button")));
        }

        [Fact]
        public void Should_carry_the_caller_s_name_on_the_tree_rather_than_the_root()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateEntries()" EnablePagination="false" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)">
                    <FormaDataTree TItem="Entry" aria-label="Folders" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 2);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Folders", cut.Find("[role=tree]").GetAttribute("aria-label")),
                () => Assert.Null(cut.Find(".forma-data-tree").GetAttribute("aria-label")));
        }

        [Fact]
        public void Should_open_a_node_from_its_disclosure_and_show_its_children_a_level_deeper()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateEntries()" EnablePagination="false" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)">
                    <FormaDataTree TItem="Entry" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 2);

            // Act
            cut.Find("button.forma-data-tree-disclosure-button").Click();
            cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 4);

            // Assert
            var documents = cut.FindAll("[role=treeitem]")[0];
            var group = cut.Find("[role=group]");
            var children = group.QuerySelectorAll("[role=treeitem]");
            Assert.Multiple(
                () => Assert.Equal("true", documents.GetAttribute("aria-expanded")),
                () => Assert.Equal(group.Id, documents.GetAttribute("aria-owns")),
                () => Assert.Equal(["Reports", "Notes.txt"], children.Select(node => node.QuerySelector(".forma-data-tree-node-name")!.TextContent).ToList()),
                () => Assert.Equal("2", children[0].GetAttribute("aria-level")),
                () => Assert.Null(children[1].GetAttribute("aria-expanded")),
                () => Assert.Null(children[1].QuerySelector("button.forma-data-tree-disclosure-button")));

            // Act — pressed again
            cut.Find("button.forma-data-tree-disclosure-button").Click();

            // Assert
            Assert.Equal(2, cut.FindAll("[role=treeitem]").Count);
        }

        [Fact]
        public void Should_draw_the_visible_nodes_in_one_run_saying_each_level_and_place_while_virtualizing()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateEntries()" EnablePagination="false" Virtualize="true" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)">
                    <FormaDataTree TItem="Entry" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 2);

            // Act
            cut.Find("button.forma-data-tree-disclosure-button").Click();
            cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 4);

            // Assert — no group holds the children, so each node says its level, its siblings' count and its place among them
            var nodes = cut.FindAll("[role=treeitem]");
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll("[role=group]")),
                () => Assert.Equal(["Documents", "Reports", "Notes.txt", "Pictures"], nodes.Select(node => node.QuerySelector(".forma-data-tree-node-name")!.TextContent).ToList()),
                () => Assert.Equal(["1", "2", "2", "1"], nodes.Select(node => node.GetAttribute("aria-level")).ToList()),
                () => Assert.Equal(["1", "1", "2", "2"], nodes.Select(node => node.GetAttribute("aria-posinset")).ToList()),
                () => Assert.Equal(["2", "2", "2", "2"], nodes.Select(node => node.GetAttribute("aria-setsize")).ToList()),
                () => Assert.Null(nodes[0].GetAttribute("aria-owns")));
        }

