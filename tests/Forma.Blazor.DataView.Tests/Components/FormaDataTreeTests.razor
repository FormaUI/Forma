            cut.FindAll(".forma-data-tree-node")[0].FocusOut();
            cut.FindAll(".forma-data-tree-node")[1].FocusIn();
            await router.RouteAsync("tree.previous", "ArrowUp");

            // Assert — up from Pictures
            Assert.Equal("Reports", current!.Name);
