        [Fact]
        public void Should_stand_beside_the_active_view_and_out_of_the_switch_when_it_selects_the_current_node()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateEntries()" EnablePagination="false" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)">
                    <FormaDataViewSwitch />
                    <FormaDataTree TItem="Entry" SelectsCurrent="true" NodeFilter="@(entry => entry.IsFolder)" />
                    <FormaDataGrid TItem="Entry">
                        <Columns>
                            <FormaPropertyColumn Property="@(entry => entry.Name)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 2 && cut.FindAll("tbody tr.forma-data-grid-row").Count == 2);

            // Assert — both draw at once, the region lays them out across, and the switch offers the grid alone
            Assert.Multiple(
                () => Assert.Contains("forma-data-view-region-companions", cut.Find(".forma-data-view-region").ClassName, StringComparison.Ordinal),
                () => Assert.Contains("forma-data-tree-companion", cut.Find(".forma-data-tree").ClassName, StringComparison.Ordinal),
                () => Assert.Equal(["Grid"], cut.FindAll(".forma-data-view-switch button").Select(button => button.TextContent.Trim()).ToList()));
