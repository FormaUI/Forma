            Entry? current = null;
            var cut = ctx.Render(
                @<FormaDataView TItem="Entry" Items="CreateEntries()" EnablePagination="false" Virtualize="true" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)" CurrentItemChanged="@((Entry? entry) => current = entry)">
