        [Fact]
        public async Task Should_show_a_chosen_node_s_children_in_the_grid_beside_it()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();
            var router = new InputRouterProbe(ctx);
            Entry? current = null;
            var cut = ctx.Render(
                @<FormaDataView TItem="Entry" Items="CreateEntries()" EnablePagination="false" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)" CurrentItemChanged="@((Entry? entry) => current = entry)">
