        [Fact]
        public async Task Should_move_into_a_folder_double_clicked_or_entered_in_a_selecting_grid_and_leave_a_click_to_the_selection()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();
            Entry? clicked = null;
            var cut = ctx.Render(
                @<FormaDataView Items="CreateEntries()" EnablePagination="false" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)" EnableItemSelection="true" OnItemClick="@((Entry entry) => clicked = entry)">
                    <FormaDataGrid TItem="Entry">
                        <Columns>
                            <FormaPropertyColumn Property="@(entry => entry.Name)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("tbody tr.forma-data-grid-row").Count == 2);

            // Act — a double press on Documents moves into it
            await PressRowAsync(cut, 0);
            cut.WaitForState(() => cut.Markup.Contains("Notes.txt", StringComparison.Ordinal));

            // Assert
            Assert.Equal(["Reports", "Notes.txt"], cut.FindAll("tbody tr.forma-data-grid-row td:last-child").Select(cell => cell.TextContent).ToList());

            // Act — Enter on Reports' marker, as the selection behavior reports it, moves into it, and a double press on a file is a click
            var marker = cut.Find("tbody tr.forma-data-grid-row input[data-row-key]");
            var token = int.Parse(marker.GetAttribute("data-row-key")!, CultureInfo.InvariantCulture);
            await cut.InvokeAsync(() => cut.FindComponent<FormaDataView<Entry>>().Instance.HandleActivateAsync(token));
            cut.WaitForState(() => cut.Markup.Contains("Q1.pdf", StringComparison.Ordinal));
            await PressRowAsync(cut, 0);

            // Assert
            Assert.Equal("Q1.pdf", clicked!.Name);
        }

        [Fact]
        public void Should_show_the_children_of_the_node_the_host_names()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();
            var reports = CreateEntries().Single(entry => entry.Id == 3);

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateEntries()" EnablePagination="false" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)" CurrentItem="reports">
                    <FormaDataGrid TItem="Entry">
                        <Columns>
                            <FormaPropertyColumn Property="@(entry => entry.Name)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("tbody tr.forma-data-grid-row").Count == 1);

            // Assert
            Assert.Equal("Q1.pdf", cut.Find("tbody tr.forma-data-grid-row td").TextContent);
        }
    }

    private sealed record Entry(int Id, int? ParentId, string Name, bool IsFolder);

    // A press on a row reaches the data view through the selection behavior, which tells it the token the row carries.
    private static Task PressRowAsync(IRenderedComponent<IComponent> cut, int index)
    {
        var token = int.Parse(cut.FindAll("tbody tr.forma-data-grid-row")[index].GetAttribute("data-item")!, CultureInfo.InvariantCulture);

        return cut.InvokeAsync(() => cut.FindComponent<FormaDataView<Entry>>().Instance.HandleActivateAsync(token));
    }
}
