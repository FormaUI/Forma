        [Fact]
        public async Task Should_open_and_close_a_node_from_the_inline_arrows()
        {
            // Arrange — with a selection, the tree claims the inline arrows alone and leaves the vertical keys to it
            using var ctx = new FormaDataTreeTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(
                @<FormaDataView Items="CreateEntries()" EnablePagination="false" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)" EnableItemSelection="true">
                    <FormaDataTree TItem="Entry" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 2);
            cut.Find(".forma-data-tree-node").FocusIn();

            // Act
            await router.RouteAsync("tree.open", "ArrowRight");
            cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 4);

            // Assert
            Assert.Equal("true", cut.Find("[role=treeitem]").GetAttribute("aria-expanded"));
            Assert.Equal(["tree.open:ArrowRight", "tree.close:ArrowLeft", "tree.find:typing"], InputRouterProbe.GetRoutes(router.Registrations.Last()));

            // Act
            await router.RouteAsync("tree.close", "ArrowLeft");

            // Assert
            Assert.Equal(2, cut.FindAll("[role=treeitem]").Count);
        }

        [Fact]
        public void Should_bind_the_inline_arrows_by_the_reading_direction()
        {
            // Arrange — the reading direction is the culture's, which the tree reads as it registers
            var previous = CultureInfo.CurrentCulture;
            CultureInfo.CurrentCulture = CultureInfo.GetCultureInfo("he");

            try
            {
                using var ctx = new FormaDataTreeTests();
                var router = new InputRouterProbe(ctx);

                // Act
                var cut = ctx.Render(
                    @<FormaDataView Items="CreateEntries()" EnablePagination="false" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)" EnableItemSelection="true">
                        <FormaDataTree TItem="Entry" />
                    </FormaDataView>);
                cut.WaitForState(() => cut.FindAll("[role=treeitem]").Count == 2);

                // Assert
                Assert.Equal(["tree.open:ArrowLeft", "tree.close:ArrowRight", "tree.find:typing"], InputRouterProbe.GetRoutes(router.Registrations.Last()));
            }
            finally
            {
                CultureInfo.CurrentCulture = previous;
            }
        }

        [Fact]
        public async Task Should_jump_to_the_next_node_starting_with_a_typed_letter()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();
            var router = new InputRouterProbe(ctx);
            IReadOnlyList<Entry>? changedTo = null;
            var cut = ctx.Render(
