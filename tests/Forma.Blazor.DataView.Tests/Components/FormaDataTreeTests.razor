        [Fact]
        public async Task Should_move_into_a_folder_activated_in_the_grid_and_leave_a_file_to_the_click()
        {
            // Arrange
            using var ctx = new FormaDataTreeTests();
            Entry? clicked = null;
            var cut = ctx.Render(
                @<FormaDataView Items="CreateEntries()" EnablePagination="false" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.ParentId)" HasChildren="@(entry => entry.IsFolder)" OnItemClick="@((Entry entry) => clicked = entry)">
