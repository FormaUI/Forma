@inherits FormaBunitContext
@using AngleSharp.Dom

@code {
    public sealed class Component
    {
        private static IQueryable<Product> CreateProducts() => new[]
        {
            new Product(1, "Hammer", "Tools"),
            new Product(2, "Atlas", "Books"),
            new Product(3, "Wrench", "Tools"),
        }.AsQueryable();

        [Fact]
        public void Should_draw_a_card_per_item_with_its_thumbnail_its_name_its_detail_and_its_actions()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" CardSize="@CssLength.FromRem(12)">
                        <ThumbnailTemplate Context="product"><span class="thumb">@product.Id</span></ThumbnailTemplate>
                        <ItemTemplate Context="product"><span class="detail">@product.Category</span></ItemTemplate>
                        <ActionsTemplate Context="product"><button class="act">Open @product.Name</button></ActionsTemplate>
                    </FormaDataCards>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Assert
            var cards = cut.FindAll("[role=listitem]");
            Assert.Multiple(
                () => Assert.Equal("list", cut.Find(".forma-data-cards-pack").GetAttribute("role")),
                () => Assert.Contains("--forma-data-cards-size: 12rem", cut.Find(".forma-data-cards").GetAttribute("style"), StringComparison.Ordinal),
                () => Assert.Equal("Hammer", cards[0].QuerySelector(".forma-data-card-name")!.TextContent),
                () => Assert.Equal("1", cards[0].QuerySelector(".forma-data-card-thumbnail .thumb")!.TextContent),
                () => Assert.Equal("Tools", cards[0].QuerySelector(".forma-data-card-detail .detail")!.TextContent),
                () => Assert.Equal("Open Hammer", cards[0].QuerySelector(".forma-data-card-actions .act")!.TextContent),
                () => Assert.True(cards[0].HasAttribute("data-item")));
        }

        [Fact]
        public void Should_draw_the_thumbnail_and_the_name_alone_when_dense()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" Dense="true">
                        <ThumbnailTemplate Context="product"><span class="thumb">@product.Id</span></ThumbnailTemplate>
                        <ItemTemplate Context="product"><span class="detail">@product.Category</span></ItemTemplate>
                        <ActionsTemplate Context="product"><button class="act">Open</button></ActionsTemplate>
                    </FormaDataCards>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Assert
            Assert.Multiple(
                () => Assert.Contains("forma-data-cards-dense", cut.Find(".forma-data-cards").ClassName, StringComparison.Ordinal),
                () => Assert.Equal(3, cut.FindAll(".thumb").Count),
                () => Assert.Equal(3, cut.FindAll(".forma-data-card-name").Count),
                () => Assert.Empty(cut.FindAll(".detail")),
                () => Assert.Empty(cut.FindAll(".act")));
        }

        [Fact]
        public void Should_mark_a_selected_card_with_the_tint_and_a_check_under_item_selection()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)" EnableItemSelection="true" SelectedItems="@(new[] { new Product(2, "Atlas", "Books") })">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Assert
            var cards = cut.FindAll("[role=listitem]");
            Assert.Multiple(
                () => Assert.Contains("forma-data-card-selected", cards[1].ClassName, StringComparison.Ordinal),
                () => Assert.Equal("true", cards[1].GetAttribute("aria-selected")),
                () => Assert.NotNull(cards[1].QuerySelector(".forma-data-card-check")),
                () => Assert.Null(cards[0].QuerySelector(".forma-data-card-check")),
                () => Assert.Equal(3, cut.FindAll("input.forma-data-card-marker[data-row-key]").Count));
        }

        [Fact]
        public void Should_draw_a_box_per_card_under_checked_selection_and_select_through_it()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();
            IReadOnlyList<Product>? changedTo = null;
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)" EnableCheckedSelection="true" SelectedItemsChanged="@((IReadOnlyList<Product> selected) => changedTo = selected)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Act
            cut.FindAll("input.forma-data-card-box")[0].Click();

            // Assert
            Assert.Equal(1, Assert.Single(changedTo!).Id);
        }

        [Fact]
        public void Should_carry_the_caller_s_name_on_the_list_rather_than_the_root()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" aria-label="Products" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Products", cut.Find("[role=list]").GetAttribute("aria-label")),
                () => Assert.Null(cut.Find(".forma-data-cards").GetAttribute("aria-label")));
        }

        [Fact]
        public void Should_name_the_groups_by_the_caller_and_each_group_s_list_by_its_heading()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)" GroupBy="@(DataViewGrouping<Product>.By(product => product.Category))">
                    <FormaDataCards TItem="Product" aria-label="Products" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-group").Count == 2);

            // Assert
            var groups = cut.Find(".forma-data-cards-groups");
            var first = cut.Find(".forma-data-cards-group");
            Assert.Multiple(
                () => Assert.Equal("group", groups.GetAttribute("role")),
                () => Assert.Equal("Products", groups.GetAttribute("aria-label")),
                () => Assert.Equal(first.QuerySelector(".forma-data-group-name")!.Id, first.QuerySelector("[role=list]")!.GetAttribute("aria-labelledby")),
                () => Assert.False(string.IsNullOrEmpty(first.QuerySelector(".forma-data-group-name")!.Id)));
        }

        [Fact]
        public void Should_fold_a_group_from_its_heading()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)" GroupBy="@(DataViewGrouping<Product>.By(product => product.Category))">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-group").Count == 2);

            // Act
            cut.Find(".forma-data-cards-group button").Click();

            // Assert
            var groups = cut.FindAll(".forma-data-cards-group");
            Assert.Multiple(
                () => Assert.Equal("1", groups[0].QuerySelector(".forma-data-group-count")!.TextContent),
                () => Assert.Empty(groups[0].QuerySelectorAll("[role=listitem]")),
                () => Assert.Equal(2, groups[1].QuerySelectorAll("[role=listitem]").Length));
        }

        [Fact]
        public void Should_wait_for_the_columns_before_drawing_virtualized_rows()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);

            // Assert — the rows are laid out once the ruler reports how many columns the width holds
            Assert.Empty(cut.FindAll(".forma-data-card"));
        }

        [Fact]
        public async Task Should_draw_virtualized_rows_of_the_columns_the_width_holds()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);

            // Act
            var cards = cut.FindComponent<FormaDataCards<Product>>();
            await cards.InvokeAsync(() => cards.Instance.HandleGridColumnsAsync(2));
            cut.WaitForState(() => cut.FindAll(".forma-data-card").Count == 3);

            // Assert — two across then one, each card saying where it stands in the set
            Assert.Multiple(
                () => Assert.Equal([2, 1], cut.FindAll(".forma-data-cards-row").Select(row => row.QuerySelectorAll(".forma-data-card").Length)),
                () => Assert.Equal(["1", "2", "3"], cut.FindAll(".forma-data-card").Select(card => card.GetAttribute("aria-posinset"))),
                () => Assert.All(cut.FindAll(".forma-data-card"), card => Assert.Equal("3", card.GetAttribute("aria-setsize"))));
        }

        [Fact]
        public async Task Should_measure_the_columns_again_when_the_cards_show_again()
        {
            // Arrange — the cards beside the list, so the view switch takes them off the page and back
            using var ctx = new FormaDataCardsTests();
            var cut = ctx.Render(
                @<FormaDataView TItem="Product" Items="CreateProducts()" EnablePagination="false" Virtualize="true" View="cards" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);
            var engine = cut.FindComponent<FormaDataView<Product>>();

            // Act
            await engine.InvokeAsync(() => engine.Instance.SwitchViewAsync("list"));
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 0);
            await engine.InvokeAsync(() => engine.Instance.SwitchViewAsync("cards"));
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);

            // Assert — the new ruler is watched from when it shows, the one taken away no longer
            var rulerAttaches = ctx.JSInterop.Invocations.Count(invocation => invocation.Identifier == "attach"
                && invocation.Arguments is [ElementReference, { } options]
                && options.GetType().GetProperties() is [{ Name: "owner" }]);
            Assert.Equal(2, rulerAttaches);
        }

        [Fact]
        public async Task Should_open_on_the_heading_of_the_group_whose_first_row_holds_the_initial_item()
        {
            // Arrange — the rows are Books' heading, Atlas, Tools' heading, then Hammer and Wrench together
            using var ctx = new FormaDataCardsTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" InitialItemIndex="2" ItemName="@(product => product.Name)" GroupBy="@(DataViewGrouping<Product>.By(product => product.Category))">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);

            // Act
            var cards = cut.FindComponent<FormaDataCards<Product>>();
            await cards.InvokeAsync(() => cards.Instance.HandleGridColumnsAsync(2));
            cut.WaitForState(() => cut.FindAll(".forma-data-card").Count > 0);

            // Assert — Wrench stands in Tools' first row, so the rows open on Tools' heading
            var virtualization = cut.FindComponents<IComponent>().Single(component => component.Instance.GetType().IsGenericType && component.Instance.GetType().GetGenericTypeDefinition() == typeof(Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize<>)).Instance;
            Assert.Equal(2, virtualization.GetType().GetProperty("InitialItemIndex")!.GetValue(virtualization));
        }

        [Fact]
        public async Task Should_draw_each_group_s_heading_above_its_virtualized_rows()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" ItemName="@(product => product.Name)" GroupBy="@(DataViewGrouping<Product>.By(product => product.Category))">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);

            // Act
            var cards = cut.FindComponent<FormaDataCards<Product>>();
            await cards.InvokeAsync(() => cards.Instance.HandleGridColumnsAsync(4));
            cut.WaitForState(() => cut.FindAll(".forma-data-card").Count == 3);

            // Assert — a group's cards start a row of their own beneath its heading
            Assert.Multiple(
                () => Assert.Equal(["Books", "Tools"], cut.FindAll(".forma-data-group-name").Select(name => name.TextContent)),
                () => Assert.Equal([1, 2], cut.FindAll(".forma-data-cards-row").Select(row => row.QuerySelectorAll(".forma-data-card").Length)));
        }

        private sealed record Product(int Id, string Name, string Category);
    }
}
