                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("thead input[type=checkbox]").Count == 1);
            await cut.Find("thead input[type=checkbox]").ClickAsync(new MouseEventArgs());
            await cut.Find(".forma-pagination-navigation-input .forma-pagination-navigation-button-next").ClickAsync(new MouseEventArgs());
            Assert.Contains("Item 11", cut.Markup, StringComparison.Ordinal);

