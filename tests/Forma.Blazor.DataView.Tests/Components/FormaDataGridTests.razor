        [Fact]
        public void Should_keep_an_item_selected_by_key_when_the_provider_returns_a_fresh_copy()
        {
            // Arrange — every fetch materializes items equal to the selected one in nothing but the key
            using var ctx = new FormaDataGridTests();
            DataViewItemsProvider<GridItem> provider = request => ValueTask.FromResult(
                new DataViewPage<GridItem>(CreateItems(25).Skip(request.StartIndex).Take(request.Count ?? 25).Select(item => new GridItem(item.Id, $"Fresh {item.Title}")).ToArray(), 25));

            var cut = ctx.Render(
                @<FormaDataView ItemsProvider="provider" ItemKey="@(item => item.Id)" PageSize="10" EnableCheckedSelection="true" SelectedItems="@(new[] { new GridItem(11, "Item 11") })">
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(item => item.Title)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("nav.forma-pagination").Count == 1);

            // Act
            cut.Find(".forma-pagination-navigation-input .forma-pagination-navigation-button-next").Click();
            cut.WaitForState(() => cut.Markup.Contains("Fresh Item 11", StringComparison.Ordinal));

            // Assert
            Assert.Equal("true", cut.FindAll("tbody tr")[0].GetAttribute("aria-selected"));
        }

