        [Fact]
        public async Task Should_release_row_tokens_for_rows_that_leave_the_grid()
        {
            // Arrange
            using var ctx = new FormaDataGridTests();
            IReadOnlyList<GridItem>? changedTo = null;

            var cut = ctx.Render(
                @<FormaDataView Items="CreateItems(4)" PageSize="2" EnableItemSelection="true" SelectedItemsChanged="@((IReadOnlyList<GridItem> selected) => changedTo = selected)">
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(item => item.Title)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("tbody .forma-data-grid-row-marker").Count == 2);
            var grid = cut.FindComponent<FormaDataView<GridItem>>();
            var staleToken = GetRowTokens(grid)[0];

            // Act — paging retires the first page's rows, the next pass drops them
            var pager = cut.FindComponent<FormaPagination>();
            await cut.InvokeAsync(() => pager.Instance.OnPageChanged.InvokeAsync(2));
            grid.WaitForState(() => grid.Markup.Contains("Item 3", StringComparison.Ordinal));
            grid.Render();
            await cut.InvokeAsync(() => grid.Instance.HandleSelectAsync(staleToken, additive: false));

            // Assert
            Assert.Null(changedTo);
        }

        private static IReadOnlyList<int> GetRowTokens<TComponent>(IRenderedComponent<TComponent> rendered)
            where TComponent : IComponent
            => [.. rendered.FindAll("tbody .forma-data-grid-row-marker")
                .Select(marker => int.Parse(marker.GetAttribute("data-row-key")!, CultureInfo.InvariantCulture))];

        private sealed record GridItem(int Id, string Title);

        private sealed record Reading(int Id, decimal Value, Extent Size);

        private sealed record Extent(double Width);

        private sealed record Product(int Id, string Title, string Category);

        // Reports every header cell that names a column as wanting one width, and the container as giving the width asked for.
        private static ColumnFitReport CreateFitReport(IRenderedComponent<IComponent> cut, double availableWidth, double columnWidth = 100)
            => new(availableWidth, [.. cut.FindAll("thead th[data-column]").Select(cell => new ColumnWidth(cell.GetAttribute("data-column")!, columnWidth))]);

        private static Task FitAsync(IRenderedComponent<IComponent> cut, double availableWidth, double columnWidth = 100)
        {
            var grid = cut.FindComponent<FormaDataGrid<GridItem>>().Instance;

            return cut.InvokeAsync(() => grid.HandleColumnFitAsync(CreateFitReport(cut, availableWidth, columnWidth)));
        }

        private static IReadOnlyList<string> GetHeaderTitles(IRenderedComponent<IComponent> cut)
