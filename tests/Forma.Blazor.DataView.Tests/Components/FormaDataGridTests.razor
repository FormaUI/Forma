        [Fact]
        public async Task Should_re_query_the_data_source_when_refresh_is_requested()
        {
            // Arrange
            using var ctx = new FormaDataGridTests();
            var calls = 0;
            DataViewItemsProvider<GridItem> provider = _ =>
            {
                calls++;
                return ValueTask.FromResult(new DataViewPage<GridItem>(CreateItems(3).ToArray(), 3));
            };

            var cut = ctx.Render(
                @<FormaDataView ItemsProvider="provider" PageSize="10">
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(item => item.Title)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => calls > 0);
            var before = calls;
            var grid = cut.FindComponent<FormaDataView<GridItem>>().Instance;

            // Act
            await cut.InvokeAsync(grid.RefreshDataAsync);

            // Assert
            Assert.True(calls > before);
        }

