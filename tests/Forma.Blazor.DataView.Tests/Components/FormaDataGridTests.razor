            cut.WaitForState(() => cut.Markup.Contains("Bob", StringComparison.Ordinal));
            var grid = cut.FindComponent<FormaDataGrid<Employee>>();
            await cut.InvokeAsync(() => grid.Instance.BeginEdit(employees[0]));

            // Act
            cut.Find("tbody input").Input("Alicia");
            await cut.InvokeAsync(() => grid.Instance.SaveEditAsync());

            // Assert
            Assert.Equal("Alicia", saved!.Name);
            Assert.Equal("Alice", employees[0].Name);
            Assert.Null(grid.Instance.EditingItem);
        }

        [Fact]
        public async Task Should_keep_the_row_open_and_report_nothing_when_validation_fails()
        {
