            await cut.Find("thead input[type=checkbox]").ClickAsync(new MouseEventArgs());

            // Assert
            Assert.Equal(20, changedTo!.Count);
        }

        // A cell that says each time a row draws it, so what a change draws again can be read.
        private static string Draw(Dictionary<int, int> drawn, GridItem item)
        {
            drawn[item.Id] = drawn.GetValueOrDefault(item.Id) + 1;

            return item.Title;
        }

        private static IReadOnlyList<int> DrawnSince(Dictionary<int, int> drawn, Dictionary<int, int> before)
            => [.. drawn.Where(entry => entry.Value != before.GetValueOrDefault(entry.Key)).Select(entry => entry.Key).Order()];

