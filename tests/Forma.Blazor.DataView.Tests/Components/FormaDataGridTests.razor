            var cut = ctx.Render(
                @<FormaDataView Items="employees.AsQueryable()" PageSize="10">
                    <FormaDataGrid TItem="Employee" EnableInlineEditing="true" CloneForEdit="Clone" OnRowSave="@((Employee _) => saved = true)">
                        <Columns>
                            <FormaPropertyColumn Property="@(employee => employee.Name)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => cut.Markup.Contains("Bob", StringComparison.Ordinal));
            var grid = cut.FindComponent<FormaDataGrid<Employee>>();
            await cut.InvokeAsync(() => grid.Instance.BeginEdit(employees[0]));

            // Act
            cut.Find("tbody input").Input(string.Empty);
            var accepted = await cut.InvokeAsync(() => grid.Instance.SaveEditAsync());

            // Assert
            Assert.False(accepted);
            Assert.False(saved);
            Assert.NotNull(grid.Instance.EditingItem);
        }

