            using var ctx = new FormaDataGridTests();
            IReadOnlyList<GridItem>? changedTo = null;
            var cut = ctx.Render(
                @<FormaDataView Items="CreateItems(25)" PageSize="10" EnableCheckedSelection="true" SelectedItemsChanged="@((IReadOnlyList<GridItem> selected) => changedTo = selected)">
                    <FormaDataGrid>
