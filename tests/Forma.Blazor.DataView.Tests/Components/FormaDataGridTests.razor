        [Fact]
        public void Should_ask_a_provider_for_each_group_s_size_while_virtualizing()
        {
            // Arrange
            using var ctx = new FormaDataGridTests();
            var asked = false;
            DataViewItemsProvider<Product> provider = request =>
            {
                var sorted = request.ApplySorting(CreateProducts());
                asked |= request.IncludesGroupSizes;

                return ValueTask.FromResult(new DataViewPage<Product>([.. sorted.Skip(request.StartIndex).Take(request.Count ?? 6)], 6)
                {
                    GroupSizes = request.IncludesGroupSizes ? [.. request.CountGroups(CreateProducts())] : null,
                });
            };

            // Act
            var cut = ctx.Render(
                @<FormaDataView TItem="Product" ItemsProvider="provider" EnablePagination="false" Virtualize="true" OverscanCount="10" GroupBy="@(DataViewGrouping<Product>.ByDescending(product => product.Category))">
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(item => item.Title)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("tr.forma-data-grid-row").Count == 6);

            // Assert
            Assert.Multiple(
                () => Assert.True(asked),
                () => Assert.Equal(["Tools", "Books"], cut.FindAll(".forma-data-grid-group-name").Select(name => name.TextContent)));
        }

