        [Fact]
        public void Should_push_the_host_s_input_policy_before_attaching_row_selection()
        {
            // Arrange
            using var ctx = new FormaDataGridTests();

            // Act
            ctx.Render(
                @<FormaDataView Items="CreateItems(3)" PageSize="10" EnableItemSelection="true">
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(item => item.Title)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);

            // Assert
            var identifiers = ctx.JSInterop.Invocations.Select(invocation => invocation.Identifier).ToList();
            Assert.Multiple(
                () => Assert.Contains("configure", identifiers),
                () => Assert.True(identifiers.IndexOf("configure") < identifiers.IndexOf("attach")));
        }

        [Fact]
        public async Task Should_activate_an_item_from_enter_on_its_box_under_checked_selection()
        {
            // Arrange
            using var ctx = new FormaDataGridTests();
            GridItem? clicked = null;
            var cut = ctx.Render(
                @<FormaDataView Items="CreateItems(3)" PageSize="10" EnableCheckedSelection="true" OnItemClick="@((GridItem item) => clicked = item)">
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(item => item.Title)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            var box = cut.FindAll("tbody input[data-row-key]")[1];
            var token = int.Parse(box.GetAttribute("data-row-key")!, CultureInfo.InvariantCulture);

            // Act — Enter on the box, as the selection behavior reports it
            await cut.InvokeAsync(() => cut.FindComponent<FormaDataView<GridItem>>().Instance.HandleActivateAsync(token));

            // Assert
            Assert.Equal(2, clicked!.Id);
            Assert.Contains(ctx.JSInterop.Invocations, invocation => invocation.Identifier == "attach");
        }

        [Fact]
        public void Should_attach_selection_again_when_the_selection_changes_from_checked_to_items()
        {
            // Arrange — the behavior hands back a handle, so the grid holds it as attached
            using var ctx = new FormaDataGridTests();
            var selection = ctx.JSInterop.SetupModule("./_content/Forma.Blazor.DataView/scripts/SelectionInteraction.js");
            selection.SetupModule("attach", _ => true);
            var cut = ctx.Render(
                @<FormaDataView Items="CreateItems(3)" PageSize="10" EnableCheckedSelection="true">
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(item => item.Title)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);

            // Act
            cut.FindComponent<FormaDataView<GridItem>>().Render(parameters => parameters
                .Add(view => view.EnableCheckedSelection, false)
                .Add(view => view.EnableItemSelection, true));

            // Assert — attached for activation alone, then again to select
            var selects = selection.Invocations.Where(invocation => invocation.Identifier == "attach")
                .Select(invocation => invocation.Arguments[1]!.GetType().GetProperty("selects")!.GetValue(invocation.Arguments[1]))
                .ToList();
            Assert.Equal([false, true], selects);
        }

        [Fact]
        public void Should_attach_selection_again_to_move_among_the_boxes_once_they_are_drawn()
        {
            // Arrange — the behavior hands back a handle, so the grid holds it as attached
            using var ctx = new FormaDataGridTests();
            var selection = ctx.JSInterop.SetupModule("./_content/Forma.Blazor.DataView/scripts/SelectionInteraction.js");
            selection.SetupModule("attach", _ => true);
            var cut = ctx.Render(
                @<FormaDataView Items="CreateItems(3)" PageSize="10">
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(item => item.Title)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);

            // Act
            cut.FindComponent<FormaDataView<GridItem>>().Render(parameters => parameters.Add(view => view.EnableCheckedSelection, true));

            // Assert — attached with no marker to move among, then again to move among the boxes without selecting
            var attached = selection.Invocations.Where(invocation => invocation.Identifier == "attach")
                .Select(invocation => invocation.Arguments[1]!)
                .Select(options => (Selects: (bool)options.GetType().GetProperty("selects")!.GetValue(options)!, Moves: (bool)options.GetType().GetProperty("moves")!.GetValue(options)!))
                .ToList();
            Assert.Equal([(false, false), (false, true)], attached);
        }

        private static IQueryable<GridItem> CreateItems(int count) => Enumerable.Range(1, count)
            .Select(id => new GridItem(id, $"Item {id}"))
            .AsQueryable();

        // Six products in two categories, listed with the categories interleaved so only a grouping brings each together.
        private static IQueryable<Product> CreateProducts() => new[]
        {
            new Product(1, "Hammer", "Tools"),
            new Product(2, "Atlas", "Books"),
            new Product(3, "Wrench", "Tools"),
            new Product(4, "Primer", "Books"),
            new Product(5, "Saw", "Tools"),
            new Product(6, "Reader", "Books"),
        }.AsQueryable();

        [Fact]
        public void Should_draw_a_heading_with_the_name_and_count_over_each_group()
        {
            // Arrange
            using var ctx = new FormaDataGridTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView TItem="Product" Items="CreateProducts()" EnablePagination="false" GroupBy="@(DataViewGrouping<Product>.By(product => product.Category))">
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(item => item.Title)" Sortable="true" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("tbody.forma-data-grid-group").Count == 2);

            // Assert — the groups come smallest key first
            var groups = cut.FindAll("tbody.forma-data-grid-group");
            Assert.Multiple(
                () => Assert.Equal("Books", groups[0].QuerySelector(".forma-data-grid-group-name")!.TextContent),
                () => Assert.Equal("3", groups[0].QuerySelector(".forma-data-grid-group-count")!.TextContent),
                () => Assert.Equal("rowgroup", groups[0].QuerySelector("th")!.GetAttribute("scope")),
                () => Assert.Equal("true", groups[0].QuerySelector("button")!.GetAttribute("aria-expanded")),
                () => Assert.Equal(3, groups[0].QuerySelectorAll("tr.forma-data-grid-row").Length),
                () => Assert.Equal("Tools", groups[1].QuerySelector(".forma-data-grid-group-name")!.TextContent));
