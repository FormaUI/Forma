[*.{cs,razor}]
# ------------------------------------------------------------
# Diagnostics that do not apply to test sources
# ------------------------------------------------------------

# Disable IDE0017 and IDE0028 - Arrange builds the subject and Act mutates it, so folding the
# two together is not an improvement.
dotnet_diagnostic.IDE0017.severity = none
dotnet_diagnostic.IDE0028.severity = none

[*Fixture.cs]
dotnet_diagnostic.CA1822.severity = none

[unit/Framework/Forma.Framework.Culture.Router.Tests/Support/FakeRenderer.cs]
# Disable BL0006 - a renderer fake derives from Renderer and takes its RenderBatch, both in the RenderTree namespace,
# since a Framework test reaches an interactive renderer no other way.
dotnet_diagnostic.BL0006.severity = none

# End of .editorconfig
