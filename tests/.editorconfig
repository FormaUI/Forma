[*.{cs,razor}]
# ------------------------------------------------------------
# Diagnostics that do not apply to test sources
# ------------------------------------------------------------

# Disable IDE0017 and IDE0028 - Arrange builds the subject and Act mutates it, so folding the
# two together is not an improvement.
dotnet_diagnostic.IDE0017.severity = none
dotnet_diagnostic.IDE0028.severity = none

[{*Tests.cs,*Tests.*.cs}]
# ------------------------------------------------------------
# Disable specific diagnostics that are not relevant or too noisy in test projects
# ------------------------------------------------------------

# Disable CA2007 - xUnit1030 conflicts with ConfigureAwait(false)
dotnet_diagnostic.CA2007.severity = none

# Disable CA1707 - Identifiers should not contain underscores (test method names)
dotnet_diagnostic.CA1707.severity = none

# Disable IDE0022 - Use expression body for methods (test readability)
dotnet_diagnostic.IDE0022.severity = none

# Disable CA1062 - Validate arguments of public methods (test methods don't need null checks)
dotnet_diagnostic.CA1062.severity = none

# ------------------------------------------------------------
# ReSharper
# ------------------------------------------------------------

# Disable "Class is never instantiated" warning in test projects
resharper_class_never_instantiated_global_highlighting = none

[*Fixture.cs]
dotnet_diagnostic.CA1822.severity = none

[Forma.Tests.Support/Shared/FakeRenderer.cs]
# Disable BL0006 - a renderer fake derives from Renderer and takes its RenderBatch, both in the RenderTree namespace,
# since a Framework test reaches an interactive renderer no other way.
dotnet_diagnostic.BL0006.severity = none

# End of .editorconfig
