@page "/date-picker"
@attribute [ShowcasePage("SiteDatePicker")]
@rendermode InteractiveServer
@using Site.UI.Components.Admin.Forms
@inject IStringLocalizer<SiteDatePickerPage> L

<h1>SiteDatePicker</h1>
<p class="desc">@L["Date.Description"]</p>

<div class="demo-section">
    <h2>@L["Date.Section.Basic"]</h2>
    <div class="demo-box">
        <SiteDatePicker @bind-Value="_singleDate" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Date.Section.WithLabel"]</h2>
    <div class="demo-box">
        <SiteDatePicker @bind-Value="_labelDate"
                       Label="@L["Date.Label.Start"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Date.Section.DualView"]</h2>
    <div class="demo-box">
        <SiteDatePicker @bind-StartDate="_dualStart"
                       @bind-EndDate="_dualEnd"
                       Label="@L["Date.Label.DualView"]"
                       ShowPresets="false" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Date.Section.Range"]</h2>
    <div class="demo-box">
        <SiteDatePicker @bind-StartDate="_rangeStart"
                       @bind-EndDate="_rangeEnd"
                       Label="@L["Date.Label.Range"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Date.Section.WithMin"]</h2>
    <div class="demo-box">
        <SiteDatePicker @bind-Value="_futureDate"
                       Label="@L["Date.Label.Future"]"
                       MinDate="@DateOnly.FromDateTime(DateTime.Today)" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Date.Section.PreFilled"]</h2>
    <div class="demo-box">
        <SiteDatePicker @bind-Value="_preFilled"
                       Label="@L["Date.Label.PreFilled"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Date.Section.Hebrew"]</h2>
    <p class="desc">@L["Date.Section.Hebrew.Desc"]</p>
    <div class="demo-box">
        <SiteDatePicker @bind-StartDate="_hebrewStart"
                       @bind-EndDate="_hebrewEnd"
                       Label="@L["Date.Label.Hebrew"]"
                       UseNonGregorianMonths="true" />
    </div>
</div>

@code {
    private DateOnly? _singleDate;
    private DateOnly? _labelDate;
    private DateOnly? _dualStart;
    private DateOnly? _dualEnd;
    private DateOnly? _rangeStart;
    private DateOnly? _rangeEnd;
    private DateOnly? _futureDate;
    private DateOnly? _preFilled = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _hebrewStart;
    private DateOnly? _hebrewEnd;
}
