  <data name="Date.Section.DualView" xml:space="preserve"><value>Vista doble (dos meses)</value></data>
  <data name="Date.Label.DualView" xml:space="preserve"><value>Elija una fecha</value></data>
  <data name="Date.Section.Range" xml:space="preserve"><value>Intervalo de fechas con valores predefinidos</value></data>
  <data name="Date.Section.WithMin" xml:space="preserve"><value>Con fecha mínima</value></data>
  <data name="Date.Section.PreFilled" xml:space="preserve"><value>Precargado</value></data>
