@page "/tabs"
@attribute [ShowcasePage("SiteTabs")]
@rendermode InteractiveServer
@using Site.UI.Components.Admin.Layout
@inject IStringLocalizer<SiteTabsPage> L

<h1>SiteTabs</h1>
<p class="desc">@L["Tabs.Description"]</p>

<div class="demo-section">
    <h2>@L["Tabs.Section.Basic"]</h2>
    <div class="demo-box">
        <SiteTabs>
            <SiteTab Title="@L["Tabs.Tab.General"]">
                <p>@L["Tabs.Content.General"]</p>
            </SiteTab>
            <SiteTab Title="@L["Tabs.Tab.SEO"]">
                <p>@L["Tabs.Content.SEO"]</p>
            </SiteTab>
            <SiteTab Title="@L["Tabs.Tab.Images"]">
                <p>@L["Tabs.Content.Images"]</p>
            </SiteTab>
        </SiteTabs>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Tabs.Section.WithIcons"]</h2>
    <div class="demo-box">
        <SiteTabs>
            <SiteTab Title="@L["Tabs.Tab.Settings"]" Icon="@(SiteIcon.FontAwesome("gear"))">
                <p>@L["Tabs.Content.Settings"]</p>
            </SiteTab>
            <SiteTab Title="@L["Tabs.Tab.Users"]" Icon="@(SiteIcon.FontAwesome("users"))">
                <p>@L["Tabs.Content.Users"]</p>
            </SiteTab>
            <SiteTab Title="@L["Tabs.Tab.Billing"]" Icon="@(SiteIcon.FontAwesome("credit-card"))">
                <p>@L["Tabs.Content.Billing"]</p>
            </SiteTab>
        </SiteTabs>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Tabs.Section.Many"]</h2>
    <div class="demo-box">
        <SiteTabs>
            <SiteTab Title="@L["Tabs.Tab.Tab1"]"><p>@L["Tabs.Content.Tab1"]</p></SiteTab>
            <SiteTab Title="@L["Tabs.Tab.Tab2"]"><p>@L["Tabs.Content.Tab2"]</p></SiteTab>
            <SiteTab Title="@L["Tabs.Tab.Tab3"]"><p>@L["Tabs.Content.Tab3"]</p></SiteTab>
            <SiteTab Title="@L["Tabs.Tab.Tab4"]"><p>@L["Tabs.Content.Tab4"]</p></SiteTab>
            <SiteTab Title="@L["Tabs.Tab.Tab5"]"><p>@L["Tabs.Content.Tab5"]</p></SiteTab>
        </SiteTabs>
    </div>
</div>
