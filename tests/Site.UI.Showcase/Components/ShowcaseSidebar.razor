@using System.Globalization
@using System.Reflection
@using Site.UI.Showcase
@inject NavigationManager Nav

<nav class="showcase-sidebar">
    <div class="culture-switcher">
        <a href="@CultureLink("he")" data-enhance-nav="false" @onclick="SwitchToHebrew" class="@(IsCurrentCulture("he") ? "active" : "")">עב</a>
        <a href="@CultureLink("en")" data-enhance-nav="false" @onclick="SwitchToEnglish" class="@(IsCurrentCulture("en") ? "active" : "")">En</a>
    </div>
    @foreach (var group in PageGroups)
    {
        <h3>@group.Key</h3>
        @foreach (var entry in group)
        {
            <NavLink href="@($"{Culture}{entry.Route}")" Match="NavLinkMatch.Prefix">@entry.Title</NavLink>
        }
    }
</nav>

@code {
    private record ShowcasePage(string Title, string Category, string Route);

    private static readonly ILookup<string, ShowcasePage> PageGroups = DiscoverPages();

    private string Culture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private static ILookup<string, ShowcasePage> DiscoverPages()
    {
        return typeof(Program).Assembly.GetTypes()
            .Select(t => (Type: t, Attr: t.GetCustomAttribute<ShowcasePageAttribute>(), Route: t.GetCustomAttribute<RouteAttribute>()?.Template))
            .Where(x => x.Attr is not null && x.Route is not null)
            .Select(x =>
            {
                var ns = x.Type.Namespace ?? "";
                var tag = ns.Contains('.') ? ns[(ns.LastIndexOf('.') + 1)..] : ns;
                return new ShowcasePage(x.Attr!.Title, tag, x.Route!);
            })
            .OrderBy(p => p.Category)
            .ThenBy(p => p.Title)
            .ToLookup(p => p.Category);
    }

    private bool IsCurrentCulture(string culture) =>
        string.Equals(Culture, culture, StringComparison.OrdinalIgnoreCase);

    private string CultureLink(string culture)
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        return $"/{culture}{(path == "/" ? "" : path)}";
    }

    private void SwitchToHebrew() => Nav.NavigateTo(CultureLink("he"), forceLoad: true);
    private void SwitchToEnglish() => Nav.NavigateTo(CultureLink("en"), forceLoad: true);
}
