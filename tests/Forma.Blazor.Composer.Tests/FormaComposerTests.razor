        [Fact]
        public void Should_lose_no_command_when_a_non_action_item_takes_part_of_the_inline_limit()
        {
            // Arrange
            using var ctx = new FormaComposerTests();
            var model = new TestModel();
            var surplus = FormaComposerPluginsBar.InlineLimit + 3;
            var plugins = ComposerDefinition.Create(composer => composer.AddFeaturePlugin(_ => new MenuThenCommandsPlugin(surplus)));

            // Act
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="plugins" />);
            cut.Find("button[aria-label='Plugin Commands']").Click();
            cut.Find("button[aria-label='More Plugin Commands']").Click();

            // Assert
            var shown = cut.Find(".forma-composer-plugins-row")
                           .QuerySelectorAll(".forma-toggle-button")
                           .Select(button => button.GetAttribute("aria-label"));
            var overflowed = cut.FindAll("[role=menuitem]").Select(item => item.TextContent.Trim());
            Assert.Equal(surplus, shown.Concat(overflowed).Distinct().Count(name => name?.StartsWith("Command ", StringComparison.Ordinal) == true));
        }

