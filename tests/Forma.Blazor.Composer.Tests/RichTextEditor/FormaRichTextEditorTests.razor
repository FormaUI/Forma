@using Forma.Blazor.Components.Composer.Plugins
@using Forma.Framework.Composer.Interop
@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        private sealed class TestModel
        {
            public ComposerDocument Body { get; set; } = new(ComposerDocumentFormat.Html, "<p>Initial Text</p>");
        }

        private static readonly ComposerDefinition RichText =
            ComposerDefinition.Create(composer => composer.AddRichTextEditor());

        private static readonly ComposerDefinition RichTextWithFormatting = ComposerDefinition.Create(composer => composer
            .AddRichTextEditor(editor => editor.AddFeaturePlugin<BasicFormattingPlugin>()));

        private static readonly ComposerDefinition RichTextWithSelectionBar = ComposerDefinition.Create(composer => composer
            .AddRichTextEditor(editor => editor.AddFeaturePlugin<BasicFormattingPlugin>())
            .AddFeaturePlugin<SelectionBarPlugin>());

        [Fact]
        public void Should_render_contenteditable_canvas()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            var model = new TestModel();

            // Act
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichText" />);

            // Assert
            var canvas = cut.Find(".forma-composer-rich-text-canvas");
            Assert.True(canvas.HasAttribute("contenteditable"));
            Assert.Equal("textbox", canvas.GetAttribute("role"));
        }

        [Fact]
        public void Should_disable_contenteditable_when_disabled()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            var model = new TestModel();

            // Act
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Disabled="true" Plugins="RichText" />);

            // Assert
            var canvas = cut.Find(".forma-composer-rich-text-canvas");
            Assert.Equal("false", canvas.GetAttribute("contenteditable"));
        }

        [Fact]
        public void Should_make_contenteditable_readonly_when_readonly()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            var model = new TestModel();

            // Act
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" ReadOnly="true" Plugins="RichText" />);

            // Assert
            var canvas = cut.Find(".forma-composer-rich-text-canvas");
            Assert.Equal("false", canvas.GetAttribute("contenteditable"));
        }

        [Fact]
        public void Should_render_the_selection_bar_with_the_commands_plugins_placed_on_it()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            var model = new TestModel();
            var editor = new RichTextEditorPlugin();

            // Act
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichTextWithFormatting" />);

            // Assert
            var menu = cut.Find(".forma-composer-selection-bar");
            Assert.Multiple(() =>
            {
                Assert.NotNull(menu.QuerySelector("[role='toolbar']"));
                Assert.NotNull(menu.QuerySelector(".forma-composer-selection-bar-handle"));
                Assert.Equal(4, menu.QuerySelectorAll("[role='toolbar'] button").Length);
            });
        }

        // A screen reader hears the formatting a shortcut or a button changed, which the canvas itself never says.
        [Fact]
        public void Should_announce_a_formatting_a_command_turned_on()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            var canvas = ctx.JSInterop.SetupModule("./_content/forma/composer/scripts/RichTextEditor.js").SetupModule("attach", _ => true);
            canvas.Setup<RichTextCommandResult>("exec", _ => true)
                .SetResult(new RichTextCommandResult("<p><strong>Initial Text</strong></p>", new RichTextSelectionDto(0, 0, true, "p", ["bold"])));
            var model = new TestModel();
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichTextWithFormatting" />);

            // Act
            cut.Find("button[aria-label='Bold']").Click();

            // Assert
            cut.WaitForAssertion(() => Assert.Equal("Bold on", cut.Find(".forma-composer-rich-text-announcer").TextContent));
        }

        [Fact]
        public void Should_render_no_selection_bar_while_the_engine_hides_it()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            var model = new TestModel();
            var editor = new RichTextEditorPlugin();
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichTextWithSelectionBar" />);
            var composer = cut.FindComponent<FormaComposer>().Instance;
            Assert.NotNull(cut.Find(".forma-composer-selection-bar"));

            // Act
            cut.InvokeAsync(() => composer.HandleCommandAsync(ComposerCommands.SelectionBar));

            // Assert
            cut.WaitForAssertion(() => Assert.Empty(cut.FindAll(".forma-composer-selection-bar")));
        }

        [Fact]
        public void Should_render_no_selection_bar_when_no_plugin_placed_anything_on_it()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            var model = new TestModel();

            // Act
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichText" />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-composer-selection-bar"));
        }
    }
}
