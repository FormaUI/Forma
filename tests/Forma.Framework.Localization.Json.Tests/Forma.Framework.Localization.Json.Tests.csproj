<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>Forma.Framework.Localization.Json.Tests</RootNamespace>
        <NoWarn>CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="xunit.v3" Version="3.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Forma.Framework.Localization.Json\Forma.Framework.Localization.Json.csproj" />
        <ProjectReference Include="..\Forma.Tests.Support\Forma.Tests.Support.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Fixtures\**\*.json" />
        <!-- The same relative tree under a root, which is what ResourcesPath resolves against. -->
        <EmbeddedResource Include="Resources\**\*.json" />
        <!-- Kept in the main assembly to cover the layout a project gets by opting out of satellites. -->
        <EmbeddedResource Update="Fixtures\MainAssembly.he.json" WithCulture="false" />
        <!-- Embedded under the type's own namespace, which an assembly named apart from its root produces. -->
        <EmbeddedResource Update="Fixtures\Foreign\ForeignRoot.he.json" LogicalName="Contoso.Widgets.ForeignRoot.he.json" WithCulture="false" />
        <!-- A type outside any namespace, whose resource the root namespace alone qualifies. -->
        <EmbeddedResource Update="Fixtures\GlobalRoot.he.json" LogicalName="Forma.Framework.Localization.Json.Tests.GlobalRoot.he.json" WithCulture="false" />
    </ItemGroup>

    <!-- The host's own files, copied beside the test assembly, where the default locales folder is looked for. -->
    <ItemGroup>
        <Content Include="locales\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
