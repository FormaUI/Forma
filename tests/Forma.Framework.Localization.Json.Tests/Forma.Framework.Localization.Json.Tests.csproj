<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Forma.Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\..\src\Forma.Framework\Forma.Framework.Localization.Json\Forma.Framework.Localization.Json.csproj" />
        <ProjectReference Include="..\Forma.Tests.Support\Forma.Tests.Support.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Fixtures\**\*.json" />
        <!-- Files gathered under a folder of their own, which a path in the config file reads by the type's name. -->
        <EmbeddedResource Include="Resources\**\*.json" />
        <!-- A file beside its type, kept in the main assembly to cover the layout a project gets by opting out of satellites. -->
        <EmbeddedResource Update="Fixtures\Beside\MainAssembly.he.json" WithCulture="false" />
        <!-- Embedded under the type's own namespace, which an assembly named apart from its root produces. -->
        <EmbeddedResource Update="Fixtures\Foreign\ForeignRoot\.locales\he.json" LogicalName="Contoso.Widgets.ForeignRoot..locales.he.json" />
        <!-- A type outside any namespace, whose resource the root namespace alone qualifies. -->
        <EmbeddedResource Update="Fixtures\GlobalRoot\.locales\he.json" LogicalName="Forma.Framework.Localization.Json.Tests.GlobalRoot..locales.he.json" />
    </ItemGroup>

    <!-- The host's own files, copied beside the test assembly, where the default folder is looked for. -->
    <ItemGroup>
        <Content Include=".locales\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Host folders a test names in place of the default one, each configured its own way. -->
    <ItemGroup>
        <Content Include="Hosts\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
