        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<ICatalogProvider>(_ => new StubLibrary(Clip));
            var options = new ExplorerPluginOptions { InsertMode = MediaInsertMode.Both };
            var cut = ctx.Render(@<FormaComposerExplorerDialog Options="options" />);
            await ChooseAsync(cut, "finish.mp4");

            // Act
            var insertion = await ConfirmAsync(cut);

            // Assert
            Assert.NotNull(insertion);
            Assert.Multiple(
                () => Assert.Equal("video", insertion.Kind),
                () => Assert.True(insertion.Embed),
                () => Assert.True(insertion.Link));
        }

        [Fact]
        public async Task Should_link_a_file_the_browser_cannot_render_whatever_the_mode_says()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<ICatalogProvider>(_ => new StubLibrary(Report));
            var options = new ExplorerPluginOptions { InsertMode = MediaInsertMode.Embed };
            var cut = ctx.Render(@<FormaComposerExplorerDialog Options="options" />);
            await ChooseAsync(cut, "report.pdf");

            // Act
            var insertion = await ConfirmAsync(cut);

            // Assert
            Assert.NotNull(insertion);
            Assert.Multiple(
