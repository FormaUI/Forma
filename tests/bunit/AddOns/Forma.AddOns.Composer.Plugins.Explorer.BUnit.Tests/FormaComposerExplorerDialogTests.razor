        [Fact]
        public async Task Should_embed_a_picture_and_not_link_it_by_default()
        {
            // Arrange
            using var ctx = new FormaComposerExplorerDialogTests();
            ctx.Services.AddScoped<ICatalogProvider>(_ => new StubLibrary(Picture));
            var cut = ctx.Render(@<FormaComposerExplorerDialog />);
