@code {
    // Chooses the file the card showing the name stands for, by the box the explorer's selection draws on it, once the click has ended.
    private static Task ChooseAsync(IRenderedComponent<ContainerFragment> cut, string name)
        => cut.FindAll(".forma-data-card")
            .Single(card => card.QuerySelector(".forma-data-card-name")?.TextContent == name)
            .QuerySelector("input[type=checkbox]")!
            .ClickAsync(new MouseEventArgs());

    // The card showing the name.
    private static AngleSharp.Dom.IElement FindCard(IRenderedComponent<ContainerFragment> cut, string name)
        => cut.FindAll(".forma-data-card").Single(card => card.QuerySelector(".forma-data-card-name")?.TextContent == name);

    // The token the card showing the name carries, by which the selection behavior reports a press or Enter on it.
    private static int GetCardToken(IRenderedComponent<ContainerFragment> cut, string name)
        => int.Parse(FindCard(cut, name).GetAttribute("data-item")!, System.Globalization.CultureInfo.InvariantCulture);

    public sealed class Component
    {
        private sealed class StubLibrary(params ResourceInfo[] resources) : ICatalogProvider
        {
            public ValueTask<CatalogPage> GetItemsAsync(CatalogQuery query, CancellationToken cancellationToken)
                => ValueTask.FromResult(new CatalogPage(CatalogItem.ForAll(resources), resources.Length));
        }

        private static readonly ResourceInfo Picture = new ImageResourceInfo("/media/podium.png");
        private static readonly ResourceInfo Clip = new VideoResourceInfo("/media/finish.mp4");
        private static readonly ResourceInfo Report = new DocumentResourceInfo("/media/report.pdf");

        private static IComposerInsertionDialog GetBody(IRenderedComponent<ContainerFragment> cut)
            => cut.FindComponent<FormaComposerExplorerDialog>().Instance;

        private static async Task<ResourceInsertion?> ConfirmAsync(IRenderedComponent<ContainerFragment> cut)
            => await GetBody(cut).TryConfirmAsync(TestContext.Current.CancellationToken) as ResourceInsertion;

        [Fact]
        public void Should_title_itself_for_the_dialog_that_hosts_it()
