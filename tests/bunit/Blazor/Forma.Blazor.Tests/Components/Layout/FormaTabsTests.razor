    public sealed class SelectionById
    {
        [Fact]
        public void Should_activate_the_tab_the_caller_named()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs ActiveTabId="second">
                    <FormaTab TabId="first" Title="First">Content 1</FormaTab>
                    <FormaTab TabId="second" Title="Second">Content 2</FormaTab>
                </FormaTabs>);

            // Assert
            var active = cut.FindAll(".forma-tab-button.active");
            Assert.Single(active);
            Assert.Contains("Second", active[0].TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public async Task Should_report_the_identifier_the_caller_gave_the_tab()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            string? reported = null;
            var cut = ctx.Render(
                @<FormaTabs ActiveTabId="first" ActiveTabIdChanged="id => reported = id">
                    <FormaTab TabId="first" Title="First">Content 1</FormaTab>
                    <FormaTab TabId="second" Title="Second">Content 2</FormaTab>
                </FormaTabs>);

            // Act
            await cut.FindAll(".forma-tab-button")[1].ClickAsync(new());

            // Assert
            Assert.Equal("second", reported);
        }

        [Fact]
        public void Should_reject_a_tab_with_no_identifier_when_the_caller_selects_by_one()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act & Assert
            Assert.Throws<InvalidOperationException>(() => ctx.Render(
                @<FormaTabs ActiveTabId="first">
                    <FormaTab TabId="first" Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>));
        }

        [Fact]
        public void Should_reject_a_tab_with_no_identifier_when_the_caller_only_observes()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act & Assert
            Assert.Throws<InvalidOperationException>(() => ctx.Render(
                @<FormaTabs ActiveTabIdChanged="_ => { }">
                    <FormaTab Title="First">Content 1</FormaTab>
                </FormaTabs>));
        }

        [Fact]
        public void Should_reject_a_registered_tab_with_no_identifier_once_the_caller_starts_selecting()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                </FormaTabs>);

            // Act & Assert
            Assert.Throws<InvalidOperationException>(
                () => cut.FindComponent<FormaTabs>().Render(parameters => parameters.Add(p => p.ActiveTabId, "first")));
        }
    }

    public sealed class Keyboard
    {
        [Fact]
        public void Should_route_the_arrows_home_and_end_on_the_tab_list()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            var router = new InputRouterProbe(ctx);

            // Act
            ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>);

            // Assert
            var registration = Assert.Single(router.Registrations);
            Assert.Equal(["tabs.next:ArrowRight", "tabs.previous:ArrowLeft", "tabs.first:Home", "tabs.last:End"], InputRouterProbe.GetRoutes(registration));
        }

        [Fact]
        public void Should_swap_the_arrows_under_right_to_left()
        {
            // Arrange
            using var culture = new CultureFixture("he");
            using var ctx = new FormaTabsTests();
            var router = new InputRouterProbe(ctx);

            // Act
            ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>);

            // Assert
            var registration = Assert.Single(router.Registrations);
            Assert.Equal(["tabs.next:ArrowLeft", "tabs.previous:ArrowRight", "tabs.first:Home", "tabs.last:End"], InputRouterProbe.GetRoutes(registration));
        }

        [Fact]
        public void Should_give_only_the_active_tab_a_place_in_the_tab_order()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>);

            // Assert
            var buttons = cut.FindAll(".forma-tab-button");
            Assert.Multiple(
                () => Assert.Equal("0", buttons[0].GetAttribute("tabindex")),
                () => Assert.Equal("-1", buttons[1].GetAttribute("tabindex")));
        }

        [Fact]
        public void Should_keep_the_first_tab_in_the_tab_order_when_the_caller_names_no_tab()
        {
            // Arrange
            using var ctx = new FormaTabsTests();

            // Act
            var cut = ctx.Render(
                @<FormaTabs ActiveTabId="missing">
                    <FormaTab Title="First" TabId="first">Content 1</FormaTab>
                    <FormaTab Title="Second" TabId="second">Content 2</FormaTab>
                </FormaTabs>);

            // Assert
            var buttons = cut.FindAll(".forma-tab-button");
            Assert.Multiple(
                () => Assert.Equal("0", buttons[0].GetAttribute("tabindex")),
                () => Assert.Equal("-1", buttons[1].GetAttribute("tabindex")));
        }

        [Fact]
        public async Task Should_focus_the_next_tab_without_selecting_it_when_the_router_routes_next()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                    <FormaTab Title="Third">Content 3</FormaTab>
                </FormaTabs>);

            // Act
            await router.RouteAsync("tabs.next", "ArrowRight");

            // Assert
            var buttons = cut.FindAll(".forma-tab-button");
            Assert.Multiple(
                () => Assert.Equal("true", buttons[0].GetAttribute("aria-selected")),
                () => Assert.Equal("false", buttons[1].GetAttribute("aria-selected")),
                () => Assert.Equal("-1", buttons[0].GetAttribute("tabindex")),
                () => Assert.Equal("0", buttons[1].GetAttribute("tabindex")),
                () => Assert.Single(ctx.JSInterop.Invocations, invocation => invocation.Identifier == "Blazor._internal.domWrapper.focus"));
        }

        [Fact]
        public async Task Should_select_the_focused_tab_when_it_is_activated()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                </FormaTabs>);
            await router.RouteAsync("tabs.next", "ArrowRight");

            // Act
            cut.FindAll(".forma-tab-button")[1].Click();

            // Assert
            Assert.Equal("true", cut.FindAll(".forma-tab-button")[1].GetAttribute("aria-selected"));
        }

        [Fact]
        public async Task Should_wrap_from_the_first_tab_to_the_last_on_previous()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                    <FormaTab Title="Third">Content 3</FormaTab>
                </FormaTabs>);

            // Act
            await router.RouteAsync("tabs.previous", "ArrowLeft");

            // Assert
            Assert.Equal("0", cut.FindAll(".forma-tab-button")[2].GetAttribute("tabindex"));
        }

        [Fact]
        public async Task Should_reach_either_end_on_last_and_first()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="First">Content 1</FormaTab>
                    <FormaTab Title="Second">Content 2</FormaTab>
                    <FormaTab Title="Third">Content 3</FormaTab>
                </FormaTabs>);

            // Act
            await router.RouteAsync("tabs.last", "End");
            var afterLast = cut.FindAll(".forma-tab-button")[2].GetAttribute("tabindex");
            await router.RouteAsync("tabs.first", "Home");

            // Assert
            Assert.Multiple(
                () => Assert.Equal("0", afterLast),
                () => Assert.Equal("0", cut.FindAll(".forma-tab-button")[0].GetAttribute("tabindex")));
        }

        [Fact]
        public async Task Should_leave_a_controlled_caller_alone_until_the_focused_tab_is_activated()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            var router = new InputRouterProbe(ctx);
            string? reported = null;
            var cut = ctx.Render(
                @<FormaTabs ActiveTabId="first" ActiveTabIdChanged="id => reported = id">
                    <FormaTab Title="First" TabId="first">Content 1</FormaTab>
                    <FormaTab Title="Second" TabId="second">Content 2</FormaTab>
                </FormaTabs>);

            // Act
            await router.RouteAsync("tabs.next", "ArrowRight");
            var reportedByArrow = reported;
            cut.FindAll(".forma-tab-button")[1].Click();

            // Assert
            Assert.Multiple(
                () => Assert.Null(reportedByArrow),
                () => Assert.Equal("second", reported),
                () => Assert.Equal("true", cut.FindAll(".forma-tab-button")[0].GetAttribute("aria-selected")));
        }

        [Fact]
        public void Should_render_its_tabs_disabled_and_the_active_one_selected_before_the_renderer_is_interactive()
        {
            // Arrange
            using var ctx = new FormaTabsTests();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));

            // Act
            var cut = ctx.Render(
                @<FormaTabs>
                    <FormaTab Title="Tab 1">Content 1</FormaTab>
                    <FormaTab Title="Tab 2">Content 2</FormaTab>
                </FormaTabs>);

            // Assert
            var tabs = cut.FindAll(".forma-tab-button");
            Assert.Multiple(
                () => Assert.All(tabs, tab => Assert.True(tab.HasAttribute("disabled"))),
                () => Assert.Equal(["true", "false"], tabs.Select(tab => tab.GetAttribute("aria-selected"))),
                () => Assert.Contains("Content 1", cut.Markup, StringComparison.Ordinal));
        }
    }
}
