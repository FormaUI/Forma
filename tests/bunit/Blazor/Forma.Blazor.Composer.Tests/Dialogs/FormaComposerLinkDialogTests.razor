@inherits FormaBunitContext
@using Bunit.Rendering
@using Forma.Blazor.Components.Composer.Dialogs
@using Forma.Blazor.Components.Feedback

@code {
    public sealed class Component
    {
        private static void Fill(IRenderedComponent<ContainerFragment> cut, string label, string value)
        {
            var field = cut.FindAll("label.forma-field-label")
                .Single(candidate => candidate.TextContent.Trim().TrimEnd('*', ' ') == label);

            cut.Find($"#{field.GetAttribute("for")}").Input(value);
        }

        private static void Confirm(IRenderedComponent<ContainerFragment> cut)
            => cut.FindAll("button").Single(button => button.TextContent.Trim() == "Insert").Click();

        private static string GetAlert(IRenderedComponent<ContainerFragment> cut)
            => cut.Find(".forma-composer-dialog-error[role=alert]").TextContent.Trim();

        [Fact]
        public void Should_keep_the_modal_open_when_confirming_can_fail()
        {
            // Arrange
            using var ctx = new FormaComposerLinkDialogTests();

            // Act
            var cut = ctx.Render(@<FormaComposerLinkDialog Opened="true" />);

            // Assert
            Assert.False(cut.FindComponent<FormaDialog>().Instance.Options.CloseOnConfirm);
        }

        [Fact]
        public void Should_ask_for_an_address_when_confirmed_empty()
        {
            // Arrange
            using var ctx = new FormaComposerLinkDialogTests();
            var inserted = false;

            // Act
            var cut = ctx.Render(@<FormaComposerLinkDialog Opened="true" OnInsert="_ => inserted = true" />);
            Confirm(cut);

            // Assert
            Assert.False(inserted);
            Assert.Equal("Enter the address of the link before inserting.", GetAlert(cut));
        }

        [Theory]
        [InlineData("javascript:alert(1)")]
        [InlineData("ftp://files.example.com")]
        [InlineData("just some text")]
        public void Should_refuse_an_address_the_document_could_not_keep(string address)
        {
            // Arrange
            using var ctx = new FormaComposerLinkDialogTests();
            var inserted = false;

            // Act
            var cut = ctx.Render(@<FormaComposerLinkDialog Opened="true" OnInsert="_ => inserted = true" />);
            Fill(cut, "URL", address);
            Confirm(cut);

            // Assert
            Assert.False(inserted);
            Assert.Equal(
                "An address has to be a web address, a mail or telephone link, a path within this site, or an inline picture.",
                GetAlert(cut));
        }

        [Theory]
        [InlineData("https://example.com/stage-12")]
        [InlineData("/news/stage-12")]
        [InlineData("#results")]
        [InlineData("mailto:editor@epica.cc")]
        public void Should_insert_an_address_the_document_may_keep(string address)
        {
            // Arrange
            using var ctx = new FormaComposerLinkDialogTests();
            LinkDialogResult? result = null;

            // Act
            var cut = ctx.Render(@<FormaComposerLinkDialog Opened="true" OnInsert="value => result = value" />);
            Fill(cut, "URL", address);
            Confirm(cut);

            // Assert
            Assert.NotNull(result);
            Assert.Equal(address, result.Href);
            Assert.Empty(cut.FindAll(".forma-composer-dialog-error"));
        }

        [Fact]
        public void Should_trim_the_address_before_inserting_it()
        {
            // Arrange
            using var ctx = new FormaComposerLinkDialogTests();
            LinkDialogResult? result = null;

            // Act
            var cut = ctx.Render(@<FormaComposerLinkDialog Opened="true" OnInsert="value => result = value" />);
            Fill(cut, "URL", "  https://example.com  ");
            Confirm(cut);

            // Assert
            Assert.NotNull(result);
            Assert.Equal("https://example.com", result.Href);
        }

        [Fact]
        public void Should_ask_for_a_name_when_an_anchor_is_confirmed_empty()
        {
            // Arrange
            using var ctx = new FormaComposerLinkDialogTests();
            var inserted = false;

            // Act
            var cut = ctx.Render(@<FormaComposerLinkDialog Opened="true" IsAnchor="true" OnInsert="_ => inserted = true" />);
            Confirm(cut);

            // Assert
            Assert.False(inserted);
            Assert.Equal("Enter a name for the anchor before inserting.", GetAlert(cut));
        }

        [Fact]
        public void Should_insert_an_anchor_without_judging_it_as_an_address()
        {
            // Arrange
            using var ctx = new FormaComposerLinkDialogTests();
            LinkDialogResult? result = null;

            // Act
            var cut = ctx.Render(@<FormaComposerLinkDialog Opened="true" IsAnchor="true" OnInsert="value => result = value" />);
            Fill(cut, "Anchor Name", "results");
            Confirm(cut);

            // Assert
            Assert.NotNull(result);
            Assert.True(result.IsAnchor);
            Assert.Equal("results", result.Name);
        }

        [Fact]
        public void Should_name_the_link_after_the_text_the_author_selected()
        {
            // Arrange
            using var ctx = new FormaComposerLinkDialogTests();
            LinkDialogResult? result = null;
            var selected = new LinkDialogResult { IsAnchor = false, Name = "stage twelve", Href = string.Empty, OpenInNewTab = false };

            // Act
            var cut = ctx.Render(@<FormaComposerLinkDialog Opened="true" Reopening="selected" OnInsert="value => result = value" />);
            Fill(cut, "URL", "https://example.com");
            Confirm(cut);

            // Assert
            Assert.NotNull(result);
            Assert.Equal("stage twelve", result.Name);
        }
    }
}
