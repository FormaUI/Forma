@inherits FormaBunitContext
@using Forma.Framework.Browser.Interop.Focus
@using Forma.Framework.Input
@using Forma.Framework.Input.Keyboard
@code {
    public sealed class Component
    {
        private static IReadOnlyList<ToolbarItem> Group(params ToolbarItem[] items)
            => [new ToolbarGroup { Id = "group", Title = "Group", Items = items }];

        [Fact]
        public void Should_render_a_command_as_a_button()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            var groups = Group(new ToolbarCommand { Id = "bold", Title = "Bold", Command = "bold" });

            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="groups" />);

            // Assert
            Assert.Equal("Bold", cut.Find("button").TextContent);
        }

        [Fact]
        public void Should_isolate_the_direction_of_a_command_but_not_of_its_button()
        {
