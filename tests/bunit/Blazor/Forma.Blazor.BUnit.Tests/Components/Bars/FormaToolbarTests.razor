        [Fact]
        public async Task Should_release_its_shortcuts_when_taken_away_while_they_register()
        {
            // Arrange — taken away while its shortcuts' registration still waits on the browser
            using var ctx = new FormaToolbarTests();
            var register = new HeldObjectReferenceHandler("register");
            ctx.Router.AddInvocationHandler(register);
            var groups = Group(new ToolbarCommand { Id = "bold", Title = "Bold", Command = "bold", ShortcutAriaKeys = "Control+B" });
            var target = new ElementReference("toolbar-target");
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="groups" Target="target" />);
            var toolbar = cut.FindComponent<FormaToolbar>();
            await toolbar.InvokeAsync(() => toolbar.Instance.DisposeAsync().AsTask());
            var scope = new FakeJSObjectReference((_, _) => null);

            // Act
            await cut.ReleaseAsync(() => register.Answer(Assert.Single(register.HeldCalls), scope));

            // Assert
            Assert.True(scope.IsDisposed);
        }

        [Fact]
        public void Should_attach_a_parsed_shortcut_when_a_target_is_given()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            var groups = Group(new ToolbarCommand { Id = "bold", Title = "Bold", Command = "bold", ShortcutAriaKeys = "Control+Shift+B" });
            var target = new ElementReference("toolbar-target");

            // Act
            ctx.Render(@<FormaToolbar Label="Formatting" Items="groups" Target="target" />);

            // Assert — Control stands for the platform's shortcut key
            var profile = Assert.Single(GetRegistrations(ctx));
            var route = Assert.Single(profile.InputRoutes);
            var binding = Assert.IsType<KeyBinding>(Assert.Single(route.Bindings));
            Assert.Multiple(
                () => Assert.Equal("toolbar.bold", route.Action),
                () => Assert.Equal("B", binding.Key),
                () => Assert.True(binding.Modifiers.Primary),
                () => Assert.Equal(true, binding.Modifiers.Shift),
                () => Assert.Equal(false, binding.Modifiers.Alt));
        }

