        [Fact]
        public void Should_keep_a_menu_with_its_own_item_when_an_earlier_item_is_removed()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            var both = Group(CreateMenuItem("first"), CreateMenuItem("second"));
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="both" />);
            cut.FindAll(".forma-dropdown-menu-trigger")[1].Click();

            // Act
            cut.FindComponent<FormaToolbar>()
               .Render(parameters => parameters.Add(p => p.Items, Group(CreateMenuItem("second"))));

            // Assert
            var trigger = cut.Find(".forma-dropdown-menu-trigger");
            Assert.Multiple(
                () => Assert.Equal("second", trigger.GetAttribute("aria-label")),
                () => Assert.Equal("true", trigger.GetAttribute("aria-expanded")));
        }

        private static ToolbarItem CreateMenuItem(string id)
            => new ToolbarMenu
            {
                Id = id,
                Title = id,
                Options = [new() { Id = $"{id}-only", Title = id, Command = $"{id}.pick", IsActive = true }],
            };

        /// <summary>The profile of every scope the toolbar registered with the router.</summary>
        private static List<InputProfile> GetRegistrations(FormaToolbarTests ctx)
            => [.. ctx.Router.Invocations
                     .Where(invocation => invocation.Identifier == "register")
                     .Select(invocation => (InputProfile)invocation.Arguments[1]!)];

        [Fact]
        public void Should_rove_its_controls_as_one_tab_stop()
        {
            // Arrange
            using var ctx = new FormaToolbarTests();
            var probe = new DomProbe<FocusState>(ctx);
            var groups = Group(new ToolbarCommand { Id = "bold", Title = "Bold", Command = "bold" });

            // Act
            ctx.Render(@<FormaToolbar Label="Formatting" Items="groups" />);

            // Assert
            var attach = Assert.Single(probe.Interactions, attach => DomProbe<FocusState>.GetRequestField(attach, "capability") is "focus");
            Assert.Equal("horizontal", DomProbe<FocusState>.GetOption(attach, "rovingOrientation"));
        }

