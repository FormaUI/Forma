            // Act
            var cut = ctx.Render(@<FormaToolbar Label="Formatting" Items="groups" />);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Bold", cut.Find("button bdi").TextContent),
                () => Assert.Null(cut.Find("button").GetAttribute("dir")));
        }

