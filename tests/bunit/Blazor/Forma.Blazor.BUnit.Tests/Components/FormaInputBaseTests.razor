@inherits FormaBunitContext
@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Forma.Blazor.Models
@using Forma.Framework.Css
@using Forma.Framework.Culture
@using Forma.Tests.Culture
@using Microsoft.AspNetCore.Components.Rendering

@code {
    public sealed class Component
    {
        private static IRenderedComponent<Field> RenderField(FormaInputBaseTests ctx, FakeModel model, string? hostClass = null, bool failsOnDispose = false, bool frameworkFailsOnDispose = false)
        {
            var editContext = new EditContext(model);

            return ctx.Render<Field>(parameters => parameters
                .AddCascadingValue(editContext)
                .Bind(field => field.Value, model.Text, value => model.Text = value, () => model.Text)
                .Add(field => field.Class, hostClass)
                .Add(field => field.FailsOnDispose, failsOnDispose)
                .Add(field => field.FrameworkFailsOnDispose, frameworkFailsOnDispose));
        }

        [Fact]
        public void Should_start_the_scope_s_part_in_the_culture_as_it_first_sets_its_parameters()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var start = new FakeCultureScopeStart();
            ctx.Services.AddSingleton<ICultureScopeStart>(start);
            var cut = RenderField(ctx, new FakeModel());

            // Act
            cut.Render();

            // Assert
            Assert.Equal(1, start.StartCount);
        }

        [Fact]
        public async Task Should_render_again_when_the_culture_state_changes()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            using var fixture = new CultureFixture("en");
            var cut = RenderField(ctx, new FakeModel());
            var before = cut.RenderCount;

            // Act
            await ctx.ChangeCultureAsync("he", "he");

            // Assert
            Assert.Equal(before + 1, cut.RenderCount);
        }

        [Fact]
        public async Task Should_read_its_strings_in_the_culture_states_ui_culture()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            using var fixture = new CultureFixture("en");
            var model = new FakeModel();
            var field = ctx.Render<Field>(parameters => parameters
                .AddCascadingValue(new EditContext(model))
                .Bind(field => field.Value, model.Text, value => model.Text = value, () => model.Text)
                .Add(field => field.StringsSource, typeof(FormaPagination))).Instance;

            // Act
            await ctx.ChangeCultureAsync("en", "he");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("הבא", field.OwnContext.Locale["Next"].Value);
                Assert.Equal("en", CultureInfo.CurrentUICulture.Name);
            });
        }

        [Fact]
        public async Task Should_release_its_context_even_when_the_frameworks_cleanup_fails()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var field = RenderField(ctx, new FakeModel(), frameworkFailsOnDispose: true).Instance;
            _ = field.OwnContext.RuntimeId;

            // Act
            await Assert.ThrowsAsync<InvalidOperationException>(() => field.DisposeAsync().AsTask());

            // Assert
            Assert.True(((ComponentContext)field.OwnContext).IsDisposed);
        }

        [Fact]
        public async Task Should_release_its_context_after_its_own_cleanup_and_the_frameworks()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var field = RenderField(ctx, new FakeModel()).Instance;
            _ = field.OwnContext.RuntimeId;

            // Act
            await field.DisposeAsync();

            // Assert
            Assert.Multiple(
                () => Assert.False(field.ContextDisposedDuringCleanup),
                () => Assert.False(field.ContextDisposedDuringFrameworkCleanup),
                () => Assert.Equal(1, field.FrameworkDisposeCalls),
                () => Assert.True(((ComponentContext)field.OwnContext).IsDisposed));
        }

        [Fact]
        public async Task Should_create_no_context_while_it_is_disposed()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var field = RenderField(ctx, new FakeModel()).Instance;

            // Act
            await field.DisposeAsync();

            // Assert: a context made during teardown would have been released with it.
            Assert.False(((ComponentContext)field.OwnContext).IsDisposed);
        }

        [Fact]
        public async Task Should_release_its_context_and_run_the_frameworks_cleanup_even_when_its_own_cleanup_fails()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var field = RenderField(ctx, new FakeModel(), failsOnDispose: true).Instance;
            _ = field.OwnContext.RuntimeId;

            // Act
            await Assert.ThrowsAsync<InvalidOperationException>(() => field.DisposeAsync().AsTask());

            // Assert
            Assert.Multiple(
                () => Assert.True(field.IsDisposed),
                () => Assert.Equal(1, field.FrameworkDisposeCalls),
                () => Assert.True(((ComponentContext)field.OwnContext).IsDisposed));
        }

        [Fact]
        public void Should_write_its_own_classes_then_the_hosts_then_the_fields()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();

            // Act
            var cut = RenderField(ctx, new FakeModel(), "host-field");

            // Assert
            Assert.Equal("fake-field host-field valid", cut.Find("input").GetAttribute("class"));
        }

        [Fact]
        public void Should_write_the_hosts_id_and_style_on_its_root()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render<Field>(parameters => parameters
                .AddCascadingValue(new EditContext(model))
                .Bind(field => field.Value, model.Text, value => model.Text = value, () => model.Text)
                .Add(field => field.Id, "name")
                .Add(field => field.Style, "color: red;"));
            var root = cut.Find("input");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("name", root.GetAttribute("id"));
                Assert.Equal("color: red;", root.GetAttribute("style"));
                Assert.NotNull(cut.Instance.RootElement.Id);
            });
        }

        [Fact]
        public async Task Should_dispose_once_and_run_the_frameworks_own_cleanup()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var field = RenderField(ctx, new FakeModel()).Instance;

            // Act
            await field.DisposeAsync();
            await field.DisposeAsync();

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(1, field.AsyncDisposeCalls);
                Assert.Equal(1, field.FrameworkDisposeCalls);
                Assert.True(field.IsDisposed);
            });
        }

        [Fact]
        public void Should_carry_an_identity_of_its_own_for_its_lifetime()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();

            // Act
            var first = RenderField(ctx, new FakeModel()).Instance;
            var second = RenderField(ctx, new FakeModel()).Instance;

            // Assert
            Assert.Multiple(() =>
            {
                Assert.NotEqual(first.OwnContext.RuntimeId, second.OwnContext.RuntimeId);
                Assert.Equal(7, first.OwnContext.RuntimeId.Version);
            });
        }

        [Fact]
        public void Should_carry_its_user_scopes_culture_state_in_its_context()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();

            // Act
            var field = RenderField(ctx, new FakeModel()).Instance;

            // Assert
            Assert.Same(ctx.Services.GetRequiredService<ICultureState>(), field.OwnContext.CultureState);
        }

        [Fact]
        public void Should_keep_its_identity_across_rerenders()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var cut = RenderField(ctx, new FakeModel());
            var before = cut.Instance.OwnContext.RuntimeId;

            // Act
            cut.Render();

            // Assert
            Assert.Equal(2, cut.RenderCount);
            Assert.Equal(before, cut.Instance.OwnContext.RuntimeId);
        }

        [Fact]
        public async Task Should_be_described_by_the_fields_messages_while_it_shows_any()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var model = new FakeModel();
            var editContext = new EditContext(model);
            var cut = ctx.Render<Field>(parameters => parameters
                .AddCascadingValue(editContext)
                .Bind(field => field.Value, model.Text, value => model.Text = value, () => model.Text)
                .Add(field => field.Id, "name"));
            var messages = new ValidationMessageStore(editContext);

            // Act
            messages.Add(FieldIdentifier.Create(() => model.Text), "Required");
            await cut.InvokeAsync(editContext.NotifyValidationStateChanged);
            var invalid = cut.Find("input").GetAttribute("aria-describedby");
            messages.Clear();
            await cut.InvokeAsync(editContext.NotifyValidationStateChanged);

            // Assert
            Assert.Multiple(
                () => Assert.Equal(cut.Instance.OwnFieldElementIds.MessageContainerId, invalid),
                () => Assert.Null(cut.Find("input").GetAttribute("aria-describedby")));
        }

        [Fact]
        public async Task Should_be_described_by_the_hosts_ids_then_its_description_then_its_parts_then_the_fields_messages()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var model = new FakeModel();
            var editContext = new EditContext(model);
            var cut = ctx.Render<Field>(parameters => parameters
                .AddCascadingValue(editContext)
                .Bind(field => field.Value, model.Text, value => model.Text = value, () => model.Text)
                .Add(field => field.Id, "name")
                .Add(field => field.Description, "Lowercase letters only.")
                .Add(field => field.PartId, "name-hint")
                .AddUnmatched("aria-describedby", "host-note"));

            // Act
            new ValidationMessageStore(editContext).Add(FieldIdentifier.Create(() => model.Text), "Required");
            await cut.InvokeAsync(editContext.NotifyValidationStateChanged);

            // Assert
            var ids = cut.Instance.OwnFieldElementIds;
            Assert.Equal($"host-note {ids.DescriptionId} name-hint {ids.MessageContainerId}", cut.Find("input").GetAttribute("aria-describedby"));
        }

        [Fact]
        public async Task Should_not_be_described_by_messages_no_field_shows()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var model = new FakeModel();
            var editContext = new EditContext(model);
            var cut = ctx.Render<Field>(parameters => parameters
                .AddCascadingValue(editContext)
                .Bind(field => field.Value, model.Text, value => model.Text = value, () => model.Text)
                .Add(field => field.OutsideField, true));

            // Act
            new ValidationMessageStore(editContext).Add(FieldIdentifier.Create(() => model.Text), "Required");
            await cut.InvokeAsync(editContext.NotifyValidationStateChanged);

            // Assert
            Assert.Null(cut.Find("input").GetAttribute("aria-describedby"));
        }
    }

    public sealed class Descriptions
    {
        private const string Instructions = "Shown beneath it.";

        public static TheoryData<string> Inputs { get; } =
        [
            "check-box", "color-picker", "currency-input", "date-picker", "date-range-picker", "date-time-picker", "multi-select",
            "number-input", "labeled-number-input", "password-box", "select", "slider", "text-area", "text-box", "labeled-text-box",
            "time-picker", "toggle-switch",
        ];

        [Theory]
        [MemberData(nameof(Inputs))]
        public void Should_show_its_description_beneath_it_and_be_described_by_it(string input)
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            ctx.JSInterop.Mode = JSRuntimeMode.Loose;
            var model = new DescribedModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">@CreateInput(input, model)</FakeFormHost>);

            // Assert
            var description = cut.Find("[id$='-description']");
            var described = cut.FindAll("input, textarea, button, select")
                .Where(element => element.GetAttribute("aria-describedby")?.Split(' ').Contains(description.Id) == true);
            Assert.Multiple(
                () => Assert.Equal(Instructions, description.TextContent.Trim()),
                () => Assert.NotEmpty(described));
        }

        private RenderFragment CreateInput(string input, DescribedModel model)
            => input switch
            {
                "check-box" => @<FormaCheckBox @bind-Value="model.Flag" Description="@Instructions">Subscribe</FormaCheckBox>,
                "color-picker" => @<FormaColorPicker @bind-Value="model.Color" Label="Background" Description="@Instructions" />,
                "currency-input" => @<FormaCurrencyInput @bind-Value="model.Price" CurrencyCode="USD" Label="Price" Description="@Instructions" />,
                "date-picker" => @<FormaDatePicker @bind-Value="model.Date" Label="Start Date" Description="@Instructions" />,
                "date-range-picker" => @<FormaDateRangePicker @bind-Value="model.Range" Label="Period" Description="@Instructions" />,
                "date-time-picker" => @<FormaDateTimePicker @bind-Value="model.Moment" Label="Starts" Description="@Instructions" />,
                "multi-select" => @<FormaMultiSelect TValue="int" @bind-Value="model.Categories" Options="Categories" Label="Categories" Description="@Instructions" />,
                "number-input" => @<FormaNumberInput @bind-Value="model.Price" Description="@Instructions" />,
                "labeled-number-input" => @<FormaNumberInput @bind-Value="model.Price" Label="Price" Description="@Instructions" />,
                "password-box" => @<FormaPasswordBox @bind-Value="model.Text" Label="Password" Description="@Instructions" />,
                "select" => @<FormaSelect TValue="int?" @bind-Value="model.Status" Options="Statuses" Label="Status" Description="@Instructions" />,
                "slider" => @<FormaSlider @bind-Value="model.Ratio" Label="Duration" Min="0.5" Max="5" Description="@Instructions" />,
                "text-area" => @<FormaTextArea @bind-Value="model.Text" Label="Notes" Description="@Instructions" />,
                "text-box" => @<FormaTextBox @bind-Value="model.Text" Description="@Instructions" />,
                "labeled-text-box" => @<FormaTextBox @bind-Value="model.Text" Label="Slug" Description="@Instructions" />,
                "time-picker" => @<FormaTimePicker @bind-Value="model.Time" Label="Starts" Description="@Instructions" />,
                "toggle-switch" => @<FormaToggleSwitch @bind-Value="model.Flag" Label="Notify" Description="@Instructions" />,
                _ => throw new ArgumentOutOfRangeException(nameof(input), input, null),
            };

        private static readonly IReadOnlyList<SelectOption<int>> Categories = [new(1, "News"), new(2, "Sport")];

        private static readonly IReadOnlyList<SelectOption<int?>> Statuses = [new(1, "Draft"), new(2, "Published")];

        private sealed class DescribedModel
        {
            public bool Flag { get; set; }

            public string? Text { get; set; }

            public string Color { get; set; } = "#336699";

            public decimal Price { get; set; }

            public DateOnly? Date { get; set; }

            public DateRange? Range { get; set; }

            public DateTime? Moment { get; set; }

            public TimeOnly? Time { get; set; }

            public List<int> Categories { get; set; } = [];

            public int? Status { get; set; }

            public double Ratio { get; set; } = 1;
        }
    }

    public sealed class Focusing
    {
        [Fact]
        public async Task Should_focus_its_control_and_answer_that_it_asked()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var cut = RenderField(ctx);

            // Act
            var asked = await cut.InvokeAsync(() => cut.Instance.FocusAsync().AsTask());

            // Assert
            var focus = Assert.Single(GetFocusCalls(ctx.JSInterop));
            Assert.Multiple(
                () => Assert.True(asked),
                () => Assert.Equal(cut.Find("input").GetAttribute("blazor:elementReference"), Assert.IsType<ElementReference>(focus.Arguments[0]).Id),
                () => Assert.Equal(false, focus.Arguments[1]));
        }

        [Fact]
        public async Task Should_leave_the_page_where_it_stands_when_asked()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var cut = RenderField(ctx);

            // Act
            await cut.InvokeAsync(() => cut.Instance.FocusAsync(preventScroll: true).AsTask());

            // Assert
            Assert.Equal(true, Assert.Single(GetFocusCalls(ctx.JSInterop)).Arguments[1]);
        }

        [Fact]
        public async Task Should_answer_false_without_asking_before_it_is_drawn()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var cut = RenderField(ctx, isDrawn: false);

            // Act
            var asked = await cut.InvokeAsync(() => cut.Instance.FocusAsync().AsTask());

            // Assert
            Assert.False(asked);
            Assert.Empty(GetFocusCalls(ctx.JSInterop));
        }

        [Fact]
        public async Task Should_answer_false_without_asking_once_disposed()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var cut = RenderField(ctx);
            await cut.InvokeAsync(() => cut.Instance.DisposeAsync().AsTask());

            // Act
            var asked = await cut.InvokeAsync(() => cut.Instance.FocusAsync().AsTask());

            // Assert
            Assert.False(asked);
            Assert.Empty(GetFocusCalls(ctx.JSInterop));
        }

        [Fact]
        public async Task Should_answer_false_without_asking_under_a_static_render()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));
            var cut = RenderField(ctx);

            // Act
            var asked = await cut.InvokeAsync(() => cut.Instance.FocusAsync().AsTask());

            // Assert
            Assert.False(asked);
            Assert.Empty(GetFocusCalls(ctx.JSInterop));
        }

        [Fact]
        public async Task Should_answer_false_without_asking_while_its_host_disables_it()
        {
            // Arrange
            using var ctx = new FormaInputBaseTests();
            var cut = RenderField(ctx, disabled: true);

            // Act
            var asked = await cut.InvokeAsync(() => cut.Instance.FocusAsync().AsTask());

            // Assert
            Assert.False(asked);
            Assert.Empty(GetFocusCalls(ctx.JSInterop));
        }

        private static IRenderedComponent<Field> RenderField(FormaInputBaseTests ctx, bool isDrawn = true, bool disabled = false)
        {
            var model = new FakeModel();

            return ctx.Render<Field>(parameters =>
            {
                parameters
                    .Bind(field => field.Value, model.Text, value => model.Text = value, () => model.Text)
                    .Add(field => field.LeavesRootUncaptured, !isDrawn);

                if (disabled)
                {
                    parameters.AddUnmatched("disabled", true);
                }
            });
        }

        private static List<JSRuntimeInvocation> GetFocusCalls(BunitJSInterop js)
            => [.. js.Invocations.Where(invocation => invocation.Identifier == "Blazor._internal.domWrapper.focus")];
    }

    public sealed class Field : FormaInputBase<string?>
    {
        [Parameter] public string? PartId { get; set; }

        [Parameter] public bool LeavesRootUncaptured { get; set; }

        [Parameter] public Type? StringsSource { get; set; }

        [Parameter] public bool OutsideField { get; set; }

        [Parameter] public bool FailsOnDispose { get; set; }

        [Parameter] public bool FrameworkFailsOnDispose { get; set; }

        private IComponentContext? _readContext;

        public bool? ContextDisposedDuringCleanup { get; private set; }

        public bool? ContextDisposedDuringFrameworkCleanup { get; private set; }

        // The context a test read, so the cleanup can look at it without reading the context itself.
        public IComponentContext OwnContext
            => _readContext = Context;

        public FieldElementIds OwnFieldElementIds
            => FieldElementIds;

        public int AsyncDisposeCalls { get; private set; }

        public int FrameworkDisposeCalls { get; private set; }

        protected override bool HasFieldContainer
            => !OutsideField;

        protected override Type LocalizationSourceType
            => StringsSource ?? base.LocalizationSourceType;

        protected override void BuildRootClass(CssClassBuilder builder)
            => builder.Add("fake-field");

        protected override void BuildDescribedBy(ICollection<string> ids)
        {
            if (PartId is not null)
            {
                ids.Add(PartId);
            }
        }

        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            builder.OpenElement(0, "input");
            builder.AddAttribute(1, "id", Id);
            builder.AddAttribute(2, "class", RootClass);
            builder.AddAttribute(3, "style", RootStyle);
            builder.AddAttribute(4, "value", CurrentValueAsString);
            builder.AddMultipleAttributes(5, AdditionalAttributes);
            builder.AddAttribute(6, "aria-describedby", DescribedBy);
            if (!LeavesRootUncaptured)
            {
                builder.AddElementReferenceCapture(7, element => RootElement = element);
            }

            builder.CloseElement();
        }

        protected override bool TryParseValueFromString(string? value, out string? result, [NotNullWhen(false)] out string? validationErrorMessage)
        {
            result = value;
            validationErrorMessage = null;

            return true;
        }

        protected override ValueTask DisposeAsyncCore()
        {
            AsyncDisposeCalls++;
            ContextDisposedDuringCleanup = (_readContext as ComponentContext)?.IsDisposed;

            return FailsOnDispose ? throw new InvalidOperationException("The cleanup failed.") : ValueTask.CompletedTask;
        }

        protected override void Dispose(bool disposing)
        {
            FrameworkDisposeCalls++;
            ContextDisposedDuringFrameworkCleanup = (_readContext as ComponentContext)?.IsDisposed;

            if (FrameworkFailsOnDispose)
            {
                throw new InvalidOperationException("The framework's cleanup failed.");
            }

            base.Dispose(disposing);
        }
    }
}
