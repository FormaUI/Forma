@using AngleSharp.Dom
@using Bunit.Rendering
@using Forma.Framework.Browser.Interop.Operations
@using Forma.Framework.Resources
@using Forma.Framework.Share
@using Forma.Framework.Share.Targets
@using Forma.Tests.Browser
@using Forma.Tests.Share
@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        private static ShareItem Article => new()
        {
            Name = "Stage 12",
            Address = "https://example.com/news/stage-12?ref=a b",
        };

        [Fact]
        public void Should_offer_the_networks_for_a_subject_with_an_address()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            var facebook = cut.FindAll("a").First(a => a.TextContent.Contains("Facebook", StringComparison.Ordinal));
            Assert.Multiple(
                () => Assert.StartsWith("https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fexample.com", facebook.GetAttribute("href"), StringComparison.Ordinal),
                () => Assert.Equal("_blank", facebook.GetAttribute("target")),
                () => Assert.Contains("noopener", facebook.GetAttribute("rel"), StringComparison.Ordinal),
                () => Assert.Contains(cut.FindAll(".forma-share-menu-primary a"), item => item.TextContent.Contains("WhatsApp", StringComparison.Ordinal)),
                () => Assert.Contains(cut.FindAll(".forma-share-menu-primary a"), item => item.TextContent.Contains("Bluesky", StringComparison.Ordinal)),
                () => Assert.Contains(cut.FindAll(".forma-share-menu-primary a"), item => item.GetAttribute("href")?.StartsWith("https://www.snapchat.com/share?link=", StringComparison.Ordinal) == true));
        }

        [Fact]
        public void Should_name_each_network_by_its_title_alone()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            var facebook = cut.FindAll("a").First(a => a.TextContent.Contains("Facebook", StringComparison.Ordinal));
            Assert.Equal("true", facebook.QuerySelector("svg")!.GetAttribute("aria-hidden"));
        }

        [Fact]
        public void Should_offer_no_network_for_a_subject_without_an_address()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var notes = new ShareItem { Name = "notes.txt", Resource = new ResourceInfo("data:text/plain,notes") { Name = "notes.txt" } };

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="notes" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            Assert.DoesNotContain(cut.FindAll("a,button"), item => item.TextContent.Contains("Facebook", StringComparison.Ordinal));
            Assert.Contains(cut.FindAll("a"), item => item.TextContent.Contains("Download", StringComparison.Ordinal));
        }

        [Fact]
        public void Should_download_through_the_address_when_the_subject_has_one()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var file = new ShareItem { Name = "kit.zip", Resource = new ResourceInfo("/files/kit.zip") };

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="file" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            var download = cut.FindAll("a").First(a => a.TextContent.Contains("Download", StringComparison.Ordinal));
            Assert.Equal("/files/kit.zip", download.GetAttribute("href"));
            Assert.Equal("kit.zip", download.GetAttribute("download"));
        }

        private sealed class VaultTarget : IShareTarget
        {
            public ShareItem? Shared { get; private set; }
            public string Id => "vault";
            public string Title => "Vault";
            public Icon Icon => Glyph.Folder;
            public bool Supports(ShareItem item) => item.Kind == ShareItemKind.File;
            public Task<bool> ShareAsync(ShareItem item, CancellationToken cancellationToken = default)
            {
                Shared = item;
                return Task.FromResult(true);
            }
        }

        [Fact]
        public void Should_keep_a_file_off_the_networks_and_off_email()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var file = new ShareItem { Kind = ShareItemKind.File, Name = "kit.zip", Address = "https://example.com/files/kit.zip", Resource = new ResourceInfo("/files/kit.zip") };

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="file" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            Assert.DoesNotContain(cut.FindAll("a,button"), item => item.TextContent.Contains("Facebook", StringComparison.Ordinal));
            Assert.DoesNotContain(cut.FindAll("a"), item => item.GetAttribute("href")?.StartsWith("mailto:", StringComparison.Ordinal) == true);
            Assert.Contains(cut.FindAll("a"), item => item.TextContent.Contains("Download", StringComparison.Ordinal));
            Assert.Contains(cut.FindAll("button"), item => item.TextContent.Contains("Copy Link", StringComparison.Ordinal));
        }

        [Fact]
        public void Should_offer_a_picture_to_the_board_that_pins_media()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var picture = new ShareItem { Kind = ShareItemKind.Image, Name = "Finish line", Address = "https://example.com/photos/finish", Resource = new ResourceInfo("https://example.com/photos/finish.jpg") };

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="picture" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            var pinterest = cut.FindAll("a").First(a => a.TextContent.Contains("Pinterest", StringComparison.Ordinal));
            Assert.Contains("media=https%3A%2F%2Fexample.com%2Fphotos%2Ffinish.jpg", pinterest.GetAttribute("href"), StringComparison.Ordinal);
        }

        [Fact]
        public void Should_reach_a_contact_by_email_rather_than_a_network_or_a_copied_link()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var contact = new ShareItem { Kind = ShareItemKind.Contact, Name = "Ana Torres", Address = "https://example.com/people/ana" };

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="contact" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            Assert.DoesNotContain(cut.FindAll("a,button"), item => item.TextContent.Contains("Facebook", StringComparison.Ordinal));
            Assert.DoesNotContain(cut.FindAll("button"), item => item.TextContent.Contains("Copy Link", StringComparison.Ordinal));
            Assert.Contains(cut.FindAll("a"), item => item.GetAttribute("href")?.StartsWith("mailto:?subject=Ana%20Torres", StringComparison.Ordinal) == true);
        }

        [Fact]
        public void Should_offer_a_registered_target_to_the_items_it_supports_alone()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var vault = new VaultTarget();
            ctx.Services.AddSingleton<IShareTarget>(vault);
            var file = new ShareItem { Kind = ShareItemKind.File, Name = "kit.zip", Resource = new ResourceInfo("/files/kit.zip") };

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="file" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();
            cut.FindAll(".forma-share-menu-primary button").First(button => button.TextContent.Contains("Vault", StringComparison.Ordinal)).Click();

            // Assert
            Assert.Same(file, vault.Shared);

            // Act 2 (a link, which the target refuses)
            var linkCut = ctx.Render(@<FormaShareMenu Item="Article" />);
            linkCut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert 2
            Assert.DoesNotContain(linkCut.FindAll("a,button"), item => item.TextContent.Contains("Vault", StringComparison.Ordinal));
        }

        [Fact]
        public void Should_render_no_header_for_an_item_without_a_name()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var item = new ShareItem { Address = "https://example.com/a" };

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="item" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            Assert.Empty(cut.FindAll(".forma-dropdown-menu-header"));
        }

        [Fact]
        public void Should_show_the_subjects_name_and_meta_in_the_header()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var subject = new ShareItem { Name = "Stage 12", Meta = "Article", Address = "https://example.com/a" };

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="subject" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            var header = cut.Find(".forma-share-menu-item");
            Assert.Contains("Stage 12", header.TextContent, StringComparison.Ordinal);
            Assert.Contains("Article", header.TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_keep_the_built_in_commands_in_the_open_with_no_more_to_press()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            Assert.Contains(cut.FindAll("a"), item => item.GetAttribute("href")?.StartsWith("mailto:", StringComparison.Ordinal) == true);
            Assert.Contains(cut.FindAll("button"), item => item.TextContent.Contains("Copy Link", StringComparison.Ordinal));
            Assert.Contains(cut.FindAll("button"), item => item.TextContent.Contains("Print", StringComparison.Ordinal));
            Assert.DoesNotContain(cut.FindAll("button"), item => item.TextContent.Contains("More", StringComparison.Ordinal));
        }

        [Fact]
        public void Should_hold_consumer_actions_behind_more_and_raise_their_commands()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            string? raised = null;
            IReadOnlyList<ShareAction> actions = [new() { Id = "embed", Title = "Copy Embed Code", Command = "demo.embed" }];
            var callback = EventCallback.Factory.Create<string>(this, command => raised = command);

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" Actions="actions" OnCommand="callback" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert (waiting behind More)
            Assert.DoesNotContain(cut.FindAll(".forma-share-menu-primary button"), item => item.TextContent.Contains("Copy Embed Code", StringComparison.Ordinal));
            Assert.DoesNotContain("is-shown", cut.FindAll(".forma-visibility")[^1].ClassList);

            // Act 2 (expand and run)
            cut.FindAll("button").First(button => button.TextContent.Contains("More", StringComparison.Ordinal)).Click();
            cut.FindAll(".forma-visibility button").First(button => button.TextContent.Contains("Copy Embed Code", StringComparison.Ordinal)).Click();

            // Assert 2
            Assert.Equal("demo.embed", raised);
        }
    }

    public sealed class Accounts
    {
        private static ShareItem Article => new()
        {
            Name = "Stage 12",
            Address = "https://example.com/news/stage-12",
        };

        private static FakeAccountShareTarget RegisterVault(FormaShareMenuTests ctx, FakeShareTokenSource tokens, FakeShareConnections? connections)
        {
            var vault = new FakeAccountShareTarget(tokens);
            ctx.Services.AddSingleton<IShareTokenSource>(tokens);
            ctx.Services.AddSingleton<IShareTarget>(vault);

            if (connections is not null)
            {
                ctx.Services.AddSingleton<IShareConnections>(connections);
            }

            return vault;
        }

        private static IElement FindPrimaryButton(IRenderedComponent<ContainerFragment> cut, string text)
            => cut.FindAll(".forma-share-menu-primary button").First(button => button.TextContent.Contains(text, StringComparison.Ordinal));

        private static IElement FindMenuItem(IRenderedComponent<ContainerFragment> cut, string text)
            => cut.FindAll("[role=menuitem]").First(item => item.TextContent.Trim() == text);

        [Fact]
        public void Should_offer_and_share_through_the_host_s_native_share_surface()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var native = new FakeNativeOperations();
            ctx.Services.AddSingleton<INativeOperations>(native);
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Act
            FindMenuItem(cut, "Share").Click();

            // Assert
            Assert.Equal([(Article.Name, Article.Address!)], native.Shared);
        }

        [Fact]
        public void Should_hand_the_host_the_page_to_print_as_a_file_named_for_the_item()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var native = new FakeNativeOperations();
            ctx.Services.AddSingleton<INativeOperations>(native);
            ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/operations/Print.js").Setup<JSTransfer>("composePage", _ => true).SetResult(InlineTransfer.Of("<!DOCTYPE html><html></html>"));
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Act
            FindMenuItem(cut, "Print").Click();

            // Assert
            Assert.Equal([("Stage 12.html", "<!DOCTYPE html><html></html>", "text/html")], native.Saved);
        }

        [Fact]
        public void Should_offer_to_connect_an_account_target_the_host_reports_unconnected()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var connections = new FakeShareConnections();
            var vault = RegisterVault(ctx, new FakeShareTokenSource(), connections);

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();
            FindPrimaryButton(cut, "Connect Vault").Click();

            // Assert
            Assert.Multiple(
                () => Assert.Equal(["vault"], connections.ConnectRequests),
                () => Assert.Null(vault.Shared));
        }

        [Fact]
        public void Should_share_through_an_account_the_host_reports_connected_and_say_so()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var connections = new FakeShareConnections { Connected = { "vault" } };
            var vault = RegisterVault(ctx, new FakeShareTokenSource { Tokens = { ["vault"] = "token-123" } }, connections);

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();
            FindPrimaryButton(cut, "Vault").Click();

            // Assert
            Assert.Multiple(
                () => Assert.Equal("token-123", vault.SharedUnder),
                () => Assert.Equal("Shared to Vault.", cut.Find(".forma-share-menu-notice").TextContent));
        }

        [Fact]
        public void Should_report_a_missing_account_when_the_host_reports_no_status()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var vault = RegisterVault(ctx, new FakeShareTokenSource(), connections: null);

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();
            FindPrimaryButton(cut, "Vault").Click();

            // Assert
            Assert.Multiple(
                () => Assert.Null(vault.Shared),
                () => Assert.Equal("Vault needs a connected account.", cut.Find(".forma-share-menu-notice").TextContent));
        }

        [Fact]
        public void Should_report_a_missing_account_when_the_hosts_status_is_stale()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var connections = new FakeShareConnections { Connected = { "vault" } };
            var vault = RegisterVault(ctx, new FakeShareTokenSource(), connections);

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();
            FindPrimaryButton(cut, "Vault").Click();

            // Assert
            Assert.Multiple(
                () => Assert.Null(vault.Shared),
                () => Assert.Equal("Vault needs a connected account.", cut.Find(".forma-share-menu-notice").TextContent));
        }

        [Fact]
        public void Should_link_a_federated_target_to_the_users_server_once_named()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var servers = new FakeShareServerSource { Servers = { ["mastodon"] = new Uri("https://mastodon.social/") } };
            ctx.Services.AddSingleton<IShareTarget>(new MastodonShare(servers));

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();

            // Assert
            var mastodon = cut.FindAll(".forma-share-menu-primary a").First(a => a.TextContent.Contains("Mastodon", StringComparison.Ordinal));
            Assert.StartsWith("https://mastodon.social/share?text=", mastodon.GetAttribute("href"), StringComparison.Ordinal);
        }

        [Fact]
        public void Should_report_a_federated_target_needs_an_account_while_no_server_is_named()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            ctx.Services.AddSingleton<IShareTarget>(new MastodonShare(new FakeShareServerSource()));

            // Act
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();
            FindPrimaryButton(cut, "Mastodon").Click();

            // Assert
            Assert.Equal("Mastodon needs a connected account.", cut.Find(".forma-share-menu-notice").TextContent);
        }

        [Fact]
        public async Task Should_offer_the_target_itself_once_the_host_reports_it_connected()
        {
            // Arrange
            using var ctx = new FormaShareMenuTests();
            var connections = new FakeShareConnections();
            RegisterVault(ctx, new FakeShareTokenSource { Tokens = { ["vault"] = "token-123" } }, connections);
            var cut = ctx.Render(@<FormaShareMenu Item="Article" />);
            cut.Find(".forma-dropdown-menu-anchor button").Click();
            Assert.NotNull(FindPrimaryButton(cut, "Connect Vault"));

            // Act
            await connections.MarkConnectedAsync("vault");

            // Assert
            cut.WaitForAssertion(() => Assert.DoesNotContain(cut.FindAll(".forma-share-menu-primary button"), button => button.TextContent.Contains("Connect", StringComparison.Ordinal)));
        }
    }
}
