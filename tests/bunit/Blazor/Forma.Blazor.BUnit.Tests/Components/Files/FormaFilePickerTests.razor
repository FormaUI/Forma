@inherits FormaBunitContext
@using Bunit.TestDoubles
@using Forma.Blazor.Components.Files
@using Forma.Framework.Files
@using Microsoft.AspNetCore.Components.Forms

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_take_a_drop_of_files_as_its_drop_action()
        {
            // Arrange
            using var ctx = new FormaFilePickerTests();
            var zone = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/behaviors/FileDropZone.js");

            // Act
            ctx.Render(@<FormaFilePicker OnFilesSelected="@(_ => Task.CompletedTask)" />);

            // Assert
            var options = Assert.Single(zone.Invocations, invocation => invocation.Identifier == "attach").Arguments[1]!;
            Assert.Multiple(
                () => Assert.Equal("file-picker.drop", InteropPayload.GetValue(options, "action")),
                () => Assert.Equal("forma-file-picker-dragging", InteropPayload.GetValue(options, "activeClass")));
        }

        [Fact]
        public void Should_render_the_default_prompt()
        {
            // Arrange
            using var ctx = new FormaFilePickerTests();

            // Act
            var cut = ctx.Render(@<FormaFilePicker OnFilesSelected="@(_ => Task.CompletedTask)" />);

            // Assert
            Assert.Equal("Drop files here or click to browse", cut.Find(".forma-file-picker-prompt").TextContent);
        }

        [Fact]
        public void Should_render_a_caller_supplied_prompt()
        {
            // Arrange
            using var ctx = new FormaFilePickerTests();

            // Act
            var cut = ctx.Render(@<FormaFilePicker Prompt="Drop images here" OnFilesSelected="@(_ => Task.CompletedTask)" />);

            // Assert
            Assert.Equal("Drop images here", cut.Find(".forma-file-picker-prompt").TextContent);
        }

        [Fact]
        public void Should_report_a_file_that_passes_validation()
        {
            // Arrange
            using var ctx = new FormaFilePickerTests();
            IReadOnlyList<IBrowserFile>? selected = null;
            var cut = ctx.Render(@<FormaFilePicker OnFilesSelected="@(files => { selected = files; return Task.CompletedTask; })" />);
            var input = cut.FindComponent<InputFile>();

            // Act
            input.UploadFiles(InputFileContent.CreateFromText("hello", "cover.jpg", contentType: "image/jpeg"));

            // Assert
            Assert.Equal("cover.jpg", Assert.Single(selected!).Name);
        }

        [Fact]
        public void Should_reject_a_file_whose_type_is_not_accepted()
        {
            // Arrange
            using var ctx = new FormaFilePickerTests();
            IReadOnlyList<RejectedFile>? rejected = null;
            var cut = ctx.Render(@<FormaFilePicker Options="@(new FilePickerOptions { Accept = "image/*" })"
                                                   OnFilesSelected="@(_ => Task.CompletedTask)"
                                                   OnFilesRejected="@(files => { rejected = files; return Task.CompletedTask; })" />);
            var input = cut.FindComponent<InputFile>();

            // Act
            input.UploadFiles(InputFileContent.CreateFromText("notes", "notes.txt", contentType: "text/plain"));
            var rejection = Assert.Single(rejected!);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("notes.txt", rejection.Name);
                Assert.Equal(FileRejectionReason.DisallowedType, rejection.Reason);
                Assert.Contains("notes.txt", cut.Find(".forma-file-picker-rejections").TextContent);
            });
        }

        [Fact]
        public void Should_reject_a_file_larger_than_the_limit()
        {
            // Arrange
            using var ctx = new FormaFilePickerTests();
            IReadOnlyList<RejectedFile>? rejected = null;
            var cut = ctx.Render(@<FormaFilePicker Options="@(new FilePickerOptions { MaxFileSize = 4 })"
                                                   OnFilesSelected="@(_ => Task.CompletedTask)"
                                                   OnFilesRejected="@(files => { rejected = files; return Task.CompletedTask; })" />);
            var input = cut.FindComponent<InputFile>();

            // Act
            input.UploadFiles(InputFileContent.CreateFromText("far too long a body", "brief.pdf", contentType: "application/pdf"));

            // Assert
            Assert.Equal(FileRejectionReason.TooLarge, Assert.Single(rejected!).Reason);
        }

        [Fact]
        public void Should_reject_files_beyond_the_selection_limit()
        {
            // Arrange
            using var ctx = new FormaFilePickerTests();
            IReadOnlyList<IBrowserFile>? selected = null;
            IReadOnlyList<RejectedFile>? rejected = null;
            var cut = ctx.Render(@<FormaFilePicker Options="@(new FilePickerOptions { MaxFiles = 1 })"
                                                   OnFilesSelected="@(files => { selected = files; return Task.CompletedTask; })"
                                                   OnFilesRejected="@(files => { rejected = files; return Task.CompletedTask; })" />);
            var input = cut.FindComponent<InputFile>();

            // Act
            input.UploadFiles(
                InputFileContent.CreateFromText("one", "one.jpg", contentType: "image/jpeg"),
                InputFileContent.CreateFromText("two", "two.jpg", contentType: "image/jpeg"));

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("one.jpg", Assert.Single(selected!).Name);
                Assert.Equal(FileRejectionReason.TooManyFiles, Assert.Single(rejected!).Reason);
            });
        }

        [Fact]
        public void Should_cap_a_single_file_selection_when_multiple_files_are_not_allowed()
        {
            // Arrange
            using var ctx = new FormaFilePickerTests();
            IReadOnlyList<IBrowserFile>? selected = null;
            var cut = ctx.Render(@<FormaFilePicker Options="@(new FilePickerOptions { AllowMultipleFiles = false })" OnFilesSelected="@(files => { selected = files; return Task.CompletedTask; })" />);
            var input = cut.FindComponent<InputFile>();

            // Act
            input.UploadFiles(
                InputFileContent.CreateFromText("one", "one.jpg", contentType: "image/jpeg"),
                InputFileContent.CreateFromText("two", "two.jpg", contentType: "image/jpeg"));

            // Assert
            Assert.Equal("one.jpg", Assert.Single(selected!).Name);
        }

        [Fact]
        public void Should_hand_the_host_a_readable_file_it_has_not_already_consumed()
        {
            // Arrange
            using var ctx = new FormaFilePickerTests();
            var content = "the quick brown fox";
            var readBack = string.Empty;
            var cut = ctx.Render(@<FormaFilePicker OnFilesSelected="@(async files =>
                                                 {
                                                     using var reader = new StreamReader(files[0].OpenReadStream());
                                                     readBack = await reader.ReadToEndAsync();
                                                 })" />);
            var input = cut.FindComponent<InputFile>();

            // Act
            input.UploadFiles(InputFileContent.CreateFromText(content, "note.txt", contentType: "text/plain"));

            // Assert
            Assert.Equal(content, readBack);
        }
    }

    public sealed class Clearing
    {
        [Fact]
        public async Task Should_clear_its_refusals_and_its_input_so_the_same_file_is_taken_again()
        {
            // Arrange — a file refused as too large
            using var ctx = new FormaFilePickerTests();
            var dropZone = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/behaviors/FileDropZone.js").SetupModule("attach", _ => true);
            dropZone.Mode = JSRuntimeMode.Loose;
            var cut = ctx.Render(@<FormaFilePicker Options="@(new FilePickerOptions { MaxFileSize = 4 })" OnFilesSelected="@(_ => Task.CompletedTask)" />);
            cut.FindComponent<InputFile>().UploadFiles(InputFileContent.CreateFromText("far too long a body", "brief.pdf", contentType: "application/pdf"));
            Assert.Single(cut.FindAll(".forma-file-picker-rejections li"));
            var picker = cut.FindComponent<FormaFilePicker>();

            // Act
            await picker.InvokeAsync(picker.Instance.ClearAsync);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll(".forma-file-picker-rejections li")),
                () => Assert.Contains(dropZone.Invocations, invocation => invocation.Identifier == "clear"));
        }
    }
}
