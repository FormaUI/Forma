        [Fact]
        public async Task Should_write_the_time_in_the_culture_state_s_culture()
        {
            // Arrange
            using var ctx = new FormaTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var model = new Shift { Start = new TimeOnly(9, 30) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.Start" Label="Starts" />
            </FakeFormHost>);

            // Act
            await ctx.ChangeCultureAsync("de-DE");

            // Assert
            Assert.Equal("09:30", cut.Find("input").GetAttribute("value"));
        }

        [Fact]
        public void Should_render_an_editable_combobox_in_a_field_showing_the_time_as_the_culture_writes_it()
        {
            // Arrange
            using var ctx = new FormaTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var model = new Shift { Start = new TimeOnly(9, 30) };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.Start" Label="Starts" />
            </FakeFormHost>);

            // Assert
            var input = cut.Find("input");
            Assert.Multiple(
                () => Assert.Equal("combobox", input.GetAttribute("role")),
                () => Assert.Equal("false", input.GetAttribute("aria-expanded")),
                () => Assert.Equal("none", input.GetAttribute("aria-autocomplete")),
                () => Assert.Null(input.GetAttribute("aria-controls")),
                () => Assert.Equal(FormatInEnglish("9:30 AM"), input.GetAttribute("value")),
                () => Assert.Equal("Starts", cut.Find("label.forma-field-label").FirstChild!.TextContent.Trim()),
                () => Assert.Equal("Choose a Time", cut.Find("button").GetAttribute("aria-label")),
                () => Assert.Equal("-1", cut.Find("button").GetAttribute("tabindex")));
        }

