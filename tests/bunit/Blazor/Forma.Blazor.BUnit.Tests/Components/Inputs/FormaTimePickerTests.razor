        [Fact]
        public void Should_mark_a_time_required_where_it_cannot_be_empty_or_the_host_asks()
        {
            // Arrange
            using var ctx = new FormaTimePickerTests();
            var model = new Shift();

            // Act
            var optional = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.End" Label="Ends" />
            </FakeFormHost>);
            var asked = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.End" Label="Ends" Required="true" />
            </FakeFormHost>);
            var inherent = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.Start" Label="Starts" />
            </FakeFormHost>);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(optional.FindAll(".forma-field-required")),
                () => Assert.Null(optional.Find("input").GetAttribute("aria-required")),
                () => Assert.Single(asked.FindAll(".forma-field-required")),
                () => Assert.Equal("true", asked.Find("input").GetAttribute("aria-required")),
                () => Assert.Single(inherent.FindAll(".forma-field-required")),
                () => Assert.Equal("true", inherent.Find("input").GetAttribute("aria-required")));
        }

