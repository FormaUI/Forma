    public sealed class List
    {
        private static IReadOnlyList<string> GetOptions(IRenderedComponent<IComponent> cut)
            => [.. cut.FindAll("[role=option]").Select(option => option.TextContent.Trim())];

        [Fact]
        public void Should_claim_the_arrows_alone_while_the_list_is_closed_leaving_enter_to_the_form()
        {
            // Arrange
            using var ctx = new FormaTimePickerTests();
            var router = new InputRouterProbe(ctx);
            var model = new Shift();

            // Act
            ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.End" Label="Ends" />
            </FakeFormHost>);

            // Assert
            Assert.Equal(["time-box.next:ArrowDown", "time-box.previous:ArrowUp"], InputRouterProbe.GetRoutes(router.Registrations.Last(registration => InputRouterProbe.GetRoutes(registration).Any(route => route.StartsWith("time-box.", StringComparison.Ordinal)))));
        }

        [Fact]
        public async Task Should_open_on_the_suggestion_nearest_the_time_held_and_name_it_from_the_field()
        {
            // Arrange
            using var ctx = new FormaTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var router = new InputRouterProbe(ctx);
            var model = new Shift { End = new TimeOnly(9, 40) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.End" Label="Ends" />
            </FakeFormHost>);

            // Act
            await router.RouteAsync("time-box.next", "ArrowDown");

            // Assert — 9:30 is the nearest half hour to 9:40
            var input = cut.Find("input");
            var active = cut.Find(".forma-time-box-option-active");
            Assert.Multiple(
                () => Assert.Equal("true", input.GetAttribute("aria-expanded")),
                () => Assert.Equal(cut.Find("[role=listbox]").Id, input.GetAttribute("aria-controls")),
                () => Assert.Equal(active.Id, input.GetAttribute("aria-activedescendant")),
                () => Assert.Equal(FormatInEnglish("9:30 AM"), active.TextContent.Trim()),
                () => Assert.Equal("true", active.GetAttribute("aria-selected")));
        }

        [Fact]
        public async Task Should_place_each_suggestion_drawn_among_every_suggestion_the_list_holds()
        {
            // Arrange
            using var ctx = new FormaTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var router = new InputRouterProbe(ctx);
            var model = new Shift { End = new TimeOnly(9, 30) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.End" Label="Ends" />
            </FakeFormHost>);

            // Act
            await router.RouteAsync("time-box.next", "ArrowDown");

            // Assert — a day of half hours holds 48 suggestions, and 9:30 AM is the 20th
            var active = cut.Find(".forma-time-box-option-active");
            Assert.Multiple(
                () => Assert.All(cut.FindAll("[role=option]"), option => Assert.Equal("48", option.GetAttribute("aria-setsize"))),
                () => Assert.Equal("20", active.GetAttribute("aria-posinset")));
        }

        [Fact]
        public async Task Should_move_through_the_list_with_the_arrows_and_take_the_highlighted_time_on_enter()
        {
            // Arrange
            using var ctx = new FormaTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var router = new InputRouterProbe(ctx);
            var model = new Shift { End = new TimeOnly(9, 30) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.End" Label="Ends" />
            </FakeFormHost>);
            await router.RouteAsync("time-box.next", "ArrowDown");

            // Act — down twice and back once, from 9:30 to 10:00
            await router.RouteAsync("time-box.next", "ArrowDown");
            await router.RouteAsync("time-box.next", "ArrowDown");
            await router.RouteAsync("time-box.previous", "ArrowUp");
            var held = model.End;
            await router.RouteAsync(cut.FindComponent<FormaTimeBox>().Instance.InputElement, "time-box.choose", "Enter");

            // Assert — the arrows move the list alone, and Enter writes the time and closes it
            Assert.Multiple(
                () => Assert.Equal(new TimeOnly(9, 30), held),
                () => Assert.Equal(new TimeOnly(10, 0), model.End),
                () => Assert.Equal(FormatInEnglish("10:00 AM"), cut.Find("input").GetAttribute("value")),
                () => Assert.Equal("false", cut.Find("input").GetAttribute("aria-expanded")));
        }

        [Fact]
        public async Task Should_close_its_list_once_the_focus_leaves_the_field()
        {
            // Arrange
            using var ctx = new FormaTimePickerTests();
            var probe = new DomProbe<FocusState>(ctx);
            var router = new InputRouterProbe(ctx);
            var model = new Shift { End = new TimeOnly(9, 30) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.End" Label="Ends" />
            </FakeFormHost>);
            await probe.ReportAsync(new FocusState(IsWithin: true));
            await router.RouteAsync("time-box.next", "ArrowDown");
            var isOpenWithin = cut.Find("input").GetAttribute("aria-expanded");

            // Act
            await probe.ReportAsync(new FocusState(IsWithin: false));

            // Assert
            Assert.Multiple(
                () => Assert.Equal("true", isOpenWithin),
                () => Assert.Equal("false", cut.Find("input").GetAttribute("aria-expanded")),
                () => Assert.Equal(new TimeOnly(9, 30), model.End));
        }

        [Fact]
        public async Task Should_close_on_escape_without_taking_the_highlighted_time()
        {
            // Arrange
            using var ctx = new FormaTimePickerTests();
            var router = new InputRouterProbe(ctx);
            var model = new Shift { End = new TimeOnly(9, 30) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTimePicker @bind-Value="model.End" Label="Ends" />
            </FakeFormHost>);
            await router.RouteAsync("time-box.next", "ArrowDown");
            await router.RouteAsync("time-box.next", "ArrowDown");

            // Act
            await router.DismissAsync(cut.FindComponent<FormaPopover>().Instance.RootElement, DismissBehavior.Dismiss, DismissReason.Escape);

            // Assert
            Assert.Multiple(
                () => Assert.Equal(new TimeOnly(9, 30), model.End),
                () => Assert.Equal("false", cut.Find("input").GetAttribute("aria-expanded")));
        }

