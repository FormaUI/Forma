@inherits FormaBunitContext
@using System.Globalization
@using Microsoft.Extensions.Logging
@code {
    public sealed class Component
    {
        [Fact]
        public async Task Should_show_the_value_in_the_culture_state_s_culture()
        {
            // Arrange
            using var ctx = new FormaSliderTests();
            using var culture = new CultureFixture("en-US");
            var model = new FakeModel { Ratio = 0.5 };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSlider @bind-Value="model.Ratio" Label="Duration" Min="0.5" Max="5" Step="0.5" Unit="s" />
            </FakeFormHost>);

            // Act
            await ctx.ChangeCultureAsync("de-DE");

            // Assert
            Assert.Equal("0,5s", cut.Find(".forma-slider-value").TextContent);
        }

        [Fact]
        public void Should_render_a_range_input()
        {
            // Arrange
            using var ctx = new FormaSliderTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSlider @bind-Value="model.Number" Label="Border radius" Min="0" Max="20" />
            </FakeFormHost>);

            // Assert
            Assert.Equal("range", cut.Find(".forma-slider").GetAttribute("type"));
        }

        [Fact]
        public void Should_render_the_label_text()
        {
            // Arrange
            using var ctx = new FormaSliderTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSlider @bind-Value="model.Number" Label="Border radius" Min="0" Max="20" />
            </FakeFormHost>);

            // Assert
            Assert.Contains("Border radius", cut.Find(".forma-field-label").TextContent, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_apply_min_max_and_step_to_the_input()
        {
            // Arrange
            using var ctx = new FormaSliderTests();
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSlider @bind-Value="model.Number" Label="Border radius" Min="0" Max="20" Step="2" />
            </FakeFormHost>);

            // Assert
            var input = cut.Find(".forma-slider");
            Assert.Equal("0", input.GetAttribute("min"));
            Assert.Equal("20", input.GetAttribute("max"));
            Assert.Equal("2", input.GetAttribute("step"));
        }

