            // Arrange
            using var ctx = new FormaSliderTests();
            var model = new FakeModel();

            // Act
            var act = () => ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSlider @bind-Value="model.Number" Label="Border radius" Min="20" Max="0" />
            </FakeFormHost>);

