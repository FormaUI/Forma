            </FakeFormHost>);

            // Assert
            Assert.Equal("1", cut.Find(".forma-slider").GetAttribute("step"));
        }

        [Fact]
        public void Should_display_the_current_value_beside_the_label()
        {
            // Arrange
            using var ctx = new FormaSliderTests();
            var model = new FakeModel { Number = 8 };

