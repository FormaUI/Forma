        [Theory]
        [InlineData(TextUpdate.Input)]
        [InlineData(TextUpdate.Change)]
        public void Should_handle_no_event_of_its_textarea_in_net_since_each_would_carry_its_whole_text(TextUpdate updateOn)
        {
            // Arrange
            using var ctx = new FormaTextAreaTests();
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextArea @bind-Value="model.Text" Label="Notes" UpdateOn="updateOn" />
            </FakeFormHost>);
            var textarea = cut.Find("textarea");

            // Act
            var typing = () => textarea.Input("typed");
            var committing = () => textarea.Change("typed");

            // Assert
            Assert.Multiple(
                () => Assert.Throws<MissingEventHandlerException>(typing),
                () => Assert.Throws<MissingEventHandlerException>(committing));
        }

        [Fact]
        public async Task Should_take_its_value_and_tell_the_form_as_its_edit_commits_when_it_updates_on_change()
        {
            // Arrange
            using var ctx = new FormaTextAreaTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel();
            var editContext = new EditContext(model);
            var changedFields = new List<string>();
            editContext.OnFieldChanged += (_, args) => changedFields.Add(args.FieldIdentifier.FieldName);
            var cut = ctx.Render(@<FakeFormHost EditContext="editContext">
                <FormaTextArea @bind-Value="model.Text" Label="Notes" UpdateOn="TextUpdate.Change" />
            </FakeFormHost>);

            // Act
            await fields.ChangeAsync(cut.Find("textarea"), "typed");

            // Assert
            Assert.Multiple(
                () => Assert.Equal("typed", model.Text),
                () => Assert.Equal([nameof(FakeModel.Text)], changedFields));
        }

        [Theory]
        [InlineData(TextUpdate.Input)]
        [InlineData(TextUpdate.Change)]
        public void Should_count_in_the_browser_as_the_reader_types_whichever_way_it_updates(TextUpdate updateOn)
        {
            // Arrange
            using var ctx = new FormaTextAreaTests();
            var probe = new DomProbe<FocusState>(ctx);
            var model = new FakeModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextArea Id="notes" @bind-Value="model.Text" Label="Notes" UpdateOn="updateOn" ShowCharacterCount="true" MaxLength="280" />
            </FakeFormHost>);

            // Assert
            var count = DomProbe<FocusState>.GetOption(Assert.Single(probe.Interactions, attach => DomProbe<FocusState>.GetRequestField(attach, "capability") is "edits"), "count")!;
            Assert.Multiple(
                () => Assert.Equal("notes-count-value", InteropPayload.GetValue(count, "output")),
                () => Assert.Equal(280, InteropPayload.GetValue(count, "maxLength")),
                () => Assert.Equal("notes-count-value", cut.Find(".forma-textarea-count bdi").Id));
        }

