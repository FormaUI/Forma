        [Fact]
        public async Task Should_render_the_count_of_a_text_the_host_writes_over_the_reader_s()
        {
            // Arrange
            using var ctx = new FormaTextAreaTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel();
            var cut = ctx.Render<FormaTextArea>(parameters => parameters
                .Add(p => p.Value, model.Text)
                .Add(p => p.ValueExpression, () => model.Text)
                .Add(p => p.Label, "Notes")
                .Add(p => p.MaxLength, 280)
                .Add(p => p.ShowCharacterCount, true));
            await fields.TypeAsync(cut.Find("textarea"), "hello");

            // Act
            cut.Render(parameters => parameters.Add(p => p.Value, "Hi"));

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Hi", fields.GetText(cut.Find("textarea"))),
                () => Assert.Equal("2 / 280", cut.Find(".forma-textarea-count bdi").TextContent));
        }

