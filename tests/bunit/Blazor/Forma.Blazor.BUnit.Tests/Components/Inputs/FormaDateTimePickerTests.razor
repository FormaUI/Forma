@code {
    public sealed class Component
    {
        [Fact]
        public void Should_name_a_group_by_its_label_and_each_control_by_a_name_of_its_own()
        {
            // Arrange
            using var ctx = new FormaDateTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var model = new Booking { Starts = new DateTime(2026, 3, 15, 9, 30, 0) };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDateTimePicker @bind-Value="model.Starts" Label="Starts" />
            </FakeFormHost>);

            // Assert
            var group = cut.Find("[role=group]");
            var trigger = GetTrigger(cut);
            var names = trigger.GetAttribute("aria-labelledby")!.Split(' ').Select(id => cut.Find($"[id='{id}']").TextContent.Trim());
            var time = GetTime(cut);
            Assert.Multiple(
                () => Assert.Equal("Starts", cut.Find($"[id='{group.GetAttribute("aria-labelledby")}']").FirstChild!.TextContent.Trim()),
                () => Assert.Empty(cut.FindAll("label[for]")),
                () => Assert.Single(cut.FindAll(".forma-field")),
                () => Assert.Equal(["Date", "3/15/2026"], names),
                () => Assert.Equal("Time", time.GetAttribute("aria-label")),
                () => Assert.Equal(FormatInEnglish("9:30 AM"), time.GetAttribute("value")));
        }

        [Fact]
        public void Should_refuse_a_value_that_is_not_a_date_with_a_time()
        {
            // Arrange
            using var ctx = new FormaDateTimePickerTests();
            var model = new Booking();

            // Act
