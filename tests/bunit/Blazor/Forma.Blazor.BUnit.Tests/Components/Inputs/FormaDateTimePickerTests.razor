            var cut = ctx.Render<FormaDateTimePicker<DateTime?>>(parameters => parameters
                .Add(p => p.Label, "Starts")
                .Add(p => p.Value, model.Starts)
                .Add(p => p.ValueExpression, () => model.Starts));
            await fields.TypeAsync(cut.Find("input[role=combobox]"), "1:30 אחה״צ");
            await ctx.ChangeCultureAsync("en-US");

            // Act
            cut.Render(parameters => parameters.Add(p => p.Value, new DateTime(2026, 3, 15, 14, 0, 0)));

