                <FormaDateTimePicker @bind-Value="model.Note" Label="Note" />
            </FakeFormHost>);

            // Assert
            Assert.Throws<InvalidOperationException>(render);
        }

        [Fact]
        public void Should_mark_both_controls_required_where_the_value_cannot_be_empty()
        {
            // Arrange
            using var ctx = new FormaDateTimePickerTests();
            var model = new Booking();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDateTimePicker @bind-Value="model.Reminder" Label="Reminder" />
                <FormaDateTimePicker @bind-Value="model.Starts" Label="Starts" />
            </FakeFormHost>);

            // Assert
            var triggers = cut.FindAll(".forma-date-box-trigger");
            var times = cut.FindAll("input[role=combobox]");
            Assert.Multiple(
                () => Assert.Equal("true", triggers[0].GetAttribute("aria-required")),
                () => Assert.Equal("true", times[0].GetAttribute("aria-required")),
                () => Assert.Single(cut.FindAll(".forma-field")[0].QuerySelectorAll(".forma-field-required")),
                () => Assert.Null(triggers[1].GetAttribute("aria-required")),
                () => Assert.Empty(cut.FindAll(".forma-field")[1].QuerySelectorAll(".forma-field-required")));
        }

        [Fact]
        public void Should_show_a_read_only_value_as_text_with_nothing_to_open_or_clear()
        {
            // Arrange
            using var ctx = new FormaDateTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var model = new Booking { Starts = new DateTime(2026, 3, 15, 9, 30, 0) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDateTimePicker @bind-Value="model.Starts" Label="Starts" ReadOnly="true" />
            </FakeFormHost>);

            // Act
            var date = cut.Find("input.forma-date-box-trigger");

            // Assert
            Assert.Multiple(
                () => Assert.Throws<MissingEventHandlerException>(() => date.Click()),
                () => Assert.True(date.HasAttribute("readonly")),
                () => Assert.Equal("3/15/2026", date.GetAttribute("value")),
                () => Assert.Equal("Date", cut.Find($"[id='{date.GetAttribute("aria-labelledby")}']").TextContent.Trim()),
                () => Assert.True(GetTime(cut).HasAttribute("readonly")),
                () => Assert.Empty(cut.FindAll(".forma-date-box-clear")),
                () => Assert.Empty(cut.FindAll(".forma-date-box-popover")),
                () => Assert.Equal(new DateTime(2026, 3, 15, 9, 30, 0), model.Starts));
        }

        [Fact]
        public void Should_pass_the_dates_of_its_bounds_to_the_calendar()
        {
            // Arrange
            using var ctx = new FormaDateTimePickerTests();
            var model = new Booking { Starts = new DateTime(2026, 3, 16, 9, 0, 0) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDateTimePicker @bind-Value="model.Starts" Label="Starts" Min="new DateTime(2026, 3, 15, 14, 0, 0)" Max="new DateTime(2026, 3, 17, 11, 0, 0)" />
            </FakeFormHost>);

            // Act
            GetTrigger(cut).Click();

            // Assert
            var calendar = cut.FindComponent<FormaCalendar>().Instance;
            Assert.Multiple(
                () => Assert.Equal(new DateOnly(2026, 3, 15), calendar.MinDate),
                () => Assert.Equal(new DateOnly(2026, 3, 17), calendar.MaxDate));
        }
    }

