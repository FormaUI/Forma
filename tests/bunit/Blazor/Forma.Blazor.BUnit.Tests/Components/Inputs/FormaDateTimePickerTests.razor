        [Fact]
        public async Task Should_run_its_form_s_actions_with_the_time_typed_once_it_arrives()
        {
            // Arrange — the typed time still on its way as the reader presses the form's button
            using var ctx = new FormaDateTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var fields = new TextFieldProbe(ctx);
            var model = new Booking { Starts = new DateTime(2026, 3, 15, 9, 30, 0) };
            var saved = new List<DateTime?>();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDateTimePicker @bind-Value="model.Starts" Label="Starts" />
                <FormaButton Type="ButtonType.Submit" OnClick="@(() => saved.Add(model.Starts))">Save</FormaButton>
            </FakeFormHost>);
            var typing = fields.CommitHeld(GetTime(cut), "2:30 PM");

            // Act
            var saving = cut.FindAll("button").Single(button => button.TextContent.Trim() == "Save").ClickAsync(new());
            var savedEarly = saved.ToList();
            await typing.ReleaseAsync();
            await saving;

            // Assert
            Assert.Multiple(
                () => Assert.Empty(savedEarly),
                () => Assert.Equal<DateTime?>([new DateTime(2026, 3, 15, 14, 30, 0)], saved));
        }

        [Fact]
        public async Task Should_say_on_its_field_that_its_time_s_text_did_not_arrive_and_take_it_off_once_it_does()
        {
            // Arrange — the form's messages as each change of its validation state leaves them
            using var ctx = new FormaDateTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var fields = new TextFieldProbe(ctx);
            var model = new Booking { Starts = new DateTime(2026, 3, 15, 9, 30, 0) };
            var form = new EditContext(model);
            var states = new List<IReadOnlyList<string>>();
            form.OnValidationStateChanged += (_, _) => states.Add([.. form.GetValidationMessages()]);
            var cut = ctx.Render(@<FakeFormHost EditContext="@form">
                <FormaDateTimePicker @bind-Value="model.Starts" Label="Starts" />
            </FakeFormHost>);

            // Act — a long text whose stream breaks, and the whole text the browser sends in its place too, then the reader's next edit
            await fields.CommitBrokenAsync(GetTime(cut), "2:30 PM");
            await fields.ChangeAsync(GetTime(cut), "3:15 PM");

            // Assert
            Assert.Multiple(
                () => Assert.Equal([["Your text didn't arrive in full. Edit it to try again."], []], states),
                () => Assert.Empty(cut.FindAll(".forma-field-message")),
                () => Assert.Equal(new DateTime(2026, 3, 15, 15, 15, 0), model.Starts));
        }

