    private static IElement GetTrigger(IRenderedComponent<IComponent> cut)
        => cut.Find(".forma-date-box-trigger");

    private static IElement GetTime(IRenderedComponent<IComponent> cut)
        => cut.Find("input[role=combobox]");

    // The focus within the picker's field, which the picker watches apart from the time box inside it.
    private static Task ReportFocusAsync(DomProbe<FocusState> probe, IRenderedComponent<IComponent> cut, bool isWithin)
        => probe.ReportAsync(GetTime(cut).GetAttribute("data-rid")!, new FocusState(isWithin));

    private static void PickDay(IRenderedComponent<IComponent> cut, string day)
    {
        GetTrigger(cut).Click();
        cut.FindAll(".forma-calendar-day").First(element => element.TextContent.Trim() == day && !element.ClassList.Contains("empty")).Click();
    }

    private sealed class Booking
    {
        public DateTime? Starts { get; set; }

        public DateTime Reminder { get; set; }

        public DateTimeOffset? Departure { get; set; }

        public DateTimeOffset? Arrival { get; set; }

        public string? Note { get; set; }
    }

    private static string FormatInEnglish(string text)
        => CultureText.FormatTimes(text, CultureInfo.GetCultureInfo("en-US"));
}
