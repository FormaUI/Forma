    public sealed class EditInProgress
    {
        [Fact]
        public async Task Should_commit_a_time_in_the_culture_it_was_typed_in_after_the_culture_changes()
        {
            // Arrange — Hebrew reads the text as half past one in the afternoon, and English refuses it
            using var ctx = new FormaDateTimePickerTests();
            var fields = new TextFieldProbe(ctx);
            using var culture = new CultureFixture(PinnedCultures.Hebrew);
            var model = new Booking { Starts = new DateTime(2026, 3, 15, 9, 0, 0) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDateTimePicker @bind-Value="model.Starts" Label="Starts" />
            </FakeFormHost>);
            await fields.TypeAsync(GetTime(cut), "1:30 אחה״צ");
            await ctx.ChangeCultureAsync("en-US");
            var textAfterChange = fields.GetText(GetTime(cut));

            // Act
            await fields.ChangeAsync(GetTime(cut), "1:30 אחה״צ");

            // Assert
            Assert.Multiple(
                () => Assert.Equal("1:30 אחה״צ", textAfterChange),
                () => Assert.Equal(new DateTime(2026, 3, 15, 13, 30, 0), model.Starts),
                () => Assert.Equal(FormatInEnglish("1:30 PM"), fields.GetText(GetTime(cut))));
        }

        [Fact]
        public async Task Should_keep_a_time_it_read_as_typed_while_the_field_waits_for_its_date()
        {
            // Arrange
            using var ctx = new FormaDateTimePickerTests();
            var fields = new TextFieldProbe(ctx);
            using var culture = new CultureFixture(PinnedCultures.Hebrew);
            var model = new Booking();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDateTimePicker @bind-Value="model.Starts" Label="Starts" />
            </FakeFormHost>);
            await fields.TypeAsync(GetTime(cut), "1:30 אחה״צ");
            await fields.ChangeAsync(GetTime(cut), "1:30 אחה״צ");
            await ctx.ChangeCultureAsync("en-US");
            var textAfterChange = fields.GetText(GetTime(cut));

            // Act
            PickDay(cut, "15");

            // Assert
            Assert.Multiple(
                () => Assert.Equal("1:30 אחה״צ", textAfterChange),
                () => Assert.Equal(15, model.Starts!.Value.Day),
                () => Assert.Equal(new TimeSpan(13, 30, 0), model.Starts!.Value.TimeOfDay),
                () => Assert.Equal(FormatInEnglish("1:30 PM"), fields.GetText(GetTime(cut))));
        }

