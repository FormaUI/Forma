            </FakeFormHost>);

            // Act
            await fields.ChangeAsync(cut.FindAll("input[role=combobox]")[0], "10:00 AM");
            await fields.ChangeAsync(cut.FindAll("input[role=combobox]")[1], "6:00 PM");
            cut.FindAll(".forma-date-box-trigger")[1].Click();
