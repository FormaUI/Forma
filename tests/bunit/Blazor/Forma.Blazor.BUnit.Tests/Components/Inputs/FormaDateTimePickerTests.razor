        [Theory]
        [InlineData(15, 14, 20, "2:00 PM")]
        [InlineData(16, 0, 48, "12:00 AM")]
        [InlineData(17, 0, 23, "12:00 AM")]
        public async Task Should_suggest_only_the_times_the_date_allows(int day, int hour, int count, string first)
        {
            // Arrange — the value at the date's first time, which the list opens on
            using var ctx = new FormaDateTimePickerTests();
            using var culture = new CultureFixture("en-US");
            var router = new InputRouterProbe(ctx);
            var model = new Booking { Starts = new DateTime(2026, 3, day, hour, 0, 0) };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaDateTimePicker @bind-Value="model.Starts" Label="Starts" Min="new DateTime(2026, 3, 15, 14, 0, 0)" Max="new DateTime(2026, 3, 17, 11, 0, 0)" />
            </FakeFormHost>);

            // Act
            await router.RouteAsync("time-box.next", "ArrowDown");

            // Assert
            var options = cut.FindAll("[role=option]");
            Assert.Multiple(
                () => Assert.All(options, option => Assert.Equal(count.ToString(CultureInfo.InvariantCulture), option.GetAttribute("aria-setsize"))),
                () => Assert.Equal(FormatInEnglish(first), options.Single(option => option.GetAttribute("aria-posinset") == "1").TextContent.Trim()));
        }

