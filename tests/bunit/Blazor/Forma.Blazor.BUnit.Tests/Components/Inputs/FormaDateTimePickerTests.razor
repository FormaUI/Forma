                () => Assert.Equal(TimeSpan.FromHours(5.5), model.Departure!.Value.Offset),
                () => Assert.Equal(TimeSpan.FromHours(3), model.Arrival!.Value.Offset),
                () => Assert.Equal(new TimeSpan(18, 0, 0), model.Arrival!.Value.TimeOfDay));
