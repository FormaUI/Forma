            var chosen = cut.Find("option[selected]");
            Assert.Multiple(
                () => Assert.Equal(string.Empty, chosen.GetAttribute("value")),
                () => Assert.Equal("Pick one", chosen.TextContent));
        }

        [Fact]
        public void Should_keep_its_trigger_disabled_before_the_renderer_is_interactive_where_its_values_post_no_text_a_form_binds()
        {
            // Arrange
            using var ctx = new FormaSelectTests();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));
            var sport = new Sport("Running");
            IReadOnlyList<SelectOption<Sport>> sports = [new(new Sport("Cycling"), "Cycling"), new(sport, "Running")];

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(new FakeModel()))">
                <FormaSelect TValue="Sport" @bind-Value="sport" Options="sports" Label="Sport" />
            </FakeFormHost>);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll("select")),
                () => Assert.True(cut.Find(".forma-select-trigger").HasAttribute("disabled")));
        }

        private sealed record Sport(string Name);
    }
