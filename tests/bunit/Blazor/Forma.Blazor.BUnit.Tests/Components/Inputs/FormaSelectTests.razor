        [Fact]
        public async Task Should_pass_over_an_option_that_can_t_be_chosen_as_the_arrows_move()
        {
            // Arrange
            using var ctx = new FormaSelectTests();
            var router = new InputRouterProbe(ctx);
            var model = new FakeModel { Status = 1 };
            List<SelectOption<int?>> options = [new(1, "Cycling"), new(2, "Running") { IsDisabled = true }, new(3, "Swimming")];
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaSelect TValue="int?" @bind-Value="model.Status" Options="options" Label="Status" />
            </FakeFormHost>);
            cut.Find(".forma-select-trigger").Click();
            var popover = cut.FindComponent<FormaPopover>().Instance;
            var openedOn = GetFocused(ctx.JSInterop).Last();
            var opened = GetFocused(ctx.JSInterop).Count;

            // Act — from the first, down to the third, round to the first, and up to the third again
            foreach (var (action, key) in new[] { ("select.next", "ArrowDown"), ("select.next", "ArrowDown"), ("select.previous", "ArrowUp") })
            {
                await router.RouteAsync(popover.RootElement, action, key);
            }

            // Assert: the second, which can't be chosen, never takes the focus
            var focused = GetFocused(ctx.JSInterop).Skip(opened).ToList();
            Assert.Multiple(
                () => Assert.Equal(3, focused.Count),
                () => Assert.NotEqual(openedOn, focused[0]),
                () => Assert.Equal(openedOn, focused[1]),
                () => Assert.Equal(focused[0], focused[2]));
        }

