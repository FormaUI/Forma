@inherits FormaBunitContext
@using Microsoft.Extensions.DependencyInjection
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_input_element_with_forma_search_box_class()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox />);

            // Assert
            Assert.NotNull(cut.Find("input.forma-search-box"));
        }

        [Fact]
        public void Should_render_a_search_type()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox />);

            // Assert
            Assert.Equal("search", cut.Find("input").GetAttribute("type"));
        }

        [Fact]
        public void Should_render_leading_magnifying_glass_icon()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox />);

            // Assert
            Assert.NotNull(cut.Find(".forma-search-box-icon svg"));
        }

        [Fact]
        public void Should_render_placeholder_when_specified()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox Options="@(new SearchBoxOptions { Placeholder = "Search articles..." })" />);

            // Assert
            Assert.Equal("Search articles...", cut.Find("input").GetAttribute("placeholder"));
        }

        [Fact]
        public void Should_render_initial_value()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox Value="banner" />);

            // Assert
            Assert.Equal("banner", cut.Find("input").GetAttribute("value"));
        }

        [Fact]
        public async Task Should_update_value_on_input()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();
            var fields = new TextFieldProbe(ctx);
            string? bound = null;

            // Act
            var cut = ctx.Render(@<FormaSearchBox Value="@bound" ValueChanged="v => bound = v" />);
            await fields.TypeAsync(cut.Find("input"), "cover");

            // Assert
            Assert.Equal("cover", bound);
        }

        [Fact]
        public async Task Should_raise_on_search_instantly_without_a_debounce_delay()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();
            var fields = new TextFieldProbe(ctx);
            var searched = new List<string>();

            // Act
            var cut = ctx.Render(@<FormaSearchBox OnSearch="v => searched.Add(v)" />);
            await fields.TypeAsync(cut.Find("input"), "cover");

            // Assert
            Assert.Equal(["cover"], searched);
        }

        [Fact]
        public async Task Should_debounce_the_search_by_the_configured_delay()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();
            var fields = new TextFieldProbe(ctx);
            var debouncer = new RecordingDebounceable();
            ctx.Services.AddSingleton<IDebounceable>(debouncer);
            var searched = new List<string>();
            var delay = TimeSpan.FromMilliseconds(150);
            var cut = ctx.Render(@<FormaSearchBox Options="@(new SearchBoxOptions { DebounceDelay = delay })" OnSearch="v => searched.Add(v)" />);

            // Act
            await fields.TypeAsync(cut.Find("input"), "cov");

            // Assert
            Assert.Multiple(
                () => Assert.Equal([delay], debouncer.Delays),
                () => Assert.Equal(["cov"], searched));
        }

        [Fact]
        public async Task Should_search_at_once_without_a_debounce()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();
            var fields = new TextFieldProbe(ctx);
            var debouncer = new RecordingDebounceable();
            ctx.Services.AddSingleton<IDebounceable>(debouncer);
            var searched = new List<string>();
            var cut = ctx.Render(@<FormaSearchBox OnSearch="v => searched.Add(v)" />);

            // Act
            await fields.TypeAsync(cut.Find("input"), "cov");

            // Assert
            Assert.Multiple(
                () => Assert.Equal([TimeSpan.Zero], debouncer.Delays),
                () => Assert.Equal(["cov"], searched));
        }

        [Fact]
        public async Task Should_abandon_a_pending_search_when_enter_commits_one()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();
            var fields = new TextFieldProbe(ctx);
            var router = new InputRouterProbe(ctx);
            var debouncer = new RecordingDebounceable();
            ctx.Services.AddSingleton<IDebounceable>(debouncer);
            var searched = new List<string>();
            var cut = ctx.Render(@<FormaSearchBox Options="@(new SearchBoxOptions { DebounceDelay = TimeSpan.FromSeconds(30) })" OnSearch="v => searched.Add(v)" />);
            var input = cut.Find("input");

            // Act
            await fields.TypeAsync(input, "cover");
            await router.RouteAsync("search-box.search", "Enter");

            // Assert
            Assert.Multiple(
                () => Assert.Equal(1, debouncer.Cancellations),
                () => Assert.Equal(["cover", "cover"], searched));
        }

        [Fact]
        public void Should_reject_a_negative_debounce_delay()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var render = () => ctx.Render(@<FormaSearchBox Options="@(new SearchBoxOptions { DebounceDelay = TimeSpan.FromMilliseconds(-1) })" />);

            // Assert
            Assert.Throws<ArgumentOutOfRangeException>(render);
        }

        [Fact]
        public void Should_reject_null_options()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var render = () => ctx.Render(@<FormaSearchBox Options="null" />);

            // Assert
            Assert.Throws<ArgumentNullException>(render);
        }

        [Fact]
        public void Should_not_render_clear_button_when_empty()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox />);

            // Assert
            Assert.Empty(cut.FindAll(".forma-search-box-clear"));
        }

        [Fact]
        public void Should_render_clear_button_when_populated()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox Value="banner" />);

            // Assert
            Assert.NotNull(cut.Find(".forma-search-box-clear button"));
        }

        [Fact]
        public void Should_clear_value_and_raise_search_immediately_when_cleared()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();
            string? bound = "banner";
            var searched = new List<string>();
            var delay = TimeSpan.FromSeconds(30);

            // Act
            var cut = ctx.Render(@<FormaSearchBox Value="@bound" ValueChanged="v => bound = v" Options="@(new SearchBoxOptions { DebounceDelay = delay })" OnSearch="v => searched.Add(v)" />);
            cut.Find(".forma-search-box-clear button").Click();

            // Assert
            Assert.Equal(string.Empty, bound);
            cut.WaitForAssertion(() => Assert.Equal([string.Empty], searched));
        }

        [Fact]
        public async Task Should_raise_on_search_immediately_on_enter_bypassing_debounce()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();
            var fields = new TextFieldProbe(ctx);
            var router = new InputRouterProbe(ctx);
            var searched = new List<string>();
            var delay = TimeSpan.FromSeconds(30);

            // Act
            var cut = ctx.Render(@<FormaSearchBox Options="@(new SearchBoxOptions { DebounceDelay = delay })" OnSearch="v => searched.Add(v)" />);
            var input = cut.Find("input");
            await fields.TypeAsync(input, "cover");
            await router.RouteAsync("search-box.search", "Enter");

            // Assert
            cut.WaitForAssertion(() => Assert.Equal(["cover"], searched));
        }

        [Fact]
        public void Should_support_disabled_attribute()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox Options="@(new SearchBoxOptions { Disabled = true })" />);

            // Assert
            Assert.True(cut.Find("input").HasAttribute("disabled"));
        }

        [Fact]
        public void Should_disable_the_clear_button_when_the_field_is_disabled()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox Value="banner" Options="@(new SearchBoxOptions { Disabled = true })" />);

            // Assert
            Assert.True(cut.Find(".forma-search-box-clear button").HasAttribute("disabled"));
        }

        [Fact]
        public void Should_render_id_when_specified()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox Id="site-search" />);

            // Assert
            Assert.Equal("site-search", cut.Find("input").GetAttribute("id"));
        }

        [Fact]
        public void Should_pass_through_unmatched_attributes()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox aria-label="Search the site" />);

            // Assert
            Assert.Equal("Search the site", cut.Find("input").GetAttribute("aria-label"));
        }

        [Fact]
        public void Should_merge_custom_class_with_forma_search_box()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox Class="demo-row-field" />);

            // Assert
            var classes = cut.Find("input").ClassList;
            Assert.Multiple(() =>
            {
                Assert.Contains("forma-search-box", classes);
                Assert.Contains("demo-row-field", classes);
            });
        }
    }

    public sealed class Label
    {
        [Fact]
        public void Should_draw_a_field_whose_pinned_label_names_the_search()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox Label="Search" />);

            // Assert
            var input = cut.Find("input");
            var label = cut.Find(".forma-field.forma-field-label-pinned label.forma-field-label");
            Assert.Multiple(
                () => Assert.Contains("Search", label.TextContent, StringComparison.Ordinal),
                () => Assert.Equal(input.Id, label.GetAttribute("for")),
                () => Assert.Contains("forma-field-input", input.ClassList));
        }

        [Fact]
        public void Should_stay_the_compact_box_without_a_label()
        {
            // Arrange
            using var ctx = new FormaSearchBoxTests();

            // Act
            var cut = ctx.Render(@<FormaSearchBox />);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll(".forma-field")),
                () => Assert.DoesNotContain("forma-field-input", cut.Find("input").ClassList));
        }
    }
}
