@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_swatch_with_current_color()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var model = new FakeModel { Color = "#FF5533" };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label="Brand color" />
            </FakeFormHost>);
            var swatch = cut.Find(".forma-color-picker-swatch");

            // Assert
            Assert.Contains("background-color: #FF5533", swatch.GetAttribute("style"));
        }

        [Fact]
        public void Should_render_hex_input_with_value()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var model = new FakeModel { Color = "#FF5533" };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label="Brand color" />
            </FakeFormHost>);

            // Assert
            Assert.Equal("#FF5533", cut.Find(".forma-color-picker-hex-input").GetAttribute("value"));
        }

        [Fact]
        public void Should_render_label_when_provided()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var model = new FakeModel { Color = "#000000" };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label="Background" />
            </FakeFormHost>);
            var label = cut.Find(".forma-field-label");

            // Assert
            Assert.Equal("Background", label.TextContent);
        }

        [Fact]
        public void Should_throw_when_the_label_is_blank()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var model = new FakeModel { Color = "#000000" };

            // Act / Assert
            Assert.Throws<ArgumentException>(() => ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label=" " />
            </FakeFormHost>));
        }

        [Fact]
        public void Should_render_native_color_input()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var model = new FakeModel { Color = "#FF5533" };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label="Brand color" />
            </FakeFormHost>);
            var native = cut.Find("input[type='color']");

            // Assert
            Assert.Equal("#FF5533", native.GetAttribute("value"));
        }

        [Fact]
        public void Should_pass_additional_attributes()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var model = new FakeModel { Color = "#000000" };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" data-testid="my-picker" Label="Brand color" />
            </FakeFormHost>);

            // Assert
            Assert.Equal("my-picker", cut.Find(".forma-color-picker-hex-input").GetAttribute("data-testid"));
        }

        [Fact]
        public void Should_not_show_alpha_by_default()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var model = new FakeModel { Color = "#000000" };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label="Brand color" />
            </FakeFormHost>);

            // Assert
            Assert.Empty(cut.FindAll(".forma-color-picker-alpha-row"));
        }

        [Fact]
        public void Should_show_alpha_when_enabled()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var model = new FakeModel { Color = "#000000" };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" ShowAlpha="true" Label="Brand color" />
            </FakeFormHost>);

            // Assert
            Assert.Single(cut.FindAll(".forma-color-picker-alpha-row"));
        }

        [Fact]
        public async Task Should_update_value_from_hex_input()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel { Color = "#FF5533" };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label="Brand color" />
            </FakeFormHost>);

            // Act
            await fields.ChangeAsync(cut.Find(".forma-color-picker-hex-input"), "#00FF00");

            // Assert
            Assert.Equal("#00FF00", model.Color);
        }

        [Fact]
        public async Task Should_keep_text_that_is_not_a_hex_color_and_report_it_by_the_field_s_name()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel { Color = "#FF5533" };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label="Brand color" />
            </FakeFormHost>);

            // Act
            await fields.ChangeAsync(cut.Find(".forma-color-picker-hex-input"), "teal");

            // Assert
            Assert.Multiple(
                () => Assert.Equal("#FF5533", model.Color),
                () => Assert.Equal("The Brand color field must be a hex color.", cut.Find(".forma-field-message").TextContent));
        }

        [Fact]
        public async Task Should_run_its_form_s_actions_with_the_hex_value_typed_once_it_arrives()
        {
            // Arrange — the typed value still on its way as the reader presses the form's button
            using var ctx = new FormaColorPickerTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel { Color = "#FF5533" };
            var saved = new List<string?>();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label="Brand color" />
                <FormaButton Type="ButtonType.Submit" OnClick="@(() => saved.Add(model.Color))">Save</FormaButton>
            </FakeFormHost>);
            var typing = fields.CommitHeld(cut.Find(".forma-color-picker-hex-input"), "#00FF00");

            // Act
            var saving = cut.FindAll("button").Single(button => button.TextContent.Trim() == "Save").ClickAsync(new());
            var savedEarly = saved.ToList();
            await typing.ReleaseAsync();
            await saving;

            // Assert
            Assert.Multiple(
                () => Assert.Empty(savedEarly),
                () => Assert.Equal(["#00FF00"], saved));
        }

        [Fact]
        public async Task Should_update_value_from_native_picker()
        {
            // Arrange
            using var ctx = new FormaColorPickerTests();
            var model = new FakeModel { Color = "#FF5533" };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaColorPicker @bind-Value="model.Color" Label="Brand color" />
            </FakeFormHost>);

            // Act
            await cut.Find("input[type='color']").InputAsync(new ChangeEventArgs { Value = "#ff0000" });

            // Assert
            Assert.Equal("#ff0000", model.Color);
        }
    }
}
