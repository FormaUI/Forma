@inherits FormaBunitContext
@using Microsoft.AspNetCore.Components.Forms
@code {
    public sealed class Validating
    {
        [Fact]
        public async Task Should_hand_a_plain_form_s_valid_submit_the_text_the_reader_typed()
        {
            // Arrange — a form of the host's own, on its valid submit alone
            using var ctx = new EditContextExtensionsTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel();
            string? submitted = null;
            var cut = ctx.Render(@<EditForm Model="model" OnValidSubmit="@(() => submitted = model.Text)">
                <FormaTextBox @bind-Value="model.Text" Label="Name" />
                <button type="submit">Save</button>
            </EditForm>);
            await fields.TypeAsync(cut.Find("input"), "Ada");

            // Act
            await cut.Find("form").SubmitAsync();

            // Assert
            Assert.Equal("Ada", submitted);
        }

        [Fact]
        public async Task Should_hand_a_plain_form_to_its_invalid_submit_while_a_field_s_text_did_not_arrive()
        {
            // Arrange — a box accepting two characters, sent a text the reader could not have typed into it
            using var ctx = new EditContextExtensionsTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel();
            var outcome = string.Empty;
            var cut = ctx.Render(@<EditForm Model="model" OnValidSubmit="@(() => outcome = "valid")" OnInvalidSubmit="@(() => outcome = "invalid")">
                <FormaTextBox @bind-Value="model.Text" Label="Name" Options="@(new TextBoxOptions { MaxLength = 2 })" />
                <button type="submit">Save</button>
            </EditForm>);
            await fields.TypeAsync(cut.Find("input"), "Ada Lovelace");

            // Act
            await cut.Find("form").SubmitAsync();

            // Assert
            Assert.Equal("invalid", outcome);
        }

        [Fact]
        public async Task Should_validate_a_form_holding_its_fields_text_once_it_settles_them()
        {
            // Arrange
            using var ctx = new EditContextExtensionsTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel();
            var form = new EditContext(model);
            var cut = ctx.Render(@<FakeFormHost EditContext="@form">
                <FormaTextBox @bind-Value="model.Text" Label="Name" />
            </FakeFormHost>);
            await fields.TypeAsync(cut.Find("input"), "Ada");

            // Act
            var isValid = await cut.InvokeAsync(() => form.ValidateAsync());

            // Assert
            Assert.Multiple(
                () => Assert.True(isValid),
                () => Assert.Equal("Ada", model.Text));
        }

        [Fact]
        public async Task Should_leave_a_form_invalid_by_its_own_rules_to_its_invalid_submit()
        {
            // Arrange
            using var ctx = new EditContextExtensionsTests();
            var model = new FakeModel();
            var form = new EditContext(model);
            var store = new ValidationMessageStore(form);
            form.OnValidationRequested += (_, _) => store.Add(FieldIdentifier.Create(() => model.Text), "Required");
            var outcome = string.Empty;
            var cut = ctx.Render(@<EditForm EditContext="form" OnValidSubmit="@(() => outcome = "valid")" OnInvalidSubmit="@(() => outcome = "invalid")">
                <FormaTextBox @bind-Value="model.Text" Label="Name" />
                <button type="submit">Save</button>
            </EditForm>);

            // Act
            await cut.Find("form").SubmitAsync();

            // Assert
            Assert.Equal("invalid", outcome);
        }
    }
}
