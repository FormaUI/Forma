                () => Assert.Equal(1, model.Status),
                () => Assert.Equal("Getafe", fields.GetText(cut.Find("input"))),
                () => Assert.Equal("true", cut.Find("input").GetAttribute("aria-expanded")),
                () => Assert.Equal("\"Getafe\" wasn't added.", cut.Find("[role=status]").TextContent.Trim()));
        }

        [Fact]
        public async Task Should_give_up_an_edit_for_a_value_bound_from_outside()
        {
            // Arrange
            using var ctx = new FormaComboBoxTests();
            var probe = new DomProbe<FocusState>(ctx);
            var fields = new TextFieldProbe(ctx, probe.Engine);
            var model = new FakeModel { Status = 1 };
            var cut = ctx.Render<FormaComboBox<int?>>(parameters => parameters
                .Add(p => p.Id, "zone")
                .Add(p => p.Label, "Time zone")
                .Add(p => p.Options, Zones)
                .Add(p => p.Value, model.Status)
                .Add(p => p.ValueExpression, () => model.Status));
            await fields.TypeAsync(cut.Find("input"), "ber");

            // Act
            cut.Render(parameters => parameters.Add(p => p.Value, 3));

            // Assert
            Assert.Equal("(UTC−05:00) Bogotá", cut.Find("input").GetAttribute("value"));
        }

        [Fact]
        public async Task Should_write_its_messages_and_the_host_s_labels_again_as_the_culture_changes()
        {
            // Arrange
            using var ctx = new FormaComboBoxTests();
            var probe = new DomProbe<FocusState>(ctx);
            var fields = new TextFieldProbe(ctx, probe.Engine);
            var model = new FakeModel();
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaComboBox TValue="int?" Id="zone" @bind-Value="model.Status" Options="Zones" Label="Time zone" />
            </FakeFormHost>);
            await fields.TypeAsync(cut.Find("input"), "tokyo");

            // Act
            await ctx.ChangeCultureAsync("es", "es");

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Sin resultados", cut.Find(".forma-combo-box-empty").TextContent.Trim()),
                () => Assert.Equal("Mostrar Opciones", cut.Find(".forma-combo-box-toggle button").GetAttribute("aria-label")));
        }

        [Fact]
        public void Should_choose_in_the_browser_s_own_list_before_the_renderer_is_interactive_each_option_posting_its_value()
        {
            // Arrange
            using var ctx = new FormaComboBoxTests();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));
            var model = new FakeModel { Status = 2 };
            List<SelectOption<int?>> options = [new(1, "Free") { IsDisabled = true }, new(2, "Team") { IsDisabled = true }, new(3, "Enterprise")];

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaComboBox TValue="int?" Id="plan" @bind-Value="model.Status" Options="options" Label="Plan" Required="true" name="Plan" />
            </FakeFormHost>);

            // Assert
            var select = cut.Find("select");
            Assert.Multiple(
                () => Assert.Equal("Plan", select.GetAttribute("name")),
                () => Assert.True(select.HasAttribute("required")),
                () => Assert.Equal(["1", "2", "3"], cut.FindAll("option").Select(option => option.GetAttribute("value"))),
                () => Assert.Equal(["Team"], cut.FindAll("option[selected]").Select(option => option.TextContent)),
                () => Assert.Equal([true, false, false], cut.FindAll("option").Select(option => option.HasAttribute("disabled"))));
        }

