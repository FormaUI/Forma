        [Fact]
        public async Task Should_offer_to_add_text_no_option_names_exactly_only_where_a_factory_is_set()
        {
            // Arrange
            using var ctx = new FormaComboBoxTests();
            var probe = new DomProbe<FocusState>(ctx);
            var fields = new TextFieldProbe(ctx, probe.Engine);
            var model = new FakeModel();
            List<SelectOption<int?>> options = [new(1, "Real Madrid"), new(2, "Valencia")];
            Func<string, Task<SelectOption<int?>?>> factory = text => Task.FromResult<SelectOption<int?>?>(new(9, text));
            var adding = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaComboBox TValue="int?" Id="adding" @bind-Value="model.Status" Options="options" Label="Team" OptionFactory="factory" />
            </FakeFormHost>);
            var listing = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaComboBox TValue="int?" Id="listing" @bind-Value="model.Status" Options="options" Label="Team" />
            </FakeFormHost>);

            // Act
            await fields.TypeAsync(adding.Find("input"), "Getafe");
            var offered = GetEntries(adding);
            await fields.TypeAsync(adding.Find("input"), "valencia");
            var exact = GetEntries(adding);
            await fields.TypeAsync(listing.Find("input"), "Getafe");

            // Assert
            Assert.Multiple(
                () => Assert.Equal(["Add \"Getafe\""], offered),
                () => Assert.Equal(["Valencia"], exact),
                () => Assert.Empty(GetEntries(listing)));
        }

        [Fact]
        public async Task Should_commit_the_option_the_factory_creates_and_show_it_before_the_host_s_options_hold_it()
        {
            // Arrange
            using var ctx = new FormaComboBoxTests();
            var probe = new DomProbe<FocusState>(ctx);
            var fields = new TextFieldProbe(ctx, probe.Engine);
            var router = new InputRouterProbe(ctx);
            var model = new FakeModel();
            List<SelectOption<int?>> options = [new(1, "Real Madrid")];
            var created = new TaskCompletionSource<SelectOption<int?>?>();
            string? asked = null;
            Func<string, Task<SelectOption<int?>?>> factory = text => { asked = text; return created.Task; };
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaComboBox TValue="int?" Id="team" @bind-Value="model.Status" Options="options" Label="Team" OptionFactory="factory" />
            </FakeFormHost>);
            await fields.TypeAsync(cut.Find("input"), " Getafe ");

            // Act
            var adding = PressAsync(router, cut, "combobox.choose", "Enter");
            var busy = cut.Find("input").GetAttribute("aria-busy");
            var offerWhileAdding = cut.Find("[role=option]").GetAttribute("aria-disabled");
            created.SetResult(new SelectOption<int?>(9, "Getafe CF"));
            await adding;

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Getafe", asked),
                () => Assert.Equal("true", busy),
                () => Assert.Equal("true", offerWhileAdding),
                () => Assert.Equal(9, model.Status),
                () => Assert.Equal("Getafe CF", cut.Find("input").GetAttribute("value")),
                () => Assert.Null(cut.Find("input").GetAttribute("aria-busy")),
                () => Assert.Equal("\"Getafe CF\" was added.", cut.Find("[role=status]").TextContent.Trim()));
        }

