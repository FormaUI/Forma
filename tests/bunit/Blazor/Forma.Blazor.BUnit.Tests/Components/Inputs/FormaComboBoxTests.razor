        [Fact]
        public async Task Should_pass_over_an_option_that_can_t_be_chosen_and_never_commit_it()
        {
            // Arrange
            using var ctx = new FormaComboBoxTests();
            var probe = new DomProbe<FocusState>(ctx);
            var fields = new TextFieldProbe(ctx, probe.Engine);
            var router = new InputRouterProbe(ctx);
            var model = new FakeModel { Status = 1 };
            List<SelectOption<int?>> options = [new(1, "Free"), new(2, "Team") { IsDisabled = true }, new(3, "Enterprise")];
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaComboBox TValue="int?" Id="plan" @bind-Value="model.Status" Options="options" Label="Plan" />
            </FakeFormHost>);

            // Act
            await PressAsync(router, cut, "combobox.next", "ArrowDown");
            await PressAsync(router, cut, "combobox.next", "ArrowDown");
            var movedTo = GetActiveEntry(cut);
            var disabledMark = cut.FindAll("[role=option]")[1].GetAttribute("aria-disabled");
            cut.FindAll("[role=option]")[1].Click();
            var afterPress = model.Status;
            await probe.ReportAsync(new FocusState(IsWithin: true));
            await fields.TypeAsync(cut.Find("input"), "team");
            await probe.ReportAsync(new FocusState(IsWithin: false));

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Enterprise", movedTo),
                () => Assert.Equal("true", disabledMark),
                () => Assert.Equal(1, afterPress),
                () => Assert.Equal(1, model.Status),
                () => Assert.Equal("Free", cut.Find("input").GetAttribute("value")));
        }

