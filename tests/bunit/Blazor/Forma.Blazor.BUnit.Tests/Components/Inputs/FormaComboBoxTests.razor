@inherits FormaBunitContext
@using Forma.Framework.Browser
@code {
    public sealed class Component
    {
        private static readonly List<SelectOption<int?>> Zones =
        [
            new(1, "(UTC−03:00) Buenos Aires"),
            new(2, "(UTC+01:00) Madrid"),
            new(3, "(UTC−05:00) Bogotá"),
            new(4, "(UTC+01:00) Berlin"),
        ];

        private static string FormatZone(int? zone)
            => "Zone " + zone;

        private static List<string> GetEntries<TComponent>(IRenderedComponent<TComponent> cut)
            where TComponent : IComponent
            => [.. cut.FindAll("[role=option]").Select(option => option.TextContent.Trim())];

        private static string? GetActiveEntry<TComponent>(IRenderedComponent<TComponent> cut)
            where TComponent : IComponent
            => cut.Find("input").GetAttribute("aria-activedescendant") is { } id ? cut.Find($"#{id}").TextContent.Trim() : null;

        private static Task PressAsync<TComponent>(InputRouterProbe router, IRenderedComponent<TComponent> cut, string action, string key)
            where TComponent : class, IComponent
            => router.RouteAsync(((IRenderedComponent<IComponent>)cut).FindComponent<FormaComboBox<int?>>().Instance.RootElement, action, key);

        [Fact]
        public void Should_show_the_committed_option_s_label_in_a_combobox_field()
        {
            // Arrange
            using var ctx = new FormaComboBoxTests();
            var model = new FakeModel { Status = 2 };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaComboBox TValue="int?" Id="zone" @bind-Value="model.Status" Options="Zones" Label="Time zone" />
            </FakeFormHost>);

            // Assert
            var input = cut.Find("input");
            Assert.Multiple(
                () => Assert.Equal("combobox", input.GetAttribute("role")),
                () => Assert.Equal("list", input.GetAttribute("aria-autocomplete")),
                () => Assert.Equal("false", input.GetAttribute("aria-expanded")),
                () => Assert.Equal("(UTC+01:00) Madrid", input.GetAttribute("value")),
                () => Assert.Contains("Time zone", cut.Find(".forma-field-label").TextContent, StringComparison.Ordinal));
        }

        [Fact]
        public void Should_write_nothing_over_the_field_as_its_edits_first_listen()
        {
            // Arrange
            using var ctx = new FormaComboBoxTests();
            var probe = new DomProbe<FocusState>(ctx);
            var fields = new TextFieldProbe(ctx, probe.Engine);
            var model = new FakeModel { Status = 2 };

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaComboBox TValue="int?" Id="zone" @bind-Value="model.Status" Options="Zones" Label="Time zone" />
            </FakeFormHost>);

            // Assert — the committed label is the text the edits start from, so nothing waits to land on what the reader types first
            Assert.Multiple(
                () => Assert.DoesNotContain(probe.Engine.Invocations, invocation => invocation.Identifier == "invoke" && invocation.Arguments[3] is "write"),
                () => Assert.Equal("(UTC+01:00) Madrid", fields.GetText(cut.Find("input"))));
        }

