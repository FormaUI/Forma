                    OnPageChanged="@((int p) => received.Add(p))" />);
            var last = ctx.Render(
                @<FormaPagination TotalItems="50" PageSize="10" CurrentPage="5" Options="WithWheel"
                    OnPageChanged="@((int p) => received.Add(p))" />);

            // Act
            await first.FindComponent<FormaPagination>().Instance.HandleWheelAsync(-1);
            await last.FindComponent<FormaPagination>().Instance.HandleWheelAsync(1);

            // Assert
            Assert.Empty(received);
        }

        [Fact]
        public void Should_reject_a_negative_item_count()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();

            // Act & Assert
            Assert.Throws<ArgumentOutOfRangeException>(() => ctx.Render(
                @<FormaPagination TotalItems="-1" PageSize="10" CurrentPage="1" />));
        }

        [Fact]
        public void Should_reject_a_zero_page_size()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();

            // Act & Assert
            Assert.Throws<ArgumentOutOfRangeException>(() => ctx.Render(
                @<FormaPagination TotalItems="50" PageSize="0" CurrentPage="1" />));
        }

        [Fact]
        public void Should_clamp_a_current_page_outside_the_range()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();

            // Act
            var before = ctx.Render(@<FormaPagination TotalItems="50" PageSize="10" CurrentPage="0" />);
            var past = ctx.Render(@<FormaPagination TotalItems="50" PageSize="10" CurrentPage="99" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("1", before.Find(Current).TextContent.Trim());
                Assert.True(before.Find(StepsPrevious).HasAttribute("disabled"));
                Assert.Equal("5", past.Find(Current).TextContent.Trim());
                Assert.True(past.Find(StepsNext).HasAttribute("disabled"));
            });
        }

        [Fact]
        public void Should_step_back_from_the_clamped_page_when_the_item_count_shrinks()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();
            var received = new List<int>();
            var cut = ctx.Render(
                @<FormaPagination TotalItems="50" PageSize="10" CurrentPage="99" Options="InputByOption"
                    OnPageChanged="@((int p) => received.Add(p))" />);

            // Act
            cut.Find(InputPrevious).Click();

            // Assert
            Assert.Equal([4], received);
        }

        [Fact]
        public void Should_render_every_step_disabled_and_the_current_one_marked_before_the_renderer_is_interactive()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));

            // Act
            var cut = ctx.Render(@<FormaPagination TotalItems="100" PageSize="10" CurrentPage="3" />);

            // Assert
            Assert.Multiple(
                () => Assert.All(cut.FindAll("button"), button => Assert.True(button.HasAttribute("disabled"))),
                () => Assert.Equal("page", cut.Find(Current).GetAttribute("aria-current")));
        }

        private static List<string> StepLabels(IRenderedComponent<IComponent> cut)
        {
            var items = cut.FindAll($"{Steps} > li").ToList();

            return items
                .Skip(1)
                .Take(items.Count - 2)
                .Select(li => li.TextContent.Trim())
                .ToList();
        }
    }
