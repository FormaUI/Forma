            var first = ctx.Render(@<FormaPagination TotalItems="50" PageSize="10" CurrentPage="1" />);
            var last = ctx.Render(@<FormaPagination TotalItems="50" PageSize="10" CurrentPage="5" />);
            var middle = ctx.Render(@<FormaPagination TotalItems="50" PageSize="10" CurrentPage="3" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.True(first.Find(StepsPrevious).HasAttribute("disabled"));
                Assert.True(first.Find(InputPrevious).HasAttribute("disabled"));
                Assert.True(last.Find(StepsNext).HasAttribute("disabled"));
                Assert.True(last.Find(InputNext).HasAttribute("disabled"));
                Assert.False(middle.Find(StepsPrevious).HasAttribute("disabled"));
                Assert.False(middle.Find(StepsNext).HasAttribute("disabled"));
            });
        }

