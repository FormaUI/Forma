        [Fact]
        public async Task Should_write_what_the_navigation_input_is_out_of_again_when_the_culture_state_changes()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();
            using var culture = new CultureFixture("en-US");
            var cut = ctx.Render(
                @<FormaPagination TotalItems="20000" PageSize="10" CurrentPage="7" />);

            // Act
            await ctx.ChangeCultureAsync("de-DE");

            // Assert
            Assert.Equal("7 of 2.000", cut.Find(InputBox).GetAttribute("value"));
        }

        private static readonly PaginationOptions InputByOption =
            new() { NavigationInput = true };

        private static readonly PaginationOptions WithoutGoButton =
            new() { GoButton = false };

        private static readonly PaginationOptions WithWheel =
            new() { PageOnWheelGesture = true };

        private const string Steps = ".forma-pagination-navigation-steps";
        private const string StepsPrevious = ".forma-pagination-navigation-steps .forma-pagination-navigation-button-previous";
        private const string StepsNext = ".forma-pagination-navigation-steps .forma-pagination-navigation-button-next";
        private const string InputRow = ".forma-pagination-navigation-input";
        private const string InputPrevious = ".forma-pagination-navigation-input .forma-pagination-navigation-button-previous";
        private const string InputNext = ".forma-pagination-navigation-input .forma-pagination-navigation-button-next";
        private const string InputBox = ".forma-pagination-navigation-input-box";
        private const string GoButton = ".forma-pagination-go-button";
        private const string Current = ".forma-pagination-navigation-step-current";

