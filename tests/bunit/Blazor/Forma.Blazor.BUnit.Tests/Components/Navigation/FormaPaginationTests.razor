        [Fact]
        public void Should_attach_the_wheel_only_when_the_option_asks()
        {
            // Arrange
            using var ctx = new FormaPaginationTests();
            var module = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/behaviors/Wheel.js");
            module.SetupVoid("attach", _ => true).SetVoidResult();

            // Act
            ctx.Render(@<FormaPagination TotalItems="50" PageSize="10" CurrentPage="1" />);
            var without = module.Invocations.Count;
            ctx.Render(@<FormaPagination TotalItems="50" PageSize="10" CurrentPage="1" Options="WithWheel" />);
            var with = module.Invocations.Count;

            // Assert
            var options = module.Invocations.Single(invocation => invocation.Identifier == "attach").Arguments[1]!;
            Assert.Multiple(
                () => Assert.Equal((0, 1), (without, with)),
                () => Assert.Equal("pagination.page", InteropPayload.GetValue(options, "action")));
        }

