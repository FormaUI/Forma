@inherits FormaBunitContext
@using Forma.Framework.Browser.Interop.Scrolling
@using Forma.Framework.Emojis.Twemoji
@using Forma.Blazor.Components.Interaction
@using Forma.Framework.Input
@using Forma.Framework.Input.Keyboard
@using Forma.Framework.Localization
@using Forma.Tests.Localization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection

@code {
    public sealed class Component
    {
        // The picker's own default tab count: nine standard categories.
        private const int GroupCount = 9;

        [Fact]
        public void Should_fetch_each_sheet_once_however_many_cells_draw_from_it()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var sheets = ctx.JSInterop.Invocations["loadSprite"]
                .Select(invocation => (string)invocation.Arguments[0]!)
                .ToArray();

            Assert.Multiple(
                () => Assert.NotEmpty(sheets),
                () => Assert.Equal(sheets.Distinct(StringComparer.Ordinal).Count(), sheets.Length));
        }

        [Fact]
        public async Task Should_show_a_single_spinner_in_place_of_a_still_loading_category()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var loader = ctx.HoldSpriteLoads();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            Assert.NotNull(cut.Find(".forma-emoji-picker-loading .forma-spinner"));
            Assert.Empty(cut.FindAll(".forma-emoji-picker-emoji"));

            // Act
            await cut.ReleaseAsync(loader.CompleteAll);

            // Assert
            Assert.NotEmpty(cut.FindAll(".forma-emoji-picker-emoji"));
            Assert.Empty(cut.FindAll(".forma-emoji-picker-loading"));
        }

        [Fact]
        public void Should_render_only_the_first_chunk_until_scrolling_asks_for_more()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var catalog = ctx.Services.GetRequiredService<IEmojiCatalog>();
            catalog.TryFindByGroupId("smileys", out var smileys);

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert — the category is larger than one chunk, so only its opening run renders.
            var rendered = cut.FindAll(".forma-emoji-picker-emoji").Count;
            Assert.InRange(rendered, 1, smileys.Count - 1);
            Assert.All(cut.FindAll(".forma-emoji-picker-emoji use"), use => Assert.StartsWith("#emoji-", use.GetAttribute("href")));
        }

        [Fact]
        public void Should_offer_a_sentinel_while_chunks_remain()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act — activities is small enough that its opening chunk still leaves more to come.
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            Assert.NotNull(cut.Find(".forma-emoji-picker-sentinel"));
        }

        [Fact]
        public async Task Should_extend_the_grid_when_the_sentinel_reports_it_was_reached()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var probe = new DomProbe<IntersectionState>(ctx);
            var cut = ctx.Render(@<FormaEmojiPicker />);
            var before = cut.FindAll(".forma-emoji-picker-emoji").Count;

            // Act
            await probe.ReportAsync(new IntersectionState(IsIntersecting: true));

            // Assert
            Assert.True(cut.FindAll(".forma-emoji-picker-emoji").Count > before);
        }

        [Fact]
        public async Task Should_measure_the_sentinel_afresh_once_the_sheet_it_asked_for_has_loaded()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var probe = new DomProbe<IntersectionState>(ctx);
            ctx.Render(@<FormaEmojiPicker />);

            // Act — the sheet's cells can leave the sentinel in view, which the observation alone would never report.
            await probe.ReportAsync(new IntersectionState(IsIntersecting: true));

            // Assert
            Assert.Single(probe.Watcher.Invocations, invocation => invocation.Identifier == "refresh");
        }

        [Fact]
        public async Task Should_stop_the_spinner_when_a_sprite_fails_rather_than_spinning_forever()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var loader = ctx.HoldSpriteLoads();
            var cut = ctx.Render(@<FormaEmojiPicker />);
            Assert.NotNull(cut.Find(".forma-emoji-picker-loading"));

            // Act
            await cut.ReleaseAsync(loader.FailAll);

            // Assert
            Assert.Empty(cut.FindAll(".forma-emoji-picker-loading"));
            Assert.NotEmpty(cut.FindAll(".forma-emoji-picker-emoji"));
        }

        [Fact]
        public void Should_render_a_tab_for_every_group()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            Assert.Equal(GroupCount, cut.FindAll("[role='tab']").Count);
        }

        [Fact]
        public void Should_name_each_group_by_its_title_looked_up_as_its_localization_key()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            ctx.Services.AddSingleton<IStringLocaleFactory>(new StubStringLocaleFactory(new Dictionary<string, string> { ["Smileys & Emotion"] = "רגשות" }));

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var tab = cut.FindAll("[role='tab']")[0];
            Assert.Multiple(() =>
            {
                Assert.Equal("רגשות", tab.GetAttribute("aria-label"));
                Assert.Equal("רגשות", tab.GetAttribute("title"));
                Assert.Equal("רגשות", cut.Find(".forma-emoji-picker-heading").TextContent);
            });
        }

        [Fact]
        public void Should_select_the_first_group_until_one_is_chosen()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var tabs = cut.FindAll("[role='tab']");
            Assert.Equal("true", tabs[0].GetAttribute("aria-selected"));
            Assert.All(tabs.Skip(1), tab => Assert.Equal("false", tab.GetAttribute("aria-selected")));
        }

        [Fact]
        public void Should_render_the_emoji_of_the_selected_group()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var catalog = ctx.Services.GetRequiredService<IEmojiCatalog>();
            catalog.TryFindByGroupId("smileys", out var smileys);

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var rendered = cut.FindAll(".forma-emoji-picker-emoji");
            Assert.NotEmpty(rendered);
            Assert.Equal(smileys[0].Name, rendered[0].GetAttribute("aria-label"));
        }

        [Fact]
        public void Should_show_another_group_when_its_tab_is_pressed()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var catalog = ctx.Services.GetRequiredService<IEmojiCatalog>();
            catalog.TryFindByGroupId("animals", out var animals);
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Act
            cut.FindAll("[role='tab']")[2].Click();

            // Assert
            var rendered = cut.FindAll(".forma-emoji-picker-emoji");
            Assert.NotEmpty(rendered);
            Assert.Equal(animals[0].Name, rendered[0].GetAttribute("aria-label"));
            Assert.Equal("true", cut.FindAll("[role='tab']")[2].GetAttribute("aria-selected"));
        }

        [Fact]
        public void Should_name_every_emoji_button_and_hide_the_artwork_from_a_reader()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var first = cut.Find(".forma-emoji-picker-emoji");
            Assert.False(string.IsNullOrWhiteSpace(first.GetAttribute("aria-label")));
            Assert.Equal("true", first.QuerySelector("svg")!.GetAttribute("aria-hidden"));
        }

        [Fact]
        public void Should_point_each_emoji_at_a_symbol_adopted_into_the_document()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var catalog = ctx.Services.GetRequiredService<IEmojiCatalog>();
            var provider = ctx.Services.GetRequiredService<IEmojiProvider>();
            catalog.TryFindByGroupId("smileys", out var smileys);
            var sprite = Assert.IsType<EmojiSprite>(provider.GetArtwork(smileys[0].Emoji));

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var href = cut.Find(".forma-emoji-picker-emoji use").GetAttribute("href");
            Assert.Equal($"#{sprite.Symbol}", href);
        }

        [Fact]
        public void Should_report_the_chosen_emoji()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var catalog = ctx.Services.GetRequiredService<IEmojiCatalog>();
            catalog.TryFindByGroupId("smileys", out var smileys);
            string? selected = null;
            var cut = ctx.Render(@<FormaEmojiPicker OnSelect="value => selected = value" />);

            // Act
            cut.Find(".forma-emoji-picker-emoji").Click();

            // Assert
            Assert.Equal(smileys[0].Emoji.Sequence, selected);
        }

        [Fact]
        public void Should_add_a_recent_tab_once_the_host_supplies_recent_emoji()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            IReadOnlyList<string> recent = ["😀"];

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker RecentEmojis="recent" />);

            // Assert
            Assert.Equal(GroupCount + 1, cut.FindAll("[role='tab']").Count);
            Assert.Single(cut.FindAll(".forma-emoji-picker-emoji"));
        }

        [Fact]
        public void Should_skip_a_recent_entry_that_names_no_emoji()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            // An empty entry and a run-together entry, neither of them an emoji.
            IReadOnlyList<string> recent = ["", "😀😀", "😀"];

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker RecentEmojis="recent" />);

            // Assert
            Assert.Single(cut.FindAll(".forma-emoji-picker-emoji"));
        }

        [Fact]
        public void Should_push_the_chosen_emoji_to_the_front_of_recent()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var catalog = ctx.Services.GetRequiredService<IEmojiCatalog>();
            catalog.TryFindByGroupId("smileys", out var smileys);
            IReadOnlyList<string> recent = ["😂", "😊"];
            IReadOnlyList<string>? updated = null;
            var cut = ctx.Render(@<FormaEmojiPicker RecentEmojis="recent" RecentEmojisChanged="value => updated = value" />);

            // Act
            cut.FindAll("[role='tab']")[1].Click();
            cut.Find(".forma-emoji-picker-emoji").Click();

            // Assert
            Assert.NotNull(updated);
            Assert.Equal(smileys[0].Emoji.Sequence, updated[0]);
        }

        [Fact]
        public void Should_not_repeat_an_emoji_already_in_recent()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var catalog = ctx.Services.GetRequiredService<IEmojiCatalog>();
            catalog.TryFindByGroupId("smileys", out var smileys);
            var first = smileys[0].Emoji.Sequence;
            IReadOnlyList<string> recent = ["😂", first];
            IReadOnlyList<string>? updated = null;
            var cut = ctx.Render(@<FormaEmojiPicker RecentEmojis="recent" RecentEmojisChanged="value => updated = value" />);

            // Act
            cut.FindAll("[role='tab']")[1].Click();
            cut.Find(".forma-emoji-picker-emoji").Click();

            // Assert
            Assert.NotNull(updated);
            Assert.Equal([first, "😂"], updated);
        }

        [Fact]
        public void Should_keep_recent_within_its_limit()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            IReadOnlyList<string> recent = ["😂", "😊"];
            IReadOnlyList<string>? updated = null;
            var cut = ctx.Render(@<FormaEmojiPicker RecentEmojis="recent" Options="@(new EmojiPickerOptions { MaxRecent = 2 })" RecentEmojisChanged="value => updated = value" />);

            // Act
            cut.FindAll("[role='tab']")[1].Click();
            cut.Find(".forma-emoji-picker-emoji").Click();

            // Assert
            Assert.NotNull(updated);
            Assert.Equal(2, updated.Count);
        }

        [Fact]
        public void Should_reject_a_recent_limit_below_one()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Assert
            Assert.Throws<ArgumentOutOfRangeException>(() => ctx.Render(@<FormaEmojiPicker Options="@(new EmojiPickerOptions { MaxRecent = 0 })" />));
        }

        [Fact]
        public void Should_omit_the_tab_strip_and_search_when_they_are_turned_off()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker Options="@(new EmojiPickerOptions { ShowGroupTabs = false, ShowSearch = false })" />);

            // Assert
            Assert.Empty(cut.FindAll("[role='tab']"));
            Assert.Empty(cut.FindAll("input[type='search']"));
        }

        [Fact]
        public void Should_apply_the_supplied_id_and_class()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker Id="picker" Class="extra" />);

            // Assert
            var root = cut.Find(".forma-emoji-picker");
            Assert.Equal("picker", root.GetAttribute("id"));
            Assert.Contains("extra", root.GetAttribute("class"));
        }

        [Fact]
        public void Should_point_each_tab_at_the_panel_it_controls()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker Id="picker" />);

            // Assert
            Assert.All(cut.FindAll("[role='tab']"), tab => Assert.Equal("picker-panel", tab.GetAttribute("aria-controls")));
            Assert.Equal("picker-panel", cut.Find("[role='tabpanel']").GetAttribute("id"));
        }

        [Fact]
        public void Should_keep_only_the_selected_tab_in_the_tab_order()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var tabs = cut.FindAll("[role='tab']");
            Assert.Equal("0", tabs[0].GetAttribute("tabindex"));
            Assert.All(tabs.Skip(1), tab => Assert.Equal("-1", tab.GetAttribute("tabindex")));
        }

        // The tab strip's registrations, told apart from the search box's by their emoji-picker actions.
        private static List<JSRuntimeInvocation> GetStripRegistrations(InputRouterProbe router)
            => [.. router.Registrations.Where(registration => InputRouterProbe.GetRoutes(registration).Any(route => route.StartsWith("emoji-picker.", StringComparison.Ordinal)))];

        [Fact]
        public void Should_route_the_arrows_home_and_end_on_the_tab_strip()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var router = new InputRouterProbe(ctx);

            // Act
            ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var registration = Assert.Single(GetStripRegistrations(router));
            Assert.Equal(["emoji-picker.next:ArrowRight", "emoji-picker.previous:ArrowLeft", "emoji-picker.first:Home", "emoji-picker.last:End"], InputRouterProbe.GetRoutes(registration));
        }

        [Fact]
        public void Should_swap_the_arrows_under_right_to_left()
        {
            // Arrange
            using var culture = new CultureFixture("he");
            using var ctx = new FormaEmojiPickerTests();
            var router = new InputRouterProbe(ctx);

            // Act
            ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var registration = Assert.Single(GetStripRegistrations(router));
            Assert.Equal(["emoji-picker.next:ArrowLeft", "emoji-picker.previous:ArrowRight", "emoji-picker.first:Home", "emoji-picker.last:End"], InputRouterProbe.GetRoutes(registration));
        }

        [Fact]
        public void Should_register_no_strip_when_the_tabs_are_turned_off()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var router = new InputRouterProbe(ctx);

            // Act
            ctx.Render(@<FormaEmojiPicker Options="@(new EmojiPickerOptions { ShowGroupTabs = false })" />);

            // Assert
            Assert.Empty(GetStripRegistrations(router));
        }

        [Fact]
        public void Should_register_the_strip_again_once_it_is_shown_again()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Act
            cut.FindComponent<FormaEmojiPicker>().Render(parameters => parameters.Add(p => p.Options, new EmojiPickerOptions { ShowGroupTabs = false }));
            var scopesWhileHidden = cut.FindComponents<FormaInputScope>().Count;
            cut.FindComponent<FormaEmojiPicker>().Render(parameters => parameters.Add(p => p.Options, EmojiPickerOptions.Default));

            // Assert
            Assert.Multiple(
                () => Assert.Equal(0, scopesWhileHidden),
                () => Assert.Equal(2, GetStripRegistrations(router).Count));
        }

        [Fact]
        public async Task Should_show_the_next_group_and_focus_its_tab_when_the_router_routes_next()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Act
            await router.RouteAsync("emoji-picker.next", "ArrowRight");

            // Assert
            var tabs = cut.FindAll("[role='tab']");
            Assert.Multiple(
                () => Assert.Equal("true", tabs[1].GetAttribute("aria-selected")),
                () => Assert.Equal("0", tabs[1].GetAttribute("tabindex")),
                () => Assert.Single(ctx.JSInterop.Invocations, invocation => invocation.Identifier == "Blazor._internal.domWrapper.focus"));
        }

        [Fact]
        public async Task Should_jump_to_the_last_group_on_last()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Act
            await router.RouteAsync("emoji-picker.last", "End");

            // Assert
            Assert.Equal("true", cut.FindAll("[role='tab']")[^1].GetAttribute("aria-selected"));
        }

        [Fact]
        public async Task Should_wrap_from_the_first_group_to_the_last_on_previous()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Act
            await router.RouteAsync("emoji-picker.previous", "ArrowLeft");

            // Assert
            Assert.Equal("true", cut.FindAll("[role='tab']")[^1].GetAttribute("aria-selected"));
        }

        [Fact]
        public void Should_start_with_an_empty_search_box()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            Assert.Equal(string.Empty, cut.Find("input[type='search']").GetAttribute("value"));
        }

        [Fact]
        public void Should_announce_the_result_count_through_a_live_region()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            Assert.NotNull(cut.Find("[role='status']"));
        }

        [Fact]
        public void Should_render_its_tabs_and_the_whole_category_s_emojis_disabled_before_the_renderer_is_interactive()
        {
            // Arrange
            using var ctx = new FormaEmojiPickerTests();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));

            // Act
            var cut = ctx.Render(@<FormaEmojiPicker />);

            // Assert
            var tabs = cut.FindAll(".forma-emoji-picker-tab");
            var emojis = cut.FindAll(".forma-emoji-picker-emoji");
            Assert.Multiple(
                () => Assert.Equal(GroupCount, tabs.Count),
                () => Assert.NotEmpty(emojis),
                () => Assert.All(tabs.Concat(emojis), button => Assert.True(button.HasAttribute("disabled"))),
                () => Assert.Empty(cut.FindAll(".forma-spinner")));
        }
    }
}
