    public sealed class Workspace
    {
        private static WindowManager GetWindowManager(FormaWindowTests ctx)
            => ctx.Services.GetRequiredService<WindowManager>();

        [Fact]
        public async Task Should_register_while_rendered_and_leave_when_disposed()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var manager = GetWindowManager(ctx);

            // Act
            ctx.Render(@<FormaWindow Title="Folders" />);
            var registered = manager.StackedWindows.Select(window => window.Title).ToList();
            await ctx.DisposeComponentsAsync();

            // Assert
            Assert.Multiple(
                () => Assert.Equal(["Folders"], registered),
                () => Assert.Empty(manager.StackedWindows));
        }

        [Fact]
        public void Should_register_once_for_the_frame_it_holds()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var manager = GetWindowManager(ctx);

            // Act
            var cut = ctx.Render(@<FormaWindow Title="Folders" />);

            // Assert
            Assert.Multiple(
                () => Assert.Single(manager.Windows),
                () => Assert.Single(cut.FindAll(".forma-frame")));
        }

        [Fact]
        public void Should_take_a_cascaded_workspace_over_the_circuits()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var nested = new WindowManager();

            // Act
            ctx.Render(@<CascadingValue Value="nested"><FormaWindow Title="Folders" /></CascadingValue>);

            // Assert
            Assert.Multiple(
                () => Assert.Single(nested.StackedWindows),
                () => Assert.Empty(GetWindowManager(ctx).StackedWindows));
        }

        [Fact]
        public void Should_resolve_its_origin_from_itself_then_its_parent_then_the_cascade_then_the_workspace()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var manager = GetWindowManager(ctx);
            var own = WindowOrigin.NewInstance("explorer", "Explorer");
            var cascaded = WindowOrigin.NewInstance("shell", "Shell");
            FormaWindow? parent = null;

            // Act
            ctx.Render(@<CascadingValue Value="cascaded"><FormaWindow @ref="parent" Title="Parent" Origin="own" /></CascadingValue>);
            ctx.Render(
                @<CascadingValue Value="cascaded">
                    <FormaWindow Title="Child" Parent="parent" />
                    <FormaWindow Title="Cascaded" />
                </CascadingValue>);
            ctx.Render(@<FormaWindow Title="Lone" />);

            // Assert
            IWindow Named(string title) => manager.StackedWindows.Single(window => window.Title == title);
            Assert.Multiple(
                () => Assert.Equal(own, Named("Parent").Origin),
                () => Assert.Equal(own, Named("Child").Origin),
                () => Assert.Equal(cascaded, Named("Cascaded").Origin),
                () => Assert.Equal(manager.Origin, Named("Lone").Origin));
        }

        [Fact]
        public void Should_offer_a_minimize_command_that_takes_the_window_out_of_its_presentation()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            bool? minimized = null;

            // Act
            var cut = ctx.Render(@<FormaWindow Title="Folders" MinimizedChanged="value => minimized = value"><Body>Kept</Body></FormaWindow>);
            cut.Find("button[aria-label=Minimize]").Click();

            // Assert
            Assert.Multiple(
                () => Assert.True(minimized),
                () => Assert.True(cut.Find(".forma-window").HasAttribute("hidden")),
                () => Assert.Equal("Kept", cut.Find(".forma-chrome-body").TextContent));
        }

        [Fact]
        public async Task Should_mark_the_window_the_workspace_makes_current()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var manager = GetWindowManager(ctx);
            bool? active = null;
            var cut = ctx.Render(@<FormaWindow Title="Folders" ActiveChanged="value => active = value" />);

            // Act
            await manager.ActivateAsync(new WindowSelector { Title = "Folders" });

            // Assert
            Assert.Multiple(
                () => Assert.True(active),
                () => Assert.Contains("is-active", cut.Find(".forma-window").ClassList),
