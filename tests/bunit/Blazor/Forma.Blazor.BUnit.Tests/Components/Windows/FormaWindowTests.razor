@inherits FormaBunitContext
@using Bunit.Rendering
@using Forma.Blazor.Components.Layout
@using Forma.Framework.Browser.Interop.Focus
@using Forma.Framework.Icons
@using Forma.Framework.Input
@using Forma.Framework.Toolbar
@using Forma.Framework.Windows

@code {
    public sealed class Component
    {
        private static List<string?> CommandLabels(IRenderedComponent<ContainerFragment> cut)
            => [.. cut.FindAll(".forma-chrome-commands button").Select(button => button.GetAttribute("aria-label"))];

        [Fact]
        public void Should_frame_the_title_the_icon_and_the_body()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var cut = ctx.Render(@<FormaWindow Title="Folders" Icon="Glyph.Pin"><Body>Tree</Body></FormaWindow>);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("Folders", cut.Find(".forma-window .forma-chrome-title").TextContent);
                Assert.NotNull(cut.Find(".forma-window .forma-chrome-icon .forma-icon"));
                Assert.Equal("Tree", cut.Find(".forma-window .forma-chrome-body").TextContent);
                Assert.Equal("presentation", cut.Find(".forma-window .forma-frame").GetAttribute("role"));
            });
        }

        [Fact]
        public void Should_be_a_dialog_in_the_top_layer_named_by_its_title()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var cut = ctx.Render(@<FormaWindow Title="Folders" />);
            var window = cut.Find(".forma-window");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("dialog", window.GetAttribute("role"));
                Assert.Equal("false", window.GetAttribute("aria-modal"));
                Assert.Equal("manual", window.GetAttribute("popover"));
                Assert.Equal("Folders", window.GetAttribute("aria-label"));
            });
        }

        [Fact]
        public void Should_give_the_title_bar_the_arrow_keys_unless_maximized()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var plain = ctx.Render(@<FormaWindow Title="Folders" />);
            var maximized = ctx.Render(@<FormaWindow Title="Folders" Maximized="true" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("0", plain.Find($".{FormaFrame.DragRegionClass}").GetAttribute("tabindex"));
                Assert.Contains("Folders", plain.Find($".{FormaFrame.DragRegionClass}").GetAttribute("aria-label"));
                Assert.Null(maximized.Find($".{FormaFrame.DragRegionClass}").GetAttribute("tabindex"));
                Assert.Null(maximized.Find($".{FormaFrame.DragRegionClass}").GetAttribute("aria-keyshortcuts"));
            });
        }

        [Fact]
        public void Should_promise_the_resize_keys_only_while_resizable()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var resizable = ctx.Render(@<FormaWindow Title="Folders" />);
            var fixedSize = ctx.Render(@<FormaWindow Title="Folders" FrameOptions="new() { Resizable = false }" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Contains("Shift", resizable.Find($".{FormaFrame.DragRegionClass}").GetAttribute("aria-label"));
                Assert.Contains("Shift+ArrowUp", resizable.Find($".{FormaFrame.DragRegionClass}").GetAttribute("aria-keyshortcuts"));
                Assert.DoesNotContain("Shift", fixedSize.Find($".{FormaFrame.DragRegionClass}").GetAttribute("aria-label"));
                Assert.Equal("ArrowUp ArrowDown ArrowLeft ArrowRight", fixedSize.Find($".{FormaFrame.DragRegionClass}").GetAttribute("aria-keyshortcuts"));
            });
        }

        [Fact]
        public void Should_render_resize_handles_only_while_resizable_and_not_maximized()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var plain = ctx.Render(@<FormaWindow Title="Folders" />);
            var fixedSize = ctx.Render(@<FormaWindow Title="Folders" FrameOptions="new() { Resizable = false }" />);
            var maximized = ctx.Render(@<FormaWindow Title="Folders" Maximized="true" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal(8, plain.FindAll($".{FormaFrame.HandleClass}").Count);
                Assert.Empty(fixedSize.FindAll($".{FormaFrame.HandleClass}"));
                Assert.Empty(maximized.FindAll($".{FormaFrame.HandleClass}"));
                Assert.Contains("is-maximized", maximized.Find(".forma-window").ClassList);
            });
        }

        [Fact]
        public void Should_offer_a_lock_only_when_lockable()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var plain = ctx.Render(@<FormaWindow Title="Folders" />);
            var lockable = ctx.Render(@<FormaWindow Title="Folders" Options="new() { Lockable = true }" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Empty(plain.FindAll("button[aria-label=Lock]"));
                Assert.NotNull(lockable.Find("button[aria-label=Lock]"));
            });
        }

        [Fact]
        public void Should_hold_a_locked_window_where_it_is()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            bool? locked = null;

            // Act
            var cut = ctx.Render(@<FormaWindow Title="Folders" Options="new() { Lockable = true }" LockedChanged="value => locked = value" />);
            cut.Find("button[aria-label=Lock]").Click();
            var frame = cut.Find(".forma-frame");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.True(locked);
                Assert.Contains("is-locked", frame.ClassList);
                Assert.DoesNotContain("is-movable", frame.ClassList);
                Assert.Empty(cut.FindAll($".{FormaFrame.HandleClass}"));
                Assert.Null(cut.Find($".{FormaFrame.DragRegionClass}").GetAttribute("tabindex"));
                Assert.True(cut.Find("button[aria-label=Maximize]").HasAttribute("disabled"));
                Assert.NotNull(cut.Find("button[aria-label=Unlock]"));
                Assert.NotNull(cut.Find("button[aria-label=Minimize]"));
                Assert.NotNull(cut.Find("button[aria-label=Close]"));
            });
        }

        [Fact]
        public void Should_unlock_from_the_same_command()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var cut = ctx.Render(@<FormaWindow Title="Folders" Locked="true" Options="new() { Lockable = true }" />);

            // Act
            cut.Find("button[aria-label=Unlock]").Click();

            // Assert
            Assert.Multiple(() =>
            {
                Assert.DoesNotContain("is-locked", cut.Find(".forma-frame").ClassList);
                Assert.Contains("is-movable", cut.Find(".forma-frame").ClassList);
                Assert.Equal(8, cut.FindAll($".{FormaFrame.HandleClass}").Count);
                Assert.False(cut.Find("button[aria-label=Maximize]").HasAttribute("disabled"));
            });
        }

