        [Fact]
        public void Should_register_a_scope_shaped_by_modality_and_the_press_away_option()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            ctx.Render(@<FormaWindow Title="Plain" />);
            ctx.Render(@<FormaWindow Title="Sends back" Options="new() { PressAway = WindowPressAway.SendToBack }" />);
            ctx.Render(@<FormaWindow Title="Modal" Modal="true" Options="new() { PressAway = WindowPressAway.SendToBack }" />);
            var profiles = ctx.Router.Registrations.Select(registration => Assert.IsType<InputProfile>(registration.Arguments[1])).ToList();

            // Assert
            Assert.Multiple(
                () => Assert.Equal(3, profiles.Count),
                () => Assert.Equal((false, PressAwayBehavior.Ignore), (profiles[0].Modal, profiles[0].PressAway)),
                () => Assert.Equal((false, PressAwayBehavior.PassThrough), (profiles[1].Modal, profiles[1].PressAway)),
                () => Assert.Equal((true, PressAwayBehavior.Ignore), (profiles[2].Modal, profiles[2].PressAway)));
        }

        [Fact]
        public void Should_be_inert_while_disabled()
        {
            // Arrange
            using var ctx = new FormaWindowTests();

            // Act
            var cut = ctx.Render(@<FormaWindow Title="Folders" Disabled="true" />);

            // Assert
            Assert.True(cut.Find(".forma-window").HasAttribute("inert"));
        }

        [Fact]
        public void Should_ask_before_closing_and_stay_open_when_declined()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var closed = 0;
            var decline = true;

            // Act
            var cut = ctx.Render(@<FormaWindow Title="Folders" OnClosing="args => args.Cancel = decline" OnClose="() => closed++" />);
            cut.Find("button[aria-label=Close]").Click();
            var afterDecline = closed;
            decline = false;
            cut.Find("button[aria-label=Close]").Click();

            // Assert
            Assert.Multiple(
                () => Assert.Equal(0, afterDecline),
                () => Assert.Equal(1, closed));
        }

        [Fact]
        public void Should_close_the_windows_it_opened_when_it_closes()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var childClosed = false;
            FormaWindow? parent = null;
            var parentCut = ctx.Render(@<FormaWindow @ref="parent" Title="Parent" />);
            ctx.Render(@<FormaWindow Title="Child" Parent="parent" OnClose="() => childClosed = true" />);

            // Act
            parentCut.Find("button[aria-label=Close]").Click();

            // Assert
            Assert.True(childClosed);
        }

        [Fact]
        public void Should_keep_the_parent_open_when_a_child_declines()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var parentClosed = false;
            FormaWindow? parent = null;
            var parentCut = ctx.Render(@<FormaWindow @ref="parent" Title="Parent" OnClose="() => parentClosed = true" />);
            ctx.Render(@<FormaWindow Title="Child" Parent="parent" OnClosing="args => args.Cancel = true" />);

            // Act
            parentCut.Find("button[aria-label=Close]").Click();

            // Assert
            Assert.False(parentClosed);
        }

        [Fact]
        public async Task Should_scope_its_own_operations_to_its_descendants()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var manager = GetWindowManager(ctx);
            FormaWindow? parent = null;
            ctx.Render(@<FormaWindow @ref="parent" Title="Parent" />);
            ctx.Render(
                @<div>
                    <FormaWindow Title="Properties" Parent="parent" />
                    <FormaWindow Title="Properties" />
                </div>);

            // Act
            var result = await parent!.MinimizeAsync(new WindowSelector { Title = "Properties" });

            // Assert
            Assert.Multiple(
                () => Assert.True(result.Succeeded),
                () => Assert.Single(result.Windows),
                () => Assert.Same(parent, manager.GetParent(result.Windows[0])));
        }
    }
