        [Fact]
        public async Task Should_become_current_on_a_press_inside_it()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var manager = GetWindowManager(ctx);
            ctx.Render(@<FormaWindow Title="Other" />);
            var cut = ctx.Render(@<FormaWindow Title="Folders"><Body>Plain text</Body></FormaWindow>);
            ctx.Render(@<FormaWindow Title="Later" />);

            // Act — the window's script tells it of the press
            var window = cut.FindComponent<FormaWindow>();
            await window.InvokeAsync(window.Instance.HandlePressAsync);

            // Assert
            Assert.Equal("Folders", manager.Current?.Title);
        }

        [Fact]
        public void Should_become_current_when_it_opens()
        {
