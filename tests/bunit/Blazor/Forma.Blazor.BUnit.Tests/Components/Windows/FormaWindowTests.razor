        [Fact]
        public void Should_announce_modality_and_stand_a_root_modal_on_a_scrim()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            FormaWindow? parent = null;

            // Act
            var plain = ctx.Render(@<FormaWindow Title="Plain" />);
            var rootModal = ctx.Render(@<FormaWindow Title="Root" Modal="true" />);
            ctx.Render(@<FormaWindow @ref="parent" Title="Parent" />);
            var childModal = ctx.Render(@<FormaWindow Title="Child" Parent="parent" Modal="true" />);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("false", plain.Find(".forma-window").GetAttribute("aria-modal")),
                () => Assert.Equal("true", rootModal.Find(".forma-window").GetAttribute("aria-modal")),
                () => Assert.Single(rootModal.FindAll(".forma-window-scrim")),
                () => Assert.Empty(childModal.FindAll(".forma-window-scrim")),
                () => Assert.Empty(plain.FindAll(".forma-window-scrim")));
        }

        [Fact]
        public void Should_go_inert_while_a_modal_child_blocks_it()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            FormaWindow? parent = null;
            var parentCut = ctx.Render(@<FormaWindow @ref="parent" Title="Parent" />);
            var sibling = ctx.Render(@<FormaWindow Title="Sibling" />);

            // Act
            var modal = ctx.Render(@<FormaWindow Title="Modal" Parent="parent" Modal="true" />);
            var blockedWhileShown = parentCut.Find(".forma-window").HasAttribute("inert");
            modal.Find("button[aria-label=Close]").Click();

            // Assert
            Assert.Multiple(
                () => Assert.True(blockedWhileShown),
                () => Assert.False(sibling.Find(".forma-window").HasAttribute("inert")),
                () => Assert.False(parentCut.Find(".forma-window").HasAttribute("inert")));
        }

        [Fact]
        public async Task Should_send_itself_back_on_a_press_away_when_its_options_say_so()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            var manager = GetWindowManager(ctx);
            var closed = false;
            var cut = ctx.Render(
                @<div>
                    <FormaWindow Title="Back" Options="new() { PressAway = WindowPressAway.SendToBack }" OnClose="() => closed = true" />
                    <FormaWindow Title="Front" />
                </div>);
            await manager.ActivateAsync(new WindowSelector { Title = "Back" });

            // Act
            await ctx.Router.DismissAsync(cut.FindComponents<FormaWindow>()[0].Instance.RootElement, DismissBehavior.Dismiss, DismissReason.PressAway);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Back", manager.StackedWindows[0].Title),
                () => Assert.False(closed));
        }

        [Fact]
        public async Task Should_come_forward_on_a_press_while_current_but_sent_back()
        {
