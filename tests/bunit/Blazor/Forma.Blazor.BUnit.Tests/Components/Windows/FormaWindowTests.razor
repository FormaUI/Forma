            var cut = ctx.Render(@<FormaWindow Title="Folders"><Body>Kept</Body></FormaWindow>);
            cut.Find("button[aria-label=Minimize]").Click();

            // Act — the window's script tells it of a press made before the minimize hid it
            var window = cut.FindComponent<FormaWindow>();
            await window.InvokeAsync(window.Instance.HandlePressAsync);

