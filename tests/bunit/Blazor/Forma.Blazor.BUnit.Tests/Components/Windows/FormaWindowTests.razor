        [Fact]
        public void Should_hide_its_children_when_minimized()
        {
            // Arrange
            using var ctx = new FormaWindowTests();
            FormaWindow? parent = null;
            var parentCut = ctx.Render(@<FormaWindow @ref="parent" Title="Parent" />);
            var childCut = ctx.Render(@<FormaWindow Title="Child" Parent="parent" />);

            // Act
            parentCut.Find("button[aria-label=Minimize]").Click();

            // Assert
            Assert.Multiple(
