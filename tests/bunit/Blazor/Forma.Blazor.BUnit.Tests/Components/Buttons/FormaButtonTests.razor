@inherits FormaBunitContext
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_a_button_element_with_the_child_content()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton>Save</FormaButton>);
            var button = cut.Find(".forma-button");

            // Assert
            Assert.Equal("BUTTON", button.TagName);
            Assert.Equal("Save", button.TextContent);
        }

        [Theory]
        [InlineData(ButtonType.Submit, false)]
        [InlineData(ButtonType.Button, true)]
        public async Task Should_run_a_click_that_reads_its_form_with_the_text_the_reader_typed(ButtonType type, bool readsForm)
        {
            // Arrange — a submit button, or another that reads the form
            using var ctx = new FormaButtonTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel();
            string? saved = null;
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text" Label="Name" />
                <FormaButton Type="type" ReadsForm="readsForm" OnClick="@(() => saved = model.Text)">Save</FormaButton>
            </FakeFormHost>);
            var typing = fields.CommitHeld(cut.Find("input"), "Ada");
            var clicking = cut.Find("button").ClickAsync(new());
            var isClickedAtOnce = clicking.IsCompleted;

            // Act
            await typing.ReleaseAsync();
            await clicking;

            // Assert
            Assert.Multiple(
                () => Assert.False(isClickedAtOnce),
                () => Assert.Equal("Ada", saved));
        }

        [Theory]
        [InlineData(ButtonType.Submit, false)]
        [InlineData(ButtonType.Button, true)]
        public async Task Should_run_no_click_that_reads_its_form_while_a_field_s_text_did_not_arrive(ButtonType type, bool readsForm)
        {
            // Arrange — a submit button, or another that reads the form
            using var ctx = new FormaButtonTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel();
            var clicks = 0;
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text" Label="Name" Options="@(new TextBoxOptions { MaxLength = 2 })" />
                <FormaButton Type="type" ReadsForm="readsForm" OnClick="@(() => clicks++)">Save</FormaButton>
            </FakeFormHost>);
            await fields.TypeAsync(cut.Find("input"), "Ada Lovelace");

            // Act
            await cut.Find("button").ClickAsync(new());

            // Assert
            Assert.Equal(0, clicks);
        }

        [Fact]
        public async Task Should_run_any_other_click_in_a_form_while_a_field_s_text_did_not_arrive()
        {
            // Arrange — a button reading nothing of the form, as a pager's step or a dialog's Cancel
            using var ctx = new FormaButtonTests();
            var fields = new TextFieldProbe(ctx);
            var model = new FakeModel();
            var clicks = 0;
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaTextBox @bind-Value="model.Text" Label="Name" Options="@(new TextBoxOptions { MaxLength = 2 })" />
                <FormaButton OnClick="@(() => clicks++)">Next</FormaButton>
            </FakeFormHost>);
            await fields.TypeAsync(cut.Find("input"), "Ada Lovelace");

            // Act
            await cut.Find("button").ClickAsync(new());

            // Assert
            Assert.Equal(1, clicks);
        }

        [Fact]
        public void Should_render_the_secondary_variant_by_default()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton>Save</FormaButton>);

            // Assert
            Assert.Contains("forma-button-secondary", cut.Find(".forma-button").ClassName);
        }

        [Theory]
        [InlineData(ButtonVariant.Primary, "forma-button-primary")]
        [InlineData(ButtonVariant.Secondary, "forma-button-secondary")]
        [InlineData(ButtonVariant.Tertiary, "forma-button-tertiary")]
        [InlineData(ButtonVariant.Danger, "forma-button-danger")]
        [InlineData(ButtonVariant.Ghost, "forma-button-ghost")]
        public void Should_render_the_class_of_the_requested_variant(ButtonVariant variant, string expected)
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton Variant="variant">Save</FormaButton>);

            // Assert
            Assert.Contains(expected, cut.Find(".forma-button").ClassName);
        }

        [Fact]
        public void Should_render_the_mini_size_only_when_asked()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var normal = ctx.Render(@<FormaButton>Save</FormaButton>);
            var mini = ctx.Render(@<FormaButton Size="ButtonSize.Mini">Save</FormaButton>);

            // Assert
            Assert.DoesNotContain("forma-button-mini", normal.Find(".forma-button").ClassName);
            Assert.Contains("forma-button-mini", mini.Find(".forma-button").ClassName);
        }

        [Fact]
        public void Should_render_the_icon_size_only_when_asked()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var text = ctx.Render(@<FormaButton>Save</FormaButton>);
            var icon = ctx.Render(@<FormaButton IconOnly="true">X</FormaButton>);

            // Assert
            Assert.DoesNotContain("forma-button-icon", text.Find(".forma-button").ClassName);
            Assert.Contains("forma-button-icon", icon.Find(".forma-button").ClassName);
        }

        [Theory]
        [InlineData(ButtonType.Button, "button")]
        [InlineData(ButtonType.Submit, "submit")]
        [InlineData(ButtonType.Reset, "reset")]
        public void Should_render_the_requested_type_attribute(ButtonType type, string expected)
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton Type="type">Save</FormaButton>);

            // Assert
            Assert.Equal(expected, cut.Find(".forma-button").GetAttribute("type"));
        }

        [Fact]
        public void Should_invoke_the_click_callback()
        {
            // Arrange
            using var ctx = new FormaButtonTests();
            var clicks = 0;

            // Act
            var cut = ctx.Render(@<FormaButton OnClick="() => clicks++">Save</FormaButton>);
            cut.Find(".forma-button").Click();

            // Assert
            Assert.Equal(1, clicks);
        }

        [Fact]
        public void Should_leave_its_clicks_in_the_browser_while_nothing_handles_them()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton>Save</FormaButton>);

            // Assert
            Assert.False(cut.Find(".forma-button").HasAttribute("blazor:onclick"));
        }

        [Fact]
        public void Should_disable_the_button_when_disabled()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton Disabled="true">Save</FormaButton>);

            // Assert
            Assert.True(cut.Find(".forma-button").HasAttribute("disabled"));
        }

        [Fact]
        public void Should_announce_busy_without_leaving_the_tab_order()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton Busy="true">Save</FormaButton>);
            var button = cut.Find(".forma-button");

            // Assert
            Assert.Equal("true", button.GetAttribute("data-busy"));
            Assert.Equal("true", button.GetAttribute("aria-busy"));
            Assert.Equal("true", button.GetAttribute("aria-disabled"));
            Assert.False(button.HasAttribute("disabled"));
        }

        [Fact]
        public void Should_not_invoke_the_click_callback_when_busy()
        {
            // Arrange
            using var ctx = new FormaButtonTests();
            var clicks = 0;

            // Act
            var cut = ctx.Render(@<FormaButton Busy="true" OnClick="() => clicks++">Save</FormaButton>);
            cut.Find(".forma-button").Click();

            // Assert
            Assert.Equal(0, clicks);
        }

        [Fact]
        public void Should_render_both_labels_when_given_busy_text()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton Busy="true" BusyText="Saving…">Save</FormaButton>);

            // Assert
            Assert.Equal("Save", cut.Find(".forma-button-label").TextContent);
            Assert.Equal("Saving…", cut.Find(".forma-button-busy-label").TextContent);
        }

        [Fact]
        public void Should_keep_showing_progress_when_disabled_and_busy()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton Busy="true" Disabled="true">Save</FormaButton>);
            var button = cut.Find(".forma-button");

            // Assert
            Assert.Equal("true", button.GetAttribute("data-busy"));
            Assert.Equal("true", button.GetAttribute("aria-busy"));
            Assert.True(button.HasAttribute("disabled"));
        }

        [Fact]
        public void Should_release_the_button_when_busy_ends()
        {
            // Arrange
            using var ctx = new FormaButtonTests();
            var clicks = 0;
            var cut = ctx.Render<FormaButton>(parameters => parameters
                .Add(p => p.Busy, true)
                .Add(p => p.OnClick, () => clicks++)
                .AddChildContent("Save"));
            cut.Find(".forma-button").Click();

            // Act
            cut.Render(parameters => parameters.Add(p => p.Busy, false));
            cut.Find(".forma-button").Click();
            var button = cut.Find(".forma-button");

            // Assert
            Assert.Equal(1, clicks);
            Assert.Equal("false", button.GetAttribute("data-busy"));
            Assert.False(button.HasAttribute("aria-busy"));
            Assert.False(button.HasAttribute("aria-disabled"));
        }

        [Fact]
        public void Should_omit_aria_busy_when_not_busy()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton>Save</FormaButton>);
            var button = cut.Find(".forma-button");

            // Assert
            Assert.False(button.HasAttribute("aria-busy"));
            Assert.False(button.HasAttribute("aria-disabled"));
        }

        [Fact]
        public void Should_keep_its_own_classes_when_the_host_supplies_one()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton class="row-action">Save</FormaButton>);
            var className = cut.Find(".forma-button").ClassName;

            // Assert
            Assert.Contains("forma-button-secondary", className);
            Assert.Contains("row-action", className);
        }

        [Fact]
        public void Should_carry_its_own_identity_beside_the_hosts_id()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var save = ctx.Render<FormaButton>(parameters => parameters.Add(button => button.Id, "save")).Find("button");
            var cancel = ctx.Render<FormaButton>(parameters => parameters.Add(button => button.Id, "cancel")).Find("button");

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("save", save.Id);
                Assert.False(string.IsNullOrEmpty(save.GetAttribute("data-rid")));
                Assert.NotEqual(save.GetAttribute("data-rid"), cancel.GetAttribute("data-rid"));
            });
        }

        [Fact]
        public void Should_pass_unmatched_attributes_through()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton aria-label="Delete row" />);

            // Assert
            Assert.Equal("Delete row", cut.Find(".forma-button").GetAttribute("aria-label"));
        }

        [Fact]
        public void Should_be_disabled_before_the_renderer_is_interactive_when_it_has_a_click_handler()
        {
            // Arrange
            using var ctx = new FormaButtonTests();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));

            // Act
            var cut = ctx.Render(@<FormaButton OnClick="() => { }">Save</FormaButton>);

            // Assert
            Assert.True(cut.Find(".forma-button").HasAttribute("disabled"));
        }

        [Fact]
        public void Should_stay_enabled_before_the_renderer_is_interactive_without_a_click_handler()
        {
            // Arrange
            using var ctx = new FormaButtonTests();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));

            // Act
            var cut = ctx.Render(@<FormaButton Type="ButtonType.Submit">Save</FormaButton>);

            // Assert
            Assert.False(cut.Find(".forma-button").HasAttribute("disabled"));
        }

        [Fact]
        public void Should_be_enabled_once_the_renderer_is_interactive()
        {
            // Arrange
            using var ctx = new FormaButtonTests();
            ctx.SetRendererInfo(new RendererInfo("Server", isInteractive: true));

            // Act
            var cut = ctx.Render(@<FormaButton OnClick="() => { }">Save</FormaButton>);

            // Assert
            Assert.False(cut.Find(".forma-button").HasAttribute("disabled"));
        }
    }

    public sealed class Link
    {
        [Fact]
        public void Should_draw_a_link_to_its_address_in_the_buttons_look()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton Href="/articles/new" Target="_blank" Rel="noopener" Variant="ButtonVariant.Primary">New Article</FormaButton>);

            // Assert
            var link = cut.Find("a");
            Assert.Multiple(
                () => Assert.Equal("/articles/new", link.GetAttribute("href")),
                () => Assert.Equal("_blank", link.GetAttribute("target")),
                () => Assert.Equal("noopener", link.GetAttribute("rel")),
                () => Assert.Null(link.GetAttribute("role")),
                () => Assert.Contains("forma-button-primary", link.ClassList),
                () => Assert.Empty(cut.FindAll("button")));
        }

        [Theory]
        [InlineData(true, false)]
        [InlineData(false, true)]
        public void Should_name_no_address_while_disabled_or_busy_and_stay_a_link(bool disabled, bool busy)
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton Href="/articles/new" Disabled="disabled" Busy="busy">New Article</FormaButton>);

            // Assert
            var link = cut.Find("a");
            Assert.Multiple(
                () => Assert.False(link.HasAttribute("href")),
                () => Assert.Equal("link", link.GetAttribute("role")),
                () => Assert.Equal("true", link.GetAttribute("aria-disabled")),
                () => Assert.Equal(disabled, link.ClassList.Contains("is-disabled")));
        }

        [Fact]
        public void Should_take_no_press_while_disabled()
        {
            // Arrange
            using var ctx = new FormaButtonTests();
            var presses = 0;
            var cut = ctx.Render(@<FormaButton Href="/articles/new" Disabled="true" OnClick="@(() => presses++)">New Article</FormaButton>);

            // Act
            var press = () => cut.Find("a").Click();

            // Assert
            Assert.Throws<MissingEventHandlerException>(press);
            Assert.Equal(0, presses);
        }

        [Fact]
        public void Should_stay_in_the_tab_order_while_busy()
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            var cut = ctx.Render(@<FormaButton Href="/articles/new" Busy="true">New Article</FormaButton>);

            // Assert
            Assert.Equal("0", cut.Find("a").GetAttribute("tabindex"));
        }

        [Fact]
        public void Should_keep_its_address_under_a_static_render()
        {
            // Arrange
            using var ctx = new FormaButtonTests();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));

            // Act
            var cut = ctx.Render(@<FormaButton Href="/articles/new" OnClick="@(() => { })">New Article</FormaButton>);

            // Assert
            Assert.Equal("/articles/new", cut.Find("a").GetAttribute("href"));
        }

        [Theory]
        [InlineData(ButtonType.Submit, false)]
        [InlineData(ButtonType.Reset, false)]
        [InlineData(ButtonType.Button, true)]
        public void Should_refuse_an_address_on_a_button_that_works_a_form(ButtonType type, bool readsForm)
        {
            // Arrange
            using var ctx = new FormaButtonTests();

            // Act
            void Render() => ctx.Render(@<FormaButton Href="/articles/new" Type="type" ReadsForm="readsForm">Save</FormaButton>);

            // Assert
            Assert.Throws<ArgumentException>(Render);
        }
    }
}
