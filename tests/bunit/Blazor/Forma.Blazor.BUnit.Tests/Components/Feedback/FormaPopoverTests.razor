@inherits FormaBunitContext
@using Microsoft.Extensions.Logging
@using Forma.Blazor.Components.Interaction
@using Forma.Framework.Input
@using Forma.Framework.Input.Interop
@using Forma.Framework.Input.Keyboard
@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_a_manual_popover_with_nothing_inside_while_closed()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();

            // Act
            var cut = ctx.Render(@<FormaPopover Anchor="default"><p>Content</p></FormaPopover>);

            // Assert
            var root = cut.Find(".forma-popover");
            Assert.Multiple(
                () => Assert.Equal("manual", root.GetAttribute("popover")),
                () => Assert.Empty(root.Children),
                () => Assert.False(cut.FindComponent<FormaPopover>().Instance.IsOpen));
        }

        [Fact]
        public async Task Should_render_the_content_once_opened()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var cut = ctx.Render(@<FormaPopover Anchor="default"><p>Content</p></FormaPopover>);

            // Act
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Content", cut.Find(".forma-popover p").TextContent),
                () => Assert.Contains("forma-popover-open", cut.Find(".forma-popover").ClassList),
                () => Assert.True(cut.FindComponent<FormaPopover>().Instance.IsOpen));
        }

        [Fact]
        public async Task Should_close_when_dismissed_by_a_press_away()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(@<FormaPopover Anchor="default"><p>Content</p></FormaPopover>);
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));

            // Act
            await router.DismissAsync(cut.FindComponent<FormaPopover>().Instance.RootElement, DismissBehavior.Dismiss, DismissReason.PressAway);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll(".forma-popover p")),
                () => Assert.False(cut.FindComponent<FormaPopover>().Instance.IsOpen));
        }

        [Fact]
        public async Task Should_close_when_dismissed_by_escape()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var router = new InputRouterProbe(ctx);
            var cut = ctx.Render(@<FormaPopover Anchor="default"><p>Content</p></FormaPopover>);
            var popover = cut.FindComponent<FormaPopover>().Instance;
            await cut.InvokeAsync(() => popover.OpenAsync(default));

            // Act
            await router.DismissAsync(popover.RootElement, DismissBehavior.Dismiss, DismissReason.Escape);

            // Assert
            Assert.Multiple(
                () => Assert.False(popover.IsOpen),
                () => Assert.Empty(cut.FindAll(".forma-popover p")));
        }

        [Fact]
        public async Task Should_register_a_scope_with_its_trigger_inside_once_open()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var router = ctx.JSInterop.SetupModule("./_content/forma/input/scripts/InputRouter.js");
            var cut = ctx.Render(@<FormaPopover Anchor="default"><p>Content</p></FormaPopover>);

            // Act
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));

            // Assert
            var registration = Assert.Single(router.Invocations, invocation => invocation.Identifier == "register");
            Assert.Multiple(
                () => Assert.IsType<DotNetObjectReference<InputRegistration>>(registration.Arguments[2]),
                () => Assert.Equal(DismissBehavior.Dismiss, Assert.IsType<InputProfile>(registration.Arguments[1]).Escape),
                () => Assert.Equal(PressAwayBehavior.PassThrough, Assert.IsType<InputProfile>(registration.Arguments[1]).PressAway));
        }

        [Fact]
        public async Task Should_register_its_scope_before_it_opens_so_keys_typed_as_the_focus_moves_in_are_its_own()
        {
            // Arrange — whether the scope was registered when the script opened the popover
            using var ctx = new FormaPopoverTests();
            var router = ctx.JSInterop.SetupModule("./_content/forma/input/scripts/InputRouter.js");
            var script = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/behaviors/AnchoredPopover.js");
            var popover = script.SetupModule("attach", _ => true);
            bool? isRegisteredWhenOpened = null;
            popover.SetupVoid("open", _ =>
            {
                isRegisteredWhenOpened ??= router.Invocations.Any(invocation => invocation.Identifier == "register");
                return true;
            }).SetVoidResult();
            var cut = ctx.Render(@<FormaPopover Anchor="default"><p>Content</p></FormaPopover>);

            // Act
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));

            // Assert
            Assert.True(isRegisteredWhenOpened);
        }

        [Fact]
        public async Task Should_open_and_hand_its_content_the_focus_only_once_its_scope_is_registered_though_it_renders_again_meanwhile()
        {
            // Arrange — rendered again while its scope's registration still waits on the browser
            using var ctx = new FormaPopoverTests();
            var register = new HeldObjectReferenceHandler("register");
            ctx.JSInterop.SetupModule("./_content/forma/input/scripts/InputRouter.js").AddInvocationHandler(register);
            var script = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/behaviors/AnchoredPopover.js");
            var isRegistered = false;
            bool? isRegisteredWhenOpened = null;
            bool? isRegisteredWhenFocused = null;
            script.SetupModule("attach", _ => true).SetupVoid("open", _ =>
            {
                isRegisteredWhenOpened ??= isRegistered;
                return true;
            }).SetVoidResult();
            var cut = ctx.Render(@<FormaPopover Anchor="default" OnOpened="() => isRegisteredWhenFocused ??= isRegistered"><p>Content</p></FormaPopover>);
            var popover = cut.FindComponent<FormaPopover>();
            await popover.InvokeAsync(() => popover.Instance.OpenAsync(default));
            popover.Render();

            // Act
            await cut.ReleaseAsync(() =>
            {
                isRegistered = true;
                register.Answer(Assert.Single(register.HeldCalls), new FakeJSObjectReference((_, _) => null));
            });

            // Assert
            Assert.Multiple(
                () => Assert.True(isRegisteredWhenOpened),
                () => Assert.True(isRegisteredWhenFocused));
        }

        [Fact]
        public async Task Should_stay_unopened_when_closed_while_its_scope_registers()
        {
            // Arrange — closed while its scope's registration still waits on the browser
            using var ctx = new FormaPopoverTests();
            var register = new HeldObjectReferenceHandler("register");
            ctx.JSInterop.SetupModule("./_content/forma/input/scripts/InputRouter.js").AddInvocationHandler(register);
            var script = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/behaviors/AnchoredPopover.js");
            var popup = script.SetupModule("attach", _ => true);
            popup.SetupVoid("open", _ => true).SetVoidResult();
            var openedCount = 0;
            var cut = ctx.Render(@<FormaPopover Anchor="default" OnOpened="() => openedCount++"><p>Content</p></FormaPopover>);
            var popover = cut.FindComponent<FormaPopover>();
            await popover.InvokeAsync(() => popover.Instance.OpenAsync(default));
            var closing = popover.InvokeAsync(() => popover.Instance.CloseAsync());

            // Act
            await cut.ReleaseAsync(() => register.Answer(Assert.Single(register.HeldCalls), new FakeJSObjectReference((_, _) => null)));
            await closing;

            // Assert
            Assert.Multiple(
                () => Assert.False(popover.Instance.IsOpen),
                () => Assert.Empty(popup.Invocations["open"]),
                () => Assert.Equal(0, openedCount));
        }

        [Fact]
        public async Task Should_register_its_content_s_routes()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var router = ctx.JSInterop.SetupModule("./_content/forma/input/scripts/InputRouter.js");
            IReadOnlyList<InputRoute> routes = [new InputRoute("list.next", new KeyBinding("ArrowDown"))];
            var cut = ctx.Render(@<FormaPopover Anchor="default" InputRoutes="routes"><p>Content</p></FormaPopover>);

            // Act
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));

            // Assert
            var registration = Assert.Single(router.Invocations, invocation => invocation.Identifier == "register");
            Assert.Same(routes, Assert.IsType<InputProfile>(registration.Arguments[1]).InputRoutes);
        }

        [Fact]
        public async Task Should_raise_OnInputAction_with_the_action_and_input_the_router_resolved()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var router = new InputRouterProbe(ctx);
            InputAction? received = null;
            var cut = ctx.Render(@<FormaPopover Anchor="default" InputRoutes="@([new InputRoute("list.next", new KeyBinding("ArrowDown"))])" OnInputAction="action => received = action"><p>Content</p></FormaPopover>);
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));

            // Act
            await router.RouteAsync(cut.FindComponent<FormaPopover>().Instance.RootElement, "list.next", "ArrowDown");

            // Assert
            Assert.NotNull(received);
            Assert.Multiple(
                () => Assert.Equal("list.next", received.Action),
                () => Assert.Equal("ArrowDown", Assert.IsType<InputKeyInfo>(received.Input).Key));
        }

        [Fact]
        public async Task Should_log_a_refused_action_and_a_refused_dismissal_under_its_own_category_and_identity()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            using var loggerFactory = new FakeLoggerFactory();
            ctx.Services.AddSingleton<ILoggerFactory>(loggerFactory);
            var router = new InputRouterProbe(ctx);
            InputAction? received = null;
            var cut = ctx.Render(@<FormaPopover Anchor="default" InputRoutes="@([new InputRoute("list.next", new KeyBinding("ArrowDown"))])" OnInputAction="action => received = action"><p>Content</p></FormaPopover>);
            var popover = cut.FindComponent<FormaPopover>().Instance;
            await cut.InvokeAsync(() => popover.OpenAsync(default));
            var runtimeId = cut.Find(".forma-popover").GetAttribute("data-rid")!;

            // Act
            await router.RouteAsync("list.next", new InputKeyInfo { Type = null!, Key = "ArrowDown" });
            await router.DismissAsync(popover.RootElement, (DismissBehavior)7, DismissReason.Escape);

            // Assert
            Assert.Multiple(
                () => Assert.Null(received),
                () => Assert.True(popover.IsOpen),
                () => Assert.Equal(2, loggerFactory.Entries.Count(entry => entry.Level == LogLevel.Debug && entry.Category == typeof(FormaPopover).FullName && entry.Message.Contains(runtimeId, StringComparison.Ordinal) && entry.Message.Contains("and was refused", StringComparison.Ordinal))));
        }

        [Fact]
        public async Task Should_declare_no_press_away_dismissal_when_turned_off()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var router = ctx.JSInterop.SetupModule("./_content/forma/input/scripts/InputRouter.js");
            var cut = ctx.Render(@<FormaPopover Anchor="default" PressAway="false"><p>Content</p></FormaPopover>);

            // Act
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));

            // Assert
            var registration = Assert.Single(router.Invocations, invocation => invocation.Identifier == "register");
            Assert.Equal(PressAwayBehavior.Ignore, Assert.IsType<InputProfile>(registration.Arguments[1]).PressAway);
        }

        [Fact]
        public async Task Should_open_on_the_next_render_once_its_script_failed_to_open_it()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var script = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/behaviors/AnchoredPopover.js");
            var popover = script.SetupModule("attach", _ => true);
            var open = popover.SetupVoid("open", _ => true);
            open.SetException(new Microsoft.JSInterop.JSException("The popover was not in the document."));
            var cut = ctx.Render(@<FormaPopover Anchor="default"><p>Content</p></FormaPopover>);
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));
            open.SetVoidResult();

            // Act
            cut.FindComponent<FormaPopover>().Render(parameters => parameters.Add(p => p.Class, "reopened"));

            // Assert
            Assert.Equal(2, popover.Invocations["open"].Count);
        }

        [Fact]
        public async Task Should_toggle_between_open_and_closed()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var cut = ctx.Render(@<FormaPopover Anchor="default"><p>Content</p></FormaPopover>);
            var popover = cut.FindComponent<FormaPopover>().Instance;

            // Act
            await cut.InvokeAsync(() => popover.ToggleAsync(default));
            var openedOnce = popover.IsOpen;
            await cut.InvokeAsync(() => popover.ToggleAsync(default));

            // Assert
            Assert.Multiple(
                () => Assert.True(openedOnce),
                () => Assert.False(popover.IsOpen));
        }

        [Fact]
        public async Task Should_ignore_a_close_while_already_closed()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var changes = new List<bool>();
            var cut = ctx.Render(@<FormaPopover Anchor="default" OnOpenChanged="isOpen => changes.Add(isOpen)" />);

            // Act
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.CloseAsync());

            // Assert
            Assert.Empty(changes);
        }

        [Fact]
        public async Task Should_report_each_change_of_open_state()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();
            var changes = new List<bool>();
            var cut = ctx.Render(@<FormaPopover Anchor="default" OnOpenChanged="isOpen => changes.Add(isOpen)" />);

            // Act
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.OpenAsync(default));
            await cut.InvokeAsync(() => cut.FindComponent<FormaPopover>().Instance.CloseAsync());

            // Assert
            Assert.Equal([true, false], changes);
        }

        [Fact]
        public void Should_merge_the_host_class_and_pass_other_attributes_through()
        {
            // Arrange
            using var ctx = new FormaPopoverTests();

            // Act
            var cut = ctx.Render(@<FormaPopover Anchor="default" class="host-popover" id="host-id" />);

            // Assert
            var root = cut.Find(".forma-popover");
            Assert.Multiple(
                () => Assert.Contains("host-popover", root.ClassList),
                () => Assert.Equal("host-id", root.Id));
        }
    }
}
