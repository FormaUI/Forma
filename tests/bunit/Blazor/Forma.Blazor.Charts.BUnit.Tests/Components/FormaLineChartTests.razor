@inherits FormaBunitContext

@code {
    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-US");

    // A series of points, each a time and its value.
    private static ChartSeries CreateSeries(string name, params (string Time, double? Value)[] points)
        => new(name, [.. points.Select(point => new ChartPoint(DateTimeOffset.Parse(point.Time, CultureInfo.InvariantCulture), point.Value))]);

    // The context in English, its clock in the time zone named.
    private static async Task<FormaLineChartTests> CreateContextAsync(string timeZoneId = "UTC")
    {
        var ctx = new FormaLineChartTests();
        ctx.Clock.SetLocalTimeZone(TimeZoneInfo.FindSystemTimeZoneById(timeZoneId));
        await ctx.ChangeCultureAsync("en-US");

        return ctx;
    }

    // Each row of the chart's table: its period and each series' value.
    private static string[][] ReadTable(IRenderedComponent<ContainerFragment> cut)
        => [.. cut.FindAll(".forma-chart-table tbody tr").Select(row => row.Children.Select(cell => cell.TextContent.Trim()).ToArray())];

    // A series whose points each carry a mark of their own, as many as asked.
    private static ChartSeries CreateMarkedSeries(int count)
        => new("Value", [.. Enumerable.Range(0, count).Select(index => new ChartPoint(DateTimeOffset.UnixEpoch.AddDays(index), index) { Mark = new ChartMark($"Mark {index}") })]);

    private static string FormatHour(int year, int month, int day, int hour)
        => new DateTime(year, month, day, hour, 0, 0, DateTimeKind.Unspecified).ToString("g", English);

    public sealed class Periods
    {
        [Fact]
        public async Task Should_cover_a_day_of_hours_ending_with_the_hour_that_holds_its_end()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T14:30:00Z", CultureInfo.InvariantCulture);

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Page load" Series='[CreateSeries("Median")]' Range="ChartRange.Day" End="end" />);

            // Assert
            var rows = ReadTable(cut);
            Assert.Multiple(
                () => Assert.Equal(24, rows.Length),
                () => Assert.Equal(FormatHour(2026, 11, 22, 15), rows[0][0]),
                () => Assert.Equal(FormatHour(2026, 11, 23, 14), rows[^1][0]));
        }

        [Fact]
        public async Task Should_hold_the_hours_that_passed_on_a_day_its_zone_turns_its_clock_back()
        {
            // Arrange — Madrid's clock turns back from 03:00 to 02:00 on October 25, 2026
            using var ctx = await CreateContextAsync("Europe/Madrid");
            var end = DateTimeOffset.Parse("2026-10-25T11:30:00Z", CultureInfo.InvariantCulture);

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Page load" Series='[CreateSeries("Median")]' Range="ChartRange.Day" End="end" />);

            // Assert — 24 hours that passed, the hour from two o'clock read twice
            var periods = ReadTable(cut).Select(row => row[0]).ToList();
            Assert.Multiple(
                () => Assert.Equal(24, periods.Count),
                () => Assert.Equal(2, periods.Count(period => period == FormatHour(2026, 10, 25, 2))),
                () => Assert.Equal(FormatHour(2026, 10, 24, 14), periods[0]),
                () => Assert.Equal(FormatHour(2026, 10, 25, 12), periods[^1]));
        }

        [Fact]
        public async Task Should_start_each_day_at_its_zone_s_midnight()
        {
            // Arrange — Kolkata stands five and a half hours ahead of the universal clock
            using var ctx = await CreateContextAsync("Asia/Kolkata");
            var end = DateTimeOffset.Parse("2026-11-23T00:00:00Z", CultureInfo.InvariantCulture);
            var visits = CreateSeries("Visits", ("2026-11-22T18:00:00Z", 5), ("2026-11-22T19:00:00Z", 7));

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Visits" Series="[visits]" Range="ChartRange.ThirtyDays" End="end" />);

            // Assert — half past eleven on the 22nd and half past midnight on the 23rd, on Kolkata's clock
            var rows = ReadTable(cut);
            Assert.Multiple(
                () => Assert.Equal(30, rows.Length),
                () => Assert.Equal(new DateTime(2026, 10, 25).ToString("d", English), rows[0][0]),
                () => Assert.Equal([new DateTime(2026, 11, 22).ToString("d", English), "5"], rows[^2]),
                () => Assert.Equal([new DateTime(2026, 11, 23).ToString("d", English), "7"], rows[^1]));
        }

        [Fact]
        public async Task Should_cover_seven_days_ending_with_the_day_that_holds_its_end()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T14:30:00Z", CultureInfo.InvariantCulture);

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Visits" Series='[CreateSeries("Visits")]' Range="ChartRange.SevenDays" End="end" />);

            // Assert
            var periods = ReadTable(cut).Select(row => row[0]).ToList();
            Assert.Multiple(
                () => Assert.Equal(7, periods.Count),
                () => Assert.Equal(new DateTime(2026, 11, 17).ToString("d", English), periods[0]),
                () => Assert.Equal(new DateTime(2026, 11, 23).ToString("d", English), periods[^1]));
        }
        [Fact]
        public async Task Should_cover_thirteen_months_ending_with_the_month_that_holds_its_end()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:00Z", CultureInfo.InvariantCulture);

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Storage" Series='[CreateSeries("Used")]' Range="ChartRange.ThirteenMonths" End="end" />);

            // Assert
            var periods = ReadTable(cut).Select(row => row[0]).ToList();
            Assert.Equal(["November 2025", "December 2025", "January 2026"], periods.Take(3));
            Assert.Equal(["October 2026", "November 2026"], periods.TakeLast(2));
        }

        [Fact]
        public async Task Should_end_with_the_period_holding_its_clock_s_now_where_no_end_is_given()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            ctx.Clock.SetUtcNow(DateTimeOffset.Parse("2040-06-15T14:30:00Z", CultureInfo.InvariantCulture));

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Page load" Series='[CreateSeries("Median")]' Range="ChartRange.Day" />);

            // Assert
            Assert.Equal(FormatHour(2040, 6, 15, 14), ReadTable(cut)[^1][0]);
        }
    }

    public sealed class Values
    {
        [Fact]
        public async Task Should_place_each_point_in_its_period_and_say_a_period_without_one_holds_no_data()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);
            var load = CreateSeries("Load", ("2026-11-23T11:58:10Z", 120), ("2026-11-23T11:58:50Z", 130), ("2026-11-23T11:59:00Z", null), ("2026-11-23T09:00:00Z", 999));

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Load" Series="[load]" Range="ChartRange.Hour" End="end" />);

            // Assert — the later of two points in one minute, a null and a missing minute both without data, a point outside ignored
            var values = ReadTable(cut).Select(row => row[1]).ToList();
            Assert.Multiple(
                () => Assert.Equal(["130", "No data", "No data"], values.TakeLast(3)),
                () => Assert.DoesNotContain("999", values));
        }

        [Fact]
        public async Task Should_write_its_values_and_scale_by_its_format_in_its_culture()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);
            var load = CreateSeries("Load", ("2026-11-23T12:00:00Z", 1234.5));

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Load" Series="[load]" Range="ChartRange.Hour" End="end" ValueFormat="#,0.0' ms'" />);

            // Assert — the scale reaches 1,234.5 in even steps of 500
            Assert.Multiple(
                () => Assert.Equal("1,234.5 ms", ReadTable(cut)[^1][1]),
                () => Assert.Equal(["0.0 ms", "500.0 ms", "1,000.0 ms", "1,500.0 ms"], cut.FindAll(".forma-chart-value-label").Select(label => label.TextContent.Trim())));
        }
    }

    public sealed class Lines
    {
        [Fact]
        public async Task Should_break_a_line_where_a_period_has_no_data()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);
            var load = CreateSeries("Load", ("2026-11-23T11:56:00Z", 1), ("2026-11-23T11:57:00Z", 2), ("2026-11-23T11:59:00Z", 3), ("2026-11-23T12:00:00Z", 4));

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Load" Series="[load]" Range="ChartRange.Hour" End="end" />);

            // Assert
            Assert.Equal(2, cut.FindAll("polyline.forma-chart-line").Count);
        }

        [Fact]
        public async Task Should_mark_a_point_standing_alone_between_gaps_and_its_series_last_point()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);
            var load = CreateSeries("Load", ("2026-11-23T11:50:00Z", 1), ("2026-11-23T11:56:00Z", 2), ("2026-11-23T11:57:00Z", 3));

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Load" Series="[load]" Range="ChartRange.Hour" End="end" />);

            // Assert — 11:50 alone and 11:57 last; 11:56 draws its marker only while its period is read
            var markers = cut.FindAll(".forma-chart-marker");
            Assert.Multiple(
                () => Assert.Equal(3, markers.Count),
                () => Assert.Equal([true, false, true], markers.Select(marker => marker.ClassList.Contains("is-standing"))));
        }

        [Fact]
        public async Task Should_fill_its_band_between_its_two_series_and_mark_its_threshold_within_its_scale()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);
            var median = CreateSeries("Median", ("2026-11-23T11:59:00Z", 100), ("2026-11-23T12:00:00Z", 120));
            var slowest = CreateSeries("95th percentile", ("2026-11-23T11:59:00Z", 300), ("2026-11-23T12:00:00Z", 340));

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Page load" Series="[median, slowest]" Range="ChartRange.Hour" End="end" Band="new ChartBand(0, 1)" Threshold='@(new ChartThreshold(500, "Target"))' />);

            // Assert — the threshold lifts the scale past 500, to 600 in steps of 200
            Assert.Multiple(
                () => Assert.Single(cut.FindAll("polygon.forma-chart-band.forma-chart-series-2")),
                () => Assert.Equal("Target", cut.Find(".forma-chart-threshold-label").TextContent),
                () => Assert.Contains("inset-block-end: 83.333%", cut.Find(".forma-chart-threshold").GetAttribute("style"), StringComparison.Ordinal),
                () => Assert.Equal("600", cut.FindAll(".forma-chart-value-label")[^1].TextContent.Trim()));
        }

        [Fact]
        public async Task Should_draw_a_legend_for_two_series_and_none_for_one()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);

            // Act
            var single = ctx.Render(@<FormaLineChart Title="Readers" Series='[CreateSeries("Readers")]' Range="ChartRange.Hour" End="end" />);
            var pair = ctx.Render(@<FormaLineChart Title="Machine" Series='[CreateSeries("CPU"), CreateSeries("Memory")]' Range="ChartRange.Hour" End="end" />);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(single.FindAll(".forma-chart-legend")),
                () => Assert.Equal(["CPU", "Memory"], pair.FindAll(".forma-chart-legend-name").Select(name => name.TextContent)));
        }
    }

    public sealed class Reading
    {
        [Fact]
        public async Task Should_read_its_last_period_from_its_range_control_until_the_reader_moves_it()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);
            var load = CreateSeries("Load", ("2026-11-23T11:59:00Z", 3), ("2026-11-23T12:00:00Z", 4));
            var cut = ctx.Render(@<FormaLineChart Title="Load" Series="[load]" Range="ChartRange.Hour" End="end" />);
            var control = cut.Find("input.forma-chart-scrubber");
            var lastText = $"{new DateTime(2026, 11, 23, 12, 0, 0).ToString("g", English)}, Load 4";
            var readsLast = control.GetAttribute("aria-valuetext") == lastText && control.GetAttribute("max") == "59";

            // Act
            control.Input("58");

            // Assert
            var periods = cut.FindAll(".forma-chart-period");
            Assert.Multiple(
                () => Assert.True(readsLast, "The range control doesn't start on the last of the hour's sixty periods."),
                () => Assert.Equal($"{new DateTime(2026, 11, 23, 11, 59, 0).ToString("g", English)}, Load 3", cut.Find("input.forma-chart-scrubber").GetAttribute("aria-valuetext")),
                () => Assert.True(periods[58].ClassList.Contains("is-read")),
                () => Assert.False(periods[59].ClassList.Contains("is-read")));
        }

        [Fact]
        public async Task Should_leave_its_range_control_out_and_keep_its_table_when_rendered_statically()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            ctx.SetRendererInfo(new RendererInfo("Static", isInteractive: false));
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Load" Series='[CreateSeries("Load")]' Range="ChartRange.Hour" End="end" />);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll("input.forma-chart-scrubber")),
                () => Assert.Equal(60, ReadTable(cut).Length));
        }

        [Fact]
        public async Task Should_name_its_figure_and_table_by_its_title_and_hide_its_drawing_from_assistive_technology()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);

            // Act
            var cut = ctx.Render(@<FormaLineChart Id="load" Title="Load" Series='[CreateSeries("Load")]' Range="ChartRange.Hour" End="end" />);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Load", cut.Find("#load-title").TextContent),
                () => Assert.Equal("load-title", cut.Find("figure").GetAttribute("aria-labelledby")),
                () => Assert.Equal("load-title", cut.Find("table").GetAttribute("aria-labelledby")),
                () => Assert.Equal("true", cut.Find(".forma-chart-figure").GetAttribute("aria-hidden")));
        }

        [Fact]
        public async Task Should_write_its_table_in_the_culture_it_switches_to()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);
            var cut = ctx.Render(@<FormaLineChart Title="Load" Series='[CreateSeries("Load")]' Range="ChartRange.Hour" End="end" />);

            // Act
            await ctx.ChangeCultureAsync("he");

            // Assert
            var hebrew = CultureInfo.GetCultureInfo("he");
            Assert.Multiple(
                () => Assert.Equal("זמן", cut.Find(".forma-chart-table thead th").TextContent),
                () => Assert.Equal([new DateTime(2026, 11, 23, 12, 0, 0).ToString("g", hebrew), "אין נתונים"], ReadTable(cut)[^1]));
        }
    }

    public sealed class Spans
    {
        [Fact]
        public async Task Should_stand_each_point_at_its_own_time_across_a_span_from_the_first_point_to_the_last()
        {
            // Arrange — sixty days from the first point to the second, and a leap year's 366 to the third
            using var ctx = await CreateContextAsync();
            var value = CreateSeries("Value", ("2024-01-01T00:00:00Z", 100), ("2024-03-01T00:00:00Z", 120), ("2025-01-01T00:00:00Z", 150));

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Value" Series="[value]" Range="ChartRange.Span" />);

            // Assert — a row for each point, written as a date since each falls on midnight, and the line through each point's time
            var points = cut.Find("polyline.forma-chart-line").GetAttribute("points")!.Split(' ').Select(point => point.Split(',')[0]);
            Assert.Multiple(
                () => Assert.Equal(["1/1/2024", "3/1/2024", "1/1/2025"], ReadTable(cut).Select(row => row[0])),
                () => Assert.Equal(["0", "163.93", "1000"], points));
        }

        [Fact]
        public async Task Should_label_a_span_of_years_by_every_other_year_and_each_year_as_the_chart_widens()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var value = CreateSeries("Value", ("2020-01-01T00:00:00Z", 100), ("2026-01-01T00:00:00Z", 150));

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Value" Series="[value]" Range="ChartRange.Span" />);

            // Assert
            var labels = cut.FindAll(".forma-chart-time-label");
            Assert.Multiple(
                () => Assert.Equal(["2020", "2022", "2024", "2026"], labels.Where(label => label.ClassList.Contains("is-tier-0")).Select(label => label.TextContent)),
                () => Assert.Equal(["2021", "2023", "2025"], labels.Where(label => label.ClassList.Contains("is-tier-1")).Select(label => label.TextContent)));
        }

        [Fact]
        public async Task Should_draw_a_point_carrying_a_mark_in_its_shape_and_name_the_mark_and_note_beside_its_value()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var deposit = new ChartMark("Deposit");
            var fee = new ChartMark("Fee");
            ChartSeries value = new("Value",
            [
                new(DateTimeOffset.Parse("2024-01-01T00:00:00Z", CultureInfo.InvariantCulture), 100) { Mark = deposit, Note = "First deposit" },
                new(DateTimeOffset.Parse("2024-02-01T00:00:00Z", CultureInfo.InvariantCulture), 98) { Mark = fee },
                new(DateTimeOffset.Parse("2024-03-01T00:00:00Z", CultureInfo.InvariantCulture), 104),
            ]);

            var cut = ctx.Render(@<FormaLineChart Title="Value" Series="[value]" Range="ChartRange.Span" />);

            // Act
            cut.Find("input.forma-chart-scrubber").Input("0");

            // Assert — the single series named by the title alone, so the legend keys the marks
            var markers = cut.FindAll(".forma-chart-marker");
            var firstCell = cut.FindAll(".forma-chart-table tbody td")[0];
            Assert.Multiple(
                () => Assert.Equal(["Deposit", "Fee"], cut.FindAll(".forma-chart-legend-name").Select(name => name.TextContent)),
                () => Assert.True(markers[0].ClassList.Contains("forma-chart-mark-1") && markers[0].ClassList.Contains("is-standing")),
                () => Assert.True(markers[1].ClassList.Contains("forma-chart-mark-2")),
                () => Assert.False(markers[2].ClassList.Contains("is-marked")),
                () => Assert.Equal("Deposit: First deposit", firstCell.QuerySelector(".forma-chart-table-note")?.TextContent),
                () => Assert.StartsWith("100", firstCell.TextContent.Trim(), StringComparison.Ordinal),
                () => Assert.Equal("1/1/2024, Value 100 (Deposit: First deposit)", cut.Find("input.forma-chart-scrubber").GetAttribute("aria-valuetext")));
        }

        [Fact]
        public async Task Should_fill_a_series_down_to_the_baseline_and_fit_its_scale_to_its_values_where_zero_is_left_out()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var value = CreateSeries("Value", ("2024-01-01T00:00:00Z", 10_200), ("2024-06-01T00:00:00Z", 11_900)) with { IsFilled = true };

            // Act
            var cut = ctx.Render(@<FormaLineChart Title="Value" Series="[value]" Range="ChartRange.Span" IncludeZero="false" />);

            // Assert — steps of 500 from 10,000, the fill closing along the scale's bottom edge
            Assert.Multiple(
                () => Assert.Equal(["10,000", "10,500", "11,000", "11,500", "12,000"], cut.FindAll(".forma-chart-value-label").Select(label => label.TextContent.Trim())),
                () => Assert.EndsWith("1000,1000 0,1000", cut.Find("polygon.forma-chart-fill").GetAttribute("points"), StringComparison.Ordinal));
        }

        [Fact]
        public async Task Should_show_its_table_behind_a_toggle_where_asked_and_keep_it_open_for_assistive_technology_otherwise()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            var end = DateTimeOffset.Parse("2026-11-23T12:00:30Z", CultureInfo.InvariantCulture);

            // Act
            var hidden = ctx.Render(@<FormaLineChart Title="Load" Series='[CreateSeries("Load")]' Range="ChartRange.Hour" End="end" />);
            var shown = ctx.Render(@<FormaLineChart Title="Load" Series='[CreateSeries("Load")]' Range="ChartRange.Hour" End="end" ShowTable="true" />);

            // Assert
            Assert.Multiple(
                () => Assert.True(hidden.Find("details.forma-chart-table-view").HasAttribute("open")),
                () => Assert.Empty(hidden.FindAll("summary")),
                () => Assert.False(shown.Find("details.forma-chart-table-view").HasAttribute("open")),
                () => Assert.True(shown.Find("details.forma-chart-table-view").ClassList.Contains("is-shown")),
                () => Assert.Equal("Show as Table", shown.Find("summary").TextContent));
        }
    }

    public sealed class Validation
    {
        [Fact]
        public async Task Should_refuse_no_series_more_than_four_a_band_within_one_series_a_start_without_a_span_and_more_than_four_marks()
        {
            // Arrange
            using var ctx = await CreateContextAsync();
            ChartSeries[] five = [CreateSeries("A"), CreateSeries("B"), CreateSeries("C"), CreateSeries("D"), CreateSeries("E")];

            // Act & Assert
            Assert.Multiple(
                () => Assert.Throws<ArgumentOutOfRangeException>(() => ctx.Render(@<FormaLineChart Title="Load" Series="[]" />)),
                () => Assert.Throws<ArgumentOutOfRangeException>(() => ctx.Render(@<FormaLineChart Title="Load" Series="five" />)),
                () => Assert.Throws<ArgumentException>(() => ctx.Render(@<FormaLineChart Title="Load" Series='[CreateSeries("A"), CreateSeries("B")]' Band="new ChartBand(1, 1)" />)),
                () => Assert.Throws<ArgumentOutOfRangeException>(() => ctx.Render(@<FormaLineChart Title="Load" Series='[CreateSeries("A")]' Band="new ChartBand(0, 1)" />)),
                () => Assert.Throws<ArgumentException>(() => ctx.Render(@<FormaLineChart Title=" " Series='[CreateSeries("A")]' />)),
                () => Assert.Throws<ArgumentException>(() => ctx.Render(@<FormaLineChart Title="Load" Series='[CreateSeries("A")]' Range="ChartRange.Hour" Start="DateTimeOffset.UnixEpoch" />)),
                () => Assert.Throws<ArgumentException>(() => ctx.Render(@<FormaLineChart Title="Load" Series="[CreateMarkedSeries(5)]" Range="ChartRange.Span" />)));
        }
    }
}
