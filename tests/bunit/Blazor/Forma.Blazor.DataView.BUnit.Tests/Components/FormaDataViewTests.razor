            var engine = cut.FindComponent<FormaDataView<Entry>>();
            var gate = source.Gate = new TaskCompletionSource();

            // Act
            var first = engine.InvokeAsync(() => engine.Instance.LoadMoreAsync());
            var second = engine.InvokeAsync(() => engine.Instance.LoadMoreAsync());
            var busy = cut.Find(".forma-data-view-more button").GetAttribute("aria-busy");
            await cut.ReleaseAsync(gate.SetResult);
            await Task.WhenAll(first, second);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("true", busy),
                () => Assert.Equal([(0, 2), (2, 2)], source.Requests),
                () => Assert.Equal(["a", "b", "c", "d"], GetNames(cut)));
        }

        [Fact]
        public async Task Should_keep_the_items_and_offer_the_page_again_when_it_fails()
        {
