@inherits FormaBunitContext
@using System.Globalization
@using Forma.Framework.Browser.Interop.Scrolling
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Time.Testing

@code {
    public sealed class PageGivingWay
    {
        [Fact]
        public void Should_stay_on_a_page_whose_positions_the_source_read_and_left_out_whole()
        {
            // Arrange — six positions two to a page, the second page's two left out by the source
            using var ctx = new FormaDataViewTests();
            var moves = new List<int>();
            DataViewItemsProvider<Product> provider = request => ValueTask.FromResult(request.StartIndex == 2
                ? new DataViewPage<Product>([], null) { ReadCount = 2, PositionCount = 6 }
                : new DataViewPage<Product>([.. Enumerable.Range(request.StartIndex + 1, 2).Select(id => new Product(id, $"Product {id}"))], null) { PositionCount = 6 });

            // Act
            var cut = ctx.Render(
                @<FormaDataView TItem="Product" ItemsProvider="provider" PageSize="2" Page="2" PageChanged="@((int page) => moves.Add(page))" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindAll("[role=listitem]")),
                () => Assert.Empty(moves));
        }

        private sealed record Product(int Id, string Name);
    }

    public sealed class TabOrder
    {
        private static IQueryable<Product> CreateProducts() => Enumerable.Range(1, 3)
            .Select(id => new Product(id, $"Product {id}"))
            .AsQueryable();

        [Fact]
        public void Should_have_the_script_gather_every_item_s_controls_but_the_active_item_s()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            var selection = ctx.JSInterop.SetupModule("./_content/Forma.Blazor.DataView/scripts/SelectionInteraction.js");
            selection.SetupModule("attach", _ => true);

            // Act
            ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" EnableItemSelection="true" TabOrder="DataViewTabOrder.ActiveItem" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);

            // Assert
            var options = selection.Invocations.Single(invocation => invocation.Identifier == "attach").Arguments[1]!;
            Assert.Multiple(
                () => Assert.Equal(true, InteropPayload.GetValue(options, "gathersControls")),
                () => Assert.Equal("[data-item-root]", InteropPayload.GetValue(options, "itemRootSelector")),
                () => Assert.Equal("[data-item-actions]", InteropPayload.GetValue(options, "actionsSelector")));
        }

        [Fact]
        public void Should_attach_again_when_the_tab_order_changes()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            var selection = ctx.JSInterop.SetupModule("./_content/Forma.Blazor.DataView/scripts/SelectionInteraction.js");
            selection.SetupModule("attach", _ => true);
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" EnableItemSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);

            // Act
            cut.FindComponent<FormaDataView<Product>>().Render(parameters => parameters.Add(view => view.TabOrder, DataViewTabOrder.ActiveItem));

            // Assert — every item's controls in the Tab sequence, then the active item's alone
            var gathers = selection.Invocations.Where(invocation => invocation.Identifier == "attach")
                .Select(invocation => InteropPayload.GetValue(invocation.Arguments[1]!, "gathersControls"))
                .ToList();
            Assert.Equal([false, true], gathers);
        }

        private sealed record Product(int Id, string Name);
    }

    public sealed class ItemFocus
    {
        private static IQueryable<Product> CreateProducts() => Enumerable.Range(1, 3)
            .Select(id => new Product(id, $"Product {id}"))
            .AsQueryable();

        private static BunitJSModuleInterop SetUpSelection(FormaDataViewTests ctx)
        {
            var selection = ctx.JSInterop.SetupModule("./_content/Forma.Blazor.DataView/scripts/SelectionInteraction.js");
            selection.SetupModule("attach", _ => true);

            return selection;
        }

        [Fact]
        public void Should_make_each_card_item_and_row_its_own_marker_where_the_items_take_the_focus_with_no_selection()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            SetUpSelection(ctx);

            // Act — a list, cards and a grid, each its own data view taking the focus on its items
            var list = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" EnableItemFocus="true" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            var cards = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" EnableItemFocus="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" Dense="true" />
                </FormaDataView>);
            var grid = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" EnableItemFocus="true" ItemName="@(product => product.Name)">
                    <FormaDataGrid TItem="Product">
                        <Columns>
                            <FormaPropertyColumn Property="@(product => product.Name)" />
                        </Columns>
                    </FormaDataGrid>
                </FormaDataView>);

            // Assert — the item element carries the key the script moves by, and no box is drawn to carry it instead
            Assert.Multiple(
                () => Assert.All(list.FindAll(".forma-data-list-item"), item => Assert.Equal(item.GetAttribute("data-item"), item.GetAttribute("data-row-key"))),
                () => Assert.All(cards.FindAll(".forma-data-card"), card => Assert.Equal(card.GetAttribute("data-item"), card.GetAttribute("data-row-key"))),
                () => Assert.All(grid.FindAll("tbody tr.forma-data-grid-row"), row => Assert.Equal(row.GetAttribute("data-item"), row.GetAttribute("data-row-key"))),
                () => Assert.Empty(list.FindAll("input[type=checkbox]")),
                () => Assert.Empty(cards.FindAll("input[type=checkbox]")),
                () => Assert.Empty(grid.FindAll("input[type=checkbox]")));
        }

        [Fact]
        public void Should_have_the_script_move_the_focus_without_selecting_where_the_items_take_the_focus()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            var selection = SetUpSelection(ctx);

            // Act
            ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" EnableItemFocus="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);

            // Assert
            var options = selection.Invocations.Single(invocation => invocation.Identifier == "attach").Arguments[1]!;
            Assert.Multiple(
                () => Assert.Equal(true, InteropPayload.GetValue(options, "moves")),
                () => Assert.Equal(false, InteropPayload.GetValue(options, "selects")),
                () => Assert.Equal(false, InteropPayload.GetValue(options, "checksOnPress")));
        }

        [Fact]
        public void Should_hand_the_focus_to_the_boxes_once_checked_selection_turns_on_and_have_a_press_check_them()
        {
            // Arrange — the items taking the focus themselves, then a selection mode drawing boxes that a press checks
            using var ctx = new FormaDataViewTests();
            var selection = SetUpSelection(ctx);
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" EnableItemFocus="true" CheckedSelectionOptions="@(new CheckedSelectionOptions { ChecksOnPress = true })" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" Dense="true" />
                </FormaDataView>);

            // Act
            cut.FindComponent<FormaDataView<Product>>().Render(parameters => parameters.Add(view => view.EnableCheckedSelection, true));

            // Assert — the boxes carry the key now, the cards no longer, and the script, attached once to check the box an item draws on a
            // press, is told nothing as the boxes come
            var attach = Assert.Single(selection.Invocations, invocation => invocation.Identifier == "attach");
            Assert.Multiple(
                () => Assert.All(cut.FindAll(".forma-data-card"), card => Assert.Null(card.GetAttribute("data-row-key"))),
                () => Assert.Equal(3, cut.FindAll(".forma-data-card [data-row-key]").Count),
                () => Assert.Equal(true, InteropPayload.GetValue(attach.Arguments[1]!, "checksOnPress")),
                () => Assert.DoesNotContain(selection.Invocations, invocation => invocation.Identifier == "setChecksOnPress"));
        }

        [Fact]
        public void Should_tell_the_attached_script_once_the_host_has_a_press_check()
        {
            // Arrange — the boxes drawn, a press activating
            using var ctx = new FormaDataViewTests();
            var selection = SetUpSelection(ctx);
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" EnableCheckedSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);

            // Act
            cut.FindComponent<FormaDataView<Product>>().Render(parameters => parameters.Add(view => view.CheckedSelectionOptions, new CheckedSelectionOptions { ChecksOnPress = true }));

            // Assert
            Assert.Multiple(
                () => Assert.Single(selection.Invocations, invocation => invocation.Identifier == "attach"),
                () => Assert.Equal([true], selection.Invocations.Where(invocation => invocation.Identifier == "setChecksOnPress").Select(invocation => invocation.Arguments[0])));
        }

        [Fact]
        public void Should_leave_a_press_activating_under_checked_selection_unless_it_checks()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            var selection = SetUpSelection(ctx);

            // Act
            ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" EnableCheckedSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);

            // Assert
            var options = selection.Invocations.Single(invocation => invocation.Identifier == "attach").Arguments[1]!;
            Assert.Equal(false, InteropPayload.GetValue(options, "checksOnPress"));
        }

        private sealed record Product(int Id, string Name);
    }

    public sealed class Announcement
    {
        private static IQueryable<Product> CreateProducts(int count, int firstId = 1) => Enumerable.Range(firstId, count)
            .Select(id => new Product(id, $"Product {id}"))
            .AsQueryable();

        [Fact]
        public void Should_say_nothing_when_the_first_load_answers_at_once()
        {
            // Arrange — the clock stands still, so the wait before a slow load is announced never runs out on its own
            using var ctx = new FormaDataViewTests();
            ctx.Services.AddSingleton<TimeProvider>(new FakeTimeProvider());

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts(3)" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Assert
            Assert.Multiple(
                () => Assert.Equal("status", cut.Find(".forma-data-view-announcement").GetAttribute("role")),
                () => Assert.Empty(cut.Find(".forma-data-view-announcement").TextContent),
                () => Assert.Null(cut.Find(".forma-data-view-region").GetAttribute("aria-busy")));
        }

        [Fact]
        public void Should_draw_a_new_source_in_the_render_that_gives_it_while_the_last_load_waits_to_be_announced()
        {
            // Arrange — the clock stands still, so the wait the first load began before announcing itself is still running
            using var ctx = new FormaDataViewTests();
            ctx.Services.AddSingleton<TimeProvider>(new FakeTimeProvider());
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts(3)" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Act
            cut.FindComponent<FormaDataView<Product>>().Render(parameters => parameters.Add(view => view.Items, CreateProducts(2)));

            // Assert
            Assert.Equal(2, cut.FindAll("[role=listitem]").Count);
        }

        [Fact]
        public async Task Should_announce_the_count_when_a_new_source_changes_it()
        {
            // Arrange — the new source's answer is held, so the announcement is read once the load it settles has finished
            using var ctx = new FormaDataViewTests();
            var (cut, held) = RenderThenHoldNewSource(ctx);

            // Act
            await cut.ReleaseAsync(() => held.SetResult(new DataViewPage<Product>([.. CreateProducts(2)], 2)));

            // Assert
            Assert.Multiple(
                () => Assert.Equal(2, cut.FindAll("[role=listitem]").Count),
                () => Assert.Equal("2 items", cut.Find(".forma-data-view-announcement").TextContent));
        }

        [Fact]
        public async Task Should_say_nothing_when_a_new_source_keeps_the_count()
        {
            // Arrange — the new source's answer is held, so the silence is read once the load it settles has finished
            using var ctx = new FormaDataViewTests();
            var (cut, held) = RenderThenHoldNewSource(ctx);

            // Act — three other products, so the new source is seen to have answered
            await cut.ReleaseAsync(() => held.SetResult(new DataViewPage<Product>([.. CreateProducts(3, firstId: 4)], 3)));

            // Assert
            Assert.Multiple(
                () => Assert.Contains("Product 4", cut.Markup, StringComparison.Ordinal),
                () => Assert.Empty(cut.Find(".forma-data-view-announcement").TextContent));
        }

        // Draws three products from a source that answers at once, then gives the data view a new source whose answer the test holds,
        // which the data view asks in the render that gives it; the clock stands still, so the wait before a slow load is announced
        // never runs out on its own.
        private static (IRenderedComponent<IComponent> Cut, TaskCompletionSource<DataViewPage<Product>> Held) RenderThenHoldNewSource(FormaDataViewTests ctx)
        {
            ctx.Services.AddSingleton<TimeProvider>(new FakeTimeProvider());
            DataViewItemsProvider<Product> first = _ => ValueTask.FromResult(new DataViewPage<Product>([.. CreateProducts(3)], 3));
            var held = new TaskCompletionSource<DataViewPage<Product>>();
            DataViewItemsProvider<Product> second = _ => new ValueTask<DataViewPage<Product>>(held.Task);
            var cut = ctx.Render(
                @<FormaDataView ItemsProvider="first" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);
            cut.FindComponent<FormaDataView<Product>>().Render(parameters => parameters.Add(view => view.ItemsProvider, second));

            return (cut, held);
        }

        [Fact]
        public async Task Should_announce_a_slow_source_loading_and_then_its_count()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            var clock = new FakeTimeProvider();
            ctx.Services.AddSingleton<TimeProvider>(clock);
            var held = new TaskCompletionSource<DataViewPage<Product>>();
            DataViewItemsProvider<Product> provider = _ => new ValueTask<DataViewPage<Product>>(held.Task);
            var cut = ctx.Render(
                @<FormaDataView ItemsProvider="provider" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);

            // Act — the source is still answering after the moment the data view waits; the wait ends where the clock is moved,
            // and the data view acts on it once the renderer reaches the work the end queued
            await cut.ReleaseAsync(() => clock.Advance(TimeSpan.FromSeconds(1)));
            await cut.InvokeAsync(() => { });
            var announcedWhileLoading = cut.Find(".forma-data-view-announcement").TextContent;
            var busyWhileLoading = cut.Find(".forma-data-view-region").GetAttribute("aria-busy");
            await cut.ReleaseAsync(() => held.SetResult(new DataViewPage<Product>([.. CreateProducts(1)], 1)));

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Loading", announcedWhileLoading),
                () => Assert.Equal("true", busyWhileLoading),
                () => Assert.Equal("1 item", cut.Find(".forma-data-view-announcement").TextContent),
                () => Assert.Null(cut.Find(".forma-data-view-region").GetAttribute("aria-busy")));
        }

        private sealed record Product(int Id, string Name);
    }

    public sealed class Seeking
    {
        private static IQueryable<Product> CreateProducts() => new[]
        {
            new Product(1, "Hammer", "Tools"),
            new Product(2, "Atlas", "Books"),
            new Product(3, "Wrench", "Tools"),
            new Product(4, "Primer", "Books"),
        }.AsQueryable();

        private static (int Request, int Position)? LastFocus(BunitContext ctx)
            => ctx.JSInterop.Invocations.LastOrDefault(invocation => invocation.Identifier == "focusItem") is { Arguments: [int request, int position] } ? (request, position) : null;

        private static int CancelCount(BunitContext ctx)
            => ctx.JSInterop.Invocations.Count(invocation => invocation.Identifier == "cancelSeek");

        [Fact]
        public async Task Should_select_the_last_item_and_land_the_focus_on_it()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            IReadOnlyList<Product> selected = [];
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" EnableItemSelection="true" ItemName="@(product => product.Name)" SelectedItemsChanged="@((IReadOnlyList<Product> items) => selected = items)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
            var engine = cut.FindComponent<FormaDataView<Product>>();

            // Act
            await engine.InvokeAsync(() => engine.Instance.HandleSeekAsync(7, last: true, "select", null));

            // Assert
            Assert.Multiple(
                () => Assert.Equal("Primer", Assert.Single(selected).Name),
                () => Assert.Equal((7, 3), LastFocus(ctx)));
        }

        [Fact]
        public async Task Should_move_the_focus_alone_without_touching_the_selection()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            var changes = 0;
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" EnableItemSelection="true" ItemName="@(product => product.Name)" SelectedItemsChanged="@((IReadOnlyList<Product> _) => changes++)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
            var engine = cut.FindComponent<FormaDataView<Product>>();

            // Act
            await engine.InvokeAsync(() => engine.Instance.HandleSeekAsync(1, last: false, "focus", null));

            // Assert
            Assert.Multiple(
                () => Assert.Equal(0, changes),
                () => Assert.Equal((1, 0), LastFocus(ctx)));
        }

        [Fact]
        public async Task Should_extend_the_range_from_the_anchor_to_the_last_item()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            IReadOnlyList<Product> selected = [];
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" EnableItemSelection="true" ItemName="@(product => product.Name)" SelectedItemsChanged="@((IReadOnlyList<Product> items) => selected = items)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
            var engine = cut.FindComponent<FormaDataView<Product>>();

            // Act
            await engine.InvokeAsync(() => engine.Instance.HandleSeekAsync(1, last: true, "extend", 1));

            // Assert
            Assert.Equal(["Atlas", "Primer", "Wrench"], selected.Select(product => product.Name).Order());
        }

        [Fact]
        public async Task Should_reach_the_first_item_of_the_first_open_group_and_leave_a_folded_group_out_of_a_range()
        {
            // Arrange — Books is folded, so the reachable items are Tools' alone
            using var ctx = new FormaDataViewTests();
            IReadOnlyList<Product> selected = [];
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" EnableItemSelection="true" ItemName="@(product => product.Name)" GroupBy="@(DataViewGrouping<Product>.By(product => product.Category))" SelectedItemsChanged="@((IReadOnlyList<Product> items) => selected = items)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem] .forma-data-list-item-name").Count == 4);
            cut.Find(".forma-data-group-heading").Click();
            cut.WaitForState(() => cut.FindAll(".forma-data-list-item").Count == 2);
            var engine = cut.FindComponent<FormaDataView<Product>>();

            // Act
            await engine.InvokeAsync(() => engine.Instance.HandleSeekAsync(1, last: false, "select", null));
            var first = selected;
            await engine.InvokeAsync(() => engine.Instance.HandleRangeSelectByPositionAsync(0, 3, additive: false));

            // Assert — the positions run through the set, Books' two first
            Assert.Multiple(
                () => Assert.Equal("Hammer", Assert.Single(first).Name),
                () => Assert.Equal((1, 2), LastFocus(ctx)),
                () => Assert.Equal(["Hammer", "Wrench"], selected.Select(product => product.Name).Order()));
        }

        [Fact]
        public async Task Should_let_go_of_a_move_the_order_changed_under()
        {
            // Arrange — the read the move needs is held until the order has changed
            using var ctx = new FormaDataViewTests();
            var held = new TaskCompletionSource<DataViewPage<Product>>();
            var holding = false;
            var changes = 0;
            DataViewItemsProvider<Product> provider = request => holding && request.Count == 1
                ? new ValueTask<DataViewPage<Product>>(held.Task)
                : ValueTask.FromResult(new DataViewPage<Product>([.. request.ApplySorting(CreateProducts()).Skip(request.StartIndex).Take(request.Count ?? 4)], 4));
            var cut = ctx.Render(
                @<FormaDataView ItemsProvider="provider" EnablePagination="false" Virtualize="true" EnableItemSelection="true" ItemName="@(product => product.Name)" SelectedItemsChanged="@((IReadOnlyList<Product> _) => changes++)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
            var engine = cut.FindComponent<FormaDataView<Product>>();
            var cancels = CancelCount(ctx);

            // Act
            holding = true;
            var move = engine.InvokeAsync(() => engine.Instance.HandleSeekAsync(1, last: true, "select", null));
            await engine.InvokeAsync(() => engine.Instance.RefreshDataAsync());
            held.SetResult(new DataViewPage<Product>([CreateProducts().Last()], 4));
            await move;

            // Assert — the behavior is told to let the move go
            Assert.Multiple(
                () => Assert.Equal(0, changes),
                () => Assert.Null(LastFocus(ctx)),
                () => Assert.Equal(cancels + 1, CancelCount(ctx)));
        }

        [Fact]
        public async Task Should_let_go_of_a_move_whose_read_failed()
        {
            // Arrange — the read the move needs throws
            using var ctx = new FormaDataViewTests();
            var failing = false;
            DataViewItemsProvider<Product> provider = request => failing && request.Count == 1
                ? throw new InvalidOperationException("The store is gone.")
                : ValueTask.FromResult(new DataViewPage<Product>([.. CreateProducts().Skip(request.StartIndex).Take(request.Count ?? 4)], 4));
            var cut = ctx.Render(
                @<FormaDataView ItemsProvider="provider" EnablePagination="false" Virtualize="true" EnableItemSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
            var engine = cut.FindComponent<FormaDataView<Product>>();
            var cancels = CancelCount(ctx);

            // Act
            failing = true;
            await Assert.ThrowsAsync<InvalidOperationException>(() => engine.InvokeAsync(() => engine.Instance.HandleSeekAsync(1, last: true, "select", null)));

            // Assert
            Assert.Equal(cancels + 1, CancelCount(ctx));
        }

        [Fact]
        public async Task Should_leave_the_selection_alone_for_an_extend_with_no_anchor()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            var changes = 0;
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" EnableItemSelection="true" ItemName="@(product => product.Name)" SelectedItemsChanged="@((IReadOnlyList<Product> _) => changes++)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
            var engine = cut.FindComponent<FormaDataView<Product>>();

            // Act
            await engine.InvokeAsync(() => engine.Instance.HandleSeekAsync(1, last: true, "extend", null));

            // Assert — the focus still lands on the last item
            Assert.Multiple(
                () => Assert.Equal(0, changes),
                () => Assert.Equal((1, 3), LastFocus(ctx)));
        }

        [Fact]
        public async Task Should_reach_the_last_item_a_source_that_cannot_count_answered()
        {
            // Arrange — the slice comes back shorter than asked for, which ends the set
            using var ctx = new FormaDataViewTests();
            DataViewItemsProvider<Product> provider = request => ValueTask.FromResult(new DataViewPage<Product>([.. CreateProducts().Skip(request.StartIndex).Take(request.Count ?? 4)], null));
            var cut = ctx.Render(
                @<FormaDataView ItemsProvider="provider" EnablePagination="false" Virtualize="true" EnableItemSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
            var engine = cut.FindComponent<FormaDataView<Product>>();

            // Act
            await engine.InvokeAsync(() => engine.Instance.HandleSeekAsync(1, last: true, "focus", null));

            // Assert
            Assert.Equal((1, 3), LastFocus(ctx));
