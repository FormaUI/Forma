    public sealed class Appending
    {
        // A source over positions, some of which it leaves out, recording each slice asked for and holding or failing those it is told to.
        private sealed class Source(params (string Name, bool IsShown)[] positions)
        {
            public List<(int Start, int? Count)> Requests { get; } = [];

            public TaskCompletionSource? Gate { get; set; }

            public bool Fails { get; set; }

            public bool CountsShown { get; set; } = true;

            public bool? HasMore { get; set; }

            public async ValueTask<DataViewPage<Entry>> ProvideAsync(DataViewRequest<Entry> request)
            {
                Requests.Add((request.StartIndex, request.Count));

                if (Gate is { } gate)
                {
                    await gate.Task.WaitAsync(request.CancellationToken);
                }

                if (Fails)
                {
                    throw new InvalidOperationException("The store is unavailable.");
                }

                var read = positions.Skip(request.StartIndex).Take(request.Count ?? positions.Length).ToList();

                return new DataViewPage<Entry>([.. read.Where(position => position.IsShown).Select(position => new Entry(position.Name))], CountsShown ? positions.Count(position => position.IsShown) : null)
                {
                    ReadCount = HasMore is null ? read.Count : 0,
                    HasMore = HasMore,
                };
            }
        }

        private static (string, bool)[] Shown(params string[] names)
            => [.. names.Select(name => (name, true))];

        private IRenderedComponent<IComponent> Render(FormaDataViewTests ctx, Source source)
            => ctx.Render(
                @<FormaDataView TItem="Entry" ItemsProvider="source.ProvideAsync" PageSize="2" AppendMode="DataViewAppendMode.Manual" ItemKey="@(entry => entry.Name)" ItemName="@(entry => entry.Name)">
                    <FormaDataList TItem="Entry" />
                </FormaDataView>);

        private static List<string> GetNames(IRenderedComponent<IComponent> cut)
            => [.. cut.FindAll(".forma-data-list-item-name").Select(name => name.TextContent)];

