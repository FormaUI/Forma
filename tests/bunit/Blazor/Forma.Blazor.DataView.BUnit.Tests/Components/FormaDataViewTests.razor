        [Fact]
        public async Task Should_ask_the_watch_to_measure_the_end_again_when_the_items_change_under_it()
        {
            // Arrange — the first page shown, its end out of view as the watch attaches
            using var ctx = new FormaDataViewTests();
            var probe = new DomProbe<IntersectionState>(ctx);
            var positions = Shown("a", "b", "c", "d", "e");
            var source = new Source(positions);
            var cut = RenderAutomatic(ctx, source);
            var engine = cut.FindComponent<FormaDataView<Entry>>();
            cut.WaitForState(() => engine.Instance.ItemCount == 2);
            await probe.ReportAsync(new IntersectionState(IsIntersecting: false));

            // Act — b leaves the source, and the items shown are read again, the watch left as it was
            positions[1] = ("b", false);
            await engine.InvokeAsync(() => engine.Instance.RefreshDataAsync());

            // Assert — the end the fewer items can leave in view measured again
            Assert.Multiple(
                () => Assert.Equal(1, engine.Instance.ItemCount),
                () => Assert.Single(probe.Observations),
                () => Assert.Single(probe.Watcher.Invocations, invocation => invocation.Identifier == "refresh"));
        }

        [Fact]
        public async Task Should_leave_the_end_to_the_watch_attached_again_after_a_page_that_took_a_while()
        {
            // Arrange — a source holding the second page back, so the watch is off while it comes
            using var ctx = new FormaDataViewTests();
            var probe = new DomProbe<IntersectionState>(ctx);
            var source = new Source(Shown("a", "b", "c", "d", "e"));
            var cut = RenderAutomatic(ctx, source);
            var engine = cut.FindComponent<FormaDataView<Entry>>();
            cut.WaitForState(() => engine.Instance.ItemCount == 2);
            var gate = source.Gate = new TaskCompletionSource();

            // Act — the end in view, the page let through, and the end, measured as the watch attaches again, out of view
            await probe.ReportAsync(new IntersectionState(IsIntersecting: true));
            await cut.ReleaseAsync(gate.SetResult);
            await probe.ReportAsync(new IntersectionState(IsIntersecting: false));

            // Assert — the watch attached again is asked for nothing more, so no page is read ahead
            Assert.Multiple(
                () => Assert.Equal(4, engine.Instance.ItemCount),
                () => Assert.Equal(2, probe.Observations.Count),
                () => Assert.DoesNotContain(probe.Watcher.Invocations, invocation => invocation.Identifier == "refresh"),
                () => Assert.Equal([(0, 2), (2, 2)], source.Requests));
        }

        private static IRenderedComponent<IComponent> RenderAutomatic(FormaDataViewTests ctx, Source source)
            => ctx.Render(
                @<FormaDataView TItem="Entry" ItemsProvider="source.ProvideAsync" PageSize="2" AppendMode="DataViewAppendMode.Automatic" ItemKey="@(entry => entry.Name)" ItemName="@(entry => entry.Name)">
                    <FormaDataList TItem="Entry" />
                </FormaDataView>);

        private sealed record Entry(string Name);
    }

    public sealed class Source
    {
        private static List<Product> CreateProducts(int count)
            => [.. Enumerable.Range(1, count).Select(id => new Product(id, $"Product {id}"))];

        private static IReadOnlyList<string> GetNames(IRenderedComponent<IComponent> cut)
            => [.. cut.FindAll(".forma-data-list-item-name").Select(name => name.TextContent)];

        [Fact]
        public void Should_leave_a_held_query_unasked_when_the_data_view_renders_with_nothing_changed()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            var executor = new CountingQueryExecutor();
            ctx.Services.AddSingleton<IDataViewQueryExecutor>(executor);
            var query = CreateProducts(3).AsQueryable();
            var cut = ctx.Render(
                @<FormaDataView Items="query" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);
            var engine = cut.FindComponent<FormaDataView<Product>>();
            var reads = executor.Reads;

            // Act
            engine.Render();
            engine.Render(parameters => parameters.Add(view => view.Items, query));

            // Assert
            Assert.Equal(reads, executor.Reads);
        }

        [Fact]
        public void Should_ask_a_query_built_again_over_a_changed_captured_value()
        {
            // Arrange
            using var ctx = new FormaDataViewTests();
            var executor = new CountingQueryExecutor();
            ctx.Services.AddSingleton<IDataViewQueryExecutor>(executor);
            var products = CreateProducts(4);
            var minimum = 1;
            var cut = ctx.Render(
                @<FormaDataView Items="products.AsQueryable().Where(product => product.Id >= minimum)" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
            var engine = cut.FindComponent<FormaDataView<Product>>();
            var reads = executor.Reads;

            // Act
            minimum = 3;
            engine.Render(parameters => parameters.Add(view => view.Items, products.AsQueryable().Where(product => product.Id >= minimum)));

            // Assert
            Assert.Multiple(
                () => Assert.Equal(reads + 1, executor.Reads),
                () => Assert.Equal(["Product 3", "Product 4"], GetNames(cut)));
        }

        [Theory]
        [InlineData(false)]
        [InlineData(true)]
        public async Task Should_show_what_changed_under_a_held_query_once_refreshed(bool virtualize)
        {
            // Arrange — the queryable reads the list as it is each time it is asked
            using var ctx = new FormaDataViewTests();
            var products = CreateProducts(3);
            var query = products.AsQueryable();
            var cut = ctx.Render(
                @<FormaDataView Items="query" EnablePagination="false" Virtualize="virtualize" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);
            var engine = cut.FindComponent<FormaDataView<Product>>();

            // Act
            products.RemoveAt(0);
            products.Add(new Product(4, "Product 4"));
            await engine.InvokeAsync(() => engine.Instance.RefreshDataAsync());

            // Assert
            Assert.Equal(["Product 2", "Product 3", "Product 4"], GetNames(cut));
        }

        // Counts and reads in memory, counting each read it makes.
        private sealed class CountingQueryExecutor : IDataViewQueryExecutor
        {
            public int Reads { get; private set; }

            public bool Supports<TItem>(IQueryable<TItem> query)
                => true;

            public ValueTask<int> CountAsync<TItem>(IQueryable<TItem> query, CancellationToken cancellationToken)
                => InMemoryQueryExecutor.Instance.CountAsync(query, cancellationToken);

            public ValueTask<TItem[]> ToArrayAsync<TItem>(IQueryable<TItem> query, CancellationToken cancellationToken)
            {
                Reads++;

                return InMemoryQueryExecutor.Instance.ToArrayAsync(query, cancellationToken);
            }
        }

        private sealed record Product(int Id, string Name);
    }
