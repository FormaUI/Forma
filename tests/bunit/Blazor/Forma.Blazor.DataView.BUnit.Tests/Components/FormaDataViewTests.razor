            // Assert
            Assert.Multiple(
                () => Assert.Equal(["a", "b"], afterFailure),
                () => Assert.Equal("Try Again", offered),
                () => Assert.Equal(1, alert),
                () => Assert.Equal(["a", "b", "c", "d"], GetNames(cut)),
                () => Assert.Empty(cut.FindAll(".forma-data-view-more [role=alert]")));
        }

        [Fact]
        public async Task Should_add_nothing_from_a_page_a_new_run_replaced_while_it_was_on_its_way()
        {
            // Arrange — the next page of the old source held
            using var ctx = new FormaDataViewTests();
            var source = new Source(Shown("a", "b", "c", "d"));
            var cut = Render(ctx, source);
            cut.WaitForState(() => GetNames(cut).Count == 2);
            var engine = cut.FindComponent<FormaDataView<Entry>>();
            var gate = source.Gate = new TaskCompletionSource();
            var pending = engine.InvokeAsync(() => engine.Instance.LoadMoreAsync());

            // Act — a new source starts a run, and the old page then answers
            var replacement = new Source(Shown("x", "y", "z"));
            engine.Render(parameters => parameters.Add(view => view.ItemsProvider, replacement.ProvideAsync));
            cut.WaitForState(() => GetNames(cut).SequenceEqual(["x", "y"]));
            await cut.ReleaseAsync(gate.SetResult);
            await pending;

            // Assert
            Assert.Equal(["x", "y"], GetNames(cut));
        }

