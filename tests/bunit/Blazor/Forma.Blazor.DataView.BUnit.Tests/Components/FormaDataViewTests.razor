            source.Fails = true;

            // Act — a failed page, then the page offered again
            await cut.Find(".forma-data-view-more button").ClickAsync(new MouseEventArgs());
            var (afterFailure, offered, alert) = (GetNames(cut), cut.Find(".forma-data-view-more .forma-button-label").TextContent.Trim(), cut.FindAll(".forma-data-view-more [role=alert]").Count);
            source.Fails = false;
