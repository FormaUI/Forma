            DataViewItemsProvider<Product> provider = request =>
            {
                requests.Add((request.StartIndex, request.Count));

                return ValueTask.FromResult(new DataViewPage<Product>([.. CreateProducts().Skip(request.StartIndex).Take(request.Count ?? 3)], 3));
