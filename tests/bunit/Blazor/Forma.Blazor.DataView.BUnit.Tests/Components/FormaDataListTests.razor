        [Fact]
        public async Task Should_keep_a_focused_box_and_the_items_either_side_drawn_once_it_scrolls_away()
        {
            // Arrange
            using var ctx = new FormaDataListTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(50)" EnablePagination="false" Virtualize="true" EnableCheckedSelection="true" ItemHeight="40" OverscanCount="2" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem] input").Count > 0);
            await ReportViewportAsync(cut, 0, 200, 40);

            // Act — Product 3's box takes the focus, and the list scrolls thirty items past it
            cut.FindAll("[role=listitem]").Single(item => item.QuerySelector(".forma-data-list-item-name")!.TextContent == "Product 3").QuerySelector("input")!.FocusIn();
            await ReportViewportAsync(cut, 1200, 200, 40);

            // Assert — the focused item and the items either side of it stay drawn, each saying where it stands
            var drawn = cut.FindAll("[role=listitem]").Take(3).ToList();
            Assert.Multiple(
                () => Assert.Equal(["Product 2", "Product 3", "Product 4"], drawn.Select(item => item.QuerySelector(".forma-data-list-item-name")!.TextContent)),
                () => Assert.Equal(["2", "3", "4"], drawn.Select(item => item.GetAttribute("aria-posinset"))));
        }

