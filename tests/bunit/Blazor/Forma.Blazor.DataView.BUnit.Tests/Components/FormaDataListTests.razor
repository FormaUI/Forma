        {
            // Arrange
            using var ctx = new FormaDataListTests();
            var drawn = new Dictionary<int, int>();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(4)" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product">
                        <ThumbnailTemplate Context="product">@Draw(drawn, product)</ThumbnailTemplate>
                    </FormaDataList>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
