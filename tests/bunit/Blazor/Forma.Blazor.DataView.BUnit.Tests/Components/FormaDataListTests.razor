        [Fact]
        public async Task Should_draw_nothing_again_when_a_box_takes_the_focus_without_changing_the_items_kept()
        {
            // Arrange — Product 3's box already holds the focus
            using var ctx = new FormaDataListTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(50)" EnablePagination="false" Virtualize="true" EnableCheckedSelection="true" ItemHeight="40" OverscanCount="2" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem] input").Count > 0);
            await ReportViewportAsync(cut, 0, 200, 40);
            var list = cut.FindComponent<FormaDataList<Product>>();
            Box(cut, "Product 3").FocusIn();
            var renders = list.RenderCount;

            // Act — it takes the focus again, as it does when the window is returned to
            Box(cut, "Product 3").FocusIn();

            // Assert
            Assert.Equal(renders, list.RenderCount);

            static IElement Box(IRenderedComponent<IComponent> cut, string name)
                => cut.FindAll("[role=listitem]").Single(item => item.QuerySelector(".forma-data-list-item-name")!.TextContent == name).QuerySelector("input")!;
        }

        [Fact]
        public async Task Should_hand_a_failure_while_taking_the_focus_to_the_error_boundary_around_it()
        {
            // Arrange — the item key fails once the list is drawn, which taking the focus reads
            using var ctx = new FormaDataListTests();
            var fails = false;
            var cut = ctx.Render(
                @<ErrorBoundary>
                    <ChildContent>
                        <FormaDataView Items="CreateMany(50)" EnablePagination="false" Virtualize="true" EnableCheckedSelection="true" ItemHeight="40" OverscanCount="2" ItemName="@(product => product.Name)" ItemKey="@(product => fails ? throw new InvalidOperationException("Key") : product.Id)">
                            <FormaDataList TItem="Product" />
                        </FormaDataView>
                    </ChildContent>
                    <ErrorContent><p class="failed">Failed</p></ErrorContent>
                </ErrorBoundary>);
            cut.WaitForState(() => cut.FindAll("[role=listitem] input").Count > 0);
            await ReportViewportAsync(cut, 0, 200, 40);

            // Act
            fails = true;
            cut.FindAll("[role=listitem] input")[2].FocusIn();

            // Assert
            cut.WaitForState(() => cut.FindAll(".failed").Count == 1);
        }

        // A thumbnail that says each time an item draws it, so what a change draws again can be read.
        private static int Draw(Dictionary<int, int> drawn, Product product)
        {
            drawn[product.Id] = drawn.GetValueOrDefault(product.Id) + 1;

            return product.Id;
        }

        private static IReadOnlyList<int> DrawnSince(Dictionary<int, int> drawn, Dictionary<int, int> before)
            => [.. drawn.Where(entry => entry.Value != before.GetValueOrDefault(entry.Key)).Select(entry => entry.Key).Order()];

        private static IReadOnlyList<int> GetTokens(IRenderedComponent<IComponent> cut)
            => [.. cut.FindAll("[role=listitem]").Select(row => int.Parse(row.GetAttribute("data-item")!, CultureInfo.InvariantCulture))];

        [Fact]
        public async Task Should_draw_again_only_the_item_whose_box_was_pressed()
        {
