            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(6)" EnablePagination="false" EnableCheckedSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product">
                        <ThumbnailTemplate Context="product">@Draw(drawn, product)</ThumbnailTemplate>
                    </FormaDataList>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("input[type=checkbox]").Count == 6);
            var before = new Dictionary<int, int>(drawn);

            // Act
            await cut.FindAll("input[type=checkbox]")[2].ClickAsync(new MouseEventArgs());

            // Assert
            Assert.Equal([3], DrawnSince(drawn, before));
        }

        [Fact]
        public async Task Should_draw_again_the_item_a_selection_leaves_and_the_item_it_reaches()
        {
            // Arrange
            using var ctx = new FormaDataListTests();
            var drawn = new Dictionary<int, int>();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(6)" EnablePagination="false" EnableItemSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataList TItem="Product">
                        <ThumbnailTemplate Context="product">@Draw(drawn, product)</ThumbnailTemplate>
                    </FormaDataList>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 6);
            var engine = cut.FindComponent<FormaDataView<Product>>();
            var tokens = GetTokens(cut);
            await cut.InvokeAsync(() => engine.Instance.HandleSelectAsync(tokens[1], isAdditive: false));
            var before = new Dictionary<int, int>(drawn);

            // Act
            await cut.InvokeAsync(() => engine.Instance.HandleSelectAsync(tokens[4], isAdditive: false));

            // Assert
            Assert.Equal([2, 5], DrawnSince(drawn, before));
        }

