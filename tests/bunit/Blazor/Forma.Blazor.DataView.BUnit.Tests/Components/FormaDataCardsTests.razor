@inherits FormaBunitContext
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using AngleSharp.Dom
@using Forma.Blazor.Components.Virtualization

@code {
    public sealed class Component
    {
        private static IQueryable<Product> CreateProducts() => new[]
        {
            new Product(1, "Hammer", "Tools"),
            new Product(2, "Atlas", "Books"),
            new Product(3, "Wrench", "Tools"),
        }.AsQueryable();

        [Fact]
        public void Should_draw_each_card_and_its_parts_under_the_cards_style_scope()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Assert
            Assert.All(cut.FindAll("[role=listitem], .forma-data-card-thumbnail, .forma-data-card-name"), part => Assert.True(part.HasAttribute("b-forma-data-cards"), part.ClassName));
        }

        [Fact]
        public void Should_mark_each_card_as_the_element_its_controls_belong_to()
        {
            // Arrange
