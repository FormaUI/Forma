        [Fact]
        public async Task Should_keep_the_row_of_a_focused_card_and_the_rows_either_side_drawn_as_the_focus_moves_scrolled_away()
        {
            // Arrange — rows of three cards, a hundred pixels tall
            using var ctx = new FormaDataCardsTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(60)" EnablePagination="false" Virtualize="true" EnableCheckedSelection="true" ItemHeight="100" OverscanCount="2" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);
            var cards = cut.FindComponent<FormaDataCards<Product>>();
            await cards.InvokeAsync(() => cards.Instance.HandleGridColumnsAsync(3));
            cut.WaitForState(() => cut.FindAll(".forma-data-card").Count > 0);
            await ReportViewportAsync(cut, 0, 300, 100);

            // Act — the middle card of the second row takes the focus, and the cards scroll twenty rows past it
            Box(cut, 4).FocusIn();
            await ReportViewportAsync(cut, 2000, 300, 100);

            // Assert — its row and the rows either side of it stay drawn
            Assert.Equal([0, 1, 2, 3, 4, 5, 6, 7, 8], Positions(cut).Take(9));

            // Act — the focus moves along the row, and then onto the row below it, both kept
            Box(cut, 5).FocusIn();
            var along = Positions(cut).Take(9).ToList();
            Box(cut, 8).FocusIn();

            // Assert — moving along keeps every row; moving down keeps the row it left and the row it reached
            Assert.Multiple(
                () => Assert.Equal([0, 1, 2, 3, 4, 5, 6, 7, 8], along),
                () => Assert.Equal([3, 4, 5, 6, 7, 8], Positions(cut).Take(6)));

            static IElement Box(IRenderedComponent<IComponent> cut, int position)
                => cut.Find($"[data-item-position='{position}'] input");

            static IEnumerable<int> Positions(IRenderedComponent<IComponent> cut)
                => cut.FindAll("[data-item-position]").Select(card => int.Parse(card.GetAttribute("data-item-position")!, CultureInfo.InvariantCulture));
        }

        // A thumbnail that says each time a card draws it, so what a change draws again can be read.
        private static int Draw(Dictionary<int, int> drawn, Product product)
        {
            drawn[product.Id] = drawn.GetValueOrDefault(product.Id) + 1;

            return product.Id;
        }

        private static IReadOnlyList<int> DrawnSince(Dictionary<int, int> drawn, Dictionary<int, int> before)
            => [.. drawn.Where(entry => entry.Value != before.GetValueOrDefault(entry.Key)).Select(entry => entry.Key).Order()];

        private static IReadOnlyList<int> GetTokens(IRenderedComponent<IComponent> cut)
            => [.. cut.FindAll("[role=listitem]").Select(row => int.Parse(row.GetAttribute("data-item")!, CultureInfo.InvariantCulture))];

        [Fact]
        public async Task Should_draw_again_only_the_card_whose_box_was_pressed()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();
            var drawn = new Dictionary<int, int>();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(6)" EnablePagination="false" EnableCheckedSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product">
                        <ThumbnailTemplate Context="product">@Draw(drawn, product)</ThumbnailTemplate>
                    </FormaDataCards>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("input[type=checkbox]").Count == 6);
            var before = new Dictionary<int, int>(drawn);

            // Act
            await cut.FindAll("input[type=checkbox]")[2].ClickAsync(new MouseEventArgs());

            // Assert
            Assert.Equal([3], DrawnSince(drawn, before));
        }

        [Fact]
        public async Task Should_draw_again_the_card_a_selection_leaves_and_the_card_it_reaches()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();
            var drawn = new Dictionary<int, int>();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(6)" EnablePagination="false" EnableItemSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product">
                        <ThumbnailTemplate Context="product">@Draw(drawn, product)</ThumbnailTemplate>
                    </FormaDataCards>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 6);
            var engine = cut.FindComponent<FormaDataView<Product>>();
            var tokens = GetTokens(cut);
            await cut.InvokeAsync(() => engine.Instance.HandleSelectAsync(tokens[1], additive: false));
            var before = new Dictionary<int, int>(drawn);

            // Act
            await cut.InvokeAsync(() => engine.Instance.HandleSelectAsync(tokens[4], additive: false));

            // Assert
            Assert.Equal([2, 5], DrawnSince(drawn, before));
        }

