        [Fact]
        public async Task Should_draw_virtualized_rows_of_the_columns_the_width_holds()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" Virtualize="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);

            // Act
            var cards = cut.FindComponent<FormaDataCards<Product>>();
            await cards.InvokeAsync(() => cards.Instance.HandleGridColumnsAsync(2));
            cut.WaitForState(() => cut.FindAll(".forma-data-card").Count == 3);

            // Assert
            Assert.Multiple(
                () => Assert.Equal([2, 1], cut.FindAll(".forma-data-cards-row").Select(row => row.QuerySelectorAll(".forma-data-card").Length)),
                () => Assert.Equal(["1", "2", "3"], cut.FindAll(".forma-data-card").Select(card => card.GetAttribute("aria-posinset"))),
                () => Assert.All(cut.FindAll(".forma-data-card"), card => Assert.Equal("3", card.GetAttribute("aria-setsize"))));
        }

        [Fact]
        public async Task Should_measure_the_columns_again_when_the_cards_show_again()
        {
            // Arrange — the cards beside the list, so the view switch takes them off the page and back
            using var ctx = new FormaDataCardsTests();
            var cut = ctx.Render(
                @<FormaDataView TItem="Product" Items="CreateProducts()" EnablePagination="false" Virtualize="true" View="cards" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                    <FormaDataList TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);
            var engine = cut.FindComponent<FormaDataView<Product>>();

            // Act
            await engine.InvokeAsync(() => engine.Instance.SwitchViewAsync("list"));
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 0);
            await engine.InvokeAsync(() => engine.Instance.SwitchViewAsync("cards"));
            cut.WaitForState(() => cut.FindAll(".forma-data-cards-ruler").Count == 1);

            // Assert — the new ruler is watched from when it shows, the one taken away no longer
            var rulerAttaches = ctx.JSInterop.Invocations.Count(invocation => invocation.Identifier == "attach"
                && invocation.Arguments is [ElementReference, { } options]
                && InteropPayload.GetNames(options) is ["owner"]);
            Assert.Equal(2, rulerAttaches);
        }

