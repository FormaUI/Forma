            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Assert
            Assert.All(cut.FindAll("[role=listitem]"), card => Assert.True(card.HasAttribute("data-item-root")));
        }

        [Fact]
        public void Should_draw_a_card_per_item_with_its_thumbnail_its_name_its_detail_and_its_actions()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();

            // Act
            var cut = ctx.Render(
                @<FormaDataView Items="CreateProducts()" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" CardSize="@CssLength.FromRem(12)">
                        <ThumbnailTemplate Context="product"><span class="thumb">@product.Id</span></ThumbnailTemplate>
                        <ItemTemplate Context="product"><span class="detail">@product.Category</span></ItemTemplate>
                        <ActionsTemplate Context="product"><button class="act">Open @product.Name</button></ActionsTemplate>
                    </FormaDataCards>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 3);

            // Assert
            var cards = cut.FindAll("[role=listitem]");
            Assert.Multiple(
                () => Assert.Equal("list", cut.Find(".forma-data-cards-pack").GetAttribute("role")),
                () => Assert.Contains("--forma-data-cards-size: 12rem", cut.Find(".forma-data-cards").GetAttribute("style"), StringComparison.Ordinal),
                () => Assert.Equal("Hammer", cards[0].QuerySelector(".forma-data-card-name")!.TextContent),
                () => Assert.Equal("1", cards[0].QuerySelector(".forma-data-card-thumbnail .thumb")!.TextContent),
                () => Assert.Equal("Tools", cards[0].QuerySelector(".forma-data-card-detail .detail")!.TextContent),
                () => Assert.Equal("Open Hammer", cards[0].QuerySelector(".forma-data-card-actions .act")!.TextContent),
                () => Assert.True(cards[0].HasAttribute("data-item")));
        }

