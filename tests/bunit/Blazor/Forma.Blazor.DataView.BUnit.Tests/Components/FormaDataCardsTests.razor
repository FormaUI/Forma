        [Fact]
        public void Should_draw_every_card_again_when_the_cards_are_given_another_thumbnail()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();
            var drawn = new Dictionary<int, int>();
            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(4)" EnablePagination="false" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product">
                        <ThumbnailTemplate Context="product">@Draw(drawn, product)</ThumbnailTemplate>
                    </FormaDataCards>
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 4);
            var before = new Dictionary<int, int>(drawn);

            // Act
            RenderFragment<Product> other = product => builder => builder.AddContent(0, Draw(drawn, product));
            cut.FindComponent<FormaDataCards<Product>>().Render(parameters => parameters.Add(cards => cards.ThumbnailTemplate, other));

            // Assert
            Assert.Equal([1, 2, 3, 4], DrawnSince(drawn, before));
        }

        [Fact]
        public async Task Should_still_act_on_a_card_that_was_not_drawn_again_through_several_selections()
        {
            // Arrange
            using var ctx = new FormaDataCardsTests();
            IReadOnlyList<Product>? changedTo = null;
            var cut = ctx.Render(
                @<FormaDataView Items="CreateMany(6)" EnablePagination="false" EnableItemSelection="true" ItemName="@(product => product.Name)" SelectedItemsChanged="@((IReadOnlyList<Product> selected) => changedTo = selected)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            cut.WaitForState(() => cut.FindAll("[role=listitem]").Count == 6);
            var engine = cut.FindComponent<FormaDataView<Product>>();
            var tokens = GetTokens(cut);

            // Act — the first cards are selected again and again while the sixth is never drawn again
            foreach (var _ in Enumerable.Range(0, 4))
            {
                await cut.InvokeAsync(() => engine.Instance.HandleSelectAsync(tokens[0], additive: false));
                await cut.InvokeAsync(() => engine.Instance.HandleSelectAsync(tokens[1], additive: false));
            }

            await cut.InvokeAsync(() => engine.Instance.HandleSelectAsync(tokens[5], additive: false));

            // Assert
            Assert.Equal(6, Assert.Single(changedTo!).Id);
        }

        [Fact]
        public void Should_make_the_same_script_calls_however_many_cards_it_draws()
        {
            // Arrange
            using var few = new FormaDataCardsTests();
            using var many = new FormaDataCardsTests();

            // Act — the same cards over four items and over forty, each with a box
            var fewCut = few.Render(
                @<FormaDataView Items="CreateMany(4)" EnablePagination="false" EnableCheckedSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            var manyCut = many.Render(
                @<FormaDataView Items="CreateMany(40)" EnablePagination="false" EnableCheckedSelection="true" ItemName="@(product => product.Name)">
                    <FormaDataCards TItem="Product" />
                </FormaDataView>);
            fewCut.WaitForState(() => fewCut.FindAll("[role=listitem]").Count == 4);
            manyCut.WaitForState(() => manyCut.FindAll("[role=listitem]").Count == 40);

            // Assert — each kind of observer attached once for the data view, and no call for an item
            static IEnumerable<string> Calls(FormaDataCardsTests ctx)
                => ctx.JSInterop.Invocations.GroupBy(invocation => invocation.Identifier).OrderBy(group => group.Key, StringComparer.Ordinal).Select(group => $"{group.Key} x{group.Count()}");

            Assert.Equal(Calls(few), Calls(many));
        }

        private static IQueryable<Product> CreateMany(int count) => Enumerable.Range(1, count)
            .Select(id => new Product(id, $"Product {id}", "Tools"))
            .AsQueryable();

        // Reports where the cards stand in their viewport, as the virtualizer's script does.
        private static Task ReportViewportAsync(IRenderedComponent<IComponent> cut, double offset, double viewport, double itemSize)
        {
            var virtualizer = cut.FindComponents<IComponent>().Single(component => component.Instance.GetType().IsGenericType && component.Instance.GetType().GetGenericTypeDefinition() == typeof(FormaVirtualize<>)).Instance;
            var report = virtualizer.GetType().GetMethod(nameof(FormaVirtualize<Product>.HandleViewportAsync))!;

            return cut.InvokeAsync(() => (Task)report.Invoke(virtualizer, [offset, viewport, itemSize])!);
        }

        private sealed record Product(int Id, string Name, string Category);
    }
}
