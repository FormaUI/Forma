@inherits FormaBunitContext
@using Bunit.Rendering
@using Forma.Blazor.Components.Composer.Dialogs
@using Forma.Blazor.Components.Feedback

@code {
    public sealed class Component
    {
        private static AngleSharp.Dom.IElement GetField(IRenderedComponent<ContainerFragment> cut, string label)
        {
            var field = cut.FindAll("label.forma-field-label")
                .Single(candidate => candidate.TextContent.Trim().TrimEnd('*', ' ') == label);

            return cut.Find($"#{field.GetAttribute("for")}");
        }

        private static Task FillAsync(TextFieldProbe fields, IRenderedComponent<ContainerFragment> cut, string label, string value)
            => fields.TypeAsync(GetField(cut, label), value);

        private static void Confirm(IRenderedComponent<ContainerFragment> cut)
            => cut.FindAll("button").Single(button => button.TextContent.Trim() == "Insert").Click();

        [Fact]
        public void Should_offer_an_address_and_nothing_else()
        {
            // Arrange
            using var ctx = new FormaComposerImageDialogTests();

            // Act
            var cut = ctx.Render(@<FormaComposerImageDialog Opened="true" />);

            // Assert
            Assert.Empty(cut.FindAll("[role=tablist]"));
            Assert.Empty(cut.FindAll(".forma-explorer"));
            Assert.Equal(
                ["Source *", "Alt Text", "Caption"],
                cut.FindAll("label.forma-field-label").Select(label => label.TextContent.Trim()));
        }

        [Fact]
        public void Should_hold_the_modal_open_so_a_missing_address_can_be_reported()
        {
            // Arrange
            using var ctx = new FormaComposerImageDialogTests();

            // Act
            var cut = ctx.Render(@<FormaComposerImageDialog Opened="true" />);

            // Assert
            Assert.False(cut.FindComponent<FormaDialog>().Instance.Options.CloseOnConfirm);
        }

        [Theory]
        [InlineData("javascript:alert(1)")]
        [InlineData("ftp://files.example.com")]
        [InlineData("just some text")]
        public async Task Should_refuse_an_address_the_document_could_not_keep(string address)
        {
            // Arrange
            using var ctx = new FormaComposerImageDialogTests();
            var fields = new TextFieldProbe(ctx);
            var inserted = false;

            // Act
            var cut = ctx.Render(@<FormaComposerImageDialog Opened="true" OnInsert="_ => inserted = true" />);
            await FillAsync(fields, cut, "Source", address);
            Confirm(cut);

            // Assert
            Assert.False(inserted);
            Assert.Equal(
                "An address has to be a web address, a mail or telephone link, a path within this site, or an inline picture.",
                cut.Find(".forma-composer-dialog-error[role=alert]").TextContent.Trim());
        }

        [Fact]
        public void Should_ask_for_an_address_when_confirmed_empty()
        {
            // Arrange
            using var ctx = new FormaComposerImageDialogTests();
            var inserted = false;
            var cut = ctx.Render(@<FormaComposerImageDialog Opened="true" OnInsert="_ => inserted = true" />);

            // Act
            Confirm(cut);

            // Assert
            Assert.False(inserted);
            Assert.Equal("Enter the address of the image before inserting.", cut.Find(".forma-composer-dialog-error[role=alert]").TextContent.Trim());
        }

        [Fact]
        public async Task Should_insert_an_address_still_arriving_as_insert_is_pressed_once_it_arrives()
        {
            // Arrange — an inline picture's address too long for one message is on its way as the reader presses Insert
            using var ctx = new FormaComposerImageDialogTests();
            var fields = new TextFieldProbe(ctx);
            ImageDialogResult? result = null;
            var cut = ctx.Render(@<FormaComposerImageDialog Opened="true" OnInsert="value => result = value" />);
            var address = "data:image/png;base64,iVBORw0KGgo=";
            var paste = fields.CommitHeld(GetField(cut, "Source"), address);
            var confirming = cut.FindAll("button").Single(button => button.TextContent.Trim() == "Insert").ClickAsync(new());

            // Act
            await paste.ReleaseAsync();
            await confirming;

            // Assert
            Assert.Equal(address, result?.Source);
            Assert.Empty(cut.FindAll(".forma-composer-dialog-error"));
        }

        [Fact]
        public async Task Should_report_the_image_entered_by_address()
        {
            // Arrange
            using var ctx = new FormaComposerImageDialogTests();
            var fields = new TextFieldProbe(ctx);
            ImageDialogResult? result = null;
            var cut = ctx.Render(@<FormaComposerImageDialog Opened="true" OnInsert="value => result = value" />);
            await FillAsync(fields, cut, "Source", "/media/photo.jpg");
            await FillAsync(fields, cut, "Alt Text", "A photo");
            await FillAsync(fields, cut, "Caption", "On the podium");

            // Act
            Confirm(cut);

            // Assert
            Assert.NotNull(result);
            Assert.Equal("/media/photo.jpg", result.Source);
            Assert.Equal("A photo", result.AltText);
            Assert.Equal("On the podium", result.Caption);
            Assert.Empty(cut.FindAll(".forma-composer-dialog-error"));
        }
    }
}
