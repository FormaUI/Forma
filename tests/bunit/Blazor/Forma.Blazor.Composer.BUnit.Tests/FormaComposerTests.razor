        [Fact]
        public void Should_register_its_shortcuts_on_its_root_and_on_the_editor()
        {
            // Arrange
            using var ctx = new FormaComposerTests();
            var model = new TestModel();

            // Act
            var cut = ctx.Render(@<FakeFormHost EditContext="@(new EditContext(model))">
                <FormaComposer @bind-Value="model.Body" />
            </FakeFormHost>);
            cut.WaitForAssertion(() => Assert.Single(cut.FindAll("textarea")));

            // Assert - the composer registers its catalog on its own scope, and the plain text editor registers it on the textarea
            var profiles = ctx.Router.Invocations
                .Where(invocation => invocation.Identifier == "register")
                .Select(invocation => (InputProfile)invocation.Arguments[1]!)
                .ToList();
            Assert.Multiple(
                () => Assert.Equal(2, profiles.Count),
                () => Assert.All(profiles, profile => Assert.Contains(profile.InputRoutes, route => route.Action == ComposerCommands.Undo)),
                () => Assert.All(profiles, profile => Assert.Contains(profile.InputRoutes, route => route.Action == ComposerCommands.Redo && route.Bindings.Count == 2)));
        }

        [Fact]
        public void Should_load_the_assets_of_the_plugins_in_play_and_the_eager_ones_of_the_rest_at_start()
        {
            // Arrange
            using var ctx = new FormaComposerTests();
            var assets = SetupAssets(ctx);
            var model = new HtmlModel();
            var plugins = ComposerDefinition.Create(composer => composer.AddRichTextEditor(editor => editor
                .AddFeaturePlugin<EditorAssetPlugin>()
                .AddViewPlugin<RichTextPreviewViewPlugin>(view => view.AddFeaturePlugin<ViewAssetPlugin>())));

            // Act
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="plugins" />);
            cut.WaitForAssertion(() => Assert.Equal(2, cut.FindAll("[role=tab]").Count));

            // Assert
            Assert.Equal(["/check/eager.js", "/check/editor.js"], GetLoadedUrls(assets));
        }

