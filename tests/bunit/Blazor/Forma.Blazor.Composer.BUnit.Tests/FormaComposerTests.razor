        [Fact]
        public void Should_put_host_registered_plugin_commands_on_the_plugins_bar()
        {
            // Arrange
            using var ctx = new FormaComposerTests();
            var model = new TestModel();
            var plugins = ComposerDefinition.Create(composer => composer.AddFeaturePlugin<CommandPlugin>());

            // Act
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="plugins" />);
            cut.Find("button[aria-label='Plugin Commands']").Click();

            // Assert
