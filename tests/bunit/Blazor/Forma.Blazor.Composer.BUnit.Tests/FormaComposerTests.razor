    private sealed class StubInsertionDialog : ComponentBase, IComposerInsertionDialog
    {
        /// <summary>The message confirming refuses with, where null means confirming answers an insertion.</summary>
        [Parameter] public string? Refusal { get; set; }

        /// <summary>The notice that the body can do nothing, where null means the body is available.</summary>
        [Parameter] public string? Unavailable { get; set; }

        public string Title => "Stub Dialog";

        public string? Notice => Unavailable;

        public IReadOnlyList<string> Messages => Refusal is null ? [] : [Refusal];

        public ValueTask<ComposerInsertion?> TryConfirmAsync(CancellationToken cancellationToken = default)
            => ValueTask.FromResult<ComposerInsertion?>(
                Refusal is null ? new ResourceInsertion { Source = "/media/a.png", Name = "a.png", Kind = "image", Embed = true, Link = false } : null);
    }

