        // Pushes a status item on command.
        private sealed class StatusPushingPlugin : IComposerFeaturePlugin
        {
            private IComposerStatusItem? _item;

            public string Id => "status";
            public IReadOnlyList<ComposerToolbarItem> Items =>
                [new(ComposerRows.Plugins, [new ToolbarCommand { Id = "wordcount", Title = "Word Count", Icon = Glyph.File, Command = "demo.wordcount" }])];
            public ValueTask<bool> IsAvailableAsync(CancellationToken cancellationToken = default) => ValueTask.FromResult(true);

            public ValueTask ExecuteAsync(string command, ComposerContext context, IComposerInteraction interaction, CancellationToken cancellationToken = default)
            {
                var count = context.Document.Content.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
                var text = $"{count} words";

                if (_item is null)
                {
                    _item = context.Regions.CreateStatusItem(text);
                }
                else
                {
                    _item.Text = text;
                }

                return ValueTask.CompletedTask;
            }
        }

        // Pushes a status item that opts into being announced.
        private sealed class AnnouncingStatusPlugin : IComposerFeaturePlugin
        {
            public string Id => "announcing";
            public IReadOnlyList<ComposerToolbarItem> Items =>
                [new(ComposerRows.Plugins, [new ToolbarCommand { Id = "save", Title = "Save", Icon = Glyph.File, Command = "demo.save" }])];
            public ValueTask<bool> IsAvailableAsync(CancellationToken cancellationToken = default) => ValueTask.FromResult(true);

            public ValueTask ExecuteAsync(string command, ComposerContext context, IComposerInteraction interaction, CancellationToken cancellationToken = default)
            {
                var item = context.Regions.CreateStatusItem("Saved");
                item.IsAnnounced = true;

                return ValueTask.CompletedTask;
            }
        }

