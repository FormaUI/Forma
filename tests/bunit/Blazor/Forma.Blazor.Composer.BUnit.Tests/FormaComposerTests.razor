        // Every asset loads, so each is asked for once.
        private static BunitJSModuleInterop SetupAssets(FormaComposerTests ctx)
        {
            var assets = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/operations/Asset.js");
            assets.Setup<bool>("loadModule", _ => true).SetResult(true);
            assets.Setup<bool>("loadStyle", _ => true).SetResult(true);

            return assets;
        }

        private static List<string?> GetLoadedUrls(BunitJSModuleInterop assets)
            => [.. assets.Invocations.Where(invocation => invocation.Identifier is "loadModule" or "loadStyle").Select(invocation => (string?)invocation.Arguments[0])];

