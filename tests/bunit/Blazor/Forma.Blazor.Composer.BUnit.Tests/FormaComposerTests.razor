        [Fact]
        public void Should_route_the_shortcuts_of_the_view_shown_through_its_own_scope()
        {
            // Arrange
            using var ctx = new FormaComposerTests();
            var root = ctx.Router.SetupModule("register", invocation => invocation.Arguments[2] is DotNetObjectReference<FormaComposer>);
            var model = new HtmlModel();
            var plugins = ComposerDefinition.Create(composer => composer.AddRichTextEditor(editor => editor
                .AddViewPlugin<RichTextPreviewViewPlugin>(view => view.AddFeaturePlugin<ViewShortcutPlugin>())));
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="plugins" />);
            cut.WaitForAssertion(() => Assert.Equal(2, cut.FindAll("[role=tab]").Count));

            // Act
            cut.FindAll("[role=tab]")[1].Click();

            // Assert
            var update = Assert.Single(root.Invocations, invocation => invocation.Identifier == "update");
            Assert.Contains(((InputProfile)update.Arguments[0]!).InputRoutes, route => route.Action == "check.view-shout");
        }

