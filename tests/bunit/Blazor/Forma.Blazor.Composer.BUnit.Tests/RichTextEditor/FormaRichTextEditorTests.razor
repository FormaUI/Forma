        [Fact]
        public void Should_announce_a_formatting_a_command_turned_on()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            var canvas = ctx.JSInterop.SetupModule(CanvasPath).SetupModule("attach", _ => true);
            canvas.Setup<RichTextCommandResult>("exec", _ => true)
                .SetResult(new RichTextCommandResult { Selection = new RichTextSelectionDto { Start = 0, End = 0, IsCollapsed = true, BlockType = "p", ActiveStyles = ["bold"] } });
            var model = new TestModel();
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichTextWithFormatting" />);

            // Act
            cut.Find("button[aria-label='Bold']").Click();

            // Assert
            cut.WaitForAssertion(() => Assert.Equal("Bold on", cut.Find(".forma-composer-rich-text-announcer").TextContent));
        }

        [Fact]
        public async Task Should_leave_the_canvas_as_typed_when_a_render_brings_the_document_as_it_stood()
        {
            // Arrange — a document the canvas committed, and a selection change that renders the editor again
            using var ctx = new FormaRichTextEditorTests();
            var fields = new TextFieldProbe(ctx);
            ctx.JSInterop.SetupModule(CanvasPath).SetupModule("attach", _ => true);
            var model = new TestModel();
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichTextWithFormatting" />);
            var editor = cut.FindComponent<FormaRichTextEditor>();
            await fields.ChangeAsync(GetCanvas(cut), "<p>Typed <script>x()</script></p>");

            // Act
            await editor.InvokeAsync(() => editor.Instance.HandleSelectionChangedAsync(new RichTextSelectionDto { Start = 0, End = 0, IsCollapsed = true, BlockType = "p", ActiveStyles = [] }));

            // Assert — the canvas keeps what was typed though the document holds it sanitized
            Assert.Multiple(
                () => Assert.Equal("<p>Typed </p>", model.Body.Content),
                () => Assert.Equal("<p>Typed <script>x()</script></p>", fields.GetText(GetCanvas(cut))));
        }

        [Fact]
        public async Task Should_say_on_the_composer_s_field_that_its_canvas_text_did_not_arrive_and_take_it_off_once_it_does()
        {
            // Arrange — the form's messages as each change of its validation state leaves them
            using var ctx = new FormaRichTextEditorTests();
            var fields = new TextFieldProbe(ctx);
            ctx.JSInterop.SetupModule(CanvasPath).SetupModule("attach", _ => true);
            var model = new TestModel();
            var form = new EditContext(model);
            var states = new List<IReadOnlyList<string>>();
            form.OnValidationStateChanged += (_, _) => states.Add([.. form.GetValidationMessages()]);
            var cut = ctx.Render(@<FakeFormHost EditContext="@form">
                <FormaComposer @bind-Value="model.Body" Plugins="RichText" />
            </FakeFormHost>);

            // Act — a long paste whose stream breaks, and the whole text the browser sends in its place too, then the reader's next edit
            await fields.CommitBrokenAsync(GetCanvas(cut), "<p>A paste too long for one message</p>");
            await fields.ChangeAsync(GetCanvas(cut), "<p>A paste, typed on</p>");

            // Assert
            Assert.Multiple(
                () => Assert.Equal([["Your text didn't arrive in full. Edit it to try again."], []], states),
                () => Assert.Equal("<p>A paste, typed on</p>", model.Body.Content));
        }

