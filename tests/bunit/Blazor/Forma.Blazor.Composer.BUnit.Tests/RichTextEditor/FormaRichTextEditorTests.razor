        [Fact]
        public async Task Should_reopen_an_image_whose_values_stream_past_the_budget()
        {
            // Arrange — an image carried as a data address larger than a message
            using var ctx = new FormaRichTextEditorTests();
            ctx.JSInterop.SetupModule(CanvasPath).SetupModule("attach", _ => true);
            var model = new TestModel();
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichText" />);
            var editor = cut.FindComponent<FormaRichTextEditor>();
            var image = new ImageDialogResult { Source = "data:image/png;base64," + new string('A', 40_000), AltText = "A cat" };
            await using var stream = new FakeJSStreamReference(JsonSerializer.SerializeToUtf8Bytes(image, JsonSerializerOptions.Web));

            // Act
            await editor.InvokeAsync(() => editor.Instance.HandleImageActivatedAsync(new JSTransfer { Stream = stream }));

            // Assert
            var reopened = Assert.IsType<ImageDialogResult>(cut.FindComponent<FormaComposerImageDialog>().Instance.Reopening);
            Assert.Multiple(
                () => Assert.Equal(image.Source, reopened.Source),
                () => Assert.Equal("A cat", reopened.AltText),
                () => Assert.True(stream.IsDisposed));
        }

        [Fact]
        public async Task Should_leave_the_dialog_closed_for_values_larger_than_it_accepts()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            ctx.JSInterop.SetupModule(CanvasPath).SetupModule("attach", _ => true);
            var model = new TestModel();
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichText" />);
            var editor = cut.FindComponent<FormaRichTextEditor>();
            await using var stream = new FakeJSStreamReference([], length: JSTransferOptions.Default.MaximumLength + 1);

            // Act
            await editor.InvokeAsync(() => editor.Instance.HandleVideoActivatedAsync(new JSTransfer { Stream = stream }));

            // Assert
            Assert.Multiple(
                () => Assert.Empty(cut.FindComponents<FormaComposerVideoDialog>()),
                () => Assert.True(stream.IsDisposed));
        }

        [Fact]
        public async Task Should_prefill_the_link_dialog_with_a_selected_text_that_streams_past_the_budget()
        {
            // Arrange — the whole document selected as the dialog opens
            using var ctx = new FormaRichTextEditorTests();
            var canvas = ctx.JSInterop.SetupModule(CanvasPath).SetupModule("attach", _ => true);
            var text = new string('x', 40_000);
            var stream = new FakeJSStreamReference(JsonSerializer.SerializeToUtf8Bytes(new { text, href = (string?)null, name = (string?)null, opensInNewTab = false, count = 0 }));
            canvas.Setup<JSTransfer>("beginLinkDialog", _ => true).SetResult(new JSTransfer { Stream = stream });
            var model = new TestModel();
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichText" />);
            var plugin = Assert.IsType<RichTextEditorPlugin>(cut.FindComponent<FormaRichTextEditor>().Instance.Editor);

            // Act
            await cut.InvokeAsync(() => plugin.RequestLinkDialog());

            // Assert
            var reopened = Assert.IsType<LinkDialogResult>(cut.FindComponent<FormaComposerLinkDialog>().Instance.Reopening);
            Assert.Equal(text, reopened.Name);
        }

        [Fact]
        public void Should_render_no_selection_bar_while_the_engine_hides_it()
        {
            // Arrange
            using var ctx = new FormaRichTextEditorTests();
            var model = new TestModel();
            var editor = new RichTextEditorPlugin();
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichTextWithSelectionBar" />);
            var composer = cut.FindComponent<FormaComposer>().Instance;
            Assert.NotNull(cut.Find(".forma-composer-selection-bar"));

            // Act
            cut.InvokeAsync(() => composer.HandleCommandAsync(ComposerCommands.SelectionBar));

            // Assert
            cut.WaitForAssertion(() => Assert.Empty(cut.FindAll(".forma-composer-selection-bar")));
        }

