        [Fact]
        public async Task Should_write_a_document_of_the_composer_own_into_its_canvas()
        {
            // Arrange — an edit the composer's undo takes back
            using var ctx = new FormaRichTextEditorTests();
            var fields = new TextFieldProbe(ctx);
            ctx.JSInterop.SetupModule(CanvasPath).SetupModule("attach", _ => true);
            var model = new TestModel();
            var cut = ctx.Render(@<FormaComposer @bind-Value="model.Body" Plugins="RichText" />);
            await fields.ChangeAsync(GetCanvas(cut), "<p>Edited</p>");
            var composer = cut.FindComponent<FormaComposer>().Instance;

            // Act
            await cut.InvokeAsync(() => composer.HandleCommandAsync(ComposerCommands.Undo));

            // Assert
            Assert.Multiple(
                () => Assert.Equal("<p>Initial Text</p>", model.Body.Content),
                () => Assert.Equal("<p>Initial Text</p>", fields.GetText(GetCanvas(cut))));
        }

        [Fact]
        public async Task Should_commit_its_canvas_ahead_of_a_command_the_composer_runs()
        {
