@inherits FormaBunitContext
@using Forma.Blazor.Components.Page
@using System.Text.Json
@using Forma.Framework.Culture.Browser.Interop
@using Forma.Framework.Culture.Router
@using Forma.Tests.Shared
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection

@code {
    // Culture routing under the application at the path base, escaped, with an English route and a Hebrew one.
    private static void AddRouting(FormaPageHeadTests ctx, CultureSwitchMode cultureSwitchMode, CulturePrefix prefix, string pathBase)
    {
        ctx.Services.AddSingleton<NavigationManager>(new FakeNavigationManager(new Uri($"http://localhost{pathBase}/"), new Uri($"http://localhost{pathBase}/about")));
        ctx.Services.AddFormaCultureRouting(new CultureRouterOptions
        {
            Prefix = prefix,
            Switch = cultureSwitchMode,
            DefaultCulture = "en",
            Routes =
            [
                new() { Token = "en", UICulture = new("en") },
                new() { Token = "he", UICulture = new("he"), Aliases = ["iw"] }
            ]
        });
    }

    public sealed class Component
    {
        [Fact]
        public void Should_write_its_title_as_the_documents_only_title_where_the_page_sets_none()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Equal(["Admin Console"], cut.FindAll("title").Select(title => title.TextContent));
        }

        [Fact]
        public void Should_write_the_title_a_page_sets_as_the_documents_only_title()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Act — a page rendered after the head, setting a title of its own
            ctx.Render(@<PageTitle>Orders · Admin Console</PageTitle>);

            // Assert
            Assert.Equal(["Orders · Admin Console"], cut.FindAll("title").Select(title => title.TextContent));
        }

        [Fact]
        public void Should_write_its_title_again_once_the_pages_own_leaves()
        {
            // Arrange — a page rendered after the head, setting a title of its own
            using var ctx = new FormaPageHeadTests();
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);
            var page = ctx.Render<LayoutView>(parameters => parameters.AddChildContent(@<PageTitle>Orders · Admin Console</PageTitle>));

            // Act — the page's content replaced by content that sets none
            page.Render(parameters => parameters.AddChildContent("<p>Untitled</p>"));

            // Assert
            Assert.Equal(["Admin Console"], cut.FindAll("title").Select(title => title.TextContent));
        }

        [Fact]
        public async Task Should_publish_the_cultures_the_page_is_rendered_in()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();
            await ctx.ChangeCultureAsync("de-DE", "he");

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            var marker = cut.Find("meta[name='forma-culture']");
            Assert.Equal("de-DE/he", $"{marker.GetAttribute("data-culture")}/{marker.GetAttribute("data-ui-culture")}");
        }

        [Fact]
        public async Task Should_publish_the_invariant_culture_by_its_empty_name()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();
            await ctx.ChangeCultureAsync("");

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            var marker = cut.Find("meta[name='forma-culture']");
            Assert.Multiple(
                () => Assert.Equal(string.Empty, marker.GetAttribute("data-culture")),
                () => Assert.Equal(string.Empty, marker.GetAttribute("data-ui-culture")));
        }

        [Fact]
        public void Should_publish_the_policy_that_persists_nothing_by_default()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Equal("state", cut.Find("meta[name='forma-culture-policy']").GetAttribute("content"));
        }

        [Fact]
        public void Should_publish_everything_writing_the_cookie_takes()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();
            ctx.Services.AddSingleton(new CultureSwitchPolicy
            {
                Persistence = CultureSwitchPersistence.Cookie,
                CookieName = "culture",
                CookiePath = "/app",
                CookieDomain = "example.com",
                CookieLifetime = TimeSpan.FromDays(1),
                IsCookieSecure = true,
                CookieSameSite = CultureCookieSameSite.Strict,
            });

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            var policy = cut.Find("meta[name='forma-culture-policy']");
            Assert.Multiple(
                () => Assert.Equal("cookie", policy.GetAttribute("content")),
                () => Assert.Equal("culture /app example.com 86400 strict", string.Join(' ', new[] { "data-name", "data-path", "data-domain", "data-max-age", "data-same-site" }.Select(policy.GetAttribute))),
                () => Assert.True(policy.HasAttribute("data-secure")));
        }

        [Fact]
        public void Should_default_the_base_address_to_the_site_root()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Equal("/", cut.Find("base").GetAttribute("href"));
        }

        [Fact]
        public void Should_default_the_base_address_to_the_applications_root_under_its_path_base()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();
            ctx.Services.AddSingleton<NavigationManager>(new FakeNavigationManager(new Uri("http://localhost/my%20app/"), new Uri("http://localhost/my%20app/about")));

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Equal("/my%20app/", cut.Find("base").GetAttribute("href"));
        }

        [Theory]
        [InlineData(CultureSwitchMode.FullLoad, CulturePrefix.ExceptDefault, "he", "", "/he/")]
        [InlineData(CultureSwitchMode.FullLoad, CulturePrefix.ExceptDefault, "he", "/app", "/app/he/")]
        [InlineData(CultureSwitchMode.FullLoad, CulturePrefix.ExceptDefault, "en", "", "/")]
        [InlineData(CultureSwitchMode.FullLoad, CulturePrefix.ExceptDefault, "en", "/app", "/app/")]
        [InlineData(CultureSwitchMode.FullLoad, CulturePrefix.Always, "en", "", "/en/")]
        [InlineData(CultureSwitchMode.FullLoad, CulturePrefix.Always, "en", "/my%20app", "/my%20app/en/")]
        [InlineData(CultureSwitchMode.InPlace, CulturePrefix.ExceptDefault, "he", "", "/")]
        [InlineData(CultureSwitchMode.InPlace, CulturePrefix.ExceptDefault, "he", "/app", "/app/")]
        [InlineData(CultureSwitchMode.InPlace, CulturePrefix.Always, "en", "/my%20app", "/my%20app/")]
        public void Should_take_the_base_culture_routing_gives_the_pages_pair(CultureSwitchMode cultureSwitchMode, CulturePrefix prefix, string culture, string pathBase, string href)
        {
            // Arrange
            using var fixture = new CultureFixture(culture);
            using var ctx = new FormaPageHeadTests();
            AddRouting(ctx, cultureSwitchMode, prefix, pathBase);

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            var bases = cut.FindAll("base");
            var element = Assert.Single(bases);
            Assert.Equal(href, element.GetAttribute("href"));
        }

        [Fact]
        public void Should_reject_a_base_address_where_culture_routing_gives_the_pages()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();
            AddRouting(ctx, CultureSwitchMode.FullLoad, CulturePrefix.ExceptDefault, "");

            // Act
            var act = () => ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" BaseHref="/he/" />);

            // Assert
            var exception = Assert.Throws<InvalidOperationException>(act);
            Assert.Contains("BaseHref", exception.Message, StringComparison.Ordinal);
        }

        [Fact]
        public void Should_publish_the_address_policy_with_routings_mapping_where_culture_routing_is_registered()
        {
            // Arrange
            using var fixture = new CultureFixture("en");
            using var ctx = new FormaPageHeadTests();
            ctx.Services.AddSingleton(new CultureSwitchPolicy { Persistence = CultureSwitchPersistence.Cookie });
            AddRouting(ctx, CultureSwitchMode.InPlace, CulturePrefix.ExceptDefault, "/app");

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            var policy = cut.Find("meta[name='forma-culture-policy']");
            using var routes = JsonDocument.Parse(policy.GetAttribute("data-routes")!);
            Assert.Multiple(
                () => Assert.Equal("address", policy.GetAttribute("content")),
                () => Assert.Equal("en", policy.GetAttribute("data-default")),
                () => Assert.Equal("except-default", policy.GetAttribute("data-prefix")),
                () => Assert.Equal("in-place", policy.GetAttribute("data-switch")),
                () => Assert.Equal("/app/", policy.GetAttribute("data-root")),
                () => Assert.Equal("forma-culture-route%2Fapp", policy.GetAttribute("data-cookie-name")),
                () => Assert.Equal("/app", policy.GetAttribute("data-cookie-path")),
                () => Assert.Equal(
                    """[{"token":"en","aliases":[],"culture":"en","uiCulture":"en","direction":"ltr"},{"token":"he","aliases":["iw"],"culture":"he","uiCulture":"he","direction":"rtl"}]""",
                    routes.RootElement.GetRawText()));
        }

        [Fact]
        public void Should_render_the_base_address_given()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" BaseHref="/admin/" />);

            // Assert
            Assert.Equal("/admin/", cut.Find("base").GetAttribute("href"));
        }

        [Fact]
        public void Should_link_the_icon_given()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" IconHref="favicon.svg" />);

            // Assert
            Assert.Equal("favicon.svg", cut.Find("link[rel=icon]").GetAttribute("href"));
        }

        [Fact]
        public void Should_link_no_icon_when_none_is_given()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Empty(cut.FindAll("link[rel=icon]"));
        }

        [Fact]
        public void Should_declare_the_character_set_and_viewport()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("utf-8", cut.Find("meta[charset]").GetAttribute("charset"));
                Assert.Equal("width=device-width, initial-scale=1.0", cut.Find("meta[name=viewport]").GetAttribute("content"));
            });
        }

        [Fact]
        public void Should_link_formas_stylesheets_in_cascade_order()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);
            var hrefs = cut.FindAll("link[rel=stylesheet]").Select(link => link.GetAttribute("href") ?? "").ToArray();

            // Assert
            Assert.Equal(
                ["_content/Forma.Blazor/forma-tokens.css", "_content/Forma.Blazor/forma-reset.css", "_content/Forma.Blazor/forma-base.css", "_content/Forma.Blazor/forma-input.css", "_content/Forma.Blazor/forma-prose.css"],
                hrefs);
        }

        [Fact]
        public void Should_render_a_hosts_own_head_content_after_formas()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console">
                <link rel="stylesheet" href="app.css" />
            </FormaPageHead>);
            var hrefs = cut.FindAll("link[rel=stylesheet]").Select(link => link.GetAttribute("href") ?? "").ToArray();

            // Assert
            Assert.Equal("app.css", hrefs[^1]);
        }

        [Fact]
        public void Should_reject_a_missing_title()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var act = () => ctx.Render(@<FormaPageHead Title="   " />);

            // Assert
            Assert.Throws<ArgumentException>(act);
        }

        [Fact]
        public void Should_reject_a_missing_base_address()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var act = () => ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" BaseHref="" />);

            // Assert
            Assert.Throws<ArgumentException>(act);
        }
    }
}
