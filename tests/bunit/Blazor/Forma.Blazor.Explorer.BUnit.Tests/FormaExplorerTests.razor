            var cut = ctx.Render(@<FormaExplorer Items="[]"
                                                Folders="@(CatalogItem.ForAll([parent, child]))"
                                                OnDrop="@(req => { request = req; return Task.CompletedTask; })"
                                                OnRejected="@(r => { rejection = r; return Task.CompletedTask; })" />);

            // Act
            GetFolderRow(cut, "Races").DragStart();
            await DropOnAsync(cut, GetFolderRow(cut, "2026"));

            // Assert
            Assert.Multiple(
                () => Assert.Null(request),
                () => Assert.Equal(CatalogRejectionReason.FolderCycle, rejection?.Reason),
                () => Assert.Equal("\"Races\" can't move into itself or a folder inside it.", cut.Find(".forma-explorer-rejection-text").TextContent.Trim()));
