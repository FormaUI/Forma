        [Fact]
        public void Should_list_only_the_resources_the_accept_pattern_admits()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/cover.jpg"),
                new DocumentResourceInfo("https://example.com/notes.pdf"),
