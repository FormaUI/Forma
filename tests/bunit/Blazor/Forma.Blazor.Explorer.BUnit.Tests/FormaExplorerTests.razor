        [Fact]
        public async Task Should_refuse_the_whole_drop_when_one_selected_item_cannot_move()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<ICatalogItem> items =
            [
                CatalogItem.For(new ImageResourceInfo("https://example.com/a.jpg")),
                new CatalogItem
                {
                    Key = "b",
                    Name = "b.jpg",
                    Capabilities = CatalogItemCapabilities.Drag | CatalogItemCapabilities.Open | CatalogItemCapabilities.View,
                    Resource = new ImageResourceInfo("https://example.com/b.jpg")
                }
            ];
            var folder = new FolderResourceInfo("races") { Name = "Races" };
            CatalogDropRequest? request = null;
            CatalogRejection? rejection = null;
            var cut = ctx.Render(@<FormaExplorer Items="items"
                                                Folders="@(CatalogItem.ForAll([folder]))"
                                                OnDrop="@(req => { request = req; return Task.CompletedTask; })"
                                                OnRejected="@(r => { rejection = r; return Task.CompletedTask; })" />);
            cut.Find(".forma-explorer-select-mode-button").Click();
            await ToggleBoxAsync(cut, "a.jpg");
            await ToggleBoxAsync(cut, "b.jpg");

            // Act
            ItemNamed(cut, "a.jpg").DragStart();
            await DropOnAsync(cut, GetFolderRow(cut, "Races"));

            // Assert
            Assert.Multiple(
                () => Assert.Null(request),
                () => Assert.Equal(CatalogRejectionReason.NotPermitted, rejection?.Reason),
                () => Assert.Equal("\"b.jpg\" can't be moved.", cut.Find(".forma-explorer-rejection-text").TextContent.Trim()),
                () => Assert.True(IsBoxChecked(ItemNamed(cut, "a.jpg"))),
                () => Assert.True(IsBoxChecked(ItemNamed(cut, "b.jpg"))));
        }

