    // A selection holds files and folders together, and a deletion or a drop takes it whole: one request, validated whole before it is
    // raised, whose refusal or failure the host reports leaves the selection as it was.
    public sealed class MixedOperations
    {
        // The file the location lists beside its folders.
        private static IReadOnlyList<ICatalogItem> CreateItems()
            => CatalogItem.ForAll([new ImageResourceInfo("https://example.com/cover.jpg")]);

        // The top-level folders Races and Covers, with 2026 inside Races.
        private static IReadOnlyList<ICatalogItem> CreateFolders()
            => CatalogItem.ForAll(
            [
                new FolderResourceInfo("races") { Name = "Races" },
                new FolderResourceInfo("2026") { Name = "2026", Parent = "races" },
                new FolderResourceInfo("covers") { Name = "Covers" }
            ]);

        // Enters the selection mode and checks the box on the card showing each of the names.
        private static async Task SelectAsync<TComponent>(IRenderedComponent<TComponent> cut, params string[] names)
            where TComponent : IComponent
        {
            cut.Find(".forma-explorer-select-mode-button").Click();

            foreach (var name in names)
            {
                await ToggleBoxAsync(cut, name);
            }
        }

        [Fact]
        public async Task Should_delete_a_selected_folder_and_file_in_one_request_and_leave_neither_selected()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var items = CreateItems();
            var folders = CreateFolders();
            var requests = new List<CatalogDeleteRequest>();
            var reports = new List<IReadOnlyList<ICatalogItem>>();
            var cut = ctx.Render(@<FormaExplorer Items="items"
                                                Folders="folders"
                                                OnDelete="@(req => { requests.Add(req); return Task.CompletedTask; })"
                                                SelectedItemsChanged="@(selected => { reports.Add(selected); return Task.CompletedTask; })" />);
            await SelectAsync(cut, "Races", "cover.jpg");

            // Act
            await cut.Find(".forma-explorer-delete-button").ClickAsync(new MouseEventArgs());
            await cut.Find(".forma-dialog-footer .forma-button-danger").ClickAsync(new MouseEventArgs());

            // Assert
            var request = Assert.Single(requests);
            Assert.Multiple(
                () => Assert.Equal(["Races", "cover.jpg"], request.Items.Select(item => item.Name)),
                () => Assert.Empty(reports[^1]),
                () => Assert.False(IsBoxChecked(ItemNamed(cut, "Races"))),
                () => Assert.False(IsBoxChecked(ItemNamed(cut, "cover.jpg"))));
        }

        [Fact]
        public async Task Should_keep_the_selection_when_the_host_fails_the_deletion()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var items = CreateItems();
            var folders = CreateFolders();
            var requests = new List<CatalogDeleteRequest>();
            var cut = ctx.Render(@<FormaExplorer Items="items"
                                                Folders="folders"
                                                OnDelete="@(req => { requests.Add(req); req.Fail(); return Task.CompletedTask; })" />);
            await SelectAsync(cut, "Races", "cover.jpg");

            // Act
            await cut.Find(".forma-explorer-delete-button").ClickAsync(new MouseEventArgs());
            await cut.Find(".forma-dialog-footer .forma-button-danger").ClickAsync(new MouseEventArgs());

            // Assert
            Assert.Multiple(
                () => Assert.Single(requests),
                () => Assert.True(IsBoxChecked(ItemNamed(cut, "Races"))),
                () => Assert.True(IsBoxChecked(ItemNamed(cut, "cover.jpg"))),
                () => Assert.Equal("2 selected", cut.Find(".forma-explorer-selection-label").TextContent.Trim()));
        }

        [Fact]
        public async Task Should_refuse_the_whole_deletion_when_one_selected_item_cannot_be_deleted()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var items = CreateItems();
            var folders = CreateFolders();
            var itemOptions = new ExplorerItemOptions { AllowedFolderCapabilities = ExplorerItemOptions.Default.AllowedFolderCapabilities & ~CatalogItemCapabilities.Delete };
