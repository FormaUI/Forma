        public void Should_omit_the_folder_count_when_the_host_did_not_supply_one()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<FolderResourceInfo> folders = [new("races") { Name = "Races" }];

            // Act
            var cut = ctx.Render(@<FormaExplorer Items="[]" Folders="@(CatalogItem.ForAll(folders))" />);

            // Assert
            var folderRow = GetFolderRows(cut)[1];
            Assert.Equal("Races", folderRow.QuerySelector(".forma-data-tree-node-name")!.TextContent.Trim());
