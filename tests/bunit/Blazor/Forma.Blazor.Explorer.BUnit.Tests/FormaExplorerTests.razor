        [Fact]
        public async Task Should_resize_the_name_column_from_the_frozen_edge()
        {
            // Arrange - every column measured forty wide, and a frozen region 240 wide
            using var ctx = new FormaExplorerTests();
            var probe = new DomProbe<ScrollState>(ctx);
            var router = new InputRouterProbe(ctx);
            IReadOnlyList<ResourceInfo> resources = [new ImageResourceInfo("https://example.com/cover.jpg")];
            var cut = ctx.Render(@<FormaExplorer Items="@(CatalogItem.ForAll(resources))" ViewMode="ExplorerViewMode.Details" />);
            var grid = cut.FindComponent<FormaDataGrid<ICatalogItem>>();
            var pane = grid.FindComponent<FormaFreezePane>();
            var runtimeId = pane.Find(".forma-freeze-pane").GetAttribute("data-rid")!;
            var fit = new ColumnFitReport
            {
                AvailableWidth = 1000,
                Columns = [.. cut.FindAll("table.forma-explorer-details thead th[data-column]").Select(cell => new ColumnWidth { Key = cell.GetAttribute("data-column")!, Width = 40 })]
            };
            await cut.InvokeAsync(() => grid.Instance.HandleColumnFitAsync(fit));

            // The pane asks for its viewport's extent once its frozen edge is to be drawn.
            await probe.ReportAsync(runtimeId, new ScrollState(false, true, 240, 38));
            await probe.ReportAsync(runtimeId, new ScrollState(false, true, 240, 38, 600));

            // Act
            var edge = pane.FindComponent<FormaSplitter>();
            await router.RouteAsync(edge.Instance.RootElement, "splitter.grow", "ArrowRight");

            // Assert - the name column, the last frozen, takes what the actions column leaves of the edge's 248
            Assert.Multiple(
                () => Assert.Contains("inline-size: 208px", cut.Find("th.forma-explorer-column-name").GetAttribute("style"), StringComparison.Ordinal),
                () => Assert.Contains("inline-size: 208px", cut.Find("td.forma-explorer-column-name").GetAttribute("style"), StringComparison.Ordinal),
                () => Assert.DoesNotContain("inline-size", cut.Find("th.forma-explorer-column-actions").GetAttribute("style"), StringComparison.Ordinal));
        }
    }

    public sealed class Grouping
    {
        [Fact]
        public async Task Should_group_held_items_and_a_providers_alike_across_page_boundaries()
        {
            // Arrange - two files the name ties, told apart by their keys, and two either side of the start of the day
            using var ctx = new FormaExplorerTests();
            var clock = new FakeTimeProvider(new DateTimeOffset(2026, 9, 16, 12, 0, 0, TimeSpan.Zero));
            clock.SetLocalTimeZone(TimeZoneInfo.Utc);
            ctx.Services.AddSingleton<TimeProvider>(clock);
            var midnight = new DateTimeOffset(2026, 9, 16, 0, 0, 0, TimeSpan.Zero);
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/b/same.jpg") { ModifiedAt = midnight.AddHours(3) },
                new ImageResourceInfo("https://example.com/a/same.jpg") { ModifiedAt = midnight.AddHours(1) },
                new ImageResourceInfo("https://example.com/dawn.jpg") { ModifiedAt = midnight },
                new ImageResourceInfo("https://example.com/dusk.jpg") { ModifiedAt = midnight.AddTicks(-1) },
                new ImageResourceInfo("https://example.com/old.jpg") { ModifiedAt = midnight.AddDays(-30) },
            ];
            var provider = new FakeCatalogProvider(resources);
            var held = ctx.Render(@<FormaExplorer Items="@(CatalogItem.ForAll(resources))" GroupField="ExplorerGroupField.DateModified" PageSize="2" />);
            var provided = ctx.Render(@<FormaExplorer ItemsProvider="provider" GroupField="ExplorerGroupField.DateModified" PageSize="2" />);

            // Act - midnight passes after the first page, and each explorer reads its pages one at a time
            var heldPages = await ReadGroupedPagesAsync(held, clock, 3);
            var providedPages = await ReadGroupedPagesAsync(provided, clock, 3);

            // Assert
            Assert.Multiple(
                () => Assert.Equal(
                    [
                        ["Today (3)", "https://example.com/dawn.jpg", "https://example.com/a/same.jpg"],
                        ["Today (3)", "https://example.com/b/same.jpg", "Yesterday (1)", "https://example.com/dusk.jpg"],
                        ["Last Month (1)", "https://example.com/old.jpg"],
                    ],
                    heldPages),
                () => Assert.Equal(heldPages, providedPages));
        }

