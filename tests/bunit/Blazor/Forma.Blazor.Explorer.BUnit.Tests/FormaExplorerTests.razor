        [Fact]
        public void Should_navigate_back_forward_and_up_in_folder_history()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var parent = CatalogItem.ForFolder(new FolderResourceInfo("races") { Name = "Races", Count = 10 });
            var child = CatalogItem.ForFolder(new FolderResourceInfo("2026") { Name = "2026", Parent = "races", Count = 5 });
            IReadOnlyList<ICatalogItem> folders = [parent, child];
            ICatalogFolderItem? activeFolder = null;

            var cut = ctx.Render(@<FormaExplorer Items="[]"
                                                Folders="folders"
                                                CurrentFolder="child"
                                                OnFolderChanged="@(f => { activeFolder = f; return Task.CompletedTask; })" />);

            // Assert
            var upBtn = cut.FindAll(".forma-explorer-nav-button")[2];
            Assert.False(upBtn.HasAttribute("disabled"));
            upBtn.Click();

            // Assert
            Assert.NotNull(activeFolder);
            Assert.Equal("races", activeFolder.Key);
        }

        [Fact]
        public async Task Should_follow_its_own_moves_where_the_host_leaves_the_folder_unbound()
        {
            // Arrange - no CurrentFolder handed back
            using var ctx = new FormaExplorerTests();
            var cut = ctx.Render(@<FormaExplorer Items="@(Array.Empty<ICatalogItem>())" Folders="@(CatalogItem.ForAll([new FolderResourceInfo("covers") { Name = "Covers" }, new FolderResourceInfo("races") { Name = "Races" }]))" />);

            // Act
            await PressCardAsync(cut, "Races");

            // Assert - the location, and Up, follow the move
            var location = (IExplorerLocationView)cut.FindComponent<FormaExplorer>().Instance;
            Assert.Multiple(
                () => Assert.Equal("races", location.CurrentFolder?.Key),
                () => Assert.True(location.CanGoUp),
                () => Assert.Equal(["Races"], location.Breadcrumbs.Select(folder => folder.Name)));
        }
    }

    public sealed class Sorting
    {
        [Fact]
        public async Task Should_sort_resources_by_name_and_size()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/b.jpg") { Size = 500 },
                new ImageResourceInfo("https://example.com/a.jpg") { Size = 1000 },
                new ImageResourceInfo("https://example.com/c.jpg") { Size = 200 }
            ];

            // Act & Assert - Name ascending (default)
            var cut = ctx.Render(@<FormaExplorer Items="@(CatalogItem.ForAll(resources))" />);
            var items = cut.FindAll(".forma-data-card-name");
            Assert.Equal("a.jpg", items[0].TextContent);
            Assert.Equal("b.jpg", items[1].TextContent);
            Assert.Equal("c.jpg", items[2].TextContent);

            // Act
            await SortByAsync(cut, CatalogSortField.Size);
            items = cut.FindAll(".forma-data-card-name");
            Assert.Equal("c.jpg", items[0].TextContent);
            Assert.Equal("b.jpg", items[1].TextContent);
            Assert.Equal("a.jpg", items[2].TextContent);
        }

        [Fact]
        public async Task Should_show_the_details_in_the_sort_the_thumbnails_were_given()
        {
            // Arrange - the thumbnails sorted by size
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/a.jpg") { Size = 500 },
                new ImageResourceInfo("https://example.com/b.jpg") { Size = 1000 },
                new ImageResourceInfo("https://example.com/c.jpg") { Size = 200 }
            ];
            var cut = ctx.Render(@<FormaExplorer Items="@(CatalogItem.ForAll(resources))" />);
            await SortByAsync(cut, CatalogSortField.Size);

            // Act
            cut.FindAll(".forma-explorer-view-button")[1].Click();

            // Assert
            Assert.Multiple(
                () => Assert.Equal(["c.jpg", "a.jpg", "b.jpg"], GetDetailsNames(cut)),
                () => Assert.Equal("ascending", cut.Find("th.forma-explorer-column-size").GetAttribute("aria-sort")),
                () => Assert.Equal("none", cut.Find("th.forma-explorer-column-name").GetAttribute("aria-sort")));
        }

        [Fact]
        public async Task Should_sort_resources_by_the_date_added_and_the_date_modified()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var epoch = new DateTimeOffset(2026, 1, 1, 0, 0, 0, TimeSpan.Zero);
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/a.jpg") { CreatedAt = epoch.AddDays(3), ModifiedAt = epoch.AddDays(1) },
                new ImageResourceInfo("https://example.com/b.jpg") { CreatedAt = epoch.AddDays(1), ModifiedAt = epoch.AddDays(3) },
                new ImageResourceInfo("https://example.com/c.jpg") { CreatedAt = epoch.AddDays(2), ModifiedAt = epoch.AddDays(2) }
            ];
            var cut = ctx.Render(@<FormaExplorer Items="@(CatalogItem.ForAll(resources))" />);

            // Act
            await SortByAsync(cut, CatalogSortField.DateAdded);

            // Assert
            var items = cut.FindAll(".forma-data-card-name");
            Assert.Equal(["b.jpg", "c.jpg", "a.jpg"], items.Select(i => i.TextContent));

            // Act
            await SortByAsync(cut, CatalogSortField.DateModified);

            // Assert
