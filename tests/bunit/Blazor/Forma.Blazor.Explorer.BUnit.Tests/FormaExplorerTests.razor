                                                Folders="folders"
                                                ItemOptions="itemOptions"
                                                OnDelete="@(req => { requests.Add(req); return Task.CompletedTask; })"
                                                OnRejected="@(r => { rejection = r; return Task.CompletedTask; })" />);
