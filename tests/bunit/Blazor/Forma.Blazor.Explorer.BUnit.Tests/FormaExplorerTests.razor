    public sealed class Constraints
    {
        [Fact]
        public async Task Should_refuse_a_root_folder_beyond_the_root_folder_ceiling()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<FolderResourceInfo> folders = [new("races") { Name = "Races" }];
            var constraints = new CatalogConstraints { MaxFolderRootCount = 1 };
            CatalogRejection? rejection = null;
            CatalogFolderCreateRequest? created = null;

            var cut = ctx.Render(@<FormaExplorer Items="[]"
                                                Folders="@(CatalogItem.ForAll(folders))"
                                                Constraints="constraints"
                                                OnRejected="@(r => { rejection = r; return Task.CompletedTask; })"
                                                OnFolderCreate="@(r => { created = r; return Task.CompletedTask; })" />);

            // Act
            await cut.Find(".forma-explorer-sidebar button[aria-label='New Folder']").ClickAsync(new());

            // Assert
            Assert.Null(created);
            Assert.NotNull(rejection);
            Assert.Equal(CatalogRejectionReason.FolderRootCount, rejection.Reason);
            Assert.Equal(1, rejection.Limit);
            Assert.Equal(rejection.Message, cut.Find(".forma-explorer-rejection-text").TextContent.Trim());
        }

        [Fact]
        public async Task Should_refuse_a_subfolder_beyond_the_subfolder_ceiling()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<FolderResourceInfo> folders =
            [
                new("races") { Name = "Races" },
                new("2026") { Name = "2026", Parent = "races" }
            ];
            var constraints = new CatalogConstraints { MaxSubfolderCount = 1 };
            CatalogRejection? rejection = null;

            var cut = ctx.Render(@<FormaExplorer Items="[]"
                                                Folders="@(CatalogItem.ForAll(folders))"
                                                Constraints="constraints"
                                                OnRejected="@(r => { rejection = r; return Task.CompletedTask; })" />);

            // Act
            await cut.Find("button[aria-label='Actions for Races']").ClickAsync(new());
            await cut.Find("[data-action='folder-create']").ClickAsync(new());

            // Assert
            Assert.NotNull(rejection);
            Assert.Equal(CatalogRejectionReason.SubfolderCount, rejection.Reason);
        }

        [Fact]
        public async Task Should_refuse_a_folder_nested_beyond_the_depth_ceiling()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<FolderResourceInfo> folders = [new("races") { Name = "Races" }];
            var constraints = new CatalogConstraints { MaxFolderDepth = 1 };
            CatalogRejection? rejection = null;

            var cut = ctx.Render(@<FormaExplorer Items="[]"
                                                Folders="@(CatalogItem.ForAll(folders))"
                                                Constraints="constraints"
                                                OnRejected="@(r => { rejection = r; return Task.CompletedTask; })" />);

            // Act
            await cut.Find("button[aria-label='Actions for Races']").ClickAsync(new());
            await cut.Find("[data-action='folder-create']").ClickAsync(new());

            // Assert
            Assert.NotNull(rejection);
            Assert.Equal(CatalogRejectionReason.FolderDepth, rejection.Reason);
        }

        [Fact]
        public void Should_announce_a_refusal_in_a_live_region()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();

            // Act
            var cut = ctx.Render(@<FormaExplorer Items="[]" />);

            // Assert
            Assert.Equal("alert", cut.Find(".forma-explorer-rejection-region").GetAttribute("role"));
        }
    }

    public sealed class Uploading
    {
        [Fact]
        public async Task Should_keep_the_upload_panel_open_on_a_file_the_store_refused()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var store = new FakeFileStore { Refusals = { ["big.jpg"] = new FileRefusal(FileRefusalReason.TooLarge, 4) } };
            IReadOnlyList<ResourceInfo>? uploaded = null;
            var cut = ctx.Render(@<FormaExplorer Items="[]"
                                                Store="store"
                                                ItemOptions="ExplorerItemOptions.Default"
                                                OnUploaded="@(resources => { uploaded = resources; return Task.CompletedTask; })" />);
            await cut.Find(".forma-explorer-upload-button").ClickAsync(new());

            // Act
            cut.FindComponent<InputFile>().UploadFiles(
                InputFileContent.CreateFromText("small", "cover.jpg", contentType: "image/jpeg"),
                InputFileContent.CreateFromText("far too long a body", "big.jpg", contentType: "image/jpeg"));

            // Assert
            Assert.Multiple(
                () => Assert.Equal(["cover.jpg"], store.Saved),
                () => Assert.Equal("/stored/cover.jpg", Assert.Single(uploaded!).Source),
                () => Assert.Equal("\"big.jpg\" is larger than 4 B.", cut.Find(".forma-explorer-upload-panel .forma-file-uploader-reason").TextContent));
        }

        [Fact]
        public async Task Should_close_the_upload_panel_once_every_file_is_stored()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var store = new FakeFileStore();
            var cut = ctx.Render(@<FormaExplorer Items="[]" Store="store" ItemOptions="ExplorerItemOptions.Default" />);
            await cut.Find(".forma-explorer-upload-button").ClickAsync(new());

            // Act
            cut.FindComponent<InputFile>().UploadFiles(InputFileContent.CreateFromText("small", "cover.jpg", contentType: "image/jpeg"));

            // Assert
            Assert.Multiple(
                () => Assert.Equal(["cover.jpg"], store.Saved),
                () => Assert.Empty(cut.FindAll(".forma-explorer-upload-panel")));
        }
    }

    public sealed class Browsing
