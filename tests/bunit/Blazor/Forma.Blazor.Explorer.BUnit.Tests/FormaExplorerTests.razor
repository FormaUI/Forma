        [Fact]
        public void Should_make_the_folder_tree_one_drop_zone_whose_targets_are_the_rows_that_take_a_drop()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            var zone = ctx.JSInterop.SetupModule("./_content/forma/browser/scripts/behaviors/DropZone.js");
            var folders = new List<ICatalogItem>
            {
                new CatalogFolderItem { Key = "races", Name = "Races", Capabilities = CatalogItemCapabilities.Open | CatalogItemCapabilities.Drop, Resource = new FolderResourceInfo("races") },
                new CatalogFolderItem { Key = "sealed", Name = "Sealed", Capabilities = CatalogItemCapabilities.Open, Resource = new FolderResourceInfo("sealed") }
            };

            // Act
            var cut = ctx.Render(@<FormaExplorer Items="[]" Folders="folders" />);

            // Assert
            var options = Assert.Single(zone.Invocations, invocation => invocation.Identifier == "attach").Arguments[1]!;
            var allMedia = GetFolderRow(cut, "All Media");
            var races = GetFolderRow(cut, "Races");
            var sealedFolder = GetFolderRow(cut, "Sealed");
            Assert.Multiple(
                () => Assert.Equal("explorer.drop", InteropPayload.GetValue(options, "action")),
                () => Assert.Equal("[data-drop-target]", InteropPayload.GetValue(options, "targets")),
                () => Assert.Equal("move", InteropPayload.GetValue(options, "dropEffect")),
                () => Assert.Equal("true", allMedia.GetAttribute("data-drop-target")),
                () => Assert.Null(allMedia.GetAttribute("data-drop-key")),
                () => Assert.Equal("races", races.GetAttribute("data-drop-key")),
                () => Assert.Equal("true", races.GetAttribute("data-drop-target")),
                () => Assert.Null(sealedFolder.GetAttribute("data-drop-target")));
        }

