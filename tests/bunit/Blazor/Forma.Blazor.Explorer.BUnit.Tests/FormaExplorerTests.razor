@code {
    // The card the thumbnails draw for the item under the name, wherever the location's folders, drawn before its files, put it.
    private static AngleSharp.Dom.IElement ItemNamed<TComponent>(Bunit.IRenderedComponent<TComponent> cut, string name)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => cut.FindAll(".forma-data-card").Single(card => card.QuerySelector(".forma-data-card-name")?.TextContent == name);

    // The names the thumbnails show, in order.
    private static List<string> GetItemNames<TComponent>(Bunit.IRenderedComponent<TComponent> cut)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => [.. cut.FindAll(".forma-data-card-name").Select(node => node.TextContent.Trim())];

    // The names the details' rows show, in order.
    private static List<string> GetDetailsNames<TComponent>(Bunit.IRenderedComponent<TComponent> cut)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => [.. cut.FindAll("tr.forma-data-grid-row .forma-explorer-details-name-text").Select(node => node.TextContent.Trim())];

    // The details' row showing the name.
    private static AngleSharp.Dom.IElement GetDetailsRow<TComponent>(Bunit.IRenderedComponent<TComponent> cut, string name)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => cut.FindAll("tr.forma-data-grid-row").Single(row => row.QuerySelector(".forma-explorer-details-name-text")?.TextContent.Trim() == name);

    // The box the selection mode draws on a card.
    private static AngleSharp.Dom.IElement GetBox(AngleSharp.Dom.IElement card)
        => card.QuerySelector("input[type=checkbox]")!;

    // Whether the box on a card is checked, the item selected.
    private static bool IsBoxChecked(AngleSharp.Dom.IElement card)
        => card.QuerySelector("input[type=checkbox]")?.HasAttribute("checked") == true;

    // Clicks the box on the card showing the name, which checks it or clears it once the click has ended.
    private static Task ToggleBoxAsync<TComponent>(Bunit.IRenderedComponent<TComponent> cut, string name)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => GetBox(ItemNamed(cut, name)).ClickAsync(new MouseEventArgs());

    // Presses the card showing the name, as the selection behavior reports a press by the token the card carries.
    private static Task PressCardAsync<TComponent>(Bunit.IRenderedComponent<TComponent> cut, string name)
        where TComponent : class, Microsoft.AspNetCore.Components.IComponent
    {
        var token = int.Parse(ItemNamed(cut, name).GetAttribute("data-item")!, CultureInfo.InvariantCulture);

        return cut.InvokeAsync(() => cut.FindComponent<FormaDataView<ICatalogItem>>().Instance.HandleActivateAsync(token));
    }

    // The sidebar's rows, the row standing for every item first.
    private static IReadOnlyList<AngleSharp.Dom.IElement> GetFolderRows<TComponent>(Bunit.IRenderedComponent<TComponent> cut)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => cut.FindAll(".forma-explorer-sidebar .forma-data-tree-node");

    // The names the sidebar's rows show, in order.
    private static List<string> GetFolderNames<TComponent>(Bunit.IRenderedComponent<TComponent> cut)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => [.. GetFolderRows(cut).Select(row => row.QuerySelector(".forma-data-tree-node-name")!.TextContent.Trim())];

    // The sidebar's row showing the name.
    private static AngleSharp.Dom.IElement GetFolderRow<TComponent>(Bunit.IRenderedComponent<TComponent> cut, string name)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => GetFolderRows(cut).Single(row => row.QuerySelector(".forma-data-tree-node-name")?.TextContent.Trim() == name);

    // Reports the focus outside the sidebar's tree, which routes no press until it knows where the focus is.
    private static Task ReportFocusAsync<TComponent>(DomProbe<FocusState> probe, Bunit.IRenderedComponent<TComponent> cut)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => probe.ReportAsync(cut.Find(".forma-explorer-sidebar .forma-data-tree").GetAttribute("data-rid")!, new FocusState(IsWithin: false));

    // Presses the sidebar's row showing the name, as the input router reports a press by the token the row carries.
    private static Task PressFolderAsync<TComponent>(InputRouterProbe router, Bunit.IRenderedComponent<TComponent> cut, string name)
        where TComponent : Microsoft.AspNetCore.Components.IComponent
        => router.RouteAsync("tree.choose", new InputPointerInfo { Type = "click", Item = GetFolderRow(cut, name).GetAttribute("data-tree-node") });

    /// <summary>Drops what is being dragged on the row, as the sidebar's drop zone tells it from the row's key.</summary>
    private static Task DropOnAsync<TComponent>(Bunit.IRenderedComponent<TComponent> cut, AngleSharp.Dom.IElement row)
        where TComponent : class, Microsoft.AspNetCore.Components.IComponent
        => cut.InvokeAsync(() => cut.FindComponent<FormaExplorerSidebar>().Instance.HandleDropAsync(row.GetAttribute("data-drop-key")));

    // Reads the headings and the items of each page in turn, the clock passing midnight once the first page is read.
    // Each press's own task says when its page has arrived, since a page asked for supersedes the one before it, whose cancellation resumes
    // off the renderer.
    private static async Task<List<List<string>>> ReadGroupedPagesAsync(IRenderedComponent<ContainerFragment> cut, FakeTimeProvider clock, int count)
    {
        List<List<string>> pages = [];

        for (var page = 0; page < count; page++)
        {
            pages.Add([.. cut.FindAll(".forma-data-group-heading, .forma-data-card img").Select(element => element.ClassList.Contains("forma-data-group-heading")
                ? $"{element.QuerySelector(".forma-data-group-name")!.TextContent} ({element.QuerySelector(".forma-data-group-count")!.TextContent})"
                : element.GetAttribute("src")!)]);

            if (page == 0)
            {
                clock.Advance(TimeSpan.FromHours(13));
            }

            if (page < count - 1)
            {
                await cut.Find(".forma-explorer-footer nav.forma-pagination .forma-pagination-navigation-input .forma-pagination-navigation-button-next").ClickAsync(new MouseEventArgs());
            }
        }

        return pages;
    }

    // Chooses a sort field from the sort menu, completing once the new slice is fetched.
    private static async Task SortByAsync<TComponent>(IRenderedComponent<TComponent> cut, CatalogSortField field)
        where TComponent : IComponent
    {
        await cut.Find(".forma-explorer-sort-trigger").ClickAsync(new());
        await cut.Find($"[data-sort-field='{field}']").ClickAsync(new());
    }

