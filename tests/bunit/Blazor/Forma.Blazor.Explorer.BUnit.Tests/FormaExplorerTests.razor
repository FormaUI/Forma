            using var ctx = new FormaExplorerTests();
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/photo-01.jpg"),
                new ImageResourceInfo("https://example.com/render-01.jpg")
            ];
            var constraints = new CatalogConstraints { AcceptedResourceKinds = "globs:photo-*.jpg" };

            // Act
            var cut = ctx.Render(@<FormaExplorer Items="@(CatalogItem.ForAll(resources))" Constraints="constraints" />);

            // Assert
            var names = GetItemNames(cut);
