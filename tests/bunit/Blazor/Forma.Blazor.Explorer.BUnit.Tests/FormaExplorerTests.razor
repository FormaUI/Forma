            Assert.Multiple(
                () => Assert.Equal(["race.jpg"], GetItemNames(cut)),
                () => Assert.Equal("false", cut.Find(".forma-explorer-scroll").GetAttribute("aria-busy")));
        }

        [Fact]
        public async Task Should_go_without_an_error_when_taken_away_while_its_store_still_answers()
        {
            // Arrange - taken away while its store, which answers even once canceled, holds the first answer
            using var ctx = new FormaExplorerTests();
            var provider = new FakeCatalogProvider([new ImageResourceInfo("https://example.com/a.jpg")]) { Gate = new TaskCompletionSource(), IgnoresCancellation = true };
            var cut = ctx.Render(@<FormaExplorer ItemsProvider="provider" />);
            await ctx.DisposeComponentsAsync();

            // Act
            await OpenGateAsync(cut, provider);

            // Assert
            Assert.Multiple(
                () => Assert.Single(provider.Queries),
                () => Assert.False(ctx.Renderer.UnhandledException.IsCompleted));
        }

        // Opens the store's gate off the renderer, as the explorer's provider resumes off it, so the answer is queued on the renderer by
        // the time the gate is open, and passes a turn on the renderer, which draws it.
        private static async Task OpenGateAsync<TComponent>(Bunit.IRenderedComponent<TComponent> cut, FakeCatalogProvider provider)
            where TComponent : Microsoft.AspNetCore.Components.IComponent
        {
            await Task.Run(provider.Gate!.SetResult, TestContext.Current.CancellationToken);
            await cut.InvokeAsync(static () => { });
        }
    }

