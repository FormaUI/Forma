        [Fact]
        public void Should_list_only_the_resources_the_content_type_pattern_admits()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/cover.jpg") { ContentType = "image/jpeg" },
                new VideoResourceInfo("https://example.com/clip.mp4") { ContentType = "video/mp4" },
                new DocumentResourceInfo("https://example.com/notes.pdf") { ContentType = "application/pdf" }
