                                                PageSize="2"
                                                Options="@(new ExplorerOptions { InfiniteScroll = ExplorerInfiniteScrollMode.Manual })" />);
            cut.WaitForState(() => cut.FindAll(".forma-data-card").Count == 2);
            provider.Gate = new TaskCompletionSource();

            // Act - a second press lands while the first page is still on its way
            var first = cut.Find(".forma-data-view-more button").ClickAsync(new MouseEventArgs());
            var second = cut.Find(".forma-data-view-more button").ClickAsync(new MouseEventArgs());
