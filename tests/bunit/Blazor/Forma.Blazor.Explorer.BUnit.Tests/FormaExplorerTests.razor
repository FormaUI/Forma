    // A picker keeps its choices as the reader moves between folders, offers them for review from its count, each with where it
    // stands, and offers the current folder where it can be chosen.
    public sealed class Reviewing
    {
        private static readonly IReadOnlyList<ICatalogItem> TwoFolders =
            CatalogItem.ForAll([new FolderResourceInfo("covers") { Name = "Covers" }, new FolderResourceInfo("races") { Name = "Races" }]);

        private static FakeCatalogProvider CreateProvider()
        {
            var provider = new FakeCatalogProvider([]);
            provider.FolderResources["covers"] = [new ImageResourceInfo("https://example.com/front.jpg")];
            provider.FolderResources["races"] = [new ImageResourceInfo("https://example.com/sprint.jpg")];

            return provider;
        }

        // Presses the card showing the name while the boxes are drawn, as the selection behavior reports a checking press.
        private static Task CheckCardAsync<TComponent>(IRenderedComponent<TComponent> cut, string name)
            where TComponent : class, Microsoft.AspNetCore.Components.IComponent
        {
            var token = int.Parse(ItemNamed(cut, name).GetAttribute("data-item")!, CultureInfo.InvariantCulture);

            return cut.InvokeAsync(() => cut.FindComponent<FormaDataView<ICatalogItem>>().Instance.HandleCheckAsync(token));
        }

        private static Task GoUpAsync<TComponent>(IRenderedComponent<TComponent> cut)
            where TComponent : class, Microsoft.AspNetCore.Components.IComponent
            => cut.InvokeAsync(() => ((IExplorerLocationInteraction)cut.FindComponent<FormaExplorer>().Instance).GoUpAsync());

        // Chooses front.jpg in Covers and sprint.jpg in Races, entering each folder from the top level.
        private static async Task ChooseInTwoFoldersAsync<TComponent>(IRenderedComponent<TComponent> cut)
            where TComponent : class, Microsoft.AspNetCore.Components.IComponent
        {
            await PressCardAsync(cut, "Covers");
            await CheckCardAsync(cut, "front.jpg");
            await GoUpAsync(cut);
            await PressCardAsync(cut, "Races");
            await CheckCardAsync(cut, "sprint.jpg");
        }

        private static IReadOnlyList<string> GetReviewedChoices<TComponent>(IRenderedComponent<TComponent> cut)
            where TComponent : Microsoft.AspNetCore.Components.IComponent
            => [.. cut.FindAll(".forma-explorer-review-item").Select(item => string.Join(" in ", item.QuerySelectorAll(".forma-explorer-review-name, .forma-explorer-review-location").Select(part => part.TextContent.Trim())))];

        [Fact]
        public async Task Should_keep_a_picker_s_choices_as_the_reader_moves_between_folders()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            List<IReadOnlyList<ICatalogItem>> reports = [];
            var cut = ctx.Render(@<FormaExplorer ItemsProvider="CreateProvider()"
                                                Folders="TwoFolders"
                                                Options="@(new ExplorerOptions { SelectOnOpen = true })"
                                                SelectedItemsChanged="@(items => { reports.Add(items); return Task.CompletedTask; })" />);

            // Act
            await ChooseInTwoFoldersAsync(cut);

            // Assert
            Assert.Equal(["front.jpg", "sprint.jpg"], reports[^1].Select(item => item.Name).Order());
        }

        [Fact]
        public async Task Should_clear_the_selection_on_a_move_where_the_explorer_is_not_a_picker()
        {
