        [Fact]
        public void Should_switch_view_modes_between_thumbnails_details_and_list()
        {
            // Arrange
            using var ctx = new FormaExplorerTests();
            IReadOnlyList<ResourceInfo> resources =
            [
                new ImageResourceInfo("https://example.com/cover.jpg") { Size = 1024 }
            ];
