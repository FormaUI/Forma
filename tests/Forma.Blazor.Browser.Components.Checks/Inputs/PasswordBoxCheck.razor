@page "/{Runtime}/password-box"

@* A password box bound in a form, with the toggle that reveals it, its value shown where the check reads it. *@
<EditForm Model="_model">
    <FormaPasswordBox Id="check" Label="Password" @bind-Value="_model.Password" />
</EditForm>
<output id="result">@_model.Password</output>

@code {
    private readonly Entry _model = new();

    [Parameter] public string Runtime { get; set; } = default!;

    private sealed class Entry
    {
        public string? Password { get; set; }
    }
}
