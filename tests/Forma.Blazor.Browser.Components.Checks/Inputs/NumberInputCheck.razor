@page "/{Runtime}/number-input"

@* A number input bound to a whole number in a form, its number shown where the check reads it. *@
<EditForm Model="_model">
    <FormaNumberInput TValue="int" Id="check" Label="Quantity" @bind-Value="_model.Quantity" />
</EditForm>
<output id="result">@_model.Quantity.ToString(CultureInfo.InvariantCulture)</output>

@code {
    private readonly Entry _model = new();

    [Parameter] public string Runtime { get; set; } = default!;

    private sealed class Entry
    {
        public int Quantity { get; set; }
    }
}
