@page "/{Runtime}/icon"
@using Forma.Framework.Icons

@* A glyph a button swaps for another, the glyph shown where the check reads it, beside a brand mark named by its title. *@
<FormaIcon Id="glyph" Icon="_glyph" Size="IconSize.Large" />
<FormaIcon Id="brand" Icon="Brand.GitHub" Size="IconSize.Large" />
<FormaButton Id="swap" OnClick="@(() => _glyph = Glyph.Star)">Swap</FormaButton>
<output id="result">@_glyph</output>

@code {
    private Glyph _glyph = Glyph.Search;

    [Parameter] public string Runtime { get; set; } = default!;
}
