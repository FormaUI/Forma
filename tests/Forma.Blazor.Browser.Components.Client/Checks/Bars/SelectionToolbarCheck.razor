@page "/{Runtime}/selection-toolbar"
@using Forma.Framework.Toolbar

@* A selection toolbar captioning the count a button selects, which its clear button empties. *@
<FormaSelectionToolbar Id="selection-toolbar" Count="_count" Label="Selection" Items="Items" OnClear="@(() => _count = 0)" />
<FormaButton Id="select" OnClick="@(() => _count++)">Select</FormaButton>
<output id="result">@_count</output>

@code {
    private static readonly IReadOnlyList<ToolbarItem> Items = [new ToolbarCommand { Id = "delete", Title = "Delete", Command = "delete" }];

    private int _count;

    [Parameter] public string Runtime { get; set; } = default!;
}
