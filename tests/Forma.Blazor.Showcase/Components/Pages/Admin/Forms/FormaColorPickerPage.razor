@page "/color-picker"
@attribute [ShowcasePage("FormaColorPicker")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Forma.Blazor.Components.Admin.Forms
@inject IStringLocalizer<FormaColorPickerPage> L

<h1>FormaColorPicker</h1>
<p class="desc">@L["Color.Description"]</p>

<EditForm Model="Model" FormName="color-demo" OnValidSubmit="HandleSubmit">
    <div class="demo-section">
        <h2>@L["Color.Section.Basic"]</h2>
        <div class="demo-box">
            <FormaColorPicker @bind-Value="Model.Primary" />
            <FormaColorPicker @bind-Value="Model.Secondary" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Color.Section.WithLabel"]</h2>
        <div class="demo-box">
            <FormaColorPicker @bind-Value="Model.Background"
                            Label="@L["Color.Label.Background"]" />
            <FormaColorPicker @bind-Value="Model.Accent"
                            Label="@L["Color.Label.Accent"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Color.Section.WithAlpha"]</h2>
        <div class="demo-box">
            <FormaColorPicker @bind-Value="Model.Overlay"
                            Label="@L["Color.Label.Overlay"]"
                            ShowAlpha="true" />
        </div>
    </div>
</EditForm>

@code {
    private ColorDemoModel Model { get; set; } = new();

    private void HandleSubmit() { }

    private sealed class ColorDemoModel
    {
        public string Primary { get; set; } = "#0d6efd";
        public string Secondary { get; set; } = "#6c757d";
        public string Background { get; set; } = "#ffffff";
        public string Accent { get; set; } = "#198754";
        public string Overlay { get; set; } = "#000000CC";
    }
}
