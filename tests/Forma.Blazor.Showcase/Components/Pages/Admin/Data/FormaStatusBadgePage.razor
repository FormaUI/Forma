@page "/status-badge"
@attribute [ShowcasePage("FormaStatusBadge")]
@using Forma.Blazor.Components.Admin.Data
@using Forma.Web.Css

<h1>FormaStatusBadge</h1>
<p class="desc">@L["StatusBadge.Description"]</p>

<div class="demo-section">
    <h2>@L["StatusBadge.Section.AppDefined"]</h2>
    <p class="desc">@L["StatusBadge.AppDefined.Note"]</p>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <FormaStatusBadge Text="@L["StatusBadge.Publish.Draft"]" Status="draft" />
        <FormaStatusBadge Text="@L["StatusBadge.Publish.Scheduled"]" Status="scheduled" />
        <FormaStatusBadge Text="@L["StatusBadge.Publish.Published"]" Status="published" />
        <FormaStatusBadge Text="@L["StatusBadge.Moderation.Pending"]" Status="pending" />
        <FormaStatusBadge Text="@L["StatusBadge.Moderation.Rejected"]" Status="rejected" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["StatusBadge.Section.OtherVocabulary"]</h2>
    <p class="desc">@L["StatusBadge.OtherVocabulary.Note"]</p>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        @foreach (var status in OrderStatuses)
        {
            <FormaStatusBadge Text="@status.Label" Status="@status.Name" />
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["StatusBadge.Section.Explicit"]</h2>
    <p class="desc">@L["StatusBadge.Explicit.Note"]</p>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <FormaStatusBadge Text="@L["StatusBadge.Custom.Shipped"]"
                          Background="CssColor.FromRgba(111, 66, 193, 0.14)" Foreground="CssColor.FromHex(0x59359a)" />
        <FormaStatusBadge Text="@L["StatusBadge.Custom.Refunded"]"
                          Background="CssColor.FromRgba(13, 110, 253, 0.14)" Foreground="CssColor.FromHex(0x0a58ca)" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["StatusBadge.Section.Unstyled"]</h2>
    <p class="desc">@L["StatusBadge.Unstyled.Note"]</p>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <FormaStatusBadge Text="@L["StatusBadge.Unstyled.Unknown"]" Status="never-registered" />
        <FormaStatusBadge Text="@L["StatusBadge.Unstyled.Plain"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["StatusBadge.Section.InTable"]</h2>
    <div class="demo-box">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="text-align: start; padding: 6px;">@L["StatusBadge.Table.Article"]</th>
                    <th style="text-align: start; padding: 6px;">@L["StatusBadge.Table.Status"]</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="padding: 6px;">@L["StatusBadge.Table.Row1"]</td>
                    <td style="padding: 6px;"><FormaStatusBadge Text="@L["StatusBadge.Publish.Published"]" Status="published" /></td>
                </tr>
                <tr>
                    <td style="padding: 6px;">@L["StatusBadge.Table.Row2"]</td>
                    <td style="padding: 6px;"><FormaStatusBadge Text="@L["StatusBadge.Publish.Scheduled"]" Status="scheduled" /></td>
                </tr>
                <tr>
                    <td style="padding: 6px;">@L["StatusBadge.Table.Row3"]</td>
                    <td style="padding: 6px;"><FormaStatusBadge Text="@L["StatusBadge.Publish.Draft"]" Status="draft" /></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["StatusBadge.Section.LongText"]</h2>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <FormaStatusBadge Text="@L["StatusBadge.Long.AwaitingReview"]" Status="pending" />
    </div>
</div>
