  <data name="Page.Description" xml:space="preserve">
    <value>Una tabla paginada y ordenable sobre un conjunto de elementos consultables, construida sobre QuickGrid.</value>
  </data>
  <data name="Section.Basic" xml:space="preserve">
    <value>Tabla básica</value>
  </data>
  <data name="Section.Checkboxes" xml:space="preserve">
    <value>Casillas de selección múltiple</value>
  </data>
  <data name="Checkboxes.Note" xml:space="preserve">
    <value>{0} fila(s) seleccionada(s).</value>
  </data>
  <data name="Section.RowSelection" xml:space="preserve">
    <value>Selección de fila</value>
  </data>
  <data name="RowSelection.Note" xml:space="preserve">
    <value>Clic en una fila para seleccionar solo esa; Ctrl/Cmd-clic para alternar una fila; Shift-clic o Shift con flechas para seleccionar un rango.</value>
  </data>
  <data name="Section.Limits" xml:space="preserve">
    <value>Límites de selección y leyendas</value>
  </data>
  <data name="Limits.Note" xml:space="preserve">
    <value>Como máximo 3 filas; el control maestro es una leyenda de texto en lugar de una casilla.</value>
  </data>
  <data name="Limits.SelectAll" xml:space="preserve">
    <value>Seleccionar todo</value>
  </data>
  <data name="Limits.DeselectAll" xml:space="preserve">
    <value>Deseleccionar todo</value>
  </data>
  <data name="Section.RowClick" xml:space="preserve">
    <value>Clic en la fila</value>
  </data>
  <data name="RowClick.Note" xml:space="preserve">
    <value>Última seleccionada: {0}</value>
  </data>
  <data name="RowClick.None" xml:space="preserve">
    <value>ninguna</value>
  </data>
  <data name="Section.CustomColumn" xml:space="preserve">
    <value>Celdas personalizadas y estilo de fila</value>
  </data>
  <data name="CustomColumn.Note" xml:space="preserve">
    <value>Una TemplateColumn muestra un FormaStatusBadge por fila; RowClass atenúa las filas inactivas.</value>
  </data>
  <data name="Column.Status" xml:space="preserve">
    <value>Estado</value>
  </data>
  <data name="Status.Active" xml:space="preserve">
