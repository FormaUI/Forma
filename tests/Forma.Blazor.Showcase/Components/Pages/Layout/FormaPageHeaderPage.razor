@page "/page-header"
@attribute [ShowcasePage("FormaPageHeader")]
@using Forma.Blazor.Components.Layout
@inject IStringLocalizer<FormaPageHeaderPage> L

<h1>FormaPageHeader</h1>
<p class="desc">@L["Page header with title, breadcrumb navigation, and optional action slot."]</p>

<div class="demo-section">
    <h2>@L["Basic with Breadcrumbs"]</h2>
    <div class="demo-box">
        <FormaPageHeader Title="@L["Orders"]"
                       Breadcrumbs="BasicBreadcrumbs" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Title Only"]</h2>
    <div class="demo-box">
        <FormaPageHeader Title="@L["Dashboard"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["With Action Buttons"]</h2>
    <div class="demo-box">
        <FormaPageHeader Title="@L["Products"]"
                       Breadcrumbs="ProductsBreadcrumbs">
            <Actions>
                <button class="btn btn-primary">@L["Add New"]</button>
                <button class="btn btn-sec">@L["Export"]</button>
            </Actions>
        </FormaPageHeader>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Deep Breadcrumb Trail"]</h2>
    <div class="demo-box">
        <FormaPageHeader Title="@L["Edit Product"]"
                       Breadcrumbs="DeepBreadcrumbs" />
    </div>
</div>

@code {
    private BreadcrumbItem[] BasicBreadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Store"]),
        new(L["Orders"])
    ];

    private BreadcrumbItem[] ProductsBreadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Store"]),
        new(L["Products"])
    ];

    private BreadcrumbItem[] DeepBreadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Store"]),
        new(L["Products"], "/products"),
        new(L["Edit Product"])
    ];
}
