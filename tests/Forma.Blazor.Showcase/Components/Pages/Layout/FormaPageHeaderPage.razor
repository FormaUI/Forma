@page "/page-header"
@attribute [ShowcasePage("FormaPageHeader")]
@using Forma.Blazor.Components.Layout
@inject IStringLocalizer<FormaPageHeaderPage> L

<h1>FormaPageHeader</h1>
<p class="desc">@L["PageHeader.Description"]</p>

<div class="demo-section">
    <h2>@L["PageHeader.Section.Basic"]</h2>
    <div class="demo-box">
        <FormaPageHeader Title="@L["PageHeader.Demo.Title.Orders"]"
                       Breadcrumbs="BasicBreadcrumbs" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["PageHeader.Section.TitleOnly"]</h2>
    <div class="demo-box">
        <FormaPageHeader Title="@L["PageHeader.Demo.Title.Dashboard"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["PageHeader.Section.WithActions"]</h2>
    <div class="demo-box">
        <FormaPageHeader Title="@L["PageHeader.Demo.Title.Products"]"
                       Breadcrumbs="ProductsBreadcrumbs">
            <Actions>
                <button class="btn btn-primary">@L["PageHeader.Demo.Button.AddNew"]</button>
                <button class="btn btn-sec">@L["PageHeader.Demo.Button.Export"]</button>
            </Actions>
        </FormaPageHeader>
    </div>
</div>

<div class="demo-section">
    <h2>@L["PageHeader.Section.DeepBreadcrumb"]</h2>
    <div class="demo-box">
        <FormaPageHeader Title="@L["PageHeader.Demo.Title.EditProduct"]"
                       Breadcrumbs="DeepBreadcrumbs" />
    </div>
</div>

@code {
    private BreadcrumbItem[] BasicBreadcrumbs =>
    [
        new(L["PageHeader.Crumb.Home"], "/"),
        new(L["PageHeader.Crumb.Store"]),
        new(L["PageHeader.Crumb.Orders"])
    ];

    private BreadcrumbItem[] ProductsBreadcrumbs =>
    [
        new(L["PageHeader.Crumb.Home"], "/"),
        new(L["PageHeader.Crumb.Store"]),
        new(L["PageHeader.Crumb.Products"])
    ];

    private BreadcrumbItem[] DeepBreadcrumbs =>
    [
        new(L["PageHeader.Crumb.Home"], "/"),
        new(L["PageHeader.Crumb.Store"]),
        new(L["PageHeader.Crumb.Products"], "/products"),
        new(L["PageHeader.Crumb.EditProduct"])
    ];
}
