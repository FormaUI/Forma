@page "/modal"
@attribute [ShowcasePage("FormaModal")]
@rendermode InteractiveServer
@inject IStringLocalizer<FormaModalPage> L

<h1>FormaModal</h1>
<p class="desc">@L["Modal dialog using native <dialog> element. Provides backdrop, focus trap, Escape key, and scoped CSS animations."]</p>

<div class="demo-section">
    <h2>@L["Basic Modal"]</h2>
    <div class="demo-box">
        <button class="btn btn-primary" @onclick="() => _showBasic = true">@L["Open Basic Modal"]</button>
        <FormaModal Opened="_showBasic" OnClose="() => _showBasic = false" Title="@L["Basic Modal"]">
            <Body>
                <p>@L["This is a basic modal with a title and child content."]</p>
            </Body>
        </FormaModal>
    </div>
</div>

<div class="demo-section">
    <h2>@L["No Header (Title = null)"]</h2>
    <div class="demo-box">
        <button class="btn btn-primary" @onclick="() => _showNoHeader = true">@L["Open Headerless Modal"]</button>
        <FormaModal Opened="_showNoHeader" OnClose="() => _showNoHeader = false" Options="HideConfirmAction">
            <Body>
                <p>@L["This modal has no header - useful for simple alerts or custom layouts."]</p>
            </Body>
        </FormaModal>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Size Variants"]</h2>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        @foreach (var size in _sizes)
        {
            var s = size;
            <button class="btn btn-sec" @onclick="() => _activeSize = s">@s</button>
        }
        @if (_activeSize is not null)
        {
            <FormaModal Opened="true" OnClose="() => _activeSize = null" Title="@($"Size: {_activeSize}")" Size="@_activeSize.Value"
                      Options="HideConfirmAction">
                <Body>
                    <p>@L["This modal uses"] <code>Size="@_activeSize"</code>.</p>
                </Body>
            </FormaModal>
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Custom Footer"]</h2>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <button class="btn btn-sec" @onclick="() => _showFooterOnly = true">@L["Open Footer Only"]</button>
        <button class="btn btn-primary" @onclick="() => _showFooterWithActions = true">@L["Open Footer + Actions"]</button>

        <FormaModal Opened="_showFooterOnly" OnClose="() => _showFooterOnly = false" Title="@L["Footer Only"]"
                  Options="HideFooterActions">
            <Body>
                <p>@L["This example shows footer content only, without default actions."]</p>
            </Body>
            <Footer>
                <span style="color: var(--text-muted-color);">@L["Last updated: just now"]</span>
            </Footer>
        </FormaModal>

        <FormaModal Opened="_showFooterWithActions" OnClose="() => _showFooterWithActions = false" Title="@L["Footer + Actions"]">
            <Body>
                <p>@L["This example shows both custom footer content and default actions."]</p>
            </Body>
            <Footer>
                <span style="color: var(--text-muted-color);">@L["Tip: you can place any custom content here"]</span>
            </Footer>
        </FormaModal>
    </div>
</div>

<div class="demo-section">
    <h2>@L["No Footer"]</h2>
    <div class="demo-box">
        <button class="btn btn-primary" @onclick="() => _showNoFooter = true">@L["Open (no footer)"]</button>
        <FormaModal Opened="_showNoFooter" OnClose="() => _showNoFooter = false" Title="@L["Information"]">
            <Body>
                <p>@L["This modal has no footer - close it with Escape, backdrop click, or the X button."]</p>
            </Body>
        </FormaModal>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Backdrop Click Disabled"]</h2>
    <div class="demo-box">
        <button class="btn btn-primary" @onclick="() => _showNoBackdrop = true">@L["Open (no backdrop close)"]</button>
        <FormaModal Opened="_showNoBackdrop" OnClose="() => _showNoBackdrop = false"
                    Title="@L["Must Use X or Button"]" Options="RequireExplicitClose">
            <Body>
                <p>@L["Clicking the backdrop does not close this modal. Use the X button or the button below."]</p>
            </Body>
        </FormaModal>
    </div>
</div>

@code {
    private static readonly FormaModalOptions HideConfirmAction =
        new() { ShowConfirmAction = false };

    private static readonly FormaModalOptions HideFooterActions =
        new() { ShowCancelAction = false, ShowConfirmAction = false };

    private static readonly FormaModalOptions RequireExplicitClose =
        new() { CloseOnBackdropClick = false, ShowConfirmAction = false };

    private bool _showBasic;
    private bool _showNoHeader;
    private bool _showNoFooter;
    private bool _showNoBackdrop;
    private bool _showFooterOnly;
    private bool _showFooterWithActions;
    private ModalSize? _activeSize;

    private static readonly ModalSize[] _sizes = [ModalSize.Small, ModalSize.Medium, ModalSize.Large, ModalSize.ExtraLarge, ModalSize.Full];
}
