@page "/confirm-dialog"
@attribute [ShowcasePage("FormaConfirmDialog")]
@rendermode InteractiveServer
@using Forma.Blazor.Abstractions.Components.Feedback
@inject IConfirmDialogService ConfirmService
@inject IStringLocalizer<FormaConfirmDialogPage> L

<h1>FormaConfirmDialog</h1>
<p class="desc">@L["Confirmation dialog built on FormaModal. Uses IConfirmDialogService to show async confirm/cancel prompts from anywhere."]</p>

<div class="demo-section">
    <h2>@L["Basic Confirmation"]</h2>
    <div class="demo-box">
        <button class="btn btn-primary" @onclick="HandleBasicConfirm">@L["Delete Item"]</button>
        @if (_basicResult is not null)
        {
            <p style="margin-top: 12px; color: var(--text-muted-color);">@L["Result:"] <strong>@(_basicResult.Value ? L["Confirmed"] : L["Cancelled"])</strong></p>
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Custom Button Labels"]</h2>
    <div class="demo-box">
        <button class="btn btn-sec" @onclick="HandleCustomConfirm">@L["Discard Changes"]</button>
        @if (_customResult is not null)
        {
            <p style="margin-top: 12px; color: var(--text-muted-color);">@L["Result:"] <strong>@(_customResult.Value ? L["Discarded"] : L["Kept"])</strong></p>
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Cascading Confirmations"]</h2>
    <div class="demo-box">
        <button class="btn btn-primary" @onclick="HandleCascadeConfirm">@L["Delete Account"]</button>
        @if (_cascadeResult is not null)
        {
            <p style="margin-top: 12px; color: var(--text-muted-color);">@L["Result:"] <strong>@_cascadeResult</strong></p>
        }
    </div>
</div>

<FormaConfirmDialog />

@code {
    private bool? _basicResult;
    private bool? _customResult;
    private string? _cascadeResult;

    private async Task HandleBasicConfirm()
    {
        _basicResult = null;
        _basicResult = await ConfirmService.ConfirmAsync(
            L["Are you sure you want to delete this item?"],
            L["Confirm"],
            L["Cancel"]);
    }

    private async Task HandleCustomConfirm()
    {
        _customResult = null;
        _customResult = await ConfirmService.ConfirmAsync(
            L["You have unsaved changes. Discard them?"],
            confirmText: L["Discard Changes"],
            cancelText: L["Keep Editing"]);
    }

    private async Task HandleCascadeConfirm()
    {
        _cascadeResult = null;

        var first = await ConfirmService.ConfirmAsync(
            L["Are you sure you want to delete the account?"],
            L["Confirm"],
            L["Cancel"]);
        if (!first)
        {
            _cascadeResult = L["Cancelled at first step"];
            return;
        }

        var second = await ConfirmService.ConfirmAsync(
            L["This action is irreversible. Continue?"],
            L["Yes, Delete"],
            L["No"]);
        _cascadeResult = second
            ? L["Account deleted"]
            : L["Cancelled at second step"];
    }
}
