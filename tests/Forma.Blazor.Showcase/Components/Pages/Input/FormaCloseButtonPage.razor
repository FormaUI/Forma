@page "/close-button"
@attribute [ShowcasePage("FormaCloseButton")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Input
@inject IStringLocalizer<FormaCloseButtonPage> L

<h1>FormaCloseButton</h1>
<p class="desc">@L["CloseButton.Description"]</p>

<div class="demo-section">
    <h2>@L["CloseButton.Section.Sizes"]</h2>
    <div class="demo-box">
        <div class="demo-row">
            <FormaCloseButton Label="@L["CloseButton.Label.Close"]" OnClick="() => _clicks++" />
            <FormaCloseButton Label="@L["CloseButton.Label.Close"]" Size="ButtonSize.Mini" OnClick="() => _clicks++" />
        </div>
        <p class="demo-output">@L["CloseButton.Clicks"]: <code>@_clicks</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["CloseButton.Section.Disabled"]</h2>
    <div class="demo-box">
        <FormaCloseButton Label="@L["CloseButton.Label.Close"]" Disabled="true" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["CloseButton.Section.OnColour"]</h2>
    <p class="desc">@L["CloseButton.OnColour.Note"]</p>
    <div class="demo-box">
        <div class="demo-tinted">
            <span>@L["CloseButton.OnColour.Message"]</span>
            <FormaCloseButton Label="@L["CloseButton.Label.Dismiss"]" Size="ButtonSize.Mini" />
        </div>
    </div>
</div>

@code {
    private int _clicks;
}
