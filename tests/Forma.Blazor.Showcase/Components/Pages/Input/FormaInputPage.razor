@page "/input"
@attribute [ShowcasePage("FormaInput")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Forma.Blazor.Components.Input
@inject IStringLocalizer<FormaInputPage> L

<h1>FormaInput</h1>
<p class="desc">@L["Text input with a floating label that animates above the field on focus or when a value is present. Supports validation, required indicator, and autofill detection."]</p>

<EditForm Model="Model" FormName="field-demo" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="demo-section">
        <h2>@L["Basic Fields"]</h2>
        <div class="demo-box">
            <FormaInput Label="@L["Full Name"]" @bind-Value="Model.FullName" />
            <FormaInput Label="@L["Email Address"]" @bind-Value="Model.Email" Type="email" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Required Fields"]</h2>
        <div class="demo-box">
            <FormaInput Label="@L["Username"]" @bind-Value="Model.Username" Required="true" />
            <FormaInput Label="@L["Phone Number"]" @bind-Value="Model.Phone" Type="tel" Required="true" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Input Types"]</h2>
        <div class="demo-box">
            <FormaInput Label="@L["Website URL"]" @bind-Value="Model.Website" Type="url" />
            <FormaInput Label="@L["Search"]" @bind-Value="Model.Search" Type="search" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Pre-filled Value"]</h2>
        <div class="demo-box">
            <FormaInput Label="@L["Company Name"]" @bind-Value="Model.Company" />
        </div>
    </div>
</EditForm>

@code {
    private FieldDemoModel Model { get; set; } = new()
    {
        Company = "Acme Corp"
    };

    private void HandleSubmit() { }

    private sealed class FieldDemoModel
    {
        public string? FullName { get; set; }
        public string? Email { get; set; }
        public string? Username { get; set; }
        public string? Phone { get; set; }
        public string? Website { get; set; }
        public string? Search { get; set; }
        public string? Company { get; set; }
    }
}
