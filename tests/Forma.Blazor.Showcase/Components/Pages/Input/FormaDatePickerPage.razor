@page "/date-picker"
@attribute [ShowcasePage("FormaDatePicker")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Input
@inject IStringLocalizer<FormaDatePickerPage> L

<h1>FormaDatePicker</h1>
<p class="desc">@L["A custom calendar date picker with dual-month view, date range selection with presets, locale-aware month and day names, and RTL support. Supports single-date and range modes. Replaces the legacy jQuery datepick / Easepick library."]</p>

<div class="demo-section">
    <h2>@L["Basic (Single Date)"]</h2>
    <div class="demo-box">
        <FormaDatePicker @bind-Value="_singleDate" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["With Label"]</h2>
    <div class="demo-box">
        <FormaDatePicker @bind-Value="_labelDate"
                       Label="@L["Start Date"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Dual View (Two Months)"]</h2>
    <div class="demo-box">
        <FormaDatePicker @bind-StartDate="_dualStart"
                       @bind-EndDate="_dualEnd"
                       Label="@L["Pick a Date"]"
                       ShowPresets="false" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Date Range with Presets"]</h2>
    <div class="demo-box">
        <FormaDatePicker @bind-StartDate="_rangeStart"
                       @bind-EndDate="_rangeEnd"
                       Label="@L["Select Range"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["With Minimum Date"]</h2>
    <div class="demo-box">
        <FormaDatePicker @bind-Value="_futureDate"
                       Label="@L["Future Date Only"]"
                       MinDate="@DateOnly.FromDateTime(DateTime.Today)" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Pre-filled"]</h2>
    <div class="demo-box">
        <FormaDatePicker @bind-Value="_preFilled"
                       Label="@L["Today"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Hebrew Calendar"]</h2>
    <p class="desc">@L["The component adapts to the calendar system of the given culture. This demo uses he-IL with UseNonGregorianMonths to render the Hebrew (lunisolar) calendar with its month names."]</p>
    <div class="demo-box">
        <FormaDatePicker @bind-StartDate="_hebrewStart"
                       @bind-EndDate="_hebrewEnd"
                       Label="@L["Hebrew Date Range"]"
                       UseNonGregorianMonths="true" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Inside a scrolling container"]</h2>
    <p class="desc">@L["The box below scrolls and would clip an ordinary popup. The calendar opens in the top layer instead, so it stays whole, and it follows the trigger as the box scrolls."]</p>
    <div class="demo-box demo-scroll-box">
        <p>@L["Scroll this box to move the field around."]</p>
        <FormaDatePicker @bind-Value="_scrollableDate"
                       Label="@L["Date in a scroll box"]" />
        <p>@L["Scroll this box to move the field around."]</p>
    </div>
</div>

@code {
    private DateOnly? _singleDate;
    private DateOnly? _labelDate;
    private DateOnly? _dualStart;
    private DateOnly? _dualEnd;
    private DateOnly? _rangeStart;
    private DateOnly? _rangeEnd;
    private DateOnly? _futureDate;
    private DateOnly? _preFilled = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _hebrewStart;
    private DateOnly? _hebrewEnd;
    private DateOnly? _scrollableDate;
}
