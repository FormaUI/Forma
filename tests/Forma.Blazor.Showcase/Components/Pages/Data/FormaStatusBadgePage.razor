@page "/status-badge"
@attribute [ShowcasePage("FormaStatusBadge")]
@using Forma.Blazor.Components.Data
@using Forma.Web.Css

<h1>FormaStatusBadge</h1>
<p class="desc">@L["Pill-shaped status label. The application defines its own statuses and colours; the library ships none."]</p>

<div class="demo-section">
    <h2>@L["Application statuses"]</h2>
    <p class="desc">@L["Registered once at startup, then referenced by name."]</p>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <FormaStatusBadge Text="@L["Draft"]" Status="draft" />
        <FormaStatusBadge Text="@L["Scheduled"]" Status="scheduled" />
        <FormaStatusBadge Text="@L["Published"]" Status="published" />
        <FormaStatusBadge Text="@L["Pending"]" Status="pending" />
        <FormaStatusBadge Text="@L["Rejected"]" Status="rejected" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["A second vocabulary"]</h2>
    <p class="desc">@L["The same component with an unrelated set of statuses, registered by the page itself."]</p>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        @foreach (var status in OrderStatuses)
        {
            <FormaStatusBadge Text="@status.Label" Status="@status.Name" />
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Colours without a status"]</h2>
    <p class="desc">@L["One-off badges can pass colours directly instead of registering a status."]</p>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <FormaStatusBadge Text="@L["Shipped"]"
                          Background="CssColor.FromRgba(111, 66, 193, 0.14)" Foreground="CssColor.FromHex(0x59359a)" />
        <FormaStatusBadge Text="@L["Refunded"]"
                          Background="CssColor.FromRgba(13, 110, 253, 0.14)" Foreground="CssColor.FromHex(0x0a58ca)" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["With a marker"]</h2>
    <p class="desc">@L["A glyph before the text, so the status is still legible when the colour is not."]</p>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <FormaStatusBadge Text="@L["Published"]" Status="published" Marker="✓" />
        <FormaStatusBadge Text="@L["Pending"]" Status="pending" Marker="⋯" />
        <FormaStatusBadge Text="@L["Rejected"]" Status="rejected" Marker="✕" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Fallback"]</h2>
    <p class="desc">@L["An unregistered status, or no status at all, falls back to the neutral default."]</p>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <FormaStatusBadge Text="@L["Unknown status"]" Status="never-registered" />
        <FormaStatusBadge Text="@L["No status"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Inside a list"]</h2>
    <div class="demo-box">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="text-align: start; padding: 6px;">@L["Article"]</th>
                    <th style="text-align: start; padding: 6px;">@L["Status"]</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="padding: 6px;">@L["Stage 12 report"]</td>
                    <td style="padding: 6px;"><FormaStatusBadge Text="@L["Published"]" Status="published" /></td>
                </tr>
                <tr>
                    <td style="padding: 6px;">@L["Rider interview"]</td>
                    <td style="padding: 6px;"><FormaStatusBadge Text="@L["Scheduled"]" Status="scheduled" /></td>
                </tr>
                <tr>
                    <td style="padding: 6px;">@L["Season preview"]</td>
                    <td style="padding: 6px;"><FormaStatusBadge Text="@L["Draft"]" Status="draft" /></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Longer label"]</h2>
    <div class="demo-box" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <FormaStatusBadge Text="@L["Awaiting editorial review"]" Status="pending" />
    </div>
</div>
