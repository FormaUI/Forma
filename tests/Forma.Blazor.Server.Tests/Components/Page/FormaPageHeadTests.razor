@inherits FormaBunitContext
@using Forma.Blazor.Components.Page
@using Forma.Framework.Culture.Browser.Interop
@using Microsoft.Extensions.DependencyInjection

@code {
    public sealed class Component
    {
        [Fact]
        public void Should_render_the_title_given()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Equal("Admin Console", cut.Find("title").TextContent);
        }

        [Fact]
        public async Task Should_publish_the_cultures_the_page_is_rendered_in()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();
            await ctx.ChangeCultureAsync("de-DE", "he");

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            var marker = cut.Find("meta[name='forma-culture']");
            Assert.Equal("de-DE/he", $"{marker.GetAttribute("data-culture")}/{marker.GetAttribute("data-ui-culture")}");
        }

        [Fact]
        public void Should_publish_the_policy_that_persists_nothing_by_default()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Equal("state", cut.Find("meta[name='forma-culture-policy']").GetAttribute("content"));
        }

        [Fact]
        public void Should_publish_everything_writing_the_cookie_takes()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();
            ctx.Services.AddSingleton(new CultureSwitchPolicy
            {
                Persistence = CultureSwitchPersistence.Cookie,
                CookieName = "culture",
                CookiePath = "/app",
                CookieDomain = "example.com",
                CookieLifetime = TimeSpan.FromDays(1),
                IsCookieSecure = true,
                CookieSameSite = CultureCookieSameSite.Strict,
            });

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            var policy = cut.Find("meta[name='forma-culture-policy']");
            Assert.Multiple(
                () => Assert.Equal("cookie", policy.GetAttribute("content")),
                () => Assert.Equal("culture /app example.com 86400 strict", string.Join(' ', new[] { "data-name", "data-path", "data-domain", "data-max-age", "data-same-site" }.Select(policy.GetAttribute))),
                () => Assert.True(policy.HasAttribute("data-secure")));
        }

        [Fact]
        public void Should_default_the_base_address_to_the_site_root()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Equal("/", cut.Find("base").GetAttribute("href"));
        }

        [Fact]
        public void Should_render_the_base_address_given()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" BaseHref="/admin/" />);

            // Assert
            Assert.Equal("/admin/", cut.Find("base").GetAttribute("href"));
        }

        [Fact]
        public void Should_link_the_icon_given()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" IconHref="favicon.svg" />);

            // Assert
            Assert.Equal("favicon.svg", cut.Find("link[rel=icon]").GetAttribute("href"));
        }

        [Fact]
        public void Should_link_no_icon_when_none_is_given()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Empty(cut.FindAll("link[rel=icon]"));
        }

        [Fact]
        public void Should_declare_the_character_set_and_viewport()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);

            // Assert
            Assert.Multiple(() =>
            {
                Assert.Equal("utf-8", cut.Find("meta[charset]").GetAttribute("charset"));
                Assert.Equal("width=device-width, initial-scale=1.0", cut.Find("meta[name=viewport]").GetAttribute("content"));
            });
        }

        [Fact]
        public void Should_link_formas_stylesheets_in_cascade_order()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" />);
            var hrefs = cut.FindAll("link[rel=stylesheet]").Select(link => link.GetAttribute("href") ?? "").ToArray();

            // Assert
            Assert.Equal(
                ["_content/Forma.Blazor/forma-tokens.css", "_content/Forma.Blazor/forma-reset.css", "_content/Forma.Blazor/forma-base.css", "_content/Forma.Blazor/forma-input.css", "_content/Forma.Blazor/forma-prose.css"],
                hrefs);
        }

        [Fact]
        public void Should_render_a_hosts_own_head_content_after_formas()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var cut = ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console">
                <link rel="stylesheet" href="app.css" />
            </FormaPageHead>);
            var hrefs = cut.FindAll("link[rel=stylesheet]").Select(link => link.GetAttribute("href") ?? "").ToArray();

            // Assert
            Assert.Equal("app.css", hrefs[^1]);
        }

        [Fact]
        public void Should_reject_a_missing_title()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var act = () => ctx.Render(@<FormaPageHead Title="   " />);

            // Assert
            Assert.Throws<ArgumentException>(act);
        }

        [Fact]
        public void Should_reject_a_missing_base_address()
        {
            // Arrange
            using var ctx = new FormaPageHeadTests();

            // Act
            var act = () => ctx.Render(@<FormaPageHead PreloadAssets="false" Title="Admin Console" BaseHref="" />);

            // Assert
            Assert.Throws<ArgumentException>(act);
        }
    }
}
