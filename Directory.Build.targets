<Project>

    <!--
        Forma Build Targets

        Runs after each project's own properties, so a condition here can read what a project set.
    -->

    <!-- Where a package comes from, as the feed shows it. -->
    <PropertyGroup>
        <Authors>Eyal Alon</Authors>
        <Company>FormaUI</Company>
        <PackageProjectUrl>https://github.com/FormaUI/Forma</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FormaUI/Forma</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <!-- A package is named under the reserved prefix for its project without the product's own, formaui-net.Blazor for Forma.Blazor; the assembly, its namespace and its asset path keep the plain name. -->
    <PropertyGroup Condition="'$(PackageId)' == '' and '$(IsPackable)' != 'false' and $(MSBuildProjectName.StartsWith('Forma.'))">
        <PackageId>formaui-net.$(MSBuildProjectName.Substring(6))</PackageId>
    </PropertyGroup>

    <!-- Every project is licensed under Apache 2.0 and ships the root license and notice if it gets packed. -->
    <PropertyGroup>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- A project with a README beside it ships that as its package readme, unless it named a different one first. -->
    <PropertyGroup Condition="'$(PackageReadmeFile)' == '' and Exists('$(MSBuildProjectDirectory)\README.md')">
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- The release a package belongs to, whose tag names its changelog entry. -->
    <PropertyGroup>
        <_FormaReleaseTag>v$(VersionPrefix)</_FormaReleaseTag>
        <_FormaReleaseTag Condition="'$(VersionSuffix)' != ''">v$(VersionPrefix)-$(VersionSuffix)</_FormaReleaseTag>
    </PropertyGroup>

    <!-- A package records the commit it was built from, ships its symbols beside it, links its release's changelog entry, and has its assemblies checked across its targets; a build in CI writes source paths that don't name the machine. -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageReleaseNotes>What this release changed is in Forma's changelog: https://github.com/FormaUI/Forma/blob/$(_FormaReleaseTag)/CHANGELOG.md</PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- A pre-release may break the one before it, so a package depends on Forma's other packages at its release's exact version while the release is one. -->
    <Target Name="PinProjectPackageVersions" AfterTargets="_GetProjectReferenceVersions" Condition="'$(VersionSuffix)' != ''">
        <ItemGroup>
            <_ExactProjectReferenceVersion Include="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
            <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
            <_ProjectReferencesWithVersions Include="@(_ExactProjectReferenceVersion)" />
        </ItemGroup>
    </Target>

    <!-- A project with third-party notices beside it ships them in its package, since what they credit ships there. -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.md')">
        <None Update="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- A library a WebAssembly client loads builds with Forma's own analyzers, which keep what its interop serializes through trimming. -->
    <ItemGroup Condition="'$(IsTrimmable)' == 'true'">
        <ProjectReference Include="$(MSBuildThisFileDirectory)eng\Forma.Analyzers\Forma.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <!-- What the build does for an assembly that localizes ships with the localization library, and a project here references the library rather than its package, which imports nothing, so it is imported here for every project; it does nothing to one that has no locale files. -->
    <Import Project="$(MSBuildThisFileDirectory)src\Framework\Forma.Framework.Localization\build\Forma.Framework.Localization.targets" />

    <!-- A project referencing a pack directly rather than through its package imports no targets file from it, so it asks each referenced project whether it is a pack and records the ones that say so, as the package's own targets file would. -->
    <Target Name="RecordReferencedLocalePacks" BeforeTargets="GetAssemblyAttributes" Condition="'@(ProjectReference)' != ''">
        <MSBuild Projects="@(ProjectReference)" Targets="GetLocalePackName" SkipNonexistentTargets="true">
            <Output TaskParameter="TargetOutputs" ItemName="_ReferencedLocalePack" />
        </MSBuild>
        <ItemGroup>
            <AssemblyAttribute Include="Forma.Framework.Localization.LocalePackAttribute" Condition="'@(_ReferencedLocalePack)' != ''">
                <_Parameter1>%(_ReferencedLocalePack.Identity)</_Parameter1>
            </AssemblyAttribute>
            <TrimmerRootAssembly Include="@(_ReferencedLocalePack)" />
        </ItemGroup>
    </Target>

</Project>
