<Project>

    <!--
        Forma Build Targets

        Runs after each project's own properties, so a condition here can read what a project set.
    -->

    <!-- Where a package comes from, which the feed shows rather than the identifier carrying it. -->
    <PropertyGroup>
        <Authors>Eyal Alon</Authors>
        <Company>FormaUI</Company>
        <PackageProjectUrl>https://github.com/FormaUI/Forma</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FormaUI/Forma</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <!-- Every project ships the root MIT license if it gets packed, unless it named its own source file first. -->
    <PropertyGroup Condition="'$(PackageLicenseSourceFile)' == ''">
        <PackageLicenseSourceFile>$(MSBuildThisFileDirectory)LICENSE.md</PackageLicenseSourceFile>
    </PropertyGroup>

    <PropertyGroup>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(PackageLicenseSourceFile)" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- A project with a README beside it ships that as its package readme, unless it named a different one first. -->
    <PropertyGroup Condition="'$(PackageReadmeFile)' == '' and Exists('$(MSBuildProjectDirectory)\README.md')">
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- A project with third-party notices beside it ships them in its package, since what they credit ships there. -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.md')">
        <None Update="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- What the build does for an assembly that localizes ships with the localization library, and a project here references the library rather than its package, which imports nothing, so it is imported here for every project; it does nothing to one that has no locale files. -->
    <Import Project="$(MSBuildThisFileDirectory)src\Forma.Framework\Forma.Framework.Localization\build\Forma.Framework.Localization.targets" />

    <!-- A project referencing a pack directly rather than through its package imports no targets file from it, so it asks each referenced project whether it is a pack and records the ones that say so, as the package's own targets file would. -->
    <Target Name="RecordReferencedLocalePacks" BeforeTargets="GetAssemblyAttributes" Condition="'@(ProjectReference)' != ''">
        <MSBuild Projects="@(ProjectReference)" Targets="GetLocalePackName" SkipNonexistentTargets="true">
            <Output TaskParameter="TargetOutputs" ItemName="_ReferencedLocalePack" />
        </MSBuild>
        <ItemGroup>
            <AssemblyAttribute Include="Forma.Framework.Localization.LocalePackAttribute" Condition="'@(_ReferencedLocalePack)' != ''">
                <_Parameter1>%(_ReferencedLocalePack.Identity)</_Parameter1>
            </AssemblyAttribute>
            <TrimmerRootAssembly Include="@(_ReferencedLocalePack)" />
        </ItemGroup>
    </Target>

</Project>
