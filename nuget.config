<?xml version="1.0" encoding="utf-8"?>
<!--
    Forma Package Sources

    The sources a restore is allowed to use, cleared first so that a machine's own configuration cannot
    add one of its own. A package resolved from a folder that exists on a single developer's disk
    restores there and nowhere else, and reports itself as missing rather than as unreachable.
-->
<configuration>

    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>

    <!--
        Cleared separately, because clearing the sources does not reach this list: a machine that has
        switched nuget.org off leaves it off here too, and the restore then fails for a reason that names
        the service rather than the setting.
    -->
    <disabledPackageSources>
        <clear />
    </disabledPackageSources>

    <!--
        Which source a package may be resolved from. With one source this states what is already true, and
        it is here for the second: once mapping is on, a feed added without a pattern of its own leaves the
        packages meant to come from it unfound, which announces itself, rather than widening where an
        existing package may come from, which does not. The longest matching pattern wins, so a later feed
        claims its own names by naming them.
    -->
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>

</configuration>
