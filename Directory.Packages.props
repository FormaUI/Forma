<Project>

    <!--
        Forma Package Versions

        Every package a project references is declared here once, so a project names what it needs and
        this file decides which version it gets. A project that declares a version of its own fails the
        restore rather than diverging quietly.
    -->

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- What the library itself builds on. -->
    <ItemGroup>
        <PackageVersion Include="HtmlSanitizer" Version="9.1.982" />
        <PackageVersion Include="Markdig" Version="1.3.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Components" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.Forms" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageVersion Include="Microsoft.JSInterop" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Include="OfficeIMO.Excel" Version="3.2.0" />
        <PackageVersion Include="OfficeIMO.PowerPoint" Version="3.2.0" />
        <PackageVersion Include="OfficeIMO.Word" Version="3.2.0" />
        <PackageVersion Include="OfficeIMO.Word.Html" Version="3.2.0" />
    </ItemGroup>

    <!-- What the build checks the library with, which ships with nothing. -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    </ItemGroup>

    <!-- What the tests run on; bUnit decides the AngleSharp a test project may use. -->
    <ItemGroup>
        <PackageVersion Include="AngleSharp" Version="1.8.1" />
        <PackageVersion Include="bunit" Version="2.11.3" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-rc.3.26522.148" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.6.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageVersion Include="xunit.v3" Version="3.0.1" />
    </ItemGroup>

</Project>
