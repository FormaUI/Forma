<Project>

    <!--
        Forma Package Versions

        Every package a project references is declared here once, so a project names what it needs and
        this file decides which version it gets. A project that declares a version of its own fails the
        restore rather than diverging quietly.
    -->

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- What the library itself builds on. -->
    <ItemGroup>
        <PackageVersion Include="HtmlSanitizer" Version="9.1.982" />
        <PackageVersion Include="Markdig" Version="1.3.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Components" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.Forms" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
        <PackageVersion Include="Microsoft.JSInterop" Version="11.0.0" />
        <PackageVersion Include="OfficeIMO.Excel" Version="3.2.0" />
        <PackageVersion Include="OfficeIMO.PowerPoint" Version="3.2.0" />
        <PackageVersion Include="OfficeIMO.Word" Version="3.2.0" />
        <PackageVersion Include="OfficeIMO.Word.Html" Version="3.2.0" />
    </ItemGroup>

    <!-- What the build checks the library with, which ships with nothing. -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    </ItemGroup>

    <!-- What the tests run on; bUnit decides the AngleSharp a test project may use. -->
    <ItemGroup>
        <PackageVersion Include="AngleSharp" Version="1.8.6" />
        <PackageVersion Include="bunit" Version="2.13.3" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Maui.Essentials" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    </ItemGroup>

    <!-- MAUI and its web view at the version of the workload that builds a MAUI project. -->
    <ItemGroup Condition="'$(UseMaui)' == 'true'">
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    </ItemGroup>

</Project>
