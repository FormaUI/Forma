@page "/overflow-menu"
@attribute [ShowcasePage("FormaOverflowMenu")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Menus
@inject IStringLocale<FormaOverflowMenuPage> L

<h1>FormaOverflowMenu</h1>
<p class="description">@L["The three-dot menu that collects the actions a row or a card has no room to show. It is a drop-down menu with its trigger already chosen, so every overflow in the app looks the same."]</p>

<div class="demo-section">
    <h2>@L["Horizontal (Toolbar)"]</h2>
    <p class="description">@L["A horizontal ellipsis (⋯) for toolbars and wider contexts."]</p>
    <div class="demo-box">
        <FormaOverflowMenu Label="@L["More options"]">
            <FormaDropDownMenuItem OnClick="@(() => _lastAction = L["Print"].Value)">@L["Print"]</FormaDropDownMenuItem>
            <FormaDropDownMenuItem OnClick="@(() => _lastAction = L["Export"].Value)">@L["Export"]</FormaDropDownMenuItem>
            <FormaDropDownMenuItem OnClick="@(() => _lastAction = L["Share"].Value)">@L["Share"]</FormaDropDownMenuItem>
        </FormaOverflowMenu>
        <p class="demo-note">@L["Last action"]: <code>@(_lastAction ?? L["none yet"].Value)</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Vertical (Row Actions)"]</h2>
    <p class="description">@L["A vertical ellipsis (⋮) for table rows and narrow columns."]</p>
    <div class="demo-box">
        <FormaOverflowMenu Label="@L["Row actions"]" Orientation="MenuOrientation.Vertical">
            <FormaDropDownMenuItem OnClick="@(() => _lastAction = L["Edit"].Value)">@L["Edit"]</FormaDropDownMenuItem>
            <FormaDropDownMenuItem OnClick="@(() => _lastAction = L["Duplicate"].Value)">@L["Duplicate"]</FormaDropDownMenuItem>
            <FormaDropDownMenuDivider />
            <FormaDropDownMenuItem OnClick="@(() => _lastAction = L["Delete"].Value)">@L["Delete"]</FormaDropDownMenuItem>
        </FormaOverflowMenu>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Mini Size"]</h2>
    <p class="description">@L["Sized mini to fit alongside compact row controls."]</p>
    <div class="demo-box">
        <FormaOverflowMenu Label="@L["Compact actions"]" TriggerOptions="ButtonOptions.MiniGhostIcon" Orientation="MenuOrientation.Vertical">
            <FormaDropDownMenuItem OnClick="@(() => _lastAction = L["Edit"].Value)">@L["Edit"]</FormaDropDownMenuItem>
            <FormaDropDownMenuItem OnClick="@(() => _lastAction = L["Delete"].Value)">@L["Delete"]</FormaDropDownMenuItem>
        </FormaOverflowMenu>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Disabled"]</h2>
    <p class="description">@L["The trigger button is disabled when the surrounding row or action is unavailable."]</p>
    <div class="demo-box">
        <FormaOverflowMenu Label="@L["Unavailable actions"]" Disabled="true">
            <FormaDropDownMenuItem>@L["Edit"]</FormaDropDownMenuItem>
        </FormaOverflowMenu>
    </div>
</div>

@code {
    private string? _lastAction;
}
