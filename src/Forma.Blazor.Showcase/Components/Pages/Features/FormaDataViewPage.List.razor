@page "/data-view/list"
@rendermode InteractiveServer

<h1>FormaDataView</h1>
<p class="description">@L["This tab shows the list as a view of the data view: each product a row with its thumbnail, its name and its price, grouped by category under headings that fold, flowing into further columns as the width allows."]</p>

<div class="demo-section">
    <h2>@L["The List View"]</h2>
    <div class="demo-box">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.All" EnablePagination="false" ItemName="@(product => product.Name)" EnableItemSelection="true" GroupBy="DataViewShowcaseProducts.ByCategory" AddressOptions='@(new DataViewAddressOptions("list"))'>
            <FormaDataList TItem="ShowcaseProduct">
                <ThumbnailTemplate Context="product"><span class="demo-thumbnail demo-thumbnail-small"><FormaIcon Icon="@product.Glyph" Size="IconSize.Small" /></span></ThumbnailTemplate>
                <ItemTemplate Context="product">@product.Price.ToString("C0", CultureState.Culture)</ItemTemplate>
            </FormaDataList>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Dense List"]</h2>
    <p class="description">@L["The list at its compact density, names alone on the small step, flowing into further columns as the width allows."]</p>
    <div class="demo-box">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.All" EnablePagination="false" ItemName="@(product => product.Name)" AddressOptions='@(new DataViewAddressOptions("dense"))'>
            <FormaDataList TItem="ShowcaseProduct" Dense="true">
                <ThumbnailTemplate Context="product"><FormaIcon Icon="@product.Glyph" Size="IconSize.Small" /></ThumbnailTemplate>
            </FormaDataList>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Hundred Thousand Items"]</h2>
    <p class="description">@L["The list virtualizing over a hundred thousand products in a bounded box: each item a row of its own, only the rows near the viewport drawn, and a box to check on each."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.Many" EnablePagination="false" Virtualize="true" ItemHeight="32" ItemName="@(product => product.Name)" EnableCheckedSelection="true" AddressOptions='@(new DataViewAddressOptions("many"))'>
            <FormaDataList TItem="ShowcaseProduct">
                <ThumbnailTemplate Context="product"><FormaIcon Icon="@product.Glyph" Size="IconSize.Small" /></ThumbnailTemplate>
                <ItemTemplate Context="product">@product.Price.ToString("C0", CultureState.Culture)</ItemTemplate>
            </FormaDataList>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Hundred Thousand Items, Selected by Row"]</h2>
    <p class="description">@L["The same list with the rows themselves selecting: a press selects, Ctrl or Cmd toggles and Shift extends a range, the arrows, Home and End walk the rows, and a row scrolled away keeps the focus."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.Many" ItemKey="@(product => product.Id)" EnablePagination="false" Virtualize="true" ItemHeight="32" ItemName="@(product => product.Name)" EnableItemSelection="true" AddressOptions='@(new DataViewAddressOptions("many-selected"))' SelectedItems="_selectedProducts" SelectedItemsChanged="HandleSelectedChanged">
            <ChildContent>
                <FormaDataList TItem="ShowcaseProduct">
                    <ThumbnailTemplate Context="product"><FormaIcon Icon="@product.Glyph" Size="IconSize.Small" /></ThumbnailTemplate>
                    <ItemTemplate Context="product">@product.Price.ToString("C0", CultureState.Culture)</ItemTemplate>
                </FormaDataList>
            </ChildContent>
            <Status>@L["{Selected} selected.", _selectedProducts.Count]</Status>
        </FormaDataView>
    </div>
</div>

@code {
    private IReadOnlyList<ShowcaseProduct> _selectedProducts = [];

    /// <inheritdoc />
    protected override Type LocalizationSourceType
        => typeof(FormaDataViewPage);

    private void HandleSelectedChanged(IReadOnlyList<ShowcaseProduct> selected)
        => _selectedProducts = selected;
}
