@page "/explorer"
@attribute [ShowcasePage("FormaExplorer")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Explorer
@using Forma.Features.Explorer

<h1>FormaExplorer</h1>
<p class="description">@L["A browser for the media a site already holds: a thumbnail grid or a details table over folders, with selection, upload, paging and a preview of any item. It handles files the way a desktop does, so an editor already knows how to use it."]</p>

<div class="demo-section">
    <h2>@L["Full Media Explorer"]</h2>
    <p class="description">@L["Browse folders, preview media, select items, rename, delete, and upload."]</p>
    <div class="demo-box">
        <FormaExplorer ResourcesProvider="@(ProviderFor("full"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("full"))"
                      TotalCount="_allMedia.Count"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("full", folder))"
                      SelectedChanged="@(resources => HandleSelectedAsync("full", resources))"
                      OnRename="@(req => HandleRenameAsync("full", req))"
                      OnDelete="@(req => HandleDeleteAsync("full", req))"
                      OnDrop="@(req => HandleDropAsync("full", req))"
                      OnFolderDrop="@(req => HandleFolderDropAsync("full", req))"
                      OnFolderCreate="@(req => HandleFolderCreateAsync("full", req))"
                      OnFolderRename="@(req => HandleFolderRenameAsync("full", req))"
                      OnFolderDelete="@(req => HandleFolderDeleteAsync("full", req))"
                      OnUploaded="@(resources => HandleUploadedAsync("full", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("full"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Single Selection for a Cover Image"]</h2>
    <p class="description">@L["With MaxSelection set to 1, picking any item immediately selects it alone. This one holds its collection through Resources, which is the simpler half of the contract and the right choice for a handful of items."]</p>
    <div class="demo-box">
        <FormaExplorer Resources="_singleSelectResources"
                      MaxSelection="1"
                      SelectedChanged="@(resources => HandleSelectedAsync("single", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("single"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Details Columns"]</h2>
    <p class="description">@L["DetailsColumns picks which optional columns the details view renders beside the name. Nothing wraps, so a narrow explorer scrolls sideways rather than squeezing a column out."]</p>
    <div class="demo-box">
        <fieldset class="demo-row">
            <legend>@L["Columns"]</legend>
            @foreach (var column in ColumnChoices)
            {
                <label>
                    <input type="checkbox"
                           checked="@_detailsColumns.HasFlag(column)"
                           @onchange="@(e => ToggleColumn(column, (bool)e.Value!))" />
                    @ColumnLabel(column)
                </label>
            }
        </fieldset>
        <FormaExplorer Resources="_allMedia"
                      ViewMode="ExplorerViewMode.Details"
                      Options="@(new ExplorerOptions { DetailsColumns = _detailsColumns, ShowSidebar = false })" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Read-Only Explorer"]</h2>
    <p class="description">@L["With ExplorerFileOptions.ReadOnly, browsing and selection remain while upload, rename, delete, and every folder action disappear."]</p>
    <div class="demo-box">
        <FormaExplorer ResourcesProvider="@(ProviderFor("readonly"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("readonly"))"
                      TotalCount="_allMedia.Count"
                      FileOptions="ExplorerFileOptions.ReadOnly"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("readonly", folder))"
                      SelectedChanged="@(resources => HandleSelectedAsync("readonly", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("readonly"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Constraints"]</h2>
    <p class="description">@L["This explorer accepts only images, holds two root folders, one subfolder each, nests two deep, and stops at four items or 1 MB. Trip any of them and the refusal is announced above the toolbar and reported to the host."]</p>
    <div class="demo-box">
        <FormaExplorer Resources="_constrainedResources"
                      Folders="_constrainedFolders"
                      CurrentFolder="@(CurrentFolderFor("constrained"))"
                      Constraints="_demoConstraints"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("constrained", folder))"
                      OnFolderCreate="@(req => HandleFolderCreateAsync("constrained", req))"
                      OnRejected="@(rejection => HandleRejectedAsync("constrained", rejection))" />
        <ul class="demo-log">
            @foreach (var resource in Log("constrained"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Media without Folder Management"]</h2>
    <p class="description">@L["Media stays fully editable while the folder tree is fixed, so items can be renamed and deleted but folders cannot."]</p>
    <div class="demo-box">
        <FormaExplorer ResourcesProvider="@(ProviderFor("fixedfolders"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("fixedfolders"))"
                      TotalCount="_allMedia.Count"
                      FileOptions="_fixedFolderOptions"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("fixedfolders", folder))"
                      OnRename="@(req => HandleRenameAsync("fixedfolders", req))"
                      OnDelete="@(req => HandleDeleteAsync("fixedfolders", req))"
                      OnUploaded="@(resources => HandleUploadedAsync("fixedfolders", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("fixedfolders"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Breadcrumb-Only Navigation"]</h2>
    <p class="description">@L["With ShowSidebar off, the folder tree is hidden and folders are reached through the breadcrumb menus instead."]</p>
    <div class="demo-box">
        <FormaExplorer ResourcesProvider="@(ProviderFor("nosidebar"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("nosidebar"))"
                      TotalCount="_allMedia.Count"
                      Options="@(new ExplorerOptions { ShowSidebar = false })"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("nosidebar", folder))" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Sidebar without Breadcrumb Menus"]</h2>
    <p class="description">@L["With ShowFolderMenu off, the breadcrumbs become plain separators and the tree is the only way to change folder."]</p>
    <div class="demo-box">
        <FormaExplorer ResourcesProvider="@(ProviderFor("nomenu"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("nomenu"))"
                      TotalCount="_allMedia.Count"
                      Options="@(new ExplorerOptions { ShowFolderMenu = false })"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("nomenu", folder))" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Library Too Large to Hold"]</h2>
    <p class="description">@L["Twenty thousand items behind a provider. The explorer keeps only the window it is showing, and the folder never appears in the query because the page already knows it."]</p>
    <div class="demo-box">
        <FormaExplorer ResourcesProvider="@(ProviderFor("library"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("library"))"
                      PageSize="12"
                      TotalCount="_libraryCount"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("library", folder))" />
        <p class="demo-note">@L["Windows fetched: {Count}", ("Count", _libraryStore.QueryCount)] — @LibraryQueryDescription</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Empty Explorer"]</h2>
    <p class="description">@L["When a folder has no media, the explorer displays an empty state."]</p>
    <div class="demo-box">
        <FormaExplorer Resources="[]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Paginated Explorer"]</h2>
    <p class="description">@L["A large collection splits across pages using FormaPagination."]</p>
    <div class="demo-box">
        <FormaExplorer ResourcesProvider="@(ProviderFor("paged"))" PageSize="4" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Infinite Scrolling Explorer"]</h2>
    <p class="description">@L["ExplorerInfiniteScrollMode.Manual appends the next page as the reader nears the end, and offers a button for anyone not using a pointer. The media scrolls inside the panel, so the toolbar and folder tree stay put."]</p>
    <div class="demo-box">
        <FormaExplorer ResourcesProvider="@(ProviderFor("infinite"))" PageSize="24" Options="@(new ExplorerOptions { InfiniteScroll = ExplorerInfiniteScrollMode.Manual })" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Automatic Infinite Scrolling"]</h2>
    <p class="description">@L["ExplorerInfiniteScrollMode.Automatic drops the button entirely: pages arrive as the reader scrolls, marked by a spinner while each one loads, with the running count left as the reader's sense of position."]</p>
    <div class="demo-box">
        <FormaExplorer ResourcesProvider="@(ProviderFor("infinite"))"
                      PageSize="24"
                      Options="@(new ExplorerOptions { InfiniteScroll = ExplorerInfiniteScrollMode.Automatic })" />
    </div>
</div>
