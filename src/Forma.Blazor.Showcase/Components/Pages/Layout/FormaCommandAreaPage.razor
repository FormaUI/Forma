@page "/command-area"
@attribute [ShowcasePage("FormaCommandArea")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Inputs
@using Forma.Blazor.Components.Layout
@inject IStringLocale<FormaCommandAreaPage> L

<h1>FormaCommandArea</h1>
<p class="description">@L["The region a page puts above its content. The area owns the surface and stacks as many bars as a caller gives it. What those bars carry is never the area's business."]</p>

<div class="demo-section">
    <h2>@L["A Header of Two Bars"]</h2>
    <p class="description">@L["Bars stack in the order they are written. This is the shape a file explorer uses: somewhere to navigate and search above, the commands acting on what is shown below."]</p>
    <div class="demo-box demo-box-flush">
        <FormaCommandArea>
            <FormaCommandBar>
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" IconOnly="true" aria-label="@L["Back"]"><FormaIcon Icon="Glyph.ArrowLeft" /></FormaButton>
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" IconOnly="true" aria-label="@L["Up"]"><FormaIcon Icon="Glyph.ArrowUp" /></FormaButton>
                <FormaSearchBox Value="@_query" ValueChanged="v => _query = v" Options="@(new SearchBoxOptions { Placeholder = L["Search media..."] })" aria-label="@L["Search media..."]" />
            </FormaCommandBar>
            <FormaCommandBar>
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini"><FormaIcon Icon="Glyph.CheckSquare" /> @L["Select"]</FormaButton>
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini"><FormaIcon Icon="Glyph.CloudUpload" /> @L["Upload"]</FormaButton>
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini"><FormaIcon Icon="Glyph.FolderAdd" /> @L["New Folder"]</FormaButton>
            </FormaCommandBar>
        </FormaCommandArea>
    </div>
</div>

<div class="demo-section">
    <h2>@L["As Many Bars as You Like"]</h2>
    <p class="description">@L["Each bar scrolls on its own, so a crowded bar of filters never drags the bar of actions along with it."]</p>
    <div class="demo-box demo-box-flush demo-command-bar-narrow">
        <FormaCommandArea>
            <FormaCommandBar>
                <FormaButton Variant="ButtonVariant.Primary" Size="ButtonSize.Mini">@L["Publish"]</FormaButton>
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@L["Discard"]</FormaButton>
            </FormaCommandBar>
            <FormaCommandBar>
                @foreach (var filter in ManyFilters)
                {
                    <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@filter</FormaButton>
                }
            </FormaCommandBar>
        </FormaCommandArea>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Nothing but the Region"]</h2>
    <p class="description">@L["Given no bars the area is only its own surface, which is what a caller wanting somewhere to put its own layout gets."]</p>
    <div class="demo-box demo-box-flush">
        <FormaCommandArea />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Retuned by the Caller"]</h2>
    <p class="description">@L["The padding and the surface are knobs, so a host can seat the area in its own chrome without forking the stylesheet."]</p>
    <div class="demo-box demo-box-flush">
        <FormaCommandArea Class="demo-command-area-tinted">
            <FormaCommandBar>
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@L["Publish"]</FormaButton>
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@L["Discard"]</FormaButton>
            </FormaCommandBar>
        </FormaCommandArea>
    </div>
</div>

@code {
    private string _query = string.Empty;

    private string[] ManyFilters =>
    [
        L["All"], L["Images"], L["Video"], L["Audio"], L["Documents"],
        L["Archives"], L["Recent"], L["Starred"], L["Shared with Me"]
    ];
}

