@page "/frame"
@attribute [ShowcasePage("FormaFrame")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Layout
@inject IStringLocale<FormaFramePage> L

<h1>FormaFrame</h1>
<p class="description">@L["A region of the page. Its variant decides its look: flat in its parent, raised off the canvas as a card, inset a tone, or the canvas other frames are laid on. It draws no line."]</p>

<div class="demo-section">
    <h2>@L["Flat and Inset"]</h2>
    <p class="description">@L["Two frames inside one frame are told apart by tone alone: the inset frame sets a header strip or a toolbar band back from the flat frame beside it."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame>
            <FormaFrame Variant="FrameVariant.Inset" class="demo-frame">@L["Inset: a header strip"]</FormaFrame>
            <FormaFrame class="demo-frame demo-frame-tall">@L["Flat: the content"]</FormaFrame>
        </FormaFrame>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Raised on a Canvas"]</h2>
    <p class="description">@L["A raised frame stands off the canvas as a card, lifted by a soft shadow with the canvas showing around it."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas">
            <FormaFrame Variant="FrameVariant.Raised" class="demo-frame demo-frame-tall">@L["Raised: a card on the canvas"]</FormaFrame>
        </FormaFrame>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Flat inside a Card"]</h2>
    <p class="description">@L["Inside a raised frame, the frames it holds lie flat and are told apart by tone, so the card reads as one whole."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas">
            <FormaFrame Variant="FrameVariant.Raised">
                <FormaFrame Variant="FrameVariant.Inset" class="demo-frame">@L["Inset: a header strip"]</FormaFrame>
                <FormaFrame class="demo-frame demo-frame-tall">@L["Flat: the content"]</FormaFrame>
            </FormaFrame>
        </FormaFrame>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Cards on One Canvas"]</h2>
    <p class="description">@L["Several raised frames stacked on one canvas. The seam shows between them, one step wide, the same step the canvas shows around them."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas">
            <FormaStackLayout>
                <FormaFrame Variant="FrameVariant.Raised" class="demo-frame">@L["Header"]</FormaFrame>
                <FormaStackLayout Orientation="StackOrientation.Horizontal">
                    <FormaFrame Variant="FrameVariant.Raised" class="demo-frame demo-frame-side">@L["Sidebar"]</FormaFrame>
                    <FormaFrame Variant="FrameVariant.Raised" class="demo-frame demo-frame-tall demo-frame-fill">@L["Content"]</FormaFrame>
                </FormaStackLayout>
            </FormaStackLayout>
        </FormaFrame>
    </div>
</div>
