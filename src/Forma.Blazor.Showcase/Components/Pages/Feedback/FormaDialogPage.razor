@page "/dialog"
@attribute [ShowcasePage("FormaDialog")]
@rendermode InteractiveServer

<h1>FormaDialog</h1>
<p class="description">@L["A dialog that holds the page until it is answered. It is the browser's own dialog underneath, so focus stays inside it, Escape closes it and a screen reader treats it as modal without the library reimplementing any of that."]</p>

<div class="demo-section">
    <h2>@L["Basic Dialog"]</h2>
    <div class="demo-box">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _showBasic = true">@L["Open Basic Dialog"]</FormaButton>
        <FormaDialog Opened="_showBasic" OnClose="() => _showBasic = false" Title="@L["Basic Dialog"]">
            <Body>
                <p>@L["This is a basic dialog with a title and child content."]</p>
            </Body>
        </FormaDialog>
    </div>
</div>

<div class="demo-section">
    <h2>@L["No Header (Title = null)"]</h2>
    <div class="demo-box">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _showNoHeader = true">@L["Open Headerless Dialog"]</FormaButton>
        <FormaDialog Opened="_showNoHeader" OnClose="() => _showNoHeader = false" Options="HideConfirmAction">
            <Body>
                <p>@L["This dialog has no header - useful for simple alerts or custom layouts."]</p>
            </Body>
        </FormaDialog>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Size Variants"]</h2>
    <div class="demo-box demo-row">
        @foreach (var size in _sizes)
        {
            var chosen = size;
            <FormaButton OnClick="() => _activeSize = chosen">@chosen</FormaButton>
        }
        @if (_activeSize is not null)
        {
            <FormaDialog Opened="true" OnClose="() => _activeSize = null" Title="@($"Size: {_activeSize}")" Size="@_activeSize.Value"
                      Options="HideConfirmAction">
                <Body>
                    <p>@L["This dialog uses"] <code>Size="@_activeSize"</code>.</p>
                </Body>
            </FormaDialog>
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Custom Footer"]</h2>
    <div class="demo-box demo-row">
        <FormaButton OnClick="() => _showFooterOnly = true">@L["Open Footer Only"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _showFooterWithActions = true">@L["Open Footer + Actions"]</FormaButton>

        <FormaDialog Opened="_showFooterOnly" OnClose="() => _showFooterOnly = false" Title="@L["Footer Only"]"
                  Options="HideFooterActions">
            <Body>
                <p>@L["This example shows footer content only, without default actions."]</p>
            </Body>
            <Footer>
                <span class="demo-note">@L["Last updated: just now"]</span>
            </Footer>
        </FormaDialog>

        <FormaDialog Opened="_showFooterWithActions" OnClose="() => _showFooterWithActions = false" Title="@L["Footer + Actions"]">
            <Body>
                <p>@L["This example shows both custom footer content and default actions."]</p>
            </Body>
            <Footer>
                <span class="demo-note">@L["Tip: you can place any custom content here"]</span>
            </Footer>
        </FormaDialog>
    </div>
</div>

<div class="demo-section">
    <h2>@L["No Footer"]</h2>
    <div class="demo-box">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _showNoFooter = true">@L["Open (no footer)"]</FormaButton>
        <FormaDialog Opened="_showNoFooter" OnClose="() => _showNoFooter = false" Title="@L["Information"]">
            <Body>
                <p>@L["This dialog has no footer - close it with Escape, scrim click, or the X button."]</p>
            </Body>
        </FormaDialog>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Scrim Click Disabled"]</h2>
    <div class="demo-box">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _showNoScrim = true">@L["Open (no scrim close)"]</FormaButton>
        <FormaDialog Opened="_showNoScrim" OnClose="() => _showNoScrim = false"
                    Title="@L["Must Use X or Button"]" Options="RequireExplicitClose">
            <Body>
                <p>@L["Clicking the scrim does not close this dialog. Use the X button or the button below."]</p>
            </Body>
        </FormaDialog>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Menu Inside"]</h2>
    <p class="description">@L["A menu opened inside the dialog closes on the first Escape and leaves the dialog open; the next Escape closes the dialog."]</p>
    <div class="demo-box">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _showWithMenu = true">@L["Open Dialog With a Menu"]</FormaButton>
        <FormaDialog Opened="_showWithMenu" OnClose="() => _showWithMenu = false" Title="@L["Export"]">
            <Body>
                <FormaDropDownMenu>
                    <Trigger>@L["Format"]</Trigger>
                    <ChildContent>
                        <FormaDropDownMenuItem OnClick="@(() => _exportFormat = "CSV")">CSV</FormaDropDownMenuItem>
                        <FormaDropDownMenuItem OnClick="@(() => _exportFormat = "PDF")">PDF</FormaDropDownMenuItem>
                    </ChildContent>
                </FormaDropDownMenu>
                <p class="demo-note">@L["Format"]: <code>@(_exportFormat ?? L["none yet"])</code></p>
            </Body>
        </FormaDialog>
    </div>
</div>

@code {
    private static readonly DialogOptions HideConfirmAction =
        new() { ShowConfirmAction = false };

    private static readonly DialogOptions HideFooterActions =
        new() { ShowCancelAction = false, ShowConfirmAction = false };

    private static readonly DialogOptions RequireExplicitClose =
        new() { CloseOnScrimClick = false, ShowConfirmAction = false };

    private bool _showBasic;
    private bool _showNoHeader;
    private bool _showNoFooter;
    private bool _showNoScrim;
    private bool _showFooterOnly;
    private bool _showFooterWithActions;
    private bool _showWithMenu;
    private string? _exportFormat;
    private DialogSize? _activeSize;

    private static readonly DialogSize[] _sizes = [DialogSize.Small, DialogSize.Medium, DialogSize.Large, DialogSize.ExtraLarge, DialogSize.Full];
}
