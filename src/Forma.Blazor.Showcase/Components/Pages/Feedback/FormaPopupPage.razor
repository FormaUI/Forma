@page "/popup"
@attribute [ShowcasePage("FormaPopup")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Buttons
@inject IStringLocale<FormaPopupPage> L

<h1>FormaPopup</h1>
<p class="description">@L["A panel hanging from the control that opened it. It is drawn in the browser's top layer, so nothing scrolls or clips it; Escape closes it and puts focus back on the trigger, and a click anywhere else closes it without moving focus."]</p>

<div class="demo-section">
    <h2>@L["Basic"]</h2>
    <p class="description">@L["The popup follows its anchor when the page scrolls, and flips above it when there is no room below."]</p>
    <div class="demo-box">
        <span class="demo-anchor" @ref="_basicAnchor">
            <FormaButton @ref="_basicTrigger" Variant="ButtonVariant.Primary" aria-expanded="@(_basic is { IsOpen: true } ? "true" : "false")" OnClick="() => ToggleAsync(_basic, _basicTrigger)">@L["Open"]</FormaButton>
        </span>
        <FormaPopup @ref="_basic" Anchor="_basicAnchor" OnOpenChanged="_ => { }">
            <div class="demo-popup">
                <p>@L["Anything can go here. Press Escape, or click outside, to close."]</p>
            </div>
        </FormaPopup>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Keeping Focus"]</h2>
    <p class="description">@L["With KeepsFocus, Tab and Shift+Tab move between the popup's own controls and wrap at either end, so the page behind it is never tabbed into by accident."]</p>
    <div class="demo-box">
        <span class="demo-anchor" @ref="_trappedAnchor">
            <FormaButton @ref="_trappedTrigger" Variant="ButtonVariant.Primary" aria-expanded="@(_trapped is { IsOpen: true } ? "true" : "false")" OnClick="() => ToggleAsync(_trapped, _trappedTrigger)">@L["Open"]</FormaButton>
        </span>
        <FormaPopup @ref="_trapped" Anchor="_trappedAnchor" KeepsFocus="true" OnOpenChanged="_ => { }" OnOpened="() => _firstAction.Element.FocusAsync()">
            <div class="demo-popup demo-popup-actions">
                <FormaButton @ref="_firstAction" Variant="ButtonVariant.Secondary" OnClick="@(() => Choose(L["One"]))">@L["One"]</FormaButton>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="@(() => Choose(L["Two"]))">@L["Two"]</FormaButton>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="@(() => Choose(L["Three"]))">@L["Three"]</FormaButton>
            </div>
        </FormaPopup>
        <p class="demo-note">@L["Chosen"]: <code>@(_chosen ?? L["none yet"])</code></p>
    </div>
</div>

@code {
    private ElementReference _basicAnchor;
    private FormaButton _basicTrigger = default!;
    private FormaPopup _basic = default!;

    private ElementReference _trappedAnchor;
    private FormaButton _trappedTrigger = default!;
    private FormaPopup _trapped = default!;
    private FormaButton _firstAction = default!;

    private string? _chosen;

    private static Task ToggleAsync(FormaPopup popup, FormaButton trigger)
        => popup.ToggleAsync(trigger.Element);

    private async Task Choose(string choice)
    {
        _chosen = choice;
        await _trapped.CloseAsync();
    }
}
