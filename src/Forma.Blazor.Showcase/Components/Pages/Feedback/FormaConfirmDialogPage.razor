@page "/confirm-dialog"
@attribute [ShowcasePage("FormaConfirmDialog")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Feedback
@inject IConfirmDialogService ConfirmService
@inject IStringLocale<FormaConfirmDialogPage> L

<h1>FormaConfirmDialog</h1>
<p class="description">@L["A question the app asks before it acts, answered with one of two buttons. Any code raises it through the confirm service and simply awaits the answer, so a confirmation is one line wherever it is needed."]</p>

<div class="demo-section">
    <h2>@L["Basic Confirmation"]</h2>
    <div class="demo-box">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="HandleBasicConfirm">@L["Delete Item"]</FormaButton>
        @if (_basicResult is not null)
        {
            <p class="demo-note">@L["Result:"] <strong>@(_basicResult.Value ? L["Confirmed"] : L["Canceled"])</strong></p>
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Custom Button Labels"]</h2>
    <div class="demo-box">
        <FormaButton OnClick="HandleCustomConfirm">@L["Discard Changes"]</FormaButton>
        @if (_customResult is not null)
        {
            <p class="demo-note">@L["Result:"] <strong>@(_customResult.Value ? L["Discarded"] : L["Kept"])</strong></p>
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Cascading Confirmations"]</h2>
    <div class="demo-box">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="HandleCascadeConfirm">@L["Delete Account"]</FormaButton>
        @if (_cascadeResult is not null)
        {
            <p class="demo-note">@L["Result:"] <strong>@_cascadeResult</strong></p>
        }
    </div>
</div>

<FormaConfirmDialog />

@code {
    private bool? _basicResult;
    private bool? _customResult;
    private string? _cascadeResult;

    private async Task HandleBasicConfirm()
    {
        _basicResult = null;
        _basicResult = await ConfirmService.ConfirmAsync(
            L["Are you sure you want to delete this item?"],
            L["Confirm"],
            L["Cancel"]);
    }

    private async Task HandleCustomConfirm()
    {
        _customResult = null;
        _customResult = await ConfirmService.ConfirmAsync(
            L["You have unsaved changes. Discard them?"],
            confirmText: L["Discard Changes"],
            cancelText: L["Keep Editing"]);
    }

    private async Task HandleCascadeConfirm()
    {
        _cascadeResult = null;

        var first = await ConfirmService.ConfirmAsync(
            L["Are you sure you want to delete the account?"],
            L["Confirm"],
            L["Cancel"]);
        if (!first)
        {
            _cascadeResult = L["Canceled at first step"];
            return;
        }

        var second = await ConfirmService.ConfirmAsync(
            L["This action is irreversible. Continue?"],
            L["Yes, Delete"],
            L["No"]);
        _cascadeResult = second
            ? L["Account deleted"]
            : L["Canceled at second step"];
    }
}
