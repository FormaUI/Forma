@page "/breadcrumb"
@attribute [ShowcasePage("FormaBreadcrumb")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Navigation
@inject IStringLocale<FormaBreadcrumbPage> L

<h1>FormaBreadcrumb</h1>
<p class="description">@L["A trail of segments that link, click, or sit static depending on what the caller wires up, with an optional dropdown of alternatives and drop-target events per segment."]</p>

<div class="demo-section">
    <h2>@L["Site Navigation"]</h2>
    <p class="description">@L["Every segment but the last carries a Url, so it renders as a real link; the last carries none and stands as static text — no OnItemClick is wired at all."]</p>
    <div class="demo-box">
        <FormaBreadcrumb Items="SiteItems" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Folder Navigation"]</h2>
    <p class="description">@L["No segment carries a Url; every one is a button reporting its folder through OnItemClick, and the root wears a folder icon."]</p>
    <div class="demo-box">
        <FormaBreadcrumb TItem="string" Items="FolderItems" RootIcon="Glyph.FolderOpen" OnItemClick="HandleFolderSelected" />
        <p class="demo-note">@L["Current folder"]: <code>@(_currentFolder ?? L["(root)"])</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Dropdown of Alternatives"]</h2>
    <p class="description">@L["A chevron beside a segment opens a menu of siblings it could jump to instead, the way a folder's breadcrumb offers folders next to the one shown."]</p>
    <div class="demo-box">
        <FormaBreadcrumb TItem="string" Items="ItemsWithChildren" RootIcon="Glyph.FolderOpen" OnItemClick="HandleAlternativeSelected" />
        <p class="demo-note">@L["Selected"]: <code>@(_selectedAlternative ?? L["(none yet)"])</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Drop Target"]</h2>
    <p class="description">@L["Every segment accepts a drop, reporting which one received it — drag the chip onto Races or Covers."]</p>
    <div class="demo-box">
        <div class="demo-row">
            <span class="demo-chip" draggable="true">@L["banner.png"]</span>
            <FormaBreadcrumb TItem="string" Items="DropTargetItems" OnItemClick="v => { }" OnItemDrop="HandleDropped" />
        </div>
        <p class="demo-note">@L["Dropped on"]: <code>@(_droppedOn ?? L["(nothing yet)"])</code></p>
    </div>
</div>

@code {
    private string? _currentFolder;
    private string? _selectedAlternative;
    private string? _droppedOn;

    private BreadcrumbItem<object?>[] SiteItems =>
    [
        new(L["Home"], "/"),
        new(L["Store"], "/store"),
        new(L["Orders"]) { IsCurrent = true }
    ];

    private BreadcrumbItem<string>[] FolderItems =>
    [
        new(L["All Media"]) { Value = null, IsCurrent = _currentFolder is null },
        new(L["Races"]) { Value = "races", IsCurrent = _currentFolder == "races" },
        new(L["2026"]) { Value = "2026", IsCurrent = _currentFolder == "2026" }
    ];

    private BreadcrumbItem<string>[] ItemsWithChildren =>
    [
        new(L["All Media"])
        {
            Children =
            [
                new(L["Races"]) { Value = "races" },
                new(L["Covers"]) { Value = "covers" }
            ]
        },
        new(L["Races"]) { Value = "races" }
    ];

    private BreadcrumbItem<string>[] DropTargetItems =>
    [
        new(L["All Media"]) { Value = "root" },
        new(L["Races"]) { Value = "races" },
        new(L["Covers"]) { Value = "covers" }
    ];

    private void HandleFolderSelected(string? folder)
        => _currentFolder = folder;

    private void HandleAlternativeSelected(string? value)
        => _selectedAlternative = value;

    private void HandleDropped(string? value)
        => _droppedOn = value;
}
