@page "/window"
@attribute [ShowcasePage("FormaWindow")]
@rendermode InteractiveServer
@using System.Globalization
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Layout
@using Forma.Blazor.Components.Windows
@using Forma.Framework.Icons
@using Forma.Framework.Toolbar
@using Forma.Framework.Windows
@using Forma.Blazor.Components.Inputs
@inject IStringLocale<FormaWindowPage> L
@inject WindowManager Manager
@implements IDisposable

<h1>FormaWindow</h1>
<p class="description">@L["A raised frame with chrome: a title bar carrying the title, an icon and commands, then an optional header band, the body, and an optional footer band. It stands embedded in its parent's layout or floats over the page, where it can be moved by its title bar, resized at its edges and maximized."]</p>

<div class="demo-section">
    <h2>@L["Embedded"]</h2>
    <p class="description">@L["Embedded, a window is a region its parent lays out like any frame. These two stand in a horizontal stack with a splitter in the seam between them."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas">
            <FormaStackLayout Orientation="StackOrientation.Horizontal" class="demo-window-stack" style="@FoldersStyle">
                <FormaWindow Title="@L["Folders"]" Icon="Glyph.Pin" Options="new() { Embeddable = false, Closable = false }" class="demo-window-side">
                    <Body>@L["The folder tree would stand here."]</Body>
                </FormaWindow>
                <FormaSplitter Orientation="SplitterOrientation.Vertical" @bind-Value="_foldersWidth" Min="10" Max="24" Label="@L["Resize Folders"]" />
                <FormaWindow Title="@L["Details"]" Options="new() { Embeddable = false, Closable = false }" class="demo-window-fill">
                    <Header>@L["Everything known about the selected item."]</Header>
                    <Body>@L["The details would stand here."]</Body>
                    <Footer>@L["Two items selected"]</Footer>
                </FormaWindow>
            </FormaStackLayout>
        </FormaFrame>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Floating"]</h2>
    <p class="description">@L["Floating, a window stands over the page. Drag it by its title bar, pull any edge or corner to resize it, or focus the title bar and use the arrow keys, holding Shift to resize. Escape closes the focused window. This one resizes no smaller than 320 by 200 and no larger than 900 by 700."]</p>
    <div class="demo-box">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _isFloatingOpen = true" Disabled="_isFloatingOpen">@L["Open a Floating Window"]</FormaButton>
        <p class="demo-note">@L["Placement"]: <code>@PlacementText</code></p>
    </div>
    @if (_isFloatingOpen)
    {
        <FormaWindow Title="@L["Inspector"]"
                     Icon="Glyph.Search"
                     Mode="WindowMode.Floating"
                     @bind-Placement="_placement"
                     @bind-Maximized="_isMaximized"
                     Options="new() { Embeddable = false, Lockable = true, MinResizeSize = (320, 200), MaxResizeSize = (900, 700) }"
                     OnClose="() => _isFloatingOpen = false">
            <Body>@L["A floating window keeps its place while the page beneath it scrolls."]</Body>
            <Footer>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isFloatingOpen = false">@L["Close"]</FormaButton>
            </Footer>
        </FormaWindow>
    }
</div>

<div class="demo-section">
    <h2>@L["Embedding and Floating"]</h2>
    <p class="description">@L["The pin command switches a window between embedded and floating. Float this one and it lifts off the canvas; embed it and it returns to its place in the stack."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas" class="demo-window-canvas">
            <FormaStackLayout>
                <FormaWindow Title="@L["Output"]" @bind-Mode="_outputMode" Options="new() { Closable = false }" class="demo-window-fill">
                    <Body>@L["Build succeeded."]</Body>
                </FormaWindow>
            </FormaStackLayout>
        </FormaFrame>
    </div>
    <p class="demo-note">@L["Mode"]: <code>@_outputMode</code></p>
</div>

<div class="demo-section">
    <h2>@L["Host Commands"]</h2>
    <p class="description">@L["A host adds its own commands to the title bar; they stand before the window's own."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas">
            <FormaStackLayout>
                <FormaWindow Title="@L["Media"]" Commands="MediaCommands" OnCommand="command => _lastCommand = command" Options="new() { Embeddable = false, Closable = false }" class="demo-window-fill">
                    <Body>@L["Refresh or upload from the title bar."]</Body>
                </FormaWindow>
            </FormaStackLayout>
        </FormaFrame>
    </div>
    <p class="demo-note">@L["Last command"]: <code>@(_lastCommand ?? L["none yet"])</code></p>
</div>

<div class="demo-section">
    <h2>@L["Workspace"]</h2>
    <p class="description">@L["Every window belongs to a workspace that knows which one is current and which windows another opened. Properties is a child of Library: minimizing Library hides it, closing Library asks it first, and with unsaved work it declines and keeps both open."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas" class="demo-window-canvas">
            <FormaStackLayout>
                @if (_isLibraryOpen)
                {
                    <FormaWindow @ref="_library" Title="@L["Library"]" Icon="Glyph.Pin" Origin="_libraryOrigin" Options="new() { Embeddable = false }" OnClose="() => _isLibraryOpen = false" class="demo-window-fill">
                        <Body>
                            <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isPropertiesOpen = true" Disabled="_isPropertiesOpen">@L["Open Properties"]</FormaButton>
                        </Body>
                    </FormaWindow>
                }
                else
                {
                    <div class="demo-window-fill demo-window-empty">
                        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isLibraryOpen = true">@L["Reopen Library"]</FormaButton>
                    </div>
                }
            </FormaStackLayout>
        </FormaFrame>
    </div>
    @if (_isLibraryOpen && _isPropertiesOpen && _library is not null)
    {
        <FormaWindow Title="@L["Properties"]"
                     Parent="_library"
                     Mode="WindowMode.Floating"
                     Options="new() { Embeddable = false, Maximizable = false }"
                     OnClosing="args => args.Cancel = _hasUnsavedWork"
                     OnClose="() => _isPropertiesOpen = false">
            <Body>
                <FormaCheckBox @bind-Checked="_hasUnsavedWork">@L["Unsaved work"]</FormaCheckBox>
            </Body>
        </FormaWindow>
    }
    <p class="demo-note">
        @L["Current"]: <code>@(Manager.Current?.Title ?? L["none"])</code>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="RestoreAllAsync">@L["Restore Every Window"]</FormaButton>
    </p>
</div>

<div class="demo-section">
    <h2>@L["Origins and Instances"]</h2>
    <p class="description">@L["Two running instances of one application, Explorer, share an origin and keep separate instance identities and separate handles, titles alike. Each opens a Preview, and the first Preview opens a Zoom: three generations. Type in the first Explorer's notes, minimize it and restore it, and the text is still there; focus the notes, activate the second Explorer, then come back through the rest area, and focus returns to the notes."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas">
            <FormaStackLayout Orientation="StackOrientation.Horizontal" class="demo-window-stack">
                @if (_isExplorerAOpen)
                {
                    <FormaWindow @ref="_explorerAWindow" Title="@L["Explorer"]" Icon="Glyph.Folder" Origin="_explorerA" Options="new() { Embeddable = false }" OnClose="() => _isExplorerAOpen = false" class="demo-window-fill">
                        <Body>
                            <EditForm Model="_explorerNotes">
                                <FormaTextBox @bind-Value="_explorerNotes.Text" Label="@L["Notes"]" Placeholder="@L["Kept across minimization"]" />
                            </EditForm>
                            <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isPreviewAOpen = true" Disabled="_isPreviewAOpen">@L["Open Preview"]</FormaButton>
                        </Body>
                    </FormaWindow>
                }
                else
                {
                    <div class="demo-window-fill demo-window-empty">
                        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isExplorerAOpen = true">@L["Reopen the First Explorer"]</FormaButton>
                    </div>
                }
                @if (_isExplorerBOpen)
                {
                    <FormaWindow @ref="_explorerBWindow" Title="@L["Explorer"]" Icon="Glyph.Folder" Origin="_explorerB" Options="new() { Embeddable = false }" OnClose="() => _isExplorerBOpen = false" class="demo-window-fill">
                        <Body>
                            <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isPreviewBOpen = true" Disabled="_isPreviewBOpen">@L["Open Preview"]</FormaButton>
                        </Body>
                    </FormaWindow>
                }
                else
                {
                    <div class="demo-window-fill demo-window-empty">
                        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isExplorerBOpen = true">@L["Reopen the Second Explorer"]</FormaButton>
                    </div>
                }
            </FormaStackLayout>
        </FormaFrame>
    </div>
    @if (_isExplorerAOpen && _isPreviewAOpen && _explorerAWindow is not null)
    {
        <FormaWindow @ref="_previewAWindow" Title="@L["Preview"]" Parent="_explorerAWindow" Mode="WindowMode.Floating" Placement="new(280, 240, 360, 220)" Options="new() { Embeddable = false, Maximizable = false }" OnClose="() => _isPreviewAOpen = false">
            <Body>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isZoomOpen = true" Disabled="_isZoomOpen">@L["Open Zoom"]</FormaButton>
            </Body>
        </FormaWindow>
    }
    @if (_isExplorerBOpen && _isPreviewBOpen && _explorerBWindow is not null)
    {
        <FormaWindow Title="@L["Preview"]" Parent="_explorerBWindow" Mode="WindowMode.Floating" Placement="new(720, 260, 360, 220)" Options="new() { Embeddable = false, Maximizable = false }" OnClose="() => _isPreviewBOpen = false">
            <Body>@L["The second Explorer's preview."]</Body>
        </FormaWindow>
    }
    @if (_isExplorerAOpen && _isPreviewAOpen && _isZoomOpen && _previewAWindow is not null)
    {
        <FormaWindow Title="@L["Zoom"]" Parent="_previewAWindow" Mode="WindowMode.Floating" Placement="new(400, 420, 320, 200)" Options="new() { Embeddable = false, Maximizable = false }" OnClosing="args => args.Cancel = _zoomHasUnsavedWork" OnClose="() => _isZoomOpen = false">
            <Body>
                <FormaCheckBox @bind-Checked="_zoomHasUnsavedWork">@L["Unsaved work"]</FormaCheckBox>
            </Body>
        </FormaWindow>
    }
</div>

<div class="demo-section">
    <h2>@L["Selectors"]</h2>
    <p class="description">@L["One selector shape drives every query and operation: by window reference, by origin, by instance, by title, or by parent. Two Explorers make activation by title ambiguous, an empty operation selector is rejected, All reaches the whole workspace, and a selection holding a parent and its descendants processes each once. Renaming the origin changes what the rest area shows and nothing the selectors match."]</p>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Activate by title"], () => Manager.ActivateAsync(new WindowSelector { Title = L["Explorer"] })))">@L["Activate by Title"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Activate the first by reference"], () => Manager.ActivateAsync(new WindowSelector { Window = _explorerAWindow })))" Disabled="!_isExplorerAOpen">@L["Activate the First by Reference"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Activate the second by instance and title"], () => Manager.ActivateAsync(new WindowSelector { InstanceId = _explorerB.InstanceId, Title = L["Explorer"] })))">@L["Activate the Second by Instance"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Activate the second instance alone"], () => Manager.ActivateAsync(new WindowSelector { InstanceId = _explorerB.InstanceId })))">@L["Activate the Second Instance Alone"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Activate with an empty selector"], () => Manager.ActivateAsync(new WindowSelector())))">@L["Activate with an Empty Selector"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Minimize all"], () => Manager.MinimizeAsync(WindowSelector.All)))">@L["Minimize All"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Minimize by origin"], () => Manager.MinimizeAsync(new WindowSelector { OriginId = ExplorerOriginId })))">@L["Minimize by Origin"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Restore all"], () => Manager.RestoreAsync(WindowSelector.All)))">@L["Restore All"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Bring the origin to the front"], () => Manager.BringToFrontAsync(new WindowSelector { OriginId = ExplorerOriginId })))">@L["Bring the Origin to the Front"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Bring the first instance to the front"], () => Manager.BringToFrontAsync(new WindowSelector { InstanceId = _explorerA.InstanceId })))">@L["Bring the First Instance to the Front"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="FindByTitle">@L["Find Every Preview"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="FindDescendants" Disabled="!_isExplorerAOpen">@L["Find the First Explorer's Descendants"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="RenameOrigin">@(_explorerA.OriginName == L["Explorer"] ? L["Rename the Origin to Files"] : L["Rename the Origin to Explorer"])</FormaButton>
        <FormaButton Variant="ButtonVariant.Danger" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Close the first by reference"], () => Manager.CloseAsync(new WindowSelector { Window = _explorerAWindow })))" Disabled="!_isExplorerAOpen">@L["Close the First by Reference"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Danger" Size="ButtonSize.Mini" OnClick="@(() => RunAsync(L["Close by origin"], () => Manager.CloseAsync(new WindowSelector { OriginId = ExplorerOriginId })))">@L["Close by Origin"]</FormaButton>
    </div>
    <ul class="demo-log">
        @foreach (var entry in _log)
        {
            <li>@entry</li>
        }
    </ul>
</div>

<div class="demo-section">
    <h2>@L["Rest Area"]</h2>
    <p class="description">@L["Every window on this page has a handle here for as long as it exists. Minimize a window, or send one behind another, and its handle brings it back and makes it current. Grouped by origin, both Explorers and their descendants share one group; grouped by instance, each stands apart, the second numbered so a screen reader tells them apart."]</p>
    <div class="demo-box demo-row">
        <FormaToggleButton Label="@L["Ungrouped"]" ShowLabel="true" Pressed="_grouping == RestAreaGrouping.None" OnClick="() => _grouping = RestAreaGrouping.None" />
        <FormaToggleButton Label="@L["By Origin"]" ShowLabel="true" Pressed="_grouping == RestAreaGrouping.Origin" OnClick="() => _grouping = RestAreaGrouping.Origin" />
        <FormaToggleButton Label="@L["By Instance"]" ShowLabel="true" Pressed="_grouping == RestAreaGrouping.Instance" OnClick="() => _grouping = RestAreaGrouping.Instance" />
    </div>
    <div class="demo-box">
        <FormaRestArea Options="new() { Grouping = _grouping }" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Two Workspaces"]</h2>
    <p class="description">@L["A host that needs a second workspace cascades its own manager. Timeline belongs to the studio workspace: the studio's rest area lists it alone, the page's rest area above never shows it, and each workspace keeps its own current window."]</p>
    <CascadingValue Value="_studio">
        <div class="demo-box demo-box-flush">
            <FormaFrame Variant="FrameVariant.Canvas">
                <FormaStackLayout>
                    <FormaWindow Title="@L["Timeline"]" Options="new() { Embeddable = false, Closable = false }" class="demo-window-fill">
                        <Body>@L["A window of the studio workspace."]</Body>
                    </FormaWindow>
                </FormaStackLayout>
            </FormaFrame>
        </div>
        <div class="demo-box">
            <FormaRestArea Label="@L["Studio Windows"]" />
        </div>
    </CascadingValue>
    <p class="demo-note">@L["Studio's current"]: <code>@(_studio.Current?.Title ?? L["none"])</code></p>
</div>

<div class="demo-section">
    <h2>@L["Modal"]</h2>
    <p class="description">@L["A modal child blocks the window that opened it and nothing else: Account cannot be used until Confirm is answered, while the rest of the page can. A modal root blocks the whole workspace and stands on a backdrop."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas" class="demo-window-canvas">
            <FormaStackLayout>
                <FormaWindow @ref="_account" Title="@L["Account"]" Options="new() { Embeddable = false, Closable = false }" class="demo-window-fill">
                    <Body>
                        <FormaButton Variant="ButtonVariant.Danger" OnClick="() => _isConfirmOpen = true" Disabled="_isConfirmOpen">@L["Delete Account"]</FormaButton>
                    </Body>
                </FormaWindow>
            </FormaStackLayout>
        </FormaFrame>
    </div>
    @if (_isConfirmOpen && _account is not null)
    {
        <FormaWindow Title="@L["Confirm"]"
                     Parent="_account"
                     Mode="WindowMode.Floating"
                     Modal="true"
                     Options="new() { Embeddable = false, Maximizable = false, Minimizable = false }"
                     OnClose="() => _isConfirmOpen = false">
            <Body>@L["Delete the account? This cannot be undone."]</Body>
            <Footer>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isConfirmOpen = false">@L["Keep"]</FormaButton>
                <FormaButton Variant="ButtonVariant.Danger" OnClick="() => _isConfirmOpen = false">@L["Delete"]</FormaButton>
            </Footer>
        </FormaWindow>
    }
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _isNoticeOpen = true" Disabled="_isNoticeOpen">@L["Open a Workspace-Wide Modal"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="ActivateAccountAsync">@L["Activate Account"]</FormaButton>
    </div>
    <p class="demo-note">@L["Activating Account"]: <code>@(_accountActivation ?? L["none yet"])</code></p>
    @if (_isNoticeOpen)
    {
        <FormaWindow Title="@L["Notice"]"
                     Mode="WindowMode.Floating"
                     Modal="true"
                     Options="new() { Embeddable = false, Maximizable = false, Minimizable = false }"
                     OnClose="() => _isNoticeOpen = false">
            <Body>@L["Every other window waits until this one is closed."]</Body>
            <Footer>
                <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _isNoticeOpen = false">@L["Got It"]</FormaButton>
            </Footer>
        </FormaWindow>
    }
</div>

<div class="demo-section">
    <h2>@L["Press Away"]</h2>
    <p class="description">@L["A window can answer a press outside it by going to the back. Open both: the Palette is in front; press anywhere else on the page and it goes behind the Canvas; press the Palette and it returns."]</p>
    <div class="demo-box">
        <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _isPairOpen = true" Disabled="_isPairOpen">@L["Open Palette and Canvas"]</FormaButton>
    </div>
    @if (_isPairOpen)
    {
        <FormaWindow Title="@L["Canvas"]" Mode="WindowMode.Floating" Placement="new(320, 200, 520, 360)" Options="new() { Embeddable = false }" OnClose="() => _isPairOpen = false">
            <Body>@L["A plain floating window."]</Body>
        </FormaWindow>
        <FormaWindow Title="@L["Palette"]" Mode="WindowMode.Floating" Placement="new(700, 420, 320, 240)" Options="new() { Embeddable = false, Maximizable = false, PressAway = WindowPressAway.SendToBack }" OnClose="() => _isPairOpen = false">
            <Body>@L["Goes to the back on a press away."]</Body>
        </FormaWindow>
    }
</div>

<div class="demo-section">
    <h2>@L["Bounds"]</h2>
    <p class="description">@L["A window can be held within an element instead of the viewport: it opens at the element's center, cannot be moved or resized past its edges, and maximizes to fill it. Shrink the arena with the window near its bottom edge and the window is brought back inside."]</p>
    <div class="demo-box demo-box-flush">
        <FormaFrame Variant="FrameVariant.Canvas">
            <div @ref="_arena" class="@(_isArenaShort ? "demo-window-arena demo-window-arena-short" : "demo-window-arena")">
                <FormaButton Variant="ButtonVariant.Primary" OnClick="() => _isBoundedOpen = true" Disabled="_isBoundedOpen">@L["Open a Bounded Window"]</FormaButton>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _isArenaShort = !_isArenaShort">@(_isArenaShort ? L["Grow the Arena"] : L["Shrink the Arena"])</FormaButton>
            </div>
        </FormaFrame>
    </div>
    @if (_isBoundedOpen)
    {
        <FormaWindow Title="@L["Bounded"]" Mode="WindowMode.Floating" Options="new() { Embeddable = false, Bounds = WindowBounds.Container(_arena), MinResizeSize = (240, 160) }" OnClose="() => _isBoundedOpen = false">
            <Body>@L["Held within the arena beneath."]</Body>
        </FormaWindow>
    }
</div>

@code {
    private double _foldersWidth = 14;
    private bool _isFloatingOpen;
    private WindowPlacement? _placement;
    private bool _isMaximized;
    private WindowMode _outputMode = WindowMode.Embedded;
    private string? _lastCommand;
    private WindowOrigin _libraryOrigin = WindowOrigin.NewInstance("library", "Library");
    private FormaWindow? _library;
    private bool _isLibraryOpen = true;
    private bool _isPropertiesOpen;
    private bool _hasUnsavedWork;
    private FormaWindow? _account;
    private bool _isConfirmOpen;
    private bool _isNoticeOpen;
    private bool _isPairOpen;
    private ElementReference _arena;
    private bool _isBoundedOpen;
    private bool _isArenaShort;
    private string? _accountActivation;
    private const string ExplorerOriginId = "explorer";
    private WindowOrigin _explorerA = WindowOrigin.NewInstance(ExplorerOriginId, "Explorer");
    private WindowOrigin _explorerB = WindowOrigin.NewInstance(ExplorerOriginId, "Explorer");
    private FormaWindow? _explorerAWindow;
    private FormaWindow? _explorerBWindow;
    private FormaWindow? _previewAWindow;
    private bool _isExplorerAOpen = true;
    private bool _isExplorerBOpen = true;
    private bool _isPreviewAOpen;
    private bool _isPreviewBOpen;
    private bool _isZoomOpen;
    private bool _zoomHasUnsavedWork;
    private readonly ExplorerNotes _explorerNotes = new();
    private readonly List<string> _log = [];
    private RestAreaGrouping _grouping = RestAreaGrouping.Origin;
    private readonly WindowManager _studio = new();

    protected override void OnInitialized()
    {
        _libraryOrigin = _libraryOrigin with { OriginName = L["Library"] };
        _explorerA = _explorerA with { OriginName = L["Explorer"] };
        _explorerB = _explorerB with { OriginName = L["Explorer"] };
        Manager.Changed += HandleWorkspaceChanged;
        _studio.Changed += HandleWorkspaceChanged;
    }

    public void Dispose()
    {
        Manager.Changed -= HandleWorkspaceChanged;
        _studio.Changed -= HandleWorkspaceChanged;
    }

    private void HandleWorkspaceChanged(object? sender, EventArgs args)
        => _ = InvokeAsync(StateHasChanged);

    private Task RestoreAllAsync()
        => Manager.RestoreAsync(WindowSelector.All).AsTask();

    private async Task RunAsync(string operation, Func<ValueTask<WindowOperationResult>> operate)
    {
        try
        {
            var result = await operate();
            var titles = result.Windows.Count == 0 ? L["no windows"] : string.Join(", ", result.Windows.Select(window => window.Title));

            Log(L["{Operation}: {Outcome} ({Windows})", operation, OutcomeText(result.Outcome), titles]);
        }
        catch (ArgumentException rejection)
        {
            Log(L["{Operation}: rejected, {Message}", operation, rejection.Message]);
        }
    }

    private void FindByTitle()
    {
        Manager.TryFindWindows(new WindowSelector { Title = L["Preview"] }, out var windows);
        Log(L["Find every Preview: {Count} found", windows.Count]);
    }

    private void FindDescendants()
    {
        Manager.TryFindWindows(new WindowSelector { Parent = _explorerAWindow, Recursive = true }, out var windows);
        Log(L["The first Explorer's descendants: {Windows}", windows.Count == 0 ? L["no windows"] : string.Join(", ", windows.Select(window => window.Title))]);
    }

    private void RenameOrigin()
    {
        var name = _explorerA.OriginName == L["Explorer"] ? L["Files"] : L["Explorer"];

        _explorerA = _explorerA with { OriginName = name };
        _explorerB = _explorerB with { OriginName = name };
        Log(L["Origin renamed to {Name}; identities unchanged", name]);
    }

    private async Task ActivateAccountAsync()
    {
        var result = await Manager.ActivateAsync(new WindowSelector { Window = _account });

        _accountActivation = L["{Outcome}, current is {Window}", OutcomeText(result.Outcome), Manager.Current?.Title ?? L["none"]];
    }

    private string OutcomeText(WindowOperationOutcome outcome)
        => outcome switch
        {
            WindowOperationOutcome.Applied => L["applied"],
            WindowOperationOutcome.NoMatch => L["no match"],
            WindowOperationOutcome.Ambiguous => L["ambiguous"],
            WindowOperationOutcome.Ineligible => L["ineligible"],
            _ => L["declined"],
        };

    private void Log(string entry)
    {
        _log.Insert(0, entry);

        if (_log.Count > 8)
        {
            _log.RemoveAt(_log.Count - 1);
        }
    }

    private sealed class ExplorerNotes
    {
        public string? Text { get; set; }
    }

    private string FoldersStyle => FormattableString.Invariant($"--demo-window-side-size: {_foldersWidth}rem");

    private string PlacementText => _placement is { } placement
        ? string.Create(CultureInfo.CurrentCulture, $"{placement.Left:0} × {placement.Top:0}, {placement.Width:0} × {placement.Height:0}")
        : L["centered"];

    private IReadOnlyList<FormaToolbarItem> MediaCommands =>
    [
        new FormaToolbarCommand { Id = "refresh", Command = "refresh", Title = L["Refresh"], Icon = Glyph.Refresh },
        new FormaToolbarCommand { Id = "upload", Command = "upload", Title = L["Upload"], Icon = Glyph.Upload },
    ];
}
