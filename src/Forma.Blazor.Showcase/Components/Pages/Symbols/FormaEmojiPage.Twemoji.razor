@page "/emoji/twemoji"
@rendermode InteractiveServer

<h1>FormaEmoji</h1>
<p class="description">@L["One emoji, drawn through whichever provider the host registered."]</p>
<p class="description">@L["This tab draws them from the Twemoji artwork package, which a host adds and registers itself: one drawing per emoji, identical on every device, fetched as a sprite sheet the first time one of its emoji is drawn."]</p>

<CascadingValue Value="Twemoji" IsFixed="true">
    <EmojiCatalogGallery />

    <div class="demo-section">
        <h2>@L["Sizing"]</h2>
        <p class="description">@L["An emoji takes the font size of whatever contains it, so it sits on a line of text without being measured against it."]</p>
        <div class="demo-box">
            <div class="glyph-sizes">
                <span style="font-size: var(--font-size-xs);"><FormaEmoji Emoji="@("🚴")" /> xs</span>
                <span style="font-size: var(--font-size-base);"><FormaEmoji Emoji="@("🚴")" /> base</span>
                <span style="font-size: var(--font-size-2xl);"><FormaEmoji Emoji="@("🚴")" /> 2xl</span>
                <span style="font-size: var(--icon-size-lg);"><FormaEmoji Emoji="@("🚴")" /> @L["Large"]</span>
            </div>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Inside a Sentence"]</h2>
        <p class="description">@L["An emoji is decorative by default and hidden from assistive technology, so the sentence around it has to read without it."]</p>
        <div class="demo-box">
            <p>@L["The stage winner"] <FormaEmoji Emoji="@("🏆")" /> @L["took the mountains classification as well"] <FormaEmoji Emoji="@("⛰️")" />.</p>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Named for a Reader"]</h2>
        <p class="description">@L["An emoji carrying meaning of its own takes a label, which announces it as an image rather than leaving it silent."]</p>
        <div class="demo-box">
            <div class="glyph-sizes">
                <FormaEmoji Emoji="@("✅")" Label="@L["Stage completed"]" />
                <FormaEmoji Emoji="@("⚠️")" Label="@L["Weather warning"]" />
                <FormaEmoji Emoji="@("🩺")" Label="@L["Medical car"]" />
            </div>
        </div>
    </div>
</CascadingValue>

<PageLocalization />

@code {
    private static readonly IEmojiProvider Twemoji = new TwemojiEmojiProvider();

    /// <inheritdoc />
    protected override Type LocalizationSourceType
        => typeof(FormaEmojiPage);
}
