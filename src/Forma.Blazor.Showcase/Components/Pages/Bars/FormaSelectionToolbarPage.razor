@page "/selection-toolbar"
@attribute [ShowcasePage("FormaSelectionToolbar")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Bars
@using Forma.Framework.Icons
@using Microsoft.AspNetCore.Components.Web
@inject IStringLocale<FormaSelectionToolbarPage> L

<h1>FormaSelectionToolbar</h1>
<p class="description">@L["A toolbar for actions that apply to the current selection. It appears while one or more items are selected and can clear the selection when the work is done."]</p>

<div class="demo-section">
    <h2>@L["Basic Usage"]</h2>
    <div class="demo-box">
        <FormaButton OnClick="() => _basicCount = _basicCount > 0 ? 0 : 3">
            @L["Toggle selection"]
        </FormaButton>
        <FormaSelectionToolbar Count="_basicCount" Label="@L["Selection Actions"]" Items="BasicItems" OnCommand="HandleCommand" OnClear="() => _basicCount = 0" />
        <p class="demo-note">@L["Last command"]: <code>@_lastCommand</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Caption Agreeing with the Count"]</h2>
    <p class="description">@L["Step the count up. The caption is a plural construct, so a language with a dual reads differently at one, two, and more."]</p>
    <div class="demo-box">
        <FormaButton OnClick="() => _agreementCount = (_agreementCount + 1) % 4">
            @L["Add one"]
        </FormaButton>
        <FormaSelectionToolbar Count="_agreementCount" Label="@L["Selection Actions"]" Items="DeleteOnly" OnCommand="HandleCommand" OnClear="() => _agreementCount = 0" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Without a Clear Button"]</h2>
    <div class="demo-box">
        <FormaSelectionToolbar Count="2" Label="@L["Selection Actions"]" Items="DeleteOnly" OnCommand="HandleCommand" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Several Actions"]</h2>
    <div class="demo-box">
        <FormaButton OnClick="() => _wideCount = _wideCount > 0 ? 0 : 4">
            @L["Toggle selection"]
        </FormaButton>
        <FormaSelectionToolbar Count="_wideCount" Label="@L["Selection Actions"]" Items="WideItems" OnCommand="HandleCommand" OnClear="() => _wideCount = 0" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Caller-Supplied Caption"]</h2>
    <div class="demo-box">
        <FormaSelectionToolbar Count="ModerationCount" Caption="@(L["[$ plural; one: # comment awaiting moderation; other: # comments awaiting moderation; $]", ModerationCount])" Label="@L["Selection Actions"]" Items="PublishOnly" OnCommand="HandleCommand" />
    </div>
</div>

@code {
    private const int ModerationCount = 7;

    private int _basicCount;
    private int _agreementCount = 1;
    private int _wideCount = 4;
    private string _lastCommand = "";

    private IReadOnlyList<FormaToolbarItem> BasicItems =>
    [
        Delete, Publish,
    ];

    private IReadOnlyList<FormaToolbarItem> DeleteOnly =>
    [
        Delete,
    ];

    private IReadOnlyList<FormaToolbarItem> PublishOnly =>
    [
        Publish,
    ];

    private IReadOnlyList<FormaToolbarItem> WideItems =>
    [
        Delete,
        Publish,
        new FormaToolbarCommand { Id = "unpublish", Title = L["Unpublish"], Icon = Glyph.EyeSlash, Command = "unpublish" },
        new FormaToolbarCommand { Id = "export", Title = L["Export"], Icon = Glyph.Download, Command = "export" },
    ];

    private FormaToolbarItem Delete
        => new FormaToolbarCommand { Id = "delete", Title = L["Delete"], Icon = Glyph.Delete, Command = "delete" };

    private FormaToolbarItem Publish
        => new FormaToolbarCommand { Id = "publish", Title = L["Publish"], Icon = Glyph.CloudUpload, Command = "publish" };

    private void HandleCommand(string command)
        => _lastCommand = command;
}
