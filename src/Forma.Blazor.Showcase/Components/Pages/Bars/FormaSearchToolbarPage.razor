@page "/search-toolbar"
@attribute [ShowcasePage("FormaSearchToolbar")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Bars
@using Forma.Blazor.Components.Inputs
@using Forma.Framework.Icons
@using Microsoft.AspNetCore.Components.Web
@inject IStringLocale<FormaSearchToolbarPage> L

<h1>FormaSearchToolbar</h1>
<p class="description">@L["A search field and the actions that apply to the list it filters, in one row at the top of a list page."]</p>

<div class="demo-section">
    <h2>@L["Search Only"]</h2>
    <div class="demo-box">
        <FormaSearchToolbar OnSearch="HandleSearchOnly" Search="Search" />
        <p class="demo-note">@L["Last search"]: <code>@_searchOnlyQuery</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Search with Actions"]</h2>
    <div class="demo-box">
        <FormaSearchToolbar OnSearch="HandleSearchWithActions" Search="Search" Label="@L["List Actions"]" Items="Actions" OnCommand="HandleCommand" />
        <p class="demo-note">@L["Last search"]: <code>@_withActionsQuery</code></p>
        <p class="demo-note">@L["Last command"]: <code>@_lastCommand</code></p>
    </div>
</div>

@code {
    private string _searchOnlyQuery = "";
    private string _withActionsQuery = "";
    private string _lastCommand = "";

    private SearchBoxOptions Search
        => new() { Placeholder = L["Search..."], DebounceDelay = TimeSpan.FromMilliseconds(300) };

    private IReadOnlyList<FormaToolbarItem> Actions =>
    [
        new FormaToolbarCommand { Id = "add", Title = L["Add New"], Icon = Glyph.Plus, Command = "add-new" },
        new FormaToolbarCommand { Id = "export", Title = L["Export"], Icon = Glyph.Download, Command = "export" },
    ];

    private void HandleCommand(string command)
        => _lastCommand = command;

    private Task HandleSearchOnly(string value)
    {
        _searchOnlyQuery = value;
        return Task.CompletedTask;
    }

    private Task HandleSearchWithActions(string value)
    {
        _withActionsQuery = value;
        return Task.CompletedTask;
    }
}
