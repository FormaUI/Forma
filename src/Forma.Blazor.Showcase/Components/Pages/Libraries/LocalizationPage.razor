@page "/localization"
@attribute [ShowcasePage("Localization")]
@rendermode InteractiveServer
@using System.Globalization
@using Forma.Framework.Culture.Router.AspNetCore
@using Forma.Framework.Localization
@using Forma.Framework.Localization.Json
@using Forma.Framework.Localization.Language
@inject CultureRouter Router

<h1>Localization</h1>
<p class="description">@L["Every string Forma renders resolves through IStringLocale. Switch the culture in the sidebar to watch each section below change."]</p>

<div class="demo-section">
    <h2>@L["The Culture in Force"]</h2>
    <div class="demo-box">
        <table class="demo-table">
            <tbody>
                <tr>
                    <th>@L["Locale files are read for"]</th>
                    <td><code dir="ltr">@CultureState.UICulture.Name</code></td>
                </tr>
                <tr>
                    <th>@L["Numbers and dates format for"]</th>
                    <td><code dir="ltr">@CultureState.Culture.Name</code></td>
                </tr>
                <tr>
                    <th>@L["Plural rules follow"]</th>
                    <td><code dir="ltr">@Language</code></td>
                </tr>
                <tr>
                    <th>@L["Writing direction"]</th>
                    <td>@(CultureState.UICulture.TextInfo.IsRightToLeft ? L["right to left"] : L["left to right"])</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Hit and a Miss"]</h2>
    <p class="description">@L["A key with no translation is returned as written and flagged, so nothing ever renders blank. In English both rows miss, because English is the language the keys are written in and carries no file of its own."]</p>
    <div class="demo-box">
        @foreach (var text in new[] { L["Save"], L[AbsentKey] })
        {
            <table class="demo-table">
                <tbody>
                    <tr>
                        <th>@L["Key"]</th>
                        <td dir="ltr"><code>@text.Name</code></td>
                    </tr>
                    <tr>
                        <th>@L["Result"]</th>
                        <td><bdi>@text.Value</bdi></td>
                    </tr>
                    <tr>
                        <th>@L["Translation"]</th>
                        <td><span class="demo-chip">@(text.ResourceNotFound ? L["missing"] : L["found"])</span></td>
                    </tr>
                    <tr>
                        <th>@L["Searched"]</th>
                        <td dir="ltr" class="demo-note"><code>@text.SearchedLocation</code></td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Holes Filled with Values"]</h2>
    <p class="description">@L["Arguments stay as objects rather than text, so a format specifier written into a translation still reaches the value."]</p>
    <div class="demo-box">
        <div class="demo-row">
            <label class="demo-field">@L["Written"] <input type="number" class="demo-number" @bind="_written" @bind:event="oninput" /></label>
            <label class="demo-field">@L["Allowed"] <input type="number" class="demo-number" @bind="_allowed" @bind:event="oninput" /></label>
        </div>
        <p>@L["{Written} of {Allowed} characters", _written, _allowed]</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Values Paired by Position"]</h2>
    <p class="description">@L["The names mark where the holes are, and the values are paired with them in the order the key writes them, so any expression can be passed. A translation refers to the holes by name, so it may put them in another order — the Hebrew here does."]</p>
    <div class="demo-box">
        <p>@L["Stored {Stored} of {Total}.", _written, _allowed]</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Plural Forms"]</h2>
    <p class="description">@L["The count decides which branch of the construct is used. Try 1, 2 and 5, then switch to Hebrew, which has a dual the other two languages do not."]</p>
    <div class="demo-box">
        <div class="demo-row">
            <label class="demo-field">@L["Count"] <input type="number" step="0.5" class="demo-number" @bind="_count" @bind:event="oninput" /></label>
            <span class="demo-field">@L["Category"] <span class="demo-chip"><code dir="ltr">@GetCategory(_count)</code></span></span>
        </div>
        <p>@L[PluralKey, _count]</p>
        <p class="demo-note"><code dir="ltr">@PluralKey</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["The Categories This Language Uses"]</h2>
    <p class="description">@L["A language selects only the categories it needs, so a construct only has to carry those. A category it never selects is simply unused."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <thead>
                <tr>
                    <th>@L["Count"]</th>
                    <th>@L["Category"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sample in Samples)
                {
                    <tr>
                        <td><code dir="ltr">@sample.ToString(CultureState.Culture)</code></td>
                        <td><code dir="ltr">@GetCategory(sample)</code></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="demo-note">@L["1 and 1.0 can differ, because the rules read how the number was written rather than its value alone."]</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Count Written Two Ways"]</h2>
    <p class="description">@L["Both stand for the count. The hash is substituted while the plural is resolved and carries the culture's grouping; the named hole survives until the holes are filled."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <tbody>
                <tr>
                    <th><code dir="ltr">#</code></th>
                    <td>@GetGroupedCount(1234567)</td>
                </tr>
                <tr>
                    <th><code dir="ltr">{count}</code></th>
                    <td>@GetRawCount(1234567)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Branch That Is Missing"]</h2>
    <p class="description">@L["A construct needs a branch for every category its language can select. When the one chosen is absent and there is no other branch to fall back to, the result is empty."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <tbody>
                <tr>
                    <th><code dir="ltr">@IncompleteKey</code></th>
                    <td>
                        <code dir="ltr">@L[IncompleteKey, 5].Value</code>
                        <span class="demo-note">@L["nothing at all"]</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["The Language the Keys Are Written In"]</h2>
    <p class="description">@L["This key has no translation, so it is shown exactly as authored — in Hebrew. Its plural forms have to follow Hebrew, whatever language is on screen, and SourceLanguage is what says so."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <thead>
                <tr>
                    <th>@L["Setting"]</th>
                    <th>@L["Result"]</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th><code dir="ltr">SourceLanguage = "en"</code></th>
                    <td>@EnglishSource[HebrewSourceKey, 2].Value</td>
                </tr>
                <tr>
                    <th><code dir="ltr">SourceLanguage = "he"</code></th>
                    <td>@HebrewSource[HebrewSourceKey, 2].Value</td>
                </tr>
            </tbody>
        </table>
        <p class="demo-note">@L["Forma's own keys are English, so the default already matches and nothing needs configuring."]</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Holes Left Open"]</h2>
    <p class="description">@L["Resolve hands back the localized format with its holes still open, so a caller can render each value itself rather than pasting text together."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <tbody>
                <tr>
                    <th>@L["Format"]</th>
                    <td><code>@Pattern.Format</code></td>
                </tr>
                <tr>
                    <th>@L["Arguments"]</th>
                    <td><code dir="ltr">@string.Join(", ", Pattern.Arguments)</code></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Locale Files from the Host"]</h2>
    <p class="description">@L["A host lays its own files in a .locales folder beside the application, to reword a string an assembly ships or to add a language it never had. Each key below is localized beside this page and again in the Showcase's .locales folder, and the folder wins; the last key exists in the folder alone."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <thead>
                <tr>
                    <th>@L["Key"]</th>
                    <th>@L["Beside the Page"]</th>
                    <th>@L["From the Host's Folder"]</th>
                    <th>@L["File"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (key, file) in HostFiles)
                {
                    <tr>
                        <td dir="ltr"><code>@key</code></td>
                        <td><bdi>@WithoutHostFiles[key].Value</bdi></td>
                        <td><bdi>@L[key].Value</bdi></td>
                        <td dir="ltr" class="demo-note"><code>@file</code></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Language the Library Never Shipped"]</h2>
    <p class="description">@L["French ships with neither the library nor the Showcase. The Showcase's .locales folder supplies it for this section, for the share menu and for the pagination, so the strings below read in French from that folder alone, and the page can be opened in French to see everything else fall back to English."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <thead>
                <tr>
                    <th>@L["Key"]</th>
                    <th>@L["In French, from the host's folder"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (key, _) in HostFiles)
                {
                    <tr>
                        <td dir="ltr"><code>@key</code></td>
                        <td dir="ltr">@GetFrench(key)</td>
                    </tr>
                }
            </tbody>
        </table>
        <FormaPagination TotalItems="65" PageSize="10" CurrentPage="_page" OnPageChanged="HandlePageChangedAsync" />
        <p class="demo-note">@L["Current page"]: <code>@_page</code></p>
        <p class="demo-note"><a href="@Router.GetUrl(French, "localization")" data-enhance-nav="false">@L["Open this page in French"]</a></p>
    </div>
</div>

@code {
    private const string AbsentKey = "No translation exists for this sentence.";
    private const string PluralKey = "[$ plural; one: # file; other: # files; $]";
    private const string IncompleteKey = "[$ plural; one: # file; $]";
    private const string HebrewSourceKey = "[$ plural; one: פריט אחד; two: שני פריטים; other: # פריטים; $]";
    private const string GroupedFormat = "[$ plural; other: #; $]";
    private const string RawFormat = "{count}";

    private static readonly decimal[] Samples = [0m, 0.5m, 1m, 1.0m, 2m, 3m, 5m, 11m, 100m, 1000000m];

    private static readonly PluralExpressionEvaluator PluralFormat = new(CommonPluralRuleSet.Default);

    private const string AssemblyFileKey = "Written in the root's file";
    private const string NamespaceFileKey = "Written in a parent folder's file";
    private const string TypeFileKey = "Written in the page's folder's file";
    private const string HostOnlyKey = "Added by the host's folder alone";

    private static readonly (string Key, string File)[] HostFiles =
    [
        (AssemblyFileKey, ".locales/Forma.Blazor.Showcase/.locales/{culture}.json"),
        (NamespaceFileKey, ".locales/Forma.Blazor.Showcase/Components/.locales/{culture}.json"),
        (TypeFileKey, ".locales/Forma.Blazor.Showcase/Components/Pages/Libraries/.locales/{culture}.json"),
        (HostOnlyKey, ".locales/Forma.Blazor.Showcase/.locales/{culture}.json"),
    ];

    private int _written = 5;
    private int _allowed = 280;
    private decimal _count = 1m;
    private int _page = 1;

    private string Language
        => CultureState.UICulture.TwoLetterISOLanguageName;

    private CultureRoute French
        => Router.Routes.First(route => route.Token == "fr");

    private IStringLocale EnglishSource
        => field ??= new JsonStringLocaleFactory().Create(typeof(LocalizationPage), CultureState);

    private IStringLocale HebrewSource
        => field ??= new JsonStringLocaleFactory(new LocalizationOptions { SourceLanguage = "he" }).Create(typeof(LocalizationPage), CultureState);

    private IStringLocale WithoutHostFiles
        => field ??= new JsonStringLocaleFactory(new LocalizationOptions { LocalesPath = string.Empty }).Create(typeof(LocalizationPage), CultureState);

    // Looks the key up under French, leaving the culture on screen as it is.
    private string GetFrench(string key)
    {
        var french = CultureInfo.GetCultureInfo("fr");

        return L.WithCulture(french, french)[key].Value;
    }

    private Task HandlePageChangedAsync(int page)
    {
        _page = page;

        return Task.CompletedTask;
    }

    private LocalizedPattern Pattern
        => L.Resolve("{Written} of {Allowed} characters", _written, _allowed);

    private string GetCategory(decimal count)
    {
        var category = CommonPluralRuleSet.Default.Select(Language, PluralOperands.From(count));

        return category?.ToString().ToLowerInvariant() ?? "other";
    }

    // Both rows format the count directly.
    private string GetGroupedCount(decimal count)
        => PluralFormat.Evaluate(GroupedFormat, CultureState.Culture, LocalizedFormat.Bind(GroupedFormat, count));

    private string GetRawCount(decimal count)
        => LocalizedFormat.Render(RawFormat, LocalizedFormat.Bind(RawFormat, count), CultureState.Culture, CultureState.UICulture);
}
