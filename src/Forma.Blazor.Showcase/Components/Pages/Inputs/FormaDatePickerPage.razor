@page "/date-picker"
@attribute [ShowcasePage("FormaDatePicker")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Inputs
@inject IStringLocale<FormaDatePickerPage> L

<h1>FormaDatePicker</h1>
<p class="description">@L["A field for one date, picked from a calendar that opens under it. Month and day names follow the culture, and the calendar mirrors for a right-to-left reader."]</p>

<EditForm Model="Model" FormName="date-picker-demo" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="demo-section">
        <h2>@L["Basic"]</h2>
        <div class="demo-box">
            <FormaDatePicker @bind-Value="Model.Date" Label="@L["Date"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["With Minimum Date"]</h2>
        <div class="demo-box">
            <FormaDatePicker @bind-Value="Model.FutureDate"
                             Label="@L["Future Date Only"]"
                             MinDate="@DateOnly.FromDateTime(DateTime.Today)" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Pre-Filled"]</h2>
        <div class="demo-box">
            <FormaDatePicker @bind-Value="Model.PreFilled" Label="@L["Today"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Hebrew Calendar"]</h2>
        <p class="description">@L["The component adapts to the calendar system of the given culture. This demo uses he-IL with UseNonGregorianMonths to render the Hebrew (lunisolar) calendar with its month names."]</p>
        <div class="demo-box">
            <FormaDatePicker @bind-Value="Model.HebrewDate"
                             Label="@L["Hebrew Date"]"
                             UseNonGregorianMonths="true" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Required in a Form"]</h2>
        <p class="description">@L["A date picker is a form input: submitting without a date shows the validation message under it, and picking one clears it."]</p>
        <div class="demo-box">
            <FormaDatePicker @bind-Value="Model.Deadline" Label="@L["Deadline"]" />
            <div class="demo-row">
                <FormaButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary">@L["Submit"]</FormaButton>
                @if (_submitted)
                {
                    <span class="demo-note">@L["Submitted."]</span>
                }
            </div>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["A Date That Cannot Be Empty"]</h2>
        <p class="description">@L["Bound to a date rather than a nullable one, the field always holds a date: clearing it reports the field and keeps the date it held until another is picked."]</p>
        <div class="demo-box">
            <FormaDatePicker @bind-Value="Model.Renewal" Label="@L["Renewal Date"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Inside a Scrolling Container"]</h2>
        <p class="description">@L["The box below scrolls and would clip an ordinary popover. The calendar opens in the top layer instead, so it stays whole, and it follows the trigger as the box scrolls."]</p>
        <div class="demo-box demo-scroll-box">
            <div class="demo-scroll-filler"><p>@L["Scroll this box to move the field around."]</p></div>
            <FormaDatePicker @bind-Value="Model.ScrollableDate" Label="@L["Date in a scroll box"]" />
            <div class="demo-scroll-filler"><p>@L["Scroll this box to move the field around."]</p></div>
        </div>
    </div>
</EditForm>

@code {
    private bool _submitted;

    private DatePickerDemoModel Model { get; set; } = default!;

    protected override void OnInitialized()
        => Model = new DatePickerDemoModel(L) { PreFilled = DateOnly.FromDateTime(DateTime.Today), Renewal = DateOnly.FromDateTime(DateTime.Today) };

    private void HandleSubmit()
        => _submitted = true;

    private sealed class DatePickerDemoModel(IStringLocale<FormaDatePickerPage> localizer) : IValidatableObject
    {
        public DateOnly? Date { get; set; }
        public DateOnly? FutureDate { get; set; }
        public DateOnly? PreFilled { get; set; }
        public DateOnly? HebrewDate { get; set; }
        public DateOnly? Deadline { get; set; }
        public DateOnly Renewal { get; set; }
        public DateOnly? ScrollableDate { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Deadline is null)
            {
                yield return new ValidationResult(localizer["A deadline is required."], [nameof(Deadline)]);
            }
        }
    }
}
