@using Forma.Framework.Culture.Router.AspNetCore
@using Forma.Blazor.Showcase
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Http
@implements IDisposable
@inject CultureRouter Router
@inject CultureSwitcher Switcher
@inject NavigationManager Nav
@inject IStringLocale<ShowcaseTabs> L

@* Each variant links to a page of its own; the current one is matched on the path without its culture segment. *@
@if (_variants.Count > 0)
{
    <nav class="showcase-tabs" aria-label="@L["Variants"]">
        @foreach (var variant in _variants)
        {
            <a href="@Router.GetPath(Switcher.CurrentRoute, variant.Route)"
               class="@(IsCurrent(variant) ? "active" : null)"
               aria-current="@(IsCurrent(variant) ? "page" : null)">@variant.Variant</a>
        }
    </nav>
}

@code {
    private IReadOnlyList<ShowcasePage> _variants = [];

    private string _path = "/";

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
        Refresh();
    }

    /// <inheritdoc />
    public void Dispose()
        => Nav.LocationChanged -= HandleLocationChanged;

    // The layout outlives a navigation, so the strip is rebuilt on each one.
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        Refresh();
        StateHasChanged();
    }

    private void Refresh()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimStart('/');

        _path = Router.Match(new PathString("/" + relative)).Path.Value ?? "/";
        _variants = ShowcaseCatalog.GetVariants(_path);
    }

    private bool IsCurrent(ShowcasePage page)
        => string.Equals(page.Route.TrimEnd('/'), _path.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
}
