@using Forma.Features.Globalization
@using Forma.Blazor.Showcase
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Http
@implements IDisposable
@inject CultureRouter Router
@inject NavigationManager Nav
@inject IStringLocale<ShowcaseTabs> L

@* Each variant is a page of its own, so these are links in a nav rather than an ARIA tablist,
   which would promise panels on this same page. Which link is current is decided against the
   culture-stripped path rather than by NavLink, whose comparison a culture prefix defeats. *@
@if (_variants.Count > 0)
{
    <nav class="showcase-tabs" aria-label="@L["Variants"]">
        @foreach (var variant in _variants)
        {
            <a href="@Router.GetPath(Router.CurrentRoute, variant.Route)"
               class="@(IsCurrent(variant) ? "active" : null)"
               aria-current="@(IsCurrent(variant) ? "page" : null)">@variant.Variant</a>
        }
    </nav>
}

@code {
    private IReadOnlyList<ShowcasePage> _variants = [];

    private string _path = "/";

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
        Refresh();
    }

    /// <inheritdoc />
    public void Dispose()
        => Nav.LocationChanged -= HandleLocationChanged;

    // The layout outlives a navigation, so the strip has to be rebuilt rather than re-rendered as it stands.
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        Refresh();
        StateHasChanged();
    }

    private void Refresh()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimStart('/');

        _path = Router.Match(new PathString("/" + relative)).Path.Value ?? "/";
        _variants = ShowcaseCatalog.Variants(_path);
    }

    private bool IsCurrent(ShowcasePage page)
        => string.Equals(page.Route.TrimEnd('/'), _path.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
}
