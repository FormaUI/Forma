@rendermode InteractiveServer
@using Forma.Framework.Icons
@implements IDisposable
@inject IStringLocale<ShowcaseNav> L
@inject NavigationManager Nav

@* The stylesheet opens the drawer from the toggle's aria-expanded; where the sidebar is a drawer, this is the bar holding the toggle. *@
<div class="showcase-nav">
    <button type="button"
            class="showcase-nav-toggle"
            aria-expanded="@(_isOpen ? "true" : "false")"
            aria-label="@L["Pages"]"
            @onclick="() => _isOpen = !_isOpen">
        <FormaIcon Icon="Glyph.NavigationMenu" />
    </button>

    <ShowcaseSidebar />
</div>

@code {
    private bool _isOpen;

    /// <inheritdoc />
    protected override void OnInitialized()
        => Nav.LocationChanged += HandleLocationChanged;

    /// <inheritdoc />
    public void Dispose()
        => Nav.LocationChanged -= HandleLocationChanged;

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _isOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }
}
