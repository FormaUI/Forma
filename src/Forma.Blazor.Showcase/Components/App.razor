@using System.Globalization
@using Forma.Blazor.Components.Page

<!DOCTYPE html>
@* The Showcase changes language on purpose, so the page is not to be translated. *@
<html lang="@Lang" dir="@Dir" translate="no">
<head>
    <FormaPageHead Title="Forma Component Showcase" IconHref="@Assets["favicon.svg"]">
        <meta name="google" content="notranslate" />
        <link rel="stylesheet" href="@Assets["app.css"]" />
        <link rel="stylesheet" href="@Assets["Forma.Blazor.Showcase.styles.css"]" />
        <PageLocalization />
    </FormaPageHead>
</head>
<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    private string Lang => CultureInfo.CurrentUICulture.Name;
    private string Dir => CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
