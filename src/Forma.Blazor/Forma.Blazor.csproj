<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <StaticWebAssetBasePath>_content/$(AssemblyName)</StaticWebAssetBasePath>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeBundledProjectsInPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0-preview.6.26359.118" />
    </ItemGroup>

    <!-- The component feature vocabularies and the interop assemblies ship inside this package. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Files\Forma.Framework.Files.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Feedback\Forma.Framework.Feedback.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Media\Forma.Framework.Media.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Windows\Forma.Framework.Windows.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Toolbar\Forma.Framework.Toolbar.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Input\Forma.Framework.Input.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Input.Interop\Forma.Framework.Input.Interop.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Core.Interop\Forma.Framework.Core.Interop.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Common.Interop\Forma.Framework.Common.Interop.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!-- The packable Framework assemblies are package dependencies, including the ones the bundled assemblies reach. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Share\Forma.Framework.Share.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Css\Forma.Framework.Css.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Events\Forma.Framework.Events.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Timing\Forma.Framework.Timing.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Icons\Forma.Framework.Icons.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Icons.Glyphs\Forma.Framework.Icons.Glyphs.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Emojis\Forma.Framework.Emojis.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Emojis.Unicode\Forma.Framework.Emojis.Unicode.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Resources\Forma.Framework.Resources.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Sanitization\Forma.Framework.Sanitization.csproj" />
    </ItemGroup>

    <Import Project="$(BundledPackageTargets)" />

    <!-- The translations embed in the assembly itself rather than in satellite assemblies, so packing them again as content only duplicates them. -->
    <ItemGroup>
        <EmbeddedResource Include="Components\**\*.json" WithCulture="false" />
        <Content Remove="Components\**\*.json" />
    </ItemGroup>

</Project>
