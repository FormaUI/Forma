@namespace Forma.Blazor.Components.Inputs
@inherits FormaComponentBase
@using Forma.Blazor.Components.Feedback
@using Forma.Framework.Browser.Interop.Behaviors

<div class="forma-date-box">
    <div class="forma-date-box-trigger-wrapper" @ref="_anchorElement">
        <button id="@ElementId"
                data-rid="@OwnerRuntimeId"
                class="@TriggerClassList"
                style="@TriggerStyle"
                @attributes="TriggerAttributes"
                @ref="TriggerElement"
                type="button"
                aria-expanded="@(IsOpen ? "true" : "false")"
                aria-required="@(Required ? "true" : null)"
                aria-labelledby="@LabelledBy"
                aria-describedby="@TriggerDescribedBy"
                @onclick="ToggleAsync">
            <span class="forma-date-box-arrow" aria-hidden="true">&#9662;</span>
            <span id="@ValueId" class="forma-date-box-value@(HasValue ? "" : " placeholder")">@(HasValue ? DisplayText : L["Select Date"])</span>
        </button>
        @if (HasValue)
        {
            <FormaButton Variant="ButtonVariant.Ghost"
                         Size="ButtonSize.Mini"
                         IconOnly="true"
                         class="forma-date-box-clear"
                         aria-label="@L["Clear"]"
                         OnClick="ClearAsync"
                         :stopPropagation>
                <FormaIcon Icon="Glyph.Cross" />
            </FormaButton>
        }
    </div>
    <FormaPopover @ref="Popover" Alignment="PopoverAlignment.Start" Anchor="_anchorElement" OnOpenChanged="_ => { }">
        <div class="forma-date-box-popover">
            <FormaCalendar Highlight="Highlight"
                           MinDate="MinDate"
                           MaxDate="MaxDate"
                           UseNonGregorianMonths="UseNonGregorianMonths"
                           OnDaySelected="ChooseAsync" />
        </div>
    </FormaPopover>
</div>
