@namespace Forma.Blazor.Components.Inputs
@typeparam TValue
@inherits FormaInputBase<TValue>

<FormaField Label="@Label" TargetId="@ElementId" LabelId="@LabelId" Field="@FieldIdentifier" MessageContainerId="@MessageContainerId" Required="@IsRequired" LabelMode="FieldLabelMode.Pinned">
    <ChildContent>
        <FormaDateBox @ref="Box"
                      ElementId="@ElementId"
                      OwnerRuntimeId="@Context.RuntimeId"
                      Date="@Date"
                      MinDate="MinDate"
                      MaxDate="MaxDate"
                      UseNonGregorianMonths="UseNonGregorianMonths"
                      OnChoose="SelectDayAsync"
                      OnClear="HandleClear"
                      Required="@IsRequired"
                      NameId="@LabelId"
                      TriggerClass="@RootClass"
                      TriggerStyle="@RootStyle"
                      TriggerAttributes="AdditionalAttributes"
                      TriggerDescribedBy="@DescribedBy" />
    </ChildContent>
</FormaField>
