@namespace Forma.Blazor.Components.Inputs
@inherits FormaElementBase

@{
    RenderFragment input = @<input id="@Id"
                                   data-rid="@RuntimeId"
                                   class="@RootClass"
                                   style="@RootStyle"
                                   @attributes="AdditionalAttributes"
                                   @ref="RootElement"
                                   type="checkbox"
                                   checked="@Checked"
                                   disabled="@Disabled"
                                   @onchange="HandleChangeAsync"
                                   @onclick="HandleClickAsync"
                                   @onclick:preventDefault="@PreventDefault" />;
}

@if (ChildContent is null)
{
    @input
}
else
{
    <label class="forma-checkbox-label">
        @input
        @ChildContent
    </label>
}
