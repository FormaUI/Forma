@namespace Forma.Blazor.Components.Inputs
@typeparam TValue
@inherits FormaInputBase<TValue>

@{
    RenderFragment box =
        @<input id="@ElementId"
                data-rid="@Context.RuntimeId"
                class="@RootClass"
                style="@RootStyle"
                @attributes="AdditionalAttributes"
                @ref="RootElement"
                aria-describedby="@DescribedBy"
                type="text"
                dir="ltr"
                role="spinbutton"
                inputmode="@InputModeValue"
                placeholder="@EffectivePlaceholder"
                value="@(_unreadText ?? CurrentValueAsString)"
                disabled="@Disabled"
                readonly="@ReadOnly"
                aria-required="@(IsRequired ? "true" : null)"
                aria-valuenow="@ValueNow"
                aria-valuetext="@ValueText"
                aria-valuemin="@FormatLimit(Min)"
                aria-valuemax="@FormatLimit(Max)"
                @onchange="HandleChange" />;
}

@if (HasLabel)
{
    <FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" ElementIds="FieldElementIds" Required="@IsRequired" style="@FieldStyle">
        <ChildContent>
            @box
        </ChildContent>
    </FormaField>
}
else
{
    @box
}
