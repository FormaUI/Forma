@namespace Forma.Blazor.Components.Inputs
@inherits FormaInputBase<bool>

<FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" LabelMode="FieldLabelMode.Inline">
    <ChildContent>
        <div class="forma-toggle-switch-wrapper">
            @if (OffLabel is not null)
            {
                <span class="forma-toggle-switch-label forma-toggle-switch-off-label">@OffLabel</span>
            }
            <label class="@(Disabled ? "forma-toggle-switch disabled" : "forma-toggle-switch")">
                <input id="@ElementId"
                       data-rid="@Context.RuntimeId"
                       class="@RootClass"
                       style="@RootStyle"
                       @attributes="AdditionalAttributes"
                       @ref="RootElement"
                       type="checkbox"
                       role="switch"
                       checked="@CurrentValue"
                       @onchange="HandleChange"
                       disabled="@Disabled" />
                <span class="forma-toggle-switch-track" aria-hidden="true">
                    @* The mark shows on and off apart from the track color. *@
                    <span class="forma-toggle-switch-mark"><FormaIcon Icon="@(CurrentValue ? Glyph.Check : Glyph.Cross)" /></span>
                    <span class="forma-toggle-switch-knob"></span>
                </span>
            </label>
            @if (OnLabel is not null)
            {
                <span class="forma-toggle-switch-label forma-toggle-switch-on-label">@OnLabel</span>
            }
        </div>
    </ChildContent>
</FormaField>
