@namespace Forma.Blazor.Components.Inputs
@typeparam TValue where TValue : struct, System.Numerics.INumber<TValue>
@inherits FormaInputBase<TValue>

<FormaField Label="@Label" TargetId="@ElementId" LabelMode="FieldLabelMode.Above">
    <ChildContent>
        @* Sits on the label's row, so the reading stays beside the name it belongs to. *@
        <span class="forma-slider-value" aria-hidden="true"><bdi dir="ltr">@DisplayValue</bdi></span>
        <input id="@ElementId"
               data-rid="@RuntimeId"
               class="@RootClass"
               style="@RootStyle"
               @attributes="AdditionalAttributes"
               @ref="RootElement"
               type="range"
               min="@FormatInvariant(Min)"
               max="@FormatInvariant(Max)"
               step="@FormatInvariant(Step)"
               value="@CurrentValueAsString"
               disabled="@Disabled"
               aria-valuetext="@AriaValueText"
               @oninput="@(args => CurrentValueAsString = args.Value?.ToString())" />
    </ChildContent>
    <Validation>
        <ValidationMessage For="@ValueExpression" />
    </Validation>
</FormaField>
