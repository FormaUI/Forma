@namespace Forma.Blazor.Components.Inputs
@inherits FormaInputBase<DateRange?>
@using Forma.Framework.Common.Interop.Behaviors
@using Forma.Blazor.Models

<FormaField Label="@Label" TargetId="@ElementId" LabelMode="FieldLabelMode.Pinned">
    <ChildContent>
        <div class="forma-date-range-picker">
            <div class="forma-date-range-picker-trigger-wrapper" @ref="_anchorElement">
                <button id="@ElementId"
                        data-rid="@Context.RuntimeId"
                        class="@RootClass"
                        style="@RootStyle"
                        @attributes="AdditionalAttributes"
                        @ref="RootElement"
                        type="button"
                        aria-expanded="@(IsOpen ? "true" : "false")"
                        @onclick="ToggleAsync">
                    <span class="forma-date-range-picker-arrow">&#9662;</span>
                    <span class="forma-date-range-picker-value@(HasValue ? "" : " placeholder")">@(HasValue ? DisplayText : L["Select Range"])</span>
                </button>
                @if (HasValue)
                {
                    <FormaButton Variant="ButtonVariant.Ghost"
                                 Size="ButtonSize.Mini"
                                 IconOnly="true"
                                 class="forma-date-range-picker-clear"
                                 aria-label="@L["Clear"]"
                                 OnClick="HandleClearAsync"
                                 :stopPropagation>
                        <FormaIcon Icon="Glyph.Cross" />
                    </FormaButton>
                }
            </div>
            <FormaPopover @ref="Popover" Alignment="PopoverAlignment.Start" Anchor="_anchorElement" OnOpenChanged="_ => { }">
                <div class="forma-date-range-picker-popover">
                    <FormaCalendar Months="2"
                                   Highlight="Highlight"
                                   MinDate="MinDate"
                                   MaxDate="MaxDate"
                                   UseNonGregorianMonths="UseNonGregorianMonths"
                                   OnDaySelected="SelectDayAsync"
                                   OnDayHovered="HoverDay" />
                    @if (ShowPresets)
                    {
                        <div class="forma-date-range-picker-presets" dir="@TextDirection">
                            <FormaButton Variant="ButtonVariant.Ghost"
                                         class="forma-date-range-picker-preset"
                                         Disabled="IsPresetDisabled(Preset.Today)"
                                         OnClick="() => ApplyPresetAsync(Preset.Today)">
                                @L["Today"]
                            </FormaButton>
                            <FormaButton Variant="ButtonVariant.Ghost"
                                         class="forma-date-range-picker-preset"
                                         Disabled="IsPresetDisabled(Preset.Yesterday)"
                                         OnClick="() => ApplyPresetAsync(Preset.Yesterday)">
                                @L["Yesterday"]
                            </FormaButton>
                            <FormaButton Variant="ButtonVariant.Ghost"
                                         class="forma-date-range-picker-preset"
                                         Disabled="IsPresetDisabled(Preset.Last7Days)"
                                         OnClick="() => ApplyPresetAsync(Preset.Last7Days)">
                                @L["[$ plural; one: Last # day; other: Last # days; $]", ShortRangeDays]
                            </FormaButton>
                            <FormaButton Variant="ButtonVariant.Ghost"
                                         class="forma-date-range-picker-preset"
                                         Disabled="IsPresetDisabled(Preset.Last30Days)"
                                         OnClick="() => ApplyPresetAsync(Preset.Last30Days)">
                                @L["[$ plural; one: Last # day; other: Last # days; $]", LongRangeDays]
                            </FormaButton>
                            <FormaButton Variant="ButtonVariant.Ghost"
                                         class="forma-date-range-picker-preset"
                                         Disabled="IsPresetDisabled(Preset.ThisMonth)"
                                         OnClick="() => ApplyPresetAsync(Preset.ThisMonth)">
                                @L["This Month"]
                            </FormaButton>
                            <FormaButton Variant="ButtonVariant.Ghost"
                                         class="forma-date-range-picker-preset"
                                         Disabled="IsPresetDisabled(Preset.LastMonth)"
                                         OnClick="() => ApplyPresetAsync(Preset.LastMonth)">
                                @L["Last Month"]
                            </FormaButton>
                        </div>
                    }
                </div>
            </FormaPopover>
        </div>
    </ChildContent>
    <Validation>
        <ValidationMessage For="@ValueExpression" />
    </Validation>
</FormaField>
