@typeparam TValue
@namespace Forma.Blazor.Components.Inputs
@inherits FormaInputBase<TValue>

<FormaField Label="@Label" TargetId="@ElementId" Required="@Required" LabelMode="FieldLabelMode.Pinned">
    <ChildContent>
        <div class="forma-select-trigger-wrapper" @ref="_anchorElement">
            <button id="@ElementId"
                    data-rid="@RuntimeId"
                    class="@RootClass"
                    style="@RootStyle"
                    @attributes="AdditionalAttributes"
                    @ref="RootElement"
                    type="button"
                    disabled="@Disabled"
                    aria-haspopup="listbox"
                    aria-expanded="@(IsOpen ? "true" : "false")"
                    aria-controls="@(IsOpen ? PopoverId : null)"
                    aria-required="@(Required ? "true" : null)"
                    @onclick="ToggleAsync"
                    @onkeydown="HandleTriggerKeyDownAsync">
                <span class="forma-select-trigger-text@(FindSelectedOption() is null ? " placeholder" : "")">@TriggerText</span>
                <span class="forma-select-arrow" aria-hidden="true">&#9662;</span>
            </button>
        </div>
        <FormaPopover @ref="Popover"
                    Anchor="_anchorElement"
                    OnOpenChanged="_ => { }"
                    OnOpened="HandleOpenedAsync"
                    OnKeyDown="HandlePopoverKeyDownAsync">
            <div class="forma-select-popover"
                 id="@PopoverId"
                 role="listbox"
                 aria-label="@Label">
                @for (var i = 0; i < Options.Count; i++)
                {
                    var optionIndex = i;
                    var option = Options[optionIndex];
                    var selected = IsSelected(option);
                    <button type="button"
                            class="forma-select-option@(selected ? " selected" : "")"
                            role="option"
                            tabindex="-1"
                            aria-selected="@(selected ? "true" : "false")"
                            @ref="_optionElements[optionIndex]"
                            @onclick="() => SelectAsync(option)">
                        <span class="forma-select-option-label">@option.Label</span>
                        @if (selected)
                        {
                            <span class="forma-select-option-check" aria-hidden="true">&#10003;</span>
                        }
                    </button>
                }
                @if (Options.Count == 0)
                {
                    <div class="forma-select-empty">@L["No options available yet"]</div>
                }
            </div>
        </FormaPopover>
    </ChildContent>
    <Validation>
        <ValidationMessage For="@ValueExpression" />
    </Validation>
</FormaField>
