@namespace Forma.Blazor.Components
@inherits FormaElementBase

<div id="@Id"
     data-rid="@RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement"
     inert="@Hidden">
