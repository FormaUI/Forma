@namespace Forma.Blazor.Components.Interactive

<CascadingValue Value="this" IsFixed="true">
    @* Keydown is caught on the wrapper because it bubbles from the button, which a
       component tag cannot carry a handler for directly. *@
    <span class="forma-dropdown-menu-anchor" @ref="_anchorElement" @onkeydown="HandleTriggerKeyDown">
        <FormaButton @ref="_trigger"
                     @attributes="TriggerAttributes"
                     Variant="TriggerOptions.Variant"
                     Size="TriggerOptions.Size"
                     IconOnly="TriggerOptions.IconOnly"
                     OnClick="Toggle">
            @Trigger
        </FormaButton>
    </span>

    @if (_isOpen)
    {
        <div class="forma-dropdown-menu-backdrop" @onclick="Close"></div>
        @* Manual rather than auto: the backdrop above owns dismissal, which also sidesteps
           the iOS 17–18.2 bug where a popover ignores a tap outside it. *@
        <div class="forma-dropdown-menu"
             id="@_popupId"
             role="menu"
             popover="manual"
             @ref="_popupElement"
             @onkeydown="HandlePopupKeyDownAsync">
            @ChildContent
        </div>
    }
</CascadingValue>
