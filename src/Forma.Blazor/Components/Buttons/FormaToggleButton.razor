@namespace Forma.Blazor.Components.Buttons
@* The shell carries this component's style scope. *@
<span class="forma-toggle-button-shell">
    <FormaButton @attributes="AdditionalAttributes"
                 Variant="ButtonVariant.Ghost"
                 IconOnly="!ShowsLabel"
                 Disabled="Disabled"
                 class="@CssClass"
                 aria-label="@(ShowsLabel ? null : Label)"
                 aria-pressed="@AriaPressed"
                 OnClick="OnClick">
        @if (Icon is { } icon)
        {
            <FormaIcon Icon="icon" Size="IconSize.Small" />
        }
        @if (ShowsLabel)
        {
            <span>@Label</span>
        }
    </FormaButton>
</span>
