@namespace Forma.Blazor.Components.Buttons
@inherits FormaElementBase

<FormaButton Id="@Id"
             Class="@RootClass"
             Style="@RootStyle"
             @attributes="AdditionalAttributes"
             Variant="ButtonVariant.Ghost"
             Size="Size"
             IconOnly="true"
             Disabled="Disabled"
             OnClick="OnClick"
             aria-label="@Label">
    <FormaIcon Icon="@(Revealed ? Glyph.Eye : Glyph.EyeSlash)" Size="IconSize.Small" />
</FormaButton>
