@namespace Forma.Blazor.Components.Design

@if (_artwork is BrandIconArtwork brand)
{
    <svg class="@CssClass"
         viewBox="@brand.ViewBox"
         fill="currentColor"
         role="img"
         aria-label="@brand.Title"
         focusable="false">@foreach (var path in brand.Paths)
                           {
                               <path d="@path.Data" />
                           }</svg>
}
else if (_artwork is IconVector vector)
{
    <svg class="@CssClass"
         viewBox="@vector.ViewBox"
         fill="currentColor"
         aria-hidden="true"
         focusable="false">@foreach (var path in _vectorPaths)
                           {
                               if (path.StrokeWidth is not null)
                               {
                                   <path d="@path.Data" fill="none" stroke="currentColor" stroke-width="@path.StrokeWidth" stroke-linecap="round" stroke-linejoin="round" opacity="@path.Opacity" />
                               }
                               else
                               {
                                   <path d="@path.Data" fill-rule="evenodd" opacity="@path.Opacity" />
                               }
                           }</svg>
}
else if (_characterText is not null)
{
    <span class="@CssClass forma-icon-character" aria-hidden="true">@_characterText</span>
}
