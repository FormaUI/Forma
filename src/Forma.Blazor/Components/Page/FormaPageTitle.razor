@inherits FormaElementBase
@using Forma.Blazor.Components.Navigation

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    <div>
        <h1 class="forma-page-title-heading">@Title</h1>

        @if (RenderedBreadcrumbs is { Count: > 0 })
        {
            <FormaBreadcrumb Items="RenderedBreadcrumbs" />
        }
    </div>

    @if (Actions is not null)
    {
        <div class="forma-page-title-actions">
            @Actions
        </div>
    }
</div>
