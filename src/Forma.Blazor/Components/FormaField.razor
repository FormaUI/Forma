@namespace Forma.Blazor.Components
@inherits FormaElementBase

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    @ChildContent
    @if (HasLabel)
    {
        <label id="@LabelId" for="@TargetId" class="forma-field-label">
            @Label@if (Required) {<span class="forma-field-required" aria-hidden="true"> *</span>}
        </label>
    }
    @if (ValidationMessages is { Count: > 0 } messages)
    {
        <div id="@MessageContainerId" class="forma-field-messages">
            @foreach (var message in messages)
            {
                <div class="forma-field-message">@message</div>
            }
        </div>
    }
</div>
