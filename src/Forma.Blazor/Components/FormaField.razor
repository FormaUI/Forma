@namespace Forma.Blazor.Components
@inherits FormaElementBase

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    @ChildContent
    @if (HasLabel)
    {
        <label for="@TargetId" class="forma-field-label">
            @Label@if (Required) {<span class="forma-field-required" aria-hidden="true"> *</span>}
        </label>
    }
    @Validation
</div>
