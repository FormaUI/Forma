@namespace Forma.Blazor.Components.Explorer
@using Forma.Blazor.Components.Menus
@using Forma.Features.Explorer

@{
    var children = Sidebar.ChildrenOf(Item.Key);
    var expanded = Sidebar.IsExpanded(Item.Key);
    var isCurrent = Sidebar.IsCurrent(Item);
    var selected = Sidebar.Selection.IsSelected(Item);
    var selectable = Sidebar.Selection.IsSelectionModeActive;
    var allowed = Item.Capabilities & Sidebar.ItemOptions.AllowedFolderCapabilities;
    var hasActions = !selectable && (allowed & (ExplorerItemCapabilities.Create | ExplorerItemCapabilities.Rename | ExplorerItemCapabilities.Delete)) != ExplorerItemCapabilities.None;
    var draggable = allowed.HasFlag(ExplorerItemCapabilities.Drag) ? "true" : "false";
}

<li role="treeitem"
    aria-selected="@(isCurrent ? "true" : "false")"
    aria-expanded="@(children.Count == 0 ? null : expanded ? "true" : "false")">
    <div class="forma-explorer-folder-row @(isCurrent ? "is-active" : "") @(selected ? "is-selected" : "")"
         style="--forma-explorer-folder-depth: @Depth"
         draggable="@draggable"
         @ondragstart="() => Interaction.BeginFolderDragAsync(Item)"
         @ondragover="args => FormaExplorerSidebar.HandleDragOver(args)"
         @ondragover:preventDefault="true"
         @ondrop="() => Interaction.DropOnFolderAsync(Item)">
        @if (hasActions)
        {
            <div class="forma-explorer-folder-actions">
                <FormaOverflowMenu Label="@L["Actions for {Name}", Item.Name]"
                                   Orientation="MenuOrientation.Vertical"
                                   TriggerOptions="ButtonOptions.MiniGhostIcon">
                    <HeaderContent>
                        <span title="@Item.Name">@Item.Name</span>
                    </HeaderContent>
                    <ChildContent>
                        @if (allowed.HasFlag(ExplorerItemCapabilities.Create))
                        {
                            <FormaDropDownMenuItem data-action="folder-create" OnClick="() => Interaction.CreateFolderAsync(Item)">
                                <FormaIcon Icon="Glyph.FolderAdd" Size="IconSize.Small" />
                                <span>@L["New Folder"]</span>
                            </FormaDropDownMenuItem>
                        }
                        @if (allowed.HasFlag(ExplorerItemCapabilities.Rename))
                        {
                            <FormaDropDownMenuItem data-action="folder-rename" OnClick="() => Interaction.RenameFolderAsync(Item)">
                                <FormaIcon Icon="Glyph.Pen" Size="IconSize.Small" />
                                <span>@L["Rename Folder"]</span>
                            </FormaDropDownMenuItem>
                        }
                        @if (allowed.HasFlag(ExplorerItemCapabilities.Delete))
                        {
                            <FormaDropDownMenuItem data-action="folder-delete" IsDestructive="true" OnClick="() => Interaction.DeleteFolderAsync(Item)">
                                <FormaIcon Icon="Glyph.Delete" Size="IconSize.Small" />
                                <span>@L["Delete Folder"]</span>
                            </FormaDropDownMenuItem>
                        }
                    </ChildContent>
                </FormaOverflowMenu>
            </div>
        }

        @if (selectable)
        {
            <button type="button"
                    class="forma-explorer-folder-select @(selected ? "is-checked" : "")"
                    aria-label="@(selected ? L["Deselect Folder \"{Name}\"", Item.Name] : L["Select Folder \"{Name}\"", Item.Name])"
                    aria-pressed="@(selected ? "true" : "false")"
                    @onclick="() => Interaction.ToggleFolderSelectAsync(Item)">
                <FormaIcon Icon="Glyph.Check" Size="IconSize.Small" />
            </button>
        }

        @if (children.Count > 0)
        {
            <button type="button"
                    class="forma-explorer-folder-twisty @(expanded ? "is-expanded" : "")"
                    aria-label="@(expanded ? L["Collapse {Name}", Item.Name] : L["Expand {Name}", Item.Name])"
                    @onclick="() => Interaction.ToggleExpanded(Item.Key)">
                <FormaIcon Icon="Glyph.ChevronRight" Size="IconSize.Small" />
            </button>
        }
        else
        {
            <span class="forma-explorer-folder-twisty is-empty" aria-hidden="true"></span>
        }

        <button type="button"
                class="forma-explorer-folder-target"
                @onclick="() => Interaction.SelectFolderAsync(Item)">
            <span class="forma-explorer-folder-icon" aria-hidden="true"><FormaIcon Icon="@(isCurrent ? Glyph.FolderOpen : Glyph.Folder)" Size="IconSize.Small" /></span>
            <span class="forma-explorer-folder-name" title="@Item.Name">@Item.Name</span>
        </button>

        @if (Item.Count is { } count)
        {
            <span class="forma-explorer-folder-count">@count</span>
        }
    </div>

    @if (children.Count > 0 && expanded)
    {
        <ul class="forma-explorer-folder-branch" role="group">
            @foreach (var child in children)
            {
                <FormaExplorerFolderNode Item="child" Depth="Depth + 1" />
            }
        </ul>
    }
</li>
