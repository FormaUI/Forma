@namespace Forma.Blazor.Components.Explorer
@using Forma.Framework.Resources

@if (Resource is ImageResourceInfo)
{
    <img src="@Resource.Source" alt="" class="forma-explorer-thumbnail @SizeClass" loading="lazy" />
}
else
{
    <span class="forma-explorer-thumbnail forma-explorer-thumbnail-glyph @SizeClass" aria-hidden="true"><FormaIcon Icon="KindGlyph" /></span>
}
