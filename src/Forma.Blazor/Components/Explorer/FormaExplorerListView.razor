@namespace Forma.Blazor.Components.Explorer
@using Forma.Features.Explorer

<div class="forma-explorer-list" role="list">
    @foreach (var item in Items)
    {
        var selected = View.Selection.IsSelected(item);
        var selecting = View.Selection.IsSelectionModeActive;
        var labels = item.GetLocalizedLabels(L, View.Selection);
        var capabilities = item.GetCapabilities(View.Item.ItemOptions);
        var draggable = capabilities.HasFlag(ExplorerItemCapabilities.Drag) ? "true" : "false";

        <div class="forma-explorer-list-item @(selected ? "is-selected" : "") @item.GetStateClasses()"
             role="listitem"
             draggable="@draggable"
             @ondragstart="() => ItemInteraction.BeginDrag(item)">
            @if (selecting)
            {
                <button type="button"
                        class="forma-explorer-list-select @(selected ? "is-checked" : "")"
                        aria-label="@labels.SelectionLabel"
                        aria-pressed="@(selected ? "true" : "false")"
                        disabled="@item.IsDisabled"
                        @onclick="() => Interaction.ToggleSelectionAsync(item)">
                    <FormaIcon Icon="Glyph.Check" Size="IconSize.Small" />
                </button>
            }
            else
            {
                <FormaExplorerActionBar Item="item" />
            }

            <button type="button"
                    class="forma-explorer-list-main"
                    aria-label="@labels.ActivationLabel"
                    disabled="@item.IsDisabled"
                    @onclick="() => ItemInteraction.ActivateAsync(item)">
                <span class="forma-explorer-list-media">
                    @if (item.Resource is { } resource)
                    {
                        <FormaExplorerThumbnail Resource="resource" Size="ExplorerThumbnailSize.Row" />
                    }
                </span>

                <span class="forma-explorer-list-info">
                    <span class="forma-explorer-list-name" title="@item.Name">@item.Name</span>
                    @if (item.Resource?.DisplaySize is { } size)
                    {
                        <span class="forma-explorer-list-size" dir="auto">@size</span>
                    }
                </span>
            </button>
        </div>
    }
</div>
