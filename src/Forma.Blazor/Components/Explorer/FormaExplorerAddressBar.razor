@namespace Forma.Blazor.Components.Explorer

<div class="forma-explorer-address-bar @(!string.IsNullOrEmpty(Search.SearchQuery) ? "has-search-query" : "")">
    <div class="forma-explorer-nav-buttons" role="group" aria-label="@L["Navigation"]">
        <FormaButton Variant="ButtonVariant.Ghost" IconOnly="true" class="forma-explorer-nav-button" Disabled="@(!Location.CanGoBack)" aria-label="@L["Back"]" OnClick="LocationInteraction.GoBackAsync">
            <span class="forma-explorer-nav-arrow" aria-hidden="true"><FormaIcon Icon="Glyph.ArrowLeft" /></span>
        </FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost" IconOnly="true" class="forma-explorer-nav-button" Disabled="@(!Location.CanGoForward)" aria-label="@L["Forward"]" OnClick="LocationInteraction.GoForwardAsync">
            <span class="forma-explorer-nav-arrow" aria-hidden="true"><FormaIcon Icon="Glyph.ArrowRight" /></span>
        </FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost" IconOnly="true" class="forma-explorer-nav-button" Disabled="@(!Location.CanGoUp)" aria-label="@L["Up to Parent Folder"]" OnClick="LocationInteraction.GoUpAsync">
            <FormaIcon Icon="Glyph.ArrowUp" />
        </FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost" IconOnly="true" class="forma-explorer-nav-button" aria-label="@L["Refresh"]" OnClick="Interaction.RefreshAsync">
            <FormaIcon Icon="Glyph.Refresh" />
        </FormaButton>
    </div>

    <FormaExplorerBreadcrumb />

    <div class="forma-explorer-search-wrapper @(CollapsesSearch ? "is-collapsible" : "")">
        <FormaExplorerSearch Collapsible="CollapsesSearch" />
    </div>
</div>
