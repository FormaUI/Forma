@namespace Forma.Blazor.Components.Explorer
@using Forma.Blazor.Components.Navigation

<div class="forma-explorer-address-bar @(!string.IsNullOrEmpty(SearchQuery) ? "has-search-query" : "")">
    <div class="forma-explorer-nav-buttons" role="group" aria-label="@L["Navigation"]">
        <FormaButton Variant="ButtonVariant.Ghost" IconOnly="true" class="forma-explorer-nav-button" Disabled="@(!CanGoBack)" aria-label="@L["Back"]" OnClick="OnBack">
            <span class="forma-explorer-nav-arrow" aria-hidden="true"><FormaIcon Icon="Glyph.ArrowLeft" /></span>
        </FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost" IconOnly="true" class="forma-explorer-nav-button" Disabled="@(!CanGoForward)" aria-label="@L["Forward"]" OnClick="OnForward">
            <span class="forma-explorer-nav-arrow" aria-hidden="true"><FormaIcon Icon="Glyph.ArrowRight" /></span>
        </FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost" IconOnly="true" class="forma-explorer-nav-button" Disabled="@(!CanGoUp)" aria-label="@L["Up to Parent Folder"]" OnClick="OnUp">
            <FormaIcon Icon="Glyph.ArrowUp" />
        </FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost" IconOnly="true" class="forma-explorer-nav-button" aria-label="@L["Refresh"]" OnClick="OnRefresh">
            <FormaIcon Icon="Glyph.Refresh" />
        </FormaButton>
    </div>

    <div class="forma-explorer-breadcrumb-bar">
        <FormaBreadcrumb Items="Items"
                        RootIcon="Glyph.FolderOpen"
                        AriaLabel="@L["Folder Path"]"
                        OnItemClick="OnFolderSelected"
                        OnItemDrop="OnBreadcrumbDrop" />
    </div>

    <div class="forma-explorer-search-wrapper">
        <FormaSearchBox Value="@SearchQuery"
                        ValueChanged="HandleSearchValueChangedAsync"
                        Placeholder="@SearchPlaceholder"
                        aria-label="@SearchPlaceholder" />
    </div>
</div>
