@namespace Forma.Blazor.Components.Explorer
@using Forma.Blazor.Components.Menus
@using Forma.Features.Explorer

@if (AvailableActions.Count > 0)
{
<div class="forma-explorer-action-bar">
    <FormaOverflowMenu Label="@Item.ActionsLabel(L)"
                       Orientation="MenuOrientation.Vertical"
                       TriggerOptions="ButtonOptions.MiniGhostIcon">
        <HeaderContent>
            <span title="@Item.Name">@Item.Name</span>
        </HeaderContent>
        <ChildContent>
            @foreach (var action in AvailableActions)
            {
                <FormaDropDownMenuItem IsDestructive="action.IsDestructive"
                                       data-action="@action.Id"
                                       OnClick="() => action.InvokeAsync(Item)">
                    <FormaIcon Icon="action.Icon" Size="IconSize.Small" />
                    <span>@action.Label()</span>
                </FormaDropDownMenuItem>
            }
        </ChildContent>
    </FormaOverflowMenu>
</div>
}
