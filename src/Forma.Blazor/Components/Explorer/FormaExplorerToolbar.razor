@namespace Forma.Blazor.Components.Explorer
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Layout
@using Forma.Blazor.Components.Menus
@using Forma.Framework.Explorer.Content

<div class="forma-explorer-toolbar">
    @if (View.Selection.Count > 0)
    {
        <FormaExplorerSelectionBar />
    }
    else
    {
    <FormaCommandBar Class="forma-explorer-toolbar-bar" role="toolbar" aria-label="@L["Toolbar"]">
    <div class="forma-explorer-toolbar-left">
        @if (View.CanLeaveSelectMode())
        {
            <FormaToggleButton Icon="@(View.Selection.IsSelectionModeActive ? Glyph.Cross : Glyph.Select)"
                                Label="@(View.Selection.IsSelectionModeActive ? L["Cancel"] : L["Select"])"
                                ShowLabel="true"
                                Pressed="View.Selection.IsSelectionModeActive"
                                class="forma-explorer-select-mode-button"
                                OnClick="Interaction.ToggleSelectionModeAsync" />
        }
        @if (View.ShowsNewFolderAction())
        {
            <FormaToggleButton Icon="Glyph.FolderAdd" Label="@L["New Folder"]" ShowLabel="true" class="forma-explorer-new-folder-button" OnClick="ItemInteraction.RequestNewFolderAsync" />
        }
        @if (View.Item.ItemOptions.AllowUpload)
        {
            <FormaToggleButton Icon="Glyph.CloudUpload" Label="@L["Upload"]" ShowLabel="true" class="forma-explorer-upload-button" OnClick="ItemInteraction.ToggleUpload" />
        }
    </div>

    <div class="forma-explorer-toolbar-right">
        <!-- View Mode Switcher -->
        <div class="forma-explorer-view-modes" role="group" aria-label="@L["View Mode"]">
            <FormaToggleButton Icon="Glyph.GridView"
                                Label="@L["Thumbnails"]"
                                class="forma-explorer-view-button"
                                Pressed="@(View.ViewMode == ExplorerViewMode.Thumbnails)"
                                OnClick="() => Interaction.ChangeViewModeAsync(ExplorerViewMode.Thumbnails)" />
            <FormaToggleButton Icon="Glyph.DetailsView"
                                Label="@L["Details"]"
                                class="forma-explorer-view-button"
                                Pressed="@(View.ViewMode == ExplorerViewMode.Details)"
                                OnClick="() => Interaction.ChangeViewModeAsync(ExplorerViewMode.Details)" />
            <FormaToggleButton Icon="Glyph.List"
                                Label="@L["List"]"
                                class="forma-explorer-view-button"
                                Pressed="@(View.ViewMode == ExplorerViewMode.List)"
                                OnClick="() => Interaction.ChangeViewModeAsync(ExplorerViewMode.List)" />
        </div>

        @if (View.ViewMode == ExplorerViewMode.Details)
        {
            <FormaDropDownMenu class="forma-explorer-columns-trigger"
                               TriggerOptions="ColumnsTriggerOptions"
                               aria-label="@L["Columns"]">
                <Trigger>
                    <FormaIcon Icon="Glyph.Columns" Size="IconSize.Small" />
                </Trigger>
                <ChildContent>
                    <FormaExplorerColumnsMenuItems />
                </ChildContent>
            </FormaDropDownMenu>
        }

        <!-- Sort Menu -->
        <FormaDropDownMenu class="forma-explorer-sort-trigger"
                           TriggerOptions="SortTriggerOptions"
                           aria-label="@L["Sort By"]">
            <Trigger>
                <FormaIcon Icon="@DirectionGlyph" Size="IconSize.Small" />
                <span class="forma-explorer-sort-trigger-text">@ExplorerSortPresentation.FieldLabel(L, View.SortField)</span>
                <span class="forma-explorer-sort-trigger-caret" aria-hidden="true"><FormaIcon Icon="Glyph.ChevronDown" /></span>
            </Trigger>
            <ChildContent>
                <FormaExplorerSortMenuItems />
            </ChildContent>
        </FormaDropDownMenu>
    </div>
    </FormaCommandBar>
    }
</div>
