@namespace Forma.Blazor.Components.Explorer
@using Forma.Blazor.Components.Layout
@using Forma.Framework.Explorer.Content
@using Forma.Framework.Explorer.Content.Queries
@using Forma.Framework.Explorer.Items

@{
    var selecting = View.Selection.IsSelectionModeActive;
}

<div class="forma-explorer-details-wrapper">
    <FormaFreezePane Options="PaneOptions">
    <table class="forma-explorer-details-table @(View.ShowsDetailsHeader ? "" : "is-headerless")" role="table">
        <thead>
            <tr>
                <th class="forma-explorer-column-actions @FormaFreezePane.FrozenClass"><span class="forma-explorer-visually-hidden">@(selecting ? L["Select"] : L["Actions"])</span></th>
                <th class="forma-explorer-column-name @FormaFreezePane.FrozenClass @(View.SortField == ExplorerSortField.Name ? "is-sorted" : "")"
                    aria-sort="@SortState(ExplorerSortField.Name)"
                    @onclick="() => Interaction.SortByAsync(ExplorerSortField.Name)">
                    <span>@L["Name"]</span>
                    @if (View.SortField == ExplorerSortField.Name)
                    {
                        <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == ExplorerSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                    }
                </th>
                @if (ShowsKind)
                {
                    <th class="forma-explorer-column-kind @FormaFreezePane.StopClass @(View.SortField == ExplorerSortField.Kind ? "is-sorted" : "")"
                        aria-sort="@SortState(ExplorerSortField.Kind)"
                        @onclick="() => Interaction.SortByAsync(ExplorerSortField.Kind)">
                        <span>@L["Type"]</span>
                        @if (View.SortField == ExplorerSortField.Kind)
                        {
                            <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == ExplorerSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                        }
                    </th>
                }
                @if (ShowsSize)
                {
                    <th class="forma-explorer-column-size @FormaFreezePane.StopClass @(View.SortField == ExplorerSortField.Size ? "is-sorted" : "")"
                        aria-sort="@SortState(ExplorerSortField.Size)"
                        @onclick="() => Interaction.SortByAsync(ExplorerSortField.Size)">
                        <span>@L["Size"]</span>
                        @if (View.SortField == ExplorerSortField.Size)
                        {
                            <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == ExplorerSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                        }
                    </th>
                }
                @if (ShowsModified)
                {
                    <th class="forma-explorer-column-modified @FormaFreezePane.StopClass @(View.SortField == ExplorerSortField.DateModified ? "is-sorted" : "")"
                        aria-sort="@SortState(ExplorerSortField.DateModified)"
                        @onclick="() => Interaction.SortByAsync(ExplorerSortField.DateModified)">
                        <span>@L["Modified"]</span>
                        @if (View.SortField == ExplorerSortField.DateModified)
                        {
                            <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == ExplorerSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                        }
                    </th>
                }
                @if (ShowsAdded)
                {
                    <th class="forma-explorer-column-added @FormaFreezePane.StopClass @(View.SortField == ExplorerSortField.DateAdded ? "is-sorted" : "")"
                        aria-sort="@SortState(ExplorerSortField.DateAdded)"
                        @onclick="() => Interaction.SortByAsync(ExplorerSortField.DateAdded)">
                        <span>@L["Added"]</span>
                        @if (View.SortField == ExplorerSortField.DateAdded)
                        {
                            <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == ExplorerSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                        }
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                var selected = View.Selection.IsSelected(item);
                var labels = item.GetLocalizedLabels(L, View.Selection);
                var capabilities = item.GetCapabilities(View.Item.ItemOptions);
                var draggable = capabilities.HasFlag(ExplorerItemCapabilities.Drag) ? "true" : "false";

                <tr class="forma-explorer-details-row @(selected ? "is-selected" : "") @item.GetStateClasses()"
                    aria-disabled="@(item.IsDisabled ? "true" : null)"
                    draggable="@draggable"
                    @ondragstart="() => ItemInteraction.BeginDrag(item)">
                    <td class="forma-explorer-cell-actions @FormaFreezePane.FrozenClass">
                        <FormaExplorerItemLead Item="item" />
                    </td>
                    <td class="forma-explorer-cell-name @FormaFreezePane.FrozenClass">
                        <button type="button"
                                class="forma-explorer-name-wrapper"
                                aria-label="@labels.ActivationLabel"
                                disabled="@item.IsDisabled"
                                @onclick="() => ItemInteraction.ActivateAsync(item)">
                            @if (item.Resource is { } resource)
                            {
                                <FormaExplorerThumbnail Resource="resource" Size="ExplorerThumbnailSize.Cell" />
                            }
                            <span class="forma-explorer-details-name-text" title="@item.Name">@item.Name</span>
                        </button>
                    </td>
                    @if (ShowsKind)
                    {
                        <td class="forma-explorer-cell-kind @FormaFreezePane.StopClass">@item.GetLocalizedLabels(L).KindLabel</td>
                    }
                    @if (ShowsSize)
                    {
                        <td class="forma-explorer-cell-size @FormaFreezePane.StopClass" dir="auto">@(item.Resource?.DisplaySize ?? Placeholder)</td>
                    }
                    @if (ShowsModified)
                    {
                        <td class="forma-explorer-cell-modified @FormaFreezePane.StopClass">@DisplayDate(item.ModifiedAt)</td>
                    }
                    @if (ShowsAdded)
                    {
                        <td class="forma-explorer-cell-added @FormaFreezePane.StopClass">@DisplayDate(item.CreatedAt)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
    </FormaFreezePane>
</div>
