@namespace Forma.Blazor.Components.Composer.Dialogs
@using Forma.Blazor.Components.Feedback
@using Forma.Blazor.Components.Inputs
@inherits ComposerDialogBase

<FormaComposerDialog Opened="Opened"
                     Title="@(IsReopened ? L["Edit Video"] : L["Insert Video"])"
                     Size="DialogSize.Medium"
                     Messages="Messages"
                     OnConfirm="HandleConfirmAsync"
                     OnCancel="OnCancel">
    <FormaTextBox @bind-Value="_source" Label="@L["Video URL"]" Required="true" />
    <FormaTextBox @bind-Value="_title" Label="@L["Title"]" />
    <div class="forma-composer-dialog-checkbox">
        <FormaCheckBox @bind-Value="_autoplay">
            @L["Autoplay"]
        </FormaCheckBox>
    </div>
</FormaComposerDialog>
