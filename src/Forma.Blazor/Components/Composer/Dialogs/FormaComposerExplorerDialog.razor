@namespace Forma.Blazor.Components.Composer.Dialogs
@using Forma.Blazor.Components.Explorer
@using Forma.Blazor.Components.Feedback
@inherits ComposerDialogBase

<FormaComposerDialog Opened="Opened"
                     Title="@L["Browse Files"]"
                     Size="ModalSize.Large"
                     Notice="@(_itemsProvider is null ? L["No stored files are available, because this application registered nowhere to browse."].Value : null)"
                     Messages="Messages"
                     OnConfirm="HandleConfirmAsync"
                     OnCancel="OnCancel">
    @if (_itemsProvider is not null)
    {
        <div class="forma-composer-explorer-library">
            <FormaExplorer ItemsProvider="_itemsProvider"
                           Store="_store"
                           Selected="_selected"
                           SelectedChanged="HandleSelectedChanged"
                           Options="LibraryOptions"
                           ItemOptions="LibraryItemOptions"
                           Constraints="UploadConstraints"
                           SearchPlaceholder="@L["Search files"]" />
        </div>
    }
</FormaComposerDialog>
