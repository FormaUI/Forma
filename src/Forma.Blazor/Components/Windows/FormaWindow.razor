@namespace Forma.Blazor.Components.Windows
@using Forma.Blazor.Components.Layout

@if (ShowsScrim)
{
    <div @ref="_scrim" class="forma-window-scrim" popover="manual" aria-hidden="true"></div>
}
<div @attributes="AdditionalAttributes"
     class="@CssClass"
     style="@Style"
     @ref="_element"
     role="dialog"
     tabindex="-1"
     popover="manual"
     hidden="@(!IsPresented)"
     inert="@IsInert"
     aria-modal="@(Modal ? "true" : "false")"
     aria-label="@Title"
     @onpointerdown="HandlePointerDownAsync"
     @onfocusin="HandleFocusInAsync"
     @onfocusout="HandleFocusOutAsync">
    <CascadingValue Value="FrameBox.Parent" IsFixed="true">
        <FormaChrome Title="@Title"
                     Icon="Icon"
                     Commands="TitleBarItems"
                     OnCommand="HandleCommandAsync"
                     Header="Header"
                     Body="Body"
                     Footer="Footer"
                     FrameOptions="FrameOptions"
                     Maximized="Maximized"
                     Locked="Locked"
                     Disabled="IsInert"
                     PlacementChanged="HandlePlacementChangedAsync"
                     role="presentation" />
    </CascadingValue>
</div>
