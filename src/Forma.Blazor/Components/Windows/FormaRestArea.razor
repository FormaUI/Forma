@namespace Forma.Blazor.Components.Windows
@using Forma.Blazor.Components.Buttons
@using Forma.Framework.Windows

<div @attributes="AdditionalAttributes" class="@CssClass" role="group" aria-label="@(Label ?? L["Windows"])">
    @foreach (var group in Groups)
    {
        if (group.Name is null)
        {
            @Handles(group.Windows)
        }
        else
        {
            <div class="forma-rest-area-group" role="group" aria-label="@group.Name">
                @Handles(group.Windows)
            </div>
        }
    }
</div>

@code {
    private RenderFragment Handles(IReadOnlyList<IWindow> windows) =>
        @<text>
            @foreach (var window in windows)
            {
                <FormaToggleButton @key="window.Id"
                                   Icon="window.Icon"
                                   Label="@window.Title"
                                   ShowLabel="true"
                                   Pressed="IsCurrent(window)"
                                   Disabled="window.IsDisabled"
                                   class="@HandleCssClass(window)"
                                   aria-description="@HandleDescription(window)"
                                   OnClick="() => ChooseAsync(window)" />
            }
        </text>;
}
