@namespace Forma.Blazor.Components.Menus
@inherits FormaElementBase
@if (Href is not null)
{
    <a id="@Id"
       data-rid="@Context.RuntimeId"
       class="@RootClass"
       style="@RootStyle"
       @attributes="AdditionalAttributes"
       @ref="RootElement"
       href="@Href"
       role="@Role"
       aria-checked="@AriaChecked"
       tabindex="@(Disabled ? "-1" : null)"
       aria-disabled="@(Disabled ? "true" : null)"
       @onclick="HandleActivateAsync"
       @onclick:preventDefault="Disabled">
        @ChildContent
        @if (IsSelected is true)
        {
            <span class="forma-dropdown-menu-item-check" aria-hidden="true">&#10003;</span>
        }
    </a>
}
else
{
    <button id="@Id"
            data-rid="@Context.RuntimeId"
            class="@RootClass"
            style="@RootStyle"
            @attributes="AdditionalAttributes"
            @ref="RootElement"
            type="button"
            role="@Role"
            aria-checked="@AriaChecked"
            disabled="@Disabled"
            @onclick="HandleActivateAsync">
        @ChildContent
        @if (IsSelected is true)
        {
            <span class="forma-dropdown-menu-item-check" aria-hidden="true">&#10003;</span>
        }
    </button>
}
