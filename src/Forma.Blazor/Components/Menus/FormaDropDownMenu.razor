@namespace Forma.Blazor.Components.Menus
<CascadingValue Value="this" IsFixed="true">
    @* Keydown is caught on the wrapper because it bubbles from the button, which a
       component tag cannot carry a handler for directly. *@
    <span class="@(_isOpen ? "forma-dropdown-menu-anchor forma-dropdown-menu-anchor-open" : "forma-dropdown-menu-anchor")" @ref="_anchorElement" @onkeydown="HandleTriggerKeyDown">
        <FormaButton @ref="_trigger"
                     @attributes="TriggerAttributes"
                     Variant="TriggerOptions.Variant"
                     Size="TriggerOptions.Size"
                     IconOnly="TriggerOptions.IconOnly"
                     OnClick="Toggle">
            @Trigger
        </FormaButton>
    </span>

    @if (_isOpen)
    {
        @* The backdrop takes the click that dismisses the menu and nothing else: no focus, so the selection under it stands. *@
        <div class="forma-dropdown-menu-backdrop" @onclick="Close" @onmousedown:preventDefault></div>
        @* Manual rather than auto: the backdrop above owns dismissal, which also sidesteps
           the iOS 17–18.2 bug where a popover ignores a tap outside it. *@
        <div class="forma-dropdown-menu"
             id="@_popupId"
             role="menu"
             popover="manual"
             @ref="_popupElement"
             @onkeydown="HandlePopupKeyDownAsync">
            @if (HeaderContent is not null)
            {
                <div class="forma-dropdown-menu-header">@HeaderContent</div>
            }
            @ChildContent
        </div>
    }
</CascadingValue>
