@namespace Forma.Blazor.Components.Menus
<CascadingValue Value="this" IsFixed="true">
    @* Keydown is caught on the wrapper because it bubbles from the button, which a
       component tag cannot carry a handler for directly. *@
    <span class="@(IsOpen ? "forma-dropdown-menu-anchor forma-dropdown-menu-anchor-open" : "forma-dropdown-menu-anchor")" @ref="_anchorElement" @onkeydown="HandleTriggerKeyDownAsync">
        <FormaButton @ref="_trigger"
                     @attributes="TriggerAttributes"
                     Variant="TriggerOptions.Variant"
                     Size="TriggerOptions.Size"
                     IconOnly="TriggerOptions.IconOnly"
                     OnClick="ToggleAsync">
            @Trigger
        </FormaButton>
    </span>

    <FormaPopover @ref="Popover"
                Anchor="_anchorElement"
                KeepsFocus="true"
                Alignment="Alignment"
                OnOpenChanged="_ => { }"
                OnOpened="HandleOpenedAsync"
                OnKeyDown="HandlePopoverKeyDownAsync">
        <div class="forma-dropdown-menu" id="@_popoverId" role="menu">
            @if (HeaderContent is not null)
            {
                <div class="forma-dropdown-menu-header">@HeaderContent</div>
            }
            @ChildContent
        </div>
    </FormaPopover>
</CascadingValue>
