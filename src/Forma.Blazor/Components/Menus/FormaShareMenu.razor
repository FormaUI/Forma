@namespace Forma.Blazor.Components.Menus
@using Forma.Blazor.Components.Bars
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Design
@inject IStringLocale<FormaShareMenu> L

<span class="forma-share-menu">
<FormaDropDownMenu TriggerOptions="TriggerOptions" HeaderContent="@ItemHeader" @attributes="AdditionalAttributes">
    <Trigger>
        @if (Trigger is not null)
        {
            @Trigger
        }
        else
        {
            <FormaIcon Icon="Glyph.Share" Size="IconSize.Small" />
            @L["Share"]
        }
    </Trigger>
    <ChildContent>
        @if (HasSocialNetworks)
        {
            @* The networks ride the command bar; a target a host registered is a network here too. *@
            <div class="forma-share-menu-primary" role="none">
                <FormaCommandBar>
                    @if (_canShareNatively && Item is { Address: not null })
                    {
                        <FormaDropDownMenuItem OnClick="ShareNativelyAsync"><FormaIcon Icon="Glyph.Share" /><span>@L["Share"]</span></FormaDropDownMenuItem>
                    }
                    @foreach (var target in SupportedShareTargets)
                    {
                        @if (target.GetAddress(Item!) is { } address)
                        {
                            <FormaDropDownMenuItem @key="target.Id" Href="@address" target="_blank" rel="noopener noreferrer"><FormaIcon Icon="target.Icon" /><span>@target.Title</span></FormaDropDownMenuItem>
                        }
                        else
                        {
                            <FormaDropDownMenuItem @key="target.Id" OnClick="() => target.ShareAsync(Item!)"><FormaIcon Icon="target.Icon" /><span>@target.Title</span></FormaDropDownMenuItem>
                        }
                    }
                </FormaCommandBar>
            </div>
            <FormaDropDownMenuDivider />
        }

        @* The built-in commands stand in the open, never behind More. *@
        @if (Item is { Resource: { } resource })
        {
            <FormaDropDownMenuItem Href="@resource.Source" download="@resource.Name"><FormaIcon Icon="Glyph.Download" Size="IconSize.Small" /><span>@L["Download"]</span></FormaDropDownMenuItem>
        }
        @if (OffersEmail)
        {
            <FormaDropDownMenuItem Href="@EmailAddress"><FormaIcon Icon="Glyph.Unread" Size="IconSize.Small" /><span>@L["Email"]</span></FormaDropDownMenuItem>
        }
        @if (OffersCopyLink)
        {
            <FormaDropDownMenuItem OnClick="CopyLinkAsync"><FormaIcon Icon="Glyph.Link" Size="IconSize.Small" /><span>@L["Copy Link"]</span></FormaDropDownMenuItem>
        }
        <FormaDropDownMenuItem OnClick="PrintAsync"><FormaIcon Icon="Glyph.Print" Size="IconSize.Small" /><span>@L["Print"]</span></FormaDropDownMenuItem>

        @if (Actions.Count > 0)
        {
            <FormaVisibility Hidden="!_isExpanded" Animated="true">
                <FormaDropDownMenuDivider />
                @foreach (var action in Actions)
                {
                    <FormaDropDownMenuItem @key="action.Id" Disabled="action.IsDisabled" OnClick="() => OnCommand.InvokeAsync(action.Command)">
                        @if (action.Icon is { } icon)
                        {
                            <FormaIcon Icon="icon" Size="IconSize.Small" />
                        }
                        <span>@action.Title</span>
                    </FormaDropDownMenuItem>
                }
            </FormaVisibility>
            <FormaDropDownMenuDivider />
            <FormaDropDownMenuItem OnClick="ToggleExpanded" KeepsOpen="true" aria-expanded="@(_isExpanded ? "true" : "false")">
                <FormaIcon Icon="@(_isExpanded ? Glyph.ChevronUp : Glyph.ChevronDown)" Size="IconSize.Small" />
                <span>@(_isExpanded ? L["Less"] : L["More"])</span>
            </FormaDropDownMenuItem>
        }
    </ChildContent>
</FormaDropDownMenu>
</span>

@code {
    /// <summary>The menu's header for an item with a name, and nothing for one without, so no empty header block renders.</summary>
    private RenderFragment? ItemHeader => Item is { Name: not null }
        ? @<div class="forma-share-menu-item">
                @if (Item.Icon is { } icon)
                {
                    <FormaIcon Icon="icon" Size="IconSize.Medium" />
                }
                <div class="forma-share-menu-item-text">
                    <span class="forma-share-menu-item-name">@Item.Name</span>
                    @if (Item.Meta is not null)
                    {
                        <span class="forma-share-menu-item-meta">@Item.Meta</span>
                    }
                </div>
            </div>
        : null;
}
