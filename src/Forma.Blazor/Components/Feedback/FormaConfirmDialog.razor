<FormaModal Opened="_isOpen"
          OnClose="HandleCancel"
          Size="ModalSize.Small"
          Options="ModalOptions">
    <Body>
        <p class="forma-confirm-message">@_request?.Message</p>
    </Body>
    <Footer>
        <div class="forma-confirm-actions">
            <FormaButton Variant="ButtonVariant.Secondary" OnClick="HandleCancel">
                @_request?.CancelText
            </FormaButton>
            <FormaButton Variant="ButtonVariant.Danger" OnClick="HandleConfirm">
                @_request?.ConfirmText
            </FormaButton>
        </div>
    </Footer>
</FormaModal>
