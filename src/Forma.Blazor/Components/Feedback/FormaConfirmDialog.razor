@inherits FormaComponentBase

<FormaDialog Opened="_isOpen"
          OnClose="HandleCancel"
          Size="DialogSize.Small"
          Options="DialogOptions">
    <Body>
        <p class="forma-confirm-dialog-message">@_request?.Message</p>
    </Body>
    <Footer>
        <div class="forma-confirm-dialog-actions">
            <FormaButton Variant="ButtonVariant.Secondary" OnClick="HandleCancel">
                @_request?.CancelText
            </FormaButton>
            <FormaButton Variant="ButtonVariant.Danger" OnClick="HandleConfirm">
                @_request?.ConfirmText
            </FormaButton>
        </div>
    </Footer>
</FormaDialog>
