<div class="forma-toast-container" role="status" aria-live="polite" aria-atomic="false">
    @foreach (var toast in ToastService.Toasts)
    {
        <div class="forma-toast forma-toast-@toast.Type.ToString().ToLowerInvariant()"
             @key="toast.Id">
            <span class="forma-toast-marker" aria-hidden="true"><FormaIcon Icon="GetMarker(toast.Type)" Size="IconSize.Small" /></span>
            <span class="forma-toast-message">@toast.Message</span>
            <FormaCloseButton Size="ButtonSize.Mini"
                              Label="@L["Dismiss"]"
                              OnClick="async () => await ToastService.RemoveAsync(toast.Id)" />
        </div>
    }
</div>
