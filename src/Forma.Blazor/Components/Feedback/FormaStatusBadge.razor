@namespace Forma.Blazor.Components.Feedback
@inherits FormaElementBase

<span id="@Id"
      data-rid="@RuntimeId"
      class="@RootClass"
      style="@RootStyle"
      @attributes="AdditionalAttributes"
      @ref="RootElement">@if (ResolvedMarker is { } marker)
{<span class="forma-status-badge-marker" aria-hidden="true"><FormaIcon Icon="marker" /></span>}@Text</span>
