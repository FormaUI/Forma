@inherits FormaElementBase

<dialog id="@Id"
        data-rid="@RuntimeId"
        class="@RootClass"
        style="@RootStyle"
        @attributes="AdditionalAttributes"
        @ref="RootElement"
        @onclose="HandleDialogClose">
    <div class="forma-dialog-dialog">
        @if (ShowHeader)
        {
            <header class="forma-dialog-header">
                <h5>@Title</h5>
                <FormaCloseButton Label="@L["Close"]" OnClick="RequestCloseAsync" />
            </header>
        }

        <div class="forma-dialog-body @(ShowHeader ? "" : "no-header")">
            @Body
        </div>

        @if (ShowFooter)
        {
            <footer class="forma-dialog-footer">
                @if (Footer is not null)
                {
                    <div class="forma-dialog-footer-extra">
                        @Footer
                    </div>
                }
                @if (HasDefaultFooterActions)
                {
                    <div class="forma-dialog-footer-actions">
                        @if (Options.ShowCancelAction)
                        {
                            <FormaButton Variant="ButtonVariant.Secondary" OnClick="HandleDefaultCancelAsync">
                                @CancelLabel
                            </FormaButton>
                        }
                        @if (Options.ShowConfirmAction)
                        {
                            <FormaButton Variant="ButtonVariant.Primary" OnClick="HandleDefaultConfirmAsync">
                                @ConfirmLabel
                            </FormaButton>
                        }
                    </div>
                }
            </footer>
        }
    </div>
</dialog>
