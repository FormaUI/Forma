@namespace Forma.Blazor.Components.Collections
@attribute [CascadingTypeParameter(nameof(TGridItem))]
@typeparam TGridItem where TGridItem : notnull

<div @attributes="AdditionalAttributes" class="@CssClass">
    <div class="forma-data-grid-scroller" @ref="_scrollerElement">
        @* Fixed: the session object is mutated in place, so columns read live state without
           the cascade ever changing value under a mounted editor. *@
        <CascadingValue TValue="RowEditSession<TGridItem>" Value="_editSession" IsFixed="true">
            @if (_editSession.EditContext is { } rowEditContext)
            {
                @* Fixed and keyed: the validator refuses a context swap, so it must never be
                   notified of one — it is torn down with the edit and rebuilt for the next. *@
                <CascadingValue TValue="EditContext" Value="rowEditContext" IsFixed="true">
                    <DataAnnotationsValidator @key="rowEditContext" />
                </CascadingValue>
            }

            <QuickGrid @ref="_quickGrid"
                       Items="Items"
                       ItemsProvider="ItemsProvider"
                       ItemKey="ItemKey"
                       QueryParameterNamePrefix="@QueryParameterNamePrefix"
                       Pagination="@(EnablePagination ? _pagination : null)"
                       Virtualize="Virtualize"
                       ItemSize="ItemSize"
                       OverscanCount="OverscanCount"
                       RowClass="ComposedRowClass"
                       OnRowClick="OnRowClick">
                @if (EnableCheckedSelection || EnableRowSelection)
                {
                    <TemplateColumn Class="@(EnableCheckedSelection ? "forma-data-grid-select-column" : "forma-data-grid-select-column forma-data-grid-select-column-marker")">
                        <HeaderTemplate>
                            @* Runs ahead of this pass's rows, so the row tokens below rebuild against it. *@
                            @{ BeginRowTokenPass(); }
                            @if (EnableCheckedSelection)
                            {
                                @if (!HasMasterCaption)
                                {
                                    <FormaCheckBox aria-label="@L["Select All"]"
                                                   Checked="@AllSelected"
                                                   Indeterminate="@PartiallySelected"
                                                   Disabled="@MasterControlDisabled"
                                                   PreventDefault="true"
                                                   OnClick="HandleMasterClickAsync" />
                                }
                                else if (!MasterCaptionHidden)
                                {
                                    @if (MasterCaptionInteractive)
                                    {
                                        <span class="forma-data-grid-master-caption-slot">
                                            <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" class="forma-data-grid-master-caption" Disabled="@MasterControlDisabled" OnClick="HandleMasterClickAsync">@MasterCaptionText</FormaButton>
                                            @* Holds the column at the width of the longer caption, so swapping
                                               between them does not resize every column beside it. *@
                                            <span class="forma-data-grid-master-caption-ghost" aria-hidden="true">@MasterCaptionAlternateText</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="forma-data-grid-master-caption forma-data-grid-master-caption-static">@MasterCaptionText</span>
                                    }
                                }
                            }
                        </HeaderTemplate>
                        <ChildContent Context="row">
                            @* Dropping the marker takes the editing row out of every selection
                               gesture: the script only ever acts on rows that carry one. *@
                            @if (!_editSession.IsEditing(row))
                            {
                                <FormaCheckBox class="@(EnableCheckedSelection ? null : "forma-data-grid-row-marker")"
                                               data-row-key="@GetRowToken(row)"
                                               aria-label="@L["Select Row"]"
                                               aria-disabled="@(!CanInteractWithRow(row) ? "true" : null)"
                                               Checked="@IsSelected(row)"
                                               CheckedChanged="isSelected => ToggleSelectionAsync(row, isSelected)" />
                            }
                        </ChildContent>
                    </TemplateColumn>
                }
                @Columns
            </QuickGrid>
        </CascadingValue>
    </div>

    @if (HasFooter)
    {
        <div class="forma-data-grid-footer">
            @if (ShowPaginator)
            {
                <FormaPagination TotalItems="@TotalItemCount"
                                 PageSize="PageSize"
                                 CurrentPage="@(_pagination.CurrentPageIndex + 1)"
                                 Options="PaginationOptions"
                                 OnPageChanged="HandlePageChangedAsync" />
            }

            <div class="forma-data-grid-status" role="status">@Status</div>
        </div>
    }
</div>
