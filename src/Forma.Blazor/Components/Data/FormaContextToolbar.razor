@namespace Forma.Blazor.Components.Data

<div class="forma-context-toolbar @(Count > 0 ? "is-active" : "")">
    <div class="forma-context-toolbar-inner">
        <div class="forma-context-toolbar-content">
            <span class="forma-context-toolbar-caption" role="status" aria-live="polite">@CaptionText</span>
            @if (ChildContent is not null || OnClear.HasDelegate)
            {
                @* Only the controls go inert, so the caption's live region stays in the
                   accessibility tree and is present before the count first changes. *@
                <div class="forma-context-toolbar-trailing" inert="@(Count == 0)">
                    @if (ChildContent is not null)
                    {
                        <div class="forma-context-toolbar-actions">
                            @ChildContent
                        </div>
                    }
                    @if (OnClear.HasDelegate)
                    {
                        <button type="button"
                                class="forma-context-toolbar-clear"
                                aria-label="@L["ClearSelection"]"
                                @onclick="() => OnClear.InvokeAsync()">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                <path d="M1 1l12 12M13 1 1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>
