@namespace Forma.Blazor.Components.Admin.Forms

<button @attributes="AdditionalAttributes"
        class="@CssClass"
        type="@TypeAttribute"
        disabled="@Disabled"
        aria-disabled="@AriaDisabled"
        aria-busy="@AriaBusy"
        @onclick="HandleClickAsync"
        @onclick:preventDefault="Busy">
    @ChildContent
</button>
