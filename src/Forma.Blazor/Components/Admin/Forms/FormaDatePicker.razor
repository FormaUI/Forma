@namespace Forma.Blazor.Components.Admin.Forms

<div class="forma-date-picker" @attributes="AdditionalAttributes">
    @if (Label is not null)
    {
        <label class="forma-date-picker-label">@Label</label>
    }
    <div class="forma-date-picker-trigger-wrap" @ref="_anchorElement">
        <button type="button" class="forma-date-picker-trigger" @onclick="Toggle">
            <span class="forma-date-picker-arrow">&#9662;</span>
            <span class="forma-date-picker-value@(HasValue ? "" : " placeholder")">@(HasValue ? DisplayText : Placeholder)</span>
        </button>
        @if (HasValue)
        {
            <button type="button"
                    class="forma-date-picker-clear"
                    @onclick="HandleClear"
                    @onclick:stopPropagation
                    aria-label="@L["Clear"]">
                &times;
            </button>
        }
    </div>
    @if (_isOpen)
    {
        <div class="forma-date-picker-backdrop" @onclick="Close"></div>
        @* Manual rather than auto: the backdrop above owns dismissal, which also sidesteps
           the iOS 17–18.2 bug where a popover ignores a tap outside it. *@
        <div class="forma-date-picker-popup" popover="manual" @ref="_popupElement">
            <div class="forma-date-picker-calendars">
                @for (var i = 0; i < CalendarCount; i++)
                {
                    var idx = i;
                    var month = GetPanelMonth(idx);
                    <div class="forma-date-picker-month" dir="@_textDirection">
                        <div class="forma-date-picker-month-header">
                            <button type="button" class="forma-date-picker-nav" disabled="@(!CanPanelGoPrev(idx))" @onclick="() => PanelPrev(idx)">&#10094;</button>
                            <div class="forma-date-picker-month-selectors">
                                <select class="forma-date-picker-select"
                                        value="@month.Year"
                                        @onchange="e => OnYearDropdownChange(idx, e)">
                                    @for (var y = MinYear; y <= MaxYear; y++)
                                    {
                                        var year = y;
                                        <option value="@year" disabled="@IsYearDisabled(year, idx)">@year</option>
                                    }
                                </select>
                                <select class="forma-date-picker-select"
                                        value="@CalendarMonth(month)"
                                        @onchange="e => OnMonthDropdownChange(idx, e)">
                                    @for (var m = 1; m <= _calendar.GetMonthsInYear(CalendarYear(month)); m++)
                                    {
                                        var mo = m;
                                        <option value="@mo" disabled="@IsMonthDisabled(CalendarYear(month), mo, idx)">@MonthName(CalendarYear(month), mo)</option>
                                    }
                                </select>
                            </div>
                            <button type="button" class="forma-date-picker-nav" disabled="@(!CanPanelGoNext(idx))" @onclick="() => PanelNext(idx)">&#10095;</button>
                        </div>
                        <div class="forma-date-picker-weekdays">
                            @{ var fdow = (int)_dtf.FirstDayOfWeek; }
                            @for (var wi = 0; wi < 7; wi++)
                            {
                                <span>@_dtf.AbbreviatedDayNames[(fdow + wi) % 7]</span>
                            }
                        </div>
                        <div class="forma-date-picker-days">
                            @foreach (var day in GetDaysForMonth(month, _dtf.FirstDayOfWeek))
                            {
                                @if (day is null)
                                {
                                    <span class="forma-date-picker-day empty"></span>
                                }
                                else
                                {
                                    var d = day.Value;
                                    <button type="button"
                                            class="forma-date-picker-day@(GetDayClasses(d))"
                                            disabled="@IsDayDisabled(d)"
                                            @onclick="() => SelectDay(d)"
                                            @onmouseenter="() => HoverDay(d)">
                                        @_calendar.GetDayOfMonth(d.ToDateTime(TimeOnly.MinValue))
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
            @if (ShowPresets && IsRangeMode)
            {
                <div class="forma-date-picker-presets" dir="@_textDirection">
                    <button type="button" disabled="@IsPresetDisabled(Preset.Today)" @onclick="() => ApplyPreset(Preset.Today)">@L["Today"]</button>
                    <button type="button" disabled="@IsPresetDisabled(Preset.Yesterday)" @onclick="() => ApplyPreset(Preset.Yesterday)">@L["Yesterday"]</button>
                    <button type="button" disabled="@IsPresetDisabled(Preset.Last7Days)" @onclick="() => ApplyPreset(Preset.Last7Days)">@L["Last7Days"]</button>
                    <button type="button" disabled="@IsPresetDisabled(Preset.Last30Days)" @onclick="() => ApplyPreset(Preset.Last30Days)">@L["Last30Days"]</button>
                    <button type="button" disabled="@IsPresetDisabled(Preset.ThisMonth)" @onclick="() => ApplyPreset(Preset.ThisMonth)">@L["ThisMonth"]</button>
                    <button type="button" disabled="@IsPresetDisabled(Preset.LastMonth)" @onclick="() => ApplyPreset(Preset.LastMonth)">@L["LastMonth"]</button>
                </div>
            }
        </div>
    }
</div>
