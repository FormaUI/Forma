@namespace Forma.Blazor.Components.Admin.Data

@if (PageCount > 1 && (Options.EnableButtons || Options.EnableInputBox))
{
    <nav @attributes="AdditionalAttributes" class="@CssClass" aria-label="@NavLabel">
        @if (Options.EnableButtons)
        {
            <ul class="forma-pagination-list">
                <li>
                    <button type="button"
                            class="forma-pagination-link forma-pagination-prev"
                            disabled="@(ActivePage <= 1)"
                            aria-label="@L["Previous"]"
                            @onclick="() => GoToPageAsync(ActivePage - 1)">
                        @L["Previous"]
                    </button>
                </li>
                @foreach (var pageNumber in PageNumbers)
                {
                    <li>
                        @if (pageNumber is null)
                        {
                            <span class="forma-pagination-ellipsis" aria-hidden="true">&hellip;</span>
                        }
                        else if (pageNumber == ActivePage)
                        {
                            <span class="forma-pagination-link forma-pagination-current"
                                  aria-current="page">
                                @pageNumber
                            </span>
                        }
                        else
                        {
                            <button type="button"
                                    class="forma-pagination-link"
                                    aria-label="@L["PageNumber", pageNumber]"
                                    @onclick="() => GoToPageAsync(pageNumber.Value)">
                                @pageNumber
                            </button>
                        }
                    </li>
                }
                <li>
                    <button type="button"
                            class="forma-pagination-link forma-pagination-next"
                            disabled="@(ActivePage >= PageCount)"
                            aria-label="@L["Next"]"
                            @onclick="() => GoToPageAsync(ActivePage + 1)">
                        @L["Next"]
                    </button>
                </li>
            </ul>
        }

        @if (Options.EnableInputBox)
        {
            <div class="forma-pagination-jump">
                <label class="forma-pagination-jump-label" for="@_pageInputId">@L["GoToPage"]</label>
                <input type="number"
                       @ref="_pageInputElement"
                       id="@_pageInputId"
                       class="forma-pagination-jump-input"
                       inputmode="numeric"
                       min="1"
                       max="@PageCount"
                       value="@_pageInput"
                       @oninput="OnJumpInput"
                       @onkeydown="OnJumpKeyDownAsync" />
                @if (Options.EnableGoButton)
                {
                    <button type="button"
                            class="forma-pagination-link forma-pagination-jump-go"
                            @onclick="JumpAsync">
                        @L["Go"]
                    </button>
                }
            </div>
        }
    </nav>
}
