<FormaModal Opened="_isOpen"
          OnClose="HandleCancel"
          Size="ModalSize.Small"
          CloseOnBackdropClick="false"
          ShowCancelAction="false"
          ShowConfirmAction="false">
    <Body>
        <p class="forma-confirm-message">@_request?.Message</p>
    </Body>
    <Footer>
        <div class="forma-confirm-actions">
            <button type="button" class="forma-btn forma-btn-secondary" @onclick="HandleCancel">
                @_request?.CancelText
            </button>
            <button type="button" class="forma-btn forma-btn-danger" @onclick="HandleConfirm">
                @_request?.ConfirmText
            </button>
        </div>
    </Footer>
</FormaModal>
