@namespace Forma.Blazor.Components.Layout
@inherits FormaElementBase

<div id="@Id"
     data-rid="@RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    @if (CanScrollBack && ShowsArrows)
    {
        <FormaButton Variant="ButtonVariant.Ghost"
                     Size="ButtonSize.Mini"
                     IconOnly="true"
                     class="forma-freeze-pane-arrow forma-freeze-pane-arrow-back"
                     aria-label="@BackLabel"
                     OnClick="() => ScrollAsync(-1)">
            <FormaIcon Icon="@BackGlyph" />
        </FormaButton>
    }

    <div class="forma-freeze-pane-viewport" @ref="_viewport">
        @ChildContent
    </div>

    @if (ShowsFrozenEdge)
    {
        <FormaSplitter Class="forma-freeze-pane-edge"
                       Label="@FrozenEdgeLabel"
                       Value="FrozenExtent"
                       ValueChanged="FrozenExtentChanged"
                       Min="0"
                       Max="_report.ViewportExtent"
                       Step="FrozenEdgeKeyStep"
                       PixelsPerUnit="1" />
    }

    @if (CanScrollForward && ShowsArrows)
    {
        <FormaButton Variant="ButtonVariant.Ghost"
                     Size="ButtonSize.Mini"
                     IconOnly="true"
                     class="forma-freeze-pane-arrow forma-freeze-pane-arrow-forward"
                     aria-label="@ForwardLabel"
                     OnClick="() => ScrollAsync(1)">
            <FormaIcon Icon="@ForwardGlyph" />
        </FormaButton>
    }
</div>
