@namespace Forma.Blazor.Components.Layout
@inherits FormaElementBase
<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement"
     role="separator"
     tabindex="0"
     aria-orientation="@AriaOrientation"
     aria-label="@Label"
     aria-valuenow="@FormatRounded(Value)"
     aria-valuemin="@FormatRounded(Min)"
     aria-valuemax="@FormatRounded(Max)"
     @onpointermove="HandlePointerMoveAsync"
     @onpointerup="HandlePointerUpAsync"
     @onpointercancel="HandlePointerUpAsync">
    <span class="forma-splitter-grip" aria-hidden="true"></span>
</div>
