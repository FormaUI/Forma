@namespace Forma.Blazor.Components.Layout
@inherits FormaElementBase
<FormaVisibility Hidden="Hidden" Animated="Animated">
    <div id="@Id"
         data-rid="@RuntimeId"
         class="@RootClass"
         style="@RootStyle"
         @attributes="AdditionalAttributes"
         @ref="RootElement">
        <FormaFreezePane Class="forma-command-bar-track" Options="TrackOptions">
            @ChildContent
        </FormaFreezePane>

        @TrailingContent
    </div>
</FormaVisibility>
