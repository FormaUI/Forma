@inherits FormaElementBase
<div id="@FormaTabs.GetPanelElementId(this)"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement"
     role="tabpanel"
     aria-labelledby="@FormaTabs.GetTabElementId(this)">
    @ChildContent
</div>
