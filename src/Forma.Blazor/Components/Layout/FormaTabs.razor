@inherits FormaElementBase
<CascadingValue Value="this" IsFixed="true">
    <div id="@Id"
         data-rid="@Context.RuntimeId"
         class="@RootClass"
         style="@RootStyle"
         @attributes="AdditionalAttributes"
         @ref="RootElement">
        <div class="forma-tab-list" role="tablist" aria-label="@Label" @ref="_tabList">
            @foreach (var tab in _tabs)
            {
                var isActive = IsActive(tab);
                var tabElementId = FormaTabs.GetTabElementId(tab);
                var panelElementId = FormaTabs.GetPanelElementId(tab);

                <button class="forma-tab-button @(isActive ? "active" : "") @(tab.Trailing && tab == _tabs.FirstOrDefault(candidate => candidate.Trailing) ? "forma-tab-button-trailing" : "")"
                        role="tab"
                        id="@tabElementId"
                        aria-selected="@isActive.ToString().ToLowerInvariant()"
                        aria-controls="@panelElementId"
                        tabindex="@(tab == FocusableTab ? "0" : "-1")"
                        @ref="_tabButtons[tab]"
                        @onclick="() => SelectTabAsync(tab)">
                    @if (tab.Icon is { } icon)
                    {
                        <FormaIcon Icon="icon" Size="IconSize.Small" aria-hidden="true" />
                    }
                    @tab.Title
                </button>
            }
        </div>

        <div class="forma-tab-panels">
            @ChildContent
        </div>
    </div>
</CascadingValue>
