@namespace Forma.Blazor.Components.Input
@inherits InputBase<bool>

<div class="forma-toggle-wrapper">
    @if (OffLabel is not null)
    {
        <span class="forma-toggle-label forma-toggle-off-label">@OffLabel</span>
    }
    <label class="@(Disabled ? "forma-toggle disabled" : "forma-toggle")">
        <input @attributes="AdditionalAttributes"
               id="@_id"
               type="checkbox"
               role="switch"
               class="forma-toggle-input @CssClass"
               checked="@CurrentValue"
               @onchange="HandleChange"
               disabled="@Disabled" />
        <span class="forma-toggle-track" aria-hidden="true">
            <span class="forma-toggle-mark">@(CurrentValue ? CheckMark : CrossMark)</span>
            <span class="forma-toggle-knob"></span>
        </span>
    </label>
    @if (OnLabel is not null)
    {
        <span class="forma-toggle-label forma-toggle-on-label">@OnLabel</span>
    }
    <ValidationMessage For="@ValueExpression" />
</div>
