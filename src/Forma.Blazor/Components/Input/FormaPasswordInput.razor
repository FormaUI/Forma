@namespace Forma.Blazor.Components.Input
@inherits InputBase<string?>

<FormaField Label="@Label" FieldId="@_inputId" Required="@Required">
    <ChildContent>
        <input @attributes="AdditionalAttributes"
               id="@_inputId"
               type="@(_isRevealed ? "text" : "password")"
               class="forma-field-input forma-password-input @CssClass"
               placeholder=" "
               autocomplete="@AutoComplete"
               dir="ltr"
               value="@CurrentValueAsString"
               @oninput="HandleInput"
               @ref="_inputRef"
               aria-required="@(Required ? "true" : null)"
               aria-describedby="@DescribedBy" />
        @if (ShowToggle)
        {
            <button type="button"
                    class="forma-password-input-toggle"
                    @onclick="ToggleReveal"
                    aria-label="@(_isRevealed ? L["Hide password"] : L["Show password"])"
                    aria-pressed="@(_isRevealed ? "true" : "false")">
                @if (_isRevealed)
                {
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                        <circle cx="8" cy="8" r="2" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                        <circle cx="8" cy="8" r="2" stroke="currentColor" stroke-width="1.4" />
                        <path d="M2 14 14 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                }
            </button>
        }
        @if (Strength is { } strength)
        {
            <div class="forma-password-input-strength @StrengthModifier(strength)">
                @* Decorative: the text beside it is what carries the rating. *@
                <span class="forma-password-input-strength-track" aria-hidden="true">
                    @for (var segment = 0; segment < SegmentCount; segment++)
                    {
                        <span class="forma-password-input-strength-segment@(segment <= (int)strength ? " filled" : "")"></span>
                    }
                </span>
                <span class="forma-password-input-strength-text" role="status">@StrengthText(strength)</span>
            </div>
        }
        @if (_advice.Count > 0)
        {
            <ul class="forma-password-input-advice" id="@AdviceId">
                @foreach (var item in _advice)
                {
                    <li>@item</li>
                }
            </ul>
        }
    </ChildContent>
    <Validation>
        <ValidationMessage For="@ValueExpression" />
    </Validation>
</FormaField>
