@namespace Forma.Blazor.Components.Input
@inherits InputBase<string?>

<div class="forma-input">
    <input @attributes="AdditionalAttributes"
           id="@_inputId"
           type="@Type"
           class="forma-input-field @CssClass"
           placeholder=" "
           value="@CurrentValueAsString"
           @oninput="@(e => CurrentValueAsString = e.Value?.ToString())"
           @ref="_inputRef"
           aria-required="@(Required ? "true" : null)" />
    <label for="@_inputId" class="forma-input-label">
        @Label@if (Required) {<span class="forma-input-required" aria-hidden="true"> *</span>}
    </label>
    <ValidationMessage For="@ValueExpression" />
</div>
