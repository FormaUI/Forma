@namespace Forma.Blazor.Components.Input
@inherits InputBase<string?>

<FormaField Label="@Label" FieldId="@_inputId" Required="@Required" Multiline="true">
    <ChildContent>
        <textarea @attributes="AdditionalAttributes"
                  id="@_inputId"
                  class="forma-field-input forma-textarea @CssClass"
                  placeholder=" "
                  rows="@Rows"
                  maxlength="@MaxLength"
                  value="@CurrentValueAsString"
                  @oninput="@(e => CurrentValueAsString = e.Value?.ToString())"
                  aria-required="@(Required ? "true" : null)"></textarea>
    </ChildContent>
    <Validation>
        <ValidationMessage For="@ValueExpression" />
    </Validation>
</FormaField>
