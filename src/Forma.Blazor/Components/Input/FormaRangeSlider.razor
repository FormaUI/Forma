@namespace Forma.Blazor.Components.Input
@typeparam TValue where TValue : struct, System.Numerics.INumber<TValue>
@inherits InputBase<TValue>

<div class="forma-range">
    <div class="forma-range-header">
        <label for="@_inputId" class="forma-range-label">@Label</label>
        <span class="forma-range-value" aria-hidden="true"><bdi dir="ltr">@DisplayValue</bdi></span>
    </div>
    <input @attributes="AdditionalAttributes"
           id="@_inputId"
           type="range"
           class="forma-range-input @CssClass"
           min="@FormatInvariant(Min)"
           max="@FormatInvariant(Max)"
           step="@FormatInvariant(Step)"
           value="@CurrentValueAsString"
           disabled="@Disabled"
           aria-valuetext="@AriaValueText"
           @oninput="@(e => CurrentValueAsString = e.Value?.ToString())" />
    <ValidationMessage For="@ValueExpression" />
</div>
