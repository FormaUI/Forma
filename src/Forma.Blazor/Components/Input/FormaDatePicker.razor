@namespace Forma.Blazor.Components.Input

<FormaField Label="@Label" FieldId="@_triggerId" LabelMode="FieldLabelMode.Pinned">
    <ChildContent>
        @* The root keeps the --dp-* custom properties the calendar popup reads. *@
        <div class="forma-date-picker">
            <div class="forma-date-picker-trigger-wrap" @ref="_anchorElement">
                <button @attributes="AdditionalAttributes"
                        type="button"
                        id="@_triggerId"
                        class="forma-field-input forma-date-picker-trigger"
                        @onclick="Toggle">
                    <span class="forma-date-picker-arrow">&#9662;</span>
                    <span class="forma-date-picker-value@(HasValue ? "" : " placeholder")">@(HasValue ? DisplayText : Placeholder)</span>
                </button>
                @if (HasValue)
                {
                    <button type="button"
                            class="forma-date-picker-clear"
                            @onclick="HandleClear"
                            @onclick:stopPropagation
                            aria-label="@L["Clear"]">
                        &times;
                    </button>
                }
            </div>
    @if (_isOpen)
    {
        <div class="forma-date-picker-backdrop" @onclick="Close"></div>
        @* Manual rather than auto: the backdrop above owns dismissal, which also sidesteps
           the iOS 17–18.2 bug where a popover ignores a tap outside it. *@
        <div class="forma-date-picker-popup" popover="manual" @ref="_popupElement">
            <div class="forma-date-picker-calendars">
                @for (var i = 0; i < CalendarCount; i++)
                {
                    var idx = i;
                    var month = GetPanelMonth(idx);
                    <div class="forma-date-picker-month" dir="@_textDirection">
                        <div class="forma-date-picker-month-header">
                            <FormaButton Variant="ButtonVariant.Ghost"
                                         class="forma-date-picker-nav"
                                         aria-label="@L["Previous month"]"
                                         Disabled="!CanPanelGoPrev(idx)"
                                         OnClick="() => PanelPrev(idx)">
                                &#10094;
                            </FormaButton>
                            <div class="forma-date-picker-month-selectors">
                                <select class="forma-date-picker-select"
                                        value="@month.Year"
                                        @onchange="e => OnYearDropdownChange(idx, e)">
                                    @for (var y = MinYear; y <= MaxYear; y++)
                                    {
                                        var year = y;
                                        <option value="@year" disabled="@IsYearDisabled(year, idx)">@year</option>
                                    }
                                </select>
                                <select class="forma-date-picker-select"
                                        value="@CalendarMonth(month)"
                                        @onchange="e => OnMonthDropdownChange(idx, e)">
                                    @for (var m = 1; m <= _calendar.GetMonthsInYear(CalendarYear(month)); m++)
                                    {
                                        var mo = m;
                                        <option value="@mo" disabled="@IsMonthDisabled(CalendarYear(month), mo, idx)">@MonthName(CalendarYear(month), mo)</option>
                                    }
                                </select>
                            </div>
                            <FormaButton Variant="ButtonVariant.Ghost"
                                         class="forma-date-picker-nav"
                                         aria-label="@L["Next month"]"
                                         Disabled="!CanPanelGoNext(idx)"
                                         OnClick="() => PanelNext(idx)">
                                &#10095;
                            </FormaButton>
                        </div>
                        <div class="forma-date-picker-weekdays">
                            @{ var fdow = (int)_dtf.FirstDayOfWeek; }
                            @for (var wi = 0; wi < 7; wi++)
                            {
                                <span>@_dtf.AbbreviatedDayNames[(fdow + wi) % 7]</span>
                            }
                        </div>
                        <div class="forma-date-picker-days">
                            @foreach (var day in GetDaysForMonth(month, _dtf.FirstDayOfWeek))
                            {
                                @if (day is null)
                                {
                                    <span class="forma-date-picker-day empty"></span>
                                }
                                else
                                {
                                    var d = day.Value;
                                    var dayClasses = GetDayClasses(d);
                                    <button type="button"
                                            class="forma-date-picker-day@(dayClasses)"
                                            disabled="@IsDayDisabled(d)"
                                            aria-label="@DayLabel(d)"
                                            aria-current="@(MarksToday(dayClasses) ? "date" : null)"
                                            aria-pressed="@(MarksSelected(dayClasses) ? "true" : null)"
                                            @onclick="() => SelectDay(d)"
                                            @onmouseenter="() => HoverDay(d)">
                                        @_calendar.GetDayOfMonth(d.ToDateTime(TimeOnly.MinValue))
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
            @if (ShowPresets && IsRangeMode)
            {
                <div class="forma-date-picker-presets" dir="@_textDirection">
                    <FormaButton Variant="ButtonVariant.Ghost"
                                 class="forma-date-picker-preset"
                                 Disabled="IsPresetDisabled(Preset.Today)"
                                 OnClick="() => ApplyPreset(Preset.Today)">
                        @L["Today"]
                    </FormaButton>
                    <FormaButton Variant="ButtonVariant.Ghost"
                                 class="forma-date-picker-preset"
                                 Disabled="IsPresetDisabled(Preset.Yesterday)"
                                 OnClick="() => ApplyPreset(Preset.Yesterday)">
                        @L["Yesterday"]
                    </FormaButton>
                    <FormaButton Variant="ButtonVariant.Ghost"
                                 class="forma-date-picker-preset"
                                 Disabled="IsPresetDisabled(Preset.Last7Days)"
                                 OnClick="() => ApplyPreset(Preset.Last7Days)">
                        @L["Last 7 days"]
                    </FormaButton>
                    <FormaButton Variant="ButtonVariant.Ghost"
                                 class="forma-date-picker-preset"
                                 Disabled="IsPresetDisabled(Preset.Last30Days)"
                                 OnClick="() => ApplyPreset(Preset.Last30Days)">
                        @L["Last 30 days"]
                    </FormaButton>
                    <FormaButton Variant="ButtonVariant.Ghost"
                                 class="forma-date-picker-preset"
                                 Disabled="IsPresetDisabled(Preset.ThisMonth)"
                                 OnClick="() => ApplyPreset(Preset.ThisMonth)">
                        @L["This month"]
                    </FormaButton>
                    <FormaButton Variant="ButtonVariant.Ghost"
                                 class="forma-date-picker-preset"
                                 Disabled="IsPresetDisabled(Preset.LastMonth)"
                                 OnClick="() => ApplyPreset(Preset.LastMonth)">
                        @L["Last month"]
                    </FormaButton>
                </div>
            }
        </div>
    }
        </div>
    </ChildContent>
</FormaField>
