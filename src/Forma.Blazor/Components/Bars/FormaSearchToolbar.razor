@inherits FormaElementBase

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    <div class="forma-search-toolbar-search">
        <FormaSearchBox Options="Search"
                        OnSearch="OnSearch"
                        aria-label="@Search.Placeholder" />
    </div>
    @if (Items.Count > 0)
    {
        <FormaToolbar Class="forma-search-toolbar-items" Label="@Label" Items="Items" ShowLabels="true" OnCommand="OnCommand" />
    }
</div>
