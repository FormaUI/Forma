<div class="forma-search-toolbar">
    <div class="forma-search-toolbar-search">
        <FormaSearchBox Placeholder="@SearchPlaceholder"
                        SearchDebounce="SearchDelay"
                        OnSearch="OnSearch"
                        aria-label="@SearchPlaceholder" />
    </div>
    @if (Items.Count > 0)
    {
        <FormaToolbar Class="forma-search-toolbar-items" Label="@Label" Items="Items" ShowLabels="true" OnCommand="OnCommand" />
    }
</div>
