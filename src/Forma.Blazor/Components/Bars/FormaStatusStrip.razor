@namespace Forma.Blazor.Components.Bars
@inherits FormaElementBase

@if (Items.Count > 0 || EmptyMode == StatusStripEmptyMode.Shown)
{
    <FormaVisibility Hidden="Hidden" Animated="Animated">
        <div id="@Id"
             data-rid="@RuntimeId"
             class="@RootClass"
             style="@RootStyle"
             @attributes="AdditionalAttributes"
             @ref="RootElement">
            @if (Items.Count > 0)
            {
                <FormaToolbar Class="forma-status-strip-items" Label="@Label" Items="Items" Disabled="Disabled" OnCommand="OnCommand" />
            }
        </div>
    </FormaVisibility>
}
