<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>Forma.Framework.Office</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework.Localization.Abstractions\Forma.Framework.Localization.Abstractions.csproj" />
        <ProjectReference Include="..\Forma.Framework.Resources\Forma.Framework.Resources.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="*.json" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="HtmlSanitizer" Version="9.1.982" />
      <PackageReference Include="OfficeIMO.Excel" Version="3.2.0" />
      <PackageReference Include="OfficeIMO.PowerPoint" Version="3.2.0" />
      <PackageReference Include="OfficeIMO.Word.Html" Version="3.2.0" />
    </ItemGroup>

</Project>
