<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Forma.Framework.Emojis.Twemoji</RootNamespace>
        <PackageId>2Site.Forma.AddOns.Emojis.Twemoji</PackageId>
        <StaticWebAssetBasePath>_content/$(AssemblyName)</StaticWebAssetBasePath>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- The emoji artwork ships in this package, so its notice travels with it. -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework.Emojis\Forma.Framework.Emojis.csproj" />
    </ItemGroup>

    <!-- Embedded in the assembly, so packing it again as content only duplicates it. -->
    <ItemGroup>
        <EmbeddedResource Include="_assets\**\*.json" />
        <Content Remove="_assets\**\*.json" />
    </ItemGroup>

</Project>
