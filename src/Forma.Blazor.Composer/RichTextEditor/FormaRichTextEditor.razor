@namespace Forma.Blazor.Components.Composer.RichTextEditor
@inherits FormaComponentBase
@using Forma.Blazor.Components.Composer.Dialogs

<div class="forma-composer-rich-text-editor">
    <div @ref="_editorElement"
         class="forma-composer-rich-text-canvas forma-prose"
         contenteditable="@(ContentEditable ? "true" : "false")"
         role="textbox"
         aria-multiline="true"
         aria-label="@L["Rich Text Document"]"
         aria-disabled="@IsDisabled"
         aria-readonly="@IsReadOnly"
         tabindex="0"
         spellcheck="true"></div>

    @if (!IsDisabled && !IsReadOnly && _isAttached && IsSelectionBarShown)
    {
        <FormaRichTextSelectionBar EditorElement="_editorElement" OnCommand="HandleCommand" />
    }

    <div class="forma-composer-rich-text-announcer" role="status" aria-live="polite">@_blockAnnouncement</div>

    @if (_isAttached)
    {
        @if (_dialog.Kind == RichTextDialogKind.Link)
        {
            <FormaComposerLinkDialog Opened="true"
                                     IsAnchor="_isLinkAnchorMode"
                                     Reopening="_dialog.ExistingResult"
                                     OnInsert="HandleLinkInsertedAsync"
                                     OnCancel="CloseDialog" />
        }

        @if (_dialog.Kind == RichTextDialogKind.Table)
        {
            <FormaComposerTableDialog Opened="true"
                                      OnInsert="HandleTableInsertedAsync"
                                      OnCancel="CloseDialog" />
        }

        @if (_dialog.Kind == RichTextDialogKind.Video)
        {
            <FormaComposerVideoDialog Opened="true"
                                      Reopening="_dialog.ExistingResult"
                                      OnInsert="HandleVideoInsertedAsync"
                                      OnCancel="CloseDialog" />
        }

        @if (_dialog.Kind == RichTextDialogKind.Image)
        {
            <FormaComposerImageDialog Opened="true"
                                      Reopening="_dialog.ExistingResult"
                                      OnInsert="HandleImageInsertedAsync"
                                      OnCancel="CloseDialog" />
        }

        @if (_dialog.Kind == RichTextDialogKind.Embed)
        {
            <FormaComposerEmbedDialog Opened="true"
                                      Reopening="_dialog.ExistingResult"
                                      OnInsert="HandleEmbedInsertedAsync"
                                      OnCancel="CloseDialog" />
        }
    }
</div>

