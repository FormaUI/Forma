@namespace Forma.Blazor.Components.Composer.RichTextEditor.Plugins
@inherits FormaComponentBase
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Feedback
@using Forma.Framework.Icons

<span class="forma-composer-emoji-anchor" @ref="_anchorElement">
    <FormaButton @ref="Trigger"
                 Variant="ButtonVariant.Ghost"
                 IconOnly="true"
                 aria-label="@L["Emoji"]"
                 aria-haspopup="true"
                 aria-expanded="@(IsOpen ? "true" : "false")"
                 aria-controls="@(IsOpen ? PopoverId : null)"
                 title="@L["Emoji"]"
                 OnClick="ToggleAsync">
        <FormaIcon Icon="Glyph.Emoji" Size="IconSize.Small" />
    </FormaButton>
</span>

<FormaPopover @ref="Popover" Anchor="_anchorElement" OnOpenChanged="_ => { }" id="@PopoverId">
    <FormaEmojiPicker OnSelect="HandleSelectAsync" @bind-Recent="_recentEmojis" Options="PickerOptions" />
</FormaPopover>
