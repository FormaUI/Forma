@namespace Forma.Blazor.Components.Composer
@inherits FormaElementBase

<FormaVisibility Hidden="Hidden" Animated="Animated">
    <div id="@Id"
         data-rid="@Context.RuntimeId"
         class="@RootClass"
         style="@RootStyle"
         @attributes="AdditionalAttributes"
         @ref="RootElement">
        <FormaComposerCommandBar
            Label="@L["Plugin Commands"]"
            Items="_visibleItems"
            Disabled="Disabled"
            KeyBindings="KeyBindings"
            OnCommand="OnCommand">
            <TrailingContent>
                @if (_overflowingActions.Count > 0)
                {
                    <FormaOverflowMenu Orientation="MenuOrientation.Vertical"
                                       TriggerOptions="ButtonOptions.MiniGhostIcon"
                                       Disabled="Disabled"
                                       Label="@L["More Plugin Commands"]">
                        @foreach (var action in _overflowingActions)
                        {
                            <FormaDropDownMenuItem OnClick="() => OnCommand.InvokeAsync(action.Command)">
                                @if (action.Icon is { } icon)
                                {
                                    <FormaIcon Icon="icon" Size="IconSize.Small" />
                                }
                                <span>@action.Title</span>
                            </FormaDropDownMenuItem>
                        }
                    </FormaOverflowMenu>
                }
            </TrailingContent>
        </FormaComposerCommandBar>
    </div>
</FormaVisibility>
