@namespace Forma.Blazor.Components.Composer
@inherits FormaComponentBase

<FormaCommandArea Class="forma-composer-toolbar">
    @foreach (var (bar, index) in Bars.Select((bar, index) => (bar, index)))
    {
        <FormaComposerCommandBar
            Label="@bar.Label"
            Items="bar.Items"
            ShowHistory="index == 0 && View is null"
            Disabled="Disabled"
            KeyBindings="KeyBindings"
            PluginStates="Owner.ActiveStates"
            OnCommand="OnCommand">
            <TrailingContent>
                @if (index == 0 && PluginItems.Count > 0)
                {
                    <FormaButton Variant="ButtonVariant.Ghost"
                                 IconOnly="true"
                                 Disabled="Disabled"
                                 OnClick="TogglePlugins"
                                 aria-expanded="@(_arePluginsShown ? "true" : "false")"
                                 aria-controls="@PluginsId"
                                 aria-label="@L["Plugin Commands"]"
                                 title="@L["Plugin Commands"]">
                        <FormaIcon Icon="Glyph.MoreVertical" Size="IconSize.Small" />
                    </FormaButton>
                }
            </TrailingContent>
        </FormaComposerCommandBar>
    }

    @if (PluginItems.Count > 0)
    {
        <FormaComposerPluginsBar
            Id="@PluginsId"
            Items="PluginItems"
            Disabled="Disabled"
            KeyBindings="KeyBindings"
            OnCommand="OnCommand"
            Hidden="!_arePluginsShown"
            Animated="true" />
    }
</FormaCommandArea>
