<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>The contracts a FormaComposer plugin is written against: what a plugin contributes, what it reads of the composer while it runs, and what it can ask the composer to do.</Description>
        <RootNamespace>Forma.Framework.Composer</RootNamespace>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework.Plugins\Forma.Framework.Plugins.csproj" />
        <ProjectReference Include="..\Forma.Framework.Resources\Forma.Framework.Resources.csproj" />
        <ProjectReference Include="..\Forma.Framework.Sanitization\Forma.Framework.Sanitization.csproj" />
        <ProjectReference Include="..\Forma.Framework.Icons\Forma.Framework.Icons.csproj" />
        <ProjectReference Include="..\Forma.Framework.Toolbar\Forma.Framework.Toolbar.csproj" />
    </ItemGroup>

</Project>
