<Project>

    <!--
        What the build does for an assembly that localizes. This file ships in the library's package,
        named for the package there, beside the C# file its tasks are compiled from, and is imported into
        every project that references it, directly or through another package. For any project it embeds
        the config file and every locale file, found by the $localization entry each one carries, under the
        project's root namespace and the file's path, so a project names none of them and a browser, with
        no folder to read, an application MAUI packages, with none beside it, and a server, whose build
        copies none beside its binary, read them all; for an application it marks the assembly as the
        application; for a server it records the client it references that is an application embedding
        locale files; and for a locale pack, a project that declared IsLocalePack, it does the rest: a pack
        is a project of nothing but locale files, for other assemblies' types, so it compiles no code,
        embeds its locale files under their paths alone so that a resource name spells the tree a reader
        sees, holds them to the cultures it declares, and carries in its own package a targets file that
        records the pack in whatever references it, since nothing else would. What a locale file is, what
        it is named and which culture it is for, LocaleBuildTasks.cs decides; this file says when.
    -->

    <!-- An assembly's config file sits at its root and is embedded whenever it is there, under the name its path forms, since the SDK embeds nothing by default and would ship it as content instead. -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/.locale.json')">
        <EmbeddedResource Include=".locale.json" LogicalName="$(RootNamespace)/.locale.json" Condition="'$(RootNamespace)' != ''" />
        <EmbeddedResource Include=".locale.json" LogicalName=".locale.json" Condition="'$(RootNamespace)' == ''" />
        <Content Remove=".locale.json" />
        <None Remove=".locale.json" />
    </ItemGroup>

    <ItemGroup>
        <_BlazorWebViewPlatformPackage Include="@(PackageReference->WithMetadataValue('Identity', 'Microsoft.AspNetCore.Components.WebView.Wpf'));@(PackageReference->WithMetadataValue('Identity', 'Microsoft.AspNetCore.Components.WebView.WindowsForms'));@(PackageReference->WithMetadataValue('Identity', 'Microsoft.AspNetCore.Components.WebView.Maui'))" />
    </ItemGroup>

    <UsingTask TaskName="ReadLocaleConfiguration" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <Task>
            <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)LocaleBuildTasks.cs" />
        </Task>
    </UsingTask>

    <UsingTask TaskName="PrepareLocaleResources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <Task>
            <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)LocaleBuildTasks.cs" />
        </Task>
    </UsingTask>

    <!--
        The project's locale files: every JSON file carrying the $localization entry, in the folder of
        locale files its .locale.json names, .locales by default, or anywhere outside a folder whose name
        starts with a dot, outside the build output, and left to an item that embeds it, which keeps the
        name it gives the file, or to an item in the project file that copies it beside the output, which
        keeps it a file there. An application is a WebAssembly client, a server built on the Web SDK, or a
        Blazor Hybrid application, known as an application referencing its platform's web view package, its
        output an executable or, on Android, whose build compiles an application's code as a library, the
        project the Android SDK marks as an application.
    -->
    <Target Name="CollectLocaleFiles">
        <PropertyGroup>
            <_IsLocaleApplication Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true' or '$(UsingMicrosoftNETSdkWeb)' == 'true' or ('@(_BlazorWebViewPlatformPackage)' != '' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or '$(AndroidApplication)' == 'true'))">true</_IsLocaleApplication>
            <_LocaleResourcePrefix Condition="'$(RootNamespace)' != '' and '$(IsLocalePack)' != 'true'">$(RootNamespace)/</_LocaleResourcePrefix>
            <_LocaleFileCultures Condition="'$(IsLocalePack)' == 'true'">$(LocalePackCulture)</_LocaleFileCultures>
        </PropertyGroup>
        <Error Condition="'$(IsLocalePack)' == 'true' and '$(LocalePackCulture)' == ''" Text="A locale pack declares the culture it carries in LocalePackCulture, one or several separated by semicolons; this project declares none." />
        <!-- A pack has no config of its own, and the runtime reads its names with .locales left out. -->
        <PropertyGroup>
            <_LocalesDir>.locales</_LocalesDir>
        </PropertyGroup>
        <ReadLocaleConfiguration ConfigFile="$(MSBuildProjectDirectory)/.locale.json" Condition="'$(IsLocalePack)' != 'true'">
            <Output TaskParameter="LocalesDir" PropertyName="_LocalesDir" />
        </ReadLocaleConfiguration>
        <ItemGroup>
            <_CopiedFile Include="@(Content)" Condition="'%(Content.DefiningProjectFullPath)' == '$(MSBuildProjectFullPath)' and '%(Content.CopyToOutputDirectory)' != '' and '%(Content.CopyToOutputDirectory)' != 'Never'" />
            <_CopiedFile Include="@(None)" Condition="'%(None.DefiningProjectFullPath)' == '$(MSBuildProjectFullPath)' and '%(None.CopyToOutputDirectory)' != '' and '%(None.CopyToOutputDirectory)' != 'Never'" />
            <_LocaleFileCandidate Include="**/$(_LocalesDir)/**/*.json" Exclude="$(DefaultItemExcludes);**/node_modules/**;@(EmbeddedResource);@(_CopiedFile)" />
            <_LocaleFileCandidate Include="**/*.json" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);**/node_modules/**;@(EmbeddedResource);@(_CopiedFile);@(_LocaleFileCandidate)" />
        </ItemGroup>
        <PrepareLocaleResources Files="@(_LocaleFileCandidate)" Prefix="$(_LocaleResourcePrefix)" LocalesDir="$(_LocalesDir)" Cultures="$(_LocaleFileCultures)" Condition="'@(_LocaleFileCandidate)' != ''">
            <Output TaskParameter="LocaleFiles" ItemName="_LocaleFile" />
        </PrepareLocaleResources>
    </Target>

    <!--
        Embeds the locale files under the names they were read with, named here rather than by the SDK,
        which would make a culture folder such as es-419 into es_419; an embedded file is no content, which
        a server would otherwise copy beside its binary.
    -->
    <Target Name="EmbedLocaleFiles" BeforeTargets="AssignTargetPaths" DependsOnTargets="CollectLocaleFiles">
        <ItemGroup>
            <EmbeddedResource Include="@(_LocaleFile)" WithCulture="false" />
            <Content Remove="@(_LocaleFile)" />
            <None Remove="@(_LocaleFile)" />
        </ItemGroup>
    </Target>

    <!-- Answers a server referencing this project with the project's assembly where it is an application embedding locale files, which the server reads too. -->
    <Target Name="GetHostLocaleAssemblyName" DependsOnTargets="CollectLocaleFiles" Returns="@(_HostLocaleAssemblyName)">
        <ItemGroup>
            <_HostLocaleAssemblyName Include="$(AssemblyName)" Condition="'$(_IsLocaleApplication)' == 'true' and '@(_LocaleFile)' != ''" />
        </ItemGroup>
    </Target>

    <!-- Records each referenced project that is an application embedding locale files, as a Web App's server references its client, so the server reads them as well as its own. -->
    <Target Name="RecordHostLocaleAssemblies" BeforeTargets="GetAssemblyAttributes" Condition="'@(ProjectReference)' != ''">
        <MSBuild Projects="@(ProjectReference)" Targets="GetHostLocaleAssemblyName" SkipNonexistentTargets="true">
            <Output TaskParameter="TargetOutputs" ItemName="_ReferencedHostLocaleAssembly" />
        </MSBuild>
        <ItemGroup>
            <AssemblyAttribute Include="Forma.Framework.Localization.LocaleReferenceAttribute" Condition="'@(_ReferencedHostLocaleAssembly)' != ''">
                <_Parameter1>%(_ReferencedHostLocaleAssembly.Identity)</_Parameter1>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <!-- Marks an application's assembly, whose recorded locales the runtime reads where it names no entry assembly, as a native host on Android or iOS names none. -->
    <Target Name="RecordLocaleApplication" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="CollectLocaleFiles" Condition="'$(IsLocalePack)' != 'true'">
        <ItemGroup Condition="'$(_IsLocaleApplication)' == 'true'">
            <AssemblyAttribute Include="Forma.Framework.Localization.LocaleApplicationAttribute" />
        </ItemGroup>
    </Target>

    <PropertyGroup Condition="'$(IsLocalePack)' == 'true'">
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeLocalePackTargetsInPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <!--
        The targets file NuGet imports into a project referencing this pack's package, written at pack
        time with this assembly's name in place, because the name a consumer records is the one the
        runtime loads, whatever the package is called.
    -->
    <Target Name="IncludeLocalePackTargetsInPackage" Condition="'$(IsLocalePack)' == 'true'">
        <PropertyGroup>
            <_LocalePackTargetsPath>$(IntermediateOutputPath)$(PackageId).targets</_LocalePackTargetsPath>
            <_LocalePackTargetsContent>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)LocalePack.targets').Replace('{AssemblyName}', '$(AssemblyName)'))</_LocalePackTargetsContent>
        </PropertyGroup>
        <WriteLinesToFile File="$(_LocalePackTargetsPath)" Lines="$(_LocalePackTargetsContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(_LocalePackTargetsPath)" PackagePath="build\$(PackageId).targets" />
        </ItemGroup>
    </Target>

    <!-- A pack's assembly states the cultures it carries as metadata, where a tool reading a built pack finds them. -->
    <ItemGroup Condition="'$(IsLocalePack)' == 'true' and '$(LocalePackCulture)' != ''">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>LocalePackCulture</_Parameter1>
            <_Parameter2>$(LocalePackCulture)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Answers a project that references this pack directly rather than through its package, which imports no targets file, so that it can record the pack itself. -->
    <Target Name="GetLocalePackName" Condition="'$(IsLocalePack)' == 'true'" Returns="$(AssemblyName)" />

</Project>
