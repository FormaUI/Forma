<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Forma's localization behind Microsoft's IStringLocalizer, so code written against it reads Forma's locale files, holes and plural forms.</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
    </ItemGroup>

</Project>
