<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <Description>The input router: the script that resolves every key, press, wheel turn and drop on the page to one owner, and the C# a component registers its elements through.</Description>
        <IsPackable>true</IsPackable>
        <StaticWebAssetBasePath>_content/forma/input</StaticWebAssetBasePath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" />
        <PackageReference Include="Microsoft.JSInterop" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework.Input\Forma.Framework.Input.csproj" />
        <ProjectReference Include="..\Forma.Framework.JavaScript.Interop\Forma.Framework.JavaScript.Interop.csproj" />
    </ItemGroup>

</Project>
