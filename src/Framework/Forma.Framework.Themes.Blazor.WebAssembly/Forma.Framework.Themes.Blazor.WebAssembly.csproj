<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>What the theme state needs from a WebAssembly client: the runtime's state registered with the page's theme coordinator of Forma.Framework.Themes.Browser.Interop as the runtime starts, before it renders, and the switch that requests through it.</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework.Themes\Forma.Framework.Themes.csproj" />
        <ProjectReference Include="..\Forma.Framework.Themes.Browser.Interop\Forma.Framework.Themes.Browser.Interop.csproj" />
    </ItemGroup>

</Project>
