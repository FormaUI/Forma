<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <Description>The browser capabilities Forma's components reach through JavaScript.</Description>
        <IsPackable>true</IsPackable>
        <StaticWebAssetBasePath>_content/forma/browser</StaticWebAssetBasePath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" />
        <PackageReference Include="Microsoft.JSInterop" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Forma.Framework.Browser.Blazor.Server" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework.Input.Interop\Forma.Framework.Input.Interop.csproj" />
        <ProjectReference Include="..\Forma.Framework.JavaScript.Interop\Forma.Framework.JavaScript.Interop.csproj" />
    </ItemGroup>

</Project>
