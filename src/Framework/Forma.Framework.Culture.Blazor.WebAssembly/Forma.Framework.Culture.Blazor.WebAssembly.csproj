<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>What the culture state needs from a WebAssembly client: the runtime's state registered with the page's culture coordinator of Forma.Framework.Culture.Browser.Interop as the runtime starts, before it renders, and each pair the state applies set as the process's default cultures too, so an event, a timer or any work the runtime starts after a switch runs in the new pair.</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework.Culture\Forma.Framework.Culture.csproj" />
        <ProjectReference Include="..\Forma.Framework.Culture.Browser.Interop\Forma.Framework.Culture.Browser.Interop.csproj" />
    </ItemGroup>

</Project>
