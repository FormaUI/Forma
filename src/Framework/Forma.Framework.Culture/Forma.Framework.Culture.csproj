<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>The culture state each user scope holds: the culture that formats dates, numbers and collation, and the UI culture that chooses strings and direction, kept apart so an application can show English text with German formats.</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Forma.Framework.Culture.Blazor.Server" />
        <InternalsVisibleTo Include="Forma.Framework.Culture.Blazor.WebAssembly" />
        <InternalsVisibleTo Include="Forma.Framework.Culture.Blazor.WebView" />
        <InternalsVisibleTo Include="Forma.Framework.Culture.Browser.Interop" />
        <InternalsVisibleTo Include="Forma.Framework.Culture.Router.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework.Events\Forma.Framework.Events.csproj" />
    </ItemGroup>

</Project>
