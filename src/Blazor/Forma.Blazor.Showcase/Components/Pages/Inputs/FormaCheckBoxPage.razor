@page "/checkbox"
@attribute [ShowcasePage("FormaCheckBox")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Inputs

<h1>FormaCheckBox</h1>
<p class="description">@L["A checkbox bound to a Boolean, with a third, indeterminate state for a choice that governs others. A caller can also take the checked state over entirely, which is what a select-all needs when only some of its children are checked."]</p>

<EditForm Model="Model" FormName="checkbox-demo" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="demo-section">
        <h2>@L["Basic"]</h2>
        <div class="demo-box demo-row">
            <FormaCheckBox @bind-Value="Model.Subscribed">@L["Subscribe to updates"]</FormaCheckBox>
            <FormaCheckBox @bind-Value="Model.Featured">@L["Featured"]</FormaCheckBox>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Disabled"]</h2>
        <div class="demo-box demo-row">
            <FormaCheckBox @bind-Value="Model.Off" Disabled="true">@L["Off"]</FormaCheckBox>
            <FormaCheckBox @bind-Value="Model.On" Disabled="true">@L["On"]</FormaCheckBox>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Indeterminate"]</h2>
        <p class="description">@L["The parent checkbox reflects and controls the state of its children, showing a dash when only some are checked."]</p>
        <div class="demo-box">
            <FormaCheckBox Value="@AllChildrenChecked" ValueExpression="() => AllChildrenChecked" Indeterminate="@SomeChildrenChecked" PreventDefault="true" OnClick="ToggleAllChildren">@L["Select all"]</FormaCheckBox>
            <div class="demo-row demo-checkbox-children">
                @for (var i = 0; i < Model.Children.Count; i++)
                {
                    var index = i;
                    <FormaCheckBox @bind-Value="Model.Children[index]">@L["Item {Number}", index + 1]</FormaCheckBox>
                }
            </div>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Required in a Form"]</h2>
        <p class="description">@L["A checkbox is a form input: submitting without accepting shows the validation message under it, and accepting clears it."]</p>
        <div class="demo-box">
            <FormaCheckBox @bind-Value="Model.Accepted">@L["I accept the terms"]</FormaCheckBox>
            <ValidationMessage For="() => Model.Accepted" />
            <div class="demo-row">
                <FormaButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary">@L["Submit"]</FormaButton>
                @if (_submitted)
                {
                    <span class="demo-note">@L["Submitted."]</span>
                }
            </div>
        </div>
    </div>
</EditForm>

@code {
    private bool _submitted;

    private CheckBoxDemoModel Model { get; set; } = default!;

    protected override void OnInitialized()
        => Model = new CheckBoxDemoModel(L)
        {
            Featured = true,
            On = true,
        };

    private bool AllChildrenChecked
        => Model.Children.TrueForAll(value => value);

    private bool SomeChildrenChecked
        => Model.Children.Exists(value => value) && !AllChildrenChecked;

    private void ToggleAllChildren()
    {
        var next = !AllChildrenChecked;

        for (var index = 0; index < Model.Children.Count; index++)
        {
            Model.Children[index] = next;
        }
    }

    private void HandleSubmit()
        => _submitted = true;

    private sealed class CheckBoxDemoModel(IStringLocale localizer) : IValidatableObject
    {
        public bool Subscribed { get; set; }
        public bool Featured { get; set; }
        public bool Off { get; set; }
        public bool On { get; set; }
        public List<bool> Children { get; } = [false, false, false];
        public bool Accepted { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!Accepted)
            {
                yield return new ValidationResult(localizer["You must accept the terms to continue."], [nameof(Accepted)]);
            }
        }
    }
}
