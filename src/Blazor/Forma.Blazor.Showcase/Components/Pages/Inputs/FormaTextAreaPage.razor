@page "/text-area"
@attribute [ShowcasePage("FormaTextArea")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Inputs

<h1>FormaTextArea</h1>
<p class="description">@L["A multi-line field wearing the same chrome as FormaTextBox: the floating label, focus ring and validation styling all come from the shared FormaField."]</p>

<EditForm EditContext="_editContext">

    <div class="demo-section">
        <h2>@L["Basic Usage"]</h2>
        <div class="demo-box">
            <FormaTextArea @bind-Value="_model.Notes" Label="@L["Notes"]" />
            <p class="demo-note">@L["Value"]: <code>@_model.Notes</code></p>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Taller Field"]</h2>
        <div class="demo-box">
            <FormaTextArea @bind-Value="_model.Summary" Label="@L["Summary"]" Rows="8" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Required and Length-Limited"]</h2>
        <p class="description">@L["Submit with the field empty to see the validation border and message."]</p>
        <div class="demo-box">
            <FormaTextArea @bind-Value="_model.Excerpt" Label="@L["Excerpt"]" Required="true" MaxLength="280" />
            <div class="demo-row">
                <FormaButton Variant="ButtonVariant.Primary" ReadsForm="true" OnClick="Validate">@L["Validate"]</FormaButton>
            </div>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Counting Characters"]</h2>
        <p class="description">@L["The count floats inside the field's end corner, clear of the resize grip, and reads out as a sentence rather than as glyphs. Without a maximum it simply counts up."]</p>
        <div class="demo-box">
            <FormaTextArea @bind-Value="_model.Tweet" Label="@L["Social post"]" MaxLength="280" ShowCharacterCount="true" />
            <FormaTextArea @bind-Value="_model.Comment" Label="@L["Comment"]" ShowCharacterCount="true" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Updating on Change"]</h2>
        <p class="description">@L["A long text reaches the component as its edit commits: as the field loses the focus, or before a shortcut or a button press runs. The count still follows every keystroke, kept in the browser, so the whole text never travels with each one."]</p>
        <div class="demo-box">
            <FormaTextArea @bind-Value="_model.Terms" Label="@L["Terms of Service"]" Rows="8" MaxLength="50000" ShowCharacterCount="true" UpdateOn="TextUpdate.Change" />
            <div class="demo-row">
                <FormaButton Variant="ButtonVariant.Primary" ReadsForm="true" OnClick="@(() => _savedTerms = _model.Terms)">@L["Save"]</FormaButton>
            </div>
            <p class="demo-note">@L["Saved"]: <code>@_savedTerms</code></p>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Disabled"]</h2>
        <p class="description">@L["A disabled field is dimmed, refuses the caret and shows a not-allowed cursor."]</p>
        <div class="demo-box">
            <FormaTextArea @bind-Value="_model.Locked" Label="@L["Locked note"]" disabled />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Beside a FormaTextBox"]</h2>
        <p class="description">@L["Both components share one stylesheet, so their borders, labels and focus rings cannot drift apart."]</p>
        <div class="demo-box">
            <FormaTextBox @bind-Value="_model.Title" Label="@L["Title"]" />
            <FormaTextArea @bind-Value="_model.Body" Label="@L["Body"]" />
        </div>
    </div>
</EditForm>

@code {
    private readonly DemoModel _model = new() { Locked = "Signed off by the editor." };
    private string? _savedTerms;
    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);
    }

    private void Validate()
    {
        var excerpt = _editContext.Field(nameof(DemoModel.Excerpt));
        _messages.Clear(excerpt);

        if (string.IsNullOrWhiteSpace(_model.Excerpt))
        {
            _messages.Add(excerpt, L["An excerpt is required."]);
        }

        _editContext.NotifyValidationStateChanged();
    }

    private sealed class DemoModel
    {
        public string? Notes { get; set; }
        public string? Summary { get; set; }
        public string? Excerpt { get; set; }
        public string? Tweet { get; set; }
        public string? Comment { get; set; }
        public string? Title { get; set; }
        public string? Body { get; set; }
        public string? Locked { get; set; }
        public string? Terms { get; set; }
    }
}
