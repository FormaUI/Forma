@page "/time-picker"
@attribute [ShowcasePage("FormaTimePicker")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Inputs

<h1>FormaTimePicker</h1>
<p class="description">@L["A field for a time of day, typed as the formatting culture writes it or chosen from a list of suggested times. The down arrow opens the list, the arrows move through it, Enter takes the highlighted time and Escape closes it without taking one. A time the field cannot take is reported under it and never written."]</p>

<EditForm Model="Model" FormName="time-picker-demo" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="demo-section">
        <h2>@L["Basic"]</h2>
        <p class="description">@L["A time that can be empty, with a suggestion every half hour. A typed time the list does not suggest, such as a quarter past, is still a time the field takes."]</p>
        <div class="demo-box">
            <FormaTimePicker @bind-Value="Model.Start" Label="@L["Starts"]" />
            <p class="demo-note">@L["Value"]: <code>@FormatValue(Model.Start)</code></p>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["With Seconds"]</h2>
        <p class="description">@L["A time with seconds shows them, so it never reads as a rounder time than it holds."]</p>
        <div class="demo-box">
            <FormaTimePicker @bind-Value="Model.Arrival" Label="@L["Arrival"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Opening Hours"]</h2>
        <p class="description">@L["Between 9:00 and 17:00. The list holds the times between them, and a time typed outside them is reported."]</p>
        <div class="demo-box">
            <FormaTimePicker @bind-Value="Model.Appointment" Label="@L["Appointment"]" Min="new TimeOnly(9, 0)" Max="new TimeOnly(17, 0)" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Every Quarter Hour"]</h2>
        <p class="description">@L["Only whole quarter hours are times the field takes. A time between two is reported with the quarter hours either side of it, rather than rounded onto one."]</p>
        <div class="demo-box">
            <FormaTimePicker @bind-Value="Model.Slot" Label="@L["Slot"]" Step="TimeSpan.FromMinutes(15)" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Across Midnight"]</h2>
        <p class="description">@L["From 22:00 to 02:00, a range that runs through midnight. The list runs from its start round to its end, and a time in the middle of the day is reported."]</p>
        <div class="demo-box">
            <FormaTimePicker @bind-Value="Model.NightShift" Label="@L["Night Shift"]" Min="new TimeOnly(22, 0)" Max="new TimeOnly(2, 0)" ListInterval="TimeSpan.FromHours(1)" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Required in a Form"]</h2>
        <p class="description">@L["A time picker is a form input: submitting without a time shows the validation message under it, and entering one clears it."]</p>
        <div class="demo-box">
            <FormaTimePicker @bind-Value="Model.Pickup" Label="@L["Pickup"]" Required="true" />
            <div class="demo-row">
                <FormaButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary">@L["Submit"]</FormaButton>
                @if (_isSubmitted)
                {
                    <span class="demo-note">@L["Submitted."]</span>
                }
            </div>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["A Time That Cannot Be Empty"]</h2>
        <p class="description">@L["Bound to a time rather than a nullable one, the field always holds a time: clearing it reports the field and keeps the time it held until another is entered."]</p>
        <div class="demo-box">
            <FormaTimePicker @bind-Value="Model.Alarm" Label="@L["Alarm"]" />
            <p class="demo-note">@L["Value"]: <code>@Model.Alarm.ToString("t", CultureState.Culture)</code></p>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Every Second"]</h2>
        <p class="description">@L["A suggestion for every second of the day, 86,400 of them. The list draws only the times near what it shows, so it opens and scrolls as quickly as a short one."]</p>
        <div class="demo-box">
            <FormaTimePicker @bind-Value="Model.Lap" Label="@L["Lap"]" ListInterval="TimeSpan.FromSeconds(1)" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Disabled and Read-Only"]</h2>
        <div class="demo-box">
            <div class="demo-stack">
                <FormaTimePicker @bind-Value="Model.LockedValue" Label="@L["Disabled"]" Disabled="true" />
                <FormaTimePicker @bind-Value="Model.LockedValue" Label="@L["Read-Only"]" ReadOnly="true" />
            </div>
        </div>
    </div>
</EditForm>

@code {
    private bool _isSubmitted;

    private TimePickerDemoModel Model { get; set; } = default!;

    protected override void OnInitialized()
        => Model = new TimePickerDemoModel(L) { Arrival = new TimeOnly(9, 30, 45), Alarm = new TimeOnly(7, 0), LockedValue = new TimeOnly(12, 0) };

    private string FormatValue(TimeOnly? time)
        => time?.ToString("T", CultureState.Culture) ?? "null";

    private void HandleSubmit()
        => _isSubmitted = true;

    private sealed class TimePickerDemoModel(IStringLocale localizer) : IValidatableObject
    {
        public TimeOnly? Start { get; set; }
        public TimeOnly? Arrival { get; set; }
        public TimeOnly? Appointment { get; set; }
        public TimeOnly? Slot { get; set; }
        public TimeOnly? NightShift { get; set; }
        public TimeOnly? Pickup { get; set; }
        public TimeOnly Alarm { get; set; }
        public TimeOnly? Lap { get; set; }
        public TimeOnly? LockedValue { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Pickup is null)
            {
                yield return new ValidationResult(localizer["A pickup time is required."], [nameof(Pickup)]);
            }
        }
    }
}
