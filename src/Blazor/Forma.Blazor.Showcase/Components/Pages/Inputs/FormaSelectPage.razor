@page "/select"
@attribute [ShowcasePage("FormaSelect")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Forma.Blazor.Components.Inputs

<h1>FormaSelect</h1>
<p class="description">@L["A themed single-select: a trigger button opening an anchored, keyboard-navigable option list. The popover stays anchored to its trigger wherever the page scrolls."]</p>

<EditForm Model="Model" FormName="select-demo" OnValidSubmit="HandleSubmit">
    <div class="demo-section">
        <h2>@L["Basic"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.Culture" Options="CultureOptions" Label="@L["Culture"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["With Placeholder"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.Status"
                         Options="StatusOptions"
                         Label="@L["Status"]"
                         Placeholder="@L["Choose a status"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Pre-Selected Value"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.PreSelectedRole" Options="RoleOptions" Label="@L["Role"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Options with an Icon"]</h2>
        <p class="description">@L["An option can carry an icon ahead of its label, and a screen reader reads what the icon says with the option, so its state never rests on the glyph alone."]</p>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.EditedLanguage" Options="LanguageOptions" Label="@L["Language"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["An Option That Can't Be Chosen"]</h2>
        <p class="description">@L["An option can be shown but not chosen: it reads in the disabled tone, the arrows and typing pass over it, and a press on it chooses nothing."]</p>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.Plan" Options="PlanOptions" Label="@L["Plan"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Disabled"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.DisabledStatus"
                         Options="StatusOptions"
                         Label="@L["Status"]"
                         Disabled="true" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["No Options Yet"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.EmptyChoice" Options="_emptyOptions" Label="@L["Category"]" />
        </div>
    </div>
</EditForm>

@code {
    private static readonly IReadOnlyList<SelectOption<int?>> CultureOptions =
    [
        new(1, "Español"),
        new(2, "English"),
    ];

    private static readonly IReadOnlyList<SelectOption<int?>> StatusOptions =
    [
        new(1, "Draft"),
        new(2, "Scheduled"),
        new(3, "Published"),
    ];

    private static readonly IReadOnlyList<SelectOption<int?>> RoleOptions =
    [
        new(1, "Admin"),
        new(2, "Manager"),
        new(3, "Member"),
    ];

    private static readonly IReadOnlyList<SelectOption<int?>> PlanOptions =
    [
        new(1, "Free"),
        new(2, "Team"),
        new(3, "Enterprise") { IsDisabled = true },
    ];

    private readonly List<SelectOption<int?>> _emptyOptions = [];

    private SelectDemoModel Model { get; set; } = new()
    {
        PreSelectedRole = 2,
        EditedLanguage = 2,
    };

    // The languages an article is written in, each marked by how much of its text is written.
    private IReadOnlyList<SelectOption<int?>> LanguageOptions =>
    [
        new(1, "Español") { Icon = Glyph.CircleCheck, IconLabel = L["Fully written"] },
        new(2, "English") { Icon = Glyph.HourglassProgress, IconLabel = L["Partly written"] },
        new(3, "Français") { Icon = Glyph.Empty, IconLabel = L["Not written yet"] },
    ];

    private void HandleSubmit() { }

    private sealed class SelectDemoModel
    {
        public int? Culture { get; set; }
        public int? Status { get; set; }
        public int? PreSelectedRole { get; set; }
        public int? EditedLanguage { get; set; }
        public int? Plan { get; set; }
        public int? DisabledStatus { get; set; }
        public int? EmptyChoice { get; set; }
    }
}
