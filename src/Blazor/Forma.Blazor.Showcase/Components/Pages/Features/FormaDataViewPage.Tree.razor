@page "/data-view/tree"
@rendermode InteractiveServer

<h1>FormaDataView</h1>
<p class="description">@L["This tab shows the tree as a view of the data view over a folder hierarchy: the folders as nodes under their parents, opened and closed from their disclosures and the keyboard, open on load where the host names them, and standing beside the grid as a sidebar whose chosen folder the grid shows the contents of."]</p>

<div class="demo-section">
    <h2>@L["A Folder Tree Beside a Grid"]</h2>
    <p class="description">@L["Choose a folder in the tree, or activate one in the grid, and the grid shows what it holds; the tree marks the current folder and the status names it. Arrow keys move among the nodes, the inline arrows open and close them, and typing a letter jumps to the next folder starting with it."]</p>
    <div class="demo-box demo-row demo-controls">
        <FormaButton Variant="ButtonVariant.Secondary" Disabled="@(_currentFolder is null)" OnClick="() => _currentFolder = null">@L["Back to the Roots"]</FormaButton>
    </div>
    <div class="demo-box demo-box-bounded">
        <FormaDataView TItem="ShowcaseEntry" Items="DataViewShowcaseFolders.All" EnablePagination="false" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.Parent)" HasChildren="@(entry => entry.IsFolder)" @bind-CurrentItem="_currentFolder" EnableItemSelection="true" AddressOptions='@(new DataViewAddressOptions("folders"))'>
            <ChildContent>
                <FormaDataTree TItem="ShowcaseEntry" SelectsCurrent="true" NodeFilter="@(entry => entry.IsFolder)" aria-label="@L["Folders"]">
                    <ThumbnailTemplate Context="entry"><FormaIcon Icon="@entry.Glyph" Size="IconSize.Small" /></ThumbnailTemplate>
                </FormaDataTree>
                <FormaDataGrid TItem="ShowcaseEntry">
                    <Columns>
                        <FormaTemplateColumn Title="@L["Name"]" Context="entry">
                            <span class="demo-entry"><FormaIcon Icon="@entry.Glyph" Size="IconSize.Small" /> @entry.Name</span>
                        </FormaTemplateColumn>
                        <FormaPropertyColumn Property="@(entry => entry.Kind)" Title="@L["Kind"]" Sortable="true" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["Showing: {Folder}", _currentFolder?.Name ?? L["the roots"].Value]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Folders Open on Load"]</h2>
    <p class="description">@L["The host names Documents and Pictures to start open, and Holidays, inside Pictures, as the current folder, the way an explorer reopens the branches its reader left open. Each opens once, so a folder closed now stays closed as the grid sorts."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView TItem="ShowcaseEntry" Items="DataViewShowcaseFolders.All" EnablePagination="false" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.Parent)" HasChildren="@(entry => entry.IsFolder)" InitialOpenKeys="OpenOnLoadKeys" @bind-CurrentItem="_openedFolder">
            <ChildContent>
                <FormaDataTree TItem="ShowcaseEntry" SelectsCurrent="true" NodeFilter="@(entry => entry.IsFolder)" aria-label="@L["Folders"]">
                    <ThumbnailTemplate Context="entry"><FormaIcon Icon="@entry.Glyph" Size="IconSize.Small" /></ThumbnailTemplate>
                </FormaDataTree>
                <FormaDataGrid TItem="ShowcaseEntry">
                    <Columns>
                        <FormaTemplateColumn Title="@L["Name"]" Context="entry">
                            <span class="demo-entry"><FormaIcon Icon="@entry.Glyph" Size="IconSize.Small" /> @entry.Name</span>
                        </FormaTemplateColumn>
                        <FormaPropertyColumn Property="@(entry => entry.Kind)" Title="@L["Kind"]" Sortable="true" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["Showing: {Folder}", _openedFolder?.Name ?? L["the roots"].Value]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Hundred Thousand Nodes"]</h2>
    <p class="description">@L["Ten folders of ten thousand files each: open them and the tree virtualizes over the nodes it shows, drawing only the rows near the viewport, each saying its level and its place among its siblings. End and Home reach the last and the first node however far they lie."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView TItem="ShowcaseEntry" Items="DataViewShowcaseFolders.Many" EnablePagination="false" Virtualize="true" ItemHeight="32" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.Parent)" HasChildren="@(entry => entry.IsFolder)">
            <FormaDataTree TItem="ShowcaseEntry" aria-label="@L["Archives"]">
                <ThumbnailTemplate Context="entry"><FormaIcon Icon="@entry.Glyph" Size="IconSize.Small" /></ThumbnailTemplate>
            </FormaDataTree>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Boxes Over a Hundred Thousand Nodes"]</h2>
    <p class="description">@L["The same archive with a box on each node, where pressing a node or moving to it with the arrows selects it. A box keeps its node on the page while it holds the focus, so the tree can scroll it out of view and back without the focus falling to the page, and the arrows carry on from it."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView TItem="ShowcaseEntry" Items="DataViewShowcaseFolders.Many" EnablePagination="false" Virtualize="true" ItemHeight="32" EnableCheckedSelection="true" EnableItemSelection="true" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.Parent)" HasChildren="@(entry => entry.IsFolder)">
            <FormaDataTree TItem="ShowcaseEntry" aria-label="@L["Archives"]">
                <ThumbnailTemplate Context="entry"><FormaIcon Icon="@entry.Glyph" Size="IconSize.Small" /></ThumbnailTemplate>
            </FormaDataTree>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["When Nodes Go Away"]</h2>
    <p class="description">@L["The source changes while the tree is in use: each button acts three seconds after it is pressed, which leaves time to put the focus back on a node. When the node holding the focus goes away, the focus moves to the nearest node that remains, at the same level where it can, and the selection stays as it was."]</p>
    <div class="demo-box demo-row demo-controls">
        <FormaToggleButton Label="@L["Select Nodes"]" ShowLabel="true" Pressed="_changingSelects" OnClick="() => _changingSelects = !_changingSelects" />
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => RemoveLaterAsync(4)">@L["Remove Reports"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => RemoveLaterAsync(6)">@L["Remove Notes.txt"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => RemoveLaterAsync(9)">@L["Remove Lease.pdf"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => CloseLaterAsync(1)">@L["Close Documents"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => RemoveLaterAsync(1, 2, 3)">@L["Remove Everything"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _changingEntries = DataViewShowcaseFolders.All">@L["Put Everything Back"]</FormaButton>
    </div>
    <div class="demo-box demo-box-bounded">
        <FormaDataView @key="_changingSelects" @ref="_changingView" TItem="ShowcaseEntry" Items="_changingEntries" EnablePagination="false" Virtualize="true" ItemHeight="32" EnableItemSelection="_changingSelects" ItemName="@(entry => entry.Name)" ItemKey="@(entry => entry.Id)" ParentKey="@(entry => entry.Parent)" HasChildren="@(entry => entry.IsFolder)">
            <FormaDataTree TItem="ShowcaseEntry" aria-label="@L["Folders"]">
                <ThumbnailTemplate Context="entry"><FormaIcon Icon="@entry.Glyph" Size="IconSize.Small" /></ThumbnailTemplate>
            </FormaDataTree>
        </FormaDataView>
    </div>
</div>

@code {
    // How long a change to the source waits after its button is pressed, time enough to put the focus back on a node.
    private static readonly TimeSpan ChangeDelay = TimeSpan.FromSeconds(3);

    // Documents and Pictures, the folders that start open.
    private static readonly object[] OpenOnLoadKeys = [1, 2];

    private ShowcaseEntry? _currentFolder;
    private ShowcaseEntry? _openedFolder = DataViewShowcaseFolders.All.Single(entry => entry.Id == 10);
    private IQueryable<ShowcaseEntry> _changingEntries = DataViewShowcaseFolders.All;
    private FormaDataView<ShowcaseEntry> _changingView = default!;
    private bool _changingSelects;

    /// <inheritdoc />
    protected override Type LocalizationSourceType
        => typeof(FormaDataViewPage);

    // Takes the entries away from the source, with everything under them.
    private async Task RemoveLaterAsync(params int[] ids)
    {
        await Task.Delay(ChangeDelay);

        var entries = _changingEntries.ToList();
        HashSet<int> removed = [.. ids];
        var reached = 0;

        // Each pass takes the children of what is taken, until a pass takes nothing new.
        while (removed.Count != reached)
        {
            reached = removed.Count;
            removed.UnionWith(entries.Where(entry => entry.ParentId is { } parent && removed.Contains(parent)).Select(entry => entry.Id));
        }

        _changingEntries = entries.Where(entry => !removed.Contains(entry.Id)).ToArray().AsQueryable();
    }

    private async Task CloseLaterAsync(int id)
    {
        await Task.Delay(ChangeDelay);

        if (_changingEntries.FirstOrDefault(entry => entry.Id == id) is { } entry)
        {
            await _changingView.CloseNodeAsync(entry);
        }
    }
}
