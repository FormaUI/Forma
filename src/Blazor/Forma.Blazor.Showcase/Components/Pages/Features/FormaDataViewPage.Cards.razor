@page "/data-view/cards"
@rendermode InteractiveServer
@using Forma.Framework.Css

<h1>FormaDataView</h1>
<p class="description">@L["This tab shows the cards as a view of the data view: each product a card with its thumbnail, its name, its price and an action bar the page templates, packed across the width and grouped by category, and the action bars behind the cards' one Tab stop."]</p>

<div class="demo-section">
    <h2>@L["The Cards View"]</h2>
    <p class="description">@L["Cards grouped by category under headings that fold, each with a box to check and an action bar the page templates; the master control lives with the data view, so the selection methods a page calls reach these cards as they reach the grid's rows."]</p>
    <div class="demo-box demo-row demo-controls">
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _dataView!.SelectAllAsync()">@L["Select All"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="() => _dataView!.ClearSelectionAsync()">@L["Clear"]</FormaButton>
    </div>
    <div class="demo-box">
        <FormaDataView @ref="_dataView" TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.All" EnablePagination="false" ItemName="@(product => product.Name)" EnableCheckedSelection="true" GroupBy="DataViewShowcaseProducts.ByCategory" AddressOptions='@(new DataViewAddressOptions("checked"))' SelectedItems="_checkedProducts" SelectedItemsChanged="HandleCheckedChanged">
            <ChildContent>
                <FormaDataCards TItem="ShowcaseProduct" CardSize="@CssLength.FromRem(11)">
                    <ThumbnailTemplate Context="product"><span class="demo-thumbnail"><FormaIcon Icon="@product.Glyph" Size="IconSize.Large" /></span></ThumbnailTemplate>
                    <ItemTemplate Context="product">@product.Price.ToString("C0", CultureState.Culture)</ItemTemplate>
                    <ActionsTemplate Context="product">
                        <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" OnClick="() => _lastAction = product.Name">@L["Open"]</FormaButton>
                    </ActionsTemplate>
                </FormaDataCards>
            </ChildContent>
            <Status>@L["{Selected} checked; last opened: {Name}", _checkedProducts.Count, _lastAction ?? L["nothing yet"].Value]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Commands Behind One Tab Stop"]</h2>
    <p class="description">@L["Each card's Open button and its menu of actions stand behind the cards' one Tab stop: Tab enters at a card, reaches that card's commands alone and leaves after them, however many cards there are. Shift+F10 or the Menu key on a card opens its actions, and the focus comes back to the card as they close."]</p>
    <div class="demo-box">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.All" EnablePagination="false" ItemName="@(product => product.Name)" EnableItemSelection="true" TabOrder="DataViewTabOrder.ActiveItem">
            <ChildContent>
                <FormaDataCards TItem="ShowcaseProduct" CardSize="@CssLength.FromRem(11)">
                    <ThumbnailTemplate Context="product"><span class="demo-thumbnail"><FormaIcon Icon="@product.Glyph" Size="IconSize.Large" /></span></ThumbnailTemplate>
                    <ItemTemplate Context="product">@product.Price.ToString("C0", CultureState.Culture)</ItemTemplate>
                    <ActionsTemplate Context="product">
                        <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" OnClick="@(() => _lastCommand = L["Opened {Name}", product.Name].Value)">@L["Open"]</FormaButton>
                        <FormaOverflowMenu Label="@L["Actions for {Name}", product.Name]" data-item-actions>
                            <FormaDropDownMenuItem OnClick="@(() => _lastCommand = L["Renamed {Name}", product.Name].Value)">@L["Rename"]</FormaDropDownMenuItem>
                        </FormaOverflowMenu>
                    </ActionsTemplate>
                </FormaDataCards>
            </ChildContent>
            <Status>@L["Last command: {Command}", _lastCommand ?? L["nothing yet"].Value]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Thumbnails"]</h2>
    <p class="description">@L["The cards at their compact density, the thumbnail and the name alone, which is what a consumer shows as thumbnails."]</p>
    <div class="demo-box">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.All" EnablePagination="false" ItemName="@(product => product.Name)" EnableItemSelection="true" AddressOptions='@(new DataViewAddressOptions("thumbnails"))'>
            <FormaDataCards TItem="ShowcaseProduct" Dense="true" CardSize="@CssLength.FromRem(7)">
                <ThumbnailTemplate Context="product"><span class="demo-thumbnail"><FormaIcon Icon="@product.Glyph" Size="IconSize.Large" /></span></ThumbnailTemplate>
            </FormaDataCards>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Thumbnails a Press Opens"]</h2>
    <p class="description">@L["The thumbnails take the focus with no selection on: Tab enters them once, the arrows move the focus alone, and Enter or a press opens a thumbnail. Select draws a box on each, a press or Space checks it, Enter still opens, and the focus stays on its thumbnail as the mode changes."]</p>
    <div class="demo-box demo-row demo-controls">
        <FormaButton Variant="ButtonVariant.Secondary" @onmousedown:preventDefault="true" OnClick="() => _isChoosing = !_isChoosing">@(_isChoosing ? L["Done"] : L["Select"])</FormaButton>
        <span class="demo-status">@(_openedProduct is { } opened ? L["Opened: {Name}", opened.Name] : null)</span>
    </div>
    <div class="demo-box">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.All" EnablePagination="false" ItemName="@(product => product.Name)" EnableItemFocus="true" EnableCheckedSelection="_isChoosing" CheckedSelectionOptions="ChecksOnPress" @bind-SelectedItems="_chosenProducts" OnItemClick="@((ShowcaseProduct product) => _openedProduct = product)">
            <FormaDataCards TItem="ShowcaseProduct" Dense="true" CardSize="@CssLength.FromRem(7)">
                <ThumbnailTemplate Context="product"><span class="demo-thumbnail"><FormaIcon Icon="@product.Glyph" Size="IconSize.Large" /></span></ThumbnailTemplate>
            </FormaDataCards>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Hundred Thousand Thumbnails"]</h2>
    <p class="description">@L["The cards virtualizing over a hundred thousand products grouped by category, as a gallery browses its media: the rows hold as many thumbnails as the width packs, each heading counts its whole group and folds it, and only the rows near the viewport are drawn."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.Many" EnablePagination="false" Virtualize="true" ItemHeight="160" ItemName="@(product => product.Name)" EnableCheckedSelection="true" GroupBy="DataViewShowcaseProducts.ByCategory" AddressOptions='@(new DataViewAddressOptions("many"))'>
            <FormaDataCards TItem="ShowcaseProduct" Dense="true" CardSize="@CssLength.FromRem(7)">
                <ThumbnailTemplate Context="product"><span class="demo-thumbnail"><FormaIcon Icon="@product.Glyph" Size="IconSize.Large" /></span></ThumbnailTemplate>
            </FormaDataCards>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Hundred Thousand Thumbnails, Selected by Card"]</h2>
    <p class="description">@L["The same cards with the cards themselves selecting: a press selects, Ctrl or Cmd toggles and Shift extends a range, and the arrows walk the cards across a row and down the rows. Narrowing the box packs fewer cards to a row while the selection stays."]</p>
    <div class="demo-box demo-row demo-controls">
        <FormaToggleButton Label="@L["Narrow"]" ShowLabel="true" Pressed="_isNarrow" OnClick="ToggleNarrow" />
    </div>
    <div class="@(_isNarrow ? "demo-box demo-box-bounded demo-box-narrow" : "demo-box demo-box-bounded")">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.Many" ItemKey="@(product => product.Id)" EnablePagination="false" Virtualize="true" ItemHeight="160" ItemName="@(product => product.Name)" EnableItemSelection="true" GroupBy="DataViewShowcaseProducts.ByCategory" AddressOptions='@(new DataViewAddressOptions("many-selected"))' SelectedItems="_selectedProducts" SelectedItemsChanged="HandleSelectedChanged">
            <ChildContent>
                <FormaDataCards TItem="ShowcaseProduct" Dense="true" CardSize="@CssLength.FromRem(7)">
                    <ThumbnailTemplate Context="product"><span class="demo-thumbnail"><FormaIcon Icon="@product.Glyph" Size="IconSize.Large" /></span></ThumbnailTemplate>
                </FormaDataCards>
            </ChildContent>
            <Status>@L["{Selected} selected.", _selectedProducts.Count]</Status>
        </FormaDataView>
    </div>
</div>

@code {
    private FormaDataView<ShowcaseProduct>? _dataView;

    private IReadOnlyList<ShowcaseProduct> _checkedProducts = [];

    private IReadOnlyList<ShowcaseProduct> _selectedProducts = [];

    private string? _lastAction;

    private string? _lastCommand;

    private bool _isNarrow;

    private static readonly CheckedSelectionOptions ChecksOnPress = new() { ChecksOnPress = true };

    private bool _isChoosing;

    private IReadOnlyList<ShowcaseProduct> _chosenProducts = [];

    private ShowcaseProduct? _openedProduct;

    /// <inheritdoc />
    protected override Type LocalizationSourceType
        => typeof(FormaDataViewPage);

    private void HandleCheckedChanged(IReadOnlyList<ShowcaseProduct> selectedProducts)
        => _checkedProducts = selectedProducts;

    private void HandleSelectedChanged(IReadOnlyList<ShowcaseProduct> selectedProducts)
        => _selectedProducts = selectedProducts;

    private void ToggleNarrow()
        => _isNarrow = !_isNarrow;
}
