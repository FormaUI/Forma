@page "/explorer"
@attribute [ShowcasePage("FormaExplorer")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Explorer
@using Forma.Framework.Explorer
@using Forma.Framework.Explorer.Content
@using Forma.Framework.Catalog.Queries
@using Forma.Framework.Explorer.Content.Queries
@using Forma.Framework.Explorer.Items
@using Forma.Framework.Catalog

<h1>FormaExplorer</h1>
<p class="description">@L["A browser for the media a site already holds: a thumbnail grid or a details table over folders, with selection, upload, paging and a preview of any item. It handles files the way a desktop does, so an editor already knows how to use it."]</p>

<div class="demo-section">
    <h2>@L["Full Media Explorer"]</h2>
    <p class="description">@L["Browse folders, preview media, select items, rename, delete, and upload."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("full"))"
                      Folders="_sampleFolderItems"
                      CurrentFolder="@(GetCurrentFolder("full"))"
                      TotalCount="_allMedia.Count"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("full", folder))"
                      SelectedChanged="@(items => HandleSelectedAsync("full", items))"
                      OnRename="@(req => HandleRenameAsync("full", req))"
                      OnDelete="@(req => HandleDeleteAsync("full", req))"
                      OnDrop="@(req => HandleDropAsync("full", req))"
                      OnFolderCreate="@(req => HandleFolderCreateAsync("full", req))"
                      OnUploaded="@(resources => HandleUploadedAsync("full", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("full"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Phone-Width Explorer"]</h2>
    <p class="description">@L["Held to a phone's width, the header collapses to one row: the folder path, a search glyph that opens the search across the row, and a menu holding navigation, actions, view mode and sorting."]</p>
    <div class="demo-box demo-box-phone">
        <FormaExplorer ItemsProvider="@(GetProvider("phone"))"
                      Folders="_sampleFolderItems"
                      CurrentFolder="@(GetCurrentFolder("phone"))"
                      TotalCount="_allMedia.Count"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("phone", folder))" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Single Selection for a Cover Image"]</h2>
    <p class="description">@L["With MaxSelection set to 1, picking any item immediately selects it alone. This one holds its collection through Resources, which is the simpler half of the contract and the right choice for a handful of items."]</p>
    <div class="demo-box">
        <FormaExplorer Items="_singleSelectItems"
                      Options="@(new ExplorerOptions { MaxSelection = 1 })"
                      SelectedChanged="@(items => HandleSelectedAsync("single", items))" />
        <ul class="demo-log">
            @foreach (var resource in Log("single"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Picker That Keeps Its Choices"]</h2>
    <p class="description">@L["With SelectOnOpen, the explorer is a picker: it keeps its choices as the reader moves between folders, and its count opens them for review, each with the folder it stands in and a way to remove it. Its accepted kinds name folders as well as images, so it offers Choose This Folder inside a folder, where a press on a folder still chooses it and Enter enters it."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("picker"))"
                      Folders="_sampleFolderItems"
                      TotalCount="_allMedia.Count"
                      Options="@(new ExplorerOptions { SelectOnOpen = true })"
                      Constraints="@(new CatalogConstraints { AcceptedResourceKinds = "contentType:image;folder" })"
                      ItemOptions="ExplorerItemOptions.ReadOnly"
                      SelectedChanged="@(items => HandleSelectedAsync("picker", items))" />
        <ul class="demo-log">
            @foreach (var resource in Log("picker"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Details Columns"]</h2>
    <p class="description">@L["DetailsColumns picks which optional columns the details view opens with beside the name; the columns menu in the toolbar lets the reader add or remove them and hide the header afterwards. Nothing wraps, so a narrow explorer scrolls sideways rather than squeezing a column out."]</p>
    <div class="demo-box">
        <fieldset class="demo-row">
            <legend>@L["Columns"]</legend>
            @foreach (var column in ColumnChoices)
            {
                <label>
                    <input type="checkbox"
                           checked="@_detailsColumns.HasFlag(column)"
                           @onchange="@(e => ToggleColumn(column, (bool)e.Value!))" />
                    @GetColumnLabel(column)
                </label>
            }
        </fieldset>
        <FormaExplorer Items="_allMediaItems"
                      ViewMode="ExplorerViewMode.Details"
                      Options="@(new ExplorerOptions { DetailsColumns = _detailsColumns, ShowSidebar = false })" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Read-Only Explorer"]</h2>
    <p class="description">@L["With ExplorerItemOptions.ReadOnly, browsing and selection remain while upload, rename, delete, and every folder action disappear."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("readonly"))"
                      Folders="_sampleFolderItems"
                      CurrentFolder="@(GetCurrentFolder("readonly"))"
                      TotalCount="_allMedia.Count"
                      ItemOptions="ExplorerItemOptions.ReadOnly"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("readonly", folder))"
                      SelectedChanged="@(items => HandleSelectedAsync("readonly", items))" />
        <ul class="demo-log">
            @foreach (var resource in Log("readonly"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Item States"]</h2>
    <p class="description">@L["Every item carries its own state. A disabled item is drawn but offers nothing, an invisible item keeps its place without being drawn, a hidden item leaves the listing, and an item's own capabilities decide which operations the explorer offers on it: here one file cannot be renamed, deleted or moved, one folder cannot be entered or receive a drop, and one folder is disabled."]</p>
    <div class="demo-box">
        <FormaExplorer Items="_stateItems"
                      Folders="_stateFolderItems"
                      CurrentFolder="@(GetCurrentFolder("states"))"
                      ItemOptions="_stateOptions"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("states", folder))"
                      SelectedChanged="@(items => HandleSelectedAsync("states", items))"
                      OnRename="@(req => HandleRenameAsync("states", req))"
                      OnDelete="@(req => HandleDeleteAsync("states", req))"
                      OnDrop="@(req => HandleDropAsync("states", req))" />
        <ul class="demo-log">
            @foreach (var entry in Log("states"))
            {
                <li>@entry</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Constraints"]</h2>
    <p class="description">@L["This explorer accepts only images, holds two root folders, one subfolder each, nests two deep, and stops at four items or 1 MB. Trip any of them and the refusal is announced above the toolbar and reported to the host."]</p>
    <div class="demo-box">
        <FormaExplorer Items="_constrainedItems"
                      Folders="_constrainedFolderItems"
                      CurrentFolder="@(GetCurrentFolder("constrained"))"
                      Constraints="_demoConstraints"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("constrained", folder))"
                      OnFolderCreate="@(req => HandleFolderCreateAsync("constrained", req))"
                      OnRejected="@(rejection => HandleRejectedAsync("constrained", rejection))" />
        <ul class="demo-log">
            @foreach (var resource in Log("constrained"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Media without Folder Management"]</h2>
    <p class="description">@L["Media stays fully editable while the folder tree is fixed, so items can be renamed and deleted but folders cannot."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("fixedfolders"))"
                      Folders="_sampleFolderItems"
                      CurrentFolder="@(GetCurrentFolder("fixedfolders"))"
                      TotalCount="_allMedia.Count"
                      ItemOptions="_fixedFolderOptions"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("fixedfolders", folder))"
                      OnRename="@(req => HandleRenameAsync("fixedfolders", req))"
                      OnDelete="@(req => HandleDeleteAsync("fixedfolders", req))"
                      OnUploaded="@(resources => HandleUploadedAsync("fixedfolders", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("fixedfolders"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Breadcrumb-Only Navigation"]</h2>
    <p class="description">@L["With ShowSidebar off, the folder tree is hidden and folders are reached through the breadcrumb menus instead."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("nosidebar"))"
                      Folders="_sampleFolderItems"
                      CurrentFolder="@(GetCurrentFolder("nosidebar"))"
                      TotalCount="_allMedia.Count"
                      Options="@(new ExplorerOptions { ShowSidebar = false })"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("nosidebar", folder))" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Sidebar without Breadcrumb Menus"]</h2>
    <p class="description">@L["With ShowFolderMenu off, the breadcrumbs become plain separators and the tree is the only way to change folder."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("nomenu"))"
                      Folders="_sampleFolderItems"
                      CurrentFolder="@(GetCurrentFolder("nomenu"))"
                      TotalCount="_allMedia.Count"
                      Options="@(new ExplorerOptions { ShowFolderMenu = false })"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("nomenu", folder))" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Library Too Large to Hold"]</h2>
    <p class="description">@L["Twenty thousand items behind a provider. The explorer keeps only the items it is showing, and the folder never appears in the query because the page already knows it."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("library"))"
                      Folders="_sampleFolderItems"
                      CurrentFolder="@(GetCurrentFolder("library"))"
                      PageSize="12"
                      TotalCount="_libraryCount"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("library", folder))" />
        <p class="demo-note">@L["Slices fetched: {Count}", _libraryStore.QueryCount] — @LibraryQueryDescription</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Empty Explorer"]</h2>
    <p class="description">@L["When a folder has no media, the explorer displays an empty state."]</p>
    <div class="demo-box">
        <FormaExplorer Items="[]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Paginated Explorer"]</h2>
    <p class="description">@L["A large collection splits across pages using FormaPagination."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("paged"))" PageSize="4" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Infinite Scrolling Explorer"]</h2>
    <p class="description">@L["ExplorerInfiniteScrollMode.Manual appends the next page as the reader nears the end, and offers a button for anyone not using a pointer. The media scrolls inside the panel, so the toolbar and folder tree stay put."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("infinite"))" PageSize="24" Options="@(new ExplorerOptions { InfiniteScroll = ExplorerInfiniteScrollMode.Manual })" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Automatic Infinite Scrolling"]</h2>
    <p class="description">@L["ExplorerInfiniteScrollMode.Automatic drops the button entirely: pages arrive as the reader scrolls, marked by a spinner while each one loads, with the running count left as the reader's sense of position."]</p>
    <div class="demo-box">
        <FormaExplorer ItemsProvider="@(GetProvider("infinite"))"
                      PageSize="24"
                      Options="@(new ExplorerOptions { InfiniteScroll = ExplorerInfiniteScrollMode.Automatic })" />
    </div>
</div>
