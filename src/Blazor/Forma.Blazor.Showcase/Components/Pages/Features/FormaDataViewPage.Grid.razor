    protected override void OnInitialized()
    {
        _feedItems = _feedList.AsQueryable();
        _editableEmployeeItems = _editableEmployees.AsQueryable();
        _assignmentItems = _assignments.AsQueryable();
        _blockGrouping = DataViewGrouping<GridItem>.By(item => (item.Id - 1) / BlockRowCount, block => L["Rows {First:N0} to {Last:N0}", (block * BlockRowCount) + 1, (block + 1) * BlockRowCount].Value);

        _limitsOptions = CreateLimitsOptions();
        _priorityOptions = CreatePriorityOptions();
    }

    /// <inheritdoc />
    protected override Task OnCultureChangedAsync()
    {
        _limitsOptions = CreateLimitsOptions();
        _priorityOptions = CreatePriorityOptions();

        return Task.CompletedTask;
