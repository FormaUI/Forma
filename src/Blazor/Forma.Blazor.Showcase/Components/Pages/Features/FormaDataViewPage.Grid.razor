@page "/data-view/grid"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Forma.Blazor.Components.Inputs
@using Microsoft.AspNetCore.Components.Web.Virtualization

<h1>FormaDataView</h1>
<p class="description">@L["This tab shows the grid as a view of the data view: the products as rows with sortable headers and a box per row, the master control and the selection the engine's, as they are in every other view."]</p>
<p class="description">@L["A table that pages, sorts and selects over any queryable set of items. The grid keeps its state in the address, so a page number or a sort order survives a refresh and can be shared as a link."]</p>

<div class="demo-section">
    <h2>@L["The Grid View"]</h2>
    <div class="demo-box">
        <FormaDataView TItem="ShowcaseProduct" Items="DataViewShowcaseProducts.All" EnablePagination="false" EnableCheckedSelection="true" AddressOptions='@(new DataViewAddressOptions("grid"))' SelectedItems="_checkedProducts" SelectedItemsChanged="HandleCheckedChanged">
            <ChildContent>
                <FormaDataGrid TItem="ShowcaseProduct">
                    <Columns>
                        <FormaPropertyColumn Property="@(product => product.Name)" Title="@L["Name"]" Sortable="true" />
                        <FormaPropertyColumn Property="@(product => product.Category)" Title="@L["Category"]" Sortable="true" />
                        <FormaPropertyColumn Property="@(product => product.Price)" Title="@L["Price"]" Format="C0" Sortable="true" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{Selected} checked.", _checkedProducts.Count]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Basic Grid"]</h2>
    <div class="demo-box">
        <FormaDataView Items="_employees" PageSize="5" AddressOptions='@(new DataViewAddressOptions("basic"))'>
            <FormaDataGrid>
                <Columns>
                    <FormaPropertyColumn Property="@(e => e.Id)" Sortable="true" />
                    <FormaPropertyColumn Property="@(e => e.Name)" Sortable="true" />
                    <FormaPropertyColumn Property="@(e => e.Department)" Sortable="true" />
                </Columns>
            </FormaDataGrid>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Mass-Select Checkboxes"]</h2>
    <div class="demo-box">
        <FormaDataView TItem="Employee" Items="_employees" PageSize="5" EnableCheckedSelection="true" AddressOptions='@(new DataViewAddressOptions("selectable"))' SelectedItems="_selectedEmployees" SelectedItemsChanged="HandleSelectionChanged">
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(e => e.Id)" />
                        <FormaPropertyColumn Property="@(e => e.Name)" />
                        <FormaPropertyColumn Property="@(e => e.Department)" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{Selected} row(s) selected.", _selectedEmployees.Count]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Select-All Modes"]</h2>
    <p class="description">@L["What the master checkbox reaches. From a menu, it selects the page and a menu beside it offers the page, the whole set or clearing; from the pager, the footer offers the whole set once the page is selected; direct selects the whole set at one press; none draws no master checkbox at all. The selection is kept across pages either way."]</p>
    <div class="demo-box demo-row">
        @foreach (var mode in Enum.GetValues<SelectAllMode>())
        {
            <FormaToggleButton Label="@GetModeLabel(mode)" ShowLabel="true" Pressed="@(_selectAllMode == mode)" OnClick="() => SetSelectAllMode(mode)" />
        }
    </div>
    <div class="demo-box">
        <FormaDataView TItem="GridItem" Items="_manyItems" PageSize="ManyPageSize" EnableCheckedSelection="true" CheckedSelectionOptions="_selectAllModeOptions" AddressOptions='@(new DataViewAddressOptions("modes"))' SelectedItems="_modeSelectedItems" SelectedItemsChanged="HandleModeSelectionChanged">
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(item => item.Id)" Sortable="true" />
                        <FormaPropertyColumn Property="@(item => item.Title)" Sortable="true" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{Selected} of {Total} selected.", _modeSelectedItems.Count, ManyRowCount]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Row Selection"]</h2>
    <p class="description">@L["Click a row to select only it; Ctrl/Cmd-click to toggle one row; Shift-click or Shift with arrow keys to select a range."]</p>
    <div class="demo-box">
        <FormaDataView TItem="Employee" Items="_employees" PageSize="5" EnableItemSelection="true" AddressOptions='@(new DataViewAddressOptions("row-selectable"))' SelectedItems="_rowSelectedEmployees" SelectedItemsChanged="HandleRowSelectionChanged">
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(e => e.Id)" />
                        <FormaPropertyColumn Property="@(e => e.Name)" />
                        <FormaPropertyColumn Property="@(e => e.Department)" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{Selected} row(s) selected.", _rowSelectedEmployees.Count]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Select in a Cell"]</h2>
    <p class="description">@L["A select inside a cell of a row-selection grid. While it is open its arrows walk its own options; otherwise the grid's arrows move the selection."]</p>
    <div class="demo-box">
        <EditForm Model="_assignments" FormName="cell-select-demo">
            <FormaDataView TItem="Assignment" Items="_assignmentItems" PageSize="5" EnableItemSelection="true" AddressOptions='@(new DataViewAddressOptions("cell-select"))' SelectedItems="_assignmentSelection" SelectedItemsChanged="HandleAssignmentSelectionChanged">
                <ChildContent>
                    <FormaDataGrid>
                        <Columns>
                            <FormaPropertyColumn Property="@(a => a.Id)" />
                            <FormaPropertyColumn Property="@(a => a.Name)" />
                            <FormaTemplateColumn Title="@L["Priority"]" Context="assignment">
                                <FormaSelect TValue="int?" @bind-Value="assignment.Priority" Options="_priorityOptions" Label="@L["Priority"]" />
                            </FormaTemplateColumn>
                        </Columns>
                    </FormaDataGrid>
                </ChildContent>
                <Status>@L["{Selected} row(s) selected.", _assignmentSelection.Count]</Status>
            </FormaDataView>
        </EditForm>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Selection Limits and Captions"]</h2>
    <p class="description">@L["At most {SelectionLimit} rows; the master toggle is a text caption instead of a checkbox.", SelectionLimit]</p>
    <div class="demo-box">
        <FormaDataView TItem="Employee" Items="_employees" PageSize="5" EnableCheckedSelection="true" AddressOptions='@(new DataViewAddressOptions("limited"))' CheckedSelectionOptions="_limitsOptions" SelectedItems="_limitsSelectedEmployees" SelectedItemsChanged="HandleLimitsSelectionChanged">
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(e => e.Id)" />
                        <FormaPropertyColumn Property="@(e => e.Name)" />
                        <FormaPropertyColumn Property="@(e => e.Department)" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{Selected} row(s) selected.", _limitsSelectedEmployees.Count]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Row Click-Through"]</h2>
    <div class="demo-box">
        <FormaDataView TItem="Employee" Items="_employees" PageSize="5" OnItemClick="HandleRowClick" AddressOptions='@(new DataViewAddressOptions("clickable"))'>
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(e => e.Id)" />
                        <FormaPropertyColumn Property="@(e => e.Name)" />
                        <FormaPropertyColumn Property="@(e => e.Department)" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["Last clicked: {Name}", _lastClickedEmployee?.Name ?? L["none"].Value]</Status>
        </FormaDataView>
    </div>
</div>


<div class="demo-section">
    <h2>@L["Custom Cell Rendering and Row Styling"]</h2>
    <p class="description">@L["A TemplateColumn renders a FormaStatusBadge per row; RowClass dims inactive rows."]</p>
    <div class="demo-box">
        <FormaDataView TItem="Employee" Items="_employees" PageSize="5" ItemClass="GetRowClass" AddressOptions='@(new DataViewAddressOptions("styled"))'>
            <FormaDataGrid>
                <Columns>
                    <FormaPropertyColumn Property="@(e => e.Id)" />
                    <FormaPropertyColumn Property="@(e => e.Name)" />
                    <FormaTemplateColumn Title="@L["Status"]">
                        <FormaStatusBadge Text="@(context.IsActive ? L["Active"] : L["Inactive"])"
                                          Status="@(context.IsActive ? "active" : "inactive")" />
                    </FormaTemplateColumn>
                </Columns>
            </FormaDataGrid>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Fitting a Width"]</h2>
    <p class="description">@L["The grid is given a narrow box. Columns leave by priority, the lowest first, until the rest fit; the columns menu at the header's end lists the ones that can leave, marks the ones shown, and brings a dropped column back until the width changes."]</p>
    <div class="demo-box demo-box-narrow">
        <FormaDataView Items="_shipments" PageSize="5" AddressOptions='@(new DataViewAddressOptions("fit"))'>
            <FormaDataGrid>
                <Columns>
                    <FormaPropertyColumn Property="@(s => s.Id)" Priority="4" />
                    <FormaPropertyColumn Property="@(s => s.Customer)" Priority="4" />
                    <FormaPropertyColumn Property="@(s => s.Product)" Priority="3" />
                    <FormaPropertyColumn Property="@(s => s.City)" Priority="1" />
                    <FormaPropertyColumn Property="@(s => s.Country)" Priority="0" />
                    <FormaPropertyColumn Property="@(s => s.Amount)" Format="C0" Priority="2" />
                </Columns>
            </FormaDataGrid>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Frozen Columns"]</h2>
    <p class="description">@L["Every column shares the highest priority, so none leaves and the table scrolls sideways instead; the id and the customer are frozen and stay put while the rest slide beneath them, moved by the pane's arrows, and the edge of the frozen region can be dragged."]</p>
    <div class="demo-box demo-box-narrow">
        <FormaDataView Items="_shipments" PageSize="5" EnableCheckedSelection="true" AddressOptions='@(new DataViewAddressOptions("frozen"))'>
            <FormaDataGrid>
                <Columns>
                    <FormaPropertyColumn Property="@(s => s.Id)" Frozen="true" />
                    <FormaPropertyColumn Property="@(s => s.Customer)" Frozen="true" />
                    <FormaPropertyColumn Property="@(s => s.Product)" />
                    <FormaPropertyColumn Property="@(s => s.City)" />
                    <FormaPropertyColumn Property="@(s => s.Country)" />
                    <FormaPropertyColumn Property="@(s => s.Amount)" Format="C0" />
                    <FormaPropertyColumn Property="@(s => s.Shipped)" Format="d" />
                </Columns>
            </FormaDataGrid>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Picker"]</h2>
    <p class="description">@L["The grid as a picker: its header off, its rows dense, and a row chosen by pointer or keyboard, the way a modal lists what a reader picks from."]</p>
    <div class="demo-box demo-box-narrow demo-box-bounded">
        <FormaDataView TItem="Employee" Items="_employees" EnablePagination="false" EnableItemSelection="true" AddressOptions='@(new DataViewAddressOptions("picker"))' SelectedItems="_pickedEmployees" SelectedItemsChanged="HandlePickedChanged">
            <ChildContent>
                <FormaDataGrid TItem="Employee" ShowHeader="false" Dense="true">
                    <Columns>
                        <FormaPropertyColumn Property="@(e => e.Name)" />
                        <FormaPropertyColumn Property="@(e => e.Department)" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["Picked: {Name}", _pickedEmployees.FirstOrDefault()?.Name ?? L["none"].Value]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Row Actions"]</h2>
    <p class="description">@L["An action column is an ordinary TemplateColumn — the grid adds no button components of its own. In a real app these navigate to an editor page or raise a confirm dialog."]</p>
    <div class="demo-box">
        <FormaDataView TItem="Employee" Items="_employees" PageSize="5" AddressOptions='@(new DataViewAddressOptions("actions"))'>
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(e => e.Id)" />
                        <FormaPropertyColumn Property="@(e => e.Name)" />
                        <FormaTemplateColumn Title="@L["Actions"]">
                            <div class="demo-row-actions">
                                <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                             OnClick="() => RecordAction(RowAction.View, context)">@L["View"]</FormaButton>
                                <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                             OnClick="() => RecordAction(RowAction.Edit, context)">@L["Edit"]</FormaButton>
                                <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                             OnClick="() => RecordAction(RowAction.Delete, context)">@L["Delete"]</FormaButton>
                            </div>
                        </FormaTemplateColumn>
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["Last action: {action}", _lastAction ?? L["none yet"].Value]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">    <h2>@L["Dialog Details"]</h2>
    <p class="description">@L["A single FormaDialog instance is shared by every row; the action column tells it which row to show."]</p>
    <div class="demo-box">
        <FormaDataView TItem="Employee" Items="_employees" PageSize="5" AddressOptions='@(new DataViewAddressOptions("dialog"))'>
            <FormaDataGrid>
                <Columns>
                    <FormaPropertyColumn Property="@(e => e.Id)" />
                    <FormaPropertyColumn Property="@(e => e.Name)" />
                    <FormaPropertyColumn Property="@(e => e.Department)" />
                    <FormaTemplateColumn Title="@L["Actions"]">
                        <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                     OnClick="() => OpenDetails(context)">@L["View"]</FormaButton>
                    </FormaTemplateColumn>
                </Columns>
            </FormaDataGrid>
        </FormaDataView>

        <FormaDialog Opened="_isDetailsOpen" OnClose="CloseDetails" Title="@_detailsEmployee?.Name">
            <Body>
                @if (_detailsEmployee is { } employee)
                {
                    <dl class="detail-list">
                        <dt>@L["ID"]</dt>
                        <dd>@employee.Id</dd>
                        <dt>@L["Name"]</dt>
                        <dd>@employee.Name</dd>
                        <dt>@L["Department"]</dt>
                        <dd>@employee.Department</dd>
                    </dl>
                }
            </Body>
        </FormaDialog>
    </div>
</div>

<div class="demo-section">    <h2>@L["Inline Editing Inside a Form"]</h2>
    <p class="description">@L["FormaPropertyColumn shows its property, then swaps to an editor chosen from the property's type while its row is edited — text, number, date and a checkbox here. The grid owns the edit: it copies the row, validates the copy against its data annotations, and reports it only once valid, so Cancel discards and Save commits. The edited row drops out of selection while it is open."]</p>
    <div class="demo-box">
        <FormaDataView TItem="EditableEmployee" @ref="_editDataView" Items="_editableEmployeeItems" EnablePagination="false" AddressOptions='@(new DataViewAddressOptions("editing"))'>
            <FormaDataGrid TItem="EditableEmployee" @ref="_editGrid" EnableInlineEditing="true" CloneForEdit="CloneEmployee" OnRowSave="SaveEmployeeAsync">
                <Columns>
                    <FormaPropertyColumn Property="@(e => e.Id)" Editable="false" />
                    <FormaPropertyColumn Property="@(e => e.Name)" Title="@L["Name"]" />
                    <FormaPropertyColumn Property="@(e => e.Department)" Title="@L["Department"]" />
                    <FormaPropertyColumn Property="@(e => e.StartDate)" Title="@L["Start date"]" Format="d" />
                    <FormaPropertyColumn Property="@(e => e.ShiftStart)" Title="@L["Shift start"]" Format="t" />
                    <FormaPropertyColumn Property="@(e => e.NextReview)" Title="@L["Next review"]" Format="g" />
                    <FormaPropertyColumn Property="@(e => e.Salary)" Title="@L["Salary"]" Format="N0" />
                    <FormaPropertyColumn Property="@(e => e.Remote)" Title="@L["Remote"]" />
                    <FormaTemplateColumn Title="@L["Actions"]">
                        <div class="demo-row-actions">
                            @if (_editGrid?.IsEditing(context) == true)
                            {
                                <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                             OnClick="() => _editGrid!.SaveEditAsync()">@L["Save"]</FormaButton>
                                <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                             OnClick="() => _editGrid!.CancelEditAsync()">@L["Cancel"]</FormaButton>
                            }
                            else
                            {
                                <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini" Disabled="@(_editGrid?.EditingItem is not null)"
                                             OnClick="() => _editGrid!.BeginEdit(context)">@L["Edit"]</FormaButton>
                            }
                        </div>
                    </FormaTemplateColumn>
                </Columns>
            </FormaDataGrid>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Grouped Rows"]</h2>
    <p class="description">@L["The rows fold under a heading per department, each a button that folds its group away and opens it again; a sort orders the rows inside their groups."]</p>
    <div class="demo-box">
        <FormaDataView TItem="Employee" Items="_employees" EnablePagination="false" GroupBy="_departmentGrouping" AddressOptions='@(new DataViewAddressOptions("grouped"))'>
            <FormaDataGrid>
                <Columns>
                    <FormaPropertyColumn Property="@(e => e.Id)" Sortable="true" />
                    <FormaPropertyColumn Property="@(e => e.Name)" Sortable="true" />
                    <FormaTemplateColumn Title="@L["Status"]">
                        <FormaStatusBadge Text="@(context.IsActive ? L["Active"] : L["Inactive"])"
                                          Status="@(context.IsActive ? "active" : "inactive")" />
                    </FormaTemplateColumn>
                </Columns>
            </FormaDataGrid>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Many Rows"]</h2>
    <div class="demo-box">
        <FormaDataView Items="_manyItems" PageSize="ManyPageSize" AddressOptions='@(new DataViewAddressOptions("many"))'>
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(item => item.Id)" Sortable="true" />
                        <FormaPropertyColumn Property="@(item => item.Title)" Sortable="true" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{ManyRowCount} rows paginated at {ManyPageSize} per page.", ManyRowCount, ManyPageSize]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Virtualized"]</h2>
    <p class="description">@L["Pagination is off and the surrounding box has a fixed height, so the rows scroll inside the grid while the header and footer stay put. Only the rows near the viewport are rendered."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView Items="_hugeItems" EnablePagination="false" Virtualize="true" AddressOptions='@(new DataViewAddressOptions("virtualized"))'>
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(item => item.Id)" />
                        <FormaPropertyColumn Property="@(item => item.Title)" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{HugeRowCount:N0} rows, scrolled rather than paged.", HugeRowCount]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Virtualized With Row Selection"]</h2>
    <p class="description">@L["A press selects a row, Ctrl or Cmd toggles it and Shift extends a range, and the arrows, Home and End walk the rows. A row scrolled out of the drawn rows keeps the focus and is drawn again beside the arrow that reaches it."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView TItem="GridItem" Items="_hugeItems" ItemKey="@(item => item.Id)" EnablePagination="false" Virtualize="true" EnableItemSelection="true" AddressOptions='@(new DataViewAddressOptions("virtualized-selection"))' SelectedItems="_virtualizedSelection" SelectedItemsChanged="HandleVirtualizedSelectionChanged">
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(item => item.Id)" />
                        <FormaPropertyColumn Property="@(item => item.Title)" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{Selected} row(s) selected.", _virtualizedSelection.Count]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Grouped and Virtualized"]</h2>
    <p class="description">@L["The same rows in blocks of ten thousand: each heading is a row the virtualization scrolls past with the rest, counts its whole block and folds it, and a folded block's rows are never fetched."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView Items="_hugeItems" EnablePagination="false" Virtualize="true" GroupBy="_blockGrouping" AddressOptions='@(new DataViewAddressOptions("blocks"))'>
            <FormaDataGrid>
                <Columns>
                    <FormaPropertyColumn Property="@(item => item.Id)" />
                    <FormaPropertyColumn Property="@(item => item.Title)" />
                </Columns>
            </FormaDataGrid>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Opening on a Row"]</h2>
    <p class="description">@L["A virtualized grid opens on the row its initial item index names, and scrolls to any row on request."]</p>
    <div class="demo-box demo-row demo-controls">
        <input type="number" min="1" max="@HugeRowCount" @bind="_scrollTargetRow" aria-label="@L["Row"]" class="forma-text-box demo-control demo-control-narrow" />
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="ScrollToRowAsync">@L["Scroll to Row"]</FormaButton>
    </div>
    <div class="demo-box demo-box-bounded">
        <FormaDataView @ref="_openingDataView" Items="_hugeItems" EnablePagination="false" Virtualize="true" InitialItemIndex="InitialRowIndex" AddressOptions='@(new DataViewAddressOptions("opening"))'>
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(item => item.Id)" />
                        <FormaPropertyColumn Property="@(item => item.Title)" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["Opened on row {Row:N0}.", InitialRowIndex + 1]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Virtualized Over a Provider"]</h2>
    <p class="description">@L["Each slice is fetched from a provider as it scrolls into view, with a delay here to show the placeholders each column draws while its slice loads."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataView TItem="GridItem" ItemsProvider="ProvideSlowItemsAsync" EnablePagination="false" Virtualize="true" EnableCheckedSelection="true" AddressOptions='@(new DataViewAddressOptions("slow"))'>
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(item => item.Id)">
                            <PlaceholderTemplate><span class="demo-skeleton demo-skeleton-narrow" aria-hidden="true"></span></PlaceholderTemplate>
                        </FormaPropertyColumn>
                        <FormaPropertyColumn Property="@(item => item.Title)">
                            <PlaceholderTemplate><span class="demo-skeleton" aria-hidden="true"></span></PlaceholderTemplate>
                        </FormaPropertyColumn>
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{HugeRowCount:N0} rows, fetched a slice at a time.", HugeRowCount]</Status>
        </FormaDataView>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Rows Arriving at the Top"]</h2>
    <p class="description">@L["A feed that grows at its start. Anchored to the start, the viewport stays at the top and shows what arrived when it is already there; anchored nowhere, the rows on screen hold their place and the new ones wait above."]</p>
    <div class="demo-box demo-row demo-controls">
        <FormaButton Variant="ButtonVariant.Secondary" OnClick="PrependFeedItemsAsync">@L["Prepend {Count} Rows", FeedBatchSize]</FormaButton>
        <FormaToggleButton Label="@L["Anchor to the start"]" ShowLabel="true" Pressed="@(_feedAnchorMode == VirtualizeAnchorMode.Start)" OnClick="ToggleFeedAnchor" />
    </div>
    <div class="demo-box demo-box-bounded">
        <FormaDataView @ref="_feedDataView" Items="_feedItems" ItemKey="@(item => item.Id)" EnablePagination="false" Virtualize="true" AnchorMode="_feedAnchorMode" AddressOptions='@(new DataViewAddressOptions("feed"))'>
            <ChildContent>
                <FormaDataGrid>
                    <Columns>
                        <FormaPropertyColumn Property="@(item => item.Id)" />
                        <FormaPropertyColumn Property="@(item => item.Title)" />
                    </Columns>
                </FormaDataGrid>
            </ChildContent>
            <Status>@L["{Count:N0} rows in the feed.", _feedList.Count]</Status>
        </FormaDataView>
    </div>
</div>

@code {
    private const int SelectionLimit = 3;
    private const int ManyRowCount = 47;
    private const int ManyPageSize = 10;
    private const int HugeRowCount = 100_000;
    private const int BlockRowCount = 10_000;
    private const int InitialRowIndex = 49_999;
    private const int FeedBatchSize = 5;
    private static readonly TimeSpan _slowSliceDelay = TimeSpan.FromMilliseconds(600);

