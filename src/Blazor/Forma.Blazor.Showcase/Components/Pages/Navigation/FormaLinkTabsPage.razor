@page "/link-tabs"
@attribute [ShowcasePage("FormaLinkTabs")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Navigation
@using Forma.Framework.Culture.Router
@using Microsoft.AspNetCore.Components.Routing
@inject CultureRouter Router
@inject CultureSwitcher Switcher

<h1>FormaLinkTabs</h1>
<p class="description">@L["A strip of tabs that link to pages, for a section whose pages each have an address of their own. The tab of the page the reader is on is marked current by an underline as well as its color, and every tab is a link that works before the page is interactive."]</p>

<div class="demo-section">
    <h2>@L["Pages of a Section"]</h2>
    <p class="description">@L["Each tab links to a page of the showcase's navigation section, and the tab of this page is marked current."]</p>
    <div class="demo-box">
        <FormaLinkTabs Items="SectionTabs" Label="@L["Navigation Components"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Icons and a Trailing Tab"]</h2>
    <p class="description">@L["Each tab draws an icon before its title, and the showcase's home tab stands at the far end. The home tab matches only its own address, so it isn't marked on this page beneath it."]</p>
    <div class="demo-box">
        <FormaLinkTabs Items="IconTabs" Label="@L["Showcase Pages"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Past Their Width"]</h2>
    <p class="description">@L["In a narrow column the strip keeps to one line, and scrolls behind an arrow at each end its tabs continue past."]</p>
    <div class="demo-box demo-box-narrow">
        <FormaLinkTabs Items="ManyTabs" Label="@L["Navigation and Layout Components"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["No Current Page"]</h2>
    <p class="description">@L["None of these tabs links to this page or to a page it lies beneath, so none is marked current."]</p>
    <div class="demo-box">
        <FormaLinkTabs Items="ElsewhereTabs" Label="@L["Input Components"]" />
    </div>
</div>

@code {
    private LinkTab[] SectionTabs =>
    [
        CreateTab(L["Breadcrumb"], "/breadcrumb"),
        CreateTab(L["Command Palette"], "/command-palette"),
        CreateTab(L["Link Tabs"], "/link-tabs"),
        CreateTab(L["Pagination"], "/pagination"),
        CreateTab(L["Stepper"], "/stepper"),
    ];

    private LinkTab[] IconTabs =>
    [
        CreateTab(L["Tabs"], "/tabs") with { Icon = Glyph.Layout },
        CreateTab(L["Link Tabs"], "/link-tabs") with { Icon = Glyph.Link },
        CreateTab(L["Splitter"], "/splitter") with { Icon = Glyph.Columns },
        CreateTab(L["Showcase"], "/") with { Icon = Glyph.Home, Match = NavLinkMatch.All, Trailing = true },
    ];

    private LinkTab[] ManyTabs =>
    [
        CreateTab(L["Breadcrumb"], "/breadcrumb"),
        CreateTab(L["Command Palette"], "/command-palette"),
        CreateTab(L["Link Tabs"], "/link-tabs"),
        CreateTab(L["Pagination"], "/pagination"),
        CreateTab(L["Stepper"], "/stepper"),
        CreateTab(L["Tabs"], "/tabs"),
        CreateTab(L["Splitter"], "/splitter"),
        CreateTab(L["Freeze Pane"], "/freeze-pane"),
    ];

    private LinkTab[] ElsewhereTabs =>
    [
        CreateTab(L["Text Box"], "/text-box"),
        CreateTab(L["Select"], "/select"),
        CreateTab(L["Combo Box"], "/combo-box"),
    ];

    // A tab goes to the page in the culture the showcase reads in, as its own links do.
    private LinkTab CreateTab(string title, string path)
        => new(title, Router.GetPath(Switcher.CurrentRoute, path));
}
