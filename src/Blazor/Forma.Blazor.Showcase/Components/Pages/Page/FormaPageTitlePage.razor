@page "/page-title"
@attribute [ShowcasePage("FormaPageTitle")]
@using Forma.Blazor.Components.Navigation
@using Forma.Blazor.Components.Page

<h1>FormaPageTitle</h1>
<p class="description">@L["The heading of a page, with its breadcrumb trail above and its actions beside it. Putting the three in one component keeps every page's top edge aligned."]</p>

<div class="demo-section">
    <h2>@L["Basic with Breadcrumbs"]</h2>
    <div class="demo-box">
        <FormaPageTitle Title="@L["Orders"]"
                       Breadcrumbs="BasicBreadcrumbs" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Title Only"]</h2>
    <div class="demo-box">
        <FormaPageTitle Title="@L["Dashboard"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["With Action Buttons"]</h2>
    <div class="demo-box">
        <FormaPageTitle Title="@L["Products"]"
                       Breadcrumbs="ProductsBreadcrumbs">
            <Actions>
                <FormaButton Variant="ButtonVariant.Primary">@L["Add New"]</FormaButton>
                <FormaButton>@L["Export"]</FormaButton>
            </Actions>
        </FormaPageTitle>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Title Too Long for One Line"]</h2>
    <p class="description">@L["Where the title and its actions don't fit one line, the actions move beneath it and keep to the end, and a word too long for the line breaks."]</p>
    <div class="demo-box">
        <FormaPageTitle Title="@L["Quarterly Revenue for the Northern Distribution Centers"]">
            <Actions>
                <FormaButton Variant="ButtonVariant.Primary">@L["Add New"]</FormaButton>
                <FormaButton>@L["Export"]</FormaButton>
            </Actions>
        </FormaPageTitle>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Deep Breadcrumb Trail"]</h2>
    <div class="demo-box">
        <FormaPageTitle Title="@L["Edit Product"]"
                       Breadcrumbs="DeepBreadcrumbs" />
    </div>
</div>

@code {
    private BreadcrumbItem<object?>[] BasicBreadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Store"]),
        new(L["Orders"])
    ];

    private BreadcrumbItem<object?>[] ProductsBreadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Store"]),
        new(L["Products"])
    ];

    private BreadcrumbItem<object?>[] DeepBreadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Store"]),
        new(L["Products"], "/products"),
        new(L["Edit Product"])
    ];
}
