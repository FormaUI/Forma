@page "/emoji-picker"
@attribute [ShowcasePage("FormaEmojiPicker")]
@rendermode InteractiveServer

<h1>FormaEmojiPicker</h1>
<p class="description">@L["A categorized emoji palette over the full Unicode set, with a tab per category, keyword search, and recently used entries. Artwork is resolved through IEmojiProvider, drawn from Forma's own sprites by default and falling back to the reader's platform font for anything the shipped set does not cover."]</p>

<div class="demo-section">
    <h2>@L["Default"]</h2>
    <p class="description">@L["Every category is a tab, and every emoji carries its name as an accessible label. Type in the search box to match against names and keywords; search \"zzzz\" to see the no-match state."]</p>
    <div class="demo-box">
        <FormaEmojiPicker OnSelect="OnPickedAsync" />
    </div>
    <p role="status">@(_pickedEmoji is null ? L["Nothing chosen yet."] : L["Chose {Emoji}.", _pickedEmoji])</p>
</div>

<div class="demo-section">
    <h2>@L["Recently Used"]</h2>
    <p class="description">@L["A host that persists the recent list gets an extra leading tab. Choose an emoji here and it moves to the front."]</p>
    <div class="demo-box">
        <FormaEmojiPicker @bind-RecentEmojis="_recentEmojis" />
    </div>
    <p>@L["Recent: {Emoji}", string.Join(" ", _recentEmojis)]</p>
</div>

<div class="demo-section">
    <h2>@L["Recent Limit"]</h2>
    <p class="description">@L["MaxRecent caps how many are kept. This one keeps three."]</p>
    <div class="demo-box">
        <FormaEmojiPicker @bind-RecentEmojis="_limitedRecentEmojis" Options="@(new EmojiPickerOptions { MaxRecent = 3 })" />
    </div>
    <p>@L["Recent: {Emoji}", string.Join(" ", _limitedRecentEmojis)]</p>
</div>

<div class="demo-section">
    <h2>@L["Without Search"]</h2>
    <div class="demo-box">
        <FormaEmojiPicker Options="@(new EmojiPickerOptions { ShowSearch = false })" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Without Category Tabs"]</h2>
    <p class="description">@L["Only the first category is reachable, so this suits a picker narrowed to one category."]</p>
    <div class="demo-box">
        <FormaEmojiPicker Options="@(new EmojiPickerOptions { ShowGroupTabs = false })" />
    </div>
</div>

@code {
    private string? _pickedEmoji;
    private IReadOnlyList<string> _recentEmojis = ["🚴", "🏆", "⏱️"];
    private IReadOnlyList<string> _limitedRecentEmojis = ["✅"];

    private Task OnPickedAsync(string emoji)
    {
        _pickedEmoji = emoji;
        return Task.CompletedTask;
    }
}
