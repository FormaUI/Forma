@page "/sortable-list"
@attribute [ShowcasePage("FormaSortableList")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Inputs
@using Forma.Blazor.Components.Collections

<h1>FormaSortableList</h1>
<p class="description">@L["A list that reorders by dragging a handle or moving a focused item with the arrow keys."]</p>

<div class="demo-section">
    <h2>@L["Basic"]</h2>
    <div class="demo-box">
        <FormaSortableList Items="_photos" ItemKey="@(photo => photo.Id)"
                            ItemsChanged="@((IReadOnlyList<PhotoItem> reordered) => _photos = [.. reordered])">
            <ItemTemplate Context="photo">@photo.Name</ItemTemplate>
        </FormaSortableList>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Interactive Item Content"]</h2>
    <p class="description">@L["The drag handle is separate from the item's own content, so a button inside an item stays clickable."]</p>
    <div class="demo-box">
        <FormaSortableList Items="_tags" ItemKey="@(tag => tag.Id)"
                            ItemsChanged="@((IReadOnlyList<TagItem> reordered) => _tags = [.. reordered])">
            <ItemTemplate Context="tag">
                <div class="demo-sortable-tag">
                    <span>@tag.Name</span>
                    <FormaButton Variant="ButtonVariant.Danger" Size="ButtonSize.Mini" OnClick="@(() => RemoveTag(tag))">@L["Remove"]</FormaButton>
                </div>
            </ItemTemplate>
        </FormaSortableList>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Long List in a Scrolling Panel"]</h2>
    <p class="description">@L["Holding a drag near the top or bottom edge scrolls the panel, and releasing in the empty space below the last row sends the item to the end."]</p>
    <div class="demo-box demo-scroll-box">
        <FormaSortableList Items="_stages" ItemKey="@(stage => stage.Id)"
                            ItemsChanged="@((IReadOnlyList<StageItem> reordered) => _stages = [.. reordered])">
            <ItemTemplate Context="stage">@stage.Name</ItemTemplate>
        </FormaSortableList>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Dragging from the Whole Row"]</h2>
    <p class="description">@L["The whole row starts a drag, not just the handle. Interactive elements inside a row keep their own press, and on touch the row is held briefly before it lifts so a swipe still scrolls."]</p>
    <div class="demo-box">
        <FormaSortableList Items="_links" ItemKey="@(link => link.Id)" DragFrom="SortableDragFrom.Item"
                            ItemsChanged="@((IReadOnlyList<LinkItem> reordered) => _links = [.. reordered])">
            <ItemTemplate Context="link">
                <div class="demo-sortable-tag">
                    <span>@link.Name</span>
                    <FormaButton Size="ButtonSize.Mini" OnClick="@(() => _lastClickedName = link.Name)">@L["Edit"]</FormaButton>
                </div>
            </ItemTemplate>
        </FormaSortableList>
        <p class="demo-note">@(_lastClickedName is null ? L["Drag a row anywhere to reorder, or press Edit — it still clicks."] : L["Edit was clicked on {Name}, so the row did not take the press.", _lastClickedName])</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["In a Popover"]</h2>
    <p class="description">@L["A list inside a popover that keeps focus. A drag begun inside it belongs to the list, Escape while dragging cancels the drag and leaves the popover open, and its keys move the item without leaving the popover."]</p>
    <div class="demo-box">
        <span class="demo-anchor" @ref="_favoritesAnchor">
            <FormaButton @ref="_favoritesTrigger" Variant="ButtonVariant.Primary" aria-expanded="@(_favoritesPopover is { IsOpen: true } ? "true" : "false")" OnClick="() => _favoritesPopover.ToggleAsync(_favoritesTrigger.RootElement)">@L["Open"]</FormaButton>
        </span>
        <FormaPopover @ref="_favoritesPopover" Anchor="_favoritesAnchor" KeepsFocus="true" OnOpenChanged="_ => { }" OnOpened="() => _favoritesList.FocusAsync()">
            <div class="demo-popover">
                <FormaSortableList @ref="_favoritesList" Items="_favorites" ItemKey="@(photo => photo.Id)"
                                    ItemsChanged="@((IReadOnlyList<PhotoItem> reordered) => _favorites = [.. reordered])">
                    <ItemTemplate Context="photo">@photo.Name</ItemTemplate>
                </FormaSortableList>
            </div>
        </FormaPopover>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Disabled"]</h2>
    <div class="demo-box">
        <FormaSortableList Items="_photos" ItemKey="@(photo => photo.Id)" Disabled="true">
            <ItemTemplate Context="photo">@photo.Name</ItemTemplate>
        </FormaSortableList>
    </div>
</div>

@code {
    private List<PhotoItem> _photos =
    [
        new(1, "cover.jpg"),
        new(2, "start-line.jpg"),
        new(3, "podium.jpg"),
        new(4, "peloton.jpg"),
    ];

    private List<TagItem> _tags =
    [
        new(1, "Road"),
        new(2, "Mountain"),
        new(3, "Gravel"),
    ];

    private List<LinkItem> _links =
    [
        new(1, "Home"),
        new(2, "Races"),
        new(3, "Videos"),
        new(4, "Contact"),
    ];

    private List<StageItem> _stages = [.. Enumerable.Range(1, 12).Select(n => new StageItem(n, $"Stage {n}"))];

    private List<PhotoItem> _favorites =
    [
        new(1, "sunrise.jpg"),
        new(2, "summit.jpg"),
        new(3, "descent.jpg"),
    ];

    private ElementReference _favoritesAnchor;
    private FormaButton _favoritesTrigger = default!;
    private FormaPopover _favoritesPopover = default!;
    private FormaSortableList<PhotoItem> _favoritesList = default!;

    private string? _lastClickedName;

    private void RemoveTag(TagItem tag)
        => _tags = [.. _tags.Where(t => t.Id != tag.Id)];

    private sealed record PhotoItem(int Id, string Name);

    private sealed record TagItem(int Id, string Name);

    private sealed record LinkItem(int Id, string Name);

    private sealed record StageItem(int Id, string Name);
}
