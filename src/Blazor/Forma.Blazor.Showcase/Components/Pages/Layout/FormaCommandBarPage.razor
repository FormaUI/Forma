@page "/command-bar"
@attribute [ShowcasePage("FormaCommandBar")]
@rendermode InteractiveServer
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Layout

<h1>FormaCommandBar</h1>
<p class="description">@L["One bar of commands. It lays them on a track that scrolls behind arrows once they outgrow the width, each arrow shown only while there is somewhere left to go that way."]</p>

<div class="demo-section">
    <h2>@L["Commands That Outgrow the Bar"]</h2>
    <p class="description">@L["Once the commands no longer fit, an arrow appears at each end, and the pair also reads as how far along the bar you are."]</p>
    <div class="demo-box demo-box-flush demo-command-bar-narrow">
        <FormaCommandArea>
            <FormaCommandBar>
                @foreach (var command in ManyCommands)
                {
                    <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@command</FormaButton>
                }
            </FormaCommandBar>
        </FormaCommandArea>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Commands That Change"]</h2>
    <p class="description">@L["A bar notices its commands being added or removed, not only the browser window being resized, so the arrows appear the moment the bar stops fitting."]</p>
    <div class="demo-box demo-box-flush demo-command-bar-narrow">
        <FormaCommandArea>
            <FormaCommandBar>
                @for (var index = 0; index < _visibleCommands; index++)
                {
                    var command = ManyCommands[index];
                    <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@command</FormaButton>
                }
            </FormaCommandBar>
        </FormaCommandArea>
    </div>
    <div class="demo-row">
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="() => _visibleCommands = Math.Min(_visibleCommands + 2, ManyCommands.Length)">@L["Add Commands"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="() => _visibleCommands = Math.Max(_visibleCommands - 2, 1)">@L["Remove Commands"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Bar That Fits"]</h2>
    <p class="description">@L["With room to spare there is nothing to scroll, so no arrows are drawn at all rather than sitting there permanently dimmed."]</p>
    <div class="demo-box demo-box-flush">
        <FormaCommandArea>
            <FormaCommandBar>
                <FormaButton Variant="ButtonVariant.Primary" Size="ButtonSize.Mini">@L["Save"]</FormaButton>
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@L["Cancel"]</FormaButton>
            </FormaCommandBar>
        </FormaCommandArea>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Content Pinned past the Track"]</h2>
    <p class="description">@L["Trailing content, such as an overflow menu, stays put beside the arrows while the commands beside it keep scrolling."]</p>
    <div class="demo-box demo-box-flush demo-command-bar-narrow">
        <FormaCommandArea>
            <FormaCommandBar>
                <ChildContent>
                    @foreach (var command in ManyCommands)
                    {
                        <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@command</FormaButton>
                    }
                </ChildContent>
                <TrailingContent>
                    <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" IconOnly="true" aria-label="@L["More"]"><FormaIcon Icon="Glyph.MoreVertical" /></FormaButton>
                </TrailingContent>
            </FormaCommandBar>
        </FormaCommandArea>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Custom Arrow Labels"]</h2>
    <p class="description">@L["A caller naming the arrows for its own domain, rather than the generic default."]</p>
    <div class="demo-box demo-box-flush demo-command-bar-narrow">
        <FormaCommandArea>
            <FormaCommandBar Options="@(new FreezePaneOptions { ScrollBackLabel = L["Earlier Filters"], ScrollForwardLabel = L["Later Filters"] })">
                @foreach (var filter in ManyFilters)
                {
                    <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@filter</FormaButton>
                }
            </FormaCommandBar>
        </FormaCommandArea>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Hidden"]</h2>
    <p class="description">@L["Toggling Hidden keeps the bar mounted, so a favorites or plugin bar can be shown and hidden on demand without losing its scroll position or re-attaching its JavaScript."]</p>
    <div class="demo-box demo-box-flush demo-command-bar-narrow">
        <FormaCommandArea>
            <FormaCommandBar Hidden="@(!_showFavorites)" Animated="true">
                @foreach (var command in ManyCommands)
                {
                    <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini">@command</FormaButton>
                }
            </FormaCommandBar>
        </FormaCommandArea>
    </div>
    <div class="demo-row">
        <FormaButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Mini" OnClick="() => _showFavorites = !_showFavorites">@(_showFavorites ? L["Hide Favorites Bar"] : L["Show Favorites Bar"])</FormaButton>
    </div>
</div>

@code {
    private int _visibleCommands = 2;

    private bool _showFavorites = true;

    private string[] ManyCommands =>
    [
        L["New"], L["Open"], L["Save"], L["Rename"], L["Duplicate"],
        L["Move"], L["Copy"], L["Share"], L["Export"], L["Archive"], L["Delete"]
    ];

    private string[] ManyFilters =>
    [
        L["All"], L["Images"], L["Video"], L["Audio"], L["Documents"],
        L["Archives"], L["Recent"], L["Starred"], L["Shared with Me"]
    ];
}
