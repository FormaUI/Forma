@page "/button"
@attribute [ShowcasePage("FormaButton")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Forma.Blazor.Components.Inputs

<h1>FormaButton</h1>
<p class="description">@L["The button every Forma surface presses. Its variant says how much it should stand out, its size how dense the row around it is, and while work is in flight it shows itself busy so the same click cannot be sent twice."]</p>

<div class="demo-section">
    <h2>@L["Variants"]</h2>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary">@L["Primary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Secondary">@L["Secondary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary">@L["Tertiary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Danger">@L["Danger"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost">@L["Ghost"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Sizes"]</h2>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary">@L["Normal"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Primary" Size="ButtonSize.Mini">@L["Mini"]</FormaButton>
        <FormaButton>@L["Normal"]</FormaButton>
        <FormaButton Size="ButtonSize.Mini">@L["Mini"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Row Actions"]</h2>
    <p class="description">@L["The tertiary variant is the one built for repeated inline commands, such as the actions at the end of a table row."]</p>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                     OnClick="@(() => Record(L["View"]))">@L["View"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                     OnClick="@(() => Record(L["Edit"]))">@L["Edit"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                     OnClick="@(() => Record(L["Delete"]))">@L["Delete"]</FormaButton>
        <span class="demo-note">@L["Last action: {Action}", _lastAction ?? L["none yet"].Value]</span>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Disabled"]</h2>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary" Disabled="true">@L["Primary"]</FormaButton>
        <FormaButton Disabled="true">@L["Secondary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary" Disabled="true">@L["Tertiary"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Danger" Disabled="true">@L["Danger"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost" Disabled="true">@L["Ghost"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Busy"]</h2>
    <p class="description">@L["A busy button keeps its label, announces itself with aria-busy, and stops accepting clicks until the work finishes."]</p>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary" Busy="true">@L["Save"]</FormaButton>
        <FormaButton Busy="true">@L["Save"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Tertiary" Busy="true">@L["Save"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Danger" Busy="true">@L["Save"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Ghost" Busy="true">@L["Save"]</FormaButton>
        <FormaButton Variant="ButtonVariant.Primary" Busy="true" BusyText="@L["Saving…"]">@L["Save"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["As a Link"]</h2>
    <p class="description">@L["Given an Href, the button is a link in the button's look: its address can be copied, opened in another tab or followed with a middle click. Disabled or busy, it names no address and stays a link."]</p>
    <div class="demo-box demo-row">
        <FormaButton Variant="ButtonVariant.Primary" Href="/text-box">@L["Open the Text Box"]</FormaButton>
        <FormaButton Href="https://github.com/FormaUI/Forma" Target="_blank" Rel="noopener">@L["Source on GitHub"]</FormaButton>
        <FormaButton Href="/text-box" Disabled="true">@L["Disabled"]</FormaButton>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Inside a Form"]</h2>
    <p class="description">@L["Submit and reset buttons drive the surrounding form without any click handler of their own. A native reset clears the inputs but leaves the bound model alone, so the value below is what the form still holds."]</p>
    <div class="demo-box">
        <EditForm Model="Model" FormName="button-demo" OnValidSubmit="HandleSubmitAsync" class="demo-stack">
            <FormaTextBox @bind-Value="Model.Name" Label="@L["Name"]" />
            <div class="demo-row">
                <FormaButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary" Busy="_isSaving">
                    @(_isSaving ? L["Saving…"] : L["Save"])
                </FormaButton>
                <FormaButton Type="ButtonType.Reset">@L["Reset"]</FormaButton>
                <span class="demo-note">@(_isSaved ? L["Saved."] : L["Not saved yet."])</span>
            </div>
        </EditForm>
        <p class="demo-note">
            @L["Bound value: {Value}", string.IsNullOrEmpty(Model.Name) ? L["(empty)"].Value : Model.Name]
        </p>
    </div>
</div>

@code {
    private ButtonDemoModel Model { get; set; } = new();

    private string? _lastAction;
    private bool _isSaving;
    private bool _isSaved;

    private void Record(string action) => _lastAction = action;

    private async Task HandleSubmitAsync()
    {
        _isSaving = true;
        _isSaved = false;

        await Task.Delay(1200);

        _isSaving = false;
        _isSaved = true;
    }

    private sealed class ButtonDemoModel
    {
        public string? Name { get; set; }
    }
}
