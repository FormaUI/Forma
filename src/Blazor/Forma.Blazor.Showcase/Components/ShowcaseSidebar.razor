@using Forma.Framework.Culture
@using Forma.Framework.Culture.Router
@using Forma.Framework.JavaScript.Interop
@using Forma.Blazor.Showcase
@using Forma.Blazor.Showcase.Interop
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject CultureRouter Router
@inject CultureSwitcher Switcher
@inject NavigationManager Nav
@inject ICultureState CultureState
@inject IJSRuntime JSRuntime
@inject ILogger<ShowcaseSidebar> Logger

@* The header stays in view while the page list below it scrolls. *@
<nav class="showcase-sidebar">
    <div class="showcase-sidebar-header">
        @* The wordmark: its lettering inline, so it takes the text color of every theme and scheme, and its O from the logo,
           which shares the wordmark's coordinates and reads on any backdrop. *@
        <a class="showcase-brand" href="@Router.GetPath(CurrentRoute, "/")">
            <svg viewBox="-28.293 79.1857 2110 440" role="img" aria-label="Forma">
                <path d="M0 0H78V18H21V46H72V65H21V106H0Z" transform="translate(1.3773584905660528 108) scale(3.5849056603773586)" fill-rule="evenodd" />
                <path d="M0 0H49C73 0 90 13 90 36C90 53 82 64 68 70L94 106H68L46 73H22V106H0Z M22 18V54H48C60 54 68 48 68 36C68 25 60 18 48 18Z" transform="translate(50 0) translate(707 108) scale(3.5849056603773586)" fill-rule="evenodd" />
                <path d="M0 0H24L60 68L95 0H119V106H98V34L67 96H53L21 34V106H0Z" transform="translate(50 0) translate(1083.9811320754716 108) scale(3.5849056603773586)" fill-rule="evenodd" />
                <path d="M0 106L52 0H76L129 106H105L94 83H35L24 106Z M44 65H84L64 22Z" transform="translate(50 0) translate(1539.5849056603772 108) scale(3.5849056603773586)" fill-rule="evenodd" />
                <image href="/logo.svg" x="297.727" y="91.186" width="416" height="416" />
            </svg>
        </a>
        <div class="culture-switcher">
            @foreach (var route in Router.Routes.Where(route => Labels.ContainsKey(route.Token)))
            {
                <a href="@LinkTo(route)" class="@(IsCurrent(route) ? "active" : "")">@GetLabel(route)</a>
            }
        </div>
    </div>
    <div class="showcase-sidebar-pages" @ref="_pagesElement">
        @foreach (var group in ShowcaseCatalog.Sidebar)
        {
            <h3>@group.Key</h3>
            @foreach (var entry in group)
            {
                <NavLink href="@Router.GetPath(CurrentRoute, entry.Route)" Match="NavLinkMatch.Prefix">@entry.Title</NavLink>
            }
        }
    </div>
</nav>

@code {
    private static readonly Dictionary<string, string> Labels = new(StringComparer.Ordinal)
    {
        ["en"] = "En",
        ["he"] = "עב",
        ["es"] = "Es"
    };

    private ElementReference _pagesElement;

    private ReadingPlace? _readingPlace;

    private bool _hasNavigated;

    private CultureRoute CurrentRoute => Switcher.CurrentRoute;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
        CultureState.Subscribe(HandleCultureChangedAsync);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The reader's place is kept across a language link for the page it leads to, and the list shows this page's entry.
        if (firstRender)
        {
            _readingPlace = new ReadingPlace(new JSEnvironment(JSRuntime, Logger, Guid.NewGuid()));
            await _readingPlace.AttachAsync(_pagesElement, ".culture-switcher a", ".demo-section", ":scope > a.active");
        }
        else if (_hasNavigated && _readingPlace is not null)
        {
            // A page reached without the list, through a card or a tab, may have its entry out of view.
            _hasNavigated = false;
            await _readingPlace.RevealAsync();
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        CultureState.Unsubscribe(HandleCultureChangedAsync);

        if (_readingPlace is not null)
        {
            await _readingPlace.DisposeAsync();
        }
    }

    // The layout outlives a navigation, so the language links are drawn again to lead to the page now shown, and the list
    // brings that page's entry into view once drawn.
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _hasNavigated = true;
        _ = InvokeAsync(StateHasChanged);
    }

    // A switch made in place lands after the location changed, so the links are drawn again once the culture follows it.
    private Task HandleCultureChangedAsync()
        => InvokeAsync(StateHasChanged);

    private static string GetLabel(CultureRoute route)
        => Labels.GetValueOrDefault(route.Token, route.Token);

    private bool IsCurrent(CultureRoute route)
        => string.Equals(route.Token, CurrentRoute.Token, StringComparison.Ordinal);

    private string LinkTo(CultureRoute route)
        => Router.GetUrl(route, Nav.ToBaseRelativePath(Nav.Uri));
}
