<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>The WebAssembly half of Forma's component library: the registration a WebAssembly client makes, which registers what the components need in the browser and the culture a WebAssembly runtime keeps.</Description>
        <!-- The WebAssembly half borrows the product's namespace, so a client reaches its registrar with the using it already writes. -->
        <RootNamespace>Forma.Blazor</RootNamespace>
    </PropertyGroup>

    <!-- The product it serves, a package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Blazor\Forma.Blazor.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Culture\Forma.Framework.Culture.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Culture.Blazor.WebAssembly\Forma.Framework.Culture.Blazor.WebAssembly.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Culture.Browser.Interop\Forma.Framework.Culture.Browser.Interop.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Input\Forma.Framework.Input.csproj" />
    </ItemGroup>

</Project>
