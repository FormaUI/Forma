@namespace Forma.Blazor.Components.Explorer
@inherits FormaComponentBase
@using Forma.Blazor.Components.DataView

<div class="forma-explorer-content">
    <div class="forma-explorer-scroll @(View.IsFetching ? "is-busy" : "")" aria-busy="@(View.IsFetching ? "true" : "false")">
        @if (View.VisibleItems.Count == 0)
        {
            <div class="forma-explorer-empty" role="status">
                <span class="forma-explorer-empty-icon" aria-hidden="true"><FormaIcon Icon="Glyph.Images" Size="IconSize.Display" /></span>
                @if (View.IsFetching)
                {
                    <p>@L["Loading media"]</p>
                }
                else if (!string.IsNullOrWhiteSpace(Search.SearchQuery))
                {
                    <p>@L["No media matches \"{Query}\"", Search.SearchQuery]</p>
                }
                else if (Location.CurrentFolder is not null)
                {
                    <p>@L["No media in this folder"]</p>
                }
                else
                {
                    <p>@L["No media found"]</p>
                }
            </div>
        }
        else
        {
            @if (View.ViewMode == ExplorerViewMode.Thumbnails)
            {
                @* The thumbnails are the data view's cards at their compact density, which draw their groups and their next page. *@
                <FormaDataCards TItem="ICatalogItem" Dense="true" CardSize="@ThumbnailSize" class="forma-explorer-cards" aria-label="@L["Media"]">
                    <ThumbnailTemplate Context="item">
                        <span class="forma-explorer-card-thumbnail">
                            @if (item.Resource is { } resource)
                            {
                                <FormaExplorerThumbnail Resource="resource" Size="ExplorerThumbnailSize.Tile" />
                            }
                        </span>
                        @if (!Selection.IsSelectionModeActive)
                        {
                            <span class="forma-explorer-card-actions" data-item-control>
                                <FormaExplorerActionBar Item="item" />
                            </span>
                        }
                    </ThumbnailTemplate>
                </FormaDataCards>
            }
            else if (View.ViewMode == ExplorerViewMode.Details)
            {
                @* The details are the data view's grid, which draws its groups and its next page: the actions and the name stay at the
                   start as the other columns scroll, and a column's header sorts by the field the store sorts by. *@
                <FormaDataGrid TItem="ICatalogItem" ShowHeader="View.ShowsDetailsHeader" class="forma-explorer-details" aria-label="@L["Media"]">
                    <Columns>
                        <FormaTemplateColumn TItem="ICatalogItem" Title="@L["Actions"]" Frozen="true" Visible="!Selection.IsSelectionModeActive" Class="forma-explorer-column-actions">
                            <HeaderTemplate Context="column"><span class="forma-explorer-visually-hidden">@L["Actions"]</span></HeaderTemplate>
                            <ChildContent Context="item">
                                <span data-item-control><FormaExplorerActionBar Item="item" /></span>
                            </ChildContent>
                        </FormaTemplateColumn>
                        <FormaTemplateColumn TItem="ICatalogItem" Title="@L["Name"]" Frozen="true" SortName="@GetSortName(CatalogSortField.Name)" SortBy="GetSort(CatalogSortField.Name)" Class="forma-explorer-column-name">
                            <span class="forma-explorer-details-name">
                                @if (context.Resource is { } resource)
                                {
                                    <FormaExplorerThumbnail Resource="resource" Size="ExplorerThumbnailSize.Cell" />
                                }
                                <span class="forma-explorer-details-name-text" title="@context.Name">@context.Name</span>
                            </span>
                        </FormaTemplateColumn>
                        <FormaTemplateColumn TItem="ICatalogItem" Title="@L["Type"]" Visible="Shows(ExplorerDetailsColumns.Kind)" SortName="@GetSortName(CatalogSortField.Kind)" SortBy="GetSort(CatalogSortField.Kind)" Class="forma-explorer-column-kind">
                            @context.GetLocalizedLabels(L).KindLabel
                        </FormaTemplateColumn>
                        <FormaTemplateColumn TItem="ICatalogItem" Title="@L["Size"]" Visible="Shows(ExplorerDetailsColumns.Size)" SortName="@GetSortName(CatalogSortField.Size)" SortBy="GetSort(CatalogSortField.Size)" Class="forma-explorer-column-size">
                            <span dir="auto">@(context.Resource?.FormatSize(Context.CultureState.Culture) ?? Placeholder)</span>
                        </FormaTemplateColumn>
                        <FormaTemplateColumn TItem="ICatalogItem" Title="@L["Modified"]" Visible="Shows(ExplorerDetailsColumns.Modified)" SortName="@GetSortName(CatalogSortField.DateModified)" SortBy="GetSort(CatalogSortField.DateModified)" Class="forma-explorer-column-modified">
                            @FormatDate(context.ModifiedAt)
                        </FormaTemplateColumn>
                        <FormaTemplateColumn TItem="ICatalogItem" Title="@L["Added"]" Visible="Shows(ExplorerDetailsColumns.Added)" SortName="@GetSortName(CatalogSortField.DateAdded)" SortBy="GetSort(CatalogSortField.DateAdded)" Class="forma-explorer-column-added">
                            @FormatDate(context.CreatedAt)
                        </FormaTemplateColumn>
                    </Columns>
                </FormaDataGrid>
            }
            else
            {
                <FormaExplorerListView Items="View.VisibleItems" />
            }
        }

        @* The next page is the data view's to load, from its action after the items and as the reader reaches their end, which the cards and
           the grid draw themselves. *@
        @if (View.VisibleItems.Count > 0 && View.ViewMode == ExplorerViewMode.List)
        {
            @Content.MoreContent
        }
    </div>

    <FormaDataViewFooter class="forma-explorer-footer" />
</div>
