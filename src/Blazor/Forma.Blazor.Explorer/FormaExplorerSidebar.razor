@namespace Forma.Blazor.Components.Explorer
@inherits FormaComponentBase
@using Forma.Blazor.Components.DataView
@using Forma.Blazor.Components.Layout
@using Forma.Blazor.Components.Menus
@using Forma.Framework.Catalog
@using Forma.Framework.Explorer.Items

<aside class="forma-explorer-sidebar" aria-labelledby="@TitleId">
    <div class="forma-explorer-sidebar-toolbar">
        <span class="forma-explorer-sidebar-title" id="@TitleId">@L["Folders"]</span>

        <div class="forma-explorer-sidebar-tools">
            @if (ItemOptions.AllowedFolderCapabilities.HasFlag(CatalogItemCapabilities.Create))
            {
                <FormaButton Variant="ButtonVariant.Ghost"
                             Size="ButtonSize.Mini"
                             IconOnly="true"
                             class="forma-explorer-sidebar-tool forma-explorer-new-folder-tool"
                             aria-label="@L["New Folder"]"
                             OnClick="() => CreateFolderAsync(null)">
                    <FormaIcon Icon="Glyph.FolderAdd" />
                </FormaButton>
            }
            <FormaButton Variant="ButtonVariant.Ghost"
                         Size="ButtonSize.Mini"
                         IconOnly="true"
                         class="@(IsFullyCollapsed ? "forma-explorer-sidebar-tool forma-explorer-expand-all-tool" : "forma-explorer-sidebar-tool forma-explorer-collapse-all-tool")"
                         Disabled="@(!HasExpandableFolders)"
                         aria-label="@(IsFullyCollapsed ? L["Expand All Folders"] : L["Collapse All Folders"])"
                         OnClick="ToggleAllAsync">
                <FormaIcon Icon="@(IsFullyCollapsed ? Glyph.ExpandPlus : Glyph.CollapseMinus)" />
            </FormaButton>
        </div>
    </div>

    <div class="forma-explorer-folder-tree" style="@TreeSizeStyle" @ref="_tree">
        <FormaDataTree TItem="ICatalogItem" SelectsCurrent="true" NodeFilter="IsFolder" RootsItem="AllMedia" Dense="true" aria-labelledby="@TitleId">
            <ThumbnailTemplate Context="item">
                <span class="forma-explorer-folder-icon"><FormaIcon Icon="@(IsCurrent(item) ? Glyph.FolderOpen : Glyph.Folder)" Size="IconSize.Small" /></span>
            </ThumbnailTemplate>
            <ItemTemplate Context="item">
                @if (item is ICatalogFolderItem folder)
                {
                    var allowed = GetActions(folder);
                    if (folder.Count is { } count)
                    {
                        <span class="forma-explorer-folder-count">@count</span>
                    }
                    @if (allowed != CatalogItemCapabilities.None)
                    {
                        <span class="forma-explorer-folder-actions">
                            <FormaOverflowMenu Label="@L["Actions for {Name}", folder.Name]"
                                               Orientation="MenuOrientation.Vertical"
                                               TriggerOptions="ButtonOptions.MiniGhostIcon"
                                               data-item-actions>
                                <HeaderContent>
                                    <span title="@folder.Name">@folder.Name</span>
                                </HeaderContent>
                                <ChildContent>
                                    @if (allowed.HasFlag(CatalogItemCapabilities.Create))
                                    {
                                        <FormaDropDownMenuItem data-action="folder-create" OnClick="() => CreateFolderAsync(folder)">
                                            <FormaIcon Icon="Glyph.FolderAdd" Size="IconSize.Small" />
                                            <span>@L["New Folder"]</span>
                                        </FormaDropDownMenuItem>
                                    }
                                    @if (allowed.HasFlag(CatalogItemCapabilities.Rename))
                                    {
                                        <FormaDropDownMenuItem data-action="folder-rename" OnClick="() => ItemInteraction.RequestRename(folder)">
                                            <FormaIcon Icon="Glyph.Pen" Size="IconSize.Small" />
                                            <span>@L["Rename Folder"]</span>
                                        </FormaDropDownMenuItem>
                                    }
                                    @if (allowed.HasFlag(CatalogItemCapabilities.Delete))
                                    {
                                        <FormaDropDownMenuItem data-action="folder-delete" IsDestructive="true" OnClick="() => OnFolderDelete.InvokeAsync(folder)">
                                            <FormaIcon Icon="Glyph.Delete" Size="IconSize.Small" />
                                            <span>@L["Delete Folder"]</span>
                                        </FormaDropDownMenuItem>
                                    }
                                </ChildContent>
                            </FormaOverflowMenu>
                        </span>
                    }
                }
            </ItemTemplate>
        </FormaDataTree>
    </div>

    <FormaSplitter Class="forma-explorer-sidebar-sash"
                   Orientation="SplitterOrientation.Horizontal"
                   Value="@(_treeHeight ?? MeasuredTreeHeight)"
                   ValueChanged="height => _treeHeight = height"
                   Min="MinTreeHeight"
                   Max="MaxTreeHeight"
                   Label="@L["Resize Folder List"]" />
</aside>
