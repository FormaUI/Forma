@namespace Forma.Blazor.Components.Feedback
@inherits FormaElementBase

<span id="@Id"
      data-rid="@Context.RuntimeId"
      class="@RootClass"
      style="@RootStyle"
      @attributes="AdditionalAttributes"
      @ref="RootElement"
      role="status">
    <span class="forma-spinner-ring" aria-hidden="true"></span>
    <span class="@LabelClass">@Label</span>
</span>
