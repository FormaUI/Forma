@namespace Forma.Blazor.Components.Feedback
@inherits FormaElementBase

@* Manual, since dismissal belongs to the input router. *@
<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement"
     popover="manual">
    @if (IsOpen)
    {
        @ChildContent
    }
</div>
