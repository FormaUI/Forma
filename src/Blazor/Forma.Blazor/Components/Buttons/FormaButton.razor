@namespace Forma.Blazor.Components.Buttons
@inherits FormaElementBase

@{
    RenderFragment content = @<text>@if (BusyText is null)
    {
        @ChildContent
    }
    else
    {
        <span class="forma-button-labels"><span class="forma-button-label">@ChildContent</span><span class="forma-button-busy-label">@BusyText</span></span>
    }<span class="forma-button-progress" aria-hidden="true"><span class="forma-button-progress-fill"></span><span class="forma-button-progress-fill"></span></span></text>;
}

@if (IsLink)
{
    <a id="@Id"
       data-rid="@Context.RuntimeId"
       class="@RootClass"
       style="@RootStyle"
       @attributes="AdditionalAttributes"
       @ref="RootElement"
       href="@LinkHref"
       target="@Target"
       rel="@Rel"
       role="@LinkRole"
       tabindex="@LinkTabIndex"
       data-busy="@DataBusy"
       aria-disabled="@LinkAriaDisabled"
       aria-busy="@AriaBusy"
       @onclick="ClickCallback">@content</a>
}
else
{
    <button id="@Id"
            data-rid="@Context.RuntimeId"
            class="@RootClass"
            style="@RootStyle"
            @attributes="AdditionalAttributes"
            @ref="RootElement"
            type="@TypeAttribute"
            disabled="@IsDisabled"
            data-busy="@DataBusy"
            aria-disabled="@AriaDisabled"
            aria-busy="@AriaBusy"
            @onclick="ClickCallback"
            @onclick:preventDefault="Busy">@content</button>
}
