@namespace Forma.Blazor.Components.Buttons
@inherits FormaElementBase

<FormaButton @ref="Button"
             Id="@Id"
             Class="@RootClass"
             Style="@RootStyle"
             @attributes="AdditionalAttributes"
             Variant="ButtonVariant.Ghost"
             Size="Size"
             IconOnly="true"
             Disabled="Disabled"
             OnClick="OnClick"
             aria-label="@Label">
    <FormaIcon Icon="Glyph.Cross" Size="IconSize.Small" />
</FormaButton>
