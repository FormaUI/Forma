@typeparam TItem
@namespace Forma.Blazor.Components.Navigation
@inherits FormaElementBase
<nav id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement"
     aria-label="@EffectiveAriaLabel">
    @if (RootIcon is { } icon)
    {
        <span class="forma-breadcrumb-root-icon" aria-hidden="true"><FormaIcon Icon="icon" Size="IconSize.Small" /></span>
    }

    <ol class="forma-breadcrumb-list">
        @for (var index = 0; index < Items.Count; index++)
        {
            var item = Items[index];
            var isLast = index == Items.Count - 1;

            <li class="forma-breadcrumb-level">
                @if (item.Url is not null)
                {
                    <a class="forma-breadcrumb-item @(item.IsCurrent ? "is-current" : "")"
                       href="@item.Url"
                       aria-current="@(item.IsCurrent ? "page" : null)"
                       @ondragover="HandleDragOver"
                       @ondragover:preventDefault="OnItemDrop.HasDelegate"
                       @ondrop="() => HandleItemDropAsync(item)">
                        @item.Label
                    </a>
                }
                else if (OnItemClick.HasDelegate)
                {
                    @* Drag events land on the anchor around the button. *@
                    <span class="forma-breadcrumb-drop-target"
                          @ondragover="HandleDragOver"
                          @ondragover:preventDefault="OnItemDrop.HasDelegate"
                          @ondrop="() => HandleItemDropAsync(item)">
                        <FormaButton Variant="ButtonVariant.Ghost"
                                     class="@(item.IsCurrent ? "forma-breadcrumb-item is-current" : "forma-breadcrumb-item")"
                                     aria-current="@(item.IsCurrent ? "page" : null)"
                                     OnClick="() => HandleItemClickAsync(item)">
                            @item.Label
                        </FormaButton>
                    </span>
                }
                else
                {
                    <span class="forma-breadcrumb-item @(item.IsCurrent ? "is-current" : "")"
                          aria-current="@(item.IsCurrent ? "page" : null)">
                        @item.Label
                    </span>
                }

                @if (item.Children is { Count: > 0 } children)
                {
                    <FormaDropDownMenu class="forma-breadcrumb-chevron"
                                       TriggerOptions="ButtonOptions.MiniGhostIcon"
                                       aria-label="@L["Show options for {Label}", item.Label]">
                        <Trigger>
                            <FormaIcon Icon="Glyph.ChevronRight" />
                        </Trigger>
                        <ChildContent>
                            @foreach (var child in children)
                            {
                                <FormaDropDownMenuItem OnClick="() => HandleItemClickAsync(child)">@child.Label</FormaDropDownMenuItem>
                            }
                        </ChildContent>
                    </FormaDropDownMenu>
                }
                else if (!isLast)
                {
                    <span class="forma-breadcrumb-separator" aria-hidden="true"><FormaIcon Icon="Glyph.ChevronRight" /></span>
                }
            </li>
        }
    </ol>
</nav>
