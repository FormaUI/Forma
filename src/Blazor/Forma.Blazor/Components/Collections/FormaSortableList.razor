@typeparam TItem
@namespace Forma.Blazor.Components.Collections
@inherits FormaElementBase
<div class="forma-sortable-list-container">
    @* Safari drops list semantics from a list whose markers are removed, so role="list" restates them. *@
    <ul id="@Id"
        data-rid="@Context.RuntimeId"
        class="@RootClass"
        style="@RootStyle"
        @attributes="AdditionalAttributes"
        @ref="RootElement"
        role="list">
        @for (var i = 0; i < Items.Count; i++)
        {
            var item = Items[i];
            var index = i;
            var key = ItemKey(item);
            <li class="forma-sortable-list-item" @key="key">
                <FormaButton @ref="_handles[key]"
                             Variant="ButtonVariant.Ghost"
                             Size="ButtonSize.Mini"
                             IconOnly="true"
                             class="forma-sortable-list-handle"
                             Disabled="@(Disabled || !RendererInfo.IsInteractive)"
                             aria-label="@HandleLabel(index)">
                    <FormaIcon Icon="Glyph.DragHandle" />
                </FormaButton>
                <div class="forma-sortable-list-content">
                    @ItemTemplate(item)
                </div>
            </li>
        }
    </ul>
    <div class="forma-sortable-list-announcement" aria-live="polite">@_announcement</div>
</div>
