@namespace Forma.Blazor.Components.Files
@inherits FormaElementBase

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    <FormaFilePicker @ref="FilePicker"
                     Options="@(Options with { Accept = ImageAccept })"
                     Prompt="@EffectivePrompt"
                     OnFilesRejected="HandleFilesRejectedAsync"
                     OnFilesSelected="HandleFilesSelectedAsync" />

    @if (_previewFileNames.Count > 0)
    {
        <ul class="forma-image-picker-previews">
            @foreach (var name in _previewFileNames)
            {
                <li class="forma-image-picker-preview">
                    <span class="forma-image-picker-frame" aria-hidden="true">
                        <FormaIcon Icon="Glyph.Image" Size="IconSize.Display" />
                        <img data-forma-preview alt="" class="forma-image-picker-thumbnail" />
                    </span>
                    <span class="forma-image-picker-name">@name</span>
                </li>
            }
        </ul>
    }
</div>
