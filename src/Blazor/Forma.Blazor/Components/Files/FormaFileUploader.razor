@namespace Forma.Blazor.Components.Files
@inherits FormaElementBase
@using Forma.Blazor.Components.Buttons

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement"
     aria-busy="@(IsUploading ? "true" : "false")">
    <ul class="forma-file-uploader-list">
        @foreach (var upload in _batch.Files)
        {
            <li class="forma-file-uploader-item forma-file-uploader-@upload.State.ToString().ToLowerInvariant()">
                <span class="forma-file-uploader-mark" aria-hidden="true"><FormaIcon Icon="GetStateGlyph(upload.State)" Size="IconSize.Small" /></span>

                <span class="forma-file-uploader-name">
                    @upload.Name
                    @if (Options.ShowByteCount)
                    {
                        <span class="forma-file-uploader-size"><bdi>(@FormatFileByteCount(upload))</bdi></span>
                    }
                </span>

                @if (Options.ShowTransferRate)
                {
                    <span class="forma-file-uploader-rate"><bdi>@FormatFileRate(upload)</bdi></span>
                }

                <progress class="forma-file-uploader-bar" max="100" value="@upload.ProgressPercentage" aria-label="@upload.Name"></progress>

                @if (ShowsDuration)
                {
                    <span class="forma-file-uploader-time"><bdi>@FormatFileTime(upload)</bdi></span>
                }

                <span class="forma-file-uploader-state">@GetStateText(upload.State)</span>

                @if (upload.Refusal is { } refusal)
                {
                    <span class="forma-file-uploader-reason">@GetRefusalText(upload.Name, refusal)</span>
                }
            </li>
        }
    </ul>

    @if (Options.ShowTotalMetrics && ShowsMetrics && _batch.Count > 1)
    {
        <p class="forma-file-uploader-totals">
            <span class="forma-file-uploader-mark" aria-hidden="true"></span>

            <span class="forma-file-uploader-name">
                <span class="forma-file-uploader-totals-label">@L["All Files"]</span>
                @if (Options.ShowByteCount)
                {
                    <span class="forma-file-uploader-size"><bdi>(@TotalByteCount)</bdi></span>
                }
            </span>

            @if (Options.ShowTransferRate)
            {
                <span class="forma-file-uploader-rate"><bdi>@TotalRate</bdi></span>
            }

            <span class="forma-file-uploader-bar-spacer" aria-hidden="true"></span>

            @if (ShowsDuration)
            {
                <span class="forma-file-uploader-time"><bdi>@TotalTime</bdi></span>
            }

            <span class="forma-file-uploader-state" aria-hidden="true"></span>
        </p>
    }

    @if (Options.ShowSummary)
    {
        <p class="forma-file-uploader-summary" role="status">@Summary</p>
    }

    <div class="forma-file-uploader-actions">
        @if (IsUploading)
        {
            <FormaButton Variant="ButtonVariant.Secondary" OnClick="@(_ => Cancel())">@L["Cancel"]</FormaButton>
        }
        else if (CanStart)
        {
            <FormaButton Variant="ButtonVariant.Primary" OnClick="@(_ => StartAsync())">@L["Upload"]</FormaButton>
        }
    </div>
</div>
