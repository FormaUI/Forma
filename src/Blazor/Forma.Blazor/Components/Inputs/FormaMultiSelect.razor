@typeparam TValue
@namespace Forma.Blazor.Components.Inputs
@using Forma.Framework.Browser.Interop.Behaviors
@inherits FormaInputBase<List<TValue>>

<FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" ElementIds="FieldElementIds" Description="@Description" Required="@Required" LabelMode="FieldLabelMode.Pinned">
    <ChildContent>
        @if (!RendererInfo.IsInteractive && IsPostable)
        {
            @* A statically rendered page chooses in the browser's own list, each chosen option posting its value in the invariant form the server binds, a value added beyond the options among them. *@
            <select id="@ElementId"
                    data-rid="@Context.RuntimeId"
                    class="@RootClass"
                    style="@RootStyle"
                    @attributes="AdditionalAttributes"
                    @ref="RootElement"
                    aria-describedby="@DescribedBy"
                    name="@ControlName"
                    multiple
                    disabled="@Disabled"
                    required="@Required">
                @foreach (var option in Options)
                {
                    <option value="@FormValue.Format(option.Value)" selected="@IsSelected(option)">@option.Label</option>
                }
                @foreach (var value in SelectedValues.Where(selected => FindOption(selected) is null))
                {
                    <option value="@FormValue.Format(value)" selected>@value</option>
                }
            </select>
        }
        else
        {
            <div class="forma-multi-select">
                <div class="forma-multi-select-trigger-wrapper" @ref="_anchorElement">
                    <button id="@ElementId"
                            data-rid="@Context.RuntimeId"
                            class="@RootClass"
                            style="@RootStyle"
                            @attributes="AdditionalAttributes"
                            @ref="RootElement"
                            aria-describedby="@DescribedBy"
                            type="button"
                            disabled="@IsTriggerDisabled"
                            aria-haspopup="dialog"
                            aria-expanded="@(IsOpen ? "true" : "false")"
                            aria-controls="@(IsOpen ? PopoverId : null)"
                            aria-required="@(Required ? "true" : null)"
                            @onclick="ToggleAsync">
                        <span class="forma-multi-select-trigger-text@(SelectedValues.Count == 0 ? " placeholder" : "")">@TriggerText</span>
                        <span class="forma-multi-select-arrow" aria-hidden="true">&#9662;</span>
                    </button>
                </div>
                <FormaPopover @ref="Popover" Alignment="PopoverAlignment.Start"
                            Anchor="_anchorElement"
                            OnOpenChanged="_ => { }"
                            OnOpened="FocusSearchAsync">
                    <div class="forma-multi-select-popover"
                         id="@PopoverId"
                         role="dialog"
                         aria-label="@Label">
                        <FormaSearchBox @ref="SearchBox"
                                        Class="forma-multi-select-search"
                                        Value="@_searchText"
                                        ValueChanged="value => _searchText = value"
                                        Options="SearchOptions"
                                        aria-label="@L["Search"]" />
                        @{ var filteredOptions = FilteredOptions; }
                        <div class="forma-multi-select-options">
                            @foreach (var option in filteredOptions)
                            {
                                <FormaCheckBox Value="@IsSelected(option)"
                                               ValueChanged="_ => ToggleOption(option)"
                                               ValueExpression="() => OptionSelection">
                                    <span>@option.Label</span>
                                </FormaCheckBox>
                            }
                            @if (filteredOptions.Count == 0)
                            {
                                <div class="forma-multi-select-empty">@(Options.Count == 0 ? L["No options available yet"] : L["No matches"])</div>
                            }
                        </div>
                        @if (CanAddSearchText)
                        {
                            <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" class="forma-multi-select-add" OnClick="HandleAddNewAsync">
                                <FormaIcon Icon="Glyph.Plus" />
                                @L["Add New"]
                            </FormaButton>
                        }
                    </div>
                </FormaPopover>
                @* The tags sit below the box, so the floating label sits over the trigger. *@
                @if (SelectedValues.Count > 0)
                {
                    <div class="forma-multi-select-tags">
                        @foreach (var value in SelectedValues)
                        {
                            var text = FindOption(value)?.Label ?? value.ToString() ?? string.Empty;
                            <span class="forma-multi-select-tag">
                                @text
                                <FormaButton Variant="ButtonVariant.Ghost"
                                             Size="ButtonSize.Mini"
                                             IconOnly="true"
                                             class="forma-multi-select-tag-remove"
                                             Disabled="@Disabled"
                                             aria-label="@L["Remove {Text}", text]"
                                             OnClick="() => RemoveValue(value)">
                                    <FormaIcon Icon="Glyph.Cross" />
                                </FormaButton>
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </ChildContent>
</FormaField>
