@namespace Forma.Blazor.Components.Inputs
@typeparam TValue
@inherits FormaInputBase<TValue>

@{
    // A statically rendered page edits the number in the browser's own input, which shows it in the reader's culture and posts it in
    // the invariant form the server binds.
    RenderFragment postedInput =
        @<input id="@ElementId"
                data-rid="@Context.RuntimeId"
                class="@RootClass"
                style="@RootStyle"
                @attributes="AdditionalAttributes"
                @ref="RootElement"
                aria-describedby="@DescribedBy"
                type="number"
                dir="ltr"
                name="@ControlName"
                placeholder="@EffectivePlaceholder"
                value="@FormValue.Format(CurrentValue)"
                min="@FormatLimit(Min)"
                max="@FormatLimit(Max)"
                step="@PostedStep"
                disabled="@Disabled"
                readonly="@ReadOnly"
                required="@IsRequired" />;

    RenderFragment number = !RendererInfo.IsInteractive ? postedInput :
        @<input id="@ElementId"
                data-rid="@Context.RuntimeId"
                class="@RootClass"
                style="@RootStyle"
                @attributes="AdditionalAttributes"
                @ref="RootElement"
                aria-describedby="@DescribedBy"
                type="text"
                dir="ltr"
                role="spinbutton"
                inputmode="@InputModeValue"
                placeholder="@EffectivePlaceholder"
                value="@ShownText"
                disabled="@Disabled"
                readonly="@ReadOnly"
                aria-required="@(IsRequired ? "true" : null)"
                aria-valuenow="@ValueNow"
                aria-valuetext="@ValueText"
                aria-valuemin="@FormatLimit(Min)"
                aria-valuemax="@FormatLimit(Max)" />;

    // The adornment stands in the number's box, outside the text the reader edits.
    RenderFragment box =
        @<text>
            @if (Adornment is { } adornment)
            {
                <span class="forma-number-input-box">
                    @number
                    <span class="@AdornmentClass" aria-hidden="true">@adornment.Text</span>
                    @if (adornment.Description is { } description)
                    {
                        <span id="@AdornmentDescriptionId" hidden>@description</span>
                    }
                </span>
            }
            else
            {
                @number
            }
        </text>;
}

@if (HasLabel)
{
    <FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" ElementIds="FieldElementIds" Required="@IsRequired" LabelMode="LabelMode" style="@FieldStyle">
        <ChildContent>
            @box
        </ChildContent>
    </FormaField>
}
else
{
    @box
}
