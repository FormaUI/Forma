@typeparam TValue
@namespace Forma.Blazor.Components.Inputs
@using Forma.Framework.Browser
@inherits FormaInputBase<TValue>

<FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" ElementIds="FieldElementIds" Description="@Description" Required="@Required" LabelMode="FieldLabelMode.Pinned">
    <ChildContent>
        @if (IsNative)
        {
            @* A statically rendered page chooses in the browser's own list, each option posting its value in the invariant form the server binds. *@
            var chosenOption = FindSelectedOption();
            <select id="@ElementId"
                    data-rid="@Context.RuntimeId"
                    class="@RootClass"
                    style="@RootStyle"
                    @attributes="AdditionalAttributes"
                    @ref="RootElement"
                    aria-describedby="@DescribedBy"
                    name="@ControlName"
                    disabled="@Disabled"
                    required="@Required">
                @if (chosenOption is null)
                {
                    <option value="" selected>@TriggerText</option>
                }
                @foreach (var option in Options)
                {
                    <option value="@FormValue.Format(option.Value)" selected="@(ReferenceEquals(option, chosenOption))" disabled="@(option.IsDisabled && !ReferenceEquals(option, chosenOption))">@FormatNativeOptionText(option)</option>
                }
            </select>
        }
        else
        {
            <div class="forma-select-trigger-wrapper" @ref="_anchorElement">
                <button id="@ElementId"
                        data-rid="@Context.RuntimeId"
                        class="@RootClass"
                        style="@RootStyle"
                        @attributes="AdditionalAttributes"
                        @ref="RootElement"
                        aria-describedby="@DescribedBy"
                        type="button"
                        disabled="@(IsTriggerDisabled && !ShowsDisabledReason)"
                        aria-disabled="@AriaDisabled"
                        aria-haspopup="listbox"
                        aria-expanded="@(IsOpen ? "true" : "false")"
                        aria-controls="@(IsOpen ? PopoverId : null)"
                        aria-required="@(Required ? "true" : null)"
                        @onclick="ToggleAsync">
                    @{ var selectedOption = FindSelectedOption(); }
                    @if (selectedOption?.Icon is { } selectedIcon)
                    {
                        <FormaIcon Icon="selectedIcon" Size="IconSize.Small" />
                    }
                    <span class="forma-select-trigger-text@(selectedOption is null ? " placeholder" : "")">@TriggerText</span>
                    @if (selectedOption?.IconLabel is { } selectedIconLabel)
                    {
                        <span id="@SelectedIconLabelId" hidden>@selectedIconLabel</span>
                    }
                    <span class="forma-select-arrow" aria-hidden="true">&#9662;</span>
                </button>
            </div>
            <FormaPopover @ref="Popover" Alignment="PopoverAlignment.Start"
                        Anchor="_anchorElement"
                        OnOpenChanged="_ => { }"
                        OnOpened="HandleOpenedAsync"
                        InputRoutes="ListRoutes"
                        OnInputAction="HandleListActionAsync">
                <div class="forma-select-popover"
                     id="@PopoverId"
                     role="listbox"
                     aria-label="@Label">
                    @for (var i = 0; i < Options.Count; i++)
                    {
                        var optionIndex = i;
                        var option = Options[optionIndex];
                        var isSelected = IsSelected(option);
                        <button type="button"
                                class="@GetOptionClass(option, isSelected)"
                                role="option"
                                tabindex="-1"
                                aria-selected="@(isSelected ? "true" : "false")"
                                aria-disabled="@(option.IsDisabled ? "true" : null)"
                                aria-describedby="@GetOptionDescribedBy(option, optionIndex)"
                                @ref="_optionElements[optionIndex]"
                                @onclick="() => SelectAsync(option)">
                            @if (option.Icon is { } icon)
                            {
                                <FormaIcon Icon="icon" Size="IconSize.Small" />
                            }
                            <span class="forma-select-option-label">@option.Label</span>
                            @if (option.IconLabel is { } iconLabel)
                            {
                                <span id="@GetOptionIconLabelId(optionIndex)" hidden>@iconLabel</span>
                            }
                            @if (isSelected)
                            {
                                <span class="forma-select-option-check" aria-hidden="true">&#10003;</span>
                            }
                        </button>
                    }
                    @if (Options.Count == 0)
                    {
                        <div class="forma-select-empty">@L["No options available yet"]</div>
                    }
                </div>
                @for (var i = 0; i < Options.Count; i++)
                {
                    if (Options[i].ShowsDisabledReason)
                    {
                        <FormaTooltip Id="@GetOptionReasonId(i)" Text="@(Options[i].DisabledReason!)" />
                    }
                }
            </FormaPopover>
        }
        @DisabledReasonTooltip
    </ChildContent>
</FormaField>
