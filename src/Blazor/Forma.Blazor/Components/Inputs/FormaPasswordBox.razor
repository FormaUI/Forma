@namespace Forma.Blazor.Components.Inputs
@inherits FormaInputBase<string?>

<FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" ElementIds="FieldElementIds" Description="@Description" Required="@Required">
    <ChildContent>
        <input id="@ElementId"
               data-rid="@Context.RuntimeId"
               class="@RootClass"
               style="@RootStyle"
               @attributes="AdditionalAttributes"
               @ref="RootElement"
               name="@ControlName"
               type="@(_isRevealed ? "text" : "password")"
               placeholder=" "
               autocomplete="@AutoComplete"
               dir="ltr"
               value="@ShownText"
               aria-required="@(Required ? "true" : null)"
               aria-describedby="@DescribedBy" />
        @if (ShowToggle)
        {
            @* The wrapper carries the toggle's positioning. *@
            <span class="forma-password-box-toggle">
                <FormaEyeButton Label="@(_isRevealed ? L["Hide Password"] : L["Show Password"])"
                                Revealed="_isRevealed"
                                OnClick="ToggleReveal"
                                aria-pressed="@(_isRevealed ? "true" : "false")" />
            </span>
        }
    </ChildContent>
    <FooterContent>
        @if (Strength is { } strength)
        {
            <div class="forma-password-box-strength @GetStrengthModifier(strength)">
                @* Decorative; the text beside it carries the rating. *@
                <span class="forma-password-box-strength-track" aria-hidden="true">
                    @for (var segment = 0; segment < SegmentCount; segment++)
                    {
                        <span class="forma-password-box-strength-segment@(segment <= (int)strength ? " filled" : "")"></span>
                    }
                </span>
                <span class="forma-password-box-strength-text" role="status">@GetStrengthText(strength)</span>
            </div>
        }
        @if (_advice.Count > 0)
        {
            <ul class="forma-password-box-advice" id="@AdviceId">
                @foreach (var item in _advice)
                {
                    <li>@item</li>
                }
            </ul>
        }
    </FooterContent>
</FormaField>
