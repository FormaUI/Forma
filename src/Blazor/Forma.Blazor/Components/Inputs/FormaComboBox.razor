@namespace Forma.Blazor.Components.Inputs
@typeparam TValue
@using Forma.Blazor.Components.Feedback
@using Forma.Blazor.Components.Virtualization
@using Forma.Framework.Browser
@inherits FormaInputBase<TValue>

<FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" ElementIds="FieldElementIds" Description="@Description" Required="@Required" LabelMode="FieldLabelMode.Pinned">
    <ChildContent>
        @if (IsNative)
        {
            @* A statically rendered page chooses in the browser's own list, each option posting its value in the invariant form the server
               binds, a value no option holds among them; a read-only one lists the value chosen alone, so it still posts it. *@
            var chosenOption = FindCommittedOption();
            <select id="@ElementId"
                    data-rid="@Context.RuntimeId"
                    class="@RootClass"
                    style="@RootStyle"
                    @attributes="AdditionalAttributes"
                    aria-describedby="@DescribedBy"
                    aria-readonly="@(ReadOnly ? "true" : null)"
                    name="@ControlName"
                    disabled="@Disabled"
                    required="@Required">
                @if (IsValueUnnamed)
                {
                    <option value="@FormValue.Format(Value)" selected>@CommittedText</option>
                }
                else if (chosenOption is null)
                {
                    <option value="" selected>@(Placeholder ?? string.Empty)</option>
                }
                @foreach (var option in NativeOptions)
                {
                    var isChosen = ReferenceEquals(option, chosenOption);
                    <option value="@FormValue.Format(option.Value)" selected="@isChosen" disabled="@(option.IsDisabled && !isChosen)">@FormatNativeOptionText(option)</option>
                }
            </select>
        }
        else
        {
            <div class="forma-combo-box" @ref="_anchorElement">
                <input id="@ElementId"
                       data-rid="@Context.RuntimeId"
                       class="@RootClass"
                       style="@RootStyle"
                       @attributes="AdditionalAttributes"
                       @ref="RootElement"
                       type="text"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-expanded="@(IsOpen ? "true" : "false")"
                       aria-controls="@(IsOpen ? ListId : null)"
                       aria-activedescendant="@ActiveEntryId"
                       aria-required="@(Required ? "true" : null)"
                       aria-busy="@(_isAdding ? "true" : null)"
                       aria-describedby="@DescribedBy"
                       autocomplete="off"
                       placeholder="@Placeholder"
                       value="@ShownText"
                       disabled="@(IsFieldDisabled && !ShowsDisabledReason)"
                       readonly="@(ReadOnly || ShowsDisabledReason)"
                       aria-disabled="@AriaDisabled" />
                @if (CommittedOption?.IconLabel is { } committedIconLabel && !_isEdited)
                {
                    <span id="@CommittedIconLabelId" hidden>@committedIconLabel</span>
                }
                @* The button opens the list without taking the focus, which stays in the field the keys move the list from. *@
                <span class="forma-combo-box-toggle" @onpointerdown:preventDefault @onmousedown:preventDefault>
                    <FormaButton Variant="ButtonVariant.Ghost"
                                 Size="ButtonSize.Mini"
                                 IconOnly="true"
                                 tabindex="-1"
                                 aria-label="@L["Show Options"]"
                                 Disabled="@(IsFieldDisabled || ReadOnly)"
                                 OnClick="ToggleAsync">
                        <FormaIcon Icon="Glyph.ChevronDown" Size="IconSize.Small" />
                    </FormaButton>
                </span>
                <FormaPopover @ref="Popover" Anchor="_anchorElement" Alignment="PopoverAlignment.Start" OnOpenChanged="HandleOpenChanged">
                    @* A press on the list keeps the focus in the field, so choosing an option never takes it away. *@
                    <div id="@ListId" class="forma-combo-box-list" role="listbox" aria-label="@Label" @onpointerdown:preventDefault @onmousedown:preventDefault>
                        @if (Entries.Count == 0)
                        {
                            <div class="forma-combo-box-empty">@L["No matches"]</div>
                        }
                        else
                        {
                            <FormaVirtualize TItem="ListEntry" @ref="Virtualizer" Items="Entries" ItemKey="@(entry => entry.Key)" ItemSize="40" PinnedKeys="PinnedKeys" InitialItemIndex="@Math.Max(_activeIndex, 0)">
                                <ItemContent Context="entry">
                                    <div id="@GetEntryId(entry.Index)"
                                         class="@GetEntryClass(entry)"
                                         role="option"
                                         aria-setsize="@Entries.Count"
                                         aria-posinset="@(entry.Index + 1)"
                                         aria-selected="@(entry.Index == _activeIndex ? "true" : "false")"
                                         aria-disabled="@(entry.Option is { IsDisabled: true } || (entry.AddsText is not null && _isAdding) ? "true" : null)"
                                         aria-describedby="@GetEntryDescribedBy(entry)"
                                         @onclick="() => TakeEntryAsync(entry)">
                                        @if (entry.Option is { } option)
                                        {
                                            @if (option.Icon is { } icon)
                                            {
                                                <FormaIcon Icon="icon" Size="IconSize.Small" />
                                            }
                                            <span class="forma-combo-box-option-label">@option.Label</span>
                                            @if (option.IconLabel is { } iconLabel)
                                            {
                                                <span id="@GetEntryIconLabelId(entry.Index)" hidden>@iconLabel</span>
                                            }
                                            @if (IsCommitted(option))
                                            {
                                                <FormaIcon Icon="Glyph.Check" Size="IconSize.Small" Class="forma-combo-box-option-check" />
                                            }
                                        }
                                        else
                                        {
                                            <FormaIcon Icon="Glyph.Plus" Size="IconSize.Small" />
                                            <span class="forma-combo-box-option-label">@L["Add \"{Text}\"", entry.AddsText!]</span>
                                        }
                                    </div>
                                </ItemContent>
                            </FormaVirtualize>
                        }
                    </div>
                    @foreach (var entry in Entries)
                    {
                        if (entry.Option is { ShowsDisabledReason: true } option)
                        {
                            <FormaTooltip Id="@GetEntryReasonId(entry.Index)" Text="@(option.DisabledReason!)" />
                        }
                    }
                </FormaPopover>
                <div class="forma-combo-box-status" role="status">@_announcement</div>
            </div>
        }
        @DisabledReasonTooltip
    </ChildContent>
</FormaField>
