@namespace Forma.Blazor.Components.Inputs
@typeparam TValue where TValue : struct, System.Numerics.INumber<TValue>
@inherits FormaInputBase<TValue>

<FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" ElementIds="FieldElementIds" LabelMode="FieldLabelMode.Above">
    <ChildContent>
        @* The reading sits on the label's row. *@
        <span class="forma-slider-value" aria-hidden="true"><bdi dir="ltr">@DisplayValue</bdi></span>
        <input id="@ElementId"
               data-rid="@Context.RuntimeId"
               class="@RootClass"
               style="@RootStyle"
               @attributes="AdditionalAttributes"
               @ref="RootElement"
               aria-describedby="@DescribedBy"
               type="range"
               min="@FormatInvariant(Min)"
               max="@FormatInvariant(Max)"
               step="@FormatInvariant(Step)"
               @bind="CurrentValueAsString"
               @bind:event="oninput"
               disabled="@Disabled"
               aria-valuetext="@AriaValueText" />
    </ChildContent>
</FormaField>
