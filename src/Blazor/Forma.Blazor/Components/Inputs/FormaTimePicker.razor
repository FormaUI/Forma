@namespace Forma.Blazor.Components.Inputs
@typeparam TValue
@inherits FormaInputBase<TValue>

<FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" ElementIds="FieldElementIds" Required="@IsRequired" LabelMode="FieldLabelMode.Pinned">
    <ChildContent>
        <FormaTimeBox @ref="Box"
                      ElementId="@ElementId"
                      OwnerRuntimeId="@Context.RuntimeId"
                      Text="@(_draft.Text ?? CurrentValueAsString)"
                      Time="@Time"
                      Suggestions="_suggestions"
                      FormatTime="FormatTime"
                      ListLabel="@Label"
                      OnInput="Draft"
                      OnChange="HandleChange"
                      OnChoose="HandleChoose"
                      OnTextFaultChanged="HandleTextFaultChanged"
                      Required="@IsRequired"
                      Disabled="@Disabled"
                      ReadOnly="@ReadOnly"
                      InputClass="@RootClass"
                      InputStyle="@RootStyle"
                      InputAttributes="AdditionalAttributes"
                      InputDescribedBy="@DescribedBy" />
    </ChildContent>
</FormaField>
