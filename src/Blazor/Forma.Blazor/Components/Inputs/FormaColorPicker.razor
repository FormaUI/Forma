@namespace Forma.Blazor.Components.Inputs
@inherits FormaInputBase<string>

<FormaField Label="@Label" TargetId="@ElementId" Field="@FieldIdentifier" ElementIds="FieldElementIds" LabelMode="FieldLabelMode.Pinned">
    <ChildContent>
        <div class="forma-color-picker">
            <input id="@ElementId"
                   data-rid="@Context.RuntimeId"
                   class="@RootClass"
                   style="@RootStyle"
                   @attributes="AdditionalAttributes"
                   @ref="RootElement"
                   name="@ControlName"
                   aria-describedby="@DescribedBy"
                   type="text"
                   value="@ShownText"
                   maxlength="@MaxLength"
                   placeholder="@(ShowAlpha ? "#RRGGBBAA" : "#RRGGBB")"
                   spellcheck="false"
                   dir="ltr" />
            @* The wrapper places the swatch and the native color input over the field box. *@
            <span class="forma-color-picker-swatch-wrapper">
                <input type="color"
                       class="forma-color-picker-native"
                       aria-label="@L["Choose Color"]"
                       @bind:get="RgbHex"
                       @bind:set="HandleNativeInput"
                       @bind:event="oninput" />
                <span class="forma-color-picker-swatch" style="background-color: @CurrentValueAsString" aria-hidden="true"></span>
            </span>
            @if (ShowAlpha)
            {
                <div class="forma-color-picker-alpha-row">
                    <label for="@(ElementId)-alpha">@L["Alpha"]</label>
                    <input id="@(ElementId)-alpha"
                           type="range"
                           class="forma-color-picker-alpha"
                           min="0" max="100" step="1"
                           @bind:get="AlphaPercent"
                           @bind:set="HandleAlphaInput"
                           @bind:event="oninput"
                           @bind:culture="System.Globalization.CultureInfo.InvariantCulture" />
                    <span class="forma-color-picker-alpha-value">@AlphaPercent%</span>
                </div>
            }
        </div>
    </ChildContent>
</FormaField>
