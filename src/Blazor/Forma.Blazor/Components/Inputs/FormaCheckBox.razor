@namespace Forma.Blazor.Components.Inputs
@inherits FormaInputBase<bool>

@{
    RenderFragment input = @<input id="@Id"
                                   data-rid="@Context.RuntimeId"
                                   class="@RootClass"
                                   style="@RootStyle"
                                   @attributes="AdditionalAttributes"
                                   @ref="RootElement"
                                   name="@ControlName"
                                   type="checkbox"
                                   value="true"
                                   checked="@CurrentValue"
                                   disabled="@HasDisabledAttribute"
                                   aria-disabled="@AriaDisabled"
                                   aria-describedby="@DescribedBy"
                                   @onchange="HandleChange"
                                   @onclick="HandleClickAsync"
                                   @onclick:preventDefault="@(PreventDefault || ShowsDisabledReason)" />;
}

@if (ChildContent is null)
{
    @input
}
else
{
    <label class="forma-checkbox-label">
        @input
        @ChildContent
    </label>
}
@DisabledReasonTooltip
@if (HasDescription)
{
    <div id="@FieldElementIds.DescriptionId" class="forma-checkbox-description">@Description</div>
}
