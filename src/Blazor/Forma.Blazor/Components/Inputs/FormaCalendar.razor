@namespace Forma.Blazor.Components.Inputs
@inherits FormaComponentBase
@using Forma.Blazor.Components.Buttons

<div class="forma-calendar">
    @for (var i = 0; i < MonthCount; i++)
    {
        var panel = i;
        var month = GetPanelMonth(panel);
        <div class="forma-calendar-month" dir="@TextDirection">
            <div class="forma-calendar-month-header">
                <FormaButton Variant="ButtonVariant.Ghost"
                             class="forma-calendar-nav"
                             aria-label="@L["Previous Month"]"
                             Disabled="!CanPanelGoPrev(panel)"
                             OnClick="() => ShowPreviousPanel(panel)">
                    &#10094;
                </FormaButton>
                <div class="forma-calendar-month-selectors">
                    <select class="forma-calendar-select"
                            value="@month.Year"
                            @onchange="args => OnYearDropdownChange(panel, args)">
                        @for (var candidate = _calendarMonthRange.MinYear; candidate <= _calendarMonthRange.MaxYear; candidate++)
                        {
                            var year = candidate;
                            <option value="@year" disabled="@IsYearDisabled(year, panel)">@year</option>
                        }
                    </select>
                    <select class="forma-calendar-select"
                            value="@_calendarMonthRange.GetMonth(month)"
                            @onchange="args => OnMonthDropdownChange(panel, args)">
                        @for (var candidate = 1; candidate <= _calendarMonthRange.GetMonthsInYear(_calendarMonthRange.GetYear(month)); candidate++)
                        {
                            var monthNumber = candidate;
                            <option value="@monthNumber" disabled="@IsMonthDisabled(_calendarMonthRange.GetYear(month), monthNumber, panel)">@_calendarMonthRange.GetMonthName(_calendarMonthRange.GetYear(month), monthNumber)</option>
                        }
                    </select>
                </div>
                <FormaButton Variant="ButtonVariant.Ghost"
                             class="forma-calendar-nav"
                             aria-label="@L["Next Month"]"
                             Disabled="!CanPanelGoNext(panel)"
                             OnClick="() => ShowNextPanel(panel)">
                    &#10095;
                </FormaButton>
            </div>
            <div class="forma-calendar-weekdays">
                @for (var offset = 0; offset < 7; offset++)
                {
                    <span>@_calendarMonthRange.GetDayAbbreviation(offset)</span>
                }
            </div>
            <div class="forma-calendar-days">
                @foreach (var day in _calendarMonthRange.GetDayCells(month))
                {
                    @if (day is null)
                    {
                        <span class="forma-calendar-day empty"></span>
                    }
                    else
                    {
                        var date = day.Value;
                        var dayClasses = GetDayClasses(date);
                        <button type="button"
                                class="forma-calendar-day@(dayClasses)"
                                disabled="@(IsDayDisabled(date) || !RendererInfo.IsInteractive)"
                                aria-label="@_calendarMonthRange.GetDayLabel(date)"
                                aria-current="@(IsToday(dayClasses) ? "date" : null)"
                                aria-pressed="@(IsSelected(dayClasses) ? "true" : null)"
                                @onclick="() => SelectDayAsync(date)"
                                @onmouseenter="GetHoverHandler(date)">
                            @_calendarMonthRange.GetDayOfMonth(date)
                        </button>
                    }
                }
            </div>
        </div>
    }
</div>
