@namespace Forma.Blazor.Components.Symbols
@inherits FormaElementBase
@using Forma.Blazor.Components.Feedback
@using Forma.Blazor.Components.Interaction

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    @if (Options.ShowGroupTabs)
    {
        <FormaInputScope Class="forma-emoji-picker-tabs" role="tablist" aria-label="@L["Emoji Categories"]" aria-orientation="horizontal" Profile="TabsProfile" OnAction="HandleTabsActionAsync">
            @foreach (var tab in Tabs)
            {
                var isActive = !IsSearching && tab.Id == ActiveGroupId;

                <button @key="tab.Id"
                        type="button"
                        role="tab"
                        id="@GetTabElementId(tab.Id)"
                        class="forma-emoji-picker-tab"
                        title="@FormatGroupTitle(tab)"
                        aria-label="@FormatGroupTitle(tab)"
                        aria-selected="@isActive.ToString().ToLowerInvariant()"
                        aria-controls="@PanelElementId"
                        disabled="@(!RendererInfo.IsInteractive)"
                        tabindex="@(isActive ? "0" : "-1")"
                        @ref="_tabButtons[tab.Id]"
                        @onclick="() => SelectGroupAsync(tab.Id)">
                    <FormaIcon Icon="GetTabIcon(tab.Id)" Size="IconSize.Small" />
                </button>
            }
        </FormaInputScope>
    }

    @if (Options.ShowSearch)
    {
        <div class="forma-emoji-picker-search">
            <FormaSearchBox Value="@_searchQuery" ValueChanged="OnQueryChangedAsync" Options="SearchOptions" />
        </div>
    }

    <div class="forma-emoji-picker-panel"
         id="@PanelElementId"
         @ref="_panelElement"
         role="tabpanel"
         aria-labelledby="@(IsSearching || !Options.ShowGroupTabs ? null : GetTabElementId(ActiveGroupId))">

        @if (MatchingEmojis.Count == 0)
        {
            <p class="forma-emoji-picker-empty">@L["No emoji match \"{Query}\".", _searchQuery]</p>
        }
        else if (RenderedEmojis.Count == 0)
        {
            <h3 class="forma-emoji-picker-heading">@HeadingText</h3>
            <div class="forma-emoji-picker-loading">
                <FormaSpinner Label="@L["Loading {Category}", HeadingText]" Size="SpinnerSize.Large" />
            </div>
        }
        else
        {
            <h3 class="forma-emoji-picker-heading">@HeadingText</h3>
            <div class="forma-emoji-picker-grid" role="group" aria-label="@HeadingText">
                @foreach (var info in RenderedEmojis)
                {
                    <button @key="info.Emoji.Sequence"
                            type="button"
                            class="forma-emoji-picker-emoji"
                            title="@info.Name"
                            aria-label="@info.Name"
                            disabled="@(!RendererInfo.IsInteractive)"
                            @onclick="() => SelectAsync(info)">
                            <FormaEmoji Emoji="info.Emoji" />
                    </button>
                }
            </div>

            @if (HasMoreToLoad)
            {
                <div class="forma-emoji-picker-sentinel" @ref="_sentinelElement">
                    <FormaSpinner Label="@L["Loading More Emoji"]" Size="SpinnerSize.Small" />
                </div>
            }
        }
    </div>

    <div class="forma-emoji-picker-announcer" role="status">@_announcement</div>
</div>
