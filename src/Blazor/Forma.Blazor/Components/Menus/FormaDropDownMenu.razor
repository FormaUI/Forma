@namespace Forma.Blazor.Components.Menus
@inherits FormaElementBase
<CascadingValue Value="this" IsFixed="true">
    <span class="@(IsOpen ? "forma-dropdown-menu-anchor forma-dropdown-menu-anchor-open" : "forma-dropdown-menu-anchor")" @ref="_anchorElement">
        <FormaButton @ref="TriggerButton"
                     Id="@Id"
                     Class="@RootClass"
                     Style="@RootStyle"
                     @attributes="AdditionalAttributes"
                     Variant="TriggerOptions.Variant"
                     Size="TriggerOptions.Size"
                     IconOnly="TriggerOptions.IconOnly"
                     aria-haspopup="menu"
                     aria-expanded="@AriaExpanded"
                     aria-controls="@AriaControls"
                     OnClick="ToggleAsync">
            @Trigger
        </FormaButton>
    </span>

    <FormaPopover @ref="Popover"
                Anchor="_anchorElement"
                KeepsFocus="true"
                Alignment="Alignment"
                OnOpenChanged="_ => { }"
                OnOpened="HandleOpenedAsync"
                InputRoutes="MenuRoutes"
                OnInputAction="HandleMenuActionAsync">
        <div class="forma-dropdown-menu" id="@PopoverId" role="menu">
            @if (HeaderContent is not null)
            {
                <div class="forma-dropdown-menu-header">@HeaderContent</div>
            }
            @ChildContent
        </div>
    </FormaPopover>
</CascadingValue>
