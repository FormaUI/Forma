@namespace Forma.Blazor.Components.Menus
@inherits FormaElementBase
@using Forma.Blazor.Components.Layout
@using Forma.Blazor.Components.Buttons
@using Forma.Blazor.Components.Symbols

@if (!RendererInfo.IsInteractive)
{
    @* A statically rendered page opens the browser's own popover from the trigger: the networks, the email and the download are
       links, and Copy Link, Print and the device's own share are drawn for the page's script, which enables each the browser
       can run, shows the device's share where the browser offers one, and runs the one pressed. *@
    <span class="forma-share-menu">
        <FormaButton Id="@Id"
                     Class="@RootClass"
                     Style="@RootStyle"
                     @attributes="AdditionalAttributes"
                     Variant="TriggerOptions.Variant"
                     Size="TriggerOptions.Size"
                     IconOnly="TriggerOptions.IconOnly"
                     popovertarget="@SheetId">
            @TriggerContent
        </FormaButton>
        <div id="@SheetId" class="forma-share-menu-sheet" popover>
            @if (ItemHeader is { } itemHeader)
            {
                <div class="forma-share-menu-sheet-header">@itemHeader</div>
            }
            <ul class="forma-share-menu-sheet-list">
                @if (Item is { Address: { } sharedAddress })
                {
                    <li hidden><button type="button" class="forma-share-menu-sheet-item" data-forma-share-command="share" data-forma-share-title="@Item.Name" data-forma-share-url="@sharedAddress" disabled><FormaIcon Icon="Glyph.Share" Size="IconSize.Small" /><span>@L["Share"]</span></button></li>
                }
                @foreach (var target in _supportedTargets)
                {
                    <li @key="target.Id">
                        @if (!NeedsConnection(target) && GetTargetAddress(target) is { } address)
                        {
                            <a class="forma-share-menu-sheet-item" href="@address" target="_blank" rel="noopener noreferrer"><FormaIcon Icon="target.Icon" Size="IconSize.Small" /><span>@target.Title</span></a>
                        }
                        else
                        {
                            <button type="button" class="forma-share-menu-sheet-item" disabled><FormaIcon Icon="target.Icon" Size="IconSize.Small" /><span>@target.Title</span></button>
                        }
                    </li>
                }
                @if (Item is { Resource: { } sheetResource })
                {
                    <li><a class="forma-share-menu-sheet-item" href="@SheetResourceAddress" download="@sheetResource.Name"><FormaIcon Icon="Glyph.Download" Size="IconSize.Small" /><span>@L["Download"]</span></a></li>
                }
                @if (OffersEmail)
                {
                    <li><a class="forma-share-menu-sheet-item" href="@EmailAddress"><FormaIcon Icon="Glyph.Unread" Size="IconSize.Small" /><span>@L["Email"]</span></a></li>
                }
                @if (OffersCopyLink)
                {
                    <li><button type="button" class="forma-share-menu-sheet-item" data-forma-share-command="copy" data-forma-share-url="@Item!.Address" disabled><FormaIcon Icon="Glyph.Link" Size="IconSize.Small" /><span>@L["Copy Link"]</span></button></li>
                }
                <li><button type="button" class="forma-share-menu-sheet-item" data-forma-share-command="print" disabled><FormaIcon Icon="Glyph.Print" Size="IconSize.Small" /><span>@L["Print"]</span></button></li>
            </ul>
        </div>
    </span>
}
else
{
<span class="forma-share-menu">
<FormaDropDownMenu @ref="Menu"
                   Id="@Id"
                   Class="@RootClass"
                   Style="@RootStyle"
                   @attributes="AdditionalAttributes"
                   TriggerOptions="TriggerOptions"
                   HeaderContent="@ItemHeader">
    <Trigger>
        @TriggerContent
    </Trigger>
    <ChildContent>
        @if (HasSocialNetworks)
        {
            @* The networks, the targets a host registered among them, ride the command bar. *@
            <div class="forma-share-menu-primary" role="none">
                <FormaCommandBar>
                    @if (_canShareNatively && Item is { Address: not null })
                    {
                        <FormaDropDownMenuItem OnClick="ShareNativelyAsync"><FormaIcon Icon="Glyph.Share" /><span>@L["Share"]</span></FormaDropDownMenuItem>
                    }
                    @foreach (var target in _supportedTargets)
                    {
                        @if (NeedsConnection(target))
                        {
                            <FormaDropDownMenuItem @key="target.Id" OnClick="() => ConnectAsync(target)"><FormaIcon Icon="target.Icon" /><span>@L["Connect {Target}", target.Title]</span></FormaDropDownMenuItem>
                        }
                        else if (target.GetAddress(Item!) is { } address)
                        {
                            <FormaDropDownMenuItem @key="target.Id" Href="@address" target="_blank" rel="noopener noreferrer"><FormaIcon Icon="target.Icon" /><span>@target.Title</span></FormaDropDownMenuItem>
                        }
                        else
                        {
                            @* A call reports how it went inside the menu, so the menu stays open to show it. *@
                            <FormaDropDownMenuItem @key="target.Id" KeepsOpen="true" OnClick="() => ShareAsync(target)"><FormaIcon Icon="target.Icon" /><span>@target.Title</span></FormaDropDownMenuItem>
                        }
                    }
                </FormaCommandBar>
                @if (_notice is not null)
                {
                    <p class="forma-share-menu-notice" role="status">@_notice</p>
                }
            </div>
            <FormaDropDownMenuDivider />
        }

        @* The built-in commands stand in the open, outside More. *@
        @if (Item is { Resource: { } resource })
        {
            <FormaDropDownMenuItem Href="@resource.Source" download="@resource.Name"><FormaIcon Icon="Glyph.Download" Size="IconSize.Small" /><span>@L["Download"]</span></FormaDropDownMenuItem>
        }
        @if (OffersEmail)
        {
            <FormaDropDownMenuItem Href="@EmailAddress"><FormaIcon Icon="Glyph.Unread" Size="IconSize.Small" /><span>@L["Email"]</span></FormaDropDownMenuItem>
        }
        @if (OffersCopyLink)
        {
            <FormaDropDownMenuItem OnClick="CopyLinkAsync"><FormaIcon Icon="Glyph.Link" Size="IconSize.Small" /><span>@L["Copy Link"]</span></FormaDropDownMenuItem>
        }
        <FormaDropDownMenuItem OnClick="PrintAsync"><FormaIcon Icon="Glyph.Print" Size="IconSize.Small" /><span>@L["Print"]</span></FormaDropDownMenuItem>

        @if (Actions.Count > 0)
        {
            <FormaVisibility Hidden="!_isExpanded" Animated="true">
                <FormaDropDownMenuDivider />
                @foreach (var action in Actions)
                {
                    <FormaDropDownMenuItem @key="action.Id" Disabled="action.IsDisabled" OnClick="() => OnCommand.InvokeAsync(action.Command)">
                        @if (action.Icon is { } icon)
                        {
                            <FormaIcon Icon="icon" Size="IconSize.Small" />
                        }
                        <span>@action.Title</span>
                    </FormaDropDownMenuItem>
                }
            </FormaVisibility>
            <FormaDropDownMenuDivider />
            <FormaDropDownMenuItem OnClick="ToggleExpanded" KeepsOpen="true" aria-expanded="@(_isExpanded ? "true" : "false")">
                <FormaIcon Icon="@(_isExpanded ? Glyph.ChevronUp : Glyph.ChevronDown)" Size="IconSize.Small" />
                <span>@(_isExpanded ? L["Less"] : L["More"])</span>
            </FormaDropDownMenuItem>
        }
    </ChildContent>
</FormaDropDownMenu>
</span>
}

@code {
    /// <summary>The trigger's content: the host's own, or the share icon and label.</summary>
    private RenderFragment TriggerContent => @<text>
        @if (Trigger is not null)
        {
            @Trigger
        }
        else
        {
            <FormaIcon Icon="Glyph.Share" Size="IconSize.Small" />
            @L["Share"]
        }
    </text>;

    /// <summary>The menu's header for an item with a name.</summary>
    private RenderFragment? ItemHeader => Item is { Name: not null }
        ? @<div class="forma-share-menu-item">
                @if (Item.Icon is { } icon)
                {
                    <FormaIcon Icon="icon" Size="IconSize.Medium" />
                }
                <div class="forma-share-menu-item-text">
                    <span class="forma-share-menu-item-name">@Item.Name</span>
                    @if (Item.Meta is not null)
                    {
                        <span class="forma-share-menu-item-meta">@Item.Meta</span>
                    }
                </div>
            </div>
        : null;
}
