@namespace Forma.Blazor.Components.Menus
@inherits FormaElementBase
@if (Href is not null)
{
    <a id="@Id"
       data-rid="@Context.RuntimeId"
       class="@RootClass"
       style="@RootStyle"
       @attributes="AdditionalAttributes"
       @ref="RootElement"
       href="@_linkAddress"
       role="@Role"
       aria-checked="@AriaChecked"
       tabindex="@LinkTabIndex"
       aria-disabled="@(Disabled ? "true" : null)"
       aria-describedby="@AriaDescribedBy"
       @onclick="HandleActivateAsync"
       @onfocusin="HandleFocusIn"
       @onclick:preventDefault="Disabled">
        @ChildContent
        @if (IsSelected is true)
        {
            <span class="forma-dropdown-menu-item-check" aria-hidden="true">&#10003;</span>
        }
    </a>
}
else
{
    <button id="@Id"
            data-rid="@Context.RuntimeId"
            class="@RootClass"
            style="@RootStyle"
            @attributes="AdditionalAttributes"
            @ref="RootElement"
            type="button"
            role="@Role"
            aria-checked="@AriaChecked"
            disabled="@(Disabled && !ShowsDisabledReason)"
            aria-disabled="@(ShowsDisabledReason ? "true" : AdditionalAttributes?.GetValueOrDefault("aria-disabled"))"
            aria-describedby="@AriaDescribedBy"
            @onclick="HandleActivateAsync"
            @onfocusin="HandleFocusIn">
        @ChildContent
        @if (IsSelected is true)
        {
            <span class="forma-dropdown-menu-item-check" aria-hidden="true">&#10003;</span>
        }
    </button>
}
@if (ShowsDisabledReason)
{
    <FormaTooltip Id="@DisabledReasons.GetTooltipId(ElementId)" Text="@(DisabledReason!)" />
}
