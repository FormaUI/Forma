@namespace Forma.Blazor.Components.Media
@inherits FormaElementBase

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    @if (ShowFacade)
    {
        <button type="button"
                class="forma-video-player-facade"
                aria-labelledby="@LabelId"
                aria-describedby="@NoteId"
                disabled="@(!RendererInfo.IsInteractive)"
                @onclick="Activate">
            @if (!string.IsNullOrWhiteSpace(Placeholder))
            {
                <img class="forma-video-player-facade-placeholder" src="@Placeholder" alt="" />
            }
            <FormaIcon Icon="Glyph.TriangleRight" Size="IconSize.Display" Class="forma-video-player-facade-glyph" />
            <span id="@LabelId" class="forma-video-player-facade-label">@L["Play {Title}", Title]</span>
            <span id="@NoteId" class="forma-video-player-facade-note">@L["Loads from another site, which will see this visit."]</span>
        </button>
    }
    else if (Frame is NativePlayerFrame nativeFrame)
    {
        <video @ref="_videoElement"
               class="forma-video-player-frame"
               src="@nativeFrame.Source"
               title="@Title"
               poster="@Placeholder"
               controls
               playsinline
               autoplay="@Autoplay"
               muted="@Autoplay">
            @foreach (var caption in Captions ?? [])
            {
                <track kind="captions"
                       src="@caption.Source"
                       srclang="@caption.Language"
                       label="@caption.Label"
                       default="@caption.IsDefault" />
            }
        </video>
    }
    else if (Frame is EmbeddedPlayerFrame embeddedFrame)
    {
        <iframe class="forma-video-player-frame"
                src="@embeddedFrame.Source"
                title="@Title"
                loading="lazy"
                allow="accelerometer; encrypted-media; picture-in-picture"
                allowfullscreen></iframe>
    }
    else if (Frame is HtmlPlayerFrame markup)
    {
        <div role="group" aria-label="@Title">
            @((MarkupString)markup.Html)
            <a class="forma-video-player-fallback"
               href="@markup.Source"
               target="_blank"
               rel="noopener noreferrer">@L["Open this video on its own site."]</a>
        </div>
    }
    else
    {
        <p class="forma-video-player-unavailable">@L["This video is unavailable."]</p>
    }
</div>
