@namespace Forma.Blazor.Components
@inherits FormaElementBase

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement"
     role="@GroupRole"
     aria-labelledby="@GroupLabelId">
    @* The element's box: the label's room, the element, what overlays it, and its label. *@
    <div class="@BoxClass">
        @if (HasLabelRoom)
        {
            @* An unseen copy of the label, set as the floated label is, which holds the lines that label takes above the value. *@
            <span class="forma-field-label-room" aria-hidden="true">@LabelRoomText</span>
        }
        @ChildContent
        @if (HasLabel && Grouped)
        {
            <span id="@EffectiveElementIds.LabelId" class="forma-field-label">
                <span class="forma-field-label-text">@Label@if (Required) {<span class="forma-field-required" aria-hidden="true"> *</span>}</span>
            </span>
        }
        else if (HasLabel)
        {
            <label id="@EffectiveElementIds.LabelId" for="@TargetId" class="forma-field-label">
                <span class="forma-field-label-text">@Label@if (Required) {<span class="forma-field-required" aria-hidden="true"> *</span>}</span>
            </label>
        }
    </div>
    @if (HasDescription)
    {
        <div id="@EffectiveElementIds.DescriptionId" class="forma-field-description">@Description</div>
    }
    @FooterContent
    @if (ShowsMessages)
    {
        <div id="@EffectiveElementIds.MessageContainerId" class="forma-field-messages">
            @foreach (var message in ValidationMessages)
            {
                <div class="forma-field-message">@message</div>
            }
        </div>
    }
</div>
