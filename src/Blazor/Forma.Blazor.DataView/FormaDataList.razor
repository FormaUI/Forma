@namespace Forma.Blazor.Components.DataView
@inherits FormaElementBase
@typeparam TItem where TItem : notnull

@using Forma.Blazor.Components.Virtualization

@if (IsActive)
{
    var revision = ItemRevision;

    // An item draws again only when its own state, its place or what every item is drawn by changed, so the list gives it the token the
    // selection behavior knows it by on every pass, which is what keeps the token from being retired.
    RenderFragment<(TItem Item, int? Position)> entry = row =>
        @<FormaDataListItem TItem="TItem" List="this" Item="row.Item" Position="row.Position" Token="View.GetItemToken(row.Item)" ViewRevision="revision" @key="View.ItemKey(row.Item)" />;

    <div id="@Id"
         data-rid="@Context.RuntimeId"
         class="@RootClass"
         style="@RootStyle"
         @attributes="_collectionName.RootAttributes"
         @ref="RootElement">
        @if (!View.HasLoaded)
        {
            <div class="forma-data-list-state">@View.LoadingContent</div>
        }
        else if (IsVirtualizing)
        {
            <div class="forma-data-list-rows" role="list" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                @if (View.TotalItemCount == 0)
                {
                    <div class="forma-data-list-state" role="none">@View.EmptyContent</div>
                }
                else
                {
                    <FormaVirtualize @ref="_virtualizer"
                                     TItem="DataViewRow<TItem>"
                                     ItemsProvider="_rows.ProvideAsync"
                                     ItemKey="_rows.GetRowKey"
                                     PinnedKeys="_rows.GetPinnedKeys()"
                                     ItemComparer="_rows.Comparer"
                                     ItemSize="View.ItemHeight"
                                     OverscanCount="View.OverscanCount"
                                     AnchorMode="View.AnchorMode"
                                     InitialItemIndex="_rows.GetRowIndex(View.InitialItemIndex)">
                        <ItemContent Context="row">
                            @if (row.Group is { } group)
                            {
                                <div class="forma-data-list-heading-row" role="listitem" @key="group.Key">
                                    <FormaDataGroupHeading TItem="TItem" Group="group" IsFolded="View.IsFolded(group)" OnToggle="() => Interaction.ToggleGroupAsync(group)" />
                                </div>
                            }
                            else
                            {
                                @foreach (var item in row.Items)
                                {
                                    @entry((item, row.FirstItemIndex))
                                }
                            }
                        </ItemContent>
                        <Placeholder>
                            <div class="forma-data-list-placeholder-row" role="none" style="@PlaceholderStyle"></div>
                        </Placeholder>
                    </FormaVirtualize>
                }
            </div>
        }
        else if (View.Items.Count == 0)
        {
            <div class="forma-data-list-state">@View.EmptyContent</div>
        }
        else if (View.IsGrouped)
        {
            <div class="forma-data-list-groups" role="group" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                @foreach (var (index, group) in View.Groups.Index())
                {
                    var isFolded = View.IsFolded(group);
                    var nameId = GetGroupNameId(index);

                    <section class="forma-data-list-group" @key="group.Key">
                        <FormaDataGroupHeading TItem="TItem" Group="group" NameId="@nameId" IsFolded="isFolded" OnToggle="() => Interaction.ToggleGroupAsync(group)" />
                        @if (!isFolded)
                        {
                            <div class="forma-data-list-flow" role="list" aria-labelledby="@nameId">
                                @foreach (var item in group.Items)
                                {
                                    @entry((item, null))
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
        else
        {
            <div class="forma-data-list-flow" role="list" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                @foreach (var item in View.Items)
                {
                    @entry((item, null))
                }
            </div>
        }
    </div>
}
