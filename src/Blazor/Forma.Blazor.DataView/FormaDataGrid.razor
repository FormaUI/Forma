@namespace Forma.Blazor.Components.DataView
@inherits FormaElementBase
@typeparam TItem where TItem : notnull
@using Forma.Blazor.Components.Layout

@* Each column registers with the grid as its parameters are set, in the order written; the table declared after them renders once they have. *@
<CascadingValue TValue="FormaDataGrid<TItem>" Value="this" IsFixed="true">
    @* Fixed: the session is mutated in place, so the cascade never changes value under a mounted editor. *@
    <CascadingValue TValue="RowEditSession<TItem>" Value="_editSession" IsFixed="true">
        @{ StartCollectingColumns(); }
        @Columns

        @if (_editSession.EditContext is { } rowEditContext)
        {
            @* Fixed and keyed: the validator refuses a context swap, so it is torn down with the edit and rebuilt for the next. *@
            <CascadingValue TValue="EditContext" Value="rowEditContext" IsFixed="true">
                <DataAnnotationsValidator @key="rowEditContext" />
            </CascadingValue>
        }

        @if (IsActive)
        {
            @* The shell takes the region's height, so the pane inside it is the one box the rows scroll in, both ways. *@
            <div class="forma-data-grid-shell">
                <FormaFreezePane Options="PaneOptions" class="forma-data-grid-pane" FrozenExtentChanged="HandleFrozenExtentChanged">
                    <FormaDataGridTable TItem="TItem" Grid="this" Id="@Id" Class="@RootClass" Style="@RootStyle" @attributes="AdditionalAttributes" @ref="Table" />
                    @View.MoreContent
                </FormaFreezePane>
            </div>
        }
    </CascadingValue>
</CascadingValue>
