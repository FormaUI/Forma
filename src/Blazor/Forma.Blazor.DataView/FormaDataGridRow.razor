@namespace Forma.Blazor.Components.DataView
@inherits FormaComponentBase
@typeparam TItem where TItem : notnull

@* A row being edited carries no token, which takes it out of every press and selection gesture. *@
<tr @attributes="View.ItemAttributes?.Invoke(Item)" class="@RowClass" aria-selected="@AriaSelected" aria-rowindex="@(Position + 1)" data-item="@(Grid.IsEditing(Item) ? null : Token)" data-row-key="@(View.FocusesItems && !Grid.IsEditing(Item) && View.CanFocus(Item) ? Token : null)" data-item-root="@(!Grid.IsEditing(Item))" data-item-position="@Position" @onfocusin="@(View.FocusesItems ? Grid.GetRowFocusHandler(Item) : default)">
    @if (Grid.HasSelectionColumn)
    {
        <td class="@Grid.SelectionCellClass" data-item-control>
            @* The editing row and a row that cannot take the focus draw no marker; the selection behavior acts only on rows that carry one. *@
            @if (!Grid.IsEditing(Item) && View.CanFocus(Item))
            {
                <label class="@(View.EnableCheckedSelection ? "forma-data-view-box-target" : null)">
                    <FormaCheckBox class="@(View.EnableCheckedSelection ? null : "forma-data-grid-row-marker")"
                                   data-row-key="@Token"
                                   aria-label="@L["Select Row"]"
                                   aria-disabled="@(!View.CanInteractWith(Item) ? "true" : null)"
                                   Value="@View.IsSelected(Item)"
                                   PreventDefault="true"
                                   OnClick="() => Interaction.ToggleSelectionAsync(Item, !View.IsSelected(Item))"
                                   @onfocusin="Grid.GetRowFocusHandler(Item)"
                                   ValueExpression="() => RowSelection" />
                </label>
            }
        </td>
    }
    @foreach (var column in Grid.ShownColumns)
    {
        <td class="@Grid.GetCellClass(column)" style="@Grid.GetCellStyle(column)" @key="column">
            @((RenderFragment)(builder => column.CellContent(builder, Item)))
        </td>
    }
    @if (Grid.HasColumnsMenu)
    {
        <td class="forma-data-grid-menu-column"></td>
    }
</tr>
