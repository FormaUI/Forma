@namespace Forma.Blazor.Components.DataView
@inherits FormaElementBase
@typeparam TItem where TItem : notnull
@using Forma.Blazor.Components.Menus

<FormaDropDownMenu @ref="Menu"
                   Id="@Id"
                   Class="@RootClass"
                   Style="@RootStyle"
                   @attributes="AdditionalAttributes"
                   TriggerOptions="TriggerOptions"
                   aria-label="@TriggerLabel">
    <Trigger>
        <FormaIcon Icon="Glyph.Sort" Size="IconSize.Small" />
        <span class="forma-data-sort-menu-text">@(CurrentOption?.Label ?? L["Sort"].Value)</span>
        @if (CurrentOption is not null)
        {
            <FormaIcon Icon="@(Sorter.SortDirection == DataViewSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" Size="IconSize.Small" class="forma-data-sort-menu-direction" />
        }
        <span class="forma-data-sort-menu-caret" aria-hidden="true"><FormaIcon Icon="Glyph.ChevronDown" /></span>
    </Trigger>
    <ChildContent>
        <FormaDropDownMenuGroup Label="@L["Sort By"]">
            @foreach (var option in Sorts)
            {
                <FormaDropDownMenuItem IsSelected="@IsCurrent(option)"
                                       data-sort="@option.Name"
                                       OnClick="() => ChooseAsync(option)"
                                       @key="option.Name">
                    <span>@option.Label</span>
                </FormaDropDownMenuItem>
            }
        </FormaDropDownMenuGroup>
        <FormaDropDownMenuGroup Label="@L["Sort Direction"]">
            @foreach (var direction in Directions)
            {
                <FormaDropDownMenuItem IsSelected="@(CurrentOption is not null && Sorter.SortDirection == direction)"
                                       Disabled="@(CurrentOption is null)"
                                       data-sort-direction="@direction"
                                       OnClick="() => TurnAsync(direction)"
                                       @key="direction">
                    <FormaIcon Icon="@(direction == DataViewSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" Size="IconSize.Small" />
                    <span>@GetDirectionLabel(direction)</span>
                </FormaDropDownMenuItem>
            }
        </FormaDropDownMenuGroup>
    </ChildContent>
</FormaDropDownMenu>
