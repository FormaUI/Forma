@namespace Forma.Blazor.Components.DataView
@inherits FormaElementBase
@attribute [CascadingTypeParameter(nameof(TItem))]
@typeparam TItem where TItem : notnull

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    @* Fixed: the engine announces its changes through the view contract, so the cascade never has to change value under a view; the
       footer's is not, so a footer draws again whenever the data view does, a status the host changes among it. *@
    <CascadingValue TValue="IDataView<TItem>" Value="this" IsFixed="true">
        <CascadingValue TValue="IDataViewInteraction<TItem>" Value="this" IsFixed="true">
            <CascadingValue TValue="IDataViewSwitcher" Value="this" IsFixed="true">
                <CascadingValue TValue="IDataViewSorter<TItem>" Value="this" IsFixed="true">
                    <CascadingValue TValue="IDataViewFooter" Value="this">
                        <div class="@RegionClass" aria-busy="@(_isBusy ? "true" : null)" @ref="_regionElement">
                            @ChildContent
                        </div>

                        @* Present from the first render, so a screen reader is already listening when the first announcement arrives. *@
                        <div class="forma-data-view-announcement" role="status">@_announcement</div>

                        @if (Layout == DataViewLayout.BuiltIn)
                        {
                            <FormaDataViewFooter />
                        }
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
</div>
