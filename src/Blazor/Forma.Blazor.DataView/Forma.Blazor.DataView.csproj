<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- The component borrows the product's namespace, so its translations embed and resolve as the product's own do. -->
        <RootNamespace>Forma.Blazor.Components.DataView</RootNamespace>
        <StaticWebAssetBasePath>_content/$(AssemblyName)</StaticWebAssetBasePath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Forms" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
        <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
        <PackageReference Include="Microsoft.JSInterop" />
    </ItemGroup>

    <!-- The grid's parts draw the table its stylesheet styles, so they share the grid's scope rather than each carrying one of their own. -->
    <ItemGroup>
        <None Update="FormaDataGrid.razor" CssScope="b-forma-data-grid" />
        <None Update="FormaDataGrid.razor.css" CssScope="b-forma-data-grid" />
        <None Update="FormaDataGridTable.razor" CssScope="b-forma-data-grid" />
        <None Update="FormaDataGridTable.razor.css" CssScope="b-forma-data-grid" />
        <None Update="FormaDataGridRow.razor" CssScope="b-forma-data-grid" />
        <None Update="FormaDataGridRow.razor.css" CssScope="b-forma-data-grid" />
        <None Update="FormaDataGridColumnHeader.razor" CssScope="b-forma-data-grid" />
        <None Update="FormaDataGridColumnHeader.razor.css" CssScope="b-forma-data-grid" />
    </ItemGroup>

    <!-- A list's item is a part of the list, so it shares the list's scope as the grid's parts share the grid's. -->
    <ItemGroup>
        <None Update="FormaDataList.razor" CssScope="b-forma-data-list" />
        <None Update="FormaDataList.razor.css" CssScope="b-forma-data-list" />
        <None Update="FormaDataListItem.razor" CssScope="b-forma-data-list" />
    </ItemGroup>

    <!-- The cards' card is a part of the cards, so it shares their scope. -->
    <ItemGroup>
        <None Update="FormaDataCards.razor" CssScope="b-forma-data-cards" />
        <None Update="FormaDataCards.razor.css" CssScope="b-forma-data-cards" />
        <None Update="FormaDataCard.razor" CssScope="b-forma-data-cards" />
    </ItemGroup>

    <!-- The tree's node is a part of the tree, so it shares the tree's scope. -->
    <ItemGroup>
        <None Update="FormaDataTree.razor" CssScope="b-forma-data-tree" />
        <None Update="FormaDataTree.razor.css" CssScope="b-forma-data-tree" />
        <None Update="FormaDataTreeNode.razor" CssScope="b-forma-data-tree" />
    </ItemGroup>

    <!-- The product, whose package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Blazor\Forma.Blazor.csproj" />
    </ItemGroup>

    <!-- The Framework assemblies the component compiles against, each a package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Forma.Framework.Browser.Interop\Forma.Framework.Browser.Interop.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Css\Forma.Framework.Css.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Culture\Forma.Framework.Culture.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Events\Forma.Framework.Events.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Icons\Forma.Framework.Icons.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Input.Interop\Forma.Framework.Input.Interop.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.JavaScript.Interop\Forma.Framework.JavaScript.Interop.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
    </ItemGroup>

    <Import Project="$(ComponentAnalyzersTargets)" />

</Project>
