<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- The component borrows the product's namespace, so its translations embed and resolve as the product's own do. -->
        <RootNamespace>Forma.Blazor.Components.Composer</RootNamespace>
        <StaticWebAssetBasePath>_content/$(AssemblyName)</StaticWebAssetBasePath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Forms" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
        <PackageReference Include="Microsoft.JSInterop" />
    </ItemGroup>

    <!-- The product, whose package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Blazor\Forma.Blazor.csproj" />
    </ItemGroup>

    <!-- The contracts a plugin is written against, which ship as their own package so a plugin outside this one can be. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Forma.Framework.Composer.Extensibility\Forma.Framework.Composer.Extensibility.csproj" />
    </ItemGroup>

    <!-- The engine the component drives, a package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Forma.Framework.Composer\Forma.Framework.Composer.csproj" />
    </ItemGroup>

    <!-- The Framework assemblies the component compiles against, each a package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Forma.Framework.Files\Forma.Framework.Files.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Media\Forma.Framework.Media.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Toolbar\Forma.Framework.Toolbar.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Input\Forma.Framework.Input.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Input.Interop\Forma.Framework.Input.Interop.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.JavaScript.Interop\Forma.Framework.JavaScript.Interop.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Browser.Interop\Forma.Framework.Browser.Interop.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Share\Forma.Framework.Share.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Css\Forma.Framework.Css.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Icons\Forma.Framework.Icons.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Emojis\Forma.Framework.Emojis.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Resources\Forma.Framework.Resources.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Sanitization\Forma.Framework.Sanitization.csproj" />
    </ItemGroup>

    <Import Project="$(ComponentAnalyzersTargets)" />

</Project>
