@namespace Forma.Blazor.Components.Composer
@inherits FormaComponentBase

@if (ShowToolbar)
{
    <FormaComposerToolbar
        Editor="Editor"
        View="View"
        Plugins="Plugins"
        Disabled="Disabled"
        KeyBindings="KeyBindings"
        OnCommand="OnCommand" />
}

<div class="forma-composer-canvas">
    @if (View is not null)
    {
        <CascadingValue Value="View" IsFixed="true">
            @ViewContent
        </CascadingValue>
    }
    else
    {
        <CascadingValue Value="Editor" IsFixed="true">
            <CascadingValue Value="SelectionBar">
                @EditorContent
            </CascadingValue>
        </CascadingValue>
    }
</div>
