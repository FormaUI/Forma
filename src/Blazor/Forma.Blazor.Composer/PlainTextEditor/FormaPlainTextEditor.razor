@namespace Forma.Blazor.Components.Composer.PlainTextEditor
@inherits FormaComponentBase

<div class="forma-composer-plain-text-editor">
    @* The text is the browser's while the reader edits it, which the editor's edits carry to the composer. *@
    <textarea @ref="_textareaElement"
              class="forma-composer-plain-text-textarea"
              value="@ShownText"
              placeholder="@L["Edit Content"]"
              aria-label="@L["Plain Text"]"
              aria-describedby="@Composer?.DescribedBy"
              disabled="@IsDisabled"
              readonly="@IsReadOnly"
              spellcheck="false"></textarea>
</div>
