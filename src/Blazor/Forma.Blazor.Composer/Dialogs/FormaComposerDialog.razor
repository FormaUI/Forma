@namespace Forma.Blazor.Components.Composer.Dialogs
@inherits FormaComponentBase
@using Forma.Blazor.Components.Feedback

<FormaDialog Opened="Opened"
            Title="@Title"
            Size="Size"
            Options="StayOpenOnConfirm"
            OnClose="OnCancel"
            OnConfirm="OnConfirm"
            ConfirmText="@ConfirmLabel"
            CancelText="@CancelLabel">
    <Body>
        @* The bound inputs' edit context, cascaded without a form because nothing here submits. *@
        <CascadingValue Value="_editContext" IsFixed="true">
            <div class="forma-composer-dialog-form">
                @ChildContent

                @if (Notice is not null)
                {
                    <p class="forma-composer-dialog-notice" role="status">@Notice</p>
                }

                @foreach (var message in Messages)
                {
                    <p class="forma-composer-dialog-error" role="alert">@message</p>
                }
            </div>
        </CascadingValue>
    </Body>
</FormaDialog>
