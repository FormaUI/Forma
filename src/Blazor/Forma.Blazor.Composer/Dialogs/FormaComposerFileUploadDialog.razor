@namespace Forma.Blazor.Components.Composer.Dialogs
@using Forma.Blazor.Components.Feedback
@using Forma.Blazor.Components.Files
@using Forma.Framework.Files
@inherits ComposerDialogBase

<FormaComposerDialog Opened="Opened"
                     Title="@L["Attach Files"]"
                     Size="DialogSize.Medium"
                     ConfirmText="@L["Done"]"
                     Notice="@(_store is null ? L["Files cannot be attached, because this application registered nowhere to keep them."].Value : null)"
                     Messages="Messages"
                     OnConfirm="HandleConfirmAsync"
                     OnCancel="HandleCancelAsync">
    @if (_store is not null)
    {
        <FormaFilePicker Options="PickerOptions"
                         OnFilesSelected="HandleFilesSelectedAsync"
                         OnFilesRejected="HandleFilesRejected" />

        @if (_files.Count > 0)
        {
            <FormaFileUploader @ref="Uploader"
                               Files="_files"
                               Store="_store"
                               Options="UploaderOptions"
                               OnCompleted="HandleCompleted"
                               OnFailed="HandleFailed"
                               OnRefused="HandleRefused" />
        }
    }
</FormaComposerDialog>
