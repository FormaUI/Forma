@namespace Forma.Blazor.Components.Composer.Dialogs
@using Forma.Blazor.Components.Feedback
@using Forma.Blazor.Components.Inputs
@inherits ComposerDialogBase

<FormaComposerDialog Opened="Opened"
                     Title="@L["Insert Table"]"
                     Size="DialogSize.Small"
                     Messages="Messages"
                     OnConfirm="HandleConfirmAsync"
                     OnCancel="OnCancel">
    <FormaSlider TValue="int" @bind-Value="_rowCount" Label="@L["Rows"]" Min="1" Max="@MaxRowCount" />
    <FormaSlider TValue="int" @bind-Value="_columnCount" Label="@L["Columns"]" Min="1" Max="@MaxColumnCount" />
    <div class="forma-composer-dialog-checkbox">
        <FormaCheckBox @bind-Value="_includeHeader">
            @L["Include Header Row"]
        </FormaCheckBox>
    </div>
    <FormaTextBox @bind-Value="_caption" Label="@L["Caption"]" />
</FormaComposerDialog>
