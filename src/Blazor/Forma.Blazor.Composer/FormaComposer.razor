@namespace Forma.Blazor.Components.Composer
@using Forma.Blazor.Components.Composer.Dialogs
@using Forma.Framework.Composer.Dialogs
@using Forma.Framework.Composer.Editing
@inherits FormaInputBase<ComposerDocument>

<CascadingValue Value="Composer">
<CascadingValue Value="Options">
<CascadingValue Value="(IComposerInteraction)this" IsFixed="true">
    <div id="@ElementId"
         data-rid="@Context.RuntimeId"
         class="@RootClass"
         style="@RootStyle"
         @attributes="AdditionalAttributes"
         @ref="RootElement">
        @if (_isInitialized && ShowTabs)
        {
            <FormaTabs ActiveTabId="@ActiveTabId" ActiveTabIdChanged="SelectTabAsync" Label="@L["Editors"]">
                @foreach (var editor in _pluginCatalog.Editors)
                {
                    <FormaTab TabId="@editor.Id" Title="@Localizer.Localize(editor, editor.Title)" Icon="editor.Icon">
                        @if (editor.Id == _activeEditor.Id && _activeView is null)
                        {
                            <FormaComposerSurface
                                Editor="_activeEditor"
                                Plugins="_surfacePlugins"
                                ShowToolbar="ShowToolbar"
                                Disabled="Disabled"
                                KeyBindings="_keyBindingCatalog"
                                OnCommand="HandleCommandAsync" />
                        }
                    </FormaTab>
                }
                @foreach (var view in ActiveViews)
                {
                    <FormaTab TabId="@view.Id" Title="@Localizer.Localize(view, view.Title)" Icon="view.Icon" Trailing="true">
                        @if (view.Id == _activeView?.Id)
                        {
                            <FormaComposerSurface
                                Editor="_activeEditor"
                                View="_activeView"
                                Plugins="_surfacePlugins"
                                ShowToolbar="ShowToolbar"
                                Disabled="Disabled"
                                KeyBindings="_keyBindingCatalog"
                                OnCommand="HandleCommandAsync" />
                        }
                    </FormaTab>
                }
            </FormaTabs>
        }
        else if (_isInitialized)
        {
            <FormaComposerSurface
                Editor="_activeEditor"
                View="_activeView"
                Plugins="_surfacePlugins"
                ShowToolbar="ShowToolbar"
                Disabled="Disabled"
                KeyBindings="_keyBindingCatalog"
                OnCommand="HandleCommandAsync" />
        }

        @if (_isInitialized)
        {
            @if (CurrentDocument.Attachments.Count > 0)
            {
                <FormaComposerAttachments />
            }

            <FormaComposerStatusStrip OnCommand="HandleCommandAsync" />
        }
    </div>
    @if (HasDescription)
    {
        <div id="@FieldElementIds.DescriptionId" class="forma-composer-description">@Description</div>
    }

    @if (_isAttachOpen)
    {
        <FormaComposerFileUploadDialog Opened="_isAttachOpen"
                                       Options="_attachOptions"
                                       OnAttach="HandleAttachedAsync"
                                       OnCancel="() => _isAttachOpen = false" />
    }

    @if (_isShortcutsOpen)
    {
        <FormaComposerShortcutsDialog Opened="_isShortcutsOpen"
                                      Editor="_activeEditor"
                                      View="_activeView"
                                      Plugins="_surfacePlugins"
                                      KeyBindings="_keyBindingCatalog"
                                      OnCancel="() => _isShortcutsOpen = false" />
    }

    @* The shell stays once a plugin's dialog has opened, so the dialog closes as a dialog does, handing the focus back to what opened it. *@
    @if (_dialogShellSize is { } shellSize)
    {
        <FormaComposerDialog Opened="_dialog is not null"
                             Title="@DialogBody?.Title"
                             Size="@GetDialogSize(shellSize)"
                             Notice="@DialogBody?.Notice"
                             Messages="DialogMessages"
                             OnConfirm="HandleDialogConfirmAsync"
                             OnCancel="CloseDialog">
            @if (_dialog is { } dialog)
            {
                <CascadingValue Value="(IComposerDialogInteraction)this" IsFixed="true">
                    @RenderDialogBody(dialog)
                </CascadingValue>
            }
        </FormaComposerDialog>
    }
</CascadingValue>
</CascadingValue>
</CascadingValue>
