@namespace Forma.Blazor.Components.Page
@using Microsoft.AspNetCore.Components.Web
@using Forma.Blazor.Components
@using Forma.Framework.Culture.Browser.Interop
@inherits FormaComponentBase
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@Title</title>
<base href="@BaseHref" />
@* The cultures the server rendered the page in, and how a switch persists, which the page's culture coordinator reads. *@
<meta name="forma-culture" data-culture="@Context.CultureState.Culture.Name" data-ui-culture="@Context.CultureState.UICulture.Name" />
@if (Policy.Persistence is CultureSwitchPersistence.Cookie)
{
    <meta name="forma-culture-policy" content="cookie" data-name="@Policy.CookieName" data-path="@Policy.CookiePath" data-domain="@Policy.CookieDomain" data-max-age="@CookieMaxAge" data-secure="@Policy.IsCookieSecure" data-same-site="@CookieSameSite" />
}
else
{
    <meta name="forma-culture-policy" content="state" />
}
@if (!string.IsNullOrWhiteSpace(IconHref))
{
    <link rel="icon" href="@IconHref" />
}
<link rel="stylesheet" href="@Assets["_content/Forma.Blazor/forma-tokens.css"]" />
<link rel="stylesheet" href="@Assets["_content/Forma.Blazor/forma-reset.css"]" />
<link rel="stylesheet" href="@Assets["_content/Forma.Blazor/forma-base.css"]" />
<link rel="stylesheet" href="@Assets["_content/Forma.Blazor/forma-input.css"]" />
<link rel="stylesheet" href="@Assets["_content/Forma.Blazor/forma-prose.css"]" />
@ChildContent
@if (PreloadAssets)
{
    <ResourcePreloader />
}
<ImportMap />
@* Last, so a page's own PageTitle and HeadContent override what is set above. *@
<HeadOutlet />
