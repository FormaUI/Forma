<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- The server half borrows the product's namespace, so a host reaches its registrar and its components with the usings it already writes. -->
        <RootNamespace>Forma.Blazor</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- The product it serves and the circuit halves it registers, each a package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Blazor\Forma.Blazor.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Browser.Blazor.Server\Forma.Framework.Browser.Blazor.Server.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Culture.Blazor.Server\Forma.Framework.Culture.Blazor.Server.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Culture.Browser.Interop\Forma.Framework.Culture.Browser.Interop.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Input\Forma.Framework.Input.csproj" />
    </ItemGroup>

    <Import Project="$(ComponentAnalyzersTargets)" />

</Project>
