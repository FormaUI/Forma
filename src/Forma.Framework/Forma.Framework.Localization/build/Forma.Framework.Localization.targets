<Project>

    <!--
        What the build does for an assembly that localizes. This file ships in the library's package,
        named for the package there, and is imported into every project that references it, directly or
        through another package. For any project it embeds the config file; for a WebAssembly client it
        embeds the host's own locale files, since the browser has no folder to read them from; and for a
        locale pack, a project that declared IsLocalePack, it does the rest: a pack is a project of
        nothing but locale files, for other assemblies' types, so it compiles no code, embeds every
        locale file beneath it under its own path so that a resource name spells the tree a reader sees,
        and carries in its own package a targets file that records the pack in whatever references it,
        since nothing else would.
    -->

    <!-- An assembly's config file sits at its root and is embedded whenever it is there, since the SDK embeds nothing by default and would ship it as content instead. -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/.locale.json')">
        <EmbeddedResource Include=".locale.json" />
        <Content Remove=".locale.json" />
        <None Remove=".locale.json" />
    </ItemGroup>

    <!--
        A WebAssembly client embeds the host's folder of locale files, the one LocalesPath names, .locales
        beside the project by default, as a pack embeds its own, each under its path in the folder, after
        the prefix HostLocalesAttribute names, which no resource name the build forms starts with; the
        attribute tells the runtime the assembly carries them, and where it reads them.
    -->
    <PropertyGroup Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true' and '$(LocalesPath)' == ''">
        <LocalesPath>.locales</LocalesPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">
        <_HostLocaleFile Include="$(LocalesPath)/**/*.json" />
        <EmbeddedResource Include="$(LocalesPath)/**/*.json" WithCulture="false" LogicalName=".locales.$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '.').Replace('/', '.'))" />
    </ItemGroup>

    <ItemGroup Condition="'@(_HostLocaleFile)' != ''">
        <AssemblyAttribute Include="Forma.Framework.Localization.HostLocalesAttribute" />
    </ItemGroup>

    <PropertyGroup Condition="'$(IsLocalePack)' == 'true'">
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeLocalePackTargetsInPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <!-- A file's resource name is its path with the folders joined by dots, which is the name the runtime reads a pack's files by. -->
    <ItemGroup Condition="'$(IsLocalePack)' == 'true'">
        <EmbeddedResource Include="**\*.json" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" WithCulture="false" LogicalName="$([System.String]::Copy('%(RelativeDir)%(Filename)%(Extension)').Replace('\', '.').Replace('/', '.'))" />
    </ItemGroup>

    <!--
        The targets file NuGet imports into a project referencing this pack's package, written at pack
        time with this assembly's name in place, because the name a consumer records is the one the
        runtime loads, whatever the package is called.
    -->
    <Target Name="IncludeLocalePackTargetsInPackage" Condition="'$(IsLocalePack)' == 'true'">
        <PropertyGroup>
            <_LocalePackTargetsPath>$(IntermediateOutputPath)$(PackageId).targets</_LocalePackTargetsPath>
            <_LocalePackTargetsContent>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)LocalePack.targets').Replace('{AssemblyName}', '$(AssemblyName)'))</_LocalePackTargetsContent>
        </PropertyGroup>
        <WriteLinesToFile File="$(_LocalePackTargetsPath)" Lines="$(_LocalePackTargetsContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(_LocalePackTargetsPath)" PackagePath="build\$(PackageId).targets" />
        </ItemGroup>
    </Target>

    <!--
        A pack declares the culture it carries, or several separated by semicolons, which its own
        assembly then states as metadata, and the build refuses a file of any other culture, so one
        package is one language by construction rather than by care. A file's culture is the last
        dotted part of its name.
    -->
    <ItemGroup Condition="'$(IsLocalePack)' == 'true' and '$(LocalePackCulture)' != ''">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>LocalePackCulture</_Parameter1>
            <_Parameter2>$(LocalePackCulture)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <Target Name="CheckLocalePackCulture" BeforeTargets="CoreCompile" Condition="'$(IsLocalePack)' == 'true'">
        <Error Condition="'$(LocalePackCulture)' == ''" Text="A locale pack declares the culture it carries in LocalePackCulture, one or several separated by semicolons; this project declares none." />
        <ItemGroup>
            <_LocaleFile Include="@(EmbeddedResource)" Condition="'%(Extension)' == '.json'">
                <Culture>$([System.String]::Copy('%(Filename)').Substring($([MSBuild]::Add($([System.String]::Copy('%(Filename)').LastIndexOf('.')), 1))))</Culture>
            </_LocaleFile>
            <_LocaleFileOfAnotherCulture Include="@(_LocaleFile)" Condition="!$([System.String]::Copy(';$(LocalePackCulture);').Contains(';%(Culture);'))" />
        </ItemGroup>
        <Error Condition="'@(_LocaleFileOfAnotherCulture)' != ''" Text="This locale pack declares the culture '$(LocalePackCulture)', and @(_LocaleFileOfAnotherCulture->'%(Identity)', ', ') is for another." />
    </Target>

    <!-- Answers a project that references this pack directly rather than through its package, which imports no targets file, so that it can record the pack itself. -->
    <Target Name="GetLocalePackName" Condition="'$(IsLocalePack)' == 'true'" Returns="$(AssemblyName)" />

</Project>
