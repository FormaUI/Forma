<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>A resource provider that converts Word, Excel and PowerPoint documents into sanitized HTML, so FormaFileViewer renders a .docx, .xlsx or .pptx file as a page.</Description>
        <IsPackable>true</IsPackable>
        <RootNamespace>Forma.Framework.Resources.Office</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\..\Framework\Forma.Framework.Resources\Forma.Framework.Resources.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="HtmlSanitizer" />
      <PackageReference Include="OfficeIMO.Excel" />
      <PackageReference Include="OfficeIMO.PowerPoint" />
      <PackageReference Include="OfficeIMO.Word.Html" />
    </ItemGroup>

</Project>
