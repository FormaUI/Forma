<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- The AddOn borrows the namespace of the composer plugins it joins, so a host reaches it with the using it already writes. -->
        <RootNamespace>Forma.Blazor.Components.Composer.Plugins</RootNamespace>
        <StaticWebAssetBasePath>_content/$(AssemblyName)</StaticWebAssetBasePath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" />
    </ItemGroup>

    <!-- The contracts the plugin is written against, the explorer its dialog composes, and the product both build on; each is a package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Forma.Framework.Composer.Extensibility\Forma.Framework.Composer.Extensibility.csproj" />
        <ProjectReference Include="..\..\Blazor\Forma.Blazor.Explorer\Forma.Blazor.Explorer.csproj" />
        <ProjectReference Include="..\..\Blazor\Forma.Blazor\Forma.Blazor.csproj" />
    </ItemGroup>

    <!-- The explorer's engine, which its dialog speaks, a package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Forma.Framework.Explorer\Forma.Framework.Explorer.csproj" />
    </ItemGroup>

    <Import Project="$(ComponentAnalyzersTargets)" />

    <!-- The translations embed in the assembly itself rather than in satellite assemblies, so packing them again as content only duplicates them. -->
    <ItemGroup>
        <EmbeddedResource Include=".locales\**\*.json" WithCulture="false" />
        <Content Remove=".locales\**\*.json" />
    </ItemGroup>

</Project>
