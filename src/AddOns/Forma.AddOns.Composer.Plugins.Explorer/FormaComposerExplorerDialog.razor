@namespace Forma.Blazor.Components.Composer.Plugins
@using Forma.Blazor.Components.Explorer
@using Forma.Blazor.Components.Feedback
@inherits FormaComponentBase

@if (_itemsProvider is not null)
{
    <div class="forma-composer-explorer-library">
        @if (_folders is { } folders)
        {
            <FormaExplorer ItemsProvider="_itemsProvider"
                           Folders="folders"
                           Store="_store"
                           Selected="_selectedItems"
                           SelectedChanged="HandleSelectedChanged"
                           OnFileActivated="HandleFileActivatedAsync"
                           Options="LibraryOptions"
                           ItemOptions="LibraryItemOptions"
                           Constraints="UploadConstraints"
                           SearchPlaceholder="@L["Search files"]" />
        }
        else
        {
            <div class="forma-composer-explorer-loading">
                <FormaSpinner Label="@L["Loading folders"]" />
            </div>
        }
    </div>
}
