<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <RootNamespace>Forma.Framework.Emojis.Twemoji</RootNamespace>
        <StaticWebAssetBasePath>_content/$(AssemblyName)</StaticWebAssetBasePath>
    </PropertyGroup>

    <!-- The emoji artwork ships in this package, so its notice travels with it. -->
    <ItemGroup>
        <None Include="..\..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Forma.Framework\Forma.Framework.Emojis\Forma.Framework.Emojis.csproj" />
    </ItemGroup>

    <!-- Embedded in the assembly, so packing it again as content only duplicates it. -->
    <ItemGroup>
        <EmbeddedResource Include="_assets\**\*.json" />
        <Content Remove="_assets\**\*.json" />
    </ItemGroup>

</Project>
