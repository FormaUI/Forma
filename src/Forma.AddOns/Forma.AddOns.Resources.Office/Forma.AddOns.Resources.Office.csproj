<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <RootNamespace>Forma.Framework.Resources.Office</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Forma.Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\..\Forma.Framework\Forma.Framework.Resources\Forma.Framework.Resources.csproj" />
    </ItemGroup>

    <!-- The translations embed in the assembly itself rather than in satellite assemblies. -->
    <ItemGroup>
        <EmbeddedResource Include=".locales\**\*.json" WithCulture="false" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="HtmlSanitizer" />
      <PackageReference Include="OfficeIMO.Excel" />
      <PackageReference Include="OfficeIMO.PowerPoint" />
      <PackageReference Include="OfficeIMO.Word.Html" />
    </ItemGroup>

</Project>
