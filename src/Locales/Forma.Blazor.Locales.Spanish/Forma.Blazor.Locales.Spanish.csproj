<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>The Spanish localization of Forma, as a locale pack: a package of locale files alone, carrying the Spanish strings of Forma.Blazor, Forma.Blazor.Composer, Forma.Blazor.DataView and Forma.Blazor.Explorer.</Description>
        <IsPackable>true</IsPackable>
        <IsLocalePack>true</IsLocalePack>
        <LocalePackCulture>es</LocalePackCulture>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
    </ItemGroup>

</Project>
