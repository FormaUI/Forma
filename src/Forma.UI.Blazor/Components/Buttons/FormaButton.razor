@namespace Forma.UI.Blazor.Components.Buttons

<button @attributes="AdditionalAttributes"
        class="@CssClass"
        type="@TypeAttribute"
        disabled="@Disabled"
        data-busy="@DataBusy"
        aria-disabled="@AriaDisabled"
        aria-busy="@AriaBusy"
        @ref="Element"
        @onclick="HandleClickAsync"
        @onclick:preventDefault="Busy">@if (BusyText is null)
    {
        @ChildContent
    }
    else
    {
        <span class="forma-button-labels"><span class="forma-button-label">@ChildContent</span><span class="forma-button-busy-label">@BusyText</span></span>
    }<span class="forma-button-progress" aria-hidden="true"><span class="forma-button-progress-fill"></span><span class="forma-button-progress-fill"></span></span></button>
