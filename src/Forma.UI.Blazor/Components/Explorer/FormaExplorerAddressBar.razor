@namespace Forma.UI.Blazor.Components.Explorer
@using Forma.UI.Blazor.Components.Navigation

<div class="forma-explorer-address-bar @(!string.IsNullOrEmpty(SearchQuery) ? "has-search-query" : "")">
    <div class="forma-explorer-nav-buttons" role="group" aria-label="@L["Navigation"]">
        <button type="button"
                class="forma-explorer-nav-button"
                disabled="@(!CanGoBack)"
                aria-label="@L["Back"]"
                @onclick="OnBack">
            <span class="forma-explorer-nav-arrow" aria-hidden="true"><FormaGlyph Name="Glyph.ArrowLeft" /></span>
        </button>
        <button type="button"
                class="forma-explorer-nav-button"
                disabled="@(!CanGoForward)"
                aria-label="@L["Forward"]"
                @onclick="OnForward">
            <span class="forma-explorer-nav-arrow" aria-hidden="true"><FormaGlyph Name="Glyph.ArrowRight" /></span>
        </button>
        <button type="button"
                class="forma-explorer-nav-button"
                disabled="@(!CanGoUp)"
                aria-label="@L["Up to Parent Folder"]"
                @onclick="OnUp">
            <FormaGlyph Name="Glyph.ArrowUp" />
        </button>
        <button type="button"
                class="forma-explorer-nav-button"
                aria-label="@L["Refresh"]"
                @onclick="OnRefresh">
            <FormaGlyph Name="Glyph.RotateRight" />
        </button>
    </div>

    <div class="forma-explorer-breadcrumb-bar">
        <FormaBreadcrumb Items="Items"
                        RootIcon="Glyph.FolderOpen"
                        AriaLabel="@L["Folder Path"]"
                        OnItemClick="OnFolderSelected"
                        OnItemDrop="OnBreadcrumbDrop" />
    </div>

    <div class="forma-explorer-search-wrapper">
        <FormaSearchBox Value="@SearchQuery"
                        ValueChanged="HandleSearchValueChangedAsync"
                        Placeholder="@SearchPlaceholder"
                        aria-label="@SearchPlaceholder" />
    </div>
</div>
