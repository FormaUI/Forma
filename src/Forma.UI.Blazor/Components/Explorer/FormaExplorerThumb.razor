@namespace Forma.UI.Blazor.Components.Explorer
@using Forma.Framework.Resources

@if (Resource is ImageResourceInfo)
{
    <img src="@Resource.Source" alt="" class="forma-explorer-thumb @SizeClass" loading="lazy" />
}
else
{
    <span class="forma-explorer-thumb forma-explorer-thumb-glyph @SizeClass" aria-hidden="true"><FormaGlyph Name="KindGlyph" /></span>
}
