@namespace Forma.UI.Blazor.Components.Explorer
@using Forma.UI.Blazor.Components.Buttons
@using Forma.UI.Blazor.Components.Menus

<div class="forma-explorer-toolbar">
    <span class="forma-explorer-visually-hidden" role="status" aria-live="polite">@SelectionAnnouncement</span>

    @if (SelectedCount > 0)
    {
        <div class="forma-explorer-selection-bar">
            <div class="forma-explorer-selection-actions">
                @if (FileOptions.AllowDelete)
                {
                    <FormaButton Variant="ButtonVariant.Danger" Size="ButtonSize.Mini" class="forma-explorer-delete-button" OnClick="OnDelete">
                        <FormaGlyph Name="Glyph.Trash" />
                        @L["Delete"]
                    </FormaButton>
                }
                <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" class="forma-explorer-clear-button" OnClick="OnClearSelection">
                    <FormaGlyph Name="Glyph.SquareMinus" />
                    @L["Clear"]
                </FormaButton>
            </div>

            <div class="forma-explorer-selection-status">
                <span class="forma-explorer-selection-label">@L["{SelectedCount} selected", SelectedCount]</span>
                <FormaCloseButton class="forma-explorer-exit-select-button"
                                  Label="@L["Leave Selection Mode"]"
                                  OnClick="OnToggleSelectMode" />
            </div>
        </div>
    }
    else
    {
    <div class="forma-explorer-toolbar-left">
        <FormaButton Variant="@(IsSelectMode ? ButtonVariant.Primary : ButtonVariant.Ghost)"
                     Size="ButtonSize.Mini"
                     class="forma-explorer-select-mode-button"
                     aria-pressed="@(IsSelectMode ? "true" : "false")"
                     OnClick="OnToggleSelectMode">
            @if (IsSelectMode)
            {
                <FormaGlyph Name="Glyph.Xmark" />
                @L["Cancel"]
            }
            else
            {
                <FormaGlyph Name="Glyph.SquareCheck" />
                @L["Select"]
            }
        </FormaButton>
        @if (FileOptions.AllowFolderCreate && ShowNewFolder)
        {
            <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" class="forma-explorer-new-folder-button" OnClick="OnFolderCreate">
                <FormaGlyph Name="Glyph.FolderPlus" />
                @L["New Folder"]
            </FormaButton>
        }
        @if (FileOptions.AllowUpload)
        {
            <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" class="forma-explorer-upload-button" OnClick="OnToggleUpload">
                <FormaGlyph Name="Glyph.CloudArrowUp" />
                @L["Upload"]
            </FormaButton>
        }
    </div>

    <div class="forma-explorer-toolbar-right">
        <!-- View Mode Switcher -->
        <div class="forma-explorer-view-modes" role="group" aria-label="@L["View Mode"]">
            <button type="button"
                    class="forma-explorer-view-button @(ViewMode == ExplorerViewMode.Thumbnails ? "is-active" : "")"
                    aria-label="@L["Thumbnails"]"
                    aria-pressed="@(ViewMode == ExplorerViewMode.Thumbnails ? "true" : "false")"
                    @onclick="() => ViewModeChanged.InvokeAsync(ExplorerViewMode.Thumbnails)">
                <FormaGlyph Name="Glyph.BorderAll" />
            </button>
            <button type="button"
                    class="forma-explorer-view-button @(ViewMode == ExplorerViewMode.Details ? "is-active" : "")"
                    aria-label="@L["Details"]"
                    aria-pressed="@(ViewMode == ExplorerViewMode.Details ? "true" : "false")"
                    @onclick="() => ViewModeChanged.InvokeAsync(ExplorerViewMode.Details)">
                <FormaGlyph Name="Glyph.TableList" />
            </button>
            <button type="button"
                    class="forma-explorer-view-button @(ViewMode == ExplorerViewMode.List ? "is-active" : "")"
                    aria-label="@L["List"]"
                    aria-pressed="@(ViewMode == ExplorerViewMode.List ? "true" : "false")"
                    @onclick="() => ViewModeChanged.InvokeAsync(ExplorerViewMode.List)">
                <FormaGlyph Name="Glyph.List" />
            </button>
        </div>

        <!-- Sort Menu -->
        <FormaDropDownMenu class="forma-explorer-sort-trigger"
                           TriggerOptions="SortTriggerOptions"
                           aria-label="@L["Sort By"]">
            <Trigger>
                <FormaGlyph Name="@DirectionGlyph" />
                <span class="forma-explorer-sort-trigger-text">@SortFieldLabel(SortField)</span>
                <span class="forma-explorer-sort-trigger-caret" aria-hidden="true"><FormaGlyph Name="Glyph.ChevronDown" /></span>
            </Trigger>
            <ChildContent>
                <div role="group" aria-label="@L["Sort By"]">
                    @foreach (var field in SortFields)
                    {
                        <FormaDropDownMenuItem IsSelected="@(SortField == field)"
                                               data-sort-field="@field"
                                               OnClick="() => SortFieldChanged.InvokeAsync(field)">
                            <span>@SortFieldLabel(field)</span>
                        </FormaDropDownMenuItem>
                    }
                </div>
                <FormaDropDownMenuDivider />
                <div role="group" aria-label="@L["Sort Direction"]">
                    @foreach (var direction in SortDirections)
                    {
                        <FormaDropDownMenuItem IsSelected="@(SortDirection == direction)"
                                               data-sort-direction="@direction"
                                               OnClick="() => SortDirectionChanged.InvokeAsync(direction)">
                            <FormaGlyph Name="@GlyphFor(direction)" />
                            <span>@DirectionLabel(direction)</span>
                        </FormaDropDownMenuItem>
                    }
                </div>
            </ChildContent>
        </FormaDropDownMenu>
    </div>
    }
</div>
