@namespace Forma.UI.Blazor.Components.Explorer
@using Forma.UI.Blazor.Components.Buttons
@using Forma.UI.Blazor.Components.Menus
@using Forma.UI.Features.Explorer

<div class="forma-explorer-toolbar">
    <span class="forma-explorer-visually-hidden" role="status" aria-live="polite">@SelectionAnnouncement</span>

    @if (SelectedCount > 0)
    {
        <div class="forma-explorer-selection-bar">
            <div class="forma-explorer-selection-actions">
                @if (FileOptions.AllowDelete)
                {
                    <FormaButton Variant="ButtonVariant.Danger" class="forma-explorer-delete-button" OnClick="OnDelete">
                        <FormaIcon Icon="Glyph.Delete" Size="IconSize.Small" />
                        @L["Delete"]
                    </FormaButton>
                }
                <FormaToggleButton Icon="Glyph.SelectNone" Label="@L["Clear"]" ShowLabel="true" class="forma-explorer-clear-button" OnClick="OnClearSelection" />
            </div>

            <div class="forma-explorer-selection-status">
                <span class="forma-explorer-selection-label">@L["{SelectedCount} selected", SelectedCount]</span>
                @if (CanLeaveSelectMode)
                {
                    <FormaCloseButton class="forma-explorer-exit-select-button"
                                      Label="@L["Leave Selection Mode"]"
                                      OnClick="OnToggleSelectMode" />
                }
            </div>
        </div>
    }
    else
    {
    <div class="forma-explorer-toolbar-left">
        @if (CanLeaveSelectMode)
        {
            <FormaToggleButton Icon="@(IsSelectMode ? Glyph.Cross : Glyph.Select)"
                                Label="@(IsSelectMode ? L["Cancel"] : L["Select"])"
                                ShowLabel="true"
                                Pressed="IsSelectMode"
                                class="forma-explorer-select-mode-button"
                                OnClick="OnToggleSelectMode" />
        }
        @if (FileOptions.AllowFolderCreate && ShowNewFolder)
        {
            <FormaToggleButton Icon="Glyph.FolderAdd" Label="@L["New Folder"]" ShowLabel="true" class="forma-explorer-new-folder-button" OnClick="OnFolderCreate" />
        }
        @if (FileOptions.AllowUpload)
        {
            <FormaToggleButton Icon="Glyph.CloudUpload" Label="@L["Upload"]" ShowLabel="true" class="forma-explorer-upload-button" OnClick="OnToggleUpload" />
        }
    </div>

    <div class="forma-explorer-toolbar-right">
        <!-- View Mode Switcher -->
        <div class="forma-explorer-view-modes" role="group" aria-label="@L["View Mode"]">
            <FormaToggleButton Icon="Glyph.GridView"
                                Label="@L["Thumbnails"]"
                                class="forma-explorer-view-button"
                                Pressed="@(ViewMode == ExplorerViewMode.Thumbnails)"
                                OnClick="() => ViewModeChanged.InvokeAsync(ExplorerViewMode.Thumbnails)" />
            <FormaToggleButton Icon="Glyph.DetailsView"
                                Label="@L["Details"]"
                                class="forma-explorer-view-button"
                                Pressed="@(ViewMode == ExplorerViewMode.Details)"
                                OnClick="() => ViewModeChanged.InvokeAsync(ExplorerViewMode.Details)" />
            <FormaToggleButton Icon="Glyph.List"
                                Label="@L["List"]"
                                class="forma-explorer-view-button"
                                Pressed="@(ViewMode == ExplorerViewMode.List)"
                                OnClick="() => ViewModeChanged.InvokeAsync(ExplorerViewMode.List)" />
        </div>

        <!-- Sort Menu -->
        <FormaDropDownMenu class="forma-explorer-sort-trigger"
                           TriggerOptions="SortTriggerOptions"
                           aria-label="@L["Sort By"]">
            <Trigger>
                <FormaIcon Icon="@DirectionGlyph" Size="IconSize.Small" />
                <span class="forma-explorer-sort-trigger-text">@SortFieldLabel(SortField)</span>
                <span class="forma-explorer-sort-trigger-caret" aria-hidden="true"><FormaIcon Icon="Glyph.ChevronDown" /></span>
            </Trigger>
            <ChildContent>
                <div role="group" aria-label="@L["Sort By"]">
                    @foreach (var field in SortFields)
                    {
                        <FormaDropDownMenuItem IsSelected="@(SortField == field)"
                                               data-sort-field="@field"
                                               OnClick="() => SortFieldChanged.InvokeAsync(field)">
                            <span>@SortFieldLabel(field)</span>
                        </FormaDropDownMenuItem>
                    }
                </div>
                <FormaDropDownMenuDivider />
                <div role="group" aria-label="@L["Sort Direction"]">
                    @foreach (var direction in SortDirections)
                    {
                        <FormaDropDownMenuItem IsSelected="@(SortDirection == direction)"
                                               data-sort-direction="@direction"
                                               OnClick="() => SortDirectionChanged.InvokeAsync(direction)">
                            <FormaIcon Icon="@GlyphFor(SortField, direction)" Size="IconSize.Small" />
                            <span>@DirectionLabel(direction)</span>
                        </FormaDropDownMenuItem>
                    }
                </div>
            </ChildContent>
        </FormaDropDownMenu>
    </div>
    }
</div>
