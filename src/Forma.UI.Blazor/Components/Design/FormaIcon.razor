@namespace Forma.UI.Blazor.Components.Design

@if (_artwork is IconVector vector)
{
    <svg class="@CssClass"
         viewBox="@vector.ViewBox"
         fill="currentColor"
         aria-hidden="true"
         focusable="false">@foreach (var path in vector.Paths)
                           {
                               <path d="@path.Data" opacity="@Fade(path)" />
                           }</svg>
}
else if (_artwork is IconCharacter character)
{
    <span class="@CssClass forma-icon-character" aria-hidden="true">@character.Text</span>
}
