@namespace Forma.UI.Blazor.Components.Design

@if (_artwork is IconVector vector)
{
    <svg class="@CssClass"
         viewBox="@vector.ViewBox"
         fill="currentColor"
         aria-hidden="true"
         focusable="false">@foreach (var path in vector.Paths)
                           {
                               if (path.StrokeWidth > 0)
                               {
                                   <path d="@path.Data" fill="none" stroke="currentColor" stroke-width="@Width(path)" stroke-linecap="round" stroke-linejoin="round" opacity="@Fade(path)" />
                               }
                               else
                               {
                                   <path d="@path.Data" fill-rule="evenodd" opacity="@Fade(path)" />
                               }
                           }</svg>
}
