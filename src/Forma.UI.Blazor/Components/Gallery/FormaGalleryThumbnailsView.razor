@namespace Forma.UI.Blazor.Components.Gallery

<div class="forma-gallery-grid" role="list">
    @foreach (var resource in Resources)
    {
        var selected = Context.Selection.IsSelected(resource);
        var selecting = Context.Selection.IsSelectMode && !Context.Selection.HasFolders;

        <div class="forma-gallery-item @(selected ? "is-selected" : "")"
             role="listitem"
             draggable="true"
             @ondragstart="() => Context.BeginDrag(resource)">
            <div class="forma-gallery-thumbnail-wrap">
                <FormaGalleryThumb Resource="resource" Size="GalleryThumbSize.Tile" />

                <button type="button"
                        class="forma-gallery-item-open"
                        aria-label="@Context.ActivateLabel(resource)"
                        aria-pressed="@(Context.Selection.IsSelectMode ? (selected ? "true" : "false") : null)"
                        @onclick="() => Context.ActivateAsync(resource)"></button>

                <span class="forma-gallery-item-lead">
                    @if (selecting)
                    {
                        <span class="forma-gallery-item-select @(selected ? "is-checked" : "")" aria-hidden="true">
                            <FormaGlyph Name="Glyph.Check" />
                        </span>
                    }
                    else
                    {
                        <FormaGalleryActionBar Resource="resource" />
                    }
                </span>
            </div>

            <div class="forma-gallery-item-info">
                <span class="forma-gallery-item-name" dir="auto" title="@resource.Name">@resource.Name</span>
                @if (resource.DisplaySize is { } size)
                {
                    <span class="forma-gallery-item-size" dir="auto">@size</span>
                }
            </div>
        </div>
    }
</div>
