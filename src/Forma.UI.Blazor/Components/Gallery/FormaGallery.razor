@namespace Forma.UI.Blazor.Components.Gallery
@using Forma.UI.Blazor.Components.Actions
@using Forma.UI.Blazor.Components.Data
@using Forma.UI.Blazor.Components.Feedback
@using Forma.UI.Blazor.Components.Files

<CascadingValue Value="_context" IsFixed="false">
<div class="forma-gallery @(Options.Resizable ? "is-resizable" : "") @(Options.AsDialog ? "is-dialog" : "")">
    <!-- Top Explorer Address Bar -->
    <FormaGalleryAddressBar Breadcrumbs="Breadcrumbs"
                            CanGoBack="CanGoBack"
                            CanGoForward="CanGoForward"
                            CanGoUp="CanGoUp"
                            CurrentFolder="CurrentFolder"
                            Folders="Folders ?? []"
                            ShowFolderMenu="Options.ShowFolderMenu"
                            Placeholder="@SearchPlaceholder"
                            SearchQuery="@_searchQuery"
                            OnBack="HandleBackAsync"
                            OnForward="HandleForwardAsync"
                            OnUp="HandleUpAsync"
                            OnRefresh="HandleRefreshAsync"
                            OnFolderSelected="HandleFolderSelectedAsync"
                            OnBreadcrumbDrop="HandleDropOnFolderAsync"
                            OnSearchQueryChanged="HandleSearchQueryChangedAsync" />

    <!-- Action & View Toolbar -->
    <FormaGalleryToolbar IsSelectMode="_context.Selection.IsSelectMode"
                         FileOptions="FileOptions"
                         SelectedCount="_context.Selection.Count"
                         SortDirection="_sortDirection"
                         SortField="_sortField"
                         ViewMode="_viewMode"
                         OnClearSelection="ClearSelectionAsync"
                         OnDelete="() => OpenDeleteDialog()"
                         OnFolderCreate="() => OpenFolderDialogAsync(CurrentFolder)"
                         ShowNewFolder="@(!ShowsSidebar)"
                         OnSortDirectionChanged="HandleSortDirectionChangedAsync"
                         OnSortFieldChanged="HandleSortFieldChangedAsync"
                         OnToggleUpload="ToggleUpload"
                         OnToggleSelectMode="ToggleSelectModeAsync"
                         OnViewModeChanged="HandleViewModeChangedAsync" />

    <!-- Refusal notice; the region stays in the DOM so a message inserted into it is announced -->
    <div class="forma-gallery-rejection-region" role="alert">
        @if (_rejectionMessage is { Length: > 0 } rejection)
        {
            <div class="forma-gallery-rejection">
                <span class="forma-gallery-rejection-icon" aria-hidden="true"><FormaGlyph Name="Glyph.CircleExclamation" /></span>
                <span class="forma-gallery-rejection-text">@rejection</span>
                <FormaCloseButton Label="@L["Dismiss"]" OnClick="() => _rejectionMessage = null" />
            </div>
        }
    </div>

    <!-- Collapsible Upload Intake Panel -->
    @if (_isUploadOpen)
    {
        <div class="forma-gallery-upload-panel">
            <div class="forma-gallery-upload-header">
                <h4 class="forma-gallery-upload-title">@L["Upload media"]</h4>
                <FormaCloseButton Label="@L["Close upload"]" OnClick="CloseUpload" />
            </div>
            <FormaFilePicker Accept="image/*,video/*,audio/*"
                             OnFilesSelected="HandleUploadFilesPickedAsync" />
            @if (_pickedUploadFiles is { Count: > 0 })
            {
                <FormaFileUploader Files="_pickedUploadFiles"
                                   Store="Store"
                                   OnCompleted="HandleUploadCompletedAsync" />
            }
        </div>
    }

    <!-- Main Layout: Sidebar & Content -->
    <div class="forma-gallery-body @(_isResizingSidebar ? "is-resizing" : "")" style="@SidebarSizeStyle">
        @if (ShowsSidebar)
        {
            <FormaGallerySidebar CurrentFolder="CurrentFolder"
                                 FileOptions="FileOptions"
                                 Folders="Folders"
                                 TotalCount="TotalCount ?? Resources?.Count ?? MatchingCount ?? 0"
                                 OnFolderDelete="OpenFolderDeleteDialog"
                                 OnFolderDragStart="folder => _draggedFolder = folder"
                                 OnFolderDrop="HandleDropOnFolderAsync"
                                 OnFolderCreate="OpenFolderDialogAsync"
                                 OnFolderRename="OpenFolderRenameDialog"
                                 OnFolderSelected="HandleFolderSelectedAsync" />

            <div class="forma-gallery-splitter @(_isResizingSidebar ? "is-resizing" : "")"
                 @ref="_splitterElement"
                 role="separator"
                 aria-orientation="vertical"
                 aria-label="@L["Resize folders panel"]"
                 aria-valuemin="@MinSidebarWidth"
                 aria-valuemax="@MaxSidebarWidth"
                 aria-valuenow="@((int)Math.Round(_sidebarWidth))"
                 tabindex="0"
                 @onpointerdown="HandleSplitterPointerDownAsync"
                 @onpointermove="HandleSplitterPointerMove"
                 @onpointerup="HandleSplitterPointerUpAsync"
                 @onpointercancel="HandleSplitterPointerUpAsync"
                 @onkeydown="HandleSplitterKeyDown">
                <span class="forma-gallery-splitter-grip" aria-hidden="true"></span>
            </div>
        }

        <div class="forma-gallery-content">
            <div class="forma-gallery-scroll @(_isQuerying ? "is-busy" : "")" id="@_scrollId" aria-busy="@(_isQuerying ? "true" : "false")">
                @if (VisibleResources.Count == 0)
                {
                    <div class="forma-gallery-empty" role="status">
                        <span class="forma-gallery-empty-icon" aria-hidden="true"><FormaGlyph Name="Glyph.Images" /></span>
                        @if (_isQuerying)
                        {
                            <p>@L["Loading media"]</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(_searchQuery))
                        {
                            <p>@L["No media matches \"{query}\"", ("query", _searchQuery)]</p>
                        }
                        else if (CurrentFolder is not null)
                        {
                            <p>@L["No media in this folder"]</p>
                        }
                        else
                        {
                            <p>@L["No media found"]</p>
                        }
                    </div>
                }
                else
                {
                    @if (_viewMode == GalleryViewMode.Thumbnails)
                    {
                        <FormaGalleryThumbnailsView Resources="VisibleResources" />
                    }
                    else if (_viewMode == GalleryViewMode.Details)
                    {
                        <FormaGalleryDetailsView Resources="VisibleResources" />
                    }
                    else
                    {
                        <FormaGalleryListView Resources="VisibleResources" />
                    }
                }

                @if (IsInfiniteScrolling && HasMorePages)
                {
                    <div class="forma-gallery-scroll-sentinel" id="@_sentinelId">
                        @if (Options.InfiniteScroll == GalleryInfiniteScrollMode.Automatic)
                        {
                            @if (_isLoadingPage)
                            {
                                <span class="forma-gallery-spinner" aria-hidden="true"></span>
                            }
                        }
                        else
                        {
                            <FormaButton Variant="ButtonVariant.Ghost" class="forma-gallery-load-more-btn" OnClick="LoadNextPageAsync">
                                <span class="forma-gallery-load-more-icon" aria-hidden="true"><FormaGlyph Name="Glyph.ChevronDown" /></span>
                                @L["Load more"]
                            </FormaButton>
                        }
                    </div>
                }
            </div>

            @if (IsInfiniteScrolling && VisibleResources.Count > 0)
            {
                <div class="forma-gallery-scroll-status" role="status">
                    @if (MatchingCount is { } total)
                    {
                        @L["Showing {shown} of {total}", ("shown", VisibleResources.Count), ("total", total)]
                    }
                    else
                    {
                        @L["Showing {shown}", ("shown", VisibleResources.Count)]
                    }
                </div>
            }

            @if (MatchingCount is not null && PageCount > 1 && !IsInfiniteScrolling)
            {
                <div class="forma-gallery-pagination">
                    <FormaPagination TotalItems="MatchingCount ?? 0"
                                     PageSize="PageSize"
                                     CurrentPage="EffectivePage"
                                     OnPageChanged="HandlePageChangedAsync" />
                </div>
            }
        </div>
    </div>

    <!-- Preview Lightbox Modal -->
    @if (_previewResource is { } preview)
    {
        <FormaModal Opened="true"
                    Size="ModalSize.ExtraLarge"
                    Title="@preview.Name"
                    Options="DialogModalOptions"
                    OnClose="ClosePreview">
            <Body>
                <FormaFileViewer Source="@preview.Source"
                                 Siblings="_previewSiblings"
                                 OnNavigate="HandlePreviewNavigate" />
            </Body>
        </FormaModal>
    }

    <!-- Rename Media Modal -->
    @if (_renamingResource is not null)
    {
        <FormaModal Opened="@(_renamingResource is not null)"
                    Size="ModalSize.Small"
                    Title="@L["Rename media"]"
                    Options="DialogModalOptions"
                    OnClose="CloseRenameDialog">
            <Body>
                <div class="forma-gallery-dialog-field">
                    <label class="forma-gallery-dialog-label" for="forma-gallery-rename-input">@L["New name"]</label>
                    <input id="forma-gallery-rename-input"
                           class="forma-gallery-dialog-input"
                           type="text"
                           value="@_renameNewName"
                           @oninput="e => _renameNewName = e.Value?.ToString() ?? string.Empty" />
                </div>
            </Body>
            <Footer>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="CloseRenameDialog">
                    @L["Cancel"]
                </FormaButton>
                <FormaButton Variant="ButtonVariant.Primary" OnClick="HandleRenameConfirmedAsync">
                    @L["Save"]
                </FormaButton>
            </Footer>
        </FormaModal>
    }

    <!-- Delete Media Modal -->
    @if (_deletingResources is not null)
    {
        <FormaModal Opened="@(_deletingResources is not null)"
                    Size="ModalSize.Small"
                    Title="@L["Delete media"]"
                    Options="DialogModalOptions"
                    OnClose="CloseDeleteDialog">
            <Body>
                <p class="forma-gallery-delete-message">@DeleteConfirmMessage</p>
            </Body>
            <Footer>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="CloseDeleteDialog">
                    @L["Cancel"]
                </FormaButton>
                <FormaButton Variant="ButtonVariant.Danger" OnClick="HandleDeleteConfirmedAsync">
                    @L["Delete"]
                </FormaButton>
            </Footer>
        </FormaModal>
    }

    <!-- Create Folder Modal -->
    @if (_isNewFolderOpen)
    {
        <FormaModal Opened="_isNewFolderOpen"
                    Size="ModalSize.Small"
                    Title="@L["New folder"]"
                    Options="DialogModalOptions"
                    OnClose="CloseFolderDialog">
            <Body>
                <div class="forma-gallery-dialog-field">
                    <label class="forma-gallery-dialog-label" for="forma-gallery-folder-input">@L["Folder name"]</label>
                    <input id="forma-gallery-folder-input"
                           class="forma-gallery-dialog-input"
                           type="text"
                           value="@_newFolderName"
                           @oninput="e => _newFolderName = e.Value?.ToString() ?? string.Empty" />
                </div>
            </Body>
            <Footer>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="CloseFolderDialog">
                    @L["Cancel"]
                </FormaButton>
                <FormaButton Variant="ButtonVariant.Primary" OnClick="HandleCreateFolderAsync">
                    @L["Create"]
                </FormaButton>
            </Footer>
        </FormaModal>
    }

    <!-- Rename Folder Modal -->
    @if (_renamingFolder is not null)
    {
        <FormaModal Opened="@(_renamingFolder is not null)"
                    Size="ModalSize.Small"
                    Title="@L["Rename folder"]"
                    Options="DialogModalOptions"
                    OnClose="CloseFolderRenameDialog">
            <Body>
                <div class="forma-gallery-dialog-field">
                    <label class="forma-gallery-dialog-label" for="forma-gallery-rename-folder-input">@L["Folder name"]</label>
                    <input id="forma-gallery-rename-folder-input"
                           class="forma-gallery-dialog-input"
                           type="text"
                           value="@_renameFolderName"
                           @oninput="e => _renameFolderName = e.Value?.ToString() ?? string.Empty" />
                </div>
            </Body>
            <Footer>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="CloseFolderRenameDialog">
                    @L["Cancel"]
                </FormaButton>
                <FormaButton Variant="ButtonVariant.Primary" OnClick="HandleFolderRenameConfirmedAsync">
                    @L["Save"]
                </FormaButton>
            </Footer>
        </FormaModal>
    }

    <!-- Delete Folder Modal -->
    @if (_deletingFolders is { Count: > 0 })
    {
        <FormaModal Opened="@(_deletingFolders is { Count: > 0 })"
                    Size="ModalSize.Small"
                    Title="@L["Delete folder"]"
                    Options="DialogModalOptions"
                    OnClose="CloseFolderDeleteDialog">
            <Body>
                <p class="forma-gallery-delete-message">@FolderDeleteConfirmMessage</p>
            </Body>
            <Footer>
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="CloseFolderDeleteDialog">
                    @L["Cancel"]
                </FormaButton>
                <FormaButton Variant="ButtonVariant.Danger" OnClick="HandleFolderDeleteConfirmedAsync">
                    @L["Delete"]
                </FormaButton>
            </Footer>
        </FormaModal>
    }
</div>
</CascadingValue>
