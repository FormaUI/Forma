@namespace Forma.UI.Blazor.Components.Gallery

@{
    var children = Sidebar.ChildrenOf(Folder.Source);
    var expanded = Sidebar.IsExpanded(Folder.Source);
    var isCurrent = Sidebar.IsCurrent(Folder);
    var selected = Context.Selection.IsFolderSelected(Folder);
    var selectable = Context.Selection.IsSelectMode && !Context.Selection.HasResources;
}

<li role="treeitem"
    aria-selected="@(isCurrent ? "true" : "false")"
    aria-expanded="@(children.Count == 0 ? null : expanded ? "true" : "false")">
    <div class="forma-gallery-folder-row @(isCurrent ? "is-active" : "") @(selected ? "is-selected" : "")"
         style="--forma-gallery-folder-depth: @Depth"
         draggable="true"
         @ondragstart="() => Sidebar.HandleFolderDragStartAsync(Folder)"
         @ondragover="args => FormaGallerySidebar.HandleDragOver(args)"
         @ondragover:preventDefault="true"
         @ondrop="() => Sidebar.HandleDropOnFolderAsync(Folder)">
        @if (selectable)
        {
            <button type="button"
                    class="forma-gallery-folder-select @(selected ? "is-checked" : "")"
                    aria-label="@(selected ? L["Deselect folder \"{name}\"", ("name", Folder.Name)] : L["Select folder \"{name}\"", ("name", Folder.Name)])"
                    aria-pressed="@(selected ? "true" : "false")"
                    @onclick="() => Context.ToggleFolderSelectAsync(Folder)">
                <FormaGlyph Name="Glyph.Check" />
            </button>
        }

        @if (children.Count > 0)
        {
            <button type="button"
                    class="forma-gallery-folder-twisty @(expanded ? "is-expanded" : "")"
                    aria-label="@(expanded ? L["Collapse {name}", ("name", Folder.Name)] : L["Expand {name}", ("name", Folder.Name)])"
                    @onclick="() => Sidebar.ToggleExpanded(Folder.Source)">
                <FormaGlyph Name="Glyph.ChevronRight" />
            </button>
        }
        else
        {
            <span class="forma-gallery-folder-twisty is-empty" aria-hidden="true"></span>
        }

        <button type="button"
                class="forma-gallery-folder-target"
                @onclick="() => Sidebar.SelectFolderAsync(Folder)">
            <span class="forma-gallery-folder-icon" aria-hidden="true"><FormaGlyph Name="@(isCurrent ? Glyph.FolderOpen : Glyph.Folder)" /></span>
            <span class="forma-gallery-folder-name" title="@Folder.Name">@Folder.Name</span>
        </button>

        <div class="forma-gallery-folder-actions">
            @if (Sidebar.FileOptions.AllowFolderCreate)
            {
                <button type="button"
                        class="forma-gallery-folder-action-btn"
                        aria-label="@L["New folder in \"{name}\"", ("name", Folder.Name)]"
                        @onclick="() => Sidebar.CreateFolderAsync(Folder)">
                    <FormaGlyph Name="Glyph.FolderPlus" />
                </button>
            }
            @if (Sidebar.FileOptions.AllowFolderRename)
            {
                <button type="button"
                        class="forma-gallery-folder-action-btn"
                        aria-label="@L["Rename folder \"{name}\"", ("name", Folder.Name)]"
                        @onclick="() => Sidebar.RenameFolderAsync(Folder)">
                    <FormaGlyph Name="Glyph.Pen" />
                </button>
            }
            @if (Sidebar.FileOptions.AllowFolderDelete)
            {
                <button type="button"
                        class="forma-gallery-folder-action-btn forma-gallery-folder-action-delete"
                        aria-label="@L["Delete folder \"{name}\"", ("name", Folder.Name)]"
                        @onclick="() => Sidebar.DeleteFolderAsync(Folder)">
                    <FormaGlyph Name="Glyph.Trash" />
                </button>
            }
        </div>
        @if (Folder.Count is { } count)
        {
            <span class="forma-gallery-folder-count">@count</span>
        }
    </div>

    @if (children.Count > 0 && expanded)
    {
        <ul class="forma-gallery-folder-branch" role="group">
            @foreach (var child in children)
            {
                <FormaGalleryFolderNode Folder="child" Depth="Depth + 1" />
            }
        </ul>
    }
</li>
