@namespace Forma.UI.Components.Gallery

<div class="forma-gallery-address-bar @(!string.IsNullOrEmpty(SearchQuery) ? "has-search-query" : "")">
    <div class="forma-gallery-nav-buttons" role="group" aria-label="@L["Navigation"]">
        <button type="button"
                class="forma-gallery-nav-btn"
                disabled="@(!CanGoBack)"
                aria-label="@L["Back"]"
                @onclick="OnBack">
            <span class="fa-solid fa-arrow-left forma-gallery-nav-arrow" aria-hidden="true"></span>
        </button>
        <button type="button"
                class="forma-gallery-nav-btn"
                disabled="@(!CanGoForward)"
                aria-label="@L["Forward"]"
                @onclick="OnForward">
            <span class="fa-solid fa-arrow-right forma-gallery-nav-arrow" aria-hidden="true"></span>
        </button>
        <button type="button"
                class="forma-gallery-nav-btn"
                disabled="@(!CanGoUp)"
                aria-label="@L["Up to parent folder"]"
                @onclick="OnUp">
            <span class="fa-solid fa-arrow-up" aria-hidden="true"></span>
        </button>
        <button type="button"
                class="forma-gallery-nav-btn"
                aria-label="@L["Refresh"]"
                @onclick="OnRefresh">
            <span class="fa-solid fa-rotate-right" aria-hidden="true"></span>
        </button>
    </div>

    <nav class="forma-gallery-breadcrumb-bar" aria-label="@L["Folder path"]" @onkeydown="HandleMenuKeyDown">
        <span class="fa-solid fa-folder-open forma-gallery-root-icon" aria-hidden="true"></span>

        @for (var index = 0; index < Levels.Count; index++)
        {
            var level = Levels[index];
            var isCurrent = CurrentFolder?.Source == level.Folder?.Source;
            var isLast = index == Levels.Count - 1;
            <button type="button"
                    class="forma-gallery-breadcrumb-item @(isCurrent ? "is-current" : "")"
                    @ondragover="HandleDragOver"
                    @ondragover:preventDefault="true"
                    @ondrop="() => HandleBreadcrumbDrop(level.Folder)"
                    @onclick="() => OnFolderSelected.InvokeAsync(level.Folder)">
                @level.Name
            </button>

            var children = ChildrenOf(level.Parent);

            if (!ShowFolderMenu || children.Count == 0)
            {
                @if (!isLast)
                {
                    <span class="forma-gallery-breadcrumb-separator fa-solid fa-chevron-right" aria-hidden="true"></span>
                }
            }
            else
            {
                var isOpen = _openLevelKey == level.Key;

                <span class="forma-gallery-breadcrumb-level">
                    <button type="button"
                            class="forma-gallery-breadcrumb-chevron @(isOpen ? "is-open" : "")"
                            aria-haspopup="menu"
                            aria-expanded="@(isOpen ? "true" : "false")"
                            aria-label="@L["Folders in {name}", ("name", level.Name)]"
                            @onclick="() => ToggleLevelMenu(level.Key)">
                        <span class="fa-solid fa-chevron-right" aria-hidden="true"></span>
                    </button>

                    @if (isOpen)
                    {
                        <span class="forma-gallery-breadcrumb-backdrop" @onclick="CloseLevelMenu"></span>
                        <span class="forma-gallery-breadcrumb-menu" role="menu">
                            @foreach (var child in children)
                            {
                                <button type="button"
                                        class="forma-gallery-breadcrumb-menu-item"
                                        role="menuitem"
                                        @onclick="() => SelectFromMenuAsync(child)">
                                    <span class="fa-solid fa-folder forma-gallery-menu-icon" aria-hidden="true"></span>
                                    @child.Name
                                </button>
                            }
                        </span>
                    }
                </span>
            }
        }
    </nav>

    <div class="forma-gallery-search-wrap">
        <span class="fa-solid fa-magnifying-glass forma-gallery-search-icon" aria-hidden="true"></span>
        <input class="forma-gallery-search-input"
               type="search"
               value="@SearchQuery"
               placeholder="@SearchPlaceholder"
               aria-label="@SearchPlaceholder"
               @oninput="HandleSearchInput" />
        @if (!string.IsNullOrEmpty(SearchQuery))
        {
            <button type="button"
                    class="forma-gallery-search-clear fa-solid fa-xmark"
                    aria-label="@L["Clear search"]"
                    @onclick="ClearSearch"></button>
        }
    </div>
</div>
