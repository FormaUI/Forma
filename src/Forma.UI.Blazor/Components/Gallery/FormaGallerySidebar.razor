@namespace Forma.UI.Blazor.Components.Gallery

<CascadingValue Value="this" IsFixed="true">
<aside class="forma-gallery-sidebar" aria-labelledby="@_titleId">
    <div class="forma-gallery-sidebar-toolbar">
        <span class="forma-gallery-sidebar-title" id="@_titleId">@L["Folders"]</span>

        <div class="forma-gallery-sidebar-tools">
            @if (FileOptions.AllowFolderCreate)
            {
                <button type="button"
                        class="forma-gallery-sidebar-tool forma-gallery-new-folder-tool"
                        aria-label="@L["New folder"]"
                        @onclick="() => CreateFolderAsync(null)">
                    <FormaGlyph Name="Glyph.FolderPlus" />
                </button>
            }
            <button type="button"
                    class="forma-gallery-sidebar-tool @(IsFullyCollapsed ? "forma-gallery-expand-all-tool" : "forma-gallery-collapse-all-tool")"
                    disabled="@(!HasExpandableFolders)"
                    aria-label="@(IsFullyCollapsed ? L["Expand all folders"] : L["Collapse all folders"])"
                    @onclick="ToggleAll">
                <FormaGlyph Name="@(IsFullyCollapsed ? Glyph.SquarePlus : Glyph.SquareMinus)" />
            </button>
        </div>
    </div>

    <ul class="forma-gallery-folder-tree" role="tree" style="@TreeSizeStyle">
        <li role="treeitem" aria-selected="@(CurrentFolder is null ? "true" : "false")">
            <div class="forma-gallery-folder-row @(CurrentFolder is null ? "is-active" : "")"
                 style="--forma-gallery-folder-depth: 0"
                 @ondragover="HandleDragOver"
                 @ondragover:preventDefault="true"
                 @ondrop="() => HandleDropOnFolderAsync(null)">
                <span class="forma-gallery-folder-twisty is-empty" aria-hidden="true"></span>
                <button type="button"
                        class="forma-gallery-folder-target"
                        @onclick="() => SelectFolderAsync(null)">
                    <span class="forma-gallery-folder-icon" aria-hidden="true"><FormaGlyph Name="@(CurrentFolder is null ? Glyph.FolderOpen : Glyph.Folder)" /></span>
                    <span class="forma-gallery-folder-name">@L["All media"]</span>
                </button>
                <span class="forma-gallery-folder-count">@TotalCount</span>
            </div>
        </li>

        @foreach (var folder in ChildrenOf(null))
        {
            <FormaGalleryFolderNode Folder="folder" Depth="0" />
        }
    </ul>

    <div class="forma-gallery-sidebar-sash @(_isResizingTree ? "is-resizing" : "")"
         @ref="_sashElement"
         role="separator"
         aria-orientation="horizontal"
         aria-label="@L["Resize folder list"]"
         aria-valuemin="@MinTreeHeight"
         aria-valuemax="@MaxTreeHeight"
         aria-valuenow="@((int)Math.Round(_treeHeight ?? MeasuredTreeHeight))"
         tabindex="0"
         @onpointerdown="HandleSashPointerDownAsync"
         @onpointermove="HandleSashPointerMove"
         @onpointerup="HandleSashPointerUpAsync"
         @onpointercancel="HandleSashPointerUpAsync"
         @onkeydown="HandleSashKeyDown">
        <span class="forma-gallery-sidebar-sash-grip" aria-hidden="true"></span>
    </div>
</aside>
</CascadingValue>
