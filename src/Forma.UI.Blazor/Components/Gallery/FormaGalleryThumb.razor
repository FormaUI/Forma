@namespace Forma.UI.Blazor.Components.Gallery
@using Forma.Framework.Resources

@if (Resource is ImageResourceInfo)
{
    <img src="@Resource.Source" alt="" class="forma-gallery-thumb @SizeClass" loading="lazy" />
}
else
{
    <span class="forma-gallery-thumb forma-gallery-thumb-glyph @SizeClass" aria-hidden="true"><FormaGlyph Name="KindGlyph" /></span>
}
