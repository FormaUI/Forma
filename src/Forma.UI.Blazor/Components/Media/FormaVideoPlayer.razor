@namespace Forma.UI.Blazor.Components.Media

<div @attributes="AdditionalAttributes" class="@CssClass">
    @if (ShowFacade)
    {
        <button type="button"
                class="forma-video-player-facade"
                aria-labelledby="@_labelId"
                aria-describedby="@_noteId"
                @onclick="Activate">
            @if (!string.IsNullOrWhiteSpace(Placeholder))
            {
                <img class="forma-video-player-facade-placeholder" src="@Placeholder" alt="" />
            }
            <FormaIcon Icon="Glyph.Play" Class="forma-video-player-facade-glyph" />
            <span id="@_labelId" class="forma-video-player-facade-label">@L["Play {Title}", Title]</span>
            <span id="@_noteId" class="forma-video-player-facade-note">@L["Loads from another site, which will see this visit."]</span>
        </button>
    }
    else if (Frame is NativePlayerFrame native)
    {
        <video @ref="_video"
               class="forma-video-player-frame"
               src="@native.Source"
               title="@Title"
               poster="@Placeholder"
               controls
               playsinline
               autoplay="@Autoplay"
               muted="@Autoplay">
            @foreach (var caption in Captions ?? [])
            {
                <track kind="captions"
                       src="@caption.Source"
                       srclang="@caption.Language"
                       label="@caption.Label"
                       default="@caption.IsDefault" />
            }
        </video>
    }
    else if (Frame is EmbeddedPlayerFrame embedded)
    {
        <iframe class="forma-video-player-frame"
                src="@embedded.Source"
                title="@Title"
                loading="lazy"
                allow="accelerometer; encrypted-media; picture-in-picture"
                allowfullscreen></iframe>
    }
    else if (Frame is HtmlPlayerFrame markup)
    {
        <div role="group" aria-label="@Title">
            @((MarkupString)markup.Html)
            <a class="forma-video-player-fallback"
               href="@markup.Source"
               target="_blank"
               rel="noopener noreferrer">@L["Open this video on its own site."]</a>
        </div>
    }
    else
    {
        <p class="forma-video-player-unavailable">@L["This video is unavailable."]</p>
    }
</div>
