<dialog @ref="_dialogElement"
        class="forma-modal @SizeClass"
        @onclose="HandleDialogClose">
    <div class="forma-modal-dialog">
        @if (ShowHeader)
        {
            <header class="forma-modal-header">
                <h5>@Title</h5>
                <FormaCloseButton Label="@L["Close"]" OnClick="RequestCloseAsync" />
            </header>
        }

        <div class="forma-modal-body @(ShowHeader ? "" : "no-header")">
            @Body
        </div>

        @if (ShowFooter)
        {
            <footer class="forma-modal-footer">
                @if (Footer is not null)
                {
                    <div class="forma-modal-footer-extra">
                        @Footer
                    </div>
                }
                @if (HasDefaultFooterActions)
                {
                    <div class="forma-modal-footer-actions">
                        @if (Options.ShowCancelAction)
                        {
                            <FormaButton Variant="ButtonVariant.Secondary" OnClick="HandleDefaultCancelAsync">
                                @CancelLabel
                            </FormaButton>
                        }
                        @if (Options.ShowConfirmAction)
                        {
                            <FormaButton Variant="ButtonVariant.Primary" OnClick="HandleDefaultConfirmAsync">
                                @ConfirmLabel
                            </FormaButton>
                        }
                    </div>
                }
            </footer>
        }
    </div>
</dialog>
