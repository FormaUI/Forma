@namespace Forma.UI.Blazor.Components.Bars
@{
    RenderFragment items =
        @<text>
    @foreach (var row in Rows)
    {
        <div class="@(row.Group is null ? "forma-toolbar-loose" : "forma-toolbar-group")"
             role="@(row.Group is null ? null : "group")"
             aria-label="@row.Group?.Title"
             @key="row.Key">
            @foreach (var item in row.Items)
            {
                @switch (item)
                {
                    case FormaToolbarCustomItem custom:
                        <DynamicComponent Type="custom.Component" Parameters="ToParameters(custom.Parameters)" @key="custom.Id" />
                        break;

                    case FormaToolbarMenu menu:
                        <FormaDropDownMenu class="forma-toolbar-menu"
                                           @key="menu.Id"
                                           TriggerOptions="MenuTriggerOptions"
                                           disabled="@(Disabled || menu.IsDisabled)"
                                           aria-label="@menu.Title"
                                           title="@GetTooltip(menu)">
                            <Trigger>
                                @if (menu.Icon is { } menuIcon)
                                {
                                    <FormaGlyph Name="menuIcon" />
                                }
                                @if (GetActiveOption(menu).Swatch is { } activeSwatch)
                                {
                                    <span class="forma-toolbar-menu-bar" style="@($"background-color:{activeSwatch}")" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <span class="forma-toolbar-menu-value">@GetActiveOption(menu).Title</span>
                                }
                                <FormaGlyph Name="Glyph.ChevronDown" Class="forma-toolbar-menu-caret" />
                            </Trigger>
                            <ChildContent>
                                @foreach (var option in menu.Options)
                                {
                                    <FormaDropDownMenuItem IsSelected="@IsOptionActive(option)"
                                                           @key="option.Id"
                                                           OnClick="() => OnCommand.InvokeAsync(option.Command)">
                                        @if (option.Swatch is { } swatch)
                                        {
                                            <span class="forma-toolbar-swatch" style="@($"background-color:{swatch}")" aria-hidden="true"></span>
                                        }
                                        <span style="@option.PreviewStyle">@option.Title</span>
                                    </FormaDropDownMenuItem>
                                }
                            </ChildContent>
                        </FormaDropDownMenu>
                        break;

                    case FormaToolbarReadout readout:
                        <span class="forma-toolbar-readout"
                              @key="readout.Id"
                              dir="auto"
                              title="@GetTooltip(readout)"
                              role="@(readout.IsAnnounced ? "status" : null)"
                              aria-live="@(readout.IsAnnounced ? "polite" : null)">@readout.Value</span>
                        break;

                    case FormaToolbarAction action:
                        var isToggleActive = IsToggleActive(action);
                        var showsLabel = action.Icon is null || ShowLabels;
                        var effectiveTitle = EffectiveTitle(action);
                        var effectiveIcon = EffectiveIcon(action);
                        <button type="button"
                                @key="action.Id"
                                class="forma-toolbar-button @(showsLabel ? "forma-toolbar-button-labelled" : null) @(isToggleActive ? "forma-toolbar-button-active" : null)"
                                dir="auto"
                                @onclick="() => OnCommand.InvokeAsync(action.Command)"
                                disabled="@(Disabled || IsUnavailable(action))"
                                aria-label="@(showsLabel ? null : effectiveTitle)"
                                aria-pressed="@(action is FormaToolbarToggle ? (isToggleActive ? "true" : "false") : null)"
                                aria-keyshortcuts="@action.ShortcutAriaKeys"
                                title="@GetActionTitle(action, showsLabel)">
                            @if (effectiveIcon is { } icon)
                            {
                                <FormaGlyph Name="icon" />
                            }
                            @if (showsLabel)
                            {
                                <span>@effectiveTitle</span>
                            }
                        </button>
                        break;
                }
            }
        </div>
    }
        </text>;
}

@if (Scrollable)
{
    <FormaCommandBar role="toolbar"
                     aria-label="@Label"
                     Class="@Class"
                     Hidden="Hidden"
                     Animated="Animated"
                     ScrollBackLabel="@ScrollBackLabel"
                     ScrollForwardLabel="@ScrollForwardLabel"
                     TrailingContent="TrailingContent">@items</FormaCommandBar>
}
else
{
    <FormaVisibility Hidden="Hidden" Animated="Animated">
        <div class="@CssClass" role="toolbar" aria-label="@Label">
            @items
            @TrailingContent
        </div>
    </FormaVisibility>
}
