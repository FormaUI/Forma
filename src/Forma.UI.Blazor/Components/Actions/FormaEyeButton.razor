@namespace Forma.UI.Components.Actions

<FormaButton @attributes="AdditionalAttributes"
             Variant="ButtonVariant.Ghost"
             Size="Size"
             IconOnly="true"
             Disabled="Disabled"
             OnClick="OnClick"
             aria-label="@Label">
    <FormaGlyph Name="@(Revealed ? Glyph.Eye : Glyph.EyeSlash)" />
</FormaButton>
