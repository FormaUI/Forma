@namespace Forma.UI.Blazor.Components.Files
@using Forma.UI.Blazor.Components.Buttons

<div class="forma-file-uploader" aria-busy="@(IsUploading ? "true" : "false")">
    <ul class="forma-file-uploader-list">
        @foreach (var upload in _uploads)
        {
            <li class="forma-file-uploader-item forma-file-uploader-@upload.State.ToString().ToLowerInvariant()">
                <span class="forma-file-uploader-mark" aria-hidden="true"><FormaGlyph Name="StateGlyph(upload.State)" /></span>

                <span class="forma-file-uploader-name">
                    @upload.Name
                    @if (Options.ShowByteCount)
                    {
                        <span class="forma-file-uploader-size"><bdi>(@FileByteCount(upload))</bdi></span>
                    }
                </span>

                @if (Options.ShowTransferRate)
                {
                    <span class="forma-file-uploader-rate"><bdi>@FileRate(upload)</bdi></span>
                }

                <progress class="forma-file-uploader-bar" max="100" value="@upload.Percent" aria-label="@upload.Name"></progress>

                @if (ShowsDuration)
                {
                    <span class="forma-file-uploader-time"><bdi>@FileTime(upload)</bdi></span>
                }

                <span class="forma-file-uploader-state">@StateText(upload.State)</span>
            </li>
        }
    </ul>

    @if (Options.ShowTotalMetrics && ShowsMetrics && _uploads.Count > 1)
    {
        <p class="forma-file-uploader-totals">
            <span class="forma-file-uploader-mark" aria-hidden="true"></span>

            <span class="forma-file-uploader-name">
                <span class="forma-file-uploader-totals-label">@L["All Files"]</span>
                @if (Options.ShowByteCount)
                {
                    <span class="forma-file-uploader-size"><bdi>(@TotalByteCount)</bdi></span>
                }
            </span>

            @if (Options.ShowTransferRate)
            {
                <span class="forma-file-uploader-rate"><bdi>@TotalRate</bdi></span>
            }

            <span class="forma-file-uploader-bar-spacer" aria-hidden="true"></span>

            @if (ShowsDuration)
            {
                <span class="forma-file-uploader-time"><bdi>@TotalTime</bdi></span>
            }

            <span class="forma-file-uploader-state" aria-hidden="true"></span>
        </p>
    }

    @if (Options.ShowSummary)
    {
        <p class="forma-file-uploader-summary" role="status">@Summary</p>
    }

    <div class="forma-file-uploader-actions">
        @if (IsUploading)
        {
            <FormaButton Variant="ButtonVariant.Secondary" OnClick="@(_ => Cancel())">@L["Cancel"]</FormaButton>
        }
        else if (CanStart)
        {
            <FormaButton Variant="ButtonVariant.Primary" OnClick="@(_ => StartAsync())">@L["Upload"]</FormaButton>
        }
    </div>
</div>
