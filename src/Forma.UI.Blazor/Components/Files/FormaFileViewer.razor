@namespace Forma.UI.Blazor.Components.Files
@using Forma.UI.Blazor.Components.Media

@* Focusable only while the arrow keys have somewhere to go, so the viewer never becomes an inert tab stop. *@
<div class="forma-file-viewer"
     tabindex="@(IsNavigable ? "0" : null)"
     role="@(IsNavigable ? "group" : null)"
     aria-label="@(IsNavigable ? DisplayName : null)"
     @onkeydown="HandleKeyDown">
    <div class="forma-file-viewer-content">
        @if (Resource is MarkupResourceInfo markup)
        {
            <div class="forma-file-viewer-html" dir="auto" role="group" aria-label="@DisplayName">
                @((MarkupString)markup.Html)
            </div>
        }
        else if (Resource is ImageResourceInfo)
        {
            <div @ref="_imageFrame" class="forma-file-viewer-image-frame @(IsZoomed ? "zoomed" : "")">
                @* A native image drag would fire dragstart and cancel the pointer mid-pan. *@
                <img class="forma-file-viewer-image"
                     draggable="@(IsZoomed ? "false" : null)"
                     src="@Resource.Source"
                     alt="@DisplayName"
                     style="@(IsZoomed ? $"inline-size: {ZoomPercent}%;" : null)" />
            </div>
            <div class="forma-file-viewer-zoom" role="group" aria-label="@L["Zoom"]">
                <button type="button" class="forma-file-viewer-zoom-button" disabled="@(_zoomIndex == 0)" @onclick="ZoomOut" aria-label="@L["Zoom out"]">
                    <span aria-hidden="true">&minus;</span>
                </button>
                <span class="forma-file-viewer-zoom-level" role="status">@ZoomPercent%</span>
                <button type="button" class="forma-file-viewer-zoom-button" disabled="@(_zoomIndex == ZoomSteps.Length - 1)" @onclick="ZoomIn" aria-label="@L["Zoom in"]">
                    <span aria-hidden="true">+</span>
                </button>
            </div>
        }
        else if (Resource is VideoResourceInfo)
        {
            <FormaVideoPlayer Source="@Resource.Source" Title="@DisplayName" DeferLoading="false" />
        }
        else if (Resource is AudioResourceInfo)
        {
            <div class="forma-file-viewer-audio" role="group" aria-label="@DisplayName">
                <audio controls src="@Resource.Source"></audio>
            </div>
        }
        else if (Resource is DocumentResourceInfo { ContentType: not null } document)
        {
            @if (document.ContentType.StartsWith("text/", StringComparison.OrdinalIgnoreCase))
            {
                @* An uploaded page is untrusted, so it previews in an opaque origin with scripts, forms and navigation withheld. *@
                <iframe class="forma-file-viewer-document"
                        src="@document.Source"
                        title="@DisplayName"
                        loading="lazy"
                        sandbox=""></iframe>
            }
            else
            {
                <object class="forma-file-viewer-document" type="@document.ContentType" data="@document.Source" aria-label="@DisplayName">
                    <a href="@document.Source" target="_blank" rel="noopener noreferrer">@L[$"Open {DisplayName} in a new tab."]</a>
                </object>
            }
        }
        else if (UnsupportedTemplate is not null)
        {
            @UnsupportedTemplate(Source)
        }
        else
        {
            <div class="forma-file-viewer-unsupported">
                <FormaGlyph Name="Glyph.File" Class="forma-file-viewer-unsupported-glyph" />
                <p class="forma-file-viewer-unsupported-name">@DisplayName</p>
                @if (DisplaySize is not null)
                {
                    <p class="forma-file-viewer-unsupported-size"><bdi dir="auto">@DisplaySize</bdi></p>
                }
                <a class="forma-file-viewer-unsupported-download" href="@Source" download="@DisplayName">@L[$"Download {DisplayName}"]</a>
            </div>
        }

        @if (IsNavigable)
        {
            <button type="button"
                    class="forma-file-viewer-nav forma-file-viewer-nav-previous"
                    disabled="@(!CanNavigate(-1))"
                    @onclick="() => NavigateAsync(-1)"
                    aria-label="@L["Previous"]">
                <span aria-hidden="true">&#10094;</span>
            </button>
            <button type="button"
                    class="forma-file-viewer-nav forma-file-viewer-nav-next"
                    disabled="@(!CanNavigate(1))"
                    @onclick="() => NavigateAsync(1)"
                    aria-label="@L["Next"]">
                <span aria-hidden="true">&#10095;</span>
            </button>
        }
    </div>

    @if (ShowMetadata)
    {
        <div class="forma-file-viewer-metadata">
            <span class="forma-file-viewer-metadata-name">@DisplayName</span>
            @if (DisplaySize is not null)
            {
                <span class="forma-file-viewer-metadata-size"><bdi dir="auto">@DisplaySize</bdi></span>
            }
        </div>
    }
</div>
