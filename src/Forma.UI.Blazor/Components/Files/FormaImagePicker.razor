@namespace Forma.UI.Components.Files

<div class="forma-image-picker" @ref="_container">
    <FormaFilePicker Accept="@ImageAccept"
                      AllowMultipleFiles="AllowMultipleFiles"
                      MaxFileSize="MaxFileSize"
                      MaxSelectedFiles="MaxSelectedFiles"
                      Prompt="@EffectivePrompt"
                      OnFilesRejected="HandleFilesRejectedAsync"
                      OnFilesSelected="HandleFilesSelectedAsync" />

    @if (_previews.Count > 0)
    {
        <ul class="forma-image-picker-previews">
            @foreach (var name in _previews)
            {
                <li class="forma-image-picker-preview">
                    <span class="forma-image-picker-frame fa-solid fa-image" aria-hidden="true">
                        <img data-forma-preview alt="" class="forma-image-picker-thumbnail" />
                    </span>
                    <span class="forma-image-picker-name">@name</span>
                </li>
            }
        </ul>
    }
</div>
