@namespace Forma.UI.Blazor.Components.Menus
<FormaDropDownMenu @attributes="AdditionalAttributes"
                   TriggerOptions="TriggerOptions"
                   HeaderContent="HeaderContent"
                   aria-label="@Label"
                   disabled="@(Disabled ? true : null)">
    <Trigger>
        <FormaIcon Icon="@(Orientation == MenuOrientation.Vertical ? Glyph.MoreVertical : Glyph.More)" />
    </Trigger>
    <ChildContent>
        @ChildContent
    </ChildContent>
</FormaDropDownMenu>
