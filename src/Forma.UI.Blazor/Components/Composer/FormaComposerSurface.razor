@namespace Forma.UI.Blazor.Components.Composer

@if (ShowToolbar)
{
    <FormaComposerToolbar
        Editor="Editor"
        View="View"
        Plugins="Plugins"
        Disabled="Disabled"
        KeyMap="KeyMap"
        OnCommand="OnCommand" />
}

<div class="forma-composer-canvas">
    @if (View is not null)
    {
        <CascadingValue Value="View" IsFixed="true">
            <DynamicComponent Type="View.ViewComponent" />
        </CascadingValue>
    }
    else
    {
        <CascadingValue Value="Editor" IsFixed="true">
            <CascadingValue Value="SelectionBar">
                <DynamicComponent Type="Editor.EditorComponent" />
            </CascadingValue>
        </CascadingValue>
    }
</div>
