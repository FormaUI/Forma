@namespace Forma.UI.Blazor.Components.Composer.RichTextEditor
@using Forma.UI.Blazor.Components.Composer.RichTextEditor.Plugins
@inject IStringLocale<FormaRichTextEditor> L

<div @ref="_menuElement" class="forma-composer-bubble-menu" role="toolbar" aria-label="@L["Selection formatting"]">
    <button type="button"
            class="forma-composer-bubble-item"
            title="@L["Bold"]"
            aria-label="@L["Bold"]"
            @onclick="() => OnCommand.InvokeAsync(BasicFormattingPlugin.BoldCommand)">
        <FormaGlyph Name="Glyph.Bold" />
    </button>
    <button type="button"
            class="forma-composer-bubble-item"
            title="@L["Italic"]"
            aria-label="@L["Italic"]"
            @onclick="() => OnCommand.InvokeAsync(BasicFormattingPlugin.ItalicCommand)">
        <FormaGlyph Name="Glyph.Italic" />
    </button>
    <button type="button"
            class="forma-composer-bubble-item"
            title="@L["Underline"]"
            aria-label="@L["Underline"]"
            @onclick="() => OnCommand.InvokeAsync(BasicFormattingPlugin.UnderlineCommand)">
        <FormaGlyph Name="Glyph.Underline" />
    </button>
    <button type="button"
            class="forma-composer-bubble-item"
            title="@L["Code"]"
            aria-label="@L["Code"]"
            @onclick="() => OnCommand.InvokeAsync(BasicFormattingPlugin.CodeCommand)">
        <FormaGlyph Name="Glyph.Code" />
    </button>
    <button type="button"
            class="forma-composer-bubble-item"
            title="@L["Heading 1"]"
            aria-label="@L["Heading 1"]"
            @onclick="() => OnCommand.InvokeAsync(ParagraphFormatPlugin.Heading1Command)">
        <FormaGlyph Name="Glyph.Heading" />
        <span class="forma-composer-bubble-level" aria-hidden="true">1</span>
    </button>
    <button type="button"
            class="forma-composer-bubble-item"
            title="@L["Heading 2"]"
            aria-label="@L["Heading 2"]"
            @onclick="() => OnCommand.InvokeAsync(ParagraphFormatPlugin.Heading2Command)">
        <FormaGlyph Name="Glyph.Heading" />
        <span class="forma-composer-bubble-level" aria-hidden="true">2</span>
    </button>
</div>
