@namespace Forma.UI.Blazor.Components.Composer

@if (Context is not null)
{
    <div class="forma-composer-status-announcer" role="status">@AnnouncedText</div>

    @if (Context.Regions.StatusItems.Count > 0)
    {
        <div class="forma-composer-status-strip">
            @foreach (var item in Context.Regions.StatusItems)
            {
                if (item.Command is { } command)
                {
                    <button type="button"
                            class="forma-composer-status-item forma-composer-status-item-button"
                            title="@item.Tooltip"
                            @onclick="() => OnCommand.InvokeAsync(command)">
                        @item.Text
                    </button>
                }
                else
                {
                    <span class="forma-composer-status-item" title="@item.Tooltip">@item.Text</span>
                }
            }
        </div>
    }
}
