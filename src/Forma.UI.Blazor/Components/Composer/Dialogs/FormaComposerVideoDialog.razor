@namespace Forma.UI.Blazor.Components.Composer.Dialogs
@using Forma.UI.Blazor.Components.Feedback
@using Forma.UI.Blazor.Components.Inputs
@inherits ComposerDialogBase

<FormaComposerDialog Opened="Opened"
                     Title="@L["Insert Video"]"
                     Size="ModalSize.Medium"
                     Messages="Messages"
                     OnConfirm="HandleConfirmAsync"
                     OnCancel="OnCancel">
    <FormaTextBox @bind-Value="_source" Label="@L["Video URL"]" Required="true" />
    <FormaTextBox @bind-Value="_title" Label="@L["Title"]" />
    <div class="forma-composer-dialog-checkbox">
        <FormaCheckBox Checked="_autoplay" CheckedChanged="v => _autoplay = v">
            @L["Autoplay"]
        </FormaCheckBox>
    </div>
</FormaComposerDialog>
