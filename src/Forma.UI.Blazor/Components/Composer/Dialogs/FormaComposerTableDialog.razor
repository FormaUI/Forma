@namespace Forma.UI.Blazor.Components.Composer.Dialogs
@using Forma.UI.Blazor.Components.Feedback
@using Forma.UI.Blazor.Components.Inputs
@inherits ComposerDialogBase

<FormaComposerDialog Opened="Opened"
                     Title="@L["Insert Table"]"
                     Size="ModalSize.Small"
                     Messages="Messages"
                     OnConfirm="HandleConfirmAsync"
                     OnCancel="OnCancel">
    <FormaSlider TValue="int" @bind-Value="_rows" Label="@L["Rows"]" Min="1" Max="@MaxRows" />
    <FormaSlider TValue="int" @bind-Value="_columns" Label="@L["Columns"]" Min="1" Max="@MaxColumns" />
    <div class="forma-composer-dialog-checkbox">
        <FormaCheckBox Checked="_includeHeader" CheckedChanged="v => _includeHeader = v">
            @L["Include Header Row"]
        </FormaCheckBox>
    </div>
    <FormaTextBox @bind-Value="_caption" Label="@L["Caption"]" />
</FormaComposerDialog>
