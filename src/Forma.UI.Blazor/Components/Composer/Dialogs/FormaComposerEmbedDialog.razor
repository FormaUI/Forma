@namespace Forma.UI.Blazor.Components.Composer.Dialogs
@using Forma.UI.Blazor.Components.Feedback
@using Forma.UI.Blazor.Components.Inputs

<FormaModal Opened="Opened"
            Title="@L["Insert Embed"]"
            Size="ModalSize.Medium"
            OnClose="OnCancel"
            OnConfirm="HandleConfirmAsync"
            ConfirmText="@L["Insert"]"
            CancelText="@L["Cancel"]">
    <Body>
        <EditForm Model="this">
            <div class="forma-composer-dialog-form">
                <FormaTextBox @bind-Value="_embedType" Label="@L["Embed Type"]" Required="true" />
                <FormaTextBox @bind-Value="_identifier" Label="@L["Identifier"]" Required="true" />
                <FormaTextArea @bind-Value="_settings" Label="@L["Settings"]" Rows="3" />
            </div>
        </EditForm>
    </Body>
</FormaModal>
