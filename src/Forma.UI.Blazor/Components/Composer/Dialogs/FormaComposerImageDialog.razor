@namespace Forma.UI.Blazor.Components.Composer.Dialogs
@using Forma.UI.Blazor.Components.Feedback
@using Forma.UI.Blazor.Components.Inputs

<FormaModal Opened="Opened"
            Title="@L["Insert Image"]"
            Size="ModalSize.Medium"
            Options="StayOpenOnConfirm"
            OnClose="OnCancel"
            OnConfirm="HandleConfirmAsync"
            ConfirmText="@L["Insert"]"
            CancelText="@L["Cancel"]">
    <Body>
        <EditForm Model="this">
            <div class="forma-composer-dialog-form">
                <FormaTextBox @bind-Value="_source" Label="@L["Source"]" Required="true" />
                <FormaTextBox @bind-Value="_altText" Label="@L["Alt Text"]" />
                <FormaTextBox @bind-Value="_caption" Label="@L["Caption"]" />

                @if (_showSourceRequired)
                {
                    <p class="forma-composer-dialog-error" role="alert">@L["Enter the address of the image before inserting."]</p>
                }
            </div>
        </EditForm>
    </Body>
</FormaModal>
