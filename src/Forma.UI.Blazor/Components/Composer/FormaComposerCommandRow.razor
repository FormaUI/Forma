@namespace Forma.UI.Blazor.Components.Composer

<FormaCommandBarRow role="toolbar" aria-label="@Label" TrailingContent="TrailingContent">
    @if (ShowHistory)
    {
        <div class="forma-composer-toolbar-group">
            <button type="button"
                    class="forma-composer-tool-button"
                    @onclick="() => OnCommand.InvokeAsync(ComposerCommands.Undo)"
                    disabled="@(!CanUndo || Disabled)"
                    aria-label="@L["Undo"]"
                    aria-keyshortcuts="@GetKeyShortcuts(ComposerCommands.Undo)"
                    title="@GetTooltip(L["Undo"].Value, ComposerCommands.Undo)">
                <FormaGlyph Name="Glyph.RotateLeft" />
            </button>
            <button type="button"
                    class="forma-composer-tool-button"
                    @onclick="() => OnCommand.InvokeAsync(ComposerCommands.Redo)"
                    disabled="@(!CanRedo || Disabled)"
                    aria-label="@L["Redo"]"
                    aria-keyshortcuts="@GetKeyShortcuts(ComposerCommands.Redo)"
                    title="@GetTooltip(L["Redo"].Value, ComposerCommands.Redo)">
                <FormaGlyph Name="Glyph.RotateRight" />
            </button>
        </div>
    }

    @foreach (var group in Groups)
    {
        <div class="forma-composer-toolbar-group">
            @foreach (var item in group)
            {
                if (item.CustomComponent is not null)
                {
                    <DynamicComponent Type="item.CustomComponent" />
                }
                else if (item.Options.Count > 0)
                {
                    <FormaDropDownMenu class="forma-composer-tool-menu"
                                       TriggerOptions="MenuTriggerOptions"
                                       disabled="@Disabled"
                                       aria-label="@GetItemTitle(item)"
                                       title="@GetTooltip(GetItemTitle(item), item.Command)">
                        <Trigger>
                            @if (item.Icon is { } menuIcon)
                            {
                                <FormaGlyph Name="menuIcon" />
                            }
                            @if (GetActiveSwatch(item) is { } activeSwatch)
                            {
                                <span class="forma-composer-tool-menu-bar" style="@($"background-color:{activeSwatch}")" aria-hidden="true"></span>
                            }
                            else
                            {
                                <span class="forma-composer-tool-menu-value">@GetActiveChoiceTitle(item)</span>
                            }
                            <FormaGlyph Name="Glyph.ChevronDown" Class="forma-composer-tool-menu-caret" />
                        </Trigger>
                        <ChildContent>
                            @foreach (var choice in item.Options)
                            {
                                <FormaDropDownMenuItem IsSelected="@IsChoiceActive(choice)"
                                                       OnClick="() => OnCommand.InvokeAsync(choice.Command)">
                                    @if (choice.Swatch is { } swatch)
                                    {
                                        <span class="forma-composer-tool-swatch" style="@($"background-color:{swatch}")" aria-hidden="true"></span>
                                    }
                                    <span style="@choice.PreviewStyle">@L[choice.Title]</span>
                                </FormaDropDownMenuItem>
                            }
                        </ChildContent>
                    </FormaDropDownMenu>
                }
                else
                {
                    var isToggleActive = item.IsToggle && IsItemActive(item);
                    <button type="button"
                            class="forma-composer-tool-button @(isToggleActive ? "forma-composer-tool-button-active" : null)"
                            @onclick="() => HandleItemClickAsync(item)"
                            disabled="@Disabled"
                            aria-label="@GetItemTitle(item)"
                            aria-pressed="@(item.IsToggle ? (isToggleActive ? "true" : "false") : null)"
                            aria-keyshortcuts="@GetKeyShortcuts(item.Command)"
                            title="@GetTooltip(GetItemTitle(item), item.Command)">
                        @if (item.Icon is { } icon)
                        {
                            <FormaGlyph Name="icon" />
                        }
                        else
                        {
                            <span>@GetItemTitle(item)</span>
                        }
                    </button>
                }
            }
        </div>
    }
</FormaCommandBarRow>
