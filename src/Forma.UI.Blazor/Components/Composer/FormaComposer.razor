@namespace Forma.UI.Blazor.Components.Composer
@using Forma.UI.Blazor.Components.Composer.Dialogs
@using Forma.UI.Blazor.Components.Feedback
@inherits InputBase<ComposerDocument>
@inject IStringLocale<FormaComposer> L

<CascadingValue Value="_context" IsFixed="false">
    <div @ref="_composerElement" id="@ElementId" class="@ComposerClass" @attributes="AdditionalAttributes">
        @if (_isInitialized && ShowTabs)
        {
            <FormaTabs ActiveTabId="@_activeEditor.Id" ActiveTabIdChanged="SwitchEditorAsync" Label="@L["Editor Surface"]">
                @foreach (var editor in _catalog.Editors)
                {
                    <FormaTab TabId="@editor.Id" Title="@L[editor.Title]" Icon="editor.Icon">
                        @if (editor.Id == _activeEditor.Id)
                        {
                            <FormaComposerSurface
                                Editor="_activeEditor"
                                Plugins="_catalog.FeaturePlugins"
                                ShowToolbar="ShowToolbar"
                                Disabled="Disabled"
                                KeyMap="_keyMap"
                                OnCommand="HandleCommandAsync" />
                        }
                    </FormaTab>
                }
            </FormaTabs>
        }
        else if (_isInitialized)
        {
            <FormaComposerSurface
                Editor="_activeEditor"
                Plugins="_catalog.FeaturePlugins"
                ShowToolbar="ShowToolbar"
                Disabled="Disabled"
                KeyMap="_keyMap"
                OnCommand="HandleCommandAsync" />
        }

        @if (_isInitialized)
        {
            @if (CurrentDocument.Attachments.Count > 0)
            {
                <FormaComposerAttachments />
            }

            <FormaComposerStatusStrip OnCommand="HandleCommandAsync" />
        }
    </div>

    @if (_isAttachOpen)
    {
        <FormaComposerFileUploadDialog Opened="_isAttachOpen"
                                       Options="AttachOptions"
                                       OnAttach="HandleAttachedAsync"
                                       OnCancel="() => _isAttachOpen = false" />
    }

    @if (_isPreviewOpen)
    {
        <FormaModal Opened="_isPreviewOpen"
                    Title="@L["Document Preview"]"
                    Size="ModalSize.Large"
                    OnClose="() => _isPreviewOpen = false"
                    ConfirmText="@L["Close"]"
                    OnConfirm="() => _isPreviewOpen = false">
            <Body>
                <div class="forma-composer-preview-body">
                    @if (CurrentDocument.Format == ComposerDocumentFormat.Html)
                    {
                        @((MarkupString)CurrentDocument.Content)
                    }
                    else
                    {
                        <pre>@CurrentDocument.Content</pre>
                    }
                </div>
            </Body>
        </FormaModal>
    }
</CascadingValue>
