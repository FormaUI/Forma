@namespace Forma.UI.Blazor.Components.Composer
@inherits InputBase<ComposerDocument>
@inject IStringLocale<FormaComposer> L

<CascadingValue Value="_context" IsFixed="false">
    <div @ref="_composerElement" id="@ElementId" class="@ComposerClass" @attributes="AdditionalAttributes">
        @if (_isInitialized && ShowTabs)
        {
            <FormaTabs ActiveId="@_activeEditor.Id" ActiveIdChanged="SwitchEditorAsync" Label="@L["Editor Surface"]">
                @foreach (var editor in _catalog.Editors)
                {
                    <FormaTab Id="@editor.Id" Title="@L[editor.Title]" Icon="editor.Icon">
                        @if (editor.Id == _activeEditor.Id)
                        {
                            <FormaComposerSurface
                                Editor="_activeEditor"
                                Plugins="_catalog.FeaturePlugins"
                                ShowToolbar="ShowToolbar"
                                Disabled="Disabled"
                                KeyMap="_keyMap"
                                OnCommand="ExecuteCommandAsync" />
                        }
                    </FormaTab>
                }
            </FormaTabs>
        }
        else if (_isInitialized)
        {
            <FormaComposerSurface
                Editor="_activeEditor"
                Plugins="_catalog.FeaturePlugins"
                ShowToolbar="ShowToolbar"
                Disabled="Disabled"
                KeyMap="_keyMap"
                OnCommand="ExecuteCommandAsync" />
        }

        @if (_isInitialized)
        {
            <FormaComposerStatusStrip OnCommand="ExecuteCommandAsync" />
        }
    </div>
</CascadingValue>
