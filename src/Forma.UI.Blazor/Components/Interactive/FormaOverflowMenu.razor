@namespace Forma.UI.Blazor.Components.Interactive

<FormaDropDownMenu @attributes="AdditionalAttributes"
                   TriggerOptions="TriggerOptions"
                   HeaderContent="HeaderContent"
                   aria-label="@Label"
                   disabled="@(Disabled ? true : null)">
    <Trigger>
        <FormaGlyph Name="@(Orientation == MenuOrientation.Vertical ? Glyph.EllipsisVertical : Glyph.Ellipsis)" />
    </Trigger>
    <ChildContent>
        @ChildContent
    </ChildContent>
</FormaDropDownMenu>
