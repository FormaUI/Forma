@namespace Forma.UI.Blazor.Components.Interactive

@if (Href is not null)
{
    <a href="@Href"
       @attributes="AdditionalAttributes"
       class="@CssClass"
       role="menuitem"
       tabindex="-1"
       aria-disabled="@(Disabled ? "true" : null)"
       @ref="_element"
       @onclick="HandleActivateAsync"
       @onclick:preventDefault="Disabled">
        @ChildContent
    </a>
}
else
{
    <button type="button"
            @attributes="AdditionalAttributes"
            class="@CssClass"
            role="menuitem"
            tabindex="-1"
            disabled="@Disabled"
            @ref="_element"
            @onclick="HandleActivateAsync">
        @ChildContent
    </button>
}
