@namespace Forma.UI.Blazor.Components.Inputs
@using Forma.UI.Blazor.Components.Buttons

<div class="forma-search-box-wrapper">
    <span class="forma-search-box-icon" aria-hidden="true"><FormaGlyph Name="Glyph.MagnifyingGlass" /></span>
    <input @attributes="AdditionalAttributes"
           id="@Id"
           type="search"
           dir="auto"
           class="@InputClass"
           placeholder="@EffectivePlaceholder"
           value="@Value"
           disabled="@Disabled"
           @oninput="HandleInputAsync"
           @onkeydown="HandleKeyDownAsync" />
    @if (!string.IsNullOrEmpty(Value))
    {
        <span class="forma-search-box-clear">
            <FormaCloseButton Label="@L["Clear Search"]" Size="ButtonSize.Mini" Disabled="Disabled" OnClick="ClearAsync" />
        </span>
    }
</div>
