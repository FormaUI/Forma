@namespace Forma.UI.Blazor.Components.Inputs
@inherits InputBase<bool>

<FormaField Label="@Label" TargetId="@_id" LabelMode="FieldLabelMode.Inline">
    <ChildContent>
        <div class="forma-toggle-switch-wrapper">
            @if (OffLabel is not null)
            {
                <span class="forma-toggle-switch-label forma-toggle-switch-off-label">@OffLabel</span>
            }
            <label class="@(Disabled ? "forma-toggle-switch disabled" : "forma-toggle-switch")">
                <input @attributes="AdditionalAttributes"
                       id="@_id"
                       type="checkbox"
                       role="switch"
                       class="forma-toggle-switch-input @CssClass"
                       checked="@CurrentValue"
                       @onchange="HandleChange"
                       disabled="@Disabled" />
                <span class="forma-toggle-switch-track" aria-hidden="true">
                    @* The mark carries on/off without relying on the track colour alone. *@
                    <span class="forma-toggle-switch-mark"><FormaIcon Icon="@(CurrentValue ? Glyph.Check : Glyph.Close)" /></span>
                    <span class="forma-toggle-switch-knob"></span>
                </span>
            </label>
            @if (OnLabel is not null)
            {
                <span class="forma-toggle-switch-label forma-toggle-switch-on-label">@OnLabel</span>
            }
        </div>
    </ChildContent>
    <Validation>
        <ValidationMessage For="@ValueExpression" />
    </Validation>
</FormaField>
