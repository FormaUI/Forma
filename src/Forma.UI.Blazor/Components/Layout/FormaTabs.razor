<CascadingValue Value="this" IsFixed="true">
    <div class="forma-tabs">
        <div class="forma-tab-list" role="tablist" aria-label="@Label">
            @foreach (var tab in _tabs)
            {
                var isActive = IsActive(tab);
                var tabElementId = FormaTabs.GetTabElementId(tab);
                var panelElementId = FormaTabs.GetPanelElementId(tab);

                <button class="forma-tab-button @(isActive ? "active" : "")"
                        role="tab"
                        id="@tabElementId"
                        aria-selected="@isActive.ToString().ToLowerInvariant()"
                        aria-controls="@panelElementId"
                        @onclick="() => SelectTabAsync(tab)">
                    @if (tab.Icon is { } icon)
                    {
                        <FormaGlyph Name="icon" />
                    }
                    @tab.Title
                </button>
            }
        </div>

        <div class="forma-tab-panels">
            @ChildContent
        </div>
    </div>
</CascadingValue>
