@namespace Forma.UI.Blazor.Components.Layout
<div class="@CssClass"
     @ref="_element"
     role="separator"
     tabindex="0"
     aria-orientation="@AriaOrientation"
     aria-label="@Label"
     aria-valuenow="@Rounded(Value)"
     aria-valuemin="@Rounded(Min)"
     aria-valuemax="@Rounded(Max)"
     @attributes="AdditionalAttributes"
     @onpointerdown="HandlePointerDownAsync"
     @onpointermove="HandlePointerMoveAsync"
     @onpointerup="HandlePointerUpAsync"
     @onpointercancel="HandlePointerUpAsync"
     @onkeydown="HandleKeyDownAsync">
    <span class="forma-splitter-grip" aria-hidden="true"></span>
</div>
