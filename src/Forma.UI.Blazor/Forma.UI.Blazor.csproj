<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Forma.UI.Blazor</RootNamespace>
        <PackageId>2Site.Forma.UI.Blazor</PackageId>
        <StaticWebAssetBasePath>_content/Forma.UI</StaticWebAssetBasePath>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectsInPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <!-- The bundled symbol font is subsetted from JuliaMono, so its notice travels with the package. -->
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- The referenced projects ship inside this package rather than as packages of their own. -->
    <Target Name="IncludeReferencedProjectsInPackage" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0-preview.6.26359.118" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Forma.UI.Features.Composer\Forma.UI.Features.Composer.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.UI.Features.Explorer\Forma.UI.Features.Explorer.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.UI.Features.Files\Forma.UI.Features.Files.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.UI.Features.Feedback\Forma.UI.Features.Feedback.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.UI.Features.Media\Forma.UI.Features.Media.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.UI.Features.Sanitization\Forma.UI.Features.Sanitization.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.UI.Features.Toolbar\Forma.UI.Features.Toolbar.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.UI.Design.Css\Forma.UI.Design.Css.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.UI.Design.Icons\Forma.UI.Design.Icons.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.UI.Design.Emojis\Forma.UI.Design.Emojis.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework.Localization.Abstractions\Forma.Framework.Localization.Abstractions.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework.Resources.Abstractions\Forma.Framework.Resources.Abstractions.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework.Sanitization.Abstractions\Forma.Framework.Sanitization.Abstractions.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!-- These ship embedded in the assembly, so packing them again as content only duplicates them. -->
    <ItemGroup>
        <EmbeddedResource Include="Components\**\*.json" />
        <EmbeddedResource Include="Assets\**\*.json" />
        <Content Remove="Components\**\*.json" />
        <Content Remove="Assets\**\*.json" />
    </ItemGroup>

</Project>
