@namespace Forma.Blazor.Components.Explorer
@inherits FormaComponentBase
@using Forma.Framework.Explorer.Content
@using Forma.Framework.Catalog.Queries
@using Forma.Framework.Explorer.Content.Queries
@using Forma.Framework.Explorer.Items
@using Forma.Framework.Catalog

@{
    RenderFragment<ICatalogItem> tile = item =>
        @<text>
        @{
            var selected = View.Selection.IsSelected(item);
            var selecting = View.Selection.IsSelectionModeActive;
            var labels = item.GetLocalizedLabels(L, View.Selection);
            var capabilities = item.GetCapabilities(View.Item.ItemOptions);
            var draggable = capabilities.HasFlag(CatalogItemCapabilities.Drag) ? "true" : "false";
        }
        <div class="forma-explorer-item @(selected ? "is-selected" : "") @item.GetStateClasses()"
             role="listitem"
             draggable="@draggable"
             @ondragstart="() => ItemInteraction.BeginDrag(item)">
            <div class="forma-explorer-thumbnail-wrapper">
                @if (item.Resource is { } resource)
                {
                    <FormaExplorerThumbnail Resource="resource" Size="ExplorerThumbnailSize.Tile" />
                }

                <button type="button"
                        class="forma-explorer-item-open"
                        aria-label="@labels.ActivationLabel"
                        aria-pressed="@(View.Selection.IsSelectionModeActive ? (selected ? "true" : "false") : null)"
                        disabled="@(item.IsDisabled || !RendererInfo.IsInteractive)"
                        @onclick="() => ItemInteraction.ActivateAsync(item)"></button>

                <span class="forma-explorer-item-lead">
                    @if (selecting)
                    {
                        <span class="forma-explorer-item-select @(selected ? "is-checked" : "")" aria-hidden="true">
                            <FormaIcon Icon="Glyph.Check" Size="IconSize.Small" />
                        </span>
                    }
                    else
                    {
                        <FormaExplorerActionBar Item="item" />
                    }
                </span>
            </div>

            <div class="forma-explorer-item-info">
                <span class="forma-explorer-item-name" title="@item.Name">@item.Name</span>
                @if (item.Resource?.FormatSize(Context.CultureState.Culture) is { } size)
                {
                    <span class="forma-explorer-item-size" dir="auto">@size</span>
                }
            </div>
        </div>
        </text>;
}

@if (View.GroupField == ExplorerGroupField.None)
{
    <div class="forma-explorer-grid" role="list">
        @foreach (var item in Items)
        {
            @tile(item)
        }
    </div>
}
else
{
    <div class="forma-explorer-groups">
        @foreach (var group in View.VisibleGroups)
        {
            var collapsed = View.IsCollapsed(group);

            <section class="forma-explorer-group" @key="group.Key">
                <FormaExplorerGroupHeading Group="group" Collapsed="collapsed" OnToggle="() => Interaction.ToggleGroupAsync(group)" />
                @if (!collapsed)
                {
                    <div class="forma-explorer-grid" role="list">
                        @foreach (var item in group.Items)
                        {
                            @tile(item)
                        }
                    </div>
                }
            </section>
        }
    </div>
}
