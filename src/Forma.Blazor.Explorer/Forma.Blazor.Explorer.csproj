<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- The component borrows the product's namespace, so its translations embed and resolve as the product's own do. -->
        <RootNamespace>Forma.Blazor.Components.Explorer</RootNamespace>
        <StaticWebAssetBasePath>_content/$(AssemblyName)</StaticWebAssetBasePath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Forms" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
        <PackageReference Include="Microsoft.JSInterop" />
    </ItemGroup>

    <!-- The product, whose package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Blazor\Forma.Blazor.csproj" />
    </ItemGroup>

    <!-- The catalog model the component browses and the engine it drives, each a package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Catalog\Forma.Framework.Catalog.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Explorer\Forma.Framework.Explorer.csproj" />
    </ItemGroup>

    <!-- The Framework assemblies the component compiles against, each a package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Files\Forma.Framework.Files.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Media\Forma.Framework.Media.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Toolbar\Forma.Framework.Toolbar.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Input\Forma.Framework.Input.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Input.Interop\Forma.Framework.Input.Interop.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.JavaScript.Interop\Forma.Framework.JavaScript.Interop.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Browser.Interop\Forma.Framework.Browser.Interop.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Share\Forma.Framework.Share.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Css\Forma.Framework.Css.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Events\Forma.Framework.Events.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Icons\Forma.Framework.Icons.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Emojis\Forma.Framework.Emojis.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Resources\Forma.Framework.Resources.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Sanitization\Forma.Framework.Sanitization.csproj" />
    </ItemGroup>

    <Import Project="$(ComponentAnalyzersTargets)" />

</Project>
