<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- The component borrows the product's namespace, so its translations embed and resolve as the product's own do. -->
        <RootNamespace>Forma.Blazor.Components.Explorer</RootNamespace>
        <StaticWebAssetBasePath>_content/$(AssemblyName)</StaticWebAssetBasePath>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeBundledProjectsInPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- The product, whose package this one depends on. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Blazor\Forma.Blazor.csproj" />
    </ItemGroup>

    <!-- The component's own feature vocabulary, which ships inside this package. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Catalog\Forma.Framework.Catalog.csproj" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Explorer\Forma.Framework.Explorer.csproj" PrivateAssets="all" />
    </ItemGroup>

    <!-- The Framework assemblies the component compiles against, every one of which the product's package already ships or declares. -->
    <ItemGroup>
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Files\Forma.Framework.Files.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Feedback\Forma.Framework.Feedback.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Media\Forma.Framework.Media.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Windows\Forma.Framework.Windows.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Toolbar\Forma.Framework.Toolbar.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Input\Forma.Framework.Input.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Input.Interop\Forma.Framework.Input.Interop.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.JavaScript.Interop\Forma.Framework.JavaScript.Interop.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Browser.Interop\Forma.Framework.Browser.Interop.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Share\Forma.Framework.Share.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Css\Forma.Framework.Css.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Events\Forma.Framework.Events.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Timing\Forma.Framework.Timing.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Icons\Forma.Framework.Icons.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Icons.Glyphs\Forma.Framework.Icons.Glyphs.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Emojis\Forma.Framework.Emojis.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Emojis.Unicode\Forma.Framework.Emojis.Unicode.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Localization\Forma.Framework.Localization.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Resources\Forma.Framework.Resources.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\Forma.Framework\Forma.Framework.Sanitization\Forma.Framework.Sanitization.csproj" PrivateAssets="all" />
    </ItemGroup>

    <Import Project="$(BundledPackageTargets)" />

</Project>
