@namespace Forma.Blazor.Components.Explorer
@inherits FormaComponentBase
@using Forma.Blazor.Components.Layout
@using Forma.Framework.Explorer.Content
@using Forma.Framework.Catalog.Queries
@using Forma.Framework.Explorer.Content.Queries
@using Forma.Framework.Explorer.Items
@using Forma.Framework.Catalog

@{
    var selecting = View.Selection.IsSelectionModeActive;

    RenderFragment<ICatalogItem> row = item =>
        @<text>
        @{
            var selected = View.Selection.IsSelected(item);
            var labels = item.GetLocalizedLabels(L, View.Selection);
            var capabilities = item.GetCapabilities(View.Item.ItemOptions);
            var draggable = capabilities.HasFlag(CatalogItemCapabilities.Drag) ? "true" : "false";
        }
        <tr class="forma-explorer-details-row @(selected ? "is-selected" : "") @item.GetStateClasses()"
            aria-disabled="@(item.IsDisabled ? "true" : null)"
            draggable="@draggable"
            @ondragstart="() => ItemInteraction.BeginDrag(item)">
            <td class="forma-explorer-cell-actions @FormaFreezePane.FrozenClass">
                <FormaExplorerItemLead Item="item" />
            </td>
            <td class="forma-explorer-cell-name @FormaFreezePane.FrozenClass">
                <button type="button"
                        class="forma-explorer-name-wrapper"
                        aria-label="@labels.ActivationLabel"
                        disabled="@(item.IsDisabled || !RendererInfo.IsInteractive)"
                        @onclick="() => ItemInteraction.ActivateAsync(item)">
                    @if (item.Resource is { } resource)
                    {
                        <FormaExplorerThumbnail Resource="resource" Size="ExplorerThumbnailSize.Cell" />
                    }
                    <span class="forma-explorer-details-name-text" title="@item.Name">@item.Name</span>
                </button>
            </td>
            @if (ShowsKind)
            {
                <td class="forma-explorer-cell-kind @FormaFreezePane.StopClass">@item.GetLocalizedLabels(L).KindLabel</td>
            }
            @if (ShowsSize)
            {
                <td class="forma-explorer-cell-size @FormaFreezePane.StopClass" dir="auto">@(item.Resource?.FormatSize(Context.CultureState.Culture) ?? Placeholder)</td>
            }
            @if (ShowsModified)
            {
                <td class="forma-explorer-cell-modified @FormaFreezePane.StopClass">@DisplayDate(item.ModifiedAt)</td>
            }
            @if (ShowsAdded)
            {
                <td class="forma-explorer-cell-added @FormaFreezePane.StopClass">@DisplayDate(item.CreatedAt)</td>
            }
        </tr>
        </text>;
}

<div class="forma-explorer-details-wrapper @(_frozenExtent is null ? "" : "has-frozen-extent")" style="@FrozenStyle">
    <FormaFreezePane Options="PaneOptions" FrozenExtentChanged="HandleFrozenExtentChanged">
    <table class="forma-explorer-details-table @(View.ShowsDetailsHeader ? "" : "is-headerless")" role="table">
        <thead>
            <tr>
                <th class="forma-explorer-column-actions @FormaFreezePane.FrozenClass"><span class="forma-explorer-visually-hidden">@(selecting ? L["Select"] : L["Actions"])</span></th>
                <th class="forma-explorer-column-name @FormaFreezePane.FrozenClass @(View.SortField == CatalogSortField.Name ? "is-sorted" : "")"
                    aria-sort="@SortState(CatalogSortField.Name)"
                    @onclick="() => Interaction.SortByAsync(CatalogSortField.Name)">
                    <span>@L["Name"]</span>
                    @if (View.SortField == CatalogSortField.Name)
                    {
                        <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == CatalogSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                    }
                </th>
                @if (ShowsKind)
                {
                    <th class="forma-explorer-column-kind @FormaFreezePane.StopClass @(View.SortField == CatalogSortField.Kind ? "is-sorted" : "")"
                        aria-sort="@SortState(CatalogSortField.Kind)"
                        @onclick="() => Interaction.SortByAsync(CatalogSortField.Kind)">
                        <span>@L["Type"]</span>
                        @if (View.SortField == CatalogSortField.Kind)
                        {
                            <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == CatalogSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                        }
                    </th>
                }
                @if (ShowsSize)
                {
                    <th class="forma-explorer-column-size @FormaFreezePane.StopClass @(View.SortField == CatalogSortField.Size ? "is-sorted" : "")"
                        aria-sort="@SortState(CatalogSortField.Size)"
                        @onclick="() => Interaction.SortByAsync(CatalogSortField.Size)">
                        <span>@L["Size"]</span>
                        @if (View.SortField == CatalogSortField.Size)
                        {
                            <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == CatalogSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                        }
                    </th>
                }
                @if (ShowsModified)
                {
                    <th class="forma-explorer-column-modified @FormaFreezePane.StopClass @(View.SortField == CatalogSortField.DateModified ? "is-sorted" : "")"
                        aria-sort="@SortState(CatalogSortField.DateModified)"
                        @onclick="() => Interaction.SortByAsync(CatalogSortField.DateModified)">
                        <span>@L["Modified"]</span>
                        @if (View.SortField == CatalogSortField.DateModified)
                        {
                            <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == CatalogSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                        }
                    </th>
                }
                @if (ShowsAdded)
                {
                    <th class="forma-explorer-column-added @FormaFreezePane.StopClass @(View.SortField == CatalogSortField.DateAdded ? "is-sorted" : "")"
                        aria-sort="@SortState(CatalogSortField.DateAdded)"
                        @onclick="() => Interaction.SortByAsync(CatalogSortField.DateAdded)">
                        <span>@L["Added"]</span>
                        @if (View.SortField == CatalogSortField.DateAdded)
                        {
                            <span class="forma-explorer-sort-arrow" aria-hidden="true"><FormaIcon Icon="@(View.SortDirection == CatalogSortDirection.Ascending ? Glyph.TriangleUp : Glyph.TriangleDown)" /></span>
                        }
                    </th>
                }
            </tr>
        </thead>
        @if (View.GroupField == ExplorerGroupField.None)
        {
            <tbody>
                @foreach (var item in Items)
                {
                    @row(item)
                }
            </tbody>
        }
        else
        {
            @foreach (var group in View.VisibleGroups)
            {
                var collapsed = View.IsCollapsed(group);

                <tbody class="forma-explorer-group" @key="group.Key">
                    <tr class="forma-explorer-group-row">
                        <th class="forma-explorer-group-cell" colspan="@ColumnCount" scope="rowgroup">
                            <FormaExplorerGroupHeading Group="group" Collapsed="collapsed" OnToggle="() => Interaction.ToggleGroupAsync(group)" />
                        </th>
                    </tr>
                    @if (!collapsed)
                    {
                        @foreach (var item in group.Items)
                        {
                            @row(item)
                        }
                    }
                </tbody>
            }
        }
    </table>
    </FormaFreezePane>
</div>
