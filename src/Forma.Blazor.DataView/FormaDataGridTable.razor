@namespace Forma.Blazor.Components.DataView
@inherits FormaElementBase
@typeparam TItem where TItem : notnull
@using System.Globalization
@using Forma.Blazor.Components.Menus
@using Forma.Blazor.Components.Virtualization
@using Microsoft.AspNetCore.Components.Web.Virtualization

@{
    Grid.FinishCollectingColumns();
    Interaction.BeginItemPass();

    RenderFragment<DataViewGroup<TItem>> groupHeading = group =>
    {
        var isFolded = View.IsFolded(group);

        return @<tr class="forma-data-grid-group-row">
            <th scope="rowgroup" colspan="@Grid.ColumnCount" class="forma-data-grid-group-cell">
                <FormaButton Variant="ButtonVariant.Ghost" class="forma-data-grid-group-heading" aria-expanded="@(isFolded ? "false" : "true")" OnClick="() => Interaction.ToggleGroupAsync(group)">
                    <FormaIcon Icon="@(isFolded ? Glyph.ChevronRight : Glyph.ChevronDown)" Size="IconSize.Small" Class="forma-data-grid-group-chevron" />
                    <span class="forma-data-grid-group-name">@group.Name</span>
                    <span class="forma-data-grid-group-count">@group.Count.ToString("N0", CultureInfo.CurrentCulture)</span>
                </FormaButton>
            </th>
        </tr>;
    };
}
<table id="@Id"
       data-rid="@Context.RuntimeId"
       class="@RootClass"
       style="@RootStyle"
       aria-rowcount="@View.TotalItemCount"
       aria-busy="@(View.IsBusy ? "true" : null)"
       @attributes="AdditionalAttributes"
       @ref="RootElement">
    @* The header always renders, since the widths are measured from it; a headerless grid collapses it to no height. *@
    <thead>
        <tr>
            @if (Grid.HasSelectionColumn)
            {
                <th scope="col" class="@Grid.SelectionCellClass" data-column="selection">
                    @if (View.EnableCheckedSelection)
                    {
                        <div class="forma-data-grid-master">
                            @if (View.HasMasterControl && !Grid.HasMasterCaption)
                            {
                                <label class="forma-data-view-box-target">
                                    <FormaCheckBox aria-label="@L["Select All"]"
                                                   Value="@View.AllSelected"
                                                   ValueExpression="() => MasterSelection"
                                                   Indeterminate="@View.PartiallySelected"
                                                   Disabled="@View.IsMasterControlDisabled"
                                                   PreventDefault="true"
                                                   OnClick="HandleMasterClickAsync" />
                                </label>
                            }
                            else if (Grid.HasMasterCaption)
                            {
                                @if (View.HasMasterControl && Grid.MasterCaptionInteractive)
                                {
                                    <span class="forma-data-grid-master-caption-slot">
                                        <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" class="forma-data-grid-master-caption" Disabled="@View.IsMasterControlDisabled" OnClick="HandleMasterClickAsync">@Grid.MasterCaptionText</FormaButton>
                                        @* Holds the column at the width of the longer caption, so swapping captions keeps every column beside it in place. *@
                                        <span class="forma-data-grid-master-caption-ghost" aria-hidden="true">@Grid.MasterCaptionAlternateText</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="forma-data-grid-master-caption forma-data-grid-master-caption-static">@Grid.MasterCaptionText</span>
                                }
                            }
                            @if (View.HasMasterMenu)
                            {
                                <FormaDropDownMenu TriggerOptions="ButtonOptions.MiniGhostIcon" class="forma-data-grid-master-menu" aria-label="@L["Selection Options"]">
                                    <Trigger>
                                        <FormaIcon Icon="Glyph.ChevronDown" Size="IconSize.Small" />
                                    </Trigger>
                                    <ChildContent>
                                        <FormaDropDownMenuItem Disabled="@(View.AllSelected || View.IsMasterControlDisabled)" OnClick="Interaction.SelectPageAsync">
                                            <span>@L["Select Page ({Count})", View.Items.Count]</span>
                                        </FormaDropDownMenuItem>
                                        @if (View.CanOfferSet)
                                        {
                                            <FormaDropDownMenuItem Disabled="@(View.SelectedCount >= (View.TotalItemCount ?? 0))" OnClick="Interaction.SelectAllAsync">
                                                <span>@L["Select All ({Count})", View.TotalItemCount ?? 0]</span>
                                            </FormaDropDownMenuItem>
                                        }
                                        <FormaDropDownMenuItem Disabled="@(View.SelectedCount == 0)" OnClick="Interaction.ClearSelectionAsync">
                                            <span>@L["Clear Selection"]</span>
                                        </FormaDropDownMenuItem>
                                    </ChildContent>
                                </FormaDropDownMenu>
                            }
                        </div>
                    }
                </th>
            }
            @foreach (var column in Grid.ShownColumns)
            {
                <th scope="col" class="@Grid.GetHeaderClass(column)" style="@Grid.GetHeaderStyle(column)" aria-sort="@Grid.GetAriaSort(column)" data-column="@column.ColumnKey" @key="column">
                    <FormaDataGridColumnHeader TItem="TItem" Column="column" />
                </th>
            }
            @if (Grid.HasColumnsMenu)
            {
                <th scope="col" class="forma-data-grid-menu-column" data-column="menu">
                    <FormaDropDownMenu TriggerOptions="ButtonOptions.MiniGhostIcon" Alignment="PopoverAlignment.End" class="forma-data-grid-columns-menu" aria-label="@L["Columns"]">
                        <Trigger>
                            <FormaIcon Icon="Glyph.Columns" Size="IconSize.Small" />
                        </Trigger>
                        <ChildContent>
                            @foreach (var column in Grid.DroppableColumns)
                            {
                                <FormaDropDownMenuItem IsSelected="@Grid.IsShown(column)" KeepsOpen="true" OnClick="() => Grid.ToggleColumnAsync(column)" @key="column">
                                    <span>@column.HeaderContent</span>
                                </FormaDropDownMenuItem>
                            }
                        </ChildContent>
                    </FormaDropDownMenu>
                </th>
            }
        </tr>
    </thead>
    @* Each group is a body of its own, its heading a row-group header the rows under it belong to. *@
    @if (View.HasLoaded && View.IsGrouped && View.Items.Count > 0)
    {
        @foreach (var group in View.Groups)
        {
            var isFolded = View.IsFolded(group);

            <tbody class="forma-data-grid-group" @key="group.Key">
                @groupHeading(group)
                @if (!isFolded)
                {
                    @foreach (var item in group.Items)
                    {
                        <FormaDataGridRow TItem="TItem" Item="item" @key="View.ItemKey(item)" />
                    }
                }
            </tbody>
        }
    }
    else
    {
    <tbody>
        @if (!View.HasLoaded)
        {
            <tr class="forma-data-grid-state-row">
                <td colspan="@Grid.ColumnCount" class="forma-data-grid-state-cell">@View.LoadingContent</td>
            </tr>
        }
        else if (View.Virtualize && !View.EnablePagination && View.TotalItemCount != 0)
        {
            @* A row is one item, or a group's heading where the data view groups. *@
            <FormaVirtualize @ref="Virtualizer"
                              TItem="DataViewRow<TItem>"
                              ItemsProvider="Grid.ProvideVirtualizedRowsAsync"
                              ItemKey="Grid.GetRowKey"
                              PinnedKeys="Grid.GetPinnedKeys()"
                              ItemComparer="Grid.RowComparer"
                              ItemSize="View.ItemHeight"
                              OverscanCount="View.OverscanCount"
                              AnchorMode="View.AnchorMode"
                              InitialItemIndex="Grid.InitialRowIndex">
                <ItemContent Context="row">
                    @if (row.Group is { } group)
                    {
                        @groupHeading(group)
                    }
                    else
                    {
                        <FormaDataGridRow TItem="TItem" Item="row.Items[0]" Position="row.FirstItemIndex" @key="View.ItemKey(row.Items[0])" />
                    }
                </ItemContent>
                <Placeholder>
                    <tr class="forma-data-grid-row forma-data-grid-placeholder-row" style="@Grid.PlaceholderStyle" aria-rowindex="@(View.IsGrouped ? null : context.Index + 1)">
                        @if (Grid.HasSelectionColumn)
                        {
                            <td class="@Grid.SelectionCellClass"></td>
                        }
                        @foreach (var column in Grid.ShownColumns)
                        {
                            <td class="@Grid.GetCellClass(column)" style="@Grid.GetCellStyle(column)" @key="column">@column.PlaceholderTemplate?.Invoke(context)</td>
                        }
                        @if (Grid.HasColumnsMenu)
                        {
                            <td class="forma-data-grid-menu-column"></td>
                        }
                    </tr>
                </Placeholder>
            </FormaVirtualize>
        }
        else if (View.Items.Count == 0)
        {
            <tr class="forma-data-grid-state-row">
                <td colspan="@Grid.ColumnCount" class="forma-data-grid-state-cell">@View.EmptyContent</td>
            </tr>
        }
        else
        {
            @foreach (var item in View.Items)
            {
                <FormaDataGridRow TItem="TItem" Item="item" @key="View.ItemKey(item)" />
            }
        }
    </tbody>
    }
</table>
