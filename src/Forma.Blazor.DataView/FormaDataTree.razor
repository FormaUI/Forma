@namespace Forma.Blazor.Components.DataView
@inherits FormaElementBase
@typeparam TItem where TItem : notnull

@using Forma.Blazor.Components.Virtualization

@if (IsActive)
{
    <div id="@Id"
         data-rid="@Context.RuntimeId"
         class="@RootClass"
         style="@RootStyle"
         @attributes="_collectionName.RootAttributes"
         @ref="RootElement"
         tabindex="@(_holdsFocus ? "-1" : null)"
         data-focus-heir="@(_focusesSelf ? string.Empty : null)">
        @if (!View.AreRootsLoaded)
        {
            <div class="forma-data-tree-state">@View.LoadingContent</div>
        }
        else if (GetRoots().Count == 0)
        {
            SettleRows();
            <div class="forma-data-tree-state">@View.EmptyContent</div>
        }
        else if (IsVirtualizing)
        {
            SettleRows();

            @* Virtualizing, the visible nodes stand in one run, each carrying its level and its place among its siblings. *@
            <div class="forma-data-tree-level" role="tree" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                <FormaVirtualize @ref="_virtualizer" TItem="VisibleNode" Items="_visibleRows" ItemKey="GetRowKey" ItemSize="View.ItemHeight" OverscanCount="View.OverscanCount" PinnedKeys="GetPinnedKeys()">
                    <ItemContent Context="row">
                        <div class="forma-data-tree-item" role="none">
                            @RenderNode(row, null)
                        </div>
                    </ItemContent>
                </FormaVirtualize>
            </div>
        }
        else
        {
            SettleRows();
            <ul class="forma-data-tree-level" role="tree" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                @RenderLevel(GetRoots(), 1)
            </ul>
        }
    </div>
}

@code {
    // Each node is a row, its children in a group beneath it while open, which the row owns.
    private RenderFragment RenderLevel(IReadOnlyList<TItem> nodes, int depth) => __builder =>
    {
        foreach (var node in nodes)
        {
            var children = View.CanOpen(node) && View.IsOpen(node) ? GetChildren(node) : [];
            var childrenId = GetNodeChildrenId(node);

            @* The row is the tree item, since it is what carries the focus; the list item around it holds the row and the children's group. *@
            <li class="forma-data-tree-item" role="none" @key="View.ItemKey(node)">
                @RenderNode(new VisibleNode(node, depth, null, null, null), children.Count > 0 ? childrenId : null)
                @if (children.Count > 0)
                {
                    <ul class="forma-data-tree-level" role="group" id="@childrenId">
                        @RenderLevel(children, depth + 1)
                    </ul>
                }
            </li>
        }
    };

    // A node's row: its disclosure, its marker, its thumbnail, its name and the caller's content.
    private RenderFragment RenderNode(VisibleNode row, string? ownsId) => __builder =>
    {
        var node = row.Node;
        var key = View.ItemKey(node);
        var canOpen = View.CanOpen(node);
        var isOpen = canOpen && View.IsOpen(node);
        var isLoading = View.IsLoadingChildren(node);
        var name = View.ItemName(node);
        var nameId = GetNodeNameId(node);

        <div class="@GetNodeClass(node)"
             style="@GetNodeStyle(row.Depth)"
             role="treeitem"
             aria-level="@row.Depth"
             aria-setsize="@row.SetSize"
             aria-posinset="@row.Position"
             aria-expanded="@(canOpen ? isOpen ? "true" : "false" : null)"
             aria-selected="@GetAriaSelected(node)"
             aria-labelledby="@nameId"
             aria-owns="@ownsId"
             tabindex="@GetNodeTabIndex(key)"
             data-focus-heir="@GetHeirMark(key, marker: false)"
             data-item="@(HasSelection ? View.GetItemToken(node) : null)"
             data-item-position="@row.Row"
             @onfocusin="() => HandleNodeFocusIn(node)"
             @onfocusout="() => _focusedNode = default"
             @ref="_nodeElements[key]">
            @if (isLoading)
            {
                <span class="forma-data-tree-disclosure forma-data-tree-loading"><FormaSpinner Label="@L["Loading"]" Size="SpinnerSize.Small" /></span>
            }
            else if (canOpen)
            {
                <span class="forma-data-tree-disclosure" data-item-control>
                    <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" IconOnly="true" class="forma-data-tree-disclosure-button"
                                 aria-label="@(isOpen ? L["Close {Name}", name] : L["Open {Name}", name])" tabindex="-1"
                                 OnClick="() => ToggleNodeAsync(node)">
                        <FormaIcon Icon="@(isOpen ? Glyph.ChevronDown : Glyph.ChevronRight)" Size="IconSize.Small" />
                    </FormaButton>
                </span>
            }
            else
            {
                <span class="forma-data-tree-disclosure" aria-hidden="true"></span>
            }
            @if (HasSelection)
            {
                <span class="forma-data-tree-node-lead @(View.EnableCheckedSelection ? null : "forma-data-tree-node-lead-collapsed")" data-item-control>
                    <label class="@(View.EnableCheckedSelection ? "forma-data-view-box-target" : null)">
                        <FormaCheckBox class="@(View.EnableCheckedSelection ? null : "forma-data-tree-node-marker")"
                                       data-row-key="@View.GetItemToken(node)"
                                       data-focus-heir="@GetHeirMark(key, marker: true)"
                                       aria-label="@L["Select Item"]"
                                       aria-disabled="@(!View.CanInteractWith(node) ? "true" : null)"
                                       Value="@View.IsSelected(node)"
                                       PreventDefault="true"
                                       OnClick="() => Interaction.ToggleSelectionAsync(node, !View.IsSelected(node))"
                                       ValueExpression="() => NodeSelection"
                                       @ref="_nodeMarkers[key]" />
                    </label>
                </span>
            }
            @if (ThumbnailTemplate is { } thumbnail)
            {
                <span class="forma-data-tree-node-thumbnail">@thumbnail(node)</span>
            }
            <span class="forma-data-tree-node-name" id="@nameId">@name</span>
            @if (ItemTemplate is { } detail)
            {
                <span class="forma-data-tree-node-detail">@detail(node)</span>
            }
        </div>
    };
}
