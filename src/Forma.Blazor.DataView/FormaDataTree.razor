@namespace Forma.Blazor.Components.DataView
@inherits FormaElementBase
@typeparam TItem where TItem : notnull

@using Forma.Blazor.Components.Virtualization

@if (IsActive)
{
    // The rows settle before the root is drawn, since settling decides whether the root holds the focus itself.
    if (View.AreRootsLoaded)
    {
        SettleRows();
    }

    <div id="@Id"
         data-rid="@Context.RuntimeId"
         class="@RootClass"
         style="@RootStyle"
         @attributes="_collectionName.RootAttributes"
         @ref="RootElement"
         tabindex="@(_holdsFocus ? "-1" : null)"
         data-focus-heir="@(_focusesSelf ? string.Empty : null)">
        @if (!View.AreRootsLoaded)
        {
            <div class="forma-data-tree-state">@View.LoadingContent</div>
        }
        else if (GetRoots().Count == 0)
        {
            <div class="forma-data-tree-state">@View.EmptyContent</div>
        }
        else if (IsVirtualizing)
        {
            @* Virtualizing, the visible nodes stand in one run, each carrying its level and its place among its siblings. *@
            <div class="forma-data-tree-level" role="tree" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                <FormaVirtualize @ref="_virtualizer" TItem="VisibleNode" Items="_visibleRows" ItemKey="GetRowKey" ItemSize="View.ItemHeight" OverscanCount="View.OverscanCount" PinnedKeys="GetPinnedKeys()">
                    <ItemContent Context="row">
                        <div class="forma-data-tree-item" role="none">
                            @RenderNode(row, null)
                        </div>
                    </ItemContent>
                </FormaVirtualize>
            </div>
        }
        else
        {
            <ul class="forma-data-tree-level" role="tree" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                @RenderLevel(GetRoots(), 1)
            </ul>
        }
    </div>
}

@code {
    // Each node is a row, its children in a group beneath it while open, which the row owns.
    private RenderFragment RenderLevel(IReadOnlyList<TItem> nodes, int depth) => __builder =>
    {
        foreach (var node in nodes)
        {
            var children = View.CanOpen(node) && View.IsOpen(node) ? GetChildren(node) : [];
            var childrenId = GetNodeChildrenId(node);

            @* The row is the tree item, since it is what carries the focus; the list item around it holds the row and the children's group. *@
            <li class="forma-data-tree-item" role="none" @key="View.ItemKey(node)">
                @RenderNode(new VisibleNode(node, depth, null, null, null), children.Count > 0 ? childrenId : null)
                @if (children.Count > 0)
                {
                    <ul class="forma-data-tree-level" role="group" id="@childrenId">
                        @RenderLevel(children, depth + 1)
                    </ul>
                }
            </li>
        }
    };

    // A node's row, which draws again only when its own state, its place or what every node is drawn by changed, so the tree gives it the
    // token the selection behavior knows it by on every pass, which is what keeps the token from being retired.
    private RenderFragment RenderNode(VisibleNode row, string? ownsId) => __builder =>
    {
        <FormaDataTreeNode TItem="TItem" Tree="this" Item="row.Node" Depth="row.Depth" SiblingPosition="row.Position" SetSize="row.SetSize" Position="row.Row" OwnsId="@ownsId" Token="View.GetItemToken(row.Node)" Revision="NodeRevision" />
    };
}
