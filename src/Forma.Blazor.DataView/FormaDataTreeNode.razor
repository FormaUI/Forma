@namespace Forma.Blazor.Components.DataView
@inherits FormaComponentBase
@typeparam TItem where TItem : notnull

@{
    var key = View.ItemKey(Item);
    var canOpen = View.CanOpen(Item);
    var isOpen = canOpen && View.IsOpen(Item);
    var isLoading = View.IsLoadingChildren(Item);
    var name = View.ItemName(Item);
    var nameId = Tree.GetNodeNameId(Item);
}

<div class="@Tree.GetNodeClass(Item)"
     style="@(FormaDataTree<TItem>.GetNodeStyle(Depth))"
     role="treeitem"
     aria-level="@Depth"
     aria-setsize="@SetSize"
     aria-posinset="@SiblingPosition"
     aria-expanded="@(canOpen ? isOpen ? "true" : "false" : null)"
     aria-selected="@Tree.GetAriaSelected(Item)"
     aria-labelledby="@nameId"
     aria-owns="@OwnsId"
     tabindex="@Tree.GetNodeTabIndex(key)"
     data-focus-heir="@Tree.GetHeirMark(key, marker: false)"
     data-item="@(Tree.HasSelection ? Token : null)"
     data-item-position="@Position"
     @onfocusin="Tree.GetNodeFocusInHandler(Item)"
     @onfocusout="Tree.GetNodeFocusOutHandler()"
     @ref="Tree.NodeElements[key]">
    @if (isLoading)
    {
        <span class="forma-data-tree-disclosure forma-data-tree-loading"><FormaSpinner Label="@L["Loading"]" Size="SpinnerSize.Small" /></span>
    }
    else if (canOpen)
    {
        <span class="forma-data-tree-disclosure" data-item-control>
            <FormaButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Mini" IconOnly="true" class="forma-data-tree-disclosure-button"
                         aria-label="@(isOpen ? L["Close {Name}", name] : L["Open {Name}", name])" tabindex="-1"
                         OnClick="() => Tree.ToggleNodeAsync(Item)">
                <FormaIcon Icon="@(isOpen ? Glyph.ChevronDown : Glyph.ChevronRight)" Size="IconSize.Small" />
            </FormaButton>
        </span>
    }
    else
    {
        <span class="forma-data-tree-disclosure" aria-hidden="true"></span>
    }
    @if (Tree.HasSelection)
    {
        <span class="forma-data-tree-node-lead @(View.EnableCheckedSelection ? null : "forma-data-tree-node-lead-collapsed")" data-item-control>
            <label class="@(View.EnableCheckedSelection ? "forma-data-view-box-target" : null)">
                <FormaCheckBox class="@(View.EnableCheckedSelection ? null : "forma-data-tree-node-marker")"
                               data-row-key="@Token"
                               data-focus-heir="@Tree.GetHeirMark(key, marker: true)"
                               aria-label="@L["Select Item"]"
                               aria-disabled="@(!View.CanInteractWith(Item) ? "true" : null)"
                               Value="@View.IsSelected(Item)"
                               PreventDefault="true"
                               OnClick="() => Interaction.ToggleSelectionAsync(Item, !View.IsSelected(Item))"
                               ValueExpression="() => NodeSelection"
                               @ref="Tree.NodeMarkers[key]" />
            </label>
        </span>
    }
    @if (Tree.ThumbnailTemplate is { } thumbnail)
    {
        <span class="forma-data-tree-node-thumbnail">@thumbnail(Item)</span>
    }
    <span class="forma-data-tree-node-name" id="@nameId">@name</span>
    @if (Tree.ItemTemplate is { } detail)
    {
        <span class="forma-data-tree-node-detail">@detail(Item)</span>
    }
</div>
