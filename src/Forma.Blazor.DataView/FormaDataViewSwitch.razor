@namespace Forma.Blazor.Components.DataView
@inherits FormaElementBase
@using Forma.Framework.Culture

<div id="@Id"
     data-rid="@Context.RuntimeId"
     class="@RootClass"
     style="@RootStyle"
     role="group"
     aria-label="@L["View"]"
     @attributes="AdditionalAttributes"
     @ref="RootElement">
    @foreach (var view in Views.Views.Where(view => !view.IsCompanion))
    {
        <FormaToggleButton Icon="@view.Glyph"
                           Label="@Context.CultureState.Run(view.GetName)"
                           ShowLabel="true"
                           class="forma-data-view-switch-button"
                           Pressed="@(view.Key == Views.ActiveViewKey)"
                           OnClick="() => Views.SwitchViewAsync(view.Key)"
                           @key="view.Key" />
    }
</div>
