@namespace Forma.Blazor.Components.DataView
@inherits FormaElementBase
@typeparam TItem where TItem : notnull

@using Microsoft.AspNetCore.Components.Web.Virtualization

@if (IsActive)
{
    RenderFragment<(TItem Item, int? Position)> card = entry =>
    {
        var item = entry.Item;

        return @<div class="@GetCardClass(item)"
                     role="listitem"
                     aria-selected="@GetAriaSelected(item)"
                     aria-setsize="@(entry.Position is null || View.IsGrouped ? null : View.TotalItemCount)"
                     aria-posinset="@(entry.Position is null || View.IsGrouped ? null : entry.Position + 1)"
                     data-item-position="@entry.Position"
                     data-item="@View.GetItemToken(item)"
                     @key="View.ItemKey(item)">
            <div class="forma-data-card-thumbnail">
                @if (ThumbnailTemplate is { } thumbnail)
                {
                    @thumbnail(item)
                }
                @if (HasSelection)
                {
                    <span class="forma-data-card-lead" data-item-control>
                        <label class="@(View.EnableCheckedSelection ? "forma-data-view-box-target" : null)">
                            <FormaCheckBox class="@(View.EnableCheckedSelection ? "forma-data-card-box" : "forma-data-card-marker")"
                                           data-row-key="@View.GetItemToken(item)"
                                           aria-label="@L["Select Item"]"
                                           aria-disabled="@(!View.CanInteractWith(item) ? "true" : null)"
                                           Value="@View.IsSelected(item)"
                                           PreventDefault="true"
                                           OnClick="() => Interaction.ToggleSelectionAsync(item, !View.IsSelected(item))"
                                           ValueExpression="() => ItemSelection" />
                        </label>
                        @if (!View.EnableCheckedSelection && View.IsSelected(item))
                        {
                            <span class="forma-data-card-check" aria-hidden="true"><FormaIcon Icon="Glyph.Check" Size="IconSize.Small" /></span>
                        }
                    </span>
                }
            </div>
            <div class="forma-data-card-info">
                <span class="forma-data-card-name">@View.ItemName(item)</span>
                @if (!Dense && ItemTemplate is { } detail)
                {
                    <div class="forma-data-card-detail">@detail(item)</div>
                }
            </div>
            @if (!Dense && ActionsTemplate is { } actions)
            {
                <div class="forma-data-card-actions" data-item-control>@actions(item)</div>
            }
        </div>;
    };

    <div id="@Id"
         data-rid="@Context.RuntimeId"
         class="@RootClass"
         style="@RootStyle"
         @attributes="_collectionName.RootAttributes"
         @ref="RootElement">
        @if (!View.HasLoaded)
        {
            <div class="forma-data-cards-state">@View.LoadingContent</div>
        }
        else if (IsVirtualizing)
        {
            @* The ruler is an empty pack; the columns it lays out at the width are the columns every row holds. *@
            <div class="forma-data-cards-rows" role="list" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                <div class="forma-data-cards-pack forma-data-cards-ruler" aria-hidden="true" @ref="_rulerElement"></div>
                @if (View.TotalItemCount == 0)
                {
                    <div class="forma-data-cards-state" role="none">@View.EmptyContent</div>
                }
                else if (_areColumnsKnown)
                {
                    <Virtualize @ref="_virtualizer"
                                TItem="DataViewRow<TItem>"
                                ItemsProvider="_rows.ProvideAsync"
                                ItemComparer="_rows.Comparer"
                                ItemSize="View.ItemHeight"
                                OverscanCount="View.OverscanCount"
                                AnchorMode="View.AnchorMode"
                                InitialItemIndex="_initialRowIndex">
                        <ItemContent Context="row">
                            @if (row.Group is { } group)
                            {
                                <div class="forma-data-cards-heading-row" role="listitem" @key="group.Key">
                                    <FormaDataGroupHeading TItem="TItem" Group="group" IsFolded="View.IsFolded(group)" OnToggle="() => Interaction.ToggleGroupAsync(group)" />
                                </div>
                            }
                            else
                            {
                                <div class="forma-data-cards-pack forma-data-cards-row" role="none" @key="row.FirstItemIndex">
                                    @foreach (var (offset, item) in row.Items.Index())
                                    {
                                        @card((item, row.FirstItemIndex + offset))
                                    }
                                </div>
                            }
                        </ItemContent>
                        <Placeholder>
                            <div class="forma-data-cards-placeholder-row" role="none" style="@PlaceholderStyle"></div>
                        </Placeholder>
                    </Virtualize>
                }
            </div>
        }
        else if (View.Items.Count == 0)
        {
            <div class="forma-data-cards-state">@View.EmptyContent</div>
        }
        else if (View.IsGrouped)
        {
            <div class="forma-data-cards-groups" role="group" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                @foreach (var (index, group) in View.Groups.Index())
                {
                    var isFolded = View.IsFolded(group);
                    var nameId = GetGroupNameId(index);

                    <section class="forma-data-cards-group" @key="group.Key">
                        <FormaDataGroupHeading TItem="TItem" Group="group" NameId="@nameId" IsFolded="isFolded" OnToggle="() => Interaction.ToggleGroupAsync(group)" />
                        @if (!isFolded)
                        {
                            <div class="forma-data-cards-pack" role="list" aria-labelledby="@nameId">
                                @foreach (var item in group.Items)
                                {
                                    @card((item, null))
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
        else
        {
            <div class="forma-data-cards-pack" role="list" aria-label="@_collectionName.Label" aria-labelledby="@_collectionName.LabelledBy">
                @foreach (var item in View.Items)
                {
                    @card((item, null))
                }
            </div>
        }
    </div>
}
