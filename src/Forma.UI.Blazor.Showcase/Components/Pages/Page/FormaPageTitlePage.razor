@page "/page-title"
@attribute [ShowcasePage("FormaPageTitle")]
@using Forma.UI.Blazor.Components.Navigation
@using Forma.UI.Blazor.Components.Page
@inject IStringLocale<FormaPageTitlePage> L

<h1>FormaPageTitle</h1>
<p class="description">@L["Page header with title, breadcrumb navigation, and optional action slot."]</p>

<div class="demo-section">
    <h2>@L["Basic with Breadcrumbs"]</h2>
    <div class="demo-box">
        <FormaPageTitle Title="@L["Orders"]"
                       Breadcrumbs="BasicBreadcrumbs" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Title Only"]</h2>
    <div class="demo-box">
        <FormaPageTitle Title="@L["Dashboard"]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["With Action Buttons"]</h2>
    <div class="demo-box">
        <FormaPageTitle Title="@L["Products"]"
                       Breadcrumbs="ProductsBreadcrumbs">
            <Actions>
                <button class="button button-primary">@L["Add New"]</button>
                <button class="button button-secondary">@L["Export"]</button>
            </Actions>
        </FormaPageTitle>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Deep Breadcrumb Trail"]</h2>
    <div class="demo-box">
        <FormaPageTitle Title="@L["Edit Product"]"
                       Breadcrumbs="DeepBreadcrumbs" />
    </div>
</div>

@code {
    private BreadcrumbItem<object?>[] BasicBreadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Store"]),
        new(L["Orders"])
    ];

    private BreadcrumbItem<object?>[] ProductsBreadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Store"]),
        new(L["Products"])
    ];

    private BreadcrumbItem<object?>[] DeepBreadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Store"]),
        new(L["Products"], "/products"),
        new(L["Edit Product"])
    ];
}
