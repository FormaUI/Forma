@page "/multi-select"
@attribute [ShowcasePage("FormaMultiSelect")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Forma.UI.Blazor.Components.Input
@inject IStringLocale<FormaMultiSelectPage> L

<h1>FormaMultiSelect</h1>
<p class="desc">@L["A chip-style multi-select with a searchable checkbox-list popup. Selected values render as removable tags; the popup stays anchored to its trigger wherever the page scrolls."]</p>

<EditForm Model="Model" FormName="multi-select-demo" OnValidSubmit="HandleSubmit">
    <div class="demo-section">
        <h2>@L["Basic"]</h2>
        <div class="demo-box">
            <FormaMultiSelect TValue="int" @bind-Value="Model.Categories" Options="CategoryOptions" Label="@L["Categories"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["With Label and Placeholder"]</h2>
        <div class="demo-box">
            <FormaMultiSelect TValue="int" @bind-Value="Model.Tags"
                                      Options="TagOptions"
                                      Label="@L["Tags"]"
                                      Placeholder="@L["Choose tags"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Pre-selected Values"]</h2>
        <div class="demo-box">
            <FormaMultiSelect TValue="int" @bind-Value="Model.PreSelectedCategories"
                                      Options="CategoryOptions"
                                      Label="@L["Categories"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Add New Option"]</h2>
        <p class="desc">@L["Search for a tag that doesn't exist yet, then use \"Add new\" to create and select it."]</p>
        <div class="demo-box">
            <FormaMultiSelect TValue="int" @bind-Value="Model.CustomTags"
                                      Options="_customTagOptions"
                                      Label="@L["Custom Tags"]"
                                      AllowAdd="true"
                                      OnAddNew="HandleAddNewTag" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Nothing to choose from"]</h2>
        <p class="desc">@L["Opening a list whose options have not loaded yet shows the empty notice rather than a blank popup."]</p>
        <div class="demo-box">
            <FormaMultiSelect TValue="int" @bind-Value="Model.EmptyChoices"
                                      Options="_emptyOptions"
                                      Label="@L["Playlists"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Disabled"]</h2>
        <div class="demo-box">
            <FormaMultiSelect TValue="int" @bind-Value="Model.DisabledCategories"
                                      Options="CategoryOptions"
                                      Label="@L["Categories"]"
                                      Disabled="true" />
        </div>
    </div>
</EditForm>

@code {
    private readonly List<SelectOption<int>> _emptyOptions = [];

    private static readonly IReadOnlyList<SelectOption<int>> CategoryOptions =
    [
        new(1, "Road"),
        new(2, "Mountain"),
        new(3, "Track"),
        new(4, "Gravel"),
        new(5, "BMX"),
        new(6, "Cyclocross"),
    ];

    private static readonly IReadOnlyList<SelectOption<int>> TagOptions =
    [
        new(1, "Breaking News"),
        new(2, "Interview"),
        new(3, "Race Report"),
        new(4, "Opinion"),
        new(5, "Tech"),
        new(6, "Training"),
        new(7, "Transfer"),
    ];

    private List<SelectOption<int>> _customTagOptions =
    [
        new(1, "Sponsored"),
        new(2, "Editor's Pick"),
    ];

    private MultiSelectDemoModel Model { get; set; } = new()
    {
        PreSelectedCategories = [1, 3],
        DisabledCategories = [2],
    };

    private void HandleSubmit() { }

    private void HandleAddNewTag(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        var nextValue = _customTagOptions.Count == 0 ? 1 : _customTagOptions.Max(o => o.Value) + 1;
        _customTagOptions = [.. _customTagOptions, new SelectOption<int>(nextValue, text)];
        Model.CustomTags = [.. Model.CustomTags, nextValue];
    }

    private sealed class MultiSelectDemoModel
    {
        public List<int> Categories { get; set; } = [];
        public List<int> Tags { get; set; } = [];
        public List<int> PreSelectedCategories { get; set; } = [];
        public List<int> CustomTags { get; set; } = [];
        public List<int> EmptyChoices { get; set; } = [];
        public List<int> DisabledCategories { get; set; } = [];
    }
}
