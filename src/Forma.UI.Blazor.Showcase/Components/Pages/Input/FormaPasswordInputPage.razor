@page "/password-input"
@attribute [ShowcasePage("FormaPasswordInput")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Forma.UI.Components.Input
@inject IStringLocale<FormaPasswordInputPage> L

<h1>FormaPasswordInput</h1>
<p class="desc">@L["A password field with a toggle that reveals the typed value, sharing FormaInput's floating label and validation chrome."]</p>

<EditForm Model="_model">

<div class="demo-section">
    <h2>@L["Basic"]</h2>
    <div class="demo-box">
        <FormaPasswordInput @bind-Value="_model.CurrentPassword" Label="@L["Password"]" />
        <p class="demo-output">@L["Characters typed"]: <code>@(_model.CurrentPassword?.Length ?? 0)</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Without a Toggle"]</h2>
    <p class="desc">@L["A one-time code or a field the caller never wants revealed can hide the toggle entirely."]</p>
    <div class="demo-box">
        <FormaPasswordInput @bind-Value="_model.OneTimeCode" Label="@L["One-time code"]" ShowToggle="false" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["New Password with Confirmation"]</h2>
    <p class="desc">@L["The autocomplete token is \"new-password\" here, so a browser offers to generate and save one instead of filling the existing sign-in password."]</p>
    <div class="demo-box">
        <FormaPasswordInput @bind-Value="_model.NewPassword" Label="@L["New password"]" AutoComplete="new-password" Required="true" />
        <FormaPasswordInput @bind-Value="_model.ConfirmPassword" Label="@L["Confirm new password"]" AutoComplete="new-password" Required="true" />
        <FormaButton OnClick="Validate">@L["Save password"]</FormaButton>
        @if (_validationMessage is not null)
        {
            <p class="demo-note">@_validationMessage</p>
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Strength Meter"]</h2>
    <p class="desc">@L["Type to see the rating. The bar is decorative — the words beside it are what carry the rating, so it still reads on a desaturated screen or to a screen reader."]</p>
    <div class="demo-box">
        <FormaPasswordInput @bind-Value="_model.RatedPassword" Label="@L["Password"]" AutoComplete="new-password" ShowStrengthMeter="true" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["What the Password Still Needs"]</h2>
    <p class="desc">@L["Advice can accompany the meter, naming each criterion the value has yet to earn. Every line disappears as it is met, so the list empties rather than scolding."]</p>
    <div class="demo-box">
        <FormaPasswordInput @bind-Value="_model.AdvisedPassword" Label="@L["Password"]" AutoComplete="new-password"
                            ShowStrengthMeter="true" ShowStrengthAdvice="true" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["A Host's Own Policy"]</h2>
    <p class="desc">@L[$"An application with a real password policy supplies its own evaluator instead of the built-in judgement. This one only calls a password strong once it reaches {StrongLength} characters."]</p>
    <div class="demo-box">
        <FormaPasswordInput @bind-Value="_model.PolicyPassword" Label="@L["Password"]" AutoComplete="new-password"
                            ShowStrengthMeter="true" StrengthEvaluator="RateByLength" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Not Your Other Details"]</h2>
    <p class="desc">@L["Type an email and a phone number, then try building a password out of either. Whole parts count, so the local part of the address or one group of the number is enough to be turned down."]</p>
    <div class="demo-box">
        <FormaInput Label="@L["Email"]" @bind-Value="_model.Email" Type="email" />
        <FormaInput Label="@L["Phone"]" @bind-Value="_model.Phone" Type="tel" />
        <FormaPasswordInput @bind-Value="_model.PersonalPassword" Label="@L["Password"]" AutoComplete="new-password"
                            ShowStrengthMeter="true" ForbiddenTerms="@(new[] { _model.Email, _model.Phone })" />
    </div>
</div>

</EditForm>

@code {
    private const int StrongLength = 16;
    private const int RequiredLength = 6;

    private readonly DemoModel _model = new();
    private string? _validationMessage;

    private static PasswordStrength RateByLength(string value)
        => value.Length switch
        {
            >= StrongLength => PasswordStrength.Strong,
            >= 12 => PasswordStrength.Good,
            >= 8 => PasswordStrength.Fair,
            _ => PasswordStrength.Weak,
        };

    private void Validate()
    {
        if (string.IsNullOrEmpty(_model.NewPassword) || _model.NewPassword.Length < RequiredLength)
        {
            _validationMessage = L["[$ plural; one: The password must be at least # character.; other: The password must be at least # characters.; $]", RequiredLength];
        }
        else if (_model.NewPassword != _model.ConfirmPassword)
        {
            _validationMessage = L["The passwords do not match."];
        }
        else
        {
            _validationMessage = L["Password saved."];
        }
    }

    private sealed class DemoModel
    {
        public string? CurrentPassword { get; set; }
        public string? OneTimeCode { get; set; }
        public string? NewPassword { get; set; }
        public string? ConfirmPassword { get; set; }
        public string? RatedPassword { get; set; }
        public string? AdvisedPassword { get; set; }
        public string? PolicyPassword { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? PersonalPassword { get; set; }
    }
}
