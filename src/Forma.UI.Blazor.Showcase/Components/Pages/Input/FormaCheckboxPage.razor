@page "/checkbox"
@attribute [ShowcasePage("FormaCheckbox")]
@rendermode InteractiveServer
@using Forma.UI.Components.Input
@inject IStringLocale<FormaCheckboxPage> L

<h1>FormaCheckbox</h1>
<p class="desc">@L["A styled checkbox with a script-driven indeterminate state, and an option to suppress the native toggle so the caller owns the checked state, as a tri-state select-all does."]</p>

<div class="demo-section">
    <h2>@L["Basic"]</h2>
    <div class="demo-box demo-row">
        <FormaCheckbox Checked="_basic" CheckedChanged="v => _basic = v">@L["Subscribe to updates"]</FormaCheckbox>
        <FormaCheckbox Checked="_prechecked" CheckedChanged="v => _prechecked = v">@L["Featured"]</FormaCheckbox>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Disabled"]</h2>
    <div class="demo-box demo-row">
        <FormaCheckbox Checked="false" Disabled="true">@L["Off"]</FormaCheckbox>
        <FormaCheckbox Checked="true" Disabled="true">@L["On"]</FormaCheckbox>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Indeterminate"]</h2>
    <p class="desc">@L["The parent checkbox reflects and controls the state of its children, showing a dash when only some are checked."]</p>
    <div class="demo-box">
        <FormaCheckbox Checked="@AllChildrenChecked" Indeterminate="@SomeChildrenChecked" PreventDefault="true" OnClick="ToggleAllChildren">@L["Select all"]</FormaCheckbox>
        <div class="demo-row demo-checkbox-children">
            @for (var i = 0; i < _children.Length; i++)
            {
                var index = i;
                <FormaCheckbox Checked="_children[index]" CheckedChanged="v => _children[index] = v">@L["Item {number}", ("number", index + 1)]</FormaCheckbox>
            }
        </div>
    </div>
</div>

@code {
    private bool _basic;
    private bool _prechecked = true;
    private readonly bool[] _children = new bool[3];

    private bool AllChildrenChecked
        => Array.TrueForAll(_children, value => value);

    private bool SomeChildrenChecked
        => Array.Exists(_children, value => value) && !AllChildrenChecked;

    private void ToggleAllChildren()
    {
        var next = !AllChildrenChecked;
        Array.Fill(_children, next);
    }
}
