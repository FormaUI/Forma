@page "/search-toolbar"
@attribute [ShowcasePage("FormaSearchToolbar")]
@rendermode InteractiveServer
@using Forma.UI.Blazor.Components.Buttons
@using Forma.UI.Blazor.Components.Layout
@using Forma.UI.Style.Glyphs
@using Microsoft.AspNetCore.Components.Web
@inject IStringLocale<FormaSearchToolbarPage> L

<h1>FormaSearchToolbar</h1>
<p class="description">@L["A search field and the actions that apply to the list it filters, in one row at the top of a list page."]</p>

<div class="demo-section">
    <h2>@L["Search Only"]</h2>
    <div class="demo-box">
        <FormaSearchToolbar OnSearch="HandleSearch1" SearchPlaceholder="@L["Search..."]" />
        <p class="demo-output">@L["Last search"]: <code>@_lastSearch1</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Search with Actions"]</h2>
    <div class="demo-box">
        <FormaSearchToolbar OnSearch="HandleSearch3" SearchPlaceholder="@L["Search..."]" Label="@L["List Actions"]" Items="_actions" OnCommand="HandleCommand" />
        <p class="demo-output">@L["Last search"]: <code>@_lastSearch3</code></p>
        <p class="demo-output">@L["Last command"]: <code>@_lastCommand</code></p>
    </div>
</div>

@code {
    private string _lastSearch1 = "";
    private string _lastSearch3 = "";
    private string _lastCommand = "";

    private IReadOnlyList<FormaToolbarItem> _actions =>
    [
        new FormaToolbarCommand { Id = "add", Title = L["Add New"], Icon = Glyph.Plus, Command = "add-new" },
        new FormaToolbarCommand { Id = "export", Title = L["Export"], Icon = Glyph.Download, Command = "export" },
    ];

    private void HandleCommand(string command)
        => _lastCommand = command;

    private Task HandleSearch1(string value)
    {
        _lastSearch1 = value;
        return Task.CompletedTask;
    }

    private Task HandleSearch3(string value)
    {
        _lastSearch3 = value;
        return Task.CompletedTask;
    }
}
