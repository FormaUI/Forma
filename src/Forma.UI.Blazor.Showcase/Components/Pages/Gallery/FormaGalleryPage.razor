@page "/gallery"
@attribute [ShowcasePage("FormaGallery")]
@rendermode InteractiveServer
@using Forma.UI.Components.Gallery

<h1>FormaGallery</h1>
<p class="desc">@L["A manager for media already on the server, in the shape of a gallery app: a dense thumbnail grid, folders, selection, pagination, upload, and enlargement through FormaFileViewer."]</p>

<div class="demo-section">
    <h2>@L["Full media gallery"]</h2>
    <p class="desc">@L["Browse folders, preview media, select items, rename, delete, and upload."]</p>
    <div class="demo-box">
        <FormaGallery ResourcesProvider="@(ProviderFor("full"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("full"))"
                      TotalCount="_allMedia.Count"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("full", folder))"
                      SelectedChanged="@(resources => HandleSelectedAsync("full", resources))"
                      OnRename="@(req => HandleRenameAsync("full", req))"
                      OnDelete="@(req => HandleDeleteAsync("full", req))"
                      OnDrop="@(req => HandleDropAsync("full", req))"
                      OnFolderDrop="@(req => HandleFolderDropAsync("full", req))"
                      OnFolderCreate="@(req => HandleFolderCreateAsync("full", req))"
                      OnFolderRename="@(req => HandleFolderRenameAsync("full", req))"
                      OnFolderDelete="@(req => HandleFolderDeleteAsync("full", req))"
                      OnUploaded="@(resources => HandleUploadedAsync("full", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("full"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Single selection for a cover image"]</h2>
    <p class="desc">@L["With MaxSelection set to 1, picking any item immediately selects it alone. This one holds its collection through Resources, which is the simpler half of the contract and the right choice for a handful of items."]</p>
    <div class="demo-box">
        <FormaGallery Resources="_singleSelectResources"
                      MaxSelection="1"
                      SelectedChanged="@(resources => HandleSelectedAsync("single", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("single"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Details columns"]</h2>
    <p class="desc">@L["DetailsColumns picks which optional columns the details view renders beside the name. Nothing wraps, so a narrow gallery scrolls sideways rather than squeezing a column out."]</p>
    <div class="demo-box">
        <fieldset class="demo-row">
            <legend>@L["Columns"]</legend>
            @foreach (var column in ColumnChoices)
            {
                <label>
                    <input type="checkbox"
                           checked="@_detailsColumns.HasFlag(column)"
                           @onchange="@(e => ToggleColumn(column, (bool)e.Value!))" />
                    @ColumnLabel(column)
                </label>
            }
        </fieldset>
        <FormaGallery Resources="_allMedia"
                      ViewMode="GalleryViewMode.Details"
                      Options="@(new FormaGalleryOptions { DetailsColumns = _detailsColumns, ShowSidebar = false })" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Read-only gallery"]</h2>
    <p class="desc">@L["With FormaGalleryFileOptions.ReadOnly, browsing and selection remain while upload, rename, delete, and every folder action disappear."]</p>
    <div class="demo-box">
        <FormaGallery ResourcesProvider="@(ProviderFor("readonly"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("readonly"))"
                      TotalCount="_allMedia.Count"
                      FileOptions="FormaGalleryFileOptions.ReadOnly"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("readonly", folder))"
                      SelectedChanged="@(resources => HandleSelectedAsync("readonly", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("readonly"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Media without folder management"]</h2>
    <p class="desc">@L["Media stays fully editable while the folder tree is fixed, so items can be renamed and deleted but folders cannot."]</p>
    <div class="demo-box">
        <FormaGallery ResourcesProvider="@(ProviderFor("fixedfolders"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("fixedfolders"))"
                      TotalCount="_allMedia.Count"
                      FileOptions="_fixedFolderOptions"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("fixedfolders", folder))"
                      OnRename="@(req => HandleRenameAsync("fixedfolders", req))"
                      OnDelete="@(req => HandleDeleteAsync("fixedfolders", req))"
                      OnUploaded="@(resources => HandleUploadedAsync("fixedfolders", resources))" />
        <ul class="demo-log">
            @foreach (var resource in Log("fixedfolders"))
            {
                <li>@resource</li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Breadcrumb-only navigation"]</h2>
    <p class="desc">@L["With ShowSidebar off, the folder tree is hidden and folders are reached through the breadcrumb menus instead."]</p>
    <div class="demo-box">
        <FormaGallery ResourcesProvider="@(ProviderFor("nosidebar"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("nosidebar"))"
                      TotalCount="_allMedia.Count"
                      Options="@(new FormaGalleryOptions { ShowSidebar = false })"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("nosidebar", folder))" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Sidebar without breadcrumb menus"]</h2>
    <p class="desc">@L["With ShowFolderMenu off, the breadcrumbs become plain separators and the tree is the only way to change folder."]</p>
    <div class="demo-box">
        <FormaGallery ResourcesProvider="@(ProviderFor("nomenu"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("nomenu"))"
                      TotalCount="_allMedia.Count"
                      Options="@(new FormaGalleryOptions { ShowFolderMenu = false })"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("nomenu", folder))" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["A library too large to hold"]</h2>
    <p class="desc">@L["Twenty thousand items behind a provider. The gallery keeps only the window it is showing, and the folder never appears in the query because the page already knows it."]</p>
    <div class="demo-box">
        <FormaGallery ResourcesProvider="@(ProviderFor("library"))"
                      Folders="_sampleFolders"
                      CurrentFolder="@(CurrentFolderFor("library"))"
                      PageSize="12"
                      TotalCount="_libraryCount"
                      OnFolderChanged="@(folder => HandleFolderChangedAsync("library", folder))" />
        <p class="demo-note">@L["Windows fetched: {count}", ("count", _libraryStore.QueryCount)] — @LibraryQueryDescription</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Empty gallery"]</h2>
    <p class="desc">@L["When a folder has no media, the gallery displays an empty state."]</p>
    <div class="demo-box">
        <FormaGallery Resources="[]" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Paginated gallery"]</h2>
    <p class="desc">@L["A large collection splits across pages using FormaPagination."]</p>
    <div class="demo-box">
        <FormaGallery ResourcesProvider="@(ProviderFor("paged"))" PageSize="4" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Infinite scrolling gallery"]</h2>
    <p class="desc">@L["GalleryInfiniteScrollMode.Manual appends the next page as the reader nears the end, and offers a button for anyone not using a pointer. The media scrolls inside the panel, so the toolbar and folder tree stay put."]</p>
    <div class="demo-box">
        <FormaGallery ResourcesProvider="@(ProviderFor("infinite"))" PageSize="24" Options="@(new FormaGalleryOptions { InfiniteScroll = GalleryInfiniteScrollMode.Manual })" />
    </div>
</div>

<div class="demo-section">
    <h2>@L["Automatic infinite scrolling"]</h2>
    <p class="desc">@L["GalleryInfiniteScrollMode.Automatic drops the button entirely: pages arrive as the reader scrolls, marked by a spinner while each one loads, with the running count left as the reader's sense of position."]</p>
    <div class="demo-box">
        <FormaGallery ResourcesProvider="@(ProviderFor("infinite"))"
                      PageSize="24"
                      Options="@(new FormaGalleryOptions { InfiniteScroll = GalleryInfiniteScrollMode.Automatic })" />
    </div>
</div>
