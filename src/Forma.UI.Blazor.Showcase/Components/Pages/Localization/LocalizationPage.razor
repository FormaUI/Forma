@page "/localization"
@attribute [ShowcasePage("Localization")]
@rendermode InteractiveServer
@using System.Globalization
@using Forma.Framework.Localization
@using Forma.Framework.Localization.Language
@inject IStringLocale<LocalizationPage> L

<h1>Localization</h1>
<p class="desc">@L["Every string Forma renders resolves through IStringLocale. Switch the culture in the sidebar to watch each section below change."]</p>

<div class="demo-section">
    <h2>@L["The culture in force"]</h2>
    <div class="demo-box">
        <table class="demo-table">
            <tbody>
                <tr>
                    <th>@L["Translations are read for"]</th>
                    <td><code dir="ltr">@CultureInfo.CurrentUICulture.Name</code></td>
                </tr>
                <tr>
                    <th>@L["Numbers and dates format for"]</th>
                    <td><code dir="ltr">@CultureInfo.CurrentCulture.Name</code></td>
                </tr>
                <tr>
                    <th>@L["Plural rules follow"]</th>
                    <td><code dir="ltr">@Language</code></td>
                </tr>
                <tr>
                    <th>@L["Writing direction"]</th>
                    <td>@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? L["right to left"] : L["left to right"])</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A hit and a miss"]</h2>
    <p class="desc">@L["A key with no translation is returned as written and flagged, so nothing ever renders blank. In English both rows miss, because English is the language the keys are written in and carries no file of its own."]</p>
    <div class="demo-box">
        @foreach (var text in new[] { L["Save"], L[AbsentKey] })
        {
            <table class="demo-table">
                <tbody>
                    <tr>
                        <th>@L["Key"]</th>
                        <td dir="ltr"><code>@text.Name</code></td>
                    </tr>
                    <tr>
                        <th>@L["Result"]</th>
                        <td><bdi>@text.Value</bdi></td>
                    </tr>
                    <tr>
                        <th>@L["Translation"]</th>
                        <td><span class="demo-chip">@(text.ResourceNotFound ? L["missing"] : L["found"])</span></td>
                    </tr>
                    <tr>
                        <th>@L["Searched"]</th>
                        <td dir="ltr" class="demo-note"><code>@text.SearchedLocation</code></td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>

<div class="demo-section">
    <h2>@L["Holes filled with values"]</h2>
    <p class="desc">@L["Arguments stay as objects rather than text, so a format specifier written into a translation still reaches the value."]</p>
    <div class="demo-box">
        <div class="demo-row">
            <label class="demo-field">@L["Written"] <input type="number" class="demo-number" @bind="_written" @bind:event="oninput" /></label>
            <label class="demo-field">@L["Allowed"] <input type="number" class="demo-number" @bind="_allowed" @bind:event="oninput" /></label>
        </div>
        <p>@L["{0} of {1} characters", _written, _allowed]</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["An interpolated string"]</h2>
    <p class="desc">@L["The handler rebuilds the composite key from the literal text between the holes, then looks that up. The values never touch the key."]</p>
    <div class="demo-box">
        <p>@L[$"Stored {_written} of {_allowed}."]</p>
        <p class="demo-note">@L["Rebuilt key"]: <code dir="ltr">Stored {0} of {1}.</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Plural forms"]</h2>
    <p class="desc">@L["The count decides which branch of the construct is used. Try 1, 2 and 5, then switch to Hebrew, which has a dual the other two languages do not."]</p>
    <div class="demo-box">
        <div class="demo-row">
            <label class="demo-field">@L["Count"] <input type="number" step="0.5" class="demo-number" @bind="_count" @bind:event="oninput" /></label>
            <span class="demo-field">@L["Category"] <span class="demo-chip"><code dir="ltr">@CategoryFor(_count)</code></span></span>
        </div>
        <p>@L[PluralKey, _count]</p>
        <p class="demo-note"><code dir="ltr">@PluralKey</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["The categories this language uses"]</h2>
    <p class="desc">@L["A language selects only the categories it needs, so a construct only has to carry those. A category it never selects is simply unused."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <thead>
                <tr>
                    <th>@L["Count"]</th>
                    <th>@L["Category"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sample in Samples)
                {
                    <tr>
                        <td><code dir="ltr">@sample.ToString(CultureInfo.CurrentCulture)</code></td>
                        <td><code dir="ltr">@CategoryFor(sample)</code></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="demo-note">@L["1 and 1.0 can differ, because the rules read how the number was written rather than its value alone."]</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A count written two ways"]</h2>
    <p class="desc">@L["Both stand for the count. The hash is substituted while the plural is resolved and carries the culture's grouping; the numbered hole survives until the holes are filled."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <tbody>
                <tr>
                    <th><code dir="ltr">#</code></th>
                    <td>@L["[$ [0] plural; other: #; $]", 1234567]</td>
                </tr>
                <tr>
                    <th><code dir="ltr">{0}</code></th>
                    <td>@L["{0}", 1234567]</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["A branch that is missing"]</h2>
    <p class="desc">@L["A construct needs a branch for every category its language can select. When the one chosen is absent and there is no other branch to fall back to, the result is empty."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <tbody>
                <tr>
                    <th><code dir="ltr">@IncompleteKey</code></th>
                    <td>
                        <code dir="ltr">@L[IncompleteKey, 5].Value</code>
                        <span class="demo-note">@L["nothing at all"]</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="demo-section">
    <h2>@L["The language the keys are written in"]</h2>
    <p class="desc">@L["This key has no translation, so it is shown exactly as authored — in Hebrew. Its plural forms have to follow Hebrew, whatever language is on screen, and SourceLanguage is what says so."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <thead>
                <tr>
                    <th>@L["Setting"]</th>
                    <th>@L["Result"]</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th><code dir="ltr">SourceLanguage = "en"</code></th>
                    <td>@EnglishSource[HebrewSourceKey, 2].Value</td>
                </tr>
                <tr>
                    <th><code dir="ltr">SourceLanguage = "he"</code></th>
                    <td>@HebrewSource[HebrewSourceKey, 2].Value</td>
                </tr>
            </tbody>
        </table>
        <p class="demo-note">@L["Forma's own keys are English, so the default already matches and nothing needs configuring."]</p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Holes left open"]</h2>
    <p class="desc">@L["Resolve hands back the translated format with its holes still open, so a caller can render each value itself rather than pasting text together."]</p>
    <div class="demo-box">
        <table class="demo-table">
            <tbody>
                <tr>
                    <th>@L["Format"]</th>
                    <td><code>@Pattern.Format</code></td>
                </tr>
                <tr>
                    <th>@L["Arguments"]</th>
                    <td><code dir="ltr">@string.Join(", ", Pattern.Arguments)</code></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    private const string AbsentKey = "No translation exists for this sentence.";
    private const string PluralKey = "[$ [0] plural; one: # file; other: # files; $]";
    private const string IncompleteKey = "[$ [0] plural; one: # file; $]";
    private const string HebrewSourceKey = "[$ [0] plural; one: פריט אחד; two: שני פריטים; other: # פריטים; $]";

    private static readonly decimal[] Samples = [0m, 0.5m, 1m, 1.0m, 2m, 3m, 5m, 11m, 100m, 1000000m];

    private static readonly IStringLocale EnglishSource =
        new JsonStringLocaleFactory().Create(typeof(LocalizationPage));

    private static readonly IStringLocale HebrewSource =
        new JsonStringLocaleFactory(new JsonLocalizationOptions { SourceLanguage = "he" }).Create(typeof(LocalizationPage));

    private int _written = 5;
    private int _allowed = 280;
    private decimal _count = 1m;

    private static string Language
        => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private LocalizedPattern Pattern
        => L.Resolve("{0} of {1} characters", _written, _allowed);

    private static string CategoryFor(decimal count)
    {
        var category = CommonPluralRuleSet.Default.Select(Language, PluralOperands.From(count));

        return category?.ToString().ToLowerInvariant() ?? "other";
    }
}
