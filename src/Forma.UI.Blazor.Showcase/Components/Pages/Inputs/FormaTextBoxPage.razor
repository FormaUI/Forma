@page "/text-box"
@attribute [ShowcasePage("FormaTextBox")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Forma.UI.Blazor.Components.Buttons
@using Forma.UI.Blazor.Components.Inputs
@using Forma.UI.Style.Css
@using Microsoft.AspNetCore.Components.Forms
@inject IStringLocale<FormaTextBoxPage> L

<h1>FormaTextBox</h1>
<p class="description">@L["A plain single-line text field: the box every Forma input draws, without the floating label and validation chrome FormaField adds. It needs no surrounding form, which is what makes it the one to reach for in a toolbar, a filter row or a grid cell."]</p>

<div class="demo-section">
    <h2>@L["Basic Usage"]</h2>
    <p class="description">@L["No EditForm anywhere on this section — the field binds and updates on its own."]</p>
    <div class="demo-box">
        <FormaTextBox @bind-Value="_model.Name" Placeholder="@L["Enter a name..."]" aria-label="@L["Enter a name..."]" />
        <p class="demo-output">@L["Value"]: <code>@_model.Name</code></p>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Bare or Labeled"]</h2>
    <p class="description">@L["Giving a Label is what decides the shape. Without one the box stands bare and level with a button, which is what a toolbar or a grid cell wants. With one it wraps in the same FormaField the labeled inputs use, gaining the floating label and validation chrome rather than imitating them."]</p>
    <div class="demo-box">
        <div class="demo-stack">
            <div class="demo-row">
                <FormaTextBox @bind-Value="_model.NormalSize" Placeholder="@L["Bare"]" aria-label="@L["Bare"]" class="demo-row-field" />
                <FormaButton Variant="ButtonVariant.Secondary">@L["Add"]</FormaButton>
            </div>
            <EditForm Model="_model" FormName="textbox-sizes">
                <FormaTextBox @bind-Value="_model.LargeSize" Label="@L["Labeled, with a floating label"]" />
            </EditForm>
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Naming the Field"]</h2>
    <p class="description">@L["The text box carries no label of its own, so naming it is the caller's job and there are two ways to do it. A visible label is bound through Id; where no visible label belongs, aria-label names it instead. A placeholder is not a name — it disappears as soon as anyone types."]</p>
    <div class="demo-box">
        <div class="demo-stack">
            <label for="text-box-nickname">@L["Nickname"]</label>
            <FormaTextBox @bind-Value="_model.Nickname" Id="text-box-nickname" />

            <p class="demo-note">@L["Named by aria-label, with the placeholder repeating it for sighted readers:"]</p>
            <FormaTextBox @bind-Value="_model.Handle" Placeholder="@L["Handle"]" aria-label="@L["Handle"]" />
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Disabled and Read-Only"]</h2>
    <p class="description">@L["Both refuse edits and share a muted background, but they are not the same state: a disabled field is skipped by the keyboard and dimmed, while a read-only one still takes focus and reads at full contrast so its value stays legible."]</p>
    <div class="demo-box">
        <div class="demo-stack">
            <FormaTextBox @bind-Value="_model.DisabledValue" Disabled="true" aria-label="@L["Disabled Field"]" />
            <p class="demo-note">@L["Read-only, and still reachable by keyboard:"]</p>
            <FormaTextBox @bind-Value="_model.ReadOnlyValue" ReadOnly="true" aria-label="@L["Read-Only Field"]" />
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Form Validation"]</h2>
    <p class="description">@L["Inside an EditForm the field takes Blazor's validation classes. Saving while it is empty turns the border red without the field ever having been touched, and typing a value turns it green."]</p>
    <div class="demo-box">
        <EditForm Model="_validationModel" FormName="textbox-validation" OnValidSubmit="HandleValidationSubmit" class="demo-stack">
            <DataAnnotationsValidator />
            <FormaTextBox @bind-Value="_validationModel.Title" Placeholder="@L["Project Title (Required)"]" aria-label="@L["Project Title (Required)"]" />
            <ValidationMessage For="@(() => _validationModel.Title)" />
            <div class="demo-row">
                <FormaButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary">@L["Save"]</FormaButton>
                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <span role="status">@_statusMessage</span>
                }
            </div>
        </EditForm>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Beside a Labeled Field"]</h2>
    <p class="description">@L["Once labeled it is the same FormaField that wraps FormaPasswordBox and FormaTextArea, so the label, the box and the validation message are drawn by one component rather than three that could drift."]</p>
    <div class="demo-box">
        <EditForm Model="_model" FormName="textbox-parity">
            <FormaTextBox @bind-Value="_model.Title" Label="@L["Title"]" />
            <FormaTextBox @bind-Value="_model.Slug" Label="@L["Slug"]" />
        </EditForm>
    </div>
</div>

<div class="demo-section">
    <h2>@L["In a Toolbar Row"]</h2>
    <p class="description">@L["With no label to stack above it and no margin of its own, the field sits on one line beside a button. This one caps its length at twenty characters."]</p>
    <div class="demo-box">
        <div class="demo-stack">
            <div class="demo-row">
                <FormaTextBox @bind-Value="_model.Tag" Placeholder="@L["Add a tag..."]" aria-label="@L["Add a tag..."]" MaxLength="20" class="demo-row-field" />
                <FormaButton Variant="ButtonVariant.Secondary" OnClick="AddTag">@L["Add"]</FormaButton>
            </div>
            @if (_tags.Count > 0)
            {
                <div class="demo-row">
                    @foreach (var tag in _tags)
                    {
                        <span class="demo-chip">@tag</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Asking for the Right Keyboard"]</h2>
    <p class="description">@L["InputMode tells a touch device which keyboard to raise, and AutoComplete tells the browser what the field holds so it can fill it. Neither changes what the box accepts — they only make it quicker to fill on a phone. Open these on a touch device to see the keyboard change."]</p>
    <div class="demo-box">
        <div class="demo-stack">
            <label for="text-box-phone">@L["Telephone"]</label>
            <FormaTextBox @bind-Value="_model.Phone" Id="text-box-phone" InputMode="TextInputMode.Tel" AutoComplete="tel" />

            <label for="text-box-email">@L["Email"]</label>
            <FormaTextBox @bind-Value="_model.Email" Id="text-box-email" InputMode="TextInputMode.Email" AutoComplete="email" />

            <label for="text-box-quantity">@L["Quantity"]</label>
            <FormaTextBox @bind-Value="_model.Quantity" Id="text-box-quantity" InputMode="TextInputMode.Numeric" />

            <label for="text-box-amount">@L["Amount"]</label>
            <FormaTextBox @bind-Value="_model.Amount" Id="text-box-amount" InputMode="TextInputMode.Fractional" />
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["The Kind of Text Held"]</h2>
    <p class="description">@L["Type covers only the kinds a text box draws itself. A date, a number or a color belongs to the component built for it, where the browser supplies the editing surface, so those types cannot be set here at all."]</p>
    <div class="demo-box">
        <div class="demo-stack">
            <label for="text-box-plain">@L["Plain Text"]</label>
            <FormaTextBox @bind-Value="_model.Plain" Id="text-box-plain" Type="TextInputType.Text" />

            <label for="text-box-typed-email">@L["Email Address"]</label>
            <FormaTextBox @bind-Value="_model.TypedEmail" Id="text-box-typed-email" Type="TextInputType.Email" AutoComplete="email" />

            <label for="text-box-typed-tel">@L["Telephone Number"]</label>
            <FormaTextBox @bind-Value="_model.TypedTel" Id="text-box-typed-tel" Type="TextInputType.Tel" AutoComplete="tel" />

            <label for="text-box-typed-url">@L["Website Address"]</label>
            <FormaTextBox @bind-Value="_model.TypedUrl" Id="text-box-typed-url" Type="TextInputType.Url" AutoComplete="url" />
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Helping the Touch Keyboard"]</h2>
    <p class="description">@L["EnterKeyHint labels the keyboard's action key, AutoCapitalize decides what it capitalizes on its own, and SpellCheck turns the red underline on or off. None of them change what the box accepts — they only make it pleasanter to fill on a phone."]</p>
    <div class="demo-box">
        <div class="demo-stack">
            <label for="text-box-full-name">@L["Full Name"]</label>
            <FormaTextBox @bind-Value="_model.FullName" Id="text-box-full-name" AutoCapitalize="TextAutoCapitalize.Words" AutoComplete="name" />

            <label for="text-box-coupon">@L["Coupon Code"]</label>
            <FormaTextBox @bind-Value="_model.Coupon" Id="text-box-coupon" AutoCapitalize="TextAutoCapitalize.Characters" SpellCheck="false" EnterKeyHint="TextEnterKeyHint.Done" />

            <label for="text-box-message">@L["Message"]</label>
            <FormaTextBox @bind-Value="_model.Message" Id="text-box-message" AutoCapitalize="TextAutoCapitalize.Sentences" SpellCheck="true" EnterKeyHint="TextEnterKeyHint.Send" />
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Limiting What Is Accepted"]</h2>
    <p class="description">@L["MaxLength stops the typing outright, so the box simply refuses the twelfth character. MinLength and Pattern stop nothing — they mark the value invalid when the form is submitted, which is why they need a form and a message to be any use."]</p>
    <div class="demo-box">
        <EditForm Model="_patternModel" FormName="textbox-pattern" OnValidSubmit="HandlePatternSubmit" class="demo-stack">
            <DataAnnotationsValidator />

            <label for="text-box-code">@L["Product Code"]</label>
            <FormaTextBox @bind-Value="_patternModel.Code"
                          Id="text-box-code"
                          MinLength="4"
                          MaxLength="12"
                          Pattern="[a-z0-9]+"
                          SpellCheck="false"
                          Placeholder="@L["acme12"]" />
            <ValidationMessage For="@(() => _patternModel.Code)" />

            <div class="demo-row">
                <FormaButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary">@L["Save"]</FormaButton>
                @if (!string.IsNullOrEmpty(_patternStatus))
                {
                    <span role="status">@_patternStatus</span>
                }
            </div>
        </EditForm>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Setting a Width"]</h2>
    <p class="description">@L["Left alone the box fills whatever space it is given, which is usually right. Width overrides that with a typed CSS length, so a field holding a year or a postcode need not stretch across the page. Measuring in ch sizes the box by the characters it holds rather than by a guess in pixels."]</p>
    <div class="demo-box">
        <div class="demo-stack">
            <p class="demo-note">@L["Full width, the default:"]</p>
            <FormaTextBox @bind-Value="_model.FullWidth" aria-label="@L["Full Width"]" />

            <p class="demo-note">@L["Six characters wide, for a year:"]</p>
            <FormaTextBox @bind-Value="_model.Year" aria-label="@L["Year"]" Width="CssLength.FromCh(6)" InputMode="TextInputMode.Numeric" MaxLength="4" />

            <p class="demo-note">@L["Fourteen rem, for a postcode:"]</p>
            <FormaTextBox @bind-Value="_model.Postcode" aria-label="@L["Postcode"]" Width="CssLength.FromRem(14)" />

            <p class="demo-note">@L["Half the space it is given:"]</p>
            <FormaTextBox @bind-Value="_model.Half" aria-label="@L["Half Width"]" Width="CssLength.FromPercent(50)" />

            <p class="demo-note">@L["A labeled box takes a width just the same:"]</p>
            <EditForm Model="_model" FormName="textbox-width">
                <FormaTextBox @bind-Value="_model.ShortLabelled" Label="@L["Reference"]" Width="CssLength.FromRem(16)" />
            </EditForm>
        </div>
    </div>
</div>

@code {
    private readonly DemoModel _model = new();
    private readonly List<string> _tags = [];
    private ValidationModel _validationModel = default!;
    private PatternModel _patternModel = default!;
    private string? _statusMessage;
    private string? _patternStatus;

    protected override void OnInitialized()
    {
        _validationModel = new ValidationModel(L);
        _patternModel = new PatternModel(L);
        _model.Name = L["Acme Corp"].Value;
        _model.DisabledValue = L["Locked by an administrator"].Value;
        _model.ReadOnlyValue = L["Generated on save"].Value;
    }

    private void HandleValidationSubmit()
        => _statusMessage = L["Saved."].Value;

    private void HandlePatternSubmit()
        => _patternStatus = L["Saved."].Value;

    private void AddTag()
    {
        if (!string.IsNullOrWhiteSpace(_model.Tag))
        {
            _tags.Add(_model.Tag.Trim());
            _model.Tag = null;
        }
    }

    private sealed class DemoModel
    {
        public string? Name { get; set; }
        public string? NormalSize { get; set; }
        public string? LargeSize { get; set; }
        public string? Nickname { get; set; }
        public string? Handle { get; set; }
        public string? DisabledValue { get; set; }
        public string? ReadOnlyValue { get; set; }
        public string? Title { get; set; }
        public string? Slug { get; set; }
        public string? Tag { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Quantity { get; set; }
        public string? Amount { get; set; }
        public string? Plain { get; set; }
        public string? TypedEmail { get; set; }
        public string? TypedTel { get; set; }
        public string? TypedUrl { get; set; }
        public string? FullName { get; set; }
        public string? Coupon { get; set; }
        public string? Message { get; set; }
        public string? FullWidth { get; set; }
        public string? Year { get; set; }
        public string? Postcode { get; set; }
        public string? Half { get; set; }
        public string? ShortLabelled { get; set; }
    }

    private sealed class PatternModel(IStringLocale<FormaTextBoxPage> localizer) : IValidatableObject
    {
        public string? Code { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrEmpty(Code) && !Code.All(character => character is (>= 'a' and <= 'z') or (>= '0' and <= '9')))
            {
                yield return new ValidationResult(localizer["A product code takes lower-case letters and digits only."], [nameof(Code)]);
            }
        }
    }

    private sealed class ValidationModel(IStringLocale<FormaTextBoxPage> localizer) : IValidatableObject
    {
        public string? Title { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (string.IsNullOrWhiteSpace(Title))
            {
                yield return new ValidationResult(localizer["A project title is required."], [nameof(Title)]);
            }
        }
    }
}
