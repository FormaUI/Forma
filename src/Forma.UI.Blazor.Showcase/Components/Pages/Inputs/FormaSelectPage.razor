@page "/select"
@attribute [ShowcasePage("FormaSelect")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Forma.UI.Blazor.Components.Inputs
@inject IStringLocale<FormaSelectPage> L

<h1>FormaSelect</h1>
<p class="description">@L["A themed single-select: a trigger button opening an anchored, keyboard-navigable option list. The popup stays anchored to its trigger wherever the page scrolls."]</p>

<EditForm Model="Model" FormName="select-demo" OnValidSubmit="HandleSubmit">
    <div class="demo-section">
        <h2>@L["Basic"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.Culture" Options="CultureOptions" Label="@L["Culture"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["With Placeholder"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.Status"
                         Options="StatusOptions"
                         Label="@L["Status"]"
                         Placeholder="@L["Choose a status"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Pre-selected Value"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.PreSelectedRole" Options="RoleOptions" Label="@L["Role"]" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Disabled"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.DisabledStatus"
                         Options="StatusOptions"
                         Label="@L["Status"]"
                         Disabled="true" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["No Options Yet"]</h2>
        <div class="demo-box">
            <FormaSelect TValue="int?" @bind-Value="Model.EmptyChoice" Options="_emptyOptions" Label="@L["Category"]" />
        </div>
    </div>
</EditForm>

@code {
    private static readonly IReadOnlyList<SelectOption<int?>> CultureOptions =
    [
        new(1, "Español"),
        new(2, "English"),
    ];

    private static readonly IReadOnlyList<SelectOption<int?>> StatusOptions =
    [
        new(1, "Draft"),
        new(2, "Scheduled"),
        new(3, "Published"),
    ];

    private static readonly IReadOnlyList<SelectOption<int?>> RoleOptions =
    [
        new(1, "Admin"),
        new(2, "Manager"),
        new(3, "Member"),
    ];

    private readonly List<SelectOption<int?>> _emptyOptions = [];

    private SelectDemoModel Model { get; set; } = new()
    {
        PreSelectedRole = 2,
    };

    private void HandleSubmit() { }

    private sealed class SelectDemoModel
    {
        public int? Culture { get; set; }
        public int? Status { get; set; }
        public int? PreSelectedRole { get; set; }
        public int? DisabledStatus { get; set; }
        public int? EmptyChoice { get; set; }
    }
}
