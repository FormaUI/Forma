@page "/input"
@attribute [ShowcasePage("FormaInput")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Forma.UI.Blazor.Components.Inputs
@inject IStringLocale<FormaInputPage> L

<h1>FormaInput</h1>
<p class="desc">@L["Text input with a floating label that animates above the field on focus or when a value is present. Supports validation, required indicator, and autofill detection."]</p>

<EditForm Model="Model" FormName="field-demo" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="demo-section">
        <h2>@L["Basic Fields"]</h2>
        <div class="demo-box">
            <FormaInput Label="@L["Full Name"]" @bind-Value="Model.FullName" />
            <FormaInput Label="@L["Email Address"]" @bind-Value="Model.Email" Type="email" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Required Fields"]</h2>
        <div class="demo-box">
            <FormaInput Label="@L["Username"]" @bind-Value="Model.Username" Required="true" />
            <FormaInput Label="@L["Phone Number"]" @bind-Value="Model.Phone" Type="tel" Required="true" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Input Types"]</h2>
        <div class="demo-box">
            <FormaInput Label="@L["Website URL"]" @bind-Value="Model.Website" Type="url" />
            <FormaInput Label="@L["Search"]" @bind-Value="Model.Search" Type="search" />
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Pre-filled Value"]</h2>
        <div class="demo-box">
            <FormaInput Label="@L["Company Name"]" @bind-Value="Model.Company" />
        </div>
    </div>
</EditForm>

<div class="demo-section">
    <h2>@L["Validation"]</h2>
    <p class="desc">@L["Saving with the project name empty shows the validation message every Forma field renders through the same chrome. Editing the field clears it again."]</p>
    <div class="demo-box">
        <EditForm Model="ValidationModel" FormName="field-validation" OnValidSubmit="HandleValidationSubmit">
            <DataAnnotationsValidator />
            <FormaInput Label="@L["Project name"]" @bind-Value="ValidationModel.ProjectName" Required="true" />
            <FormaInput Label="@L["Contact email"]" @bind-Value="ValidationModel.ContactEmail" Type="email" />
            <FormaButton Type="ButtonType.Submit" Variant="ButtonVariant.Primary">@L["Save"]</FormaButton>
            <p role="status">@_validationStatus</p>
        </EditForm>
    </div>
</div>

@code {
    private FieldDemoModel Model { get; set; } = new()
    {
        Company = "Acme Corp"
    };

    private ValidationDemoModel ValidationModel { get; set; } = default!;
    private string? _validationStatus;

    protected override void OnInitialized()
        => ValidationModel = new ValidationDemoModel(L);

    private void HandleSubmit() { }

    private void HandleValidationSubmit()
        => _validationStatus = L["Saved."];

    private sealed class FieldDemoModel
    {
        public string? FullName { get; set; }
        public string? Email { get; set; }
        public string? Username { get; set; }
        public string? Phone { get; set; }
        public string? Website { get; set; }
        public string? Search { get; set; }
        public string? Company { get; set; }
    }

    // Validated through IValidatableObject because a DataAnnotations attribute cannot reach the localizer.
    private sealed class ValidationDemoModel(IStringLocale<FormaInputPage> localizer) : IValidatableObject
    {
        public string? ProjectName { get; set; }

        public string? ContactEmail { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (string.IsNullOrWhiteSpace(ProjectName))
            {
                yield return new ValidationResult(localizer["A project name is required."], [nameof(ProjectName)]);
            }

            if (!string.IsNullOrWhiteSpace(ContactEmail) && !ContactEmail.Contains('@', StringComparison.Ordinal))
            {
                yield return new ValidationResult(localizer["Enter a valid email address."], [nameof(ContactEmail)]);
            }
        }
    }
}
