@page "/icon"
@attribute [ShowcasePage("FormaIcon")]
@inject IStringLocale<FormaIconPage> L

<h1>FormaIcon</h1>
<p class="description">@L["The library's own glyphs, drawn as inline SVG so no icon font has to be loaded."]</p>

<div class="demo-section">
    <h2>@L["Every glyph"]</h2>
    <p class="description">@L["Every glyph is Phosphor Icons artwork, inlined so no icon font has to be fetched."]</p>
    <div class="demo-box">
        <ul class="glyph-grid">
            @foreach (var glyph in Drawable)
            {
                <li>
                    <FormaIcon Icon="glyph" />
                    <code>@glyph</code>
                </li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Variants"]</h2>
    <p class="description">@L["Every glyph offers a default and an alternate variant, chosen through the icon itself; Phosphor draws them as an outline and a solid shape."]</p>
    <div class="demo-box">
        <ul class="glyph-grid">
            @foreach (var glyph in Drawable)
            {
                <li>
                    <FormaIcon Icon="glyph" />
                    <FormaIcon Icon="Icon.Alternate(glyph)" />
                    <code>@glyph</code>
                </li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Unicode fallback"]</h2>
    <p class="description">@L["With no artwork pack registered, a mapped glyph draws as a Unicode character through the library's bundled symbol font, the alternate variant takes the font's heavier cut, and a glyph no character depicts draws nothing."]</p>
    <div class="demo-box">
        <ul class="glyph-grid">
            @foreach (var glyph in Drawable)
            {
                <li>
                    <FormaIcon Icon="glyph" Provider="Fallback" />
                    <FormaIcon Icon="Icon.Alternate(glyph)" Provider="Fallback" />
                    <code>@glyph</code>
                </li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Sizing"]</h2>
    <p class="description">@L["A glyph is one em tall and keeps its own aspect ratio, so it takes the font size of whatever contains it."]</p>
    <div class="demo-box">
        <div class="glyph-sizes">
            <span style="font-size: 0.75rem;"><FormaIcon Icon="Glyph.Folder" /> 0.75rem</span>
            <span style="font-size: 1rem;"><FormaIcon Icon="Glyph.Folder" /> 1rem</span>
            <span style="font-size: 1.5rem;"><FormaIcon Icon="Glyph.Folder" /> 1.5rem</span>
            <span style="font-size: 3rem;"><FormaIcon Icon="Glyph.Folder" /> 3rem</span>
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Color"]</h2>
    <p class="description">@L["A glyph is filled with the current text color, so it inherits any color its container sets."]</p>
    <div class="demo-box">
        <div class="glyph-sizes">
            <span style="color: var(--main-color);"><FormaIcon Icon="Glyph.Check" /> @L["Accent"]</span>
            <span style="color: var(--danger-color);"><FormaIcon Icon="Glyph.Warning" /> @L["Error"]</span>
            <span style="color: var(--success-color);"><FormaIcon Icon="Glyph.CheckSquare" /> @L["Success"]</span>
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Inside a button"]</h2>
    <p class="description">@L["A glyph carries no accessible name of its own, so the button around it has to be labeled."]</p>
    <div class="demo-box">
        <div class="glyph-sizes">
            <FormaButton Variant="ButtonVariant.Primary">
                <FormaIcon Icon="Glyph.CloudUpload" /> @L["Upload"]
            </FormaButton>
            <FormaButton Variant="ButtonVariant.Danger">
                <FormaIcon Icon="Icon.Alternate(Glyph.Delete)" /> @L["Delete"]
            </FormaButton>
            <FormaButton Variant="ButtonVariant.Secondary" aria-label="@L["Search"]">
                <FormaIcon Icon="Glyph.Search" />
            </FormaButton>
        </div>
    </div>
</div>

<PageLocalization />

@code {
    private static readonly Forma.UI.Blazor.Design.UnicodeIconProvider Fallback = Forma.UI.Blazor.Design.UnicodeIconProvider.Default;

    private static IEnumerable<Glyph> Drawable
        => Enum.GetValues<Glyph>().Where(glyph => glyph is not Glyph.None);
}
