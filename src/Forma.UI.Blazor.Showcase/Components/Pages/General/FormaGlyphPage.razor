@page "/glyph"
@attribute [ShowcasePage("FormaGlyph")]
@inject IStringLocale<FormaGlyphPage> L

<h1>FormaGlyph</h1>
<p class="description">@L["The library's own glyphs, drawn as inline SVG so no icon font has to be loaded."]</p>

<div class="demo-section">
    <h2>@L["Every glyph"]</h2>
    <p class="description">@L["Every glyph is Font Awesome Free artwork, inlined so no icon font has to be fetched."]</p>
    <div class="demo-box">
        <ul class="glyph-grid">
            @foreach (var glyph in Enum.GetValues<Glyph>())
            {
                <li>
                    <FormaGlyph Name="glyph" />
                    <code>@glyph</code>
                </li>
            }
        </ul>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Sizing"]</h2>
    <p class="description">@L["A glyph is one em tall and keeps its own aspect ratio, so it takes the font size of whatever contains it."]</p>
    <div class="demo-box">
        <div class="glyph-sizes">
            <span style="font-size: 0.75rem;"><FormaGlyph Name="Glyph.Folder" /> 0.75rem</span>
            <span style="font-size: 1rem;"><FormaGlyph Name="Glyph.Folder" /> 1rem</span>
            <span style="font-size: 1.5rem;"><FormaGlyph Name="Glyph.Folder" /> 1.5rem</span>
            <span style="font-size: 3rem;"><FormaGlyph Name="Glyph.Folder" /> 3rem</span>
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Colour"]</h2>
    <p class="description">@L["A glyph is filled with the current text colour, so it inherits any colour its container sets."]</p>
    <div class="demo-box">
        <div class="glyph-sizes">
            <span style="color: var(--main-color);"><FormaGlyph Name="Glyph.Check" /> @L["Accent"]</span>
            <span style="color: var(--danger-color);"><FormaGlyph Name="Glyph.TriangleExclamation" /> @L["Error"]</span>
            <span style="color: var(--success-color);"><FormaGlyph Name="Glyph.SquareCheck" /> @L["Success"]</span>
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Inside a button"]</h2>
    <p class="description">@L["A glyph carries no accessible name of its own, so the button around it has to be labelled."]</p>
    <div class="demo-box">
        <div class="glyph-sizes">
            <FormaButton Variant="ButtonVariant.Primary">
                <FormaGlyph Name="Glyph.CloudArrowUp" /> @L["Upload"]
            </FormaButton>
            <FormaButton Variant="ButtonVariant.Danger">
                <FormaGlyph Name="Glyph.Trash" /> @L["Delete"]
            </FormaButton>
            <FormaButton Variant="ButtonVariant.Secondary" aria-label="@L["Search"]">
                <FormaGlyph Name="Glyph.MagnifyingGlass" />
            </FormaButton>
        </div>
    </div>
</div>

<PageLocalization />
