@page "/data-grid"
@attribute [ShowcasePage("FormaDataGrid")]
@rendermode InteractiveServer
@using Forma.UI.Blazor.Components.Inputs

<h1>FormaDataGrid</h1>
<p class="description">@L["A table that pages, sorts and selects over any queryable set of items. The grid keeps its state in the address, so a page number or a sort order survives a refresh and can be shared as a link."]</p>

<div class="demo-section">
    <h2>@L["Basic Grid"]</h2>
    <div class="demo-box">
        <FormaDataGrid Items="_employees" PageSize="5" QueryParameterNamePrefix="basic">
            <Columns>
                <PropertyColumn Property="@(e => e.Id)" Sortable="true" />
                <PropertyColumn Property="@(e => e.Name)" Sortable="true" />
                <PropertyColumn Property="@(e => e.Department)" Sortable="true" />
            </Columns>
        </FormaDataGrid>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Mass-Select Checkboxes"]</h2>
    <div class="demo-box">
        <FormaDataGrid TGridItem="Employee" Items="_employees" PageSize="5" EnableCheckedSelection="true"
                       QueryParameterNamePrefix="selectable"
                       SelectedItems="_selected" SelectedItemsChanged="HandleSelectionChanged">
            <Columns>
                <PropertyColumn Property="@(e => e.Id)" />
                <PropertyColumn Property="@(e => e.Name)" />
                <PropertyColumn Property="@(e => e.Department)" />
            </Columns>
            <Status>@L["{Selected} row(s) selected.", ("Selected", _selected.Count)]</Status>
        </FormaDataGrid>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Row Selection"]</h2>
    <p class="description">@L["Click a row to select only it; Ctrl/Cmd-click to toggle one row; Shift-click or Shift with arrow keys to select a range."]</p>
    <div class="demo-box">
        <FormaDataGrid TGridItem="Employee" Items="_employees" PageSize="5" EnableRowSelection="true"
                       QueryParameterNamePrefix="row-selectable"
                       SelectedItems="_rowSelected" SelectedItemsChanged="HandleRowSelectionChanged">
            <Columns>
                <PropertyColumn Property="@(e => e.Id)" />
                <PropertyColumn Property="@(e => e.Name)" />
                <PropertyColumn Property="@(e => e.Department)" />
            </Columns>
            <Status>@L["{Selected} row(s) selected.", ("Selected", _rowSelected.Count)]</Status>
        </FormaDataGrid>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Selection Limits and Captions"]</h2>
    <p class="description">@L["At most {SelectionLimit} rows; the master toggle is a text caption instead of a checkbox.", SelectionLimit]</p>
    <div class="demo-box">
        <FormaDataGrid TGridItem="Employee" Items="_employees" PageSize="5" EnableCheckedSelection="true"
                       QueryParameterNamePrefix="limited" MaximumSelection="SelectionLimit"
                       CheckedSelectionCaption="_limitsCaption"
                       SelectedItems="_limitsSelected" SelectedItemsChanged="HandleLimitsSelectionChanged">
            <Columns>
                <PropertyColumn Property="@(e => e.Id)" />
                <PropertyColumn Property="@(e => e.Name)" />
                <PropertyColumn Property="@(e => e.Department)" />
            </Columns>
            <Status>@L["{Selected} row(s) selected.", ("Selected", _limitsSelected.Count)]</Status>
        </FormaDataGrid>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Row Click-Through"]</h2>
    <div class="demo-box">
        <FormaDataGrid TGridItem="Employee" Items="_employees" PageSize="5" OnRowClick="HandleRowClick"
                       QueryParameterNamePrefix="clickable">
            <Columns>
                <PropertyColumn Property="@(e => e.Id)" />
                <PropertyColumn Property="@(e => e.Name)" />
                <PropertyColumn Property="@(e => e.Department)" />
            </Columns>
            <Status>@L["Last clicked: {Name}", ("Name", _lastClicked?.Name ?? L["none"].Value)]</Status>
        </FormaDataGrid>
    </div>
</div>


<div class="demo-section">
    <h2>@L["Custom Cell Rendering and Row Styling"]</h2>
    <p class="description">@L["A TemplateColumn renders a FormaStatusBadge per row; RowClass dims inactive rows."]</p>
    <div class="demo-box">
        <FormaDataGrid TGridItem="Employee" Items="_employees" PageSize="5" RowClass="GetRowClass"
                       QueryParameterNamePrefix="styled">
            <Columns>
                <PropertyColumn Property="@(e => e.Id)" />
                <PropertyColumn Property="@(e => e.Name)" />
                <TemplateColumn Title="@L["Status"]">
                    <FormaStatusBadge Text="@(context.IsActive ? L["Active"] : L["Inactive"])"
                                      Status="@(context.IsActive ? "active" : "inactive")" />
                </TemplateColumn>
            </Columns>
        </FormaDataGrid>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Row Actions"]</h2>
    <p class="description">@L["An action column is an ordinary TemplateColumn — the grid adds no button components of its own. In a real app these navigate to an editor page or raise a confirm dialog."]</p>
    <div class="demo-box">
        <FormaDataGrid TGridItem="Employee" Items="_employees" PageSize="5"
                       QueryParameterNamePrefix="actions">
            <Columns>
                <PropertyColumn Property="@(e => e.Id)" />
                <PropertyColumn Property="@(e => e.Name)" />
                <TemplateColumn Title="@L["Actions"]">
                    <div class="demo-row-actions">
                        <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                     OnClick="() => RecordAction(RowAction.View, context)">@L["View"]</FormaButton>
                        <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                     OnClick="() => RecordAction(RowAction.Edit, context)">@L["Edit"]</FormaButton>
                        <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                     OnClick="() => RecordAction(RowAction.Delete, context)">@L["Delete"]</FormaButton>
                    </div>
                </TemplateColumn>
            </Columns>
            <Status>@L["Last action: {action}", ("action", _lastAction ?? L["none yet"].Value)]</Status>
        </FormaDataGrid>
    </div>
</div>

<div class="demo-section">    <h2>@L["Modal Details"]</h2>
    <p class="description">@L["A single FormaModal instance is shared by every row; the action column tells it which row to show."]</p>
    <div class="demo-box">
        <FormaDataGrid TGridItem="Employee" Items="_employees" PageSize="5"
                       QueryParameterNamePrefix="modal">
            <Columns>
                <PropertyColumn Property="@(e => e.Id)" />
                <PropertyColumn Property="@(e => e.Name)" />
                <PropertyColumn Property="@(e => e.Department)" />
                <TemplateColumn Title="@L["Actions"]">
                    <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                 OnClick="() => OpenDetails(context)">@L["View"]</FormaButton>
                </TemplateColumn>
            </Columns>
        </FormaDataGrid>

        <FormaModal Opened="_detailsOpen" OnClose="CloseDetails" Title="@_detailsEmployee?.Name">
            <Body>
                @if (_detailsEmployee is { } employee)
                {
                    <dl class="detail-list">
                        <dt>@L["ID"]</dt>
                        <dd>@employee.Id</dd>
                        <dt>@L["Name"]</dt>
                        <dd>@employee.Name</dd>
                        <dt>@L["Department"]</dt>
                        <dd>@employee.Department</dd>
                    </dl>
                }
            </Body>
        </FormaModal>
    </div>
</div>

<div class="demo-section">    <h2>@L["Inline Editing Inside a Form"]</h2>
    <p class="description">@L["FormaPropertyColumn shows its property, then swaps to an editor chosen from the property's type while its row is edited — text, number and date here. The grid owns the edit: it copies the row, validates the copy against its data annotations, and reports it only once valid, so Cancel discards and Save commits. The edited row drops out of selection while it is open."]</p>
    <div class="demo-box">
        <FormaDataGrid @ref="_editGrid" TGridItem="EditableEmployee" Items="@_editable.AsQueryable()"
                       EnablePagination="false" QueryParameterNamePrefix="editing"
                       EnableInlineEditing="true" CloneForEdit="CloneEmployee"
                       OnRowSave="SaveEmployee">
            <Columns>
                <FormaPropertyColumn Property="@(e => e.Id)" Editable="false" />
                <FormaPropertyColumn Property="@(e => e.Name)" Title="@L["Name"]" />
                <FormaPropertyColumn Property="@(e => e.Department)" Title="@L["Department"]" />
                <FormaPropertyColumn Property="@(e => e.StartDate)" Title="@L["Start date"]" Format="d" />
                <FormaPropertyColumn Property="@(e => e.Salary)" Title="@L["Salary"]" Format="N0" />
                <TemplateColumn Title="@L["Actions"]">
                    <div class="demo-row-actions">
                        @if (_editGrid?.IsEditing(context) == true)
                        {
                            <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                         OnClick="() => _editGrid!.SaveEditAsync()">@L["Save"]</FormaButton>
                            <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini"
                                         OnClick="() => _editGrid!.CancelEditAsync()">@L["Cancel"]</FormaButton>
                        }
                        else
                        {
                            <FormaButton Variant="ButtonVariant.Tertiary" Size="ButtonSize.Mini" Disabled="@(_editGrid?.EditingItem is not null)"
                                         OnClick="() => _editGrid!.BeginEdit(context)">@L["Edit"]</FormaButton>
                        }
                    </div>
                </TemplateColumn>
            </Columns>
        </FormaDataGrid>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Many Rows"]</h2>
    <div class="demo-box">
        <FormaDataGrid Items="_manyItems" PageSize="ManyPageSize" QueryParameterNamePrefix="many">
            <Columns>
                <PropertyColumn Property="@(item => item.Id)" Sortable="true" />
                <PropertyColumn Property="@(item => item.Title)" Sortable="true" />
            </Columns>
            <Status>@L["{ManyRowCount} rows paginated at {ManyPageSize} per page.", ManyRowCount, ManyPageSize]</Status>
        </FormaDataGrid>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Virtualized"]</h2>
    <p class="description">@L["Pagination is off and the surrounding box has a fixed height, so the rows scroll inside the grid while the header and footer stay put. Only the rows near the viewport are rendered."]</p>
    <div class="demo-box demo-box-bounded">
        <FormaDataGrid Items="_hugeItems" EnablePagination="false" Virtualize="true"
                       QueryParameterNamePrefix="virtualized">
            <Columns>
                <PropertyColumn Property="@(item => item.Id)" />
                <PropertyColumn Property="@(item => item.Title)" />
            </Columns>
            <Status>@L["{HugeRowCount:N0} rows, scrolled rather than paged.", HugeRowCount]</Status>
        </FormaDataGrid>
    </div>
</div>
