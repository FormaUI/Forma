@page "/"
@using System.Globalization

<h1>Forma Component Showcase</h1>
<p class="description">Visual testing and documentation for the Forma component library.</p>

<h3>Blazor Runtime Environment</h3>

@if (RendererInfo.IsInteractive)
{
    <p>Interactive mode: @RendererInfo.Name</p>
}
else
{
    <p>Static SSR (prerendering)</p>
}

<h3>Blazor LifeCycle Order</h3>

<LifeCycle @rendermode="InteractiveServer" />

@code {
    private string Culture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
