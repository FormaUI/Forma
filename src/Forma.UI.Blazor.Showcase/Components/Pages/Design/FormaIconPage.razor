@page "/icon"
@attribute [ShowcasePage("FormaIcon")]
@rendermode InteractiveServer
@using Forma.UI.Blazor.Components.Layout
@inject IStringLocale<FormaIconPage> L

<h1>FormaIcon</h1>
<p class="description">@L["The library's own glyphs, named for what they mean rather than for the set they are drawn from."]</p>
<p class="description">@L["Every glyph ships as artwork inside the library, drawn as inline SVG, so a host registers nothing and loads no icon font; a host that wants a different set registers its own provider instead."]</p>

<div class="demo-section">
    <h2>@L["Every glyph"]</h2>
    <p class="description">@L["The whole set at both of its native sizes, 32px from the 32-unit grid and 24px from the 24-unit grid, so a glyph can be judged beside its neighbors and against its other drawing."]</p>
    <p class="description">@L["The default variant is a stroke drawing and the alternate its filled counterpart; a glyph with nothing to fill draws its strokes heavier instead."]</p>
    <FormaTabs Label="@L["Variants"]">
        <FormaTab Title="@L["Default"]">
            @foreach (var section in Sections)
            {
                <h3>@L[section.Title]</h3>
                <div class="demo-box">
                    <ul class="glyph-grid glyph-grid-named">
                        @foreach (var glyph in section.Glyphs)
                        {
                            <li>
                                <FormaIcon Icon="glyph" Size="IconSize.Medium" />
                                <FormaIcon Icon="glyph" Size="IconSize.Small" />
                                <code>@glyph</code>
                            </li>
                        }
                    </ul>
                </div>
            }
        </FormaTab>
        <FormaTab Title="@L["Alternate"]">
            @foreach (var section in Sections)
            {
                <h3>@L[section.Title]</h3>
                <div class="demo-box">
                    <ul class="glyph-grid glyph-grid-named">
                        @foreach (var glyph in section.Glyphs)
                        {
                            <li>
                                <FormaIcon Icon="Icon.Alternate(glyph)" Size="IconSize.Medium" />
                                <FormaIcon Icon="Icon.Alternate(glyph)" Size="IconSize.Small" />
                                <code>@glyph</code>
                            </li>
                        }
                    </ul>
                </div>
            }
        </FormaTab>
    </FormaTabs>
</div>

<div class="demo-section">
    <h2>@L["Sizing"]</h2>
    <p class="description">@L["Each size an icon takes is a whole multiple of the grid its artwork is drawn on, so a stroke lands on whole pixels: 24px and 48px draw the 24-unit grid, 32px and 64px the 32-unit grid. A glyph inline with text follows the text instead."]</p>
    <div class="demo-box">
        <div class="glyph-sizes">
            <span><FormaIcon Icon="Glyph.Folder" /> @L["Inline"]</span>
            <span><FormaIcon Icon="Glyph.Folder" Size="IconSize.Small" /> @L["Small"] · 24px</span>
            <span><FormaIcon Icon="Glyph.Folder" Size="IconSize.Medium" /> @L["Medium"] · 32px</span>
            <span><FormaIcon Icon="Glyph.Folder" Size="IconSize.Large" /> @L["Large"] · 48px</span>
            <span><FormaIcon Icon="Glyph.Folder" Size="IconSize.Display" /> @L["Display"] · 64px</span>
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Color"]</h2>
    <p class="description">@L["A glyph is drawn in the current text color, so it inherits any color its container sets."]</p>
    <div class="demo-box">
        <div class="glyph-sizes">
            <span style="color: var(--main-color);"><FormaIcon Icon="Glyph.Check" /> @L["Accent"]</span>
            <span style="color: var(--danger-color);"><FormaIcon Icon="Glyph.Warning" /> @L["Error"]</span>
            <span style="color: var(--success-color);"><FormaIcon Icon="Glyph.CheckSquare" /> @L["Success"]</span>
        </div>
    </div>
</div>

<div class="demo-section">
    <h2>@L["Inside a button"]</h2>
    <p class="description">@L["A glyph carries no accessible name of its own, so the button around it has to be labeled."]</p>
    <div class="demo-box">
        <div class="glyph-sizes">
            <FormaButton Variant="ButtonVariant.Primary">
                <FormaIcon Icon="Glyph.CloudUpload" /> @L["Upload"]
            </FormaButton>
            <FormaButton Variant="ButtonVariant.Danger">
                <FormaIcon Icon="Icon.Alternate(Glyph.Delete)" /> @L["Delete"]
            </FormaButton>
            <FormaButton Variant="ButtonVariant.Secondary" aria-label="@L["Search"]">
                <FormaIcon Icon="Glyph.Search" Size="IconSize.Small" />
            </FormaButton>
        </div>
    </div>
</div>

<PageLocalization />
