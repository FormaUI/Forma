@page "/emoji"
@attribute [ShowcasePage("FormaEmoji")]
@rendermode InteractiveServer
@inject IStringLocale<FormaEmojiPage> L

<h1>FormaEmoji</h1>
<p class="description">@L["One emoji, drawn through whichever provider the host registered."]</p>
<p class="description">@L["This tab draws them the way a host that registered no artwork package sees them: as the reader's own platform characters, which look different on every device."]</p>

<CascadingValue Value="Fallback" IsFixed="true">
    <div class="demo-section">
        <h2>@L["A sample of the set"]</h2>
        <p class="description">@L["Each cell is one emoji drawn at the surrounding font size."]</p>
        <div class="demo-box">
            <ul class="glyph-grid glyph-grid-emoji">
                @foreach (var character in Sample)
                {
                    <li>
                        <FormaEmoji Emoji="character" />
                        <code>@character</code>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Sizing"]</h2>
        <p class="description">@L["An emoji takes the font size of whatever contains it, so it sits on a line of text without being measured against it."]</p>
        <div class="demo-box">
            <div class="glyph-sizes">
                <span style="font-size: 0.75rem;"><FormaEmoji Emoji="@("🚴")" /> 0.75rem</span>
                <span style="font-size: 1rem;"><FormaEmoji Emoji="@("🚴")" /> 1rem</span>
                <span style="font-size: 1.5rem;"><FormaEmoji Emoji="@("🚴")" /> 1.5rem</span>
                <span style="font-size: 3rem;"><FormaEmoji Emoji="@("🚴")" /> 3rem</span>
            </div>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Inside a sentence"]</h2>
        <p class="description">@L["An emoji is decorative by default and hidden from assistive technology, so the sentence around it has to read without it."]</p>
        <div class="demo-box">
            <p>@L["The stage winner"] <FormaEmoji Emoji="@("🏆")" /> @L["took the mountains classification as well"] <FormaEmoji Emoji="@("⛰️")" />.</p>
        </div>
    </div>

    <div class="demo-section">
        <h2>@L["Named for a reader"]</h2>
        <p class="description">@L["An emoji carrying meaning of its own takes a label, which announces it as an image rather than leaving it silent."]</p>
        <div class="demo-box">
            <div class="glyph-sizes">
                <FormaEmoji Emoji="@("✅")" Label="@L["Stage completed"]" />
                <FormaEmoji Emoji="@("⚠️")" Label="@L["Weather warning"]" />
                <FormaEmoji Emoji="@("🩺")" Label="@L["Medical car"]" />
            </div>
        </div>
    </div>
</CascadingValue>

<PageLocalization />

@code {
    private static readonly IEmojiProvider Fallback = UnicodeEmojiProvider.Default;

    private static readonly string[] Sample =
    [
        "😀", "😍", "🤝", "👏", "🚴", "🏆", "🥇", "⛰️", "🌧️", "🔥",
        "⏱️", "📣", "🩺", "✅", "⚠️", "🎉", "📸", "🚑", "🧭", "🍀",
    ];
}
