@rendermode InteractiveServer
@using Forma.UI.Design.Icons
@implements IDisposable
@inject IStringLocale<ShowcaseNav> L
@inject NavigationManager Nav

@* The toggle carries the open state in aria-expanded, which the stylesheet reads as well, so the
   drawer's appearance and what assistive technology is told cannot drift apart. *@
<button type="button"
        class="showcase-nav-toggle"
        aria-expanded="@(_isOpen ? "true" : "false")"
        aria-label="@L["Pages"]"
        @onclick="() => _isOpen = !_isOpen">
    <FormaIcon Icon="Glyph.List" />
</button>

<ShowcaseSidebar />

@code {
    private bool _isOpen;

    /// <inheritdoc />
    protected override void OnInitialized()
        => Nav.LocationChanged += HandleLocationChanged;

    /// <inheritdoc />
    public void Dispose()
        => Nav.LocationChanged -= HandleLocationChanged;

    // Choosing a page is the end of what the drawer was opened for.
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _isOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }
}
