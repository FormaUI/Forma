@using System.Globalization

<!DOCTYPE html>
<html lang="@Lang" dir="@Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forma Component Showcase</title>
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/Forma.UI/forma-tokens.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Forma.UI/forma-reset.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Forma.UI/forma-base.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Forma.UI/forma-input.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Forma.UI.Blazor.Showcase.styles.css"]" />
    <PageLocalization />
    <ResourcePreloader />
    <ImportMap />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    private string Lang => CultureInfo.CurrentUICulture.Name;
    private string Dir => CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
