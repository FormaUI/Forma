@inherits FormaComponentBase

@* What a runtime shows of the page's culture: the runtime, a string of the host's own, a library component's label and its pages turning,
   and a switch to Hebrew. *@
<output class="runtime">@RendererInfo.Name @RendererInfo.IsInteractive</output>
<output class="welcome">@L["Welcome"]</output>
<FormaPagination TotalItemCount="20" PageSize="10" CurrentPage="_currentPage" OnPageChanged="@(page => _currentPage = page)" />
<button class="switch" @onclick="SwitchAsync">עברית</button>

@code {
    [Inject] private ICultureSwitch CultureSwitch { get; set; } = default!;

    private int _currentPage = 1;

    private Task SwitchAsync()
        => CultureSwitch.SwitchAsync(CultureInfo.GetCultureInfo("he"));
}
