<Project>

    <!-- The repository's targets import the localization targets from source; an example takes them from the package. -->

    <!--
        The packages folder is an .editorconfig root, so a package's own sources compiled into an example, as the MAUI
        example's are on Windows, take none of the repository's analyzer rules. The SDK reads only the .editorconfig
        files above the sources a project names, so the compile is handed this one.
    -->
    <Target Name="FormaExamplePackageFolderEditorConfig" BeforeTargets="CoreCompile" Condition="'$(NuGetPackageRoot)' != '' And '$([MSBuild]::NormalizeDirectory($(NuGetPackageRoot)))' == '$(RestorePackagesPath)'">
        <WriteLinesToFile File="$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)')).editorconfig" Lines="root = true" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <EditorConfigFiles Include="$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)')).editorconfig" />
        </ItemGroup>
    </Target>

    <!--
        WebView2's package references its WPF assembly from every .NET project, and that assembly needs WPF's own
        WindowsBase, which a Windows Forms application without WPF doesn't carry; such an example leaves it out.
    -->
    <Target Name="FormaExampleWebView2WithoutWpf" BeforeTargets="ResolveAssemblyReferences" Condition="'$(UseWindowsForms)' == 'true' And '$(UseWPF)' != 'true'">
        <ItemGroup>
            <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
        </ItemGroup>
    </Target>

</Project>
