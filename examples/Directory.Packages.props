<Project>

    <!--
        Forma Example Package Versions

        The framework's packages at the versions the repository builds with, and Forma's at the version the
        repository declares, which the gate packs them at.
    -->

    <Import Project="..\Directory.Packages.props" />

    <!-- The version is read from the root properties file, its one declaration, unless a build names another. -->
    <PropertyGroup Condition="'$(FormaVersion)' == ''">
        <_FormaProperties>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\Directory.Build.props'))</_FormaProperties>
        <_FormaVersionPrefix>$([System.Text.RegularExpressions.Regex]::Replace($(_FormaProperties), '(?s)^.*&lt;VersionPrefix&gt;([^&lt;]*)&lt;/VersionPrefix&gt;.*$', '$1'))</_FormaVersionPrefix>
        <_FormaVersionSuffix Condition="$(_FormaProperties.Contains('&lt;VersionSuffix&gt;'))">$([System.Text.RegularExpressions.Regex]::Replace($(_FormaProperties), '(?s)^.*&lt;VersionSuffix&gt;([^&lt;]*)&lt;/VersionSuffix&gt;.*$', '$1'))</_FormaVersionSuffix>
        <FormaVersion>$(_FormaVersionPrefix)</FormaVersion>
        <FormaVersion Condition="'$(_FormaVersionSuffix)' != ''">$(_FormaVersionPrefix)-$(_FormaVersionSuffix)</FormaVersion>
    </PropertyGroup>

    <!-- The Windows Forms web view, which only an example uses, at the WPF one's version. -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="11.0.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="formaui-net.Blazor.Server" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.Blazor.WebAssembly" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.Blazor.WebView" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.AddOns.Operations.Maui" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.Blazor.Locales.Hebrew" Version="$(FormaVersion)" />
        <PackageVersion Include="formaui-net.Framework.Localization.Json" Version="$(FormaVersion)" />
    </ItemGroup>

</Project>
