<?xml version="1.0" encoding="utf-8"?>
<!--
    Forma Example Package Sources

    Forma's packages from the folder the gate packs them into, and everything else from nuget.org.
-->
<configuration>

    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="forma-examples" value="../artifacts/browser/packages" />
    </packageSources>

    <packageSourceMapping>
        <clear />
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="forma-examples">
            <package pattern="formaui-net.*" />
        </packageSource>
    </packageSourceMapping>

</configuration>
